<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="1555506416658437797">төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="8359495463485001719">Бұзылу туралы хабарлау мүмкіндігі FlyWeb қызметінде қолжетімді емес.</translation>
<translation id="6338530717474923868">Қауіпсіз FlyWeb бетін көрудесіз</translation>
<translation id="5147169001159408844">FlyWeb төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="5702992568540613683">FlyWeb логотипі</translation>
<translation id="510342522494506803">FlyWeb төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="8375862260948854624">FlyWeb қолданбасына <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS"/>ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS"/> арқылы қол жеткізілді.</translation>
<translation id="4281953335231207224">"FlyWeb мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN параметрлері" тармағына өтіп,
          "LAN желіңіз үшін прокси серверді пайдалану" құсбелгісін алып тастаңыз.</translation>
<translation id="5040124620086808431">Бұл бетке FlyWeb тарапынан тыйым салынған.</translation>
<translation id="1953000035868532675">Брандмауэр немесе антивирус параметрлерінде FlyWeb жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="3442058224540562441">FlyWeb мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
           тармағына өтіп, конфигурацияңыз "проксисіз" немесе "тікелей" күйіне орнатылғандығын тексеріңіз.</translation>
<translation id="585620188971323280">төлеу әдістерін толтыру параметрлерін өзгертіңіз.</translation>
<translation id="2681118099728446983">Сонымен қатар FlyWeb басқа <ph name="BEGIN_LINK_OSS"/>ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS"/> арқылы қолжетімді болады.</translation>
<translation id="6888846095017247017">Өзгертулеріңіз FlyWeb келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="1017070759373671177">FlyWeb браузері <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="7777112741998051633">FlyWeb мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION"/>" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="8187289872471304532">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі &gt; Кеңейтілген &gt; Прокси серверлері" тармағына өтіп,
          таңдалған барлық прокси серверлерін таңдаудан алып тастаңыз.</translation>
<translation id="4699594416850504200">Қауіпсіз FlyWeb for Testing бетін көріп отырсыз.</translation>
<translation id="6224789938625024797">FlyWeb дұрыс өшірілмеді.</translation>
</translationbundle>