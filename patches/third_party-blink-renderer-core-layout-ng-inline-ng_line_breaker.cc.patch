+LayoutUnit MaxLineWidth(const NGLineInfo& base_line,
+                        const HeapVector<NGLineInfo, 1>& annotation_lines) {
+  LayoutUnit max = base_line.Width();
+  for (const auto& line : annotation_lines) {
+    max = std::max(max, line.Width());
+  }
+  return max;
+}
