<translation id="2266459657068215132">‏אפשר לפתוח קישורים ב-FlyWeb מכל אפליקציה. בנוסף FlyWeb מוצמד לשורת המשימות לגישה נוחה.</translation>
<translation id="504994999924593940">‏דיווח על <ph name="BEGIN_LINK"/>ההגדרות הנוכחיות<ph name="END_LINK"/> יעזור לשפר את FlyWeb</translation>
