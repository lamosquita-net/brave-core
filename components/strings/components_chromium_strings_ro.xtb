<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ro">
<translation id="130631256467250065">Modificările dvs. se vor aplica următoarea dată când reporniți dispozitivul.</translation>
<translation id="125853961893919199">Sfat pentru FlyWeb: salvează parolele</translation>
<translation id="1589233279653618219">Accesează
          meniul FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          și asigură-te că ai setat pentru configurație valoarea Fără proxy sau Directă.</translation>
<translation id="8359495463485001719">Raportarea blocărilor nu este disponibilă în FlyWeb.</translation>
<translation id="6338530717474923868">Se afișează o pagină FlyWeb securizată</translation>
<translation id="5147169001159408844">FlyWeb încearcă să modifice setările pentru completarea metodelor de plată.</translation>
<translation id="5702992568540613683">Sigla FlyWeb</translation>
<translation id="8966580353365544289">Sfat pentru FlyWeb: Navigarea sigură îmbunătățită</translation>
<translation id="510342522494506803">FlyWeb încearcă să modifice metodele de plată.</translation>
<translation id="8375862260948854624">FlyWeb există mulțumită proiectului open source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> și a altor <ph name="BEGIN_LINK_OSS"/>produse software open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Pagina a fost blocată de FlyWeb</translation>
<translation id="1953000035868532675">Din setările pentru firewall sau antivirus, permite browserului FlyWeb să acceseze
          rețeaua.</translation>
<translation id="4949828774841497663">Accesează Aplicații &gt; Setări de sistem &gt; Rețea, selectează rețeaua
          activă, dă clic pe butonul Detalii... și debifează orice proxy
          care ar fi fost selectat.</translation>
<translation id="7584668345330431749">Accesează
          meniul FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Rețea și internet &gt; Proxy
          și debifează opțiunea Detectează automat setările.</translation>
<translation id="3145451630329266064">Aceste pagini sunt destinate utilizării de către dezvoltatorii FlyWeb și este posibil să nu fie întreținute sau testate în mod activ. Pentru a le activa, accesează <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, dă clic pe butonul pentru a activa paginile de remediere a erorilor, apoi accesează din nou această pagină.</translation>
<translation id="2681118099728446983">FlyWeb acceptă și alte opțiuni de <ph name="BEGIN_LINK_OSS"/>software open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Modificările dvs. vor intra în vigoare următoarea dată când reporniți FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb are nevoie de acces la Bluetooth pentru a continua conectarea. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb există datorită proiectului open source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Accesează
          meniul FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          și debifează „<ph name="NO_PREFETCH_DESCRIPTION"/>”.
          Dacă această acțiune nu rezolvă problema, îți recomandăm să selectezi din nou
          această opțiune pentru performanță îmbunătățită.</translation>
<translation id="4699594416850504200">Se afișează o pagină FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb nu s-a închis corect.</translation>
<translation id="3593104813552438879">Sfat pentru FlyWeb: caută cu Lens</translation>
</translationbundle>