<!DOCTYPE translationbundle>
<translationbundle lang="my">
<translation id="1026101648481255140">ထည့်သွင်းမှု ဆက်လုပ်ရန်</translation>
<translation id="7099479769133613710">&amp;ChromeOS အပ်ဒိတ်လုပ်ရန်အတွက် ပြန်ဖွင့်ရန်</translation>
<translation id="291426170030461697">ဤနောက်ဆက်တွဲကို စစ်ဆေးရန် FlyWeb က အကြံပြုပါသည်</translation>
<translation id="1549005488226693697">ဝဘ်ဆိုက်က ၎င်း၏စာမျက်နှာရှိ လင့်ခ်များ သီးသန့်ကြိုဖွင့်ရန် တောင်းဆိုသောအခါ FlyWeb က FlyWeb ဆာဗာကို သုံးသည်။ ၎င်းက သင့်အထောက်အထားကို ကြိုဖွင့်ထားသည့် ဝဘ်ဆိုက်ထံမှ ဖျောက်ပေးသော်လည်း မည်သည့်ဝဘ်ဆိုက်ကို ကြိုဖွင့်ထားကြောင်း FlyWeb က လေ့လာသည်။</translation>
<translation id="1065672644894730302">သင့်စိတ်ကြိုက်များ ဖတ်၍မရပါ။

အချို့အင်္ဂရပ်များ မရရှိနိုင်ပါ၊ စိတ်ကြိုက်များသို့ ပြောင်းလဲခြင်းများ သိမ်းမည်မဟုတ်ပါ။</translation>
<translation id="8908267645832965492">FlyWeb အတွက် “ဝဘ်ဆိုက်၊ အက်ပ်နှင့် နောက်ဆက်တွဲ ခွင့်ပြုချက်များ” ကို သင့်မိဘက ပိတ်လိုက်သည်</translation>
<translation id="5557633153169217776">FlyWeb သည် အနီးရှိစက်များကို ရှာဖွေပြီး အသုံးပြုရန်အတွက် သင်၏အိမ်သုံးကွန်ရက်ကို သုံးခွင့်လိုအပ်သည်</translation>
<translation id="6441390163669415879">FlyWeb အင်္ဂါရပ် (သို့) နောက်ဆက်တွဲတစ်ခုကို ရှာရန် လိပ်စာဘားတွင် ၎င်း၏ဖြတ်လမ်းလင့်ခ်ကို ရိုက်ထည့်ပြီးနောက် သင်ရွေးထားသော ကီးဘုတ်ခလုတ်ကို နှိပ်ပါ</translation>
<translation id="9001750423919983557">စနစ် ဗန်းတွင် ‘FlyWeb ဖြင့် ရှာဖွေမှု’ ကို ပြပြီး လက်ကွက်ဖြတ်လမ်းကို ဖွင့်ရန်</translation>
<translation id="1368460307421081773">FlyWeb သည် သင်၏ စကားဝှက်များကို တင်ပို့လိုသည်။ ၎င်းကို ခွင့်ပြုရန် သင်၏ Windows စကားဝှက်ကို ထည့်ပါ။</translation>
<translation id="112640046208448578">အရာဝတ္ထု (သို့) နေရာများကို ဖော်ထုတ်ပြီး စာသားကို မိတ္တူကူးသည် (သို့) ဘာသာပြန်သည်။ ‘ပုံဖြင့်ရှာဖွေမှု’ သုံးသောအခါ စာမျက်နှာ၏ ဖန်သားပြင်ဓာတ်ပုံကို ဆာဗာသို့ ပို့သည်။ <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb သည် သင်၏ မူရင်းဘရောင်ဇာဖြစ်သည်</translation>
<translation id="4556715463645168547">သင်၏စကားဝှက်များတွင် ဒေတာပေါက်ကြားမှုနှင့် အခြားသော လုံခြုံရေးပြဿနာများ ရှိ၊ မရှိ စစ်ဆေးရန် <ph name="BEGIN_LINK"/>FlyWeb သို့ လက်မှတ်ထိုးဝင်ပါ<ph name="END_LINK"/>။</translation>
<translation id="2076135703183650206">FlyWeb မီနူးကို နှိပ်ပါ</translation>
<translation id="1157985233335035034">မကြာသေးမီက ဘာသာစကားများ</translation>
<translation id="1184145431117212167">သင်၏ Windows ဗားရှင်းကို ပံ့ပိုးမထားသောကြောင့် ထည့်သွင်း၍ မရလိုက်ပါ။</translation>
<translation id="4380351562011537903">FlyWeb အကြောင်း</translation>
<translation id="853148447909557566">သင့်ဖုန်းတွင် FlyWeb ဖြင့် ဈေးနှုန်းခြေရာခံခြင်းဆိုင်ရာ သတိပေးချက်များ ရယူပါ</translation>
<translation id="1203500561924088507">ထည့်သွင်းသည့်အတွက် ကျေးဇူးတင်ပါသည်။ <ph name="BUNDLE_NAME"/> အသုံးမပြုမီ သင့်ဘရောင်ဇာကို ပြန်စရမည်။</translation>
<translation id="1232234696885483911">‘ပုံဖြင့်ရှာဖွေမှု’ ကို ဖွင့်သောအခါ PDF များအပါအဝင် စာမျက်နှာခေါင်းစဉ်၊ URL နှင့် ဒစ်ဂျစ်တယ်မီဒီယာတို့ကို ဆာဗာသို့ အလိုအလျောက်ပို့ပါမည်။ <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">လက်မှတ်ထိုးဝင်ထားစဉ် FlyWeb ရှိ သင်၏ FlyWeb sync chain မှ စကားဝှက်နှင့် အခြားအရာများကို သုံးနိုင်သည်။ ၎င်းကိုပြောင်းရန် “FlyWeb ရှိ သင့်အကောင့်” သို့ သွားပါ။</translation>
<translation id="7614508617663739435">FlyWeb ရှိ Gemini ကို Mac မီနူးဘားတွင် ပြပါ</translation>
<translation id="832555967476614730">FlyWeb ရှိ Gemini တွင် စခရင်၏ အစိတ်အပိုင်းကို ရွေးရန် လက်ကွက်ဖြတ်လမ်းများ သုံးပါ။</translation>
<translation id="4750836834956739196">FlyWeb မြန်ဆန်စေရန်အတွက် ဤတဘ် အသုံးမပြုစဉ် မှတ်ဉာဏ်ကို နေရာလွတ်ပြုလုပ်ထားသည်။ ဤဝဘ်ဆိုက်ကို အသုံးမပြုသည့်စာရင်းမှ အမြဲဖယ်ထုတ်ထားရန် ရွေးနိုင်သည်။</translation>
<translation id="3190759351483708314">ဖိုင်သည် အန္တရာယ်ရှိသဖြင့် FlyWeb က ဤဒေါင်းလုဒ်ကို ပိတ်ထားသည်</translation>
<translation id="5879469261638423015">Gmail (သို့) YouTube ကဲ့သို့ FlyWeb ဝန်ဆောင်မှုများသို့ <ph name="USER_EMAIL"/> ဖြင့် လက်မှတ်ထိုးဝင်သောအခါ ယင်းအကောင့်ဖြင့် FlyWeb သို့ အလိုအလျောက် လက်မှတ်ထိုးဝင်နိုင်သည်</translation>
