<translation id="8463540467315366872">‏כבר קיים במכשיר פרופיל FlyWeb עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="8611872055947278722">‏עדכון FlyWeb לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS"/> שנ'</translation>
<translation id="3217139311889964618">‏<ph name="BEGIN_BOLD"/>איך ניתן לנהל את הנתונים שלך:<ph name="END_BOLD"/> כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-FlyWeb כדי שלא יילקחו בחשבון.</translation>
<translation id="3096730275883527801">‏נכנסת ל-FlyWeb כ-<ph name="USER_EMAIL_ADDRESS"/>. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="9017338699075596174">‏זוהי התקנה משנית של FlyWeb, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="5944585442866020176">‏אחרי מתן גישה ל-FlyWeb, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="3263664073045388929">‏נדרשת הרשאת מיקום ב-FlyWeb עבור האתר הזה</translation>
<translation id="5334309298019785904">‏לא בוצע סנכרון של הנתונים ב-ChromeOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="1597323875619800374">‏FlyWeb‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8455485678130879158">‏סוג הקובץ הזה מסוכן ולכן הקובץ נחסם על ידי FlyWeb</translation>
<translation id="6756872644564483342">‏אם אין לתמונה תיאור מועיל, FlyWeb ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל FlyWeb. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="5792785787074426346">‏FlyWeb לא יכול לבדוק את הסיסמאות שלך כי לא נכנסת לחשבון</translation>
<translation id="6627585369674499881">‏FlyWeb‏ חסם את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="208266011144024011">‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="3542611917357881417">‏מפיקים את המירב מ-FlyWeb</translation>
<translation id="5565286784156841599">‏כניסה לחשבון תסנכרן ותתאים אישית את FlyWeb בכל המכשירים שברשותך</translation>
<translation id="9174706677133564856">‏בכתובת <ph name="USER_EMAIL_ADDRESS"/> השתמשו בעבר ב-FlyWeb</translation>
<translation id="5975370349701995302">‏כדי לגשת אל פריטים שונים בדפדפן FlyWeb שלך מכל המכשירים, צריך להיכנס לחשבון ולהפעיל את הסנכרון</translation>
<translation id="7408894216012529448">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="7256356679044945328">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-FlyWeb כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="5261590792975521002">{0,plural, =1{‏צריך להפעיל מחדש את FlyWeb בתוך יום אחד}one{‏צריך להפעיל מחדש את FlyWeb בתוך # ימים}two{‏צריך להפעיל מחדש את FlyWeb בתוך # ימים}other{‏צריך להפעיל מחדש את FlyWeb בתוך # ימים}}</translation>
<translation id="3101564993057563365">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את FlyWeb.</translation>
<translation id="5316851838033144902">‏כדי להשתמש ב-FlyWeb נדרש Windows מגרסה 10 ואילך.</translation>
<translation id="6760691951531758781">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל FlyWeb תעזור לשפר את התכונות ואת הביצועים של ChromeOS.</translation>
<translation id="6852836260419236265">‏FlyWeb אינו מעודכן</translation>
<translation id="8550334526674375523">פרופיל העבודה שלך נפרד לחלוטין מהפרופיל האישי שלך.</translation>
<translation id="538636623826336032">‏אחד מההורים השבית ב-FlyWeb את ההגדרה "הרשאות לאתרים, אפליקציות ותוספים". לא ניתן להוסיף את ה<ph name="EXTENSION_TYPE_PARAMETER"/>.</translation>
<translation id="8842078659829047498">‏FlyWeb יכול לבדוק את הסיסמאות כשנכנסים באמצעות חשבון FlyWeb</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="6539417028609632917">‏<ph name="BEGIN_BOLD"/>איך אנחנו משתמשים בנתונים האלה:<ph name="END_BOLD"/> אתרים יכולים לשמור מידע ב-FlyWeb לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="7129578417724116642">‏הפעלת FlyWeb מתבצעת...</translation>
<translation id="781795332371306113">‏ההתקנה נכשלה בשל שגיאה לא מזוהה. יש להוריד שוב את FlyWeb.</translation>
<translation id="5469043671012993003">‏לא ניתן להגדיר את FlyWeb for Testing כדפדפן ברירת המחדל.</translation>
<translation id="1074759999845943804">{NUM_DEVICES,plural, =0{‏תוסף ל-FlyWeb ניגש למכשירי ממשק אנושי (HID)}=1{‏תוסף ל-FlyWeb ניגש למכשיר ממשק אנושי (HID) אחד}one{‏תוסף ל-FlyWeb ניגש ל-# מכשירי ממשק אנושי (HID)}two{‏תוסף ל-FlyWeb ניגש ל-# מכשירי ממשק אנושי (HID)}other{‏תוסף ל-FlyWeb ניגש ל-# מכשירי ממשק אנושי (HID)}}</translation>
<translation id="1514450422236300417">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את FlyWeb או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="573490495087487940">‏זהו ה-FlyWeb שלך</translation>
<translation id="6779439179813982247">‏FlyWeb זקוק להרשאת גישה אל המצלמה והמיקרופון בשביל האתר הזה</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="6933858244219479645">‏מערכת ChromeOS</translation>
<translation id="7354175404728814475">‏<ph name="BEGIN_BOLD"/>באילו נתונים נעשה שימוש:<ph name="END_BOLD"/> היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות FlyWeb במכשיר הזה.</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="709828993049448700">‏אם שינית את הסיסמה הזו, יש לערוך את הסיסמה השמורה ב-FlyWeb כך שהיא תתאים לסיסמה החדשה שלך.</translation>
<translation id="1446416109379198698">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את FlyWeb או לוחצים על הלחצן 'דף הבית'.</translation>
<translation id="4669168852412989042">‏FlyWeb מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="1343885466359249904">‏FlyWeb יכול להעריך מהם תחומי העניין שלך על סמך היסטוריית הגלישה שלך מהשבועות האחרונים. המידע הזה נשאר במכשיר שלך.</translation>
<translation id="1663379621921336006">‏לא ניתן לעדכן את FlyWeb</translation>
<translation id="543915850302643692">‏הלוגו של FlyWeb Enterprise</translation>
<translation id="8986207147630327271">בחרת להוסיף פרופיל עבודה לדפדפן זה ולתת למנהל המערכת שליטה רק על פרופיל העבודה.</translation>
<translation id="5804408305184682593">‏כניסה אל FlyWeb</translation>
<translation id="8692043725449223663">‏יש להיכנס אל FlyWeb. אם רוצים להיכנס לחשבון באופן חד-פעמי בלבד, אפשר <ph name="GUEST_LINK_BEGIN"/>להשתמש במכשיר כאורח<ph name="GUEST_LINK_END"/>.</translation>
<translation id="8323442969389928559">‏FlyWeb נסגר באופן אוטומטי</translation>
<translation id="7626272203917389133">‏FlyWeb אינו מעודכן</translation>
<translation id="1789655708880997767">{0,plural, =1{‏FlyWeb יופעל מחדש בעוד שעה}one{‏FlyWeb יופעל מחדש בעוד # שעות}two{‏FlyWeb יופעל מחדש בעוד # שעות}other{‏FlyWeb יופעל מחדש בעוד # שעות}}</translation>
<translation id="8970147445441095618">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="1208237657860748752">‏פתיחת הקישור &amp;בכרטיסיית FlyWeb חדשה</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="1899793037348288257">‏במהלך הפעולה של גרסאות הניסיון, תהיה לך אפשרות לראות ולהסיר את תחומי העניין שלפיהם האתרים הציגו לך את המודעות. ההערכה של תחומי העניין ב-FlyWeb מתבססת על היסטוריית הגלישה שלך מהזמן האחרון.</translation>
<translation id="3926534790663909774">‏לפי הגדרת מנהל המערכת, FlyWeb יפתח דפדפן חלופי כדי לגשת אל <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="5022081608392609959">‏הפעלה מחדש לצורך עדכון &amp;FlyWeb</translation>
<translation id="8203782065881668160">‏FlyWeb ‏(mDNS-In)</translation>
<translation id="5547805003442792166">‏אפשר להתאים אישית את FlyWeb בדרך שנוחה לך</translation>
<translation id="3410331617397516204">‏ייתכן ש-FlyWeb לא יפעל כראוי כי הוא כבר לא נתמך ב-Windows XP וב-Windows Vista</translation>
<translation id="1641772209502041092">‏אישורים שמנוהלים על ידי FlyWeb</translation>
<translation id="1127626874097952395">‏מי משתמש/ת ב-FlyWeb?</translation>
<translation id="1626113414414104077">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של FlyWeb?</translation>
<translation id="2952628102760787868">‏ניקוי נתונים מאתרים מהמכשיר בכל פעם שסוגרים את FlyWeb</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="137466361146087520">‏גרסת הבטא של Google Chrome</translation>
<translation id="7535429826459677826">‏גרסת הפיתוח של Google Chrome</translation>
<translation id="4434689349450618970">אם ברצונך להשתמש בחשבון זה באופן חד-פעמי בלבד, באפשרותך להשתמש <ph name="GUEST_LINK_BEGIN"/> ב׳מצב אורח׳ <ph name="GUEST_LINK_END"/> בדפדפן FlyWeb. אם ברצונך להוסיף חשבון עבור מישהו אחר, <ph name="LINK_BEGIN"/> הוסף פרופיל חדש <ph name="LINK_END"/> אל <ph name="DEVICE_TYPE"/>שלך. 

הרשאות שכבר ניתנו על ידך לאחרים ואפליקציות עשויות לחול על חשבון זה. באפשרותך לנהל את אפשרויות הסנכרון של FlyWeb בעמוד <ph name="SETTINGS_LINK_BEGIN"/>ההגדרות<ph name="SETTINGS_LINK_END"/> שלך.</translation>
<translation id="2725795635123877647">הרחבות, אפליקציות וערכות נושא ממקורות לא ידועים עלולים להזיק למכשיר שלך. FlyWeb ממליץ להתקין אותם רק מ-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="3470813199863172076">תוסף זה מפר את מדיניות חנות האינטרנט ועלול להיות לא בטוח. הסר אותו מ-FlyWeb כדי שלא יוכל לראות ולשנות את הנתונים שלך באתרים שבהם אתה מבקר, כולל המידע האישי שלך.</translation>
<translation id="5382847955032513683">‏אזהרה: FlyWeb לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב גלישה בסתר, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="543905389684998697">‏כדי לשפר את האבטחה של FlyWeb, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="3914570680366033593">‏כדי לשפר את האבטחה של FlyWeb, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="3293172835368652510">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-FlyWeb בתור <ph name="USER_EMAIL"/>.</translation>
<translation id="2742103213766991703">‏פתח את הקישור בחלון &amp;גלישה בסתר של FlyWeb</translation>
<translation id="1616978953472841483">‏פתח את הקישור בחלון &amp;גלישה בסתר של FlyWeb</translation>
