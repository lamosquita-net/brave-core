<!DOCTYPE translationbundle>
<translationbundle lang="uz">
<translation id="130631256467250065">O‘zgartirishlar qurimla qaytadan ishga tushirilganda kuchga kiradi.</translation>
<translation id="125853961893919199">FlyWeb maslahati: Parollarni saqlang</translation>
<translation id="1589233279653618219">Bularni oching:
          FlyWeb menyusi &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          va sozlamalarda “proksi-serversiz” yoki “bevosita” ulanish belgilanganini tekshiring.</translation>
<translation id="8359495463485001719">FlyWeb‘da xatoliklar haqidagi hisobot funksiyasi mavjud emas.</translation>
<translation id="6338530717474923868">Xavfsiz FlyWeb sahifasini ko‘rmoqdasiz.</translation>
<translation id="5147169001159408844">FlyWeb toʻlov usuli kiritilishi sozlamasini oʻzgaritishga urinmoqda.</translation>
<translation id="5702992568540613683">FlyWeb logotipi</translation>
<translation id="8966580353365544289">FlyWeb maslahati: Saytlarni kuchaytirilgan rejimda xavfsiz kezish</translation>
<translation id="510342522494506803">FlyWeb toʻlov usullarini oʻzgartirishga urinmoqda.</translation>
<translation id="8375862260948854624">FlyWeb yaratilishida <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ochiq kodli loyiha va boshqa <ph name="BEGIN_LINK_OSS"/>ochiq kodli dasturiy ta’minotning<ph name="END_LINK_OSS"/> katta o‘rni bor.</translation>
<translation id="5040124620086808431">Bu sahifa FlyWeb tomonidan bloklandi</translation>
<translation id="1953000035868532675">Himoya devori va antivirus dasturlari sozlamalarida FlyWeb tarmoqqa ulanishiga ruxsat bering.</translation>
<translation id="4949828774841497663">Ilovalar &gt; tizim sozlamalari &gt; tarmoq sahifasini ochib,
          faol tarmoqni tanlang, keyin Tafsilotlar... tugmasini bosing va tanlanishi mumkin har qanday
          proksi tanlovini bekor qiling.</translation>
<translation id="7584668345330431749">Bularni oching:
          FlyWeb menyusi &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Tarmoq va internet &gt; Proksi-server
          va keyin “Sozlamalarni avtomatik aniqlash” tanlovini bekor qiling.</translation>
<translation id="3145451630329266064">Bu sahifalar FlyWeb dastur ishlab chiquvchilari foydalanishi uchun moʻljallangan va faol ishlatish yoki sinovdan oʻtkazish mumkin emas. Ularni yoqish uchun <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/> havolasiga oʻting, debag sahifalarini yoqish uchun tugmani bosib, keyin yana bu sahifaga oʻting.</translation>
<translation id="2681118099728446983">FlyWeb paydo boʻlishida boshqa <ph name="BEGIN_LINK_OSS"/>ochiq kodli dastur<ph name="END_LINK_OSS"/> taʼminotining katta oʻrni bor.</translation>
<translation id="6888846095017247017">O‘zgartirishlar FlyWeb qaytadan ishga tushirilganda kuchga kiradi.</translation>
<translation id="8524328905288851065">FlyWeb ulanishi uchun Bluetooth orqali kirish ruxsati 
 kerak. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb paydo boʻlishida <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ochiq kodli dastur loyihasining katta oʻrni bor.</translation>
<translation id="7777112741998051633">Bu yerga o‘ting
          FlyWeb menyusi &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          va "<ph name="NO_PREFETCH_DESCRIPTION"/>"dan tanlanishni olib tashlang.
          Shunda muammo hal bo‘lmasa, samaradorlikni oshirish uchun
          yana shu parametrni tanlashni tavsiya qilamiz.</translation>
<translation id="4699594416850504200">Xavfsiz FlyWeb for Testing sahifasidasiz.</translation>
<translation id="6224789938625024797">FlyWeb faoliyati noto‘g‘ri yakunlandi.</translation>
<translation id="3593104813552438879">FlyWeb maslahati: Lens bilan qidiring</translation>
</translationbundle>