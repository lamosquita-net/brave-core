+String ShadowRoot::getHTML(const GetHTMLOptions* options) const {
+  // Chromium 125: serializableShadowRoots includes any shadow root marked
+  // serializable (open or closed); shadowRoots are always included.
+  ClosedRootsSet include_shadow_roots;
+  for (auto& shadow_root : options->shadowRoots()) {
+    include_shadow_roots.insert(shadow_root);
+  }
+  return CreateMarkup(this, kChildrenOnly, kDoNotResolveURLs,
+                      options->serializableShadowRoots()
+                          ? kIncludeSerializableShadowRoots
+                          : kOnlyProvidedShadowRoots,
+                      include_shadow_roots);
+}
