<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="130631256467250065">Οι αλλαγές σας θα εφαρμοστούν την επόμενη φορά που θα επανεκκινήσετε τη συσκευή σας.</translation>
<translation id="1555506416658437797">επεξεργαστεί τους τρόπους πληρωμής.</translation>
<translation id="8359495463485001719">Η αναφορά σφαλμάτων δεν είναι διαθέσιμη στο FlyWeb.</translation>
<translation id="6338530717474923868">Βλέπετε μια ασφαλή σελίδα FlyWeb</translation>
<translation id="5147169001159408844">Το FlyWeb προσπαθεί να τροποποιήσει τις ρυθμίσεις για τη συμπλήρωση τρόπων πληρωμής.</translation>
<translation id="5702992568540613683">Λογότυπο FlyWeb</translation>
<translation id="510342522494506803">Το FlyWeb προσπαθεί να επεξεργαστεί τους τρόπους πληρωμής.</translation>
<translation id="8375862260948854624">Το FlyWeb υλοποιήθηκε με τη βοήθεια του έργου ανοικτού κώδικα <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> και άλλου <ph name="BEGIN_LINK_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Μεταβείτε
          στο μενού του FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Ρυθμίσεις LAN
          και αποεπιλέξτε το πλαίσιο ελέγχου "Χρήση
          διακομιστή μεσολάβησης για το LAN".</translation>
<translation id="5040124620086808431">Αυτή η σελίδα έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="1953000035868532675">Επιτρέψτε στο FlyWeb να αποκτήσει πρόσβαση στο δίκτυο από τις ρυθμίσεις του τείχους προστασίας
          ή του λογισμικού προστασίας από ιούς που διαθέτετε.</translation>
<translation id="3442058224540562441">Μεταβείτε
          στο μενού του FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          και βεβαιωθείτε ότι η διαμόρφωσή σας είναι ρυθμισμένη στην επιλογή
          "χωρίς διακομιστή μεσολάβησης" ή "άμεση".</translation>
<translation id="585620188971323280">να τροποποιήσει τις ρυθμίσεις για τη συμπλήρωση τρόπων πληρωμής.</translation>
<translation id="2681118099728446983">Το FlyWeb υλοποιήθηκε με τη βοήθεια και άλλων <ph name="BEGIN_LINK_OSS"/>λογισμικών ανοικτού κώδικα<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το FlyWeb.</translation>
<translation id="1017070759373671177">Το FlyWeb υλοποιήθηκε με το έργο ανοικτού κώδικα <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Μεταβείτε
        στο μενού του FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        και αποεπιλέξτε "<ph name="NO_PREFETCH_DESCRIPTION"/>".
        Εάν με αυτόν τον τρόπο δεν επιλύεται το ζήτημά σας, συνιστούμε
        να ενεργοποιήσετε ξανά αυτήν την επιλογή για βελτιωμένη απόδοση.</translation>
<translation id="8187289872471304532">Μεταβείτε στο
          Applications &gt; System Preferences &gt; Network &gt; Advanced &gt; Proxies
          και αποεπιλέξτε τυχόν διακομιστές μεσολάβησης που έχουν επιλεγεί.</translation>
<translation id="4699594416850504200">Βλέπετε μια ασφαλή σελίδα FlyWeb for Testing</translation>
<translation id="6224789938625024797">Το FlyWeb δεν έκλεισε σωστά.</translation>
</translationbundle>