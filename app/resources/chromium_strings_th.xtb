<translation id="3900612994249740104">คีย์ API ของ FlyWeb หายไป การทำงานบางอย่างของ FlyWeb จะถูกปิดใช้งาน</translation>
<translation id="6824575001009586492">เรียกใช้แอปพลิเคชันพื้นหลังต่อไปเมื่อปิด FlyWeb</translation>
<translation id="5399208721646088502">มีโปรไฟล์ FlyWeb ที่ใช้บัญชีนี้อยู่แล้ว</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="7978410129406361692">เปลี่ยนไปใช้โปรไฟล์ FlyWeb ที่มีอยู่ไหม</translation>
<translation id="3412460710772753638">ในเครื่องมือจัดการรหัสผ่านบนอุปกรณ์นี้</translation>
<translation id="847273641988291714">โปรไฟล์ FlyWeb ช่วยให้คุณแยกข้อมูลต่างๆ ใน FlyWeb ออกจากกัน สร้างโปรไฟล์สำหรับเพื่อนและครอบครัว หรือแยกการทำงานออกจากความบันเทิง</translation>
<translation id="1558345997029205345">FlyWeb จะแจ้งให้ทราบเมื่อคุณลงชื่อเข้าใช้ด้วยรหัสผ่านที่ไม่รัดกุม</translation>
<translation id="956833467923764542">การดำเนินการนี้จะลบ <ph name="ITEMS_COUNT"/> รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ FlyWeb ด้วย <ph name="USER_EMAIL"/></translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> จะสลับไปมาระหว่างโปรไฟล์ FlyWeb ได้</translation>
<translation id="6724485219247982027">โปรดปิดหน้าต่าง FlyWeb ทั้งหมดแล้วลองอีกครั้ง</translation>
<translation id="763231524941489073">เราลบความสนใจที่เก่ากว่า 4 สัปดาห์โดยอัตโนมัติเพื่อปกป้องความเป็นส่วนตัวของคุณ ความสนใจอาจกลับมาปรากฏในรายการอีกเมื่อคุณท่องเว็บต่อ หรือคุณจะนำความสนใจที่ไม่ต้องการให้ FlyWeb พิจารณาออกก็ได้</translation>
<translation id="4856314253538330936">ประวัติการท่องเว็บ ซึ่งเป็นบันทึกรายการเว็บไซต์ที่คุณเข้าชมโดยใช้ FlyWeb ในอุปกรณ์นี้</translation>
<translation id="1054901839328542426">มีซอฟต์แวร์อันตรายในคอมพิวเตอร์ของคุณ FlyWeb ช่วยนำซอฟต์แวร์ดังกล่าวออก คืนการตั้งค่า และปิดใช้ส่วนขยายให้คุณได้ เพื่อให้เบราว์เซอร์กลับมาทำงานเป็นปกติอีกครั้ง</translation>
<translation id="199853864262219284">บัญชีอื่นได้ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก FlyWeb สร้างโปรไฟล์ให้คุณโดยเฉพาะได้</translation>
<translation id="9154454584386840012">คุณจะต้องใช้ macOS 10.15 ขึ้นไปเพื่อรับการอัปเดต FlyWeb ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ macOS 10.13</translation>
<translation id="7465608402296261674">หากต้องการส่งหมายเลขจาก <ph name="ORIGIN"/> ไปยังโทรศัพท์ Android ให้ลงชื่อเข้าใช้ FlyWeb ในอุปกรณ์ทั้งสองเครื่อง</translation>
<translation id="1543563097158722437">FlyWeb ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดลองตรวจสอบการเชื่อมต่ออินเทอร์เน็ต</translation>
<translation id="190360428475385352">ดูข้อมูลเพิ่มเติมเกี่ยวกับการปรับโฆษณาตามโปรไฟล์ของผู้ใช้ใน FlyWeb</translation>
<translation id="6611602069520888180">เปิดลิงก์ใน FlyWeb แท็บใหม่</translation>
<translation id="8701399577028839698">FlyWeb ช่วยให้คุณสามารถคลิกหมายเลขโทรศัพท์บนเว็บและโทรออกด้วย Skype ได้!</translation>
<translation id="2401189691232800402">ระบบ Chrome OS</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">รับความช่วยเหลือเกี่ยวกับ Chrome OS</translation>
<translation id="1864899808802540927">ดึงข้อมูลของคุณในเบราว์เซอร์ FlyWeb จาก <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="2736927994658608637">คุณจะต้องใช้ macOS 10.15 ขึ้นไปเพื่อรับการอัปเดต FlyWeb ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ macOS 10.14</translation>
<translation id="5175060854726708547">ปรับแต่งและควบคุม FlyWeb มีสิ่งที่คุณจำเป็นต้องทราบ โปรดคลิกเพื่อดูรายละเอียด</translation>
<translation id="606156353708638647">คลิกชื่อของคุณเพื่อเปิด FlyWeb และเริ่มท่องเว็บ</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> ลงชื่อเข้าใช้โปรไฟล์ FlyWeb นี้แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก FlyWeb สร้างโปรไฟล์ให้คุณโดยเฉพาะได้</translation>
<translation id="3376157109651222096">บัญชีของคุณจัดการโดย <ph name="MANAGER_NAME"/> ผู้ดูแลระบบสามารถดูและแก้ไขโปรไฟล์เบราว์เซอร์ FlyWeb นี้ รวมถึงข้อมูลในโปรไฟล์อย่างเช่นบุ๊กมาร์ก ประวัติการเข้าชม และรหัสผ่านได้</translation>
<translation id="8536259619256229278">FlyWeb กำลังพยายามคัดลอกรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="4041003017438130352">FlyWeb แนะนำให้สแกนไฟล์นี้เนื่องจากอาจเป็นอันตราย</translation>
<translation id="5667414856761616811">เกี่ยวกับ FlyWeb สำหรับการทดสอบ</translation>
<translation id="1152920704813762236">เกี่ยวกับ Chrome OS</translation>
<translation id="3703994572283698466">Chrome OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS"/>อื่นเพิ่มเติม ตลอดจน<ph name="BEGIN_LINK_LINUX_OSS"/>สภาพแวดล้อมในการพัฒนาซอฟต์แวร์ Linux<ph name="END_LINK_LINUX_OSS"/></translation>
<translation id="504994999924593940">ช่วยให้ FlyWeb ดียิ่งขึ้นด้วยการรายงาน<ph name="BEGIN_LINK"/>การตั้งค่าปัจจุบัน<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">การปรับปรุงด้านความปลอดภัยที่สำคัญและฟีเจอร์ใหม่ๆ พร้อมให้บริการในเวอร์ชันล่าสุด</translation>
<translation id="4055805654398742145">เครื่องมือจัดการรหัสผ่าน</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{องค์กรจะปิด FlyWeb โดยอัตโนมัติเมื่อไม่มีการใช้งานเป็นเวลา 1 นาที ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด}other{องค์กรจะปิด FlyWeb โดยอัตโนมัติเมื่อไม่มีการใช้งานเป็นเวลา # นาที ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด}}</translation>
<translation id="4148957013307229264">กำลังติดตั้ง...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - หน้าลงชื่อเข้าใช้ของเครือข่าย - FlyWeb</translation>
<translation id="4007949387571083162">พบกับแอป เกม ส่วนขยาย และธีมเด็ดๆ สำหรับ FlyWeb</translation>
<translation id="1595210458721188387">นี่เป็นภาษาที่ใช้ในการแสดง UI ของ FlyWeb</translation>
<translation id="4222932583846282852">กำลังยกเลิก...</translation>
<translation id="2564888740660198776">เชื่อมโยงข้อมูล FlyWeb กับบัญชีนี้ไหม</translation>
<translation id="8514458758262040082">รับความช่วยเหลือเกี่ยวกับ FlyWeb</translation>
<translation id="3393587701694585022">การติดตั้งล้มเหลวเนื่องจากมีข้อผิดพลาดที่ไม่ได้ระบุ หาก FlyWeb ทำงานอยู่ในขณะนี้ โปรดปิดและลองอีกครั้ง</translation>
<translation id="4304713468139749426">เครื่องมือจัดการรหัสผ่าน</translation>
<translation id="4334294535648607276">ดาวน์โหลดเสร็จสมบูรณ์</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> กำหนดว่าคุณต้องอ่านและยอมรับข้อกำหนดในการให้บริการต่อไปนี้ก่อนใช้อุปกรณ์นี้ ข้อกำหนดเหล่านี้ไม่ได้ขยาย แก้ไข หรือจำกัดข้อกำหนดของ Chrome OS</translation>
<translation id="1376968889000878095">ออกจาก FlyWeb ใช่ไหม</translation>
<translation id="6360389033094512399">ให้ FlyWeb ทำงานในพื้นหลัง</translation>
<translation id="4166347503469830337">กำหนดค่าและควบคุม FlyWeb</translation>
<translation id="4427306783828095590">การปกป้องที่ปรับปรุงแล้วทำได้มากกว่าบล็อกฟิชชิงและมัลแวร์</translation>
<translation id="8791209382165811772">เกี่ยวกับ FlyWeb สำหรับการทดสอบ</translation>
<translation id="834808339160590901">ยินดีต้อนรับสู่ FlyWeb เปิดหน้าต่างเบราวเซอร์ใหม่แล้ว</translation>
<translation id="1304885695888649052">FlyWeb ไม่ได้อัปเดตเนื่องจากเกิดข้อผิดพลาด <ph name="BEGIN_LINK"/>โปรดแก้ปัญหาการอัปเดต FlyWeb และการอัปเดตที่ไม่สำเร็จ<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">ดำเนินการต่อในโปรไฟล์ FlyWeb ใหม่ไหม</translation>
<translation id="4567424176335768812">คุณกำลังลงชื่อเข้าใช้เป็น <ph name="USER_EMAIL_ADDRESS"/> ตอนนี้คุณสามารถเข้าถึงบุ๊กมาร์ก ประวัติการเข้าชม และการตั้งค่าอื่นๆ บนอุปกรณ์ทั้งหมดที่ลงชื่อเข้าใช้</translation>
<translation id="4594305310729380060">ไปยังเครื่องมือจัดการรหัสผ่านบนอุปกรณ์นี้</translation>
<translation id="6046424510733540251">แอป FlyWeb</translation>
<translation id="4970880042055371251">เวอร์ชัน Chrome OS</translation>
<translation id="1936188352112244665">การอัปเดตใกล้จะเสร็จเรียบร้อยแล้ว เปิด FlyWeb อีกครั้งเพื่อให้การอัปเดตเสร็จสิ้น</translation>
<translation id="2962574118577609024">หากคุณแชร์รายงานการใช้งาน FlyWeb ด้วย รายงานดังกล่าวจะรวม URL ที่คุณเข้าชม</translation>
<translation id="9219132550163437762">ดูเหมือนว่าโปรไฟล์กำลังถูกใช้งานโดยกระบวนการอื่นของ FlyWeb (<ph name="PROCESS_ID"/>) บนคอมพิวเตอร์อีกเครื่อง (<ph name="HOST_NAME"/>) FlyWeb ล็อกโปรไฟล์ไว้เพื่อไม่ให้โปรไฟล์เกิดความเสียหาย หากคุณมั่นใจว่าไม่มีกระบวนการอื่นใดกำลังใช้โปรไฟล์นี้อยู่ คุณสามารถปลดล็อกโปรไฟล์และเปิด FlyWeb ใหม่</translation>
<translation id="4680828127924988555">ยกเลิกการติดตั้ง</translation>
<translation id="5227023869666757348">ก่อนหน้านี้มีผู้ลงชื่อเข้าใช้ FlyWeb ในคอมพิวเตอร์นี้ด้วยชื่อ <ph name="ACCOUNT_EMAIL_LAST"/> โปรดสร้างผู้ใช้ FlyWeb ใหม่เพื่อเก็บข้อมูลแยก</translation>
<translation id="1671154647029930623">ปิด FlyWeb ใช่ไหม</translation>
<translation id="4143239505982500022">ระบบเพิ่งนำการอัปเดตความปลอดภัยพิเศษไปใช้กับ FlyWeb รีสตาร์ทเลย แล้วเราจะคืนค่าแท็บให้คุณ</translation>
<translation id="1347247057384060764">คุณเปลี่ยนใจได้ทุกเมื่อในการตั้งค่า FlyWeb การทดลองใช้จะทำงานพร้อมกับวิธีแสดงโฆษณาปัจจุบัน คุณจึงจะไม่เห็นการเปลี่ยนแปลงโดยทันที</translation>
<translation id="4259200560913816786">FlyWeb ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดรอ 24 ชั่วโมงแล้วลองอีกครั้งหรือ<ph name="BEGIN_LINK"/>ตรวจสอบรหัสผ่านในบัญชี FlyWeb<ph name="END_LINK"/></translation>
<translation id="3469649164996417993">การดำเนินการนี้จะใช้โปรแกรมตรวจตัวสะกดแบบเดียวกับใน Brave Search ข้อความที่คุณพิมพ์ในเบราว์เซอร์จะส่งไปยัง FlyWeb คุณปรับเปลี่ยนลักษณะการทำงานนี้ได้ทุกเมื่อในการตั้งค่า</translation>
<translation id="2991144524835127379">กฎขาเข้าสำหรับ FlyWeb เพื่ออนุญาตการเข้าชมแบบ mDNS</translation>
<translation id="6208903184719035736">เปิดอีกครั้งเพื่ออัปเดต FlyWeb</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{องค์กรจะลบข้อมูลการท่องเว็บโดยอัตโนมัติเมื่อไม่มีการใช้ FlyWeb เป็นเวลา 1 นาที ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด แต่แท็บที่มีอยู่จะยังคงเปิดไว้}other{องค์กรจะลบข้อมูลการท่องเว็บโดยอัตโนมัติเมื่อไม่มีการใช้ FlyWeb เป็นเวลา # นาที ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด แต่แท็บที่มีอยู่จะยังคงเปิดไว้}}</translation>
<translation id="7174589544844983914">FlyWeb กำลังอยู่ในโหมดทำงานในพื้นหลัง</translation>
<translation id="7792628702371319769">ผู้เยี่ยมชมสามารถใช้ FlyWeb โดยไม่ทิ้งร่องรอยไว้</translation>
<translation id="2760069255902967585">เพิ่มตัวคุณเองใน FlyWeb</translation>
<translation id="4239638419916712076">FlyWeb กำลังพัฒนาฟีเจอร์ใหม่ๆ ที่จะช่วยให้เว็บไซต์มอบประสบการณ์การท่องเว็บได้เหมือนเดิมแต่ใช้ข้อมูลของคุณน้อยลง</translation>
<translation id="387444474697464273">ไม่มีรหัสผ่านที่บันทึกไว้ FlyWeb จะตรวจสอบรหัสผ่านได้เมื่อคุณบันทึกรหัสผ่านไว้</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/> ลงชื่อเข้าใช้โปรไฟล์ FlyWeb นี้แล้ว การดำเนินการนี้จะสร้างโปรไฟล์ FlyWeb ใหม่สำหรับ <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="8295539942024823191">เปิด FlyWeb ขึ้นมาใหม่เพื่อให้การเปลี่ยนแปลงมีผล</translation>
<translation id="5374328929709976901">เมื่อเริ่มการทดสอบและหาก FlyWeb สุ่มคุณไปไว้ในการทดสอบที่ดำเนินอยู่ ประวัติการท่องเว็บจะส่งผลต่อโฆษณาที่คุณเห็นและความสนใจที่ระบบคาดคะเนไว้ดังที่แสดงอยู่ด้านล่างนี้ FlyWeb ลบความสนใจเป็นประจำทุกเดือนเพื่อปกป้องความเป็นส่วนตัวของคุณ</translation>
