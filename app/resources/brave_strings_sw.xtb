<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="1026101648481255140">Endelea na Usakinishaji</translation>
<translation id="7099479769133613710">Fungua tena ili usasishe Mfumo wa Uendeshaji wa FlyWeb</translation>
<translation id="291426170030461697">FlyWeb inapendekeza ukague kiendelezi hiki</translation>
<translation id="1549005488226693697">FlyWeb hutumia seva za FlyWeb, tovuti inapoomba viungo vipakiwe mapema kwenye ukurasa wake kwa njia ya faragha. Hali hii huficha utambulisho wako usionekane kwenye tovuti inayopakiwa mapema lakini FlyWeb hufahamu tovuti zinazopakiwa mapema.</translation>
<translation id="1065672644894730302">Mapendeleo yako hayawezi kusomwa.

Baadhi ya vipengele huenda visipatikane na mabadiliko katika mapendeleo hayatahifadhiwa.</translation>
<translation id="8908267645832965492">Mzazi wako amezima "Ruhusa za tovuti, programu na viendelezi" kwenye FlyWeb</translation>
<translation id="6896681084876612310">FlyWeb inaweza kukusaidia ulinde akaunti yako dhidi ya ufichuzi haramu wa data, viendelezi vibaya na zaidi</translation>
<translation id="1368460307421081773">FlyWeb ingependa kuhamisha manenosiri yako. Andika nenosiri lako la Windows ili uruhusu shughuli hii.</translation>
<translation id="7307912249127683931">FlyWeb ni kivinjari chako chaguomsingi</translation>
<translation id="4556715463645168547">Ili uangalie kama manenosiri yako ni salama dhidi ya ufichuzi haramu wa data na matatizo mengine ya usalama, <ph name="BEGIN_LINK"/>ingia katika akaunti kwenye FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Bofya menyu ya FlyWeb</translation>
<translation id="1184145431117212167">Imeshindwa kuweka kwenye kifaa kwa sababu toleo la Windows ulilonalo halitumiki.</translation>
<translation id="4380351562011537903">Kuhusu FlyWeb</translation>
<translation id="2593084789070248821">Ili uonyeshe dirisha lako, washa kinasa skrini katika FlyWeb kwenye Mapendeleo ya Mfumo.</translation>
<translation id="1203500561924088507">Asante kwa kusakinisha. Ni lazima uzime kisha uwashe tena kivinjari chako kabla ya kutumia <ph name="BUNDLE_NAME"/>.</translation>
<translation id="4750836834956739196">Kichupo hiki kilipokuwa hakitumiki, nafasi ya hifadhi ilirejeshwa ili FlyWeb iwe na kasi ya utendaji. Unaweza kuchagua tovuti hii iendelee kutumika kila wakati.</translation>
<translation id="3190759351483708314">FlyWeb imezuia upakuaji huu kwa sababu faili si salama</translation>
<translation id="5879469261638423015">Unapoingia katika akaunti za huduma za FlyWeb kama Gmail au YouTube ukitumia <ph name="USER_EMAIL"/>, unaweza kuingia katika akaunti kiotomatiki kwenye FlyWeb ukitumia akaunti ile ile</translation>
<translation id="1290883685122687410">Hitilafu ya kuweka mipangilio: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Weka mipangilio ya wasifu wako mpya wa FlyWeb</translation>
<translation id="609743863669742325">FlyWeb inahitaji ruhusa ya kufikia Bluetooth ili kugundua 
 vifaa vyenye Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">Futa pia data kutoka FlyWeb (<ph name="URL"/>)</translation>
<translation id="4150708158890309866">Umeingia kwenye FlyWeb!</translation>
<translation id="4713192356155907986">Pata usaidizi kuhusu FlyWeb ya Majaribio</translation>
<translation id="1497802159252041924">Hitilafu ya kusakinisha: <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">Shiriki kichupo cha FlyWeb</translation>
<translation id="8196829963313696543">FlyWeb inahitaji ruhusa ya kufikia kamera yako ili iunde ramani ya 3D ya mazingira yako</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{Kiendelezi hiki hakitumiki tena. FlyWeb inapendekeza ukiondoe.}other{Viendelezi hivi havitumiki tena. FlyWeb inapendekeza uviondoe.}}</translation>
<translation id="852852907317361085">Zana usalama za FlyWeb</translation>
<translation id="4096742538387076253">FlyWeb inahitaji kuthibitisha kuwa ni wewe kabla ya kuhifadhi baadhi ya data kwenye Akaunti yako ya FlyWeb na kutumiwa kwenye vifaa vyako vyote. Ukiondoka kwenye akaunti, data hii itasalia kwenye kifaa hiki.</translation>
<translation id="481155564361715417">FlyWeb ingependa kufuta data yako ya Kidhibiti cha Manenosiri. Weka nenosiri lako la Windows ili uruhusu hatua hii.</translation>
<translation id="3961251277542681013">Kagua vidhibiti muhimu vya faragha na usalama katika FlyWeb</translation>
<translation id="1640672724030957280">Inapakua...</translation>
<translation id="6153580651793156880">Ili kusaidia kuboresha vipengele hivi, FlyWeb hutumia FlyWeb data ya jinsi unavyovitumia. Data hii inaweza kusomwa, kuchakatwa na kuwekewa vidokezo na wahakiki wanadamu.</translation>
<translation id="1722488837206509557">Hii itakuruhusu kuchagua kwenye vifaa vinavyopatikana na kuonyesha maudhui kwenye vifaa hivyo.</translation>
<translation id="2383861520542390014">Unaweza kuona na kuondoa mada zinazokuvutia zinazotumiwa na tovuti kukuonyesha matangazo. FlyWeb hukadiria mambo yanayokuvutia kulingana na historia yako ya kuvinjari ya hivi karibuni.</translation>
<translation id="5695205873161614119">FlyWeb itafuta data ya kuvinjari hivi karibuni</translation>
<translation id="8939535770474283898">FlyWeb itajaribu kuboresha usogezaji ili utumie HTTPS</translation>
<translation id="7385422968404728039">FlyWeb itazima kisha iwake baada ya <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Wakati kiendelezi cha HTTPS hakipatikani, FlyWeb itatumia muunganisho usio salama bila kukutahadharisha</translation>
<translation id="307170399141486420">Acha FlyWeb iendeshe katika mandharinyuma</translation>
<translation id="2473319786107120819">Sakinisha FlyWeb Upya</translation>
<translation id="2533324957407080119">FlyWeb inajaribu <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="3403116471618205223">Ili ufute data ya kuvinjari kwenye kifaa hiki pekee, bila kuifuta katika Akaunti yako ya FlyWeb, <ph name="BEGIN_LINK"/>ondoka kwenye akaunti ya FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="6434738578659849497">Tovuti zinaweza kuhifadhi maelezo kuhusu mambo yanayokuvutia kwa kutumia FlyWeb. Kwa mfano, iwapo utatembelea tovuti ili kununua viatu kwa ajili ya kukimbia mbio za marathoni, tovuti hiyo huenda ikatambua kuwa moja ya mambo yanayokuvutia ni kukimbia mbio za marathoni. Baadaye, iwapo utatembelea tovuti tofauti ili kujisajili kwa ajili ya mbio, tovuti hiyo huenda ikakuonyesha tangazo la viatu vya kukimbilia kulingana na mambo yanayokuvutia.</translation>
<translation id="4824940465467423308">Unaingia katika akaunti ukitumia akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye FlyWeb. Data yako ya FlyWeb, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio nyingine itahusishwa na<ph name="USER_NAME"/> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za FlyWeb, lakini hutaweza  kuunganisha data hii na akaunti nyingine. Unaweza kwa hiari kuunda wasifu mpya ili kuweka data yako ya FlyWeb iliyo kando. <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">Kwa kuzima kipengele hiki, unaweza kuingia katika tovuti za FlyWeb kama vile Gmail bila kuingia katika akaunti ya FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb haiamiliki. Zindua upya sasa?</translation>
<translation id="4035053306113201399">Mfumo wa Uendeshaji wa FlyWeb unahitaji kuzimwa na kuwashwa ili utekeleze usasishaji.</translation>
<translation id="3750729306035486751">FlyWeb imezuia upakuaji huu kwa sababu aina hii ya faili kwa kawaida haipakuliwi na huenda si salama</translation>
<translation id="1953553007165777902">Inapakua... Zimesalia dakika <ph name="MINUTE"/></translation>
<translation id="6956650624767954726">FlyWeb haijafaulu kubainisha wala kuweka kivinjari chaguomsingi</translation>
<translation id="6495079989036864983">Hatua hii itafuta kipengee 1 kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika FlyWeb ukitumia <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Imeshindwa kusakinisha. Tafadhali jaribu tena.</translation>
<translation id="4252651275570549255">Ili uangalie kama manenosiri yako mengine ni salama dhidi ya ufichuzi haramu wa data na matatizo mengine ya usalama, <ph name="BEGIN_LINK"/>ingia katika akaunti kwenye FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">Chagua iwapo ungependa kujumuisha historia kwenye FlyWeb ili upate hali ya utumiaji inayokufaa zaidi katika huduma za FlyWeb</translation>
<translation id="8924891216494775926">FlyWeb imezuia upakuaji huu kwa sababu faili inapotosha na huenda ikafanya mabadiliko yasiyotarajiwa kwenye kifaa chako</translation>
<translation id="1868972292925460871">Maelezo kuhusu jinsi FlyWeb inavyodhibiti vyeti vyake vya msingi</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Shirika lako hufuta kiotomatiki data ya kuvinjari FlyWeb isipotumika kwa dakika 1. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}other{Shirika lako hufuta kiotomatiki data ya kuvinjari FlyWeb isipotumika kwa dakika #. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}}</translation>
<translation id="2126108037660393668">Faili iliyopakuliwa imeshindwa kuthibitishwa.</translation>
<translation id="4474394796469499134">FlyWeb imezuia upakuaji huu kwa sababu tovuti haitumii muunganisho salama na huenda faili imeharibiwa</translation>
<translation id="2482315227745493547">Unaweza kufungua alamisho, hali ya kusoma na zaidi katika menyu ya FlyWeb</translation>
<translation id="6765231735885996239">Weka mipangilio ya FlyWeb upendavyo</translation>
<translation id="2174917724755363426">Usakinishaji haujakamilika. Je, una uhakika unataka kughairi?</translation>
<translation id="2937508664417729967">FlyWeb - Kuingia katika Akaunti ya Mtandao - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Hitilafu ya ukaguzi wa sasisho: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Ondoa akaunti kwenye FlyWeb</translation>
<translation id="6707114110652917144">Tovuti hatari. FlyWeb imeondoa arifa.</translation>
<translation id="5461117213064611992">Hujatembelea hivi majuzi. FlyWeb imeondoa <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/></translation>
<translation id="2726680594710751908">Kama unatumia kompyuta pamoja na wengine, marafiki na familia wanaweza kuvinjari tofauti na kusanidi FlyWeb jinsi wapendavyo.</translation>
<translation id="5067150284614317159">Hukagua URL ili kuona iwapo zipo kwenye orodha ya tovuti zisizo salama zilizohifadhiwa katika FlyWeb. Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, FlyWeb inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwa kipengele cha Kuvinjari Salama.</translation>
<translation id="3002925333439341552">FlyWeb ikiwashwa, huwa inapakia mapema kurasa, hali inayofanya shughuli za utafutaji na kuvinjari ziwe za haraka zaidi.</translation>
<translation id="3256927121768528350">Ili uweze kutuma namba kwa simu yako ya Android kutoka hapa, ingia katika akaunti kwenye FlyWeb ukitumia vifaa vyote viwili.</translation>
<translation id="2359808026110333948">Endelea</translation>
<translation id="7339360994527471629">Kiendelezi cha "<ph name="EXTENSION_NAME"/>" kinakuhitaji uingie katika FlyWeb</translation>
<translation id="4126251160852694747">Ili utumie kiendelezi hiki ukitumia <ph name="USER_EMAIL_ADDRESS"/>, ingia katika FlyWeb.</translation>
<translation id="8418845734693287262">Mfumo wa Uendeshaji wa FlyWeb haukusawazisha data yako kwa sababu maelezo ya kuingia katika akaunti yako yamepitwa na wakati.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha FlyWeb kilikuwa kinafikia kifaa 1 cha HID}=1{Kiendelezi kimoja au zaidi cha FlyWeb kinafikia kifaa 1 cha HID}other{Kiendelezi kimoja au zaidi cha FlyWeb kinafikia vifaa # vya HID}}</translation>
<translation id="1364879203203742966">FlyWeb inahitaji ruhusa ya kufikia kamera na maikrofoni kwa ajili ya tovuti hii</translation>
<translation id="1968013196034892522">Kwa kutumia <ph name="BEGIN_LINK"/>zana kutoka FlyWeb<ph name="END_LINK"/>, unaweza kuvinjari kwa usalama na kuwa na udhibiti</translation>
<translation id="2451727308784734061">Tumia njia yako ya mkato ili ufikie Kidhibiti cha Manenosiri kwa haraka. Unaweza kuhamishia njia yako ya mkato kwenye skrini ya kwanza ya kompyuta yako au kifungua programu.</translation>
<translation id="3224379053610845181">FlyWeb itafungwa hivi karibuni</translation>
<translation id="3840682988105604367">Katika FlyWeb</translation>
<translation id="2485422356828889247">Ondoa</translation>
<translation id="2513154137948333830">Unahitaji kuwashwa tena: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="6823116595279840454">FlyWeb inajaribu kubadilisha manenosiri yaliyopo. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="2691552788029831386">FlyWeb inahitaji ruhusa ya kufikia hifadhi ili ipakue faili</translation>
<translation id="2275866327478859777">Kisaidizi cha FlyWeb</translation>
<translation id="683641781063074351">Ili upate manenosiri yako na zaidi kwenye vifaa vyako vyote, ingia katika akaunti kwenye FlyWeb</translation>
<translation id="7717615706977383025">Data yoyote ya FlyWeb inayozalishwa unapotumia wasifu huu (kama vile alamisho ulizoweka, historia, manenosiri na mipangilio mingine) inaweza kuondolewa na msimamizi wa wasifu huu wa kazini. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">Endelea kutumia FlyWeb</translation>
<translation id="259935314519650377">Imeshindwa kuweka akiba ya kisakinishaji kilichopakuliwa. Hitilafu: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="6852129081045176385">FlyWeb hufanya kazi kwa kasi na vipengele vinavyotumia JavaScript vinapaswa kufanya kazi kama vilivyobuniwa (inapendekezwa)</translation>
<translation id="3827993926722004004">Hitilafu ya mfumo wa uendeshaji imetokea wakati wa usakinishaji. Tafadhali pakua FlyWeb tena.</translation>
<translation id="333184635927514678">Kama unatumia kifaa pamoja na wengine, marafiki na familia wanaweza kuvinjari kivyao na kuweka mipangilio ya FlyWeb wapendavyo</translation>
<translation id="1661841342483968180"><ph name="ACCOUNT_FIRST_NAME"/>, karibu kwenye FlyWeb</translation>
<translation id="1257705702166647105">Kichupo cha FlyWeb</translation>
<translation id="2796283369875688710">Kwa usalama ulioongezwa, FlyWeb itasimba data yako kwa njia fiche.</translation>
<translation id="1118215875395945816">Ili uondoe Akaunti yako ya FlyWeb kwenye FlyWeb, ondoka kwenye akaunti</translation>
<translation id="2738871930057338499">Imeshindwa kuunganisha kwenye Intaneti. HTTP 403 Hairuhusiwi. Tafadhali angalia mipangilio yako ya seva mbadala.</translation>
<translation id="2770231113462710648">Badilisha kivinjari chaguomsingi kiwe:</translation>
<translation id="7907238427168022751">Kiendelezi hiki kina programu hasidi na si salama. Kiondoe kwenye FlyWeb ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="2799223571221894425">Funga na ufungue</translation>
<translation id="8990114339313395142">Hatua hii itafungua wasifu mpya wa <ph name="USER_EMAIL_ADDRESS"/> kwenye FlyWeb</translation>
<translation id="2846251086934905009">Hitilafu ya kusakinisha: Kisakinishaji hakikukamilisha mchakato. Usakinishaji umeghairiwa.</translation>
<translation id="1339341044496643931">Ondoa kwenye FlyWeb...</translation>
<translation id="4922993584046885552">Hulinda usalama wako kwenye FlyWeb na inaweza kutumiwa kuboresha usalama wako kwenye programu nyingine za FlyWeb unapokuwa umeingia katika akaunti</translation>
<translation id="2885378588091291677">Kidhibiti cha Shughuli</translation>
<translation id="3806033752149316261">Kuhusu FlyWeb</translation>
<translation id="2915996080311180594">Ifunge kisha Uifungue Baadaye</translation>
<translation id="2928420929544864228">Usakinishaji umekamilika.</translation>
<translation id="2945997411976714835">Hitilafu ya kusakinisha: Mchakato wa kisakinishaji umeshindwa kuanza.</translation>
<translation id="1661079783259785361">FlyWeb imesasishwa</translation>
<translation id="5447533789927384736">Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, FlyWeb inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwenye kipengele cha Kuvinjari Salama</translation>
<translation id="1003068427103858026">FlyWeb inaweza kufanya vichupo hivi visitumike ili kuboresha hali yako ya kuvinjari na kufuta data ili upate nyenzo.</translation>
<translation id="8404327407921790238">Fungua <ph name="URL"/> kwenye kichupo kipya katika FlyWeb.</translation>
<translation id="1244955229468464260">FlyWeb imeshindwa kukagua manenosiri yako. Jaribu tena baadaye.</translation>
<translation id="8841609317523323027">Inaongeza kwenye FlyWeb...</translation>
<translation id="3038232873781883849">Inasubiri kusakinisha...</translation>
<translation id="4451837224464070850">Wasifu nyingine za FlyWeb</translation>
<translation id="7859502023458300952">Saidia kuboresha FlyWeb kwa kutuma ripoti za kuacha kufanya kazi na <ph name="UMA_LINK"/> kwenda FlyWeb</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha FlyWeb kilikuwa kinafikia kifaa 1 cha USB}=1{Kiendelezi kimoja au zaidi cha FlyWeb kinafikia kifaa 1 cha USB}other{Kiendelezi kimoja au zaidi cha FlyWeb kinafikia vifaa # vya USB}}</translation>
<translation id="4133194854947529871">Historia yako ya kuvinjari huathiri matangazo unayoyaona na mambo yanayokuvutia kama inavyokadiriwa hapa chini. Ili kulinda faragha yako, FlyWeb inafuta mambo yako yanayokuvutia kadiri unavyoendelea kutumia kila mwezi. Mambo yanayokuvutia yanaweza kuonyeshwa upya isipokuwa ukiyaondoa.</translation>
<translation id="1407857531570256859">Kisakinishi kilishindwa kufinyuza kumbukumbu. Tafadhali pakua FlyWeb tena.</translation>
<translation id="1309738977648134943">FlyWeb inatumia maikrofoni yako.</translation>
<translation id="2251813826843049011">Kichupo hiki kinatumia nyenzo za ziada. Ruhusu FlyWeb ikifanye kisitumike ili kuboresha utendaji wako.</translation>
<translation id="6274649779206195384">Zindua upya FlyWeb</translation>
<translation id="6773570808762718524">Weka wasifu wako mpya wa FlyWeb uwe upendavyo</translation>
<translation id="2700572810650522793">Lo! FlyWeb imevurugika. Unataka kuzindua upya sasa?</translation>
<translation id="5958835776851191812">Ili uondoe Akaunti yako ya FlyWeb kwenye FlyWeb, ondoka kwenye FlyWeb katika ukurasa wa Mipangilio</translation>
<translation id="5449297306961970452">FlyWeb haiwezi kusoma na kuandika kwenye saraka yake ya data:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="7452618639149696924">V8 ni mtambo wa JavaScript na WebAssembly wa FlyWeb unaotumika kuboresha utendaji wa tovuti</translation>
<translation id="6755586344927335130">Umesakinisha toleo la FlyWeb la <ph name="PRODUCT_VERSION"/></translation>
<translation id="3286538390144397061">Zima na uwashe sasa</translation>
<translation id="3900612994249740104">Funguo za FlyWeb API zinakosekana. Utendaji fulani wa FlyWeb utazimwa.</translation>
<translation id="6824575001009586492">Endelea kuendesha programu za mandharinyuma wakati FlyWeb imefungwa</translation>
<translation id="8400063458073122271">Tunapoweka mipangilio ya idhini ya kufikia akaunti, bado unaweza kutumia FlyWeb. Huenda usiweze kufikia baadhi ya nyenzo hadi uwekaji wa mipangilio ukamilike.</translation>
<translation id="2595215790271940091">FlyWeb itakutahadharisha kabla ya kupakia tovuti yoyote kwa kutumia muunganisho usio salama</translation>
<translation id="3701353923785984059">Utaondolewa kwenye tovuti nyingi ukifunga madirisha yote ya FlyWeb, isipokuwa katika Akaunti yako ya FlyWeb ikiwa umeingia katika FlyWeb. Ili uruhusu tovuti zikukumbuke, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="5399208721646088502">Tayari kuna wasifu kwenye FlyWeb unaotumia akaunti hii</translation>
<translation id="2645435784669275700">Mfumo wa uendeshaji wa FlyWeb</translation>
<translation id="7978410129406361692">Ungependa kutumia wasifu uliopo wa FlyWeb?</translation>
<translation id="3412460710772753638">Katika Kidhibiti cha Manenosiri kwenye kifaa hiki</translation>
<translation id="847273641988291714">Ukitumia kipengele cha wasifu kwenye FlyWeb unaweza kutenganisha vitu vyako vyote vya FlyWeb. Tengeneza wasifu wa marafiki na familia au utenganishe kazi na burudani.</translation>
<translation id="1558345997029205345">FlyWeb itakuarifu ukiingia katika akaunti ukitumia nenosiri lililoathiriwa</translation>
<translation id="956833467923764542">Hatua hii itafuta vipengee <ph name="ITEMS_COUNT"/> kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika FlyWeb ukitumia <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">Unaweza kubonyeza <ph name="SHORTCUT"/> ili ubadilishe kati ya wasifu mmoja wa FlyWeb na mwingine</translation>
<translation id="6724485219247982027">Tafadhali funga madirisha yote ya FlyWeb na ujaribu tena.</translation>
<translation id="1582211253241551883">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER"/>.  Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti kwenye FlyWeb katika wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="763231524941489073">Ili kulinda faragha yako, tunafuta kiotomatiki mambo yanayokuvutia ambayo yapo kwenye orodha kwa zaidi ya wiki nne. Kadiri unavyoendelea kuvinjari, jambo linalokuvutia linaweza kuonekana tena kwenye orodha. Au unaweza kuondoa mambo yanayokuvutia ambayo usingependa FlyWeb iyazingatie.</translation>
<translation id="4856314253538330936">Historia yako ya kuvinjari, kumbukumbu ya tovuti ulizozitembelea ukitumia FlyWeb kwenye kifaa hiki.</translation>
<translation id="3597003331831379823">Imeshindwa kuweka mipangilio ikitumia ufikiaji maalum. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="7465608402296261674">Ili uweze kutuma namba kwa simu yako ya Android kutoka <ph name="ORIGIN"/>, ingia katika akaunti kwenye FlyWeb ukitumia vifaa vyote viwili.</translation>
<translation id="3667616615096815454">Imeshindwa kusakinisha, seva haitambui programu hii.</translation>
<translation id="1483758453057146021">Ili uonyeshe skrini yako, washa kinasa skrini katika FlyWeb kwenye Mapendeleo ya Mfumo.</translation>
<translation id="1543563097158722437">FlyWeb imeshindwa kukagua manenosiri yako. Jaribu kuangalia muunganisho wako wa Intaneti.</translation>
<translation id="190360428475385352">Pata maelezo zaidi kuhusu kuweka mapendeleo ya matangazo kwenye FlyWeb</translation>
<translation id="6611602069520888180">Fungua kiungo katika kichupo kipya cha FlyWeb</translation>
<translation id="2591356225047803326">Unganisha FlyWeb na huduma nyingine za FlyWeb ili upate mapendeleo na madhumuni mengine</translation>
<translation id="1771882170639856394">Dhibiti Wasifu wa FlyWeb</translation>
<translation id="3782148374606932577">Fahamu kwa nini FlyWeb huzuia baadhi ya vipakuliwa</translation>
<translation id="4640643918757362950">FlyWeb itakufahamisha ikiwa kuna chochote kinachohitaji ukague</translation>
<translation id="2179738813053854729">FlyWeb hupakia mapema kurasa unazoweza kutembelea, ili zipakiwe kwa haraka zaidi unapozitembelea</translation>
<translation id="2401189691232800402">Mfumo wa Uendeshaji wa FlyWeb</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">Pata usaidizi wa kutumia Mfumo wa Uendeshaji wa FlyWeb</translation>
<translation id="1864899808802540927">Pata vitu vinavyohusu kivinjari chako cha FlyWeb kwenye<ph name="ACCOUNT_EMAIL"/></translation>
<translation id="5175060854726708547">Dhibiti na uweke mapendeleo kwenye FlyWeb. Unahitaji kushughulikia jambo fulani. Bofya ili upate maelezo.</translation>
<translation id="606156353708638647">Bofya jina lako ili ufungue FlyWeb na uanze kuvinjari.</translation>
<translation id="5145107420478372433">Tayari <ph name="EXISTING_USER"/> ameingia katika akaunti kwenye wasifu huu kwenye FlyWeb. Ili utenganishe shughuli zako za kuvinjari, FlyWeb inaweza kukutengenezea wasifu wako mwenyewe.</translation>
<translation id="3376157109651222096">Akaunti yako inadhibitiwa na <ph name="MANAGER_NAME"/>. Msimamizi wako anaweza kuona na kubadilisha wasifu wa kivinjari hiki cha FlyWeb na data yake kama vile alamisho, historia na manenosiri.</translation>
<translation id="3941890832296813527">Hitilafu ya kusakinisha: Jina la faili ya kisakinishaji si sahihi au haliwezi kutumika.</translation>
<translation id="8536259619256229278">FlyWeb inajaribu kunakili manenosiri. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="3849784651193576458">Pata maelezo ya jinsi ya FlyWeb inavyokufanya inavyohakikisha usalama wako</translation>
<translation id="5667414856761616811">Kuhusu &amp;FlyWeb ya Majaribio</translation>
<translation id="1152920704813762236">Kuhusu Mfumo wa Uendeshaji wa FlyWeb</translation>
<translation id="3703994572283698466">Mfumo wa Uendeshaji wa FlyWeb unawezeshwa na <ph name="BEGIN_LINK_CROS_OSS"/>programu huria<ph name="END_LINK_CROS_OSS"/> za ziada, kama vile <ph name="BEGIN_LINK_LINUX_OSS"/>mazingira ya wasanidi programu wa Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="504994999924593940">Saidia kuboresha FlyWeb kwa kuripoti kuhusu <ph name="BEGIN_LINK"/>mipangilio ya sasa<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Maboresho muhimu ya usalama na vipengele vipya vinapatikana katika toleo jipya.</translation>
<translation id="4055805654398742145">Kidhibiti cha Nenosiri</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Shirika lako hufunga FlyWeb kiotomatiki isipotumika kwa dakika 1. Data ya kuvinjari hufutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.}other{Shirika lako hufunga FlyWeb kiotomatiki isipotumika kwa dakika #. Data ya kuvinjari hufutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.}}</translation>
<translation id="4105099155797156500">Nenda kwenye ukurasa wa Kuhusu FlyWeb</translation>
<translation id="4148957013307229264">Inasakinisha...</translation>
<translation id="815587935943511961">Shirika lako linaweza kuona na kudhibiti data ya kuvinjari katika wasifu wako wa kazini, kama vile alamisho, historia na manenosiri yako. Haliwezi kuona data ya kuvinjari katika wasifu wa binafsi kwenye FlyWeb.</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - Kuingia katika Akaunt ya Mtandao - FlyWeb</translation>
<translation id="4007949387571083162">Gundua programu, michezo, viendelezi na mandhari bora ya FlyWeb.</translation>
<translation id="1595210458721188387">Lugha hii inatumiwa kuonyesha Kiolesura cha FlyWeb</translation>
<translation id="4222932583846282852">Inaghairi...</translation>
<translation id="4224210481850767180">Mchakato wa kuweka kwenye kifaa umekatishwa.</translation>
<translation id="2564888740660198776">Ungependa kuunganisha data yako ya FlyWeb kwenye akaunti hii?</translation>
<translation id="7337819873931851298">Hukutahadharisha kuhusu tovuti hatari, hata zile ambazo hazikutambuliwa na FlyWeb hapo awali, kwa kuchambua data zaidi kutoka kwenye tovuti kuliko ulinzi wa kawaida. Unaweza kuchagua kuruka tahadhari za FlyWeb.</translation>
<translation id="8391959103619318249">Ondoka kwenye FlyWeb</translation>
<translation id="8514458758262040082">Pata usaidizi wa kutumia FlyWeb</translation>
<translation id="4281844954008187215">Sheria na Masharti</translation>
<translation id="3393587701694585022">Usanidi umeshindwa kwa sababu ya hitilafu isiyojulikana. Ikiwa FlyWeb inaendesha sasa, tafadhali ifunge na ujaribu tena.</translation>
<translation id="4304713468139749426">Kidhibiti cha Manenosiri</translation>
<translation id="4334294535648607276">Upakuaji umekamilika.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> inahitaji usome na ukubali Sheria na Masharti yafuatayo kabla ya kutumia kifaa hiki. Masharti haya hayapanui, hayarekebishi wala hayapunguzi Sheria na Masharti ya Mfumo wa Uendeshaji wa FlyWeb.</translation>
<translation id="1376968889000878095">Ungependa kufunga FlyWeb?</translation>
<translation id="6360389033094512399">Ruhusu FlyWeb itumike Chinichini</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{FlyWeb inapendekeza ukiondoe. <ph name="BEGIN_LINK"/>Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK"/>}other{FlyWeb inapendekeza uviondoe. <ph name="BEGIN_LINK"/>Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">Dhibiti na ugeuze FlyWeb ikufae</translation>
<translation id="4427306783828095590">Kipengele cha ulinzi wa hali ya juu hufanya mengi zaidi ili kuzuia programu hasidi na wizi wa data binafsi</translation>
<translation id="4434353761996769206">Hitilafu ya kisakinishaji: <ph name="INSTALLER_ERROR"/></translation>
<translation id="8791209382165811772">Kuhusu FlyWeb ya Majaribio</translation>
<translation id="4501471624619070934">Imeshindwa kusakinisha kwa sababu ufikiaji umedhibitiwa katika nchi hii.</translation>
<translation id="3546782282376530369">Kiendelezi hiki hakijachapisha desturi za faragha, kama vile jinsi kinavyokusanya na kutumia data. FlyWeb inapendekeza ukiondoe.</translation>
<translation id="834808339160590901">Karibu kwenye FlyWeb; dirisha jipya la kivinjari limefunguliwa</translation>
<translation id="5094033276783634414">FlyWeb inahitaji ruhusa ili kuweka ramani ya mazingira yako na kufuatilia mikono yako</translation>
<translation id="3363095592946520579">Tayari umeingia katika akaunti ukitumia <ph name="USER_EMAIL_ADDRESS"/> katika wasifu mwingine wa FlyWeb</translation>
<translation id="1304885695888649052">FlyWeb haijasasishwa, hitilafu fulani imetokea. <ph name="BEGIN_LINK"/>Rekebisha matatizo ya sasisho la FlyWeb na masasisho ambayo hayakuwekwa.<ph name="END_LINK"/></translation>
<translation id="5889581962474103319">FlyWeb inaweza kufanya kichupo hiki kisitumike ili kuboresha hali yako ya kuvinjari na kufanya mambo haraka.</translation>
<translation id="7350427799239500204">Ungependa kutumia wasifu mpya kwenye FlyWeb?</translation>
<translation id="4567424176335768812">Umeingia katika akaunti kama <ph name="USER_EMAIL_ADDRESS"/>. Sasa unaweza kupata alamisho, historia, na mipangilio yako mingine kwenye vifaa vyako vyote vilivyoingia katika akaunti.</translation>
<translation id="5891777644455025808">FlyWeb imezuia upakuaji huu kwa sababu umezima kipengele cha Kuvinjari Salama na faili husika haiwezi kuthibitishwa</translation>
<translation id="4594305310729380060">Kwenye Kidhibiti cha Manenosiri katika kifaa hiki</translation>
<translation id="6046424510733540251">Programu za FlyWeb</translation>
<translation id="4970880042055371251">Toleo la Mfumo wa Uendeshaji wa FlyWeb</translation>
<translation id="8084731767622512023">Ili uonyeshe skrini yako, washa kipengele cha kunasa skrini katika FlyWeb kwenye Mapendeleo ya Mfumo</translation>
<translation id="1936188352112244665">Inakaribia kukamilisha kusasishwa! Anzisha FlyWeb upya ili ukamilishe kusasisha.</translation>
<translation id="2962574118577609024">Ikiwa pia unashiriki ripoti za matumizi ya FlyWeb, ripoti hizo zinajumuisha URL unazotembelea</translation>
<translation id="9219132550163437762">Wasifu unaonekana kuwa unatumika na mchakato mwingine wa FlyWeb (<ph name="PROCESS_ID"/>) kwenye kompyuta nyingine (<ph name="HOST_NAME"/>). FlyWeb imefunga wasifu huu ili usifisidiwe. Kama una uhakika hakuna michakato mingine inatumia wasifu huu, unaweza kufungua wasifu na uzindue tena FlyWeb.</translation>
<translation id="4680828127924988555">Ghairi Usakinishaji</translation>
<translation id="6156840135417578237">Baadhi ya data yako ya FlyWeb bado haijahifadhiwa kwenye Akaunti yako ya FlyWeb. Jaribu kusubiri kwa dakika chache kabla ya kuondoka kwenye akaunti. Ukiondoka kwenye akaunti sasa, data hii itafutwa.</translation>
<translation id="1474749355173247622">Wakati umeingia katika akaunti, unaweza kutumia manenosiri yako na mengineyo kwenye Akaunti yako ya FlyWeb katika FlyWeb. <ph name="SHORTCUT"/> inaweza kubadilisha mipangilio yako ya huduma za FlyWeb.</translation>
<translation id="5227023869666757348">Kuna mtu aliingia katika FlyWeb kwenye kompyuta hii akitumia <ph name="ACCOUNT_EMAIL_LAST"/>. Tafadhali ongeza wasifu mpya wa FlyWeb ili utenganishe maelezo yako.</translation>
<translation id="4724676981607797757">Imeshindwa kusakinisha kwa sababu ya hitilafu ya itifaki isiyotumika.</translation>
<translation id="1671154647029930623">Ungependa kufunga FlyWeb?</translation>
<translation id="4143239505982500022">Sasisho maalum la usalama wa FlyWeb limewekwa sasa hivi. Ifunge kisha uifungue na tutarejesha vichupo vyako.</translation>
<translation id="1347247057384060764">Unaweza kubadilisha mawazo yako wakati wowote kwenye mipangilio ya FlyWeb. Vipindi vya kujaribu vinatekelezwa pamoja na jinsi matangazo yanavyoonyeshwa kwa sasa, hivyo hutaona mabadiliko papo hapo.</translation>
<translation id="4259200560913816786">FlyWeb imeshindwa kukagua manenosiri yako. Jaribu tena baada ya saa 24 au <ph name="BEGIN_LINK"/>kagua manenosiri katika Akaunti yako ya FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">Huduma hii hutumia kikagua tahajia sawa na kinachotumika kwenye Huduma ya Tafuta na FlyWeb. Maandishi unayoandika kwenye kivinjari yanatumwa kwa FlyWeb. Unaweza kubadilisha hali hii katika mipangilio wakati wowote.</translation>
<translation id="7460496601839821581">Tumia FlyWeb bila akaunti</translation>
<translation id="2991144524835127379">Sheria ya ndani ya FlyWeb ili kuruhusu trafiki ya mDNS.</translation>
<translation id="6208903184719035736">Fungua tena ili Usasishe &amp;FlyWeb</translation>
<translation id="9083381064635607718">Utahitaji toleo la macOS 11 au toleo jipya zaidi ili upate masasisho ya FlyWeb ya siku zijazo. Kompyuta hii inatumia toleo la macOS 10.15.</translation>
<translation id="7174589544844983914">FlyWeb iko katika hali ya chini chini.</translation>
<translation id="9212977598552218412">Bofya ili ufunge kidirisha cha kuingia katika FlyWeb</translation>
<translation id="7792628702371319769">Walioalikwa wanaweza kutumia FlyWeb bila kuacha kitu chochote nyuma.</translation>
<translation id="2760069255902967585">Jiongeze kwenye FlyWeb</translation>
<translation id="4239638419916712076">FlyWeb inachunguza vipengele vipya vinavyoruhusu tovuti zikupatie hali ileile ya kuvinjari kwa kutumia taarifa zako chache</translation>
<translation id="4326845160190496236">Akaunti ya FlyWeb inahitaji kuthibitisha upya</translation>
<translation id="387444474697464273">Hakuna manenosiri yaliyohifadhiwa. FlyWeb inaweza kukagua manenosiri yako ukiyahifadhi.</translation>
<translation id="291933003154435191">Ondoka kwenye FlyWeb</translation>
<translation id="520701392326482190">Tayari <ph name="EXISTING_USER"/> ameingia katika akaunti kwenye wasifu huu kwenye FlyWeb. Hatua hii itafungua wasifu mpya wa <ph name="USER_EMAIL_ADDRESS"/> kwenye FlyWeb</translation>
<translation id="8295539942024823191">Ili utumie mabadiliko uliyofanya, fungua FlyWeb upya</translation>
<translation id="5374328929709976901">Vipindi vya kujaribu vinapowashwa na iwapo FlyWeb imekuweka kwa unasibu katika kipindi cha kujaribu kinachoendelea, historia ya kuvinjari huathiri mambo yanayokuvutia na matangazo unayoyaona kama inavyokadiriwa hapa chini. Ili kulinda faragha yako, FlyWeb hufuta mambo yanayokuvutia kadiri unavyoendelea kutumia kila mwezi.</translation>
<translation id="1392114650763912227">Ingia katika FlyWeb ukitumia <ph name="USER_EMAIL"/></translation>
<translation id="6178233095056047786">FlyWeb imepata baadhi ya mapendekezo ya usalama unayopaswa kukagua</translation>
<translation id="8980390875915032396">Wasifu Nyingine za FlyWeb</translation>
<translation id="8449603408481238073">Unaingia katika akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye FlyWeb. Data yako ya FlyWeb, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio miingine itahusishwa na <ph name="USER_NAME"/> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za FlyWeb, lakini hutaweza  kuunganisha data hii na akaunti nyingine. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Msimbo wa ziada: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">Ili upate mapendeleo, jumuisha FlyWeb katika Historia ya Shughuli kwenye Wavuti na Programu</translation>
<translation id="1026219128963768190">Fahamu kwa nini FlyWeb huzuia baadhi ya faili</translation>
<translation id="1284798564810038820">Inasasisha FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">Ruhusu kuingia katika akaunti ya FlyWeb</translation>
<translation id="1827750898515917134">Ondoa kwenye FlyWeb</translation>
<translation id="5020755920249060562">Weka FlyWeb kuwa kivinjari chako chaguomsingi</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - Beta ya FlyWeb</translation>
<translation id="5385202369020319636">Huenda FlyWeb haitafanya kazi vizuri kwa sababu haitumiki tena kwenye toleo hili la Linux</translation>
<translation id="362367838300880777">FlyWeb imezuia upakuaji huu kwa sababu faili inaweza kuathiri akaunti zako binafsi na za mitandao ya kijamii</translation>
<translation id="5957333939864770801">FlyWeb inahitaji kufikia maelezo ya mahali ulipo ili kushiriki mahali ulipo na tovuti hii</translation>
<translation id="780999790006298623">Ili kulinda faragha yako, tunafuta kiotomatiki mambo yanayokuvutia ambayo yapo kwenye orodha kwa zaidi ya wiki nne. Kadiri unavyoendelea kuvinjari, jambo linalokuvutia linaweza kuonekana tena kwenye orodha. Na iwapo FlyWeb itakosea au usingependa kuona matangazo fulani, unaweza kuondoa jambo hilo linalokuvutia.</translation>
<translation id="2183749398075655200">Tafadhali subiri FlyWeb inaposakinisha sasisho mpya ya mfumo.</translation>
<translation id="8996657165865563765">FlyWeb inajaribu kubadilisha manenosiri. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="5738298079259740925">Fungua PDF katika FlyWeb</translation>
<translation id="6096945112863785306">{0,plural, =0{Sasisho la FlyWeb linapatikana}=1{Sasisho la FlyWeb linapatikana}other{Sasisho la FlyWeb limekuwepo kwa siku #}}</translation>
<translation id="7698117871740446964">Futa data ya tovuti kila wakati kwenye kifaa chako unapofunga FlyWeb</translation>
<translation id="5666891644992637849">Tafadhali zima kisha uwashe FlyWeb sasa</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Onyesha FlyWeb katika lugha hii</translation>
<translation id="569897634095159764">Imeshindwa kuunganisha kwenye Intaneti. Seva mbadala inahitaji uthibitishaji.</translation>
<translation id="3833333172002764160">Hujatembelea hivi majuzi. FlyWeb imeondoa <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/></translation>
<translation id="4985665094509307744">Dhibiti na uweke mapendeleo kwenye FlyWeb. Ifanye FlyWeb iwe kivinjari chako chaguomsingi.</translation>
<translation id="5809516625706423866">Imeshindwa kuunganisha kwenye Intaneti. HTTP 401 Haijaidhinishwa. Tafadhali angalia mipangilio yako ya seva mbadala.</translation>
<translation id="8331941171144629807">Karibu kwenye FlyWeb</translation>
<translation id="7581082856615467651">FlyWeb imegundua kwamba vipengee hivi vina programu hasidi:</translation>
<translation id="8117102597407263352">FlyWeb hukagua mara kwa mara ili kuhakikisha kuwa kivinjari chako kina mipangilio salama zaidi. Tutakufahamisha ikiwa kuna chochote kinachohitaji ukague.</translation>
<translation id="5895138241574237353">Zima na uwashe</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - Kuingia katika Akaunti ya Mtandao</translation>
<translation id="5924017743176219022">Inaunganisha kwenye Intaneti...</translation>
<translation id="5383748137832083777">FlyWeb inaweza kufanya kichupo hiki kisitumike ili kuboresha hali yako ya kuvinjari na kufuta data ili upate nyenzo.</translation>
<translation id="5941711191222866238">Punguza</translation>
<translation id="483902194277448471">Iwapo FlyWeb imekuweka kwa unasibu katika kipindi cha kujaribu kinachoendelea, historia ya kuvinjari itaathiri mambo yanayokuvutia na matangazo unayoyaona kama inavyokadiriwa hapa chini. Ili kulinda faragha yako, FlyWeb hufuta mambo yanayokuvutia kadiri unavyoendelea kutumia kila mwezi. Mambo yanayokuvutia yataonyeshwa upya isipokuwa ukiyaondoa.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Shirika lako hufunga FlyWeb kiotomatiki isipotumika kwa dakika 1.}other{Shirika lako hufunga FlyWeb kiotomatiki isipotumika kwa dakika #.}}</translation>
<translation id="4955869506208896934">Sasisha FlyWeb ili uanze kusawazisha</translation>
<translation id="63409513082302419">Ni kawaida kwa tovuti unazotembelea kukumbuka mambo yanayokuvutia, ili kuweka mapendeleo kwenye matumizi yako. Tovuti zinaweza pia kuhifadhi maelezo kuhusu mambo yanayokuvutia kwa kutumia FlyWeb.</translation>
<translation id="6003112304606738118">Inapakua... Zimesalia saa <ph name="HOURS"/></translation>
<translation id="6888926086743577946">Unaweza kufungua alamisho, hali ya kusoma na zaidi katika menyu ya FlyWeb kwenye sehemu ya juu kulia</translation>
<translation id="6040143037577758943">Funga</translation>
<translation id="619330138913595431">Ili kulinda data yako, ruhusu FlyWeb iondoe ruhusa kwenye tovuti ambazo hujazitembelea hivi karibuni. Hali hii haikomeshi arifa.</translation>
<translation id="8714139918792771260">Fungua katika FlyWeb</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/> imeongezwa kwenye FlyWeb</translation>
<translation id="3890023823480067024">Ifanye FlyWeb Iwe na Kasi Zaidi</translation>
<translation id="608006075545470555">Ongeza Wasifu wa Kazini kwenye kivinjari hiki</translation>
<translation id="5880307616068888895">Weka mapendeleo na udhibiti FlyWeb. Sasisho linapatikana.</translation>
<translation id="8890528681896757647">Ukiwasha mipangilio hii, FlyWeb huhifadhi chaji ya betri kwa kudhibiti shughuli ya chinichini na madoido, kama vile usogezaji rahisi na kasi ya picha ya video.</translation>
<translation id="1429530657225981960">Kimewashwa • FlyWeb haiwezi kuthibitisha sehemu kinapotoka kiendelezi hiki</translation>
<translation id="1683225514126450592">Ruhusu kiendelezi kionyeshe maombi ya ufikiaji katika upau wa vidhibiti wa FlyWeb</translation>
