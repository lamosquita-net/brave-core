+ViewTransitionTypeSet* ViewTransition::types() {
+  if (!types_) {
+    types_ = MakeGarbageCollected<ViewTransitionTypeSet>(this, Vector<String>());
+  }
+  return types_.Get();
+}
+
+bool ViewTransition::MatchForActiveViewTransition() const {
+  // Only script-initiated (same-document) transitions in the 116.
+  return IsCreatedViaScriptAPI() && !IsTerminalState(state_);
+}
+
+bool ViewTransition::MatchForActiveViewTransitionType(
+    const Vector<AtomicString>& pseudo_types) const {
+  if (!MatchForActiveViewTransition()) {
+    return false;
+  }
+  CHECK(!pseudo_types.empty());
+  // If types are not specified, then there is no match.
+  if (!types_ || types_->IsEmpty()) {
+    return false;
+  }
+  // At least one pseudo type has to match at least one of the transition
+  // types.
+  for (const AtomicString& pseudo_type : pseudo_types) {
+    if (types_->Contains(pseudo_type)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ViewTransition::TypesChanged() {
+  if (!MatchForActiveViewTransition()) {
+    return;
+  }
+  if (auto* originating_element = document_->documentElement()) {
+    originating_element->ActiveViewTransitionTypeStateChanged();
+  }
+}
