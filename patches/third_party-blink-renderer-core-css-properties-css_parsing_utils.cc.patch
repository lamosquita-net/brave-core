+static CSSValue* ConsumeRelativeColor(CSSParserTokenRange& range,
+                                      const CSSParserContext& context) {
+  CSSParserTokenRange color_range = range;
+  CSSValueID function_id = color_range.Peek().FunctionId();
+  CSSParserTokenRange args = ConsumeFunction(color_range);
+  if (!ConsumeIdent<CSSValueID::kFrom>(args)) {
+    return nullptr;
+  }
+  const CSSValue* origin_value = ConsumeColor(args, context);
+  if (!origin_value) {
+    return nullptr;
+  }
+  Color result;
+  if (absl::optional<Color> origin =
+          TryResolveColorAtParseTime(*origin_value)) {
+    if (!ParseRelativeColorChannels(args, function_id, context, *origin,
+                                    result)) {
+      return nullptr;
