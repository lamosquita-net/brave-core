<translation id="4809579265564854985">‏ملف <ph name="FILE_NAME"/> ضار، لذلك فقد حظره FlyWeb.</translation>
<translation id="1773252983747911987">‏سيتم إغلاق FlyWeb وحذف بيانات التصفُّح قريبًا</translation>
<translation id="1686760912855738719">‏يمكنك من هنا التبديل بين الملفات الشخصية على FlyWeb.</translation>
<translation id="5461795497268691356">‏في حال السماح بملفات تعريف الارتباط، قد يستخدمها FlyWeb في عملية التحميل المُسبق.</translation>
<translation id="6165508094623778733">مزيد من المعلومات</translation>
<translation id="1292852397592425449">‏محو بيانات FlyWeb في حسابك</translation>
<translation id="7031783851441272920">‏قد يكون هذا الملف خطيرًا.<ph name="LINE_BREAK"/>بإمكان FlyWeb التحقُّق من عملية التنزيل هذه في حال أدخلت كلمة المرور. وتُرسل معلومات حول الملف إلى ميزة "التصفّح الآمن من FlyWeb"، ولكن يظل محتوى الملف وكلمة المرور على جهازك.</translation>
<translation id="6182736845697986886">تعذَّر تثبيت التطبيق بسبب حدوث خطأ داخلي في خادم التحديث.</translation>
<translation id="4403968929742079769">‏يُرجى التأكُّد من تسجيل الدخول إلى متصفِّح FlyWeb على جهازك <ph name="TARGET_DEVICE_NAME"/> ثم محاولة الإرسال مرة أخرى.</translation>
<translation id="8345188246355148375">‏يمكنك البحث وطرح الأسئلة باستخدام FlyWeb من أي مكان، حتى إن كان مصغّرًا. ويسمح هذا الإعداد بتشغيل FlyWeb في الخلفية.</translation>
<translation id="1855179706668101462">‏يحتوي هذا الكمبيوتر فعلاً على إصدار أحدث من FlyWeb. إذا كان البرنامج لا يعمل، يُرجى إزالة FlyWeb وإعادة المحاولة.</translation>
<translation id="651290634887454330">{0,plural, =0{‏ستتم إعادة تشغيل FlyWeb الآن}=1{‏ستتم إعادة تشغيل FlyWeb في غضون ثانية واحدة}two{‏ستتم إعادة تشغيل FlyWeb في غضون ثانيتين}few{‏ستتم إعادة تشغيل FlyWeb في غضون # ثوان}many{‏ستتم إعادة تشغيل FlyWeb في غضون # ثانيةً}other{‏ستتم إعادة تشغيل FlyWeb في غضون # ثانية}}</translation>
<translation id="2586408713760853791">‏يحتاج FlyWeb إلى إذن للوصول إلى مساحة التخزين من أجل تنزيل الملفات.</translation>
<translation id="1603558835003845196">‏يعمل هذا الوضع على التحقّق من عناوين URL باستخدام قائمة بمواقع إلكترونية غير آمنة مُخزّنة في FlyWeb.</translation>
<translation id="5751080530525677552">‏جعل FlyWeb المتصفح التلقائي</translation>
<translation id="6248988683584659830">البحث في الإعدادات</translation>
<translation id="6342238100521499844">‏يمكنك الاستفادة من أفضل ميزات الأمان من FlyWeb أثناء التنقل باستخدام تطبيق FlyWeb على هاتفك</translation>
<translation id="3542157007113577464">‏هل تريد الخروج من FlyWeb؟</translation>
<translation id="2166321493116256664">‏تستخدم علامات التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح FlyWeb بإيقاف علامات التبويب هذه.</translation>
<translation id="3794967601634523398">‏تخصيص ملفك الشخصي في FlyWeb</translation>
<translation id="6475001900959697061">‏تسمية ملفك الشخصي على FlyWeb</translation>
<translation id="6356094940346377065">‏تطلب منك إحدى الإضافات تسجيل الدخول إلى FlyWeb</translation>
<translation id="4465156155012748592">‏قد يكون ملف <ph name="FILE_NAME"/> ضارًا، لذلك فقد حظره FlyWeb.</translation>
<translation id="5523868569707953059">‏يستخدم FlyWeb الكاميرا.</translation>
<translation id="8226838065217375546">‏عملية أخرى على FlyWeb قيد التقدم. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="6063700568539132984">‏الآن أصبح استخدام FlyWeb مع حسابك في FlyWeb وفي أجهزة الكمبيوتر المشتركة أكثر سهولة.</translation>
<translation id="5622088198573179705">‏يمكنك الوصول بسهولة إلى الميزات المفضَّلة والموثوقة لديك من خلال ضبط FlyWeb كمتصفِّحك التلقائي.</translation>
<translation id="4709797814274745581">‏اختصار FlyWeb</translation>
<translation id="6595693843242836271">‏حَظَر FlyWeb عملية التنزيل هذه لأنّ الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="6890209090736444656">‏هل تريد فعلًا إزالة FlyWeb؟</translation>
<translation id="6375219077595103062">إضافة اختصار إلى "مدير كلمات المرور"</translation>
<translation id="6388799252195623474">أريد مساعدة بخصوص هذا المحتوى</translation>
<translation id="8407518452288816185">‏للمتابعة، يُرجى تسجيل الدخول إلى FlyWeb باستخدام حساب <ph name="EMAIL"/>. ويضمن ذلك أنّك قد اطّلعت على سياسات مؤسستك.</translation>
<translation id="2104550252781001709">‏شعار FlyWeb على شاشة كمبيوتر</translation>
<translation id="6636986997730784876">‏ إن FlyWeb هو متصفح ويب يشغّل صفحات الويب والتطبيقات بسرعة مذهلة. إنه سريع وثابت وسهل الاستخدام. يمكنك تصفح الويب بشكل أكثر أمانًا من خلال ميزات الحماية من البرامج الضارة والتصيّد الاحتيالي المدمجة في FlyWeb.</translation>
<translation id="4359872290500912570">‏لضمان إمكانية استخدامك لبيانات FlyWeb وحفظها في حسابك على FlyWeb متى شئت، يجب إثبات هويتك</translation>
<translation id="3141715584864891679">‏سيعمل FlyWeb بشكل أسرع ومن المفترض أن تعمل الميزات التي تستخدِم JavaScript على النحو المطلوب</translation>
<translation id="6436260184216827876">ميزة "البحث بالصور" ليست متوفرة. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="2139300032719313227">‏إعادة تشغيل نظام التشغيل FlyWeb</translation>
<translation id="7560906925528428585">‏يُحمِّل FlyWeb مسبقًا المزيد من الصفحات التي يُحتمل أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="5806916401157869650">‏يكفي تنزيل متصفِّح FlyWeb على هاتفك لتتبُّع الأسعار والحصول على تنبيهات عند انخفاضها على أي موقع إلكتروني</translation>
<translation id="2970877059928503461">‏غير مفعَّلة • لا يمكن لمتصفّح FlyWeb التحقُّق من مصدر هذه الإضافة</translation>
<translation id="173462352822069427">‏مرحبًا بك في الملفات الشخصية على FlyWeb</translation>
<translation id="8914008746092110409">‏عند فتح FlyWeb على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام مجموعات علامات التبويب.</translation>
<translation id="3484308111967198595">‏إزالة الحساب من FlyWeb</translation>
<translation id="1474676525193357364">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل FlyWeb.</translation>
<translation id="648319183876919572">تعزِّز ميزة "الحماية المُحسّنة للتصفّح الآمن" حمايتك من المواقع الإلكترونية الضارة وعمليات التنزيل الخطيرة.</translation>
<translation id="5777905264835557372">‏إزالة FlyWeb</translation>
<translation id="764623543427374554">‏يتم فتح الاختصارات في FlyWeb</translation>
<translation id="8852057261917278552">‏تغلق مؤسستك FlyWeb في حال عدم استخدامه لمدّة <ph name="TIMEOUT_DURATION"/>. تم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="8592211619057897362">‏يحتفظ كل ملف شخصي بالمعلومات الخاصة به على FlyWeb، مثل الإشارات المرجعية والسجلّ وكلمات المرور وغير ذلك.</translation>
<translation id="6556755379298048869">يمكنك البحث باستخدام أحد اختصارات لوحة المفاتيح.</translation>
<translation id="4273595998837775033">‏مزيد من المعلومات حول <ph name="BEGIN_LINK"/>الطريقة التي يتّبعها FlyWeb للحفاظ على خصوصية بياناتك<ph name="END_LINK"/></translation>
<translation id="654107331777480705">‏سيتم تطبيق التغييرات في هذا الإعداد بعد إعادة تشغيل FlyWeb.</translation>
<translation id="3594828538355548672">‏يمكنك إدارة الإضافات من خلال النقر على "الإضافات" في قائمة FlyWeb الرئيسية.</translation>
<translation id="7489092380688543560">‏يمكنك التبديل للاطّلاع على كلمات المرور من ملف شخصي آخر في FlyWeb.</translation>
<translation id="472958395762114471">‏أفضل أدوات الذكاء الاصطناعي ستكون متاحة لك أثناء التنقل عند استخدام تطبيق FlyWeb</translation>
<translation id="8243012192239086369">‏لإصلاح الأخطاء الإملائية، يُرسِل FlyWeb ما تكتبه في حقول النص إلى FlyWeb</translation>
<translation id="3927263773110604886">‏الانتقال إلى إعدادات الإشعارات في FlyWeb</translation>
<translation id="6600016381025017075">البحث عن أي محتوى على هذه الصفحة</translation>
<translation id="6888846095017247017">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل FlyWeb.</translation>
<translation id="4481788155537463533">‏يتم الآن فتح FlyWeb تلقائيًا عند بدء تشغيل Windows، ما يتيح لك بدء التصفّح على الفور. ويمكنك إيقاف هذا الإجراء من خلال الإعدادات.</translation>
<translation id="1116311888485102603">‏المتابعة من حيث توقفت: استعاد FlyWeb علامات التبويب من جلستك الأخيرة. يمكنك إيقاف هذه الميزة في</translation>
<translation id="1886169834787876002">‏يحتاج FlyWeb إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للمكان حولك.</translation>
<translation id="7570986009744020649">‏إذا حفظت أيضًا إشاراتك المرجعية في حسابك على FlyWeb، يمكنك تتبُّع أسعار المنتجات من خلال FlyWeb وتلقّي إشعارات عند انخفاض السعر.</translation>
<translation id="6676384891291319759">الدخول إلى الإنترنت</translation>
<translation id="1363996462118479832">‏تعذّر على نظام التشغيل FlyWeb مزامنة بياناتك بسبب حدوث خطأ أثناء تسجيل الدخول.</translation>
<translation id="5743696427773796626">‏إزالة بيانات هذا التطبيق من FlyWeb</translation>
<translation id="4152880912192471857">‏يحتاج FlyWeb إلى إذن للوصول إلى الميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="6712881677154121168">حدث خطأ في عملية التنزيل: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">‏لا يمكن استخدام ملفك الشخصي نظرًا لأنه من إصدار أحدث من FlyWeb.

قد تكون بعض الميزات غير متاحة. يُرجى تحديد دليل ملف شخصي مختلف أو استخدام إصدار أحدث من FlyWeb.</translation>
<translation id="5528558621229392814">‏للحصول على خيارات مخصَّصة والاستفادة من ميزات أخرى، يمكنك تضمين متصفّح FlyWeb في "النشاط على الويب وفي التطبيقات" وخدمات FlyWeb المرتبطة</translation>
<translation id="7728046102681268859">‏يتم تثبيت FlyWeb بالفعل لجميع المستخدمين على جهاز الكمبيوتر.</translation>
<translation id="2006421382007321898">‏يتيح لك تسجيل الدخول إلى FlyWeb الوصول إلى الإشارات المرجعية وغيرها على جميع أجهزتك. وسيتم حفظ هذه الإشارة المرجعية في حسابك على FlyWeb بعد تسجيل الدخول إليه.</translation>
<translation id="4328426102261301637">‏يعمل هذا الإعداد على زيادة سرعة المواقع الإلكترونية باستخدام محرّك V8 في FlyWeb، مع تقليل قدرة FlyWeb على مقاومة الهجمات قليلاً. هذا الإعداد مفعَّل.</translation>
<translation id="207175655966839154">{count,plural, =1{‏لم يتم حفظ بعض بيانات FlyWeb في حسابك على FlyWeb إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏لم يتم حفظ بعض بيانات FlyWeb في حسابك على FlyWeb إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏لم يتم حفظ بعض بيانات FlyWeb في حسابك على FlyWeb إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏لم يتم حفظ بعض بيانات FlyWeb في حسابك على FlyWeb إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏لم يتم حفظ بعض بيانات FlyWeb في حسابك على FlyWeb إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏لم يتم حفظ بعض بيانات FlyWeb في حسابك على FlyWeb إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="1292831930742306370">‏ينصح متصفِّح FlyWeb بفحص هذا الملف لأنّه قد يكون خطيرًا.</translation>
