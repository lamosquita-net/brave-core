<translation id="8463540467315366872">‏يتوفّر حاليًا على هذا الجهاز ملف شخصي لهذا الحساب على FlyWeb.</translation>
<translation id="7845233973568007926">شكرًا على التثبيت. عليك إعادة تشغيل الكمبيوتر قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8611872055947278722">‏تعذّرت إعادة التحميل FlyWeb إلى آخر إصدار، لذلك قد تفوتك الميزات الجديدة وعمليات إصلاح الأمان.</translation>
<translation id="7872446069773932638">جارٍ التنزيل… الثواني المتبقّية: <ph name="SECONDS"/></translation>
<translation id="3217139311889964618">‏<ph name="BEGIN_BOLD"/>كيفية إدارة بياناتك:<ph name="END_BOLD"/> لحماية خصوصيتك، نحذف تلقائيًا اهتماماتك التي يمر عليها أكثر من أربعة أسابيع. وفي حال بحثت عن أحد الاهتمامات مرّة آخرى، سيظهر في القائمة من جديد. يمكنك إزالة الاهتمامات التي لا تريد أن يضيفها FlyWeb إلى قائمة اهتماماتك.</translation>
<translation id="3096730275883527801">‏تم تسجيل دخولك إلى FlyWeb باعتبارك <ph name="USER_EMAIL_ADDRESS"/>. يُرجى استخدام الحساب نفسه لتسجيل الدخول مرة أخرى.</translation>
<translation id="9017338699075596174">‏هذا تثبيت ثانوي من FlyWeb، ولا يمكن جعله متصفحك التلقائي.</translation>
<translation id="5944585442866020176">‏بعد حصول FlyWeb على إمكانية الوصول، ستتمكن المواقع الإلكترونية من مطالبتك بإمكانية الوصول.</translation>
<translation id="80471789339884597">شكرًا على التثبيت. عليك إعادة تشغيل جميع المتصفِّحات قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="3263664073045388929">‏يحتاج FlyWeb إلى إذن تحديد الموقع الجغرافي من أجل هذا الموقع الإلكتروني.</translation>
<translation id="5334309298019785904">‏تعذّر على نظام التشغيل FlyWeb مزامنة بياناتك لأن المزامنة غير متاحة لنطاقك.</translation>
<translation id="813913629614996137">تجري التهيئة...</translation>
<translation id="1597323875619800374">‏هذا الملف ضار، لذلك فقد حظره FlyWeb.</translation>
<translation id="8455485678130879158">‏حَظَر FlyWeb هذا الملف لأنّه ملف خطير.</translation>
<translation id="6756872644564483342">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول FlyWeb توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى FlyWeb. ويمكنك إيقاف هذه الميزة في الإعدادات في أي وقت.</translation>
<translation id="5792785787074426346">‏يتعذّر على FlyWeb التحقّق من كلمات المرور لأنك لم تسجّل الدخول.</translation>
<translation id="6627585369674499881">‏قد يكون هذا الملف ضارًا، لذلك فقد حظره FlyWeb.</translation>
<translation id="208266011144024011">‏تغلق مؤسستك FlyWeb في حال عدم استخدامه لمدّة <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="3542611917357881417">‏إنجاز المزيد باستخدام FlyWeb</translation>
<translation id="5565286784156841599">‏يمكنك تسجيل الدخول لمزامنة FlyWeb وتخصيصه على جميع أجهزتك.</translation>
<translation id="9174706677133564856">‏كان <ph name="USER_EMAIL_ADDRESS"/> يستخدم FlyWeb مسبقًا</translation>
<translation id="5975370349701995302">‏للوصول إلى بياناتك في متصفّح FlyWeb من جميع أجهزتك، سجِّل الدخول وفعِّل المزامنة.</translation>
<translation id="7408894216012529448">‏للحصول على تحديثات FlyWeb في المستقبل، يجب استخدام كمبيوتر يعمل بنظام التشغيل Windows 10 أو إصدار أحدث. يعمل هذا الكمبيوتر بنظام التشغيل Windows 8.</translation>
<translation id="7256356679044945328">‏ألغى المطوِّر نشر هذه الإضافة، علمًا بأنّها قد تكون غير آمنة. يُرجى إزالة هذه الإضافة من FlyWeb كي لا تتمكّن من الاطّلاع على بياناتك وتغييرها، بما في ذلك معلوماتك الشخصية، على المواقع الإلكترونية التي تزورها.</translation>
<translation id="5261590792975521002">{0,plural, =1{‏يجب إعادة تشغيل FlyWeb في غضون يوم واحد}zero{‏يجب إعادة تشغيل FlyWeb في غضون # يوم}two{‏يجب إعادة تشغيل FlyWeb في غضون يومين}few{‏يجب إعادة تشغيل FlyWeb في غضون # أيام}many{‏يجب إعادة تشغيل FlyWeb في غضون # يومًا}other{‏يجب إعادة تشغيل FlyWeb في غضون # يوم}}</translation>
