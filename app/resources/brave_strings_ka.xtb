<translation id="8791209382165811772">FlyWeb for Testing-ის შესახებ</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="3546782282376530369">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. FlyWeb გირჩევთ მის ამოშლას.</translation>
<translation id="834808339160590901">მოგესალმებით FlyWeb-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="5094033276783634414">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის FlyWeb საჭრიროებს ნებართვას</translation>
<translation id="3363095592946520579">თქვენ უკვე შესული ხართ FlyWeb-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="1304885695888649052">FlyWeb-ის განახლება ვერ მოხერხდა შეფერხების გამო. <ph name="BEGIN_LINK"/>შეასწორეთ FlyWeb-ის განახლებასთან დაკავშირებული პრობლემები და განუხორციელებელი განახლებები.<ph name="END_LINK"/></translation>
<translation id="5889581962474103319">FlyWeb-ს შეუძლია, ეს ჩანართი უმოქმედო რეჟიმში გადაიტანოს, რათა გააუმჯობესოს თქვენი დათვალიერების გამოცდილება და მოქმედებების შესრულება ააჩქაროს.</translation>
<translation id="7350427799239500204">გსურთ ახალ FlyWeb პროფილში გაგრძელება?</translation>
<translation id="4567424176335768812">თქვენ შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS"/>. ახლა შეგიძლიათ გახსნათ თქვენი სანიშნეები, ისტორია და სხვა პარამეტრები ყველა მოწყობილობიდან, რომელშიც შესული ხართ.</translation>
<translation id="5891777644455025808">FlyWeb-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="6046424510733540251">FlyWeb პროგრამები</translation>
<translation id="4970880042055371251">ChromeOS-ის ვერსია</translation>
<translation id="8084731767622512023">ეკრანის გასაზიარებლად დაუშვით ეკრანის ჩაწერა FlyWeb-ისთვის სისტემის პრეფერენციებში</translation>
<translation id="1936188352112244665">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით FlyWeb.</translation>
<translation id="2962574118577609024">თუ FlyWeb-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="9219132550163437762">როგორც ჩანს, პროფილი გამოიყენება სხვა FlyWeb პროცესის მიერ (<ph name="PROCESS_ID"/>) სხვა კომპიუტერში (<ph name="HOST_NAME"/>). FlyWeb-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ FlyWeb.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="6156840135417578237">თქვენი FlyWeb-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს FlyWeb ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="1474749355173247622">როცა შესული ხართ, FlyWeb-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი FlyWeb ანგარიშიდან. <ph name="SHORTCUT"/> შეცვლის თქვენი FlyWeb სერვისების პარამეტრებს.</translation>
<translation id="5227023869666757348">FlyWeb-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST"/>. გთხოვთ, შექმნათ FlyWeb-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="1671154647029930623">მაინც გსურთ FlyWeb-იდან გასვლა?</translation>
<translation id="4143239505982500022">FlyWeb-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="1347247057384060764">აზრის შეცვლას ნებისმიერ დროს შეძლებთ FlyWeb-ის პარამეტრებიდან. ცდები განხორციელდება რეკლამის ჩვენების ამჟამინდელი მექანიზმების მოქმედების პარალელურად, ამიტომ ცვლილებებს მომენტალურად არ შეამჩნევთ.</translation>
<translation id="4259200560913816786">FlyWeb ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში ან <ph name="BEGIN_LINK"/>შეამოწმეთ პაროლები თქვენს FlyWeb ანგარიშში<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Brave Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება FlyWeb-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="7460496601839821581">FlyWeb-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="2991144524835127379">FlyWeb-ის შემავალი წესი დაუშვას mDNS მოძრაობა.</translation>
<translation id="6208903184719035736">ხელახლა გაშვება &amp;FlyWeb-ის გასაახლებლად</translation>
<translation id="9083381064635607718">მომავალში FlyWeb-ის განახლებების მისაღებად დაგჭირდებათ macOS 11 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 10.15-ს.</translation>
<translation id="7174589544844983914">FlyWeb ფონურ რეჟიმშია.</translation>
<translation id="9212977598552218412">დააწკაპუნეთ FlyWeb-ის შესვლის დიალოგის დასახურად</translation>
<translation id="7792628702371319769">სტუმრებს შეუძლიათ FlyWeb-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="2760069255902967585">საკუთარი თავის დამატება FlyWeb-ში</translation>
<translation id="4239638419916712076">FlyWeb მუშაობს ახალ ფუნქციებზე, რომელთა მეშვეობითაც საიტებს იგივე ფუნქციონალი შეუნარჩუნდება თქვენი ნაკლები ინფორმაციის გამოყენებით</translation>
<translation id="4326845160190496236">FlyWeb ანგარიში საჭიროებს ხელახლა ავტორიზაციას</translation>
<translation id="387444474697464273">შენახული პაროლები არ არის. პაროლების შემოწმებას FlyWeb შეძლებს მათი შენახვის შემდეგ.</translation>
<translation id="291933003154435191">FlyWeb-იდან გამოსვლა</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/> უკვე შესულია ამ FlyWeb პროფილში. ეს მოქმედება შექმნის ახალ FlyWeb პროფილს <ph name="USER_EMAIL_ADDRESS"/>-ისთვის</translation>
<translation id="8295539942024823191">ცვლილებების მისასადაგებლად ხელახლა გაუშვით FlyWeb</translation>
<translation id="611606920944085547">ვების ინკოგნიტო რეჟიმში დათვალიერებისას FlyWeb გაგაფრთხილებთ საიტის დაუცველი კავშირის გამოყენებით ჩატვირთვამდე</translation>
<translation id="5374328929709976901">როცა ცდები ჩართულია და თუ FlyWeb შემთხვევითობის პრინციპით მიგაღებინებთ მონაწილეობას მიმდინარე ცდაში, თქვენ მიერ ვების დათვალიერების ისტორია აისახება თქვენთვის ხილულ რეკლამასა და თქვენს ინტერესებზე, ქვემოთ პროგნოზირებულის შესაბამისად. თქვენი კონფიდენციალურობის დაცვის მიზნით, FlyWeb წაშლის თქვენს ინტერესებს ყოველთვიურად რიგითობის მიხედვით.</translation>
<translation id="1392114650763912227">FlyWeb-ში შესვლა, როგორც <ph name="USER_EMAIL"/></translation>
<translation id="6178233095056047786">FlyWeb-მა თქვენთვის იპოვა უსაფრთხოებასთან დაკავშირებული რეკომენდაციები</translation>
<translation id="8980390875915032396">სხვა FlyWeb პროფილები</translation>
<translation id="8449603408481238073">მართული ანგარიშით შედიხართ სისტემაში და ადმინისტრატორს თქვენს FlyWeb-ის პროფილზე კონტროლს აძლევთ. თქვენი FlyWeb ის მონაცემები როგორიცაა თქვენი აპლიკაციები, სანიშნები, ისტორიები, პაროლები, და სხვა პარამეტრები მუდმივად მიბმული გახდება <ph name="USER_NAME"/>-თან. ამ მონაცემების წაშლას FlyWeb ანგარიშის საინფორმაციო დაფის გზით შეძლებთ, მაგრამ შეუძლებელი იქნება ამ მონაცემების სხვა ანგარიშთან გაერთიანება. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">დამატებითი კოდი: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">პერსონალიზაციით რომ ისარგებლოთ, დაურთეთ FlyWeb ვებსა და აპებში აქტივობას</translation>
<translation id="1026219128963768190">შეიტყვეთ, რატომ ბლოკავს FlyWeb ზოგიერთ ფაილს</translation>
<translation id="1284798564810038820">მიმდინარეობს FlyWeb-ის განახლება (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">FlyWeb-ში შესვლის დაშვება</translation>
<translation id="1827750898515917134">FlyWeb-იდან ამოღება</translation>
<translation id="5020755920249060562">დააყენეთ FlyWeb ნაგულისხმევ ბრაუზერად</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> — FlyWeb Beta</translation>
<translation id="5385202369020319636">FlyWeb-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი ამ Linux დისტრიბუტივზე</translation>
<translation id="362367838300880777">FlyWeb-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ფაილს შეუძლია თქვენი პირადი და სოციალური ქსელების ანგარიშების დაზიანება.</translation>
<translation id="5957333939864770801">FlyWeb საჭიროებს თქვენს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის გასაზიარებლად</translation>
<translation id="780999790006298623">თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. თუ FlyWeb შეცდომით გამოიცნობს თქვენს ინტერესს, ან რომელიმე ტიპის რეკლამის ნახვას არ მოისურვებთ, ინტერესის წაშლის საშუალება გექნებათ.</translation>
<translation id="2183749398075655200">დაელოდეთ, სანამ FlyWeb დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="8996657165865563765">FlyWeb ცდილობს პაროლების რედაქტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
