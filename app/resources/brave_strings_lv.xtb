<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="7099479769133613710">Atkārtoti palaist, lai atjauninātu &amp;FlyWeb OS</translation>
<translation id="291426170030461697">FlyWeb komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="1549005488226693697">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks FlyWeb izmanto FlyWeb serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču FlyWeb uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="8908267645832965492">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam FlyWeb.</translation>
<translation id="5557633153169217776">Pārlūkam FlyWeb ir nepieciešama piekļuve jūsu lokālajam tīklam, lai atrastu un izmantotu tuvumā esošās ierīces.</translation>
<translation id="6441390163669415879">Lai meklētu konkrētu FlyWeb funkciju vai paplašinājumu, adreses joslā ievadiet tā saīsni un pēc tam nospiediet izvēlēto īsinājumtaustiņu</translation>
<translation id="9001750423919983557">Rādīt meklēšanu pārlūkā FlyWeb sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="1368460307421081773">Pārlūkā FlyWeb tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="112640046208448578">Varat identificēt priekšmetus vai vietas un kopēt vai tulkot tekstu. Kad izmantojat funkciju Attēlu meklēšana, uz serveri tiek nosūtīts lapas ekrānuzņēmums. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">Jūsu noklusējuma pārlūks ir FlyWeb.</translation>
<translation id="4556715463645168547">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK"/>pierakstieties pārlūkā FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Noklikšķiniet uz FlyWeb izvēlnes</translation>
<translation id="1157985233335035034">Nesen izmantotās valodas</translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="4380351562011537903">Par FlyWeb</translation>
<translation id="853148447909557566">Brīdinājumu saņemšana par cenu izsekošanu, izmantojot pārlūku FlyWeb savā tālrunī</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME"/> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="1232234696885483911">Kad atvērsiet attēlu meklēšanu, serverim tiks automātiski nosūtīts lapas nosaukums, vietrādis URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Kamēr esat pierakstījies, pārlūkā FlyWeb varat izmantot savas paroles un citu saturu no FlyWeb konta. Lai to mainītu, pārejiet uz sadaļu “Jūsu konts pārlūkā FlyWeb”.</translation>
<translation id="7614508617663739435">Rādīt Gemini pārlūkā FlyWeb Mac izvēļņu joslā</translation>
<translation id="832555967476614730">Lai pakalpojumā Gemini pārlūkā FlyWeb atlasītu ekrāna daļu, izmantojiet īsinājumtaustiņu.</translation>
<translation id="4750836834956739196">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka FlyWeb ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="3190759351483708314">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="5879469261638423015">Ja pierakstāties FlyWeb pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL"/>, varat automātiski pierakstīties pārlūkā FlyWeb ar to pašu kontu.</translation>
<translation id="7142135954326264349">Iegūstiet pārlūku FlyWeb savā tālrunī</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Jaunā FlyWeb profila iestatīšana</translation>
<translation id="5252737639504553444">Izmēģināt, izmantojot Gemini pārlūkā FlyWeb</translation>
<translation id="609743863669742325">Pārlūkam FlyWeb ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Pierakstieties pārlūkā FlyWeb savā tālrunī</translation>
<translation id="1330562121671411446">Valodas noteikšana</translation>
<translation id="2276527911011636666">Dzēst arī datus no pārlūka FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana, izmantojot jauno pogu rīkjoslā.</translation>
<translation id="1383876407941801731">Meklēt</translation>
<translation id="1045149878186896649">Izmantojiet lietotni FlyWeb, lai turpinātu pārlūkošanu, atrodoties ceļā</translation>
<translation id="141901961143729572">Dalieties domās!</translation>
<translation id="2758515779140515865">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā FlyWeb.</translation>
<translation id="4713192356155907986">Saņemt palīdzību saistībā ar FlyWeb for Testing</translation>
<translation id="4984443629206419460">Lai piekļūtu saglabātajai informācijai un citiem datiem no ierīces <ph name="DEVICE"/>, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Šī lapa ir aizsargāta</translation>
<translation id="8962360511570172">FlyWeb cilnes kopīgošana</translation>
<translation id="2941487459666781243">Pierakstīties pārlūkā FlyWeb</translation>
<translation id="1547469039832541117">Tiek pabeigts atzīmētais uzdevums.</translation>
<translation id="3182893868355533457">Piespraust pārlūku FlyWeb</translation>
<translation id="852852907317361085">FlyWeb drošības rīki</translation>
<translation id="481155564361715417">FlyWeb pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="2846999307505917298">Izmantojiet pārlūku FlyWeb savā tālrunī, lai pilnvērtīgi izmantotu FlyWeb piedāvātās iespējas</translation>
<translation id="3961251277542681013">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā FlyWeb.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1665602916345474427">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME"/> (<ph name="USER_EMAIL"/>), un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="7625232007557474355">Varat izmantot pārlūku FlyWeb ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs. Tas arī tiks piesprausts uzdevumu joslai.</translation>
<translation id="1709772298389099340">Nodrošina augstas privilēģijas pārlūkam <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">Pārlūkā FlyWeb drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="8939535770474283898">Pārlūkā FlyWeb tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="2581127533455294937">FlyWeb dati dzēsti</translation>
<translation id="7385422968404728039">Pārlūks FlyWeb tiks restartēts pēc: <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Ja HTTPS nav pieejams, pārlūkā FlyWeb bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="307170399141486420">Ļaut FlyWeb darboties fonā</translation>
<translation id="5006568136491721884">Windows paziņojumā noklikšķiniet uz <ph name="BEGIN_BOLD"/>Jā<ph name="END_BOLD"/>, lai piespraustu pārlūku FlyWeb uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="2473319786107120819">Pārinstalēt FlyWeb</translation>
<translation id="2533324957407080119">FlyWeb mēģina <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt paplašinājumiem un citiem datiem no <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE"/>) atvērsiet pārlūku FlyWeb, tiks parādīts aicinājums izmantot FlyWeb paroļu pārvaldnieku.</translation>
<translation id="1838374766361614909">Notīrīt meklēšanas vaicājumu</translation>
<translation id="3403116471618205223">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos FlyWeb kontā, <ph name="BEGIN_LINK"/>izrakstieties no FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Lejupielādējiet pārlūku FlyWeb savā tālrunī, lai atvērtu vai izveidotu jaunas ciļņu grupas, atrodoties ceļā.</translation>
<translation id="3285741355512747610">Varat pārvaldīt FlyWeb kontus, kuros esat pierakstījies. Jūsu FlyWeb konti tiek izmantoti pārlūkā FlyWeb, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE"/> ierīcei. <ph name="LINK_BEGIN"/>Uzziniet vairāk<ph name="LINK_END"/>.</translation>
<translation id="1862852878885210965">Meklēšana, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="5054936737639982722">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem no <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Atlasīt tekstu</translation>
<translation id="4824940465467423308">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu FlyWeb dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME"/>. Varēsiet dzēst šos datus, izmantojot FlyWeb kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu FlyWeb datus. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">Pārlūkā FlyWeb tiek taupīta akumulatora enerģija, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu. Varat <ph name="BEGIN_LINK"/>uzzināt vairāk par enerģijas taupīšanas režīmu<ph name="END_LINK"/>.</translation>
<translation id="6773732565528662666">FlyWeb atjauninātāja pakalpojums</translation>
<translation id="7390382558747224642">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties FlyWeb vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā FlyWeb.</translation>
<translation id="5714085538350759767">FlyWeb nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="5866699689358760578">Saskaņā ar jūsu organizācijas (<ph name="MANAGER"/>) politiku jums ir jāpierakstās pārlūkā FlyWeb.</translation>
<translation id="4035053306113201399">FlyWeb OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="3750729306035486751">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE"/> minūte(-es).</translation>
<translation id="6956650624767954726">FlyWeb nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="197326043290947695">Viedāka pārlūkošana, izmantojot attēlu meklēšanu</translation>
<translation id="130679046523922050">Uzzināt, kāpēc pārlūkā FlyWeb daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="8243822903505210769">Nodrošina FlyWeb programmatūras pastāvīgu atjaunināšanu. Ja šis pakalpojums tiks atspējots vai pārtraukts, jūsu FlyWeb programmatūra netiks pastāvīgi atjaunināta, kas nozīmē, ka nebūs iespējams labot drošības ievainojamības, ja tādas radīsies, turklāt var nedarboties funkcijas. Šis pakalpojums pats tiek atinstalēts, ja neviena FlyWeb programmatūra to neizmanto.</translation>
<translation id="6495079989036864983">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā FlyWeb kā <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="2039417478970545937">Iestatījumi.</translation>
<translation id="8544477465831682343">Izvēlieties, vai iekļaut FlyWeb vēsturi, lai iegūtu personalizētākas iespējas FlyWeb pakalpojumos.</translation>
<translation id="328650761750741315">Iebūvēts pārlūkā FlyWeb, lai palīdzētu jums izveidot, saglabāt un automātiski aizpildīt drošas paroles. Pievienojiet saīsni ērtai piekļuvei.</translation>
<translation id="2407746489237278840">Jaunas cilnes lapā noklikšķiniet uz pogas Pielāgot FlyWeb, lai piešķirtu pārlūkam FlyWeb jaunu izskatu.</translation>
<translation id="8924891216494775926">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="5728214838078602184">Kad nākamreiz iOS ierīcē atvērsiet pārlūku FlyWeb, tiks parādīts aicinājums izmēģināt funkciju <ph name="FEATURE_NAME"/>.</translation>
<translation id="2058207584484841616">Jūsu paroles un citi FlyWeb dati, ko saglabājāt savā FlyWeb kontā, tiks noņemti no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā FlyWeb, atkārtoti pierakstieties.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks FlyWeb nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks FlyWeb nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks FlyWeb nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks FlyWeb nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2125838419757773031">Lai meklētu, atlasiet ekrāna apgabalu</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="2135919691573380097">Ziņošana par šo vietni</translation>
<translation id="2137162749895930932">Aizvērt tulkošanas ekrānu</translation>
<translation id="2147218225094845757">Slēpt sānu paneli</translation>
<translation id="4474394796469499134">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="2170098639895543546">Atlasīt jebkādu saturu lapā</translation>
<translation id="6765231735885996239">Pielāgot pārlūkprogrammu FlyWeb</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="2937508664417729967">FlyWeb — pierakstīšanās tīklā — <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Noņemt kontu no pārlūka FlyWeb</translation>
<translation id="744837314710861405">Izmantojiet lietotni FlyWeb, lai piekļūtu vislabākajiem iepirkšanās rīkiem, atrodoties ceļā</translation>
<translation id="2745381939758295588">Saņemiet labāku aizsardzību, atrodoties ceļā, ar funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā FlyWeb operētājsistēmai iOS.</translation>
<translation id="6707114110652917144">Bīstama vietne. Pārlūkā FlyWeb tika noņemti paziņojumi.</translation>
<translation id="2236949375853147973">Manas darbības</translation>
<translation id="4646732243247482236">Pierakstieties pārlūkā FlyWeb, lai varētu piekļūt adresēm un citiem datiem visās savās ierīcēs. Šī adrese tiks saglabāta jūsu FlyWeb kontā pēc pierakstīšanās.</translation>
<translation id="2726680594710751908">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku FlyWeb atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="4086571337340463916">Prasmes pārlūkā FlyWeb</translation>
<translation id="2283803047247799269">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{FlyWeb iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{FlyWeb iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{FlyWeb iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="2307973900865360088">Paturēt dokā</translation>
<translation id="5067150284614317159">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā FlyWeb. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, FlyWeb var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2356070529366658676">Vaicāt</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="7339360994527471629">Paplašinājums “<ph name="EXTENSION_NAME"/>” pieprasa, lai jūs pierakstītos pārlūkā FlyWeb</translation>
<translation id="8788732221355188962">Atspējot FlyWeb darbību fonā lietotnēm</translation>
<translation id="4126251160852694747">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS"/>, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="8418845734693287262">FlyWeb OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Vismaz viens FlyWeb paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens FlyWeb paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens FlyWeb paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens FlyWeb paplašinājums piekļūst # HID ierīcei}other{Vismaz viens FlyWeb paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="1364879203203742966">Pārlūkam FlyWeb ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2403703063067034158">Palaišanas kļūda: pašlaik ir aktīvs cits iestatīšanas process. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="656987653252575654">Atveriet saites pārlūkā FlyWeb no jebkuras lietotnes un saglabājiet pārlūku pieejamu uzdevumu joslā.</translation>
<translation id="157662717324308283">Noklikšķiniet uz pogas Apkopot, lai kopīgotu šo dokumentu ar Gemini pārlūkā FlyWeb, iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="1968013196034892522">Izmantojot <ph name="BEGIN_LINK"/>FlyWeb rīkus<ph name="END_LINK"/>, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="1716762085628757512">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt FlyWeb paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="3224379053610845181">FlyWeb drīz tiks aizvērts</translation>
<translation id="3840682988105604367">Pārlūkā FlyWeb</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Atlasiet tekstu, ko meklēt, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="6823116595279840454">Pārlūkā FlyWeb tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="2691552788029831386">Pārlūkam FlyWeb ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="2275866327478859777">FlyWeb palīgs</translation>
<translation id="2575822587468774919">Atlasiet jebko, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="683641781063074351">Pierakstieties pārlūkā FlyWeb, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="1659167470250249643">Skenējiet kvadrātkodu, izmantojot tālruni, lai lejupielādētu pārlūku FlyWeb un pierakstītos savā FlyWeb kontā.</translation>
<translation id="5353172248151202719">meklēšanai pārlūkā FlyWeb.</translation>
<translation id="3231856291920394348">Turpināt lietot FlyWeb</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistēma</translation>
<translation id="7683745685556117660">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus citos FlyWeb profilos.</translation>
<translation id="5862783156828836752">Lai izmantotu un saglabātu FlyWeb datus savā kontā (<ph name="ACCOUNT_EMAIL"/>), apstipriniet savu identitāti.</translation>
<translation id="4450675160413947126">Startēt FlyWeb</translation>
<translation id="3827993926722004004">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet FlyWeb vēlreiz.</translation>
<translation id="333184635927514678">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku FlyWeb atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="3917488635054382918">Ērti piekļūstiet pakalpojumam Gemini pārlūkā FlyWeb savā ierīcē, pat ja pārlūka FlyWeb logs ir minimizēts.</translation>
<translation id="1257705702166647105">FlyWeb cilne</translation>
<translation id="2796283369875688710">Papildu drošības nolūkos FlyWeb šifrēs jūsu datus.</translation>
<translation id="1118215875395945816">Lai noņemtu savu FlyWeb kontu no pārlūka FlyWeb, izrakstieties.</translation>
<translation id="3320675843036708646">Pierakstieties pārlūkā FlyWeb, lai varētu piekļūt parolēm, grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2753623023919742414">Noklikšķiniet, lai meklētu</translation>
<translation id="8027563534376000179">Iestatiet FlyWeb kā noklusējuma PDF failu skatītāju.</translation>
<translation id="7907238427168022751">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka FlyWeb, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="1489590198317876070">Jūsu FlyWeb</translation>
<translation id="2816462166102338036">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6850011743146651977">Izmantojiet pārlūku FlyWeb operētājsistēmā iOS, lai atklātu produktus, izmantojot kameru, izsekotu cenu samazinājumam un veiktu citas darbības, atrodoties ceļā</translation>
<translation id="2841525013647267359">Tulkot no šādas valodas:</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="1339341044496643931">Noņemšana no pārlūka FlyWeb...</translation>
<translation id="4922993584046885552">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā FlyWeb. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās FlyWeb lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="3806033752149316261">Par &amp;FlyWeb</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="3497031519171753772">Jūsu dati ir šifrēti, izmantojot ieejas frāzi. Ievadiet ieejas frāzi, lai izmantotu un saglabātu FlyWeb datus savā FlyWeb kontā.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="1784605133570901105">Ātrāk pierakstieties vietnēs, izmantojot saglabātās paroles pārlūkam FlyWeb operētājsistēmā iOS.</translation>
<translation id="5383705372991100927">Pārlūku FlyWeb pārvalda jūsu organizācija</translation>
<translation id="1661079783259785361">FlyWeb ir atjaunināts</translation>
<translation id="5447533789927384736">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, FlyWeb var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="3208925917545144893">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pierakstieties pārlūkā FlyWeb</translation>
<translation id="3003694935412297923">Visi uzdevumi</translation>
<translation id="1216763100505470452">{count,plural, =1{Pārlūkā FlyWeb ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu FlyWeb kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Pārlūkā FlyWeb ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu FlyWeb kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Pārlūkā FlyWeb ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu FlyWeb kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienums) tiks dzēsti.}other{Pārlūkā FlyWeb ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu FlyWeb kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="8404327407921790238">Atveriet vietrādi <ph name="URL"/> jaunā cilnē pārlūkā FlyWeb.</translation>
<translation id="5184501306555415561">MI inovācijas, piemēram, prasmes, tiek saglabātas jūsu FlyWeb kontā un pārvaldītas atsevišķi no FlyWeb sinhronizācijas.</translation>
<translation id="4409390320695765203">Lai piekļūtu paplašinājumiem un citiem datiem visās savās ierīcēs, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="8841609317523323027">Notiek pievienošana pārlūkam FlyWeb...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3045032126857188731">Tulkojuma valoda: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Aizvērt atsauksmju dialoglodziņu</translation>
<translation id="2666189940580882376">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt lasīšanas sarakstam un citiem datiem no <ph name="DEVICE"/>.</translation>
<translation id="4451837224464070850">Citi FlyWeb profili</translation>
<translation id="4351369660845291597">Paplašinājumi ir papildinājumi, kas ļauj pielāgot pārlūku FlyWeb. Paplašinājumi palīdz jums pielāgot pārlūku FlyWeb, sākot no darba organizēšanas līdz ikdienas uzdevumu vienkāršošanai.</translation>
<translation id="7859502023458300952">Palīdzēt uzlabot FlyWeb, nosūtot FlyWeb serveriem avāriju pārskatus un <ph name="UMA_LINK"/></translation>
<translation id="1125501479713660011">Izmantojiet lietotni FlyWeb, lai piekļūtu FlyWeb drošības iespējām, atrodoties ceļā</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{Vismaz viens FlyWeb paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens FlyWeb paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens FlyWeb paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens FlyWeb paplašinājums piekļūst # USB ierīcei}other{Vismaz viens FlyWeb paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="6017373390117959211">Lai iegūtu lasīšanas sarakstu un citus datus no ierīces <ph name="DEVICE"/>, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="7898392424469957829">FlyWeb vēsture</translation>
<translation id="1407857531570256859">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet FlyWeb vēlreiz.</translation>
<translation id="310459126943037700">Neizdevās pabeigt uzdevumus.</translation>
<translation id="3104828284009500087">Meklēt jebkādu informāciju lapā</translation>
<translation id="4706932464498663870">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz FlyWeb.</translation>
<translation id="1309738977648134943">Pārlūkā FlyWeb tiek izmantots jūsu mikrofons.</translation>
<translation id="3130333203120345554">Jauns meklējums</translation>
<translation id="3137969841538672700">Velciet, lai meklētu</translation>
<translation id="2251813826843049011">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam FlyWeb padarīt to neaktīvu.</translation>
<translation id="2664701271733223256">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā FlyWeb.</translation>
<translation id="6274649779206195384">Restartēt FlyWeb</translation>
<translation id="3161522574479303604">Visas valodas</translation>
<translation id="6773570808762718524">Pielāgojiet savu jauno FlyWeb profilu.</translation>
<translation id="8965010907836433875">Varat turpināt tērzēšanu MI režīmā, nepārslēdzot cilnes. Lai sāktu darbu, pierakstieties pārlūkā FlyWeb. Jūs arī varēsiet piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="5958835776851191812">Lai noņemtu savu FlyWeb kontu no pārlūka FlyWeb, lapā “Iestatījumi” izrakstieties no pārlūka FlyWeb.</translation>
<translation id="4217346567895356023">Vēlāk pārlūkā FlyWeb var tikt vaicāts, vai vēlaties izmantot saglabāto informāciju veidlapu automātiskai aizpildei.</translation>
<translation id="5449297306961970452">FlyWeb nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">Izmantojiet pārlūku FlyWeb operētājsistēmā iOS, lai piekļūtu saviem iecienītākajiem FlyWeb MI rīkiem, atrodoties ceļā.</translation>
<translation id="8090118570458552025">Lai piekļūtu paplašinājumiem un citiem datiem no ierīces <ph name="DEVICE"/>, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="3900612994249740104">Trūkst FlyWeb API atslēgu. Tiks atspējotas dažas FlyWeb funkcijas.</translation>
<translation id="6824575001009586492">Turpināt lietotņu izpildi fonā, kad FlyWeb ir aizvērts</translation>
<translation id="2595215790271940091">Pārlūkā FlyWeb tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="3701353923785984059">Aizverot visus FlyWeb logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no FlyWeb konta, ja esat pierakstījies pārlūkā FlyWeb. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">meklēšanas apgabala augšējais labais stūris: <ph name="RIGHT"/>% pa labi, <ph name="TOP"/>% augšdaļā</translation>
<translation id="8629055140319079166">FlyWeb dati jūsu kontā</translation>
<translation id="1943161457314845496">Izmantojiet savas paroles pārlūkā FlyWeb savā tālrunī</translation>
<translation id="2645435784669275700">FlyWeb OS</translation>
<translation id="7978410129406361692">Vai pāriet uz esošo FlyWeb profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="1568435374218487057">Lai piekļūtu grāmatzīmēm un citiem datiem no ierīces <ph name="DEVICE"/>, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="3438772217992559640">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6301354573631022693">Izmantojiet funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā FlyWeb savā tālrunī</translation>
<translation id="7625477329092296018">Notiek FlyWeb pielāgošana…</translation>
<translation id="956833467923764542">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT"/> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā FlyWeb kā <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">Lai pārslēgtos starp FlyWeb profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT"/>.</translation>
<translation id="6724485219247982027">Aizveriet visus FlyWeb logus un mēģiniet vēlreiz.</translation>
<translation id="5048962017649434283">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā FlyWeb.</translation>
<translation id="1582211253241551883">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="408747932595284596">Kvadrātkods pārlūka FlyWeb lejupielādei mobilajās ierīcēs</translation>
<translation id="1413410454753055427">Atgādinājums: FlyWeb labākās drošības funkcijas vienmēr par rokai</translation>
<translation id="7831730508158736496">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā FlyWeb.</translation>
<translation id="9006158231572141726">Izmantojot uzlaboto aizsardzību, tiek izslēgta JavaScript optimizācija vietnēm, ko FlyWeb neatpazīst.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">Pierakstīšanās pārlūkā FlyWeb</translation>
<translation id="6970052268542136081">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā FlyWeb kā lietotājs <ph name="USER_EMAIL"/>.</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="2438845157914027912">Izmantot jūsu <ph name="BEGIN_LINK"/>ieejas frāzi<ph name="END_LINK"/> visu FlyWeb datu šifrēšanai jūsu FlyWeb kontā. Maksājumu veidi un adreses no pakalpojuma FlyWeb Pay netiks šifrētas. Pārlūkā FlyWeb saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="6611602069520888180">Atvērt saiti jaunā FlyWeb &amp;cilnē</translation>
<translation id="2591356225047803326">Saistiet pārlūku FlyWeb un citus FlyWeb pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3729187154190517324">Padziļiniet meklēšanu, izmantojot pogu “Pievienot cilni un citu kontekstu”, lai pievienotu vairākas cilnes, failus un rīkus.</translation>
<translation id="1771882170639856394">Pārvaldīt FlyWeb profilus</translation>
<translation id="3782148374606932577">Uzziniet, kāpēc FlyWeb bloķē noteiktas lejupielādes</translation>
<translation id="4640643918757362950">Ja kaut kas būs jāpārskata, saņemsiet FlyWeb paziņojumu</translation>
<translation id="2179738813053854729">Pārlūkā FlyWeb tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3810973564298564668">Pārvaldīt</translation>
<translation id="5026502787439628947">Lai izmantotu savas saglabātās paroles, izmantojiet saiti kvadrātkodā, lejupielādējiet pārlūku FlyWeb operētājsistēmai iOS un pierakstieties savā FlyWeb kontā.</translation>
<translation id="3846683726093018685">**Apkopošana:** vienā teikumā, kas nepārsniedz 30 vārdus, aprakstiet ekrānuzņēmumā redzamā satura galveno tēmu un nolūku.

          **Jautājumu ieteikšana:** ģenerējiet sarakstu ar aizzīmēm ar 3–5 jautājumiem, kas liek aizdomāties un kurus lietotājs varētu uzdot, lai labāk izprastu ekrānuzņēmumu. Šajos jautājumos ir jābūt vismaz vienam jautājumam, kas ir saistīts ar vizuālu objektu, tā dizainu vai izvietojumu.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> — FlyWeb</translation>
<translation id="2980328991301740921">Lai piekļūtu grāmatzīmēm un citiem datiem visās savās ierīcēs, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="3885770153807205175">Valodas atlasītājs</translation>
<translation id="5175060854726708547">Pielāgojiet un kontrolējiet pārlūkprogrammu FlyWeb. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="606156353708638647">Noklikšķiniet uz sava vārda, lai atvērtu FlyWeb un sāktu pārlūkošanu.</translation>
<translation id="3892148308691398805">Kopēt tekstu</translation>
<translation id="5145107420478372433">Lietotājs <ph name="EXISTING_USER"/> jau ir pierakstījies šajā FlyWeb profilā. Lai atdalītu pārlūkošanu, pārlūkā FlyWeb varat sev izveidot atsevišķu profilu.</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="8536259619256229278">FlyWeb mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="7965008434896274911">Lai iegūtu saglabāto informāciju un citus datus visās savās ierīcēs, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="4540773594514226705">Jūsu FlyWeb kontā saglabātās paroles, maksājuma veidi un adreses tiks noņemtas no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā FlyWeb, atkārtoti pierakstieties.</translation>
<translation id="395904275706073188">Aizsargātas lapas nevar lasīt. Izmēģiniet citu lapu.</translation>
<translation id="3849784651193576458">Uzziniet, kā FlyWeb rūpējas par jūsu drošību</translation>
<translation id="3967822245660637423">Lejupielāde pabeigta</translation>
<translation id="562495843857641474">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks FlyWeb nosūta rakstīto tekstu jūsu organizācijas meklēšanas, MI un starpnieku rīkiem, lai iegūtu ieteikumus.</translation>
<translation id="5667414856761616811">Par FlyWeb for Testing</translation>
<translation id="1152920704813762236">Par FlyWeb OS</translation>
<translation id="4920206821838432969">Kad apmeklējat kādu vietni, pārlūks FlyWeb nosūta funkcijai <ph name="BEGIN_LINK"/>FlyWeb droša pārlūkošana<ph name="END_LINK"/> pieslēptu URL daļu, izmantojot konfidencialitātes serveri, kas slēpj jūsu IP adresi. Ja vietnē tiek veiktas aizdomīgas darbības, tiek nosūtīti arī pilni URL un lapas satura fragmenti.</translation>
<translation id="4016217212818346953">Gādājiet par drošību, izmantojot paroļu pārvaldnieku</translation>
<translation id="3703994572283698466">FlyWeb OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS"/>Linux izstrādes vides<ph name="END_LINK_LINUX_OSS"/> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS"/>atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="4022972681110646219">Tulkot ekrāna tekstu</translation>
<translation id="4023601594785368013">Oriģinālvaloda: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">Atveriet saites pārlūkā FlyWeb no jebkuras lietotnes. Turklāt pārlūks tiks piesprausts uzdevumjoslā, lai nodrošinātu ērtāku piekļuvi.</translation>
<translation id="504994999924593940">Palīdziet uzlabot pārlūku FlyWeb, ziņojot par <ph name="BEGIN_LINK"/>pašreizējiem iestatījumiem<ph name="END_LINK"/>.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="4105099155797156500">Pāriet uz lapu “Par FlyWeb”</translation>
<translation id="7753744564324413106">Pielāgojiet pārlūku FlyWeb, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="3202882878525816493">P&amp;ielāgot pārlūku FlyWeb</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> — pierakstīšanās tīklā — FlyWeb</translation>
<translation id="6368928751841546993">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt lasīšanas sarakstam un citiem datiem visās savās ierīcēs.</translation>
<translation id="4007949387571083162">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā FlyWeb.</translation>
<translation id="4753212377237684548">Lai piekļūtu šim paplašinājumam un citiem datiem visos savos datoros, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="4391959806766569994">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pārslēdzieties uz FlyWeb profilu, kurā jau pierakstījāties ar kontu <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="2564888740660198776">Vai saistīt FlyWeb datus ar šo kontu?</translation>
<translation id="7337819873931851298">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja FlyWeb par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist FlyWeb brīdinājumus.</translation>
<translation id="8391959103619318249">Izrakstīties no pārlūka FlyWeb</translation>
<translation id="8514458758262040082">Saņemt palīdzību par FlyWeb</translation>
<translation id="4281844954008187215">FlyWeb pakalpojumu noteikumi</translation>
<translation id="3393587701694585022">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja FlyWeb šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="271336227467646058">Paroļu eksportēšana no pārlūka FlyWeb</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334241893986177674">Meklēt šajā ekrānuzņēmumā</translation>
<translation id="125418423241058931">Palaist pārlūku FlyWeb, kad tiek palaista operētājsistēma Windows</translation>
<translation id="4400772909124543403">Neviens atjauninājums nav pieejams.</translation>
<translation id="1376968889000878095">Vai tik un tā aizvērt pārlūku FlyWeb?</translation>
<translation id="4413205837991854510">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="6360389033094512399">Ļaut pārlūkam FlyWeb darboties fonā</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{FlyWeb iesaka to noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}zero{FlyWeb iesaka tos noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}one{FlyWeb iesaka tos noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}other{FlyWeb iesaka tos noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}}</translation>
<translation id="4166347503469830337">Pielāgot un kontrolēt FlyWeb</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR"/></translation>
<translation id="1198322798411238228">Pārlūku FlyWeb pārvalda organizācija “<ph name="MANAGER"/>”</translation>
<translation id="6643422079097100220">Pievienot FlyWeb profilu</translation>
<translation id="8791209382165811772">Par FlyWeb for Testing</translation>
<translation id="5651107152880556886">Lai izmantotu un saglabātu FlyWeb datus savā FlyWeb kontā, ievadiet ieejas frāzi.</translation>
<translation id="4493028449971051158">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā administrators.</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="3546782282376530369">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. FlyWeb iesaka to noņemt.</translation>
<translation id="834808339160590901">Laipni lūdzam pārlūkā FlyWeb (tika atvērts jauns pārlūka logs)!</translation>
<translation id="5094033276783634414">Pārlūkam FlyWeb ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="3363095592946520579">Ar kontu <ph name="USER_EMAIL_ADDRESS"/> jau esat pierakstījies citā FlyWeb profilā</translation>
<translation id="8767255662414713095">Pārlūkā FlyWeb tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu. Varat <ph name="BEGIN_LINK"/>uzzināt vairāk par lapu iepriekšēju ielādi<ph name="END_LINK"/>.</translation>
<translation id="4549180975214802957">Uzlabojiet tiešsaistes drošību visiem lietotājiem, ziņojot par vietni, kas, jūsuprāt, ir kaitīga.</translation>
<translation id="5891777644455025808">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="8775108347138515815">Izmēģiniet FlyWeb Lens pārlūkā FlyWeb savā tālrunī</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="3349475100979552835">FlyWeb lietotnes</translation>
<translation id="4598116752460667024">Sarakstā meklējiet jebkuru procesu.</translation>
<translation id="4970880042055371251">FlyWeb OS versija</translation>
<translation id="1936188352112244665">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku FlyWeb.</translation>
<translation id="7657326395720709145">Paātrina vietņu darbību, izmantojot FlyWeb programmu V8, taču nedaudz samazina FlyWeb izturību pret uzbrukumiem.</translation>
<translation id="7966026667528388481">Atvērt meklēšanu pārlūkā FlyWeb</translation>
<translation id="7949810958067850297">FlyWeb profils</translation>
<translation id="2962574118577609024">Ja kopīgojat arī FlyWeb lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="4673710618874938871">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME"/>, un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="9219132550163437762">Šķiet, ka profils tiek izmantots citā FlyWeb procesā (<ph name="PROCESS_ID"/>) citā datorā (<ph name="HOST_NAME"/>). Lai profils netiktu bojāts, pārlūkā FlyWeb tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku FlyWeb.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="6156840135417578237">Noteikti jūsu FlyWeb dati vēl nav saglabāti jūsu FlyWeb kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="1474749355173247622">Kamēr esat pierakstījies, pārlūkā FlyWeb varat izmantot savas paroles un citu saturu no FlyWeb konta. <ph name="SHORTCUT"/> var mainīt jūsu FlyWeb pakalpojumu iestatījumus.</translation>
<translation id="5227023869666757348">Kāds iepriekš pierakstījās pārlūkā FlyWeb šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST"/>. Lūdzu, izveidojiet jaunu FlyWeb lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="1671154647029930623">Vai tik un tā aizvērt pārlūku FlyWeb?</translation>
<translation id="4143239505982500022">Tikko tika piemērots īpašs FlyWeb drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="82292346243148940">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā FlyWeb tika noņemtas šādas atļaujas: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> un vēl <ph name="COUNT"/>.</translation>
<translation id="1802926274661855018">Ja pakalpojums Gemini pārlūkā FlyWeb ir atvērts, jaunu ciļņu izveidošanas laikā sānu panelis paliek atvērts.</translation>
<translation id="3469649164996417993">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots FlyWeb meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts FlyWeb serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="7460496601839821581">Izmantot FlyWeb, nepierakstoties kontā</translation>
<translation id="2991144524835127379">Ienākošo savienojumu kārtula pārlūkam FlyWeb, lai atļautu mDNS datplūsmu.</translation>
<translation id="6208903184719035736">Atkārtoti palaist, lai atjauninātu &amp;FlyWeb</translation>
<translation id="4918086044614829423">Pieņemt</translation>
<translation id="4918844574251943176">Attēls ir nokopēts</translation>
<translation id="5477235053075501816">Lai piekļūtu lasīšanas sarakstam un citiem datiem visās savās ierīcēs, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="7174589544844983914">FlyWeb darbojas fona režīmā.</translation>
<translation id="9212977598552218412">Noklikšķiniet, lai aizvērtu FlyWeb pierakstīšanās dialoglodziņu</translation>
<translation id="8366169706197332122">Izmantojot FlyWeb profilus, varat nodalīt visu savu FlyWeb saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="7792628702371319769">Viesi var izmantot FlyWeb, neatstājot nekādas pēdas.</translation>
<translation id="7370618680298767482">Jūsu konts pārlūkā FlyWeb</translation>
<translation id="2760069255902967585">Pievienot savu kontu pārlūkā FlyWeb</translation>
<translation id="504699503110800016">Atvērt pārpildes izvēlni</translation>
<translation id="6686344057006524628">Piekļūstiet visām savām FlyWeb izlases vietnēm, izmantojot pārlūku FlyWeb savā ierīcē (<ph name="DEVICE_TYPE"/>)</translation>
<translation id="2515109138500267971">Pārlūkam FlyWeb ir nepieciešama atļauja izsekot jūsu roku kustības.</translation>
<translation id="3910606758302645363">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā FlyWeb tika noņemtas šādas atļaujas: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet uz paziņojumu ikonas atrašanās vietas joslas labajā stūrī.</translation>
<translation id="5174983315706567306">Diskā nepietiek brīvas vietas.</translation>
<translation id="4326845160190496236">FlyWeb kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="3540715470656277664">Turpiniet iesākto, izmantojot pārlūku FlyWeb operētājsistēmā iOS.</translation>
<translation id="291933003154435191">Izrakstīšanās no FlyWeb</translation>
<translation id="5234764350956374838">Nerādīt</translation>
<translation id="9098587825736815971">Iegūstiet lietotni FlyWeb, lai saglabātu paroles, atrodoties ceļā</translation>
<translation id="8295539942024823191">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku FlyWeb.</translation>
<translation id="5286907366254680517">Noteiktā valoda</translation>
<translation id="626007313130236514">Iegūt lietotni FlyWeb</translation>
<translation id="5361365805808004630">Meklēšana pārlūkā FlyWeb</translation>
<translation id="8888283148421206435">FlyWeb atjauninātājs: iekšējais pakalpojums</translation>
<translation id="3025882852178035952">Izmantojiet tās kopā ar citām Gemini funkcijām pārlūkā FlyWeb.</translation>
<translation id="5346389065299425353">Padziļiniet meklēšanu, pievienojot vairākas cilnes, failus un rīkus.</translation>
<translation id="8330248712705246714">Iegūstiet īsu šī dokumenta kopsavilkumu un uzdodiet jautājumus, izmantojot Gemini pārlūkā FlyWeb</translation>
<translation id="6178233095056047786">Pārlūkā FlyWeb tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="8980390875915032396">Citi FlyWeb profili</translation>
<translation id="2441009746272048284">ChromeOS nevarēja saglabāt FlyWeb datus jūsu FlyWeb kontā, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="8449603408481238073">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu FlyWeb dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME"/>. Varēsiet dzēst šos datus, izmantojot FlyWeb kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">Lai izmantotu personalizēšanu, iekļaujiet pārlūku FlyWeb iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="1456957080321742545">Atvērt meklēšanu pārlūkā FlyWeb</translation>
<translation id="1026219128963768190">Uzzināt, kāpēc pārlūkā FlyWeb daži faili tiek bloķēti</translation>
<translation id="1284798564810038820">Notiek FlyWeb atjaunināšana (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="4384293746734222420">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt paplašinājumiem un citiem datiem visās savās ierīcēs.</translation>
<translation id="3872448231555118416">Atļaut pierakstīties pārlūkā FlyWeb</translation>
<translation id="1827750898515917134">Noņemt no pārlūka FlyWeb</translation>
<translation id="7460715011003906078">Samazina veiktspēju, taču uzlabo FlyWeb izturību pret uzbrukumiem.</translation>
<translation id="5020755920249060562">Iestatīt FlyWeb kā noklusējuma pārlūku</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> — FlyWeb beta versija</translation>
<translation id="1842654828911709974">{NUM_TABS,plural, =1{FlyWeb iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{FlyWeb iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{FlyWeb iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{FlyWeb iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="5385202369020319636">Iespējams, pārlūks FlyWeb nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="362367838300880777">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="2183749398075655200">Lūdzu, uzgaidiet, kamēr FlyWeb instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="8996657165865563765">FlyWeb mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="832204641669191126">Izmantojot FlyWeb, varat turpināt strādāt ar savām iecienītākajām lietotnēm, piemēram, FlyWeb disku un YouTube, atrodoties ceļā.</translation>
<translation id="5524890928877629608">meklēšanas apgabala augšējais kreisais stūris: <ph name="LEFT"/>% pa kreisi, <ph name="TOP"/>% augšdaļā</translation>
<translation id="5738298079259740925">Atvērt PDF failus pārlūkā FlyWeb</translation>
<translation id="5536164441519929134">Jautājiet<ph name="LINE_BREAK"/>par šo cilni</translation>
<translation id="6197315294677032380">Drošības apsvērumu dēļ pārlūkā FlyWeb tiek izslēgta JavaScript optimizācija, kad pirmoreiz apmeklējat kādu vietni.

Ja šī lapa nedarbojas, kā paredzēts, mēģiniet atļaut optimizāciju.</translation>
<translation id="2009834183541338014">Rādīt pakalpojumu Gemini pārlūkā FlyWeb Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="1307223624786767430">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem no <ph name="DEVICE"/>.</translation>
<translation id="5579324208890605088">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā parasts lietotājs, nevis kā administrators.</translation>
<translation id="4770353132265458564">Izmantojiet pārlūku FlyWeb pēc noklusējuma un piespraudiet to</translation>
<translation id="5596627076506792578">Citas opcijas</translation>
<translation id="5605834417512968703">Atlasiet jebko, ko vēlaties meklēt, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5618818588972826921">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="6096945112863785306">{0,plural, =0{Ir pieejams FlyWeb atjauninājums}=1{Ir pieejams FlyWeb atjauninājums}zero{FlyWeb atjauninājums ir pieejams jau # dienu}one{FlyWeb atjauninājums ir pieejams jau # dienu}other{FlyWeb atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="7698117871740446964">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks FlyWeb</translation>
<translation id="5666891644992637849">Lūdzu, nekavējoties restartējiet pārlūku FlyWeb</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Rādīt FlyWeb šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="5406894461513282158">Pārlūkā FlyWeb neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots FlyWeb darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat. Varat <ph name="BEGIN_LINK"/>uzzināt vairāk par atmiņas taupīšanas režīmu<ph name="END_LINK"/>.</translation>
<translation id="4909672456103357452">Ja aizmirsāt ieejas frāzi vai vēlaties mainīt šo iestatījumu, varat <ph name="SETTINGS_LINK"/> FlyWeb datus savā kontā.</translation>
<translation id="4985665094509307744">Pielāgojiet un kontrolējiet pārlūku FlyWeb. Iestatiet FlyWeb kā noklusējuma pārlūku.</translation>
<translation id="6646499372922411025">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs, iestatot FlyWeb kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="5890196138054330443">Paātrina vietņu darbību, izmantojot FlyWeb programmu V8, bet nedaudz samazina FlyWeb izturību pret uzbrukumiem. Šis iestatījums ir izslēgts.</translation>
<translation id="8651664269417935890">Lai izmantotu un saglabātu FlyWeb datus FlyWeb kontā, atjauniniet pārlūku FlyWeb.</translation>
<translation id="5824893331272123205">Nevarēja ielādēt šo paneli. Mēģiniet vēlreiz.</translation>
<translation id="8331941171144629807">Laipni lūdzam pārlūkā FlyWeb!</translation>
<translation id="5831968418530309689">Tiek ieslēgtas papildu funkcijas, lai nodrošinātu visefektīvāko FlyWeb aizsardzību.</translation>
<translation id="5871205389137001634">Noklikšķiniet, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="7581082856615467651">Pārlūkā FlyWeb tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="8117102597407263352">FlyWeb regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="7740963625398321937">Gemini Enterprise pārlūkā FlyWeb</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="6669708050135513710">Lai varētu izmantot šo grāmatzīmi un citus datus visās savās ierīcēs, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="3358004031263458708">FlyWeb personalizēšana</translation>
<translation id="5960071705175224773">Jūsu iestatījumus mainīja nezināma lietotne</translation>
<translation id="5977420883993828287">Piesprausta! Varat atkal piekļūt kontekstuālo uzdevumu funkcijai, izmantojot rīkjoslu.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku FlyWeb, ja tas nav izmantots # minūtes.}}</translation>
<translation id="4955869506208896934">Lai sāktu sinhronizēšanu, atjauniniet FlyWeb.</translation>
<translation id="5990360079535151574">Izmantojot rīkjoslā pieejamo pogu “Kontekstuālie uzdevumi”, varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS"/> stunda(-as).</translation>
<translation id="6009821354356307391">Uzdot papildu jautājumu</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="4530644097272078700">Izmantojiet lietotni FlyWeb savā ierīcē (<ph name="DEVICE_TYPE"/>), lai piekļūtu vairāk iespējām, iepērkoties tiešsaistē</translation>
<translation id="619330138913595431">Lai aizsargātu savus datus, ļaujiet pārlūkā FlyWeb atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="8714139918792771260">&amp;Atvērt pārlūkā FlyWeb</translation>
<translation id="6069027071882229820">Kopēt kā attēlu</translation>
<translation id="499541338626558192">Paplašinājums <ph name="EXTENSION_NAME"/> ir pievienots pārlūkam FlyWeb</translation>
<translation id="5880307616068888895">Pielāgojiet un pārvaldiet pārlūku FlyWeb. Ir pieejams atjauninājums.</translation>
<translation id="1429530657225981960">Ieslēgts • FlyWeb nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="8056369489402655495">Jūsu konts pārlūkā FlyWeb</translation>
<translation id="1683225514126450592">Atļaut paplašinājumam rādīt piekļuves pieprasījumus FlyWeb rīkjoslā</translation>
<translation id="4809579265564854985">Fails <ph name="FILE_NAME"/> ir bīstams, tādēļ FlyWeb to bloķēja.</translation>
<translation id="1773252983747911987">FlyWeb drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="1686760912855738719">Šeit varat pārslēgties starp FlyWeb profiliem.</translation>
<translation id="5461795497268691356">Ja atļaujat sīkfailus, pārlūks FlyWeb var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6165508094623778733">Uzzināt vairāk</translation>
<translation id="1292852397592425449">Notīrīt FlyWeb datus savā kontā</translation>
<translation id="7031783851441272920">Šis fails var būt bīstams.<ph name="LINE_BREAK"/>FlyWeb var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “FlyWeb droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="4403968929742079769">Ierīcē <ph name="TARGET_DEVICE_NAME"/> pierakstieties pārlūkā FlyWeb un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="8345188246355148375">Meklējiet un uzdodiet jautājumus no jebkuras vietas, pat ja pārlūka FlyWeb logs ir minimizēts. Pārlūks FlyWeb var darboties fonā.</translation>
<translation id="1855179706668101462">Šim datoram jau ir jaunākā FlyWeb versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku FlyWeb un mēģiniet vēlreiz.</translation>
<translation id="651290634887454330">{0,plural, =0{Pārlūks FlyWeb tūlīt tiks restartēts}=1{Pārlūks FlyWeb pēc 1 sekundes tiks restartēts}zero{Pārlūks FlyWeb pēc # sekundēm tiks restartēts}one{Pārlūks FlyWeb pēc # sekundes tiks restartēts}other{Pārlūks FlyWeb pēc # sekundēm tiks restartēts}}</translation>
<translation id="2586408713760853791">Pārlūkam FlyWeb ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="1603558835003845196">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā FlyWeb.</translation>
<translation id="5751080530525677552">Padarīt FlyWeb par noklusējuma pārlūku</translation>
<translation id="6248988683584659830">Meklēt iestatījumus</translation>
<translation id="6342238100521499844">Izmantojiet lietotni FlyWeb savā tālrunī, lai iegūtu labākās FlyWeb drošības funkcijas, atrodoties ceļā</translation>
<translation id="3542157007113577464">Vai izrakstīties no FlyWeb?</translation>
<translation id="2166321493116256664">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam FlyWeb padarīt tās neaktīvas.</translation>
<translation id="3794967601634523398">Pielāgot FlyWeb profilu</translation>
<translation id="6475001900959697061">FlyWeb profila nosaukšana</translation>
<translation id="6356094940346377065">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā FlyWeb</translation>
<translation id="4465156155012748592">Fails <ph name="FILE_NAME"/> var būt bīstams, tādēļ FlyWeb to bloķēja.</translation>
<translation id="5523868569707953059">FlyWeb saitē tiek izmantota kamera.</translation>
<translation id="8226838065217375546">Tiek veikta cita darbība pārlūkā FlyWeb. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="6063700568539132984">Tagad pārlūkā FlyWeb ir vieglāk izmantot FlyWeb kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="5622088198573179705">Iegūstiet ērtu piekļuvi zināmajām, iecienītajām un uzticamajām funkcijām, iestatot FlyWeb kā noklusējuma pārlūku.</translation>
<translation id="4709797814274745581">FlyWeb saīsne</translation>
<translation id="6595693843242836271">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="6890209090736444656">Vai tiešām vēlaties atinstalēt pārlūku FlyWeb?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6388799252195623474">palīdzēt man ar šo</translation>
<translation id="8407518452288816185">Lai turpinātu, pierakstieties pārlūkā FlyWeb ar kontu <ph name="EMAIL"/>. Tas nodrošinās jūsu organizācijas politiku ievērošanu.</translation>
<translation id="2104550252781001709">FlyWeb logotips datora ekrānā.</translation>
<translation id="6636986997730784876">FlyWeb ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā FlyWeb.</translation>
<translation id="4359872290500912570">Lai vienmēr varētu izmantot un saglabāt FlyWeb datus savā FlyWeb kontā, apstipriniet savu identitāti.</translation>
<translation id="3141715584864891679">FlyWeb darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā</translation>
<translation id="6436260184216827876">Funkcija Attēlu meklēšana nav pieejama. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="2139300032719313227">FlyWeb OS restartēšana</translation>
<translation id="7560906925528428585">Pārlūkā FlyWeb tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="5806916401157869650">Lejupielādējiet pārlūku FlyWeb savā tālrunī, lai izsekotu cenas un saņemtu brīdinājumus, kad kādā vietnē tiek konstatēts cenas samazinājums.</translation>
<translation id="2970877059928503461">Izslēgts • FlyWeb nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="173462352822069427">Laipni lūdzam FlyWeb profilos!</translation>
<translation id="8914008746092110409">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE"/>) atvērsiet pārlūku FlyWeb, tiks parādīts aicinājums izmantot ciļņu grupas.</translation>
<translation id="3484308111967198595">Noņemt kontu no pārlūka FlyWeb</translation>
<translation id="1474676525193357364">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku FlyWeb.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="5777905264835557372">Atinstalēt FlyWeb</translation>
<translation id="764623543427374554">Saīsnes tiek atvērtas pārlūkā FlyWeb</translation>
<translation id="8852057261917278552">Jūsu organizācija aizver pārlūku FlyWeb, ja tas <ph name="TIMEOUT_DURATION"/> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="8592211619057897362">Katrā profilā tiek glabāta attiecīgā FlyWeb profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6556755379298048869">Veiciet meklēšanu, izmantojot īsinājumtaustiņu.</translation>
<translation id="4273595998837775033">Uzziniet vairāk par to, <ph name="BEGIN_LINK"/>kā pārlūkā FlyWeb tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK"/>.</translation>
<translation id="654107331777480705">Šī iestatījuma izmaiņas tiks lietotas pēc pārlūka FlyWeb restartēšanas.</translation>
<translation id="3594828538355548672">Pārvaldiet savus paplašinājumus, FlyWeb galvenajā izvēlnē noklikšķinot uz Paplašinājumi.</translation>
<translation id="7489092380688543560">Varat pārslēgties, lai skatītu paroles no cita FlyWeb profila.</translation>
<translation id="472958395762114471">Izmantojiet lietotni FlyWeb, lai piekļūtu vislabākajiem MI rīkiem, atrodoties ceļā</translation>
<translation id="8243012192239086369">Lai izlabotu pareizrakstības kļūdas, FlyWeb nosūta teksta laukos ievadīto tekstu FlyWeb serveriem.</translation>
<translation id="3927263773110604886">Pāriet uz FlyWeb paziņojumu iestatījumiem</translation>
<translation id="6600016381025017075">Meklēt informāciju par jebkuru šīs lapas satura daļu</translation>
<translation id="6888846095017247017">Izmaiņas stāsies spēkā, kad restartēsiet FlyWeb.</translation>
<translation id="4481788155537463533">Tagad pārlūks FlyWeb tiek palaists, kad tiek palaista operētājsistēma Windows, lai jūs varētu uzreiz sākt pārlūkošanu. Šo funkciju var izslēgt iestatījumos.</translation>
<translation id="1116311888485102603">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā FlyWeb tika atjaunotas cilnes no jūsu pēdējās sesijas. Varat to izslēgt lapā</translation>
<translation id="1886169834787876002">Pārlūkam FlyWeb ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="7570986009744020649">Ja saglabāsiet grāmatzīmes arī FlyWeb kontā, varēsiet izsekot produktu cenām pārlūkā FlyWeb un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="1363996462118479832">FlyWeb OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="5743696427773796626">Noņemt šo lietotņu datus no FlyWeb</translation>
<translation id="4152880912192471857">Pārlūkam FlyWeb ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">Jūsu profilu nevar izmantot, jo tas ir no jaunākas FlyWeb versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku FlyWeb versiju.</translation>
<translation id="5528558621229392814">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku FlyWeb iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie FlyWeb pakalpojumi”.</translation>
<translation id="7728046102681268859">Pārlūks FlyWeb jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="2006421382007321898">Pierakstieties pārlūkā FlyWeb, lai varētu piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs. Šī grāmatzīme tiks saglabāta jūsu FlyWeb kontā pēc pierakstīšanās.</translation>
<translation id="4328426102261301637">Paātrina vietņu darbību, izmantojot FlyWeb programmu V8, bet nedaudz samazina FlyWeb izturību pret uzbrukumiem. Šis iestatījums ir ieslēgts.</translation>
<translation id="207175655966839154">{count,plural, =1{Noteikti jūsu FlyWeb dati vēl nav saglabāti jūsu FlyWeb kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Noteikti jūsu FlyWeb dati vēl nav saglabāti jūsu FlyWeb kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Noteikti jūsu FlyWeb dati vēl nav saglabāti jūsu FlyWeb kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumus) tiks dzēsti.}other{Noteikti jūsu FlyWeb dati vēl nav saglabāti jūsu FlyWeb kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="1292831930742306370">FlyWeb iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="1547295885616600893">FlyWeb OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS"/>atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">Tulkot</translation>
<translation id="6432682256389755533">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā FlyWeb saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME"/> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="8852956515664182428">FlyWeb — <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">Nospiediet tabulēšanas taustiņu, lai turpinātu</translation>
<translation id="6862030660799253820">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6869568587896659271">Ērti piekļūstiet tīmekļa vietnēm zem adreses joslas.</translation>
<translation id="4695676871328690599">Pārlūkā FlyWeb tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME"/>” satur ļaunprātīgu programmatūru.</translation>
<translation id="6877155553248388166">meklēšanas apgabala apakšējais labais stūris: <ph name="RIGHT"/>% pa labi, <ph name="BOTTOM"/>% apakšdaļā</translation>
<translation id="6896758677409633944">Kopēt</translation>
<translation id="6898028264630240901">Varat piespraust kontekstuālos uzdevumus, lai pārlūkošanas laikā uzdotu jautājumus.</translation>
<translation id="8416061171168102237">Iestatiet FlyWeb kā noklusējuma pārlūku un piespraudiet to uzdevumjoslai</translation>
<translation id="3503126745419877918">&amp;Pārvaldīt FlyWeb profilus</translation>
<translation id="4397299252625349918">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS"/>
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK"/>
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK"/>
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAK"/>
            • Tiks atiestatīti FlyWeb īsinājumtaustiņi.
            <ph name="LINE_BREAKS"/>
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="2640214066670118583">Ir sasniegts FlyWeb grāmatzīmju skaita ierobežojums (<ph name="BOOKMARK_LIMIT"/>), tāpēc noteiktas jūsu grāmatzīmes vēl nav saglabātas jūsu FlyWeb kontā.

Jaunas grāmatzīmes nevar saglabāt jūsu kontā, kamēr neizdzēsīsiet dažas no tām. Ja izrakstīsieties tūlīt, nesaglabātās grāmatzīmes tiks dzēstas.</translation>
<translation id="6965382102122355670">Labi</translation>
<translation id="3453763134178591239">FlyWeb OS noteikumi</translation>
<translation id="1163386134146281359">Lai savā kontā (<ph name="ACCOUNT_EMAIL"/>) izmantotu un saglabātu FlyWeb datus, ievadiet ieejas frāzi.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">Pielāgojiet pārlūku FlyWeb savām vajadzībām</translation>
<translation id="7047386856539490735">Vai šie rezultāti ir noderīgi?</translation>
<translation id="3945284827084409390">Atjaunināt FlyWeb</translation>
<translation id="7886270027101123253">Ja attēlam nav vērtīga apraksta, pārlūks FlyWeb mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam FlyWeb.</translation>
<translation id="8434939140421950539">Piekļūstiet MI iespējām, izmantojot lietotni FlyWeb savā ierīcē (<ph name="DEVICE_TYPE"/>)</translation>
<translation id="2647329478963461727">Izmantojiet lietotni FlyWeb savā tālrunī, lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="5695394421048248926">Pielāgot versiju FlyWeb for Testing</translation>
<translation id="6802544479988856975">Varat izmantot pārlūku FlyWeb ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs.</translation>
<translation id="8694083743003679818">Noņemt paplašinājumu <ph name="EXTENSION_NAME"/> no pārlūka FlyWeb</translation>
<translation id="6017914745388312119">Jūsu organizācija dzēš FlyWeb datus, ja šis pārlūks <ph name="TIMEOUT_DURATION"/> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="3283953248242339756">Pārlūkam FlyWeb ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="4729674580260824908">Neizdevās palaist FlyWeb. Mēģiniet vēlreiz.</translation>
<translation id="805403942934515799">Atvērtajā ekrānā varat jautāt jebko Gemini pārlūkā FlyWeb</translation>
<translation id="7093403858436459499">Paturiet pārlūku FlyWeb dokā, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="935820624106805690">Izmantojiet FlyWeb ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="7216228761061470870">Kad izmantojat attēlu meklēšanu, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili.</translation>
<translation id="1678436729108859736">Uzdevumu pārvaldnieks — FlyWeb</translation>
<translation id="7587087358591725059">Uzdodiet jautājumus par saturu ārpus pārlūka FlyWeb, piemēram, par citām lietotnēm vai failiem.</translation>
<translation id="7013534648688018698">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem visās savās ierīcēs.</translation>
<translation id="4889865510625659193">Sāciet pārlūkošanu uzreiz: tagad pārlūks FlyWeb var tikt palaists, kad tiek palaista operētājsistēma Windows.</translation>
<translation id="7274695763216404502">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana no rīkjoslas.</translation>
<translation id="7288567540154601580">Cilnes un paplašinājumi</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{FlyWeb iesaka to noņemt.}zero{FlyWeb iesaka tos noņemt.}one{FlyWeb iesaka tos noņemt.}other{FlyWeb iesaka tos noņemt.}}</translation>
<translation id="5321339461210685340">Lai kopīgotu sistēmas audio, pārejiet uz sistēmas iestatījumiem un iespējojiet iestatījumu “Tikai sistēmas audio ierakstīšana” pārlūkam FlyWeb. Pēc tam jums būs jārestartē pārlūks FlyWeb.</translation>
<translation id="7299899569525778554">Meklēšana no darbvirsmas</translation>
<translation id="2866611433272355726">Notiek FlyWeb atjaunināšana</translation>
<translation id="5013690772358862887">Jūsu preferenču fails ir bojāts vai nederīgs. FlyWeb nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7324051657739063017">Varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="1123144153876435088">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits FlyWeb saturs.</translation>
<translation id="8915041713909379783">Jūsu šifrētos datus var lasīt tikai personas, kurām ir jūsu ieejas frāze. Ieejas frāze netiek sūtīta uzņēmumam FlyWeb, un uzņēmums FlyWeb to neuzglabā. Ja aizmirsīsiet ieejas frāzi vai vēlēsieties mainīt šo iestatījumu, jums būs <ph name="BEGIN_LINK"/>jāizdzēš FlyWeb dati savā kontā<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">Jūsu sistēmas administrators ir konfigurējis FlyWeb atvērt <ph name="ALTERNATIVE_BROWSER_NAME"/>, lai piekļūtu <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="7601756527349047847">Lai saņemtu turpmākus FlyWeb atjauninājumus, nepieciešama operētājsistēma macOS 13 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 12.</translation>
<translation id="3916387280110223245">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā FlyWeb tika noņemtas šādas atļaujas: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>.</translation>
<translation id="3313237823190188892">Rādīt Gemini pārlūkā FlyWeb sistēmas teknē</translation>
<translation id="7401687852903179959">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6624551989332401777">Tagad FlyWeb ir jūsu noklusējuma pārlūks.</translation>
<translation id="277733508197886564">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā FlyWeb tiek atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to izslēgtu, pārejiet uz lapu</translation>
<translation id="948152006162936800">Paroļu importēšana pārlūkā FlyWeb</translation>
<translation id="4755314372270379254">1. Noklikšķiniet uz tālāk redzamās pogas <ph name="BUTTON_LABEL"/>.
2. Windows iestatījumos noklikšķiniet uz <ph name="BUTTON_2"/>.
3. Windows paziņojumā noklikšķiniet uz <ph name="BUTTON_3"/>, lai piespraustu pārlūku FlyWeb uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> — FlyWeb izstrādātāju versija</translation>
<translation id="7450541714075000668">Teksts ir nokopēts</translation>
<translation id="7472280958921965834">Lai izmantotu mikrofonu, piešķiriet pārlūkam FlyWeb piekļuvi <ph name="BEGIN_LINK"/>sistēmas iestatījumos<ph name="END_LINK"/>.</translation>
<translation id="2431618580332826398">Lai saņemtu turpmākus FlyWeb atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="2154651873647244914">Vai atkārtoti palaist FlyWeb?</translation>
<translation id="3137757192868162370">Nevar instalēt to pašu FlyWeb versiju, kas jau šobrīd darbojas. Aizveriet FlyWeb un mēģiniet vēlreiz.</translation>
<translation id="3065486555702061722">Atgādinājums: vislabākais FlyWeb saturs vienmēr par rokai</translation>
<translation id="4027434552262956425">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus FlyWeb logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no FlyWeb konta, ja esat pierakstījies pārlūkā FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{Pārlūks FlyWeb pēc 1 minūtes tiks restartēts}zero{Pārlūks FlyWeb pēc # minūtēm tiks restartēts}one{Pārlūks FlyWeb pēc # minūtes tiks restartēts}other{Pārlūks FlyWeb pēc # minūtēm tiks restartēts}}</translation>
<translation id="301074550630080641">Lai aizsargātu savus datus, ļaujiet pārlūkā FlyWeb noņemt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis.</translation>
<translation id="3930051800510118744">Automātiski palaidiet pārlūku FlyWeb, lai uzreiz sāktu pārlūkošanu.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> instalēšanas programma</translation>
<translation id="3067364763515000789">Pārlūkā FlyWeb tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="1381291360713116383">Pārlūkā FlyWeb ir veikti uzlabojumi</translation>
<translation id="3892366519980032442">Tagad pārlūkā FlyWeb ir pieejams vairāk funkciju.</translation>
<translation id="7624307931717240213">Mēs izmantojam informāciju, lai uzlabotu šo pakalpojumu. Skatiet konfidencialitātes politiku un pakalpojumu sniegšanas noteikumus.</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="7733015548570443346">Iegūt lietotni FlyWeb</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="2230101319599356673">FlyWeb nav jūsu noklusējuma pārlūks.</translation>
<translation id="3243257760331619874">FlyWeb sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="3836891631266228927">FlyWeb atjauninājums</translation>
<translation id="7362833186911891234">Jūsu darbs ir aizsargāts pārlūkā FlyWeb</translation>
<translation id="7716950018788545737">Uzdevumi ir pabeigti.</translation>
<translation id="77283119132245232">Nodrošina sistēmas izsekošanas pakalpojumus pārlūkā <ph name="BROWSER_NAME"/>. Ja šis pakalpojums ir atspējots, pārlūka izveidotajos veiktspējas izsekošanas datos netiek ietverti sistēmas līmeņa notikumi, piemēram, konteksta maiņas un pavedienu gatavības notikumi.</translation>
<translation id="1549877678317463759">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā FlyWeb kā <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="104221467268393661">Atiestatīt FlyWeb noklusējuma motīvu</translation>
<translation id="2414061498125565915">Lai aizsargātu jūsu darbu pārlūkā FlyWeb, jūsu organizācija varēs skatīt vai pārvaldīt noteiktu informāciju, kad būsiet pierakstījies pārlūkā FlyWeb.</translation>
<translation id="494195283222791090">Iestatiet FlyWeb kā noklusējuma pārlūku un piespraudiet to uzdevumu joslai</translation>
<translation id="134973275687829726">Pārlūka FlyWeb darbības paātrināšana</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> — FlyWeb Canary</translation>
<translation id="2415098152024287665">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. FlyWeb izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7810005234485217901">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai varētu piekļūt.</translation>
<translation id="6059158364953614237">Izvēlieties, kādu saturu kopīgot ar FlyWeb</translation>
<translation id="8463540467315366872">Šajā ierīcē jau pastāv FlyWeb profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME"/> izmantošanas ir jārestartē dators.</translation>
<translation id="3682929584258119691">Jūsu meklētājprogramma tika mainīta ārpus pārlūka FlyWeb. Lai jūs aizsargātu, pārlūkā FlyWeb tā tika atiestatīta uz sākotnējo noklusējuma meklētājprogrammu. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">Pielāgojiet pārlūku FlyWeb, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="8611872055947278722">Nevarēja atjaunināt uz jaunāko FlyWeb versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS"/> sekunde(-es).</translation>
<translation id="3999247564452560622">Ja aizmirstat ieejas frāzi vai vēlaties mainīt šo iestatījumu, <ph name="BEGIN_LINK"/>izdzēsiet FlyWeb datus savā kontā<ph name="END_LINK"/>.</translation>
<translation id="3544550150141249305">Ātri atveriet pakalpojumu Gemini pārlūkā FlyWeb, kad tas ir nepieciešams.</translation>
<translation id="6798431672720500005">Iestatīt FlyWeb kā noklusējuma pārlūku</translation>
<translation id="332151924263389003">Pārlūkā FlyWeb nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="3096730275883527801">Operētājsistēmā FlyWeb iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS"/>. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="7097534420680357688">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="9017338699075596174">Šī ir FlyWeb papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="2888168499066553233">Izmantojiet pārlūku FlyWeb savā ierīcē (<ph name="DEVICE_TYPE"/>), lai pilnvērtīgi izmantotu FlyWeb piedāvātās iespējas</translation>
<translation id="8004582292198964060">Pārlūkprogramma</translation>
<translation id="8010081455002666927">Noteikt automātiski</translation>
<translation id="5944585442866020176">Tiklīdz pārlūkam FlyWeb tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="4462215250900528778">Piespraudiet pārlūku FlyWeb uzdevumu joslai, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME"/> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8054112667659782652">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="8069447462453318634">Atlasiet vienumu “Piespraust rīkjoslai”.</translation>
<translation id="3685797926747054412">Atspējot FlyWeb darbību fonā lietotnēm</translation>
<translation id="80790299200510644">Attēlu meklēšana</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> — FlyWeb for Testing</translation>
<translation id="3263664073045388929">Pārlūkam FlyWeb ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="5289593085778678155">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE"/>) atvērsiet pārlūku FlyWeb, tiks parādīts aicinājums iespējot brīdinājumus par cenu izsekošanu.</translation>
<translation id="7635444121786764725">Izmantojiet lietotni FlyWeb savā tālrunī, lai saņemtu brīdinājumus par cenu kritumu precēm, kas jūs interesē</translation>
<translation id="8118331347066725040">Sūtiet atsauksmes par meklēšanu, izmantojot Lens</translation>
<translation id="5770057404954060005">FlyWeb personalizēšana</translation>
<translation id="5334309298019785904">FlyWeb OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="6992240065504496864">Atveriet pakalpojumu Gemini pārlūkā FlyWeb, izmantojot īsinājumtaustiņu.</translation>
<translation id="6334554715655789744">FlyWeb pakalpojumu sniegšanas papildu noteikumi</translation>
<translation id="1597323875619800374">Šis fails ir bīstams, tāpēc FlyWeb to bloķēja.</translation>
<translation id="8177472873527554730">Nevar atrast saturu lapā</translation>
<translation id="2214224574148863941">Lai savā kontā (<ph name="USER_EMAIL"/>) izmantotu un saglabātu FlyWeb datus, ievadiet ieejas frāzi.</translation>
<translation id="820759916613250543">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8221491193165283816">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet šeit.</translation>
<translation id="2459467374982542273">Lai izmantotu kameru, piešķiriet pārlūkam FlyWeb piekļuvi <ph name="BEGIN_LINK"/>sistēmas iestatījumos<ph name="END_LINK"/>.</translation>
<translation id="4749458995158778066">FlyWeb nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka FlyWeb, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="6756872644564483342">Ja attēlam nav vērtīga apraksta, pārlūks FlyWeb mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam FlyWeb. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="9179486248398668702">Vai pierakstīties pārlūkā FlyWeb, izmantojot jaunu profilu?</translation>
<translation id="1470002120352085290">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā FlyWeb savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>. Varēsiet arī piekļūt parolēm un citiem datiem no <ph name="DEVICE"/>.</translation>
<translation id="8901123396574346662">Rādīt pakalpojumu Gemini pārlūkā FlyWeb sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="9102959605052547519">Pārlūkā <ph name="BEGIN_LINK"/>FlyWeb tiek rādīti brīdinājumi<ph name="END_LINK"/> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="669999719045196468">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā FlyWeb tika noņemta šāda atļauja: <ph name="PERMISSION"/>.</translation>
<translation id="7136168924180047124">Iepērcieties, tulkojiet un identificējiet redzamo saturu, izmantojot kameru iOS lietotnē FlyWeb.</translation>
<translation id="867002910715789721">Kvadrātkods, lai pierakstītos pārlūkā FlyWeb ar kontu <ph name="USER_NAME"/></translation>
<translation id="8313851650939857356">Palaišanas kļūda: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">Jūsu organizācija aizver pārlūku FlyWeb, ja tas <ph name="TIMEOUT_DURATION"/> netiek izmantots.</translation>
<translation id="8321888067342493336">Saglabāt kā attēlu</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> iepriekš izmantoja FlyWeb</translation>
<translation id="7009033378151348624">Iespējot prasmes pārlūkā FlyWeb</translation>
<translation id="338142060986183805">Lai turpinātu izmantot FlyWeb datus savā FlyWeb kontā (<ph name="ACCOUNT_EMAIL"/>), atjauniniet pārlūku FlyWeb.</translation>
<translation id="7408894216012529448">Lai saņemtu turpmākus FlyWeb atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8362914115861174987">Tulkot šādā valodā:</translation>
<translation id="8367705492654390392">Uzdodiet jebkādu jautājumu</translation>
<translation id="5020916672477085422">Pierakstieties pārlūkā FlyWeb, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu FlyWeb kontā pēc pierakstīšanās.</translation>
<translation id="5417365165109189454">Pēc tam jums būs jārestartē pārlūks FlyWeb.</translation>
<translation id="4212474799248200893">FlyWeb iesaka to noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.</translation>
<translation id="7256356679044945328">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka FlyWeb, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="3669395395617655404">Pārlūkā FlyWeb ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu FlyWeb kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="5261590792975521002">{0,plural, =1{Restartējiet pārlūku FlyWeb vienas dienas laikā}zero{Restartējiet pārlūku FlyWeb # dienu laikā}one{Restartējiet pārlūku FlyWeb # dienas laikā}other{Restartējiet pārlūku FlyWeb # dienu laikā}}</translation>
<translation id="8438543370129609977">Kad izmantojat funkciju Attēlu meklēšana, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">Uzzināt vairāk par meklēšanu, izmantojot attēlu meklēšanu pārlūkā FlyWeb</translation>
<translation id="3101564993057563365">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet FlyWeb vēlreiz.</translation>
<translation id="5316851838033144902">Pārlūka FlyWeb izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="6760691951531758781">Neobligāti: palīdziet uzlabot FlyWeb OS funkcijas un veiktspēju, automātiski nosūtot FlyWeb serveriem diagnostikas un lietojuma datus.</translation>
<translation id="2523037024749170569">Lai izmantotu un saglabātu FlyWeb datus savā FlyWeb kontā, apstipriniet savu identitāti.</translation>
<translation id="5989540778099253163">Tiek rādīti aicinājumi pierakstīties pārlūkā FlyWeb.</translation>
<translation id="6852836260419236265">FlyWeb versija ir novecojusi</translation>
<translation id="360892078644515524">Paldies, ka izvēlējāties FlyWeb kā noklusējuma pārlūku!</translation>
<translation id="797182360653885317">Pārlūkprogrammā FlyWeb var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8525579356836940628">Instalēšana apturēta</translation>
<translation id="8340284327429540526">Izmantojiet lietotni FlyWeb savā ierīcē (<ph name="DEVICE_TYPE"/>), lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="7498776423722712116">Saņemiet brīdinājumu, ja pārlūkā FlyWeb tiek konstatēts, ka kāda no jūsu parolēm ir iekļauta publiskā datu aizsardzības pārkāpumā.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">Dažām FlyWeb funkcijām un paplašinājumiem ir pieejamas saīsnes. Varat izvēlēties tos atkal ieslēgt.</translation>
<translation id="8556420416730706394">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai piekļūtu. Sānu paneļa augšdaļā noklikšķiniet uz pogas “Piespraust”.</translation>
<translation id="856656450041460113">Meklēt valodu sarakstā</translation>
<translation id="5128162742812353891">Pārlūku FlyWeb pārvalda vairākas organizācijas</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="7129578417724116642">Notiek FlyWeb palaišana...</translation>
<translation id="8624541899164515475">Iestatījumi; tiks atvērta jauna cilne.</translation>
<translation id="5469043671012993003">FlyWeb for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="3892251159131070138">Meklēšana pārlūkā FlyWeb no jebkuras vietas</translation>
<translation id="1514450422236300417">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku FlyWeb vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="573490495087487940">Šis ir jūsu FlyWeb</translation>
<translation id="8712637175834984815">Sapratu!</translation>
<translation id="2666961286257416158">Vai pierakstīties pārlūkā FlyWeb?</translation>
<translation id="8747073452963259673">meklēšanas apgabala apakšējais kreisais stūris: <ph name="LEFT"/>% pa kreisi, <ph name="BOTTOM"/>% apakšdaļā</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR"/>.</translation>
<translation id="8813277370772331957">Atgādināt vēlāk</translation>
<translation id="4243214377720481697">Kopīgojiet šo dokumentu ar Gemini pārlūkā FlyWeb, lai iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="6808406663598665473">Vai pierakstīties pārlūkā FlyWeb?</translation>
<translation id="7022252178852457880">Iestatīt FlyWeb kā noklusējuma pārlūku un piespraust to uzdevumu joslai</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="6933858244219479645">FlyWeb OS sistēma</translation>
<translation id="1501202286854500367">Šī valoda tiek izmantota, lai rādītu izvēlnes, iestatījumus, brīdinājumus un citu tekstu pārlūkā FlyWeb.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="2405293075272280413">Pievienot FlyWeb profilu</translation>
<translation id="2096285611267043007">ChromeOS nevarēja saglabāt FlyWeb datus jūsu FlyWeb kontā pierakstīšanās kļūdas dēļ.</translation>
<translation id="9046344742397901138">Saskaņā ar jūsu organizācijas politiku jums ir jāpierakstās pārlūkā FlyWeb.</translation>
<translation id="4669168852412989042">FlyWeb mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="2704405030486981087">FlyWeb vairs nav jūsu noklusējuma pārlūks. Vai iestatīt FlyWeb par noklusējuma pārlūku?</translation>
<translation id="1663379621921336006">Nevar atjaunināt FlyWeb</translation>
<translation id="8944232836376404813">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS"/>
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK"/>
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK"/>
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAKS"/>
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="188856534838382513">Rādīt vietņu saīsnes pārlūkā FlyWeb</translation>
<translation id="543915850302643692">FlyWeb Enterprise logotips</translation>
<translation id="4417647437359346154">Izmantojiet lietotni FlyWeb savā ierīcē (<ph name="DEVICE_TYPE"/>), lai piekļūstu FlyWeb drošības iespējām, atrodoties ceļā</translation>
<translation id="6976267397714240800">Nevar palaist pārlūku FlyWeb, jo radās problēma, atverot jūsu profilu. Mēģiniet restartēt pārlūku FlyWeb.</translation>
<translation id="8952346994182255880">meklēšanai pārlūkā FlyWeb vai pielāgošanai sadaļā <ph name="BEGIN_LINK"/>Iestatījumi<ph name="END_LINK"/>.</translation>
<translation id="8422308271795251425">Pārvaldīt FlyWeb profilus</translation>
<translation id="519942585686549229">Izmantojiet tastatūru, lai pārvietotos starp Gemini pārlūkā FlyWeb un atvērto cilni.</translation>
<translation id="9018218886431812662">Instalēšana pabeigta</translation>
<translation id="5804408305184682593">Pierakstieties pārlūkā FlyWeb</translation>
<translation id="7410599202980023102">Rādīt meklēšanu pārlūkā FlyWeb Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="2138383893834402906">Pārlūkā FlyWeb šī lejupielāde tika bloķēta, jo šajā arhīva failā ir ietverti citi faili, kas, iespējams, slēpj ļaunprātīgu programmatūru</translation>
<translation id="8884768769854521848">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz FlyWeb. Lai nodrošinātu ātru piekļuvi, pārlūks FlyWeb tiks piesprausts uzdevumu joslai.</translation>
<translation id="3668027737318668659">Izmantojiet lietotni FlyWeb savā tālrunī, lai piekļūtu FlyWeb labākajiem MI rīkiem</translation>
<translation id="1257818515846885633">Lai iegūtu paroles un citus datus no ierīces <ph name="DEVICE"/>, pierakstieties pārlūkā FlyWeb.</translation>
<translation id="7813768067688376455">Automātiska pierakstīšanās pārlūkā FlyWeb, kad pierakstāties citos FlyWeb pakalpojumos</translation>
<translation id="8323442969389928559">Pārlūks FlyWeb tika automātiski aizvērts</translation>
<translation id="7626272203917389133">FlyWeb versija ir novecojusi.</translation>
<translation id="1789655708880997767">{0,plural, =1{Pārlūks FlyWeb pēc stundas tiks restartēts}zero{Pārlūks FlyWeb pēc # stundām tiks restartēts}one{Pārlūks FlyWeb pēc # stundas tiks restartēts}other{Pārlūks FlyWeb pēc # stundām tiks restartēts}}</translation>
<translation id="9106236359747881194">Atlasiet tekstu, ko meklēt</translation>
<translation id="8970147445441095618">Lai saņemtu turpmākus FlyWeb atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.1.</translation>
<translation id="1208237657860748752">Atvērt saiti jaunā FlyWeb &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9134482777260927479">Palīdzība mājasdarbos</translation>
<translation id="9148058034647219655">Iziet</translation>
<translation id="1592415213971909403">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā FlyWeb var tikt atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to ieslēgtu, pārejiet uz lapu</translation>
<translation id="3926534790663909774">Sistēmas administrators ir konfigurējis FlyWeb, lai vietne <ph name="TARGET_URL_HOSTNAME"/> tiktu atvērta papildu pārlūkā.</translation>
<translation id="5022081608392609959">Atkārtoti palaist, lai atjauninātu &amp;FlyWeb</translation>
<translation id="8203782065881668160">FlyWeb (mDNS ienākošie savienojumi)</translation>
<translation id="5547805003442792166">Pielāgojiet pārlūku FlyWeb savām vajadzībām</translation>
<translation id="3410331617397516204">Iespējams, FlyWeb nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="3613308994653366133">Izmantojiet pārlūku FlyWeb, lai piekļūtu FlyWeb labākajām drošības funkcijām, atrodoties ceļā</translation>
<translation id="945522503751344254">Sūtīt atsauksmes</translation>
<translation id="1127626874097952395">Kas izmanto pārlūku FlyWeb?</translation>
<translation id="1626113414414104077">Visaugstākais FlyWeb drošības līmenis</translation>
<translation id="983803489796659991">Instalēšana neizdevās, jo atjauninājumu serverim nav nekādu jaukšanas datu lietojumprogrammai.</translation>
<translation id="839475718250652248">Izmantot FlyWeb, nepierakstoties kontā</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="7783156808075587495">Lai izmantotu atrašanās vietas datus, piešķiriet pārlūkam FlyWeb piekļuvi <ph name="BEGIN_LINK"/>sistēmas iestatījumos<ph name="END_LINK"/>.</translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">Instalēšana neizdevās nenoteiktas kļūdas dēļ. Lejupielādējiet pārlūku FlyWeb vēlreiz.</translation>
<translation id="2725795635123877647">Paplašinājumi, lietotnes un tēmas no nezināmiem avotiem var kaitēt jūsu ierīcei. FlyWeb iesaka instalēt tos tikai no <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="5840822070878669614">Atveriet interneta veikalu</translation>
<translation id="3470813199863172076">Šis paplašinājums pārkāpj interneta veikala politikas noteikumus un var būt nedrošs. Noņemiet to no FlyWeb, lai tas vairs neredzētu jūsu datus, tostarp jūsu personas datus, un nevarētu tos mainīt vietnēs, kuras apmeklējat.</translation>
<translation id="5382847955032513683">BRĪDINĀJUMS! FlyWeb nevar novērst, ka paplašinājumi reģistrē jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, atceliet tā atlasi.</translation>
<translation id="543905389684998697">Lai uzlabotu FlyWeb drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē ­<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="3914570680366033593">Lai uzlabotu FlyWeb drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="2742103213766991703">Atvērt saiti &amp;inkognito režīma logā</translation>
<translation id="5606966092070089147">Atvērt saiti pārlūkprogrammā „FlyWeb“ &amp;Privātajā logā</translation>
<translation id="1616978953472841483">Atvērt saiti &amp;inkognito režīma logā</translation>
<translation id="2050263926423290804">{COUNT,plural, 
=0{Pieejams FlyWeb atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}
=1{Pieejams FlyWeb atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}
other{Pieejams FlyWeb atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="8494512118209691256">Tas ļaus jums kopīgot saturu no FlyWeb uz jūsu lokālajām ierīcēm, piemēram, TV vai skaļruni.</translation>
<translation id="7488914907489544218">{COUNT,plural, 
=0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku FlyWeb.}
=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku FlyWeb. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}
other {Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku FlyWeb. Jūsu # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="7568541461974616693">{COUNT,plural,
 =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku FlyWeb.}
=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku FlyWeb. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}
other {Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku FlyWeb. Jūsu # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="6998204082704836463">{COUNT, plural,
              =0 {Lai piemērotu atjauninājumu, ir atkārtoti jāpalaiž FlyWeb}
              =1 {Lai piemērotu atjauninājumu, ir atkārtoti jāpalaiž FlyWeb. Jūsu privātais logs netiks atvērts no jauna.}
              other {Lai piemērotu atjauninājumu, uzlabotajai aizsardzībai ir atkārtoti jāpalaiž FlyWeb. Jūsu # Privātie logi netiks atvērti no jauna.}}</translation>
<translation id="5749154344207139683">Palīdziet mums uzlabot privāto režīmu, aizpildot šo aptauju (1 min.).</translation>
<translation id="4766381896251401675">Kad rakstāt adreses joslā vai meklēšanas lodziņā, to, ko rakstāt, FlyWeb nosūta uz jūsu noklusējuma meklētājprogrammu, lai iegūtu labākus ieteikumus. Inkognito režīmā šī opcija ir izslēgta.</translation>
<translation id="2832552148674305108">FlyWeb inkognito</translation>
<translation id="611606920944085547">Pārlūkojot privātajā režīmā, FlyWeb brīdinās jūs pirms vietnes ielādes, izmantojot nedrošu savienojumu</translation>
</translationbundle>