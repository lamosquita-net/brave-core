<translation id="2533324957407080119">‏FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> کی کوشش کر رہا ہے</translation>
<translation id="6758901350197493482">‏‫<ph name="EXISTING_USER"/> پہلے سے ہی سائن ان ہے۔ اپنی براؤزنگ کو الگ رکھنے کے لیے، اپنی پروفائل میں FlyWeb میں بطور <ph name="USER_EMAIL_ADDRESS"/> سائن ان کریں۔ آپ کو <ph name="DEVICE"/> سے اپنی ایکسٹینشنز اور مزید چیزیں بھی مل جائیں گی۔</translation>
<translation id="3547283483106013256">‏اگلی بار جب آپ اپنے <ph name="DEVICE_TYPE"/> پر FlyWeb کھولیں گے تو آپ کو FlyWeb پاس ورڈ مینیجر استعمال کرنے کے لیے ایک پرامپٹ نظر آئے گا۔</translation>
<translation id="1838374766361614909">تلاش صاف کریں</translation>
<translation id="3403116471618205223">‏براؤزنگ ڈیٹا کو اپنے FlyWeb اکاؤنٹ میں برقرار رکھتے ہوئے، صرف اس آلہ سے اسے حذف کرنے کیلئے، <ph name="BEGIN_LINK"/>FlyWeb سے سائن آؤٹ کریں<ph name="END_LINK"/>۔</translation>
<translation id="1909454687815628855">‏چلتے پھرتے نئے ٹیب گروپس کھولنے یا تخلیق کرنے کے لیے اپنے فون پر FlyWeb ڈاؤن لوڈ کریں۔</translation>
<translation id="3285741355512747610">‏آپ اپنے سائن ان کردہ FlyWeb اکاؤنٹس کا نظم کر سکتے ہیں۔ آپ کے FlyWeb اکاؤنٹس FlyWeb براؤزر، Play اسٹور، Gmail اور مزید کے لیے استعمال ہوتے ہیں۔ اگر آپ کسی اور کے لیے کوئی اکاؤنٹ شامل کرنا چاہتے ہیں جیسے آپ کی فیملی کا کوئی ممبر تو اس کی بجائے اپنے <ph name="DEVICE_TYPE"/> میں ایک نیا شخص شامل کریں۔ <ph name="LINK_BEGIN"/>مزید جانیں<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">تصاویر کا استعمال کر کے تلاش کے ساتھ تلاش کریں</translation>
<translation id="5054936737639982722">‏‫<ph name="EXISTING_USER"/> پہلے سے ہی سائن ان ہے۔ اپنی براؤزنگ کو الگ رکھنے کے لیے، اپنی پروفائل میں FlyWeb میں بطور <ph name="USER_EMAIL_ADDRESS"/> سائن ان کریں۔ آپ کو <ph name="DEVICE"/> سے اپنے بُک مارکس اور مزید چیزیں بھی مل جائیں گی۔</translation>
<translation id="1880677175115548835">متن منتخب کریں</translation>
<translation id="4824940465467423308">‏آپ ایک منظم اکاؤنٹ کے ساتھ سائن ان کر رہے ہیں اور اپنے FlyWeb پروفائل پر اس کا انتظامی کنٹرول دے رہے ہیں۔ آپ کا FlyWeb ڈیٹا جیسے آپ کی ایپس، بُک مارکس، سرگزشت، پاس ورڈز اور دیگر ترتیبات <ph name="USER_NAME"/> سے مستقل طور پر جڑ جائیں گی۔ آپ اس ڈیٹا کو FlyWeb اکاؤنٹس ڈیش بورڈ کے ذریعے حذف کر سکیں گے لیکن آپ اس ڈیٹا کو دوسرے اکاؤنٹ کے ساتھ وابستہ نہیں کر سکیں گے۔ آپ اپنا موجودہ FlyWeb ڈیٹا الگ رکھنے کیلئے اختیاری طور پر ایک نیا پروفائل بنا سکتے ہیں۔ <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">‏‫FlyWeb ہموار اسکرولنگ اور ویڈیو فریم ریٹس جیسی پس منظر کی سرگرمی اور ویژوئل ایفیکٹس کو محدود کر کے بیٹری پاور کی بچت کرتا ہے۔ <ph name="BEGIN_LINK"/>اپنے انرجی سیور کے بارے میں مزید جانیں<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">‏‫FlyWeb اپ ڈیٹر سروس</translation>
<translation id="7390382558747224642">‏اسے آف کر کے، آپ FlyWeb میں سائن ان کیے بغیر Gmail جیسی FlyWeb سائٹس میں سائن ان کر سکتے ہیں</translation>
