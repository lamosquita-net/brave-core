<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="pl">
<translation id="130631256467250065">Zmiany zostaną zastosowane przy następnym uruchomieniu urządzenia.</translation>
<translation id="125853961893919199">Wskazówka od FlyWeb: zapisuj hasła</translation>
<translation id="1589233279653618219">Otwórz menu FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> i upewnij się, że w konfiguracji wybrano połączenie bez serwera proxy lub bezpośrednie.</translation>
<translation id="8359495463485001719">Zgłaszanie awarii nie jest dostępne w FlyWeb.</translation>
<translation id="6338530717474923868">Przeglądasz bezpieczną stronę FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb próbuje zmienić ustawienia wypełniania form płatności.</translation>
<translation id="5702992568540613683">Logo FlyWeb</translation>
<translation id="8966580353365544289">Wskazówka od FlyWeb: Ulepszone bezpieczne przeglądanie</translation>
<translation id="510342522494506803">FlyWeb próbuje edytować formy płatności.</translation>
<translation id="8375862260948854624">Stworzenie FlyWeb było możliwe dzięki projektowi open source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> i innym <ph name="BEGIN_LINK_OSS"/>programom o otwartym kodzie źródłowym<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Ta strona została zablokowana przez FlyWeb</translation>
<translation id="1953000035868532675">Zezwalaj FlyWeb na korzystanie z sieci w ustawieniach zapory sieciowej
        lub oprogramowania antywirusowego.</translation>
<translation id="4949828774841497663">Otwórz kolejno Aplikacje &gt; Ustawienia systemu &gt; Sieć, wybierz aktywną sieć, kliknij przycisk Szczegóły… i usuń zaznaczenie wszystkich zaznaczonych serwerów proxy.</translation>
<translation id="7584668345330431749">Otwórz menu FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Sieć i internet &gt; Serwer proxy i odznacz „Automatycznie wykrywaj ustawienia”.</translation>
<translation id="3145451630329266064">Te strony są przeznaczone dla programistów FlyWeb i mogą nie być aktywnie utrzymywane ani testowane. Aby je włączyć, otwórz <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, kliknij przycisk włączania debugowania stron, a potem ponownie otwórz tę stronę.</translation>
<translation id="2681118099728446983">Stworzenie przeglądarki FlyWeb było też możliwe dzięki innemu <ph name="BEGIN_LINK_OSS"/>oprogramowaniu open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Zmiany zostaną zastosowane po ponownym uruchomieniu FlyWeb.</translation>
<translation id="8524328905288851065">Aby kontynuować parowanie, FlyWeb potrzebuje dostępu do Bluetootha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">Stworzenie przeglądarki FlyWeb było możliwe dzięki projektowi open source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Wybierz
        menu FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        i odznacz „<ph name="NO_PREFETCH_DESCRIPTION"/>”.
        Jeśli nie rozwiąże to problemu, zalecamy ponowne wybranie tej opcji,
        by poprawić wydajność.</translation>
<translation id="4699594416850504200">Oglądasz bezpieczną stronę FlyWeb for Testing.</translation>
<translation id="6224789938625024797">FlyWeb nie został poprawnie zamknięty.</translation>
<translation id="3593104813552438879">Wskazówka dotycząca FlyWeb: wyszukuj za pomocą Obiektywu</translation>
</translationbundle>