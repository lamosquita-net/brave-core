<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="130631256467250065">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh pajisjen.</translation>
<translation id="1555506416658437797">të modifikojë mënyrat e pagesës.</translation>
<translation id="8359495463485001719">Raportimi i ndërprerjes aksidentale nuk ofrohet në FlyWeb.</translation>
<translation id="6338530717474923868">Po shikon një faqe të sigurt të FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb po përpiqet të modifikojë cilësimet për plotësimin e mënyrave të pagesave.</translation>
<translation id="5702992568540613683">Logoja e FlyWeb</translation>
<translation id="510342522494506803">FlyWeb po përpiqet të modifikojë mënyrat e pagesës.</translation>
<translation id="8375862260948854624">FlyWeb është bërë i mundur nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> dhe <ph name="BEGIN_LINK_OSS"/>softuerë të tjerë me burim të hapur<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Shko te
          menyja e FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Cilësimet e rrjetit LAN
          dhe anulo zgjedhjen e kutisë së kontrollit "Përdor një server përfaqësues për rrjetin LAN".</translation>
<translation id="5040124620086808431">Kjo faqe është bllokuar nga FlyWeb</translation>
<translation id="1953000035868532675">Lejo FlyWeb të qaset në rrjet, në cilësimet e murit mbrojtës ose
      të antivirusit.</translation>
<translation id="3442058224540562441">Shko te
          menyja e FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          dhe sigurohu që konfigurimi yt të jetë i caktuar në "pa përfaqësues" ose "direkt".</translation>
<translation id="585620188971323280">modifiko cilësimet për plotësimin e mënyrave të pagesave.</translation>
<translation id="2681118099728446983">FlyWeb është mundësuar po ashtu nga <ph name="BEGIN_LINK_OSS"/>softuerë të tjerë me burim të hapur<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh FlyWeb.</translation>
<translation id="1017070759373671177">FlyWeb është mundësuar nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Shko te
          menyja e FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          dhe anulo zgjedhjen e "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Nëse kjo nuk e zgjidh këtë problem, rekomandojmë ta zgjedhësh përsëri këtë opsion
          për një veprimtari më të mirë funksionimi.</translation>
<translation id="8187289872471304532">Shko te Aplikacionet &gt; Preferencat e sistemit &gt; Rrjeti &gt; Të përparuara &gt; Përfaqësuesit dhe anulo zgjedhjen për çdo përfaqësues që është zgjedhur.</translation>
<translation id="4699594416850504200">Po shikon një faqe të sigurt të FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb nuk u mbyll si duhet.</translation>
</translationbundle>