+
+  // Only allow a single transfer.
+  was_transferred_ = true;
+  is_transferable_ = false;
+
+  // Bypass OnStateChange() to avoid emitting an event.
+  state_ = webrtc::DataChannelInterface::kClosed;
+  feature_handle_for_scheduler_.reset();
+
+  return channel();
