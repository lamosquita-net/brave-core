# Brave counterpart to Chromium's `allow_circular_includes_from_untriaged`
# (as in Brave 1.98). Chromium 156 only lets targets in
# allow_circular_includes_from_allowlist (.gn) use allow_circular_includes_from.
allow_circular_includes_from_brave = [
  # FlyWeb: brave_chrome_browser_sources live in //chrome/browser:core (via
  # patches/chrome-browser-BUILD.gn.patch), which depends on
  # //brave/browser/ui; //brave/browser/ui includes their headers back.
  "//chrome/browser:core",
]
