<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="be">
<translation id="130631256467250065">Змены ўступяць у сілу пасля наступнага перазапуску прылады.</translation>
<translation id="1555506416658437797">змяніць спосабы аплаты.</translation>
<translation id="8359495463485001719">Справаздачы аб збоях у браўзеры FlyWeb недаступныя.</translation>
<translation id="6338530717474923868">Вы праглядаеце бяспечную старонку FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb спрабуе замяніць налады запаўнення спосабаў аплаты.</translation>
<translation id="5702992568540613683">Лагатып FlyWeb</translation>
<translation id="510342522494506803">FlyWeb спрабуе змяніць спосабы аплаты.</translation>
<translation id="8375862260948854624">FlyWeb працуе дзякуючы праекту <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> з адкрытым зыходным кодам і іншаму <ph name="BEGIN_LINK_OSS"/>праграмнаму забеспячэнню з адкрытым зыходным кодам<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Перайдзіце ў
          меню FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Налады LAN
          і зніміце птушку ў полі "Выкарыстоўваць проксі-сервер для LAN".</translation>
<translation id="5040124620086808431">Старонка заблакіравана браўзерам FlyWeb</translation>
<translation id="1953000035868532675">Дазвольце FlyWeb доступ да сеткі ў наладах брандмаўэра або
         антывіруса.</translation>
<translation id="3442058224540562441">Перайдзіце ў
          меню FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          і ўпэўніцеся, што ў канфігурацыі зададзены значэнні "no proxy" або "direct".</translation>
<translation id="585620188971323280">змяніць налады запаўнення спосабаў аплаты.</translation>
<translation id="2681118099728446983">FlyWeb працуе ў тым ліку дзякуючы іншаму <ph name="BEGIN_LINK_OSS"/>праграмнаму забеспячэнню з адкрытым зыходным кодам<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Змены ўступяць у сілу пасля перазапуску FlyWeb.</translation>
<translation id="1017070759373671177">FlyWeb працуе дзякуючы праекту <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> з адкрытым зыходным кодам.</translation>
<translation id="7777112741998051633">Перайдзіце ў
          меню FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          і адмяніце выбар параметра "<ph name="NO_PREFETCH_DESCRIPTION"/>".
          Калі гэта не вырашыць праблему, рэкамендуем выбраць гэты
          параметр зноў, каб не пагоршылася прадукцыйнасць.</translation>
<translation id="8187289872471304532">Перайдзіце ў
          Applications &gt; System Preferences &gt; Network &gt; Advanced &gt; Proxies
          і адмяніце выбар усіх выбраных проксі-сервераў.</translation>
<translation id="4699594416850504200">Вы гледзіце абароненую старонку FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb завяршыў працу некарэктна.</translation>
</translationbundle>