<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="130631256467250065">ለውጦችዎ መሣሪያዎን ዳግም በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="1555506416658437797">የመክፈያ ዘዴዎችን ያርትዑ።</translation>
<translation id="8359495463485001719">የብልሽት ሪፖርት በBrave ውስጥ አይገኝም።</translation>
<translation id="6338530717474923868">ደህንነቱ የተጠበቀ የBrave ገፅ እየተመለከቱ ነው</translation>
<translation id="5147169001159408844">FlyWeb የመክፈያ ዘዴዎችን ለመሙላት ቅንብሮችን ለማሻሻል እየሞከረ ነው።</translation>
<translation id="5702992568540613683">የBrave ዓርማ</translation>
<translation id="510342522494506803">FlyWeb የመክፈያ ዘዴዎችን ለማርትዕ እየሞከረ ነው።</translation>
<translation id="8375862260948854624">FlyWeb በ<ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>  ክፍት ምንጭ ፕሮጀክት እና በሌላ <ph name="BEGIN_LINK_OSS"/>ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_OSS"/> እውን ሊሆን ችሏል።</translation>
<translation id="4281953335231207224">ወደ
          የBrave ምናሌ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          የላን ቅንብሮች
          ይሂዱና የ«ለእርስዎ ላን ተኪ አገልጋይ ይጠቀሙ»ን አመልካች ሳጥኑን አይምረጡ።</translation>
<translation id="5040124620086808431">ይህ ገፅ በBrave ታግዷል</translation>
<translation id="1953000035868532675">FlyWeb በኬላ ወይም የጸረ-ቫይረስ ቅንብሮችዎን አውታረ መረቡን እንዲደርስበት
        ይፍቀዱለት።</translation>
<translation id="3442058224540562441">ወደ
          የBrave ምናሌ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ይሂዱና ውቅርዎ ወደ «ምንም ተኪ» ወይም «ቀጥታ» መዋቀሩን ያረጋግጡ።</translation>
<translation id="585620188971323280">የመክፈያ ዘዴዎችን ለመሙላት ቅንብሮችን ያሻሽሉ።</translation>
<translation id="2681118099728446983">እንዲሁም FlyWeb በሌላ <ph name="BEGIN_LINK_OSS"/>ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_OSS"/> እንዲሆን ተደርጓል።</translation>
<translation id="6888846095017247017">ለውጦችዎ FlyWeb በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="1017070759373671177">FlyWeb በ<ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ክፍት ምንጭ ፕሮጀክት እንዲሆን ተደርጓል።</translation>
<translation id="7777112741998051633">ወደ
        የBrave ምናሌ &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ይሂዱና «<ph name="NO_PREFETCH_DESCRIPTION"/>»ን አይምረጡ።
        ይሄ ችግሩን ካልፈታው ለተሻሻለ አፈጻጸም ይህን አማራጭ እንደገና መምረጥ እንመክራለን።</translation>
<translation id="8187289872471304532">ወደ
          መተግበሪያዎች &gt; የስርዓት ምርጫዎች &gt; አውታረ መረብ &gt; የላቁ &gt; ተኪዎች
          ይሂዱና የተመረጡ ማናቸውም ተኪዎችን አይምረጡ።</translation>
<translation id="4699594416850504200">ደህንነቱ የተጠበቀ የBrave ለሙከራ ገፅ እየተመለከቱ ነው</translation>
<translation id="6224789938625024797">FlyWeb በትክክል አልተዘጋም።</translation>
</translationbundle>