<!DOCTYPE translationbundle>
<translationbundle lang="bs">
<translation id="1026101648481255140">Nastavi instalaciju</translation>
<translation id="7099479769133613710">Ponovo pokrenite da ažurirate &amp;ChromeOS</translation>
<translation id="291426170030461697">FlyWeb vam preporučuje da pregledate ovu ekstenziju</translation>
<translation id="1549005488226693697">Kada web lokacija zatraži privatno predučitavanje linkova na stranici, FlyWeb koristi Braveove servere. Time se vaš identitet sakriva od predučitane web lokacije, ali FlyWeb uči koje web lokacije se predučitavaju.</translation>
<translation id="1065672644894730302">Nije moguće sačuvati vaše postavke.

Neke funkcije možda neće biti dostupne i promjene postavki se neće sačuvati.</translation>
<translation id="8908267645832965492">Tvoj roditelj je isključio "Odobrenja za web lokacije, aplikacije i ekstenzije" za FlyWeb</translation>
<translation id="5557633153169217776">Braveu treba pristup vašoj lokalnoj mreži da otkrije i koristi uređaje u blizini</translation>
<translation id="6441390163669415879">Da pretražite određenu funkciju ili ekstenziju Bravea, unesite prečicu te funkcije ili ekstenzije na traci za adresu, a zatim pritisnite odabranu tipku na tastaturi</translation>
<translation id="9001750423919983557">Prikaži pretraživanje putem Bravea na sistemskoj traci i uključi prečicu na tastaturi</translation>
<translation id="1368460307421081773">FlyWeb želi izvesti vaše lozinke. Unesite svoju lozinku za Windows da to dozvolite.</translation>
<translation id="112640046208448578">Identificirajte stvari ili mjesta i kopirajte ili prevedite tekst. Kada upotrijebite pretraživanje pomoću slika, snimak ekrana stranice će se poslati na server. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb je vaš zadani preglednik</translation>
<translation id="4556715463645168547">Da provjerite jesu li vaše lozinke zaštićene od narušavanja podataka i drugih sigurnosnih problema, <ph name="BEGIN_LINK"/>prijavite se u FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Kliknite na meni Bravea</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="1184145431117212167">Instalacija nije uspjela jer vaša verzija Windowsa nije podržana.</translation>
<translation id="4380351562011537903">O programu FlyWeb</translation>
<translation id="853148447909557566">Dobijajte obavještenja o praćenju cijena putem Bravea na telefonu</translation>
<translation id="1203500561924088507">Hvala što ste instalirali. Morate ponovo pokrenuti preglednik prije nego što možete koristiti <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Kada otvorite pretraživanje pomoću slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski će se poslati na server. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Dok ste prijavljeni, lozinke i drugo s FlyWeb računa možete koristiti u Braveu. Da promijenite ovo, idite na "Vaš račun u Braveu".</translation>
<translation id="7614508617663739435">Prikaži Gemini u Braveu na traci menija Maca</translation>
<translation id="832555967476614730">Da odaberete dio ekrana u Geminiju u Braveu, koristite prečicu na tastaturi.</translation>
<translation id="4750836834956739196">Dok je ova kartica bila neaktivna, memorija je oslobođena kako bi FlyWeb ostao brz. Možete odabrati da uvijek izuzmete ovu web lokaciju iz neaktivnosti.</translation>
<translation id="3190759351483708314">FlyWeb je blokirao ovo preuzimanje jer je fajl opasan</translation>
<translation id="5879469261638423015">Prilikom prijave na Braveove usluge kao što su Gmail ili YouTube koristeći <ph name="USER_EMAIL"/> možete se automatski prijaviti u FlyWeb putem istog računa</translation>
<translation id="7142135954326264349">Nabavite FlyWeb na telefonu</translation>
<translation id="1290883685122687410">Greška prilikom postavljanja: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Postavite novi FlyWeb profil</translation>
<translation id="5252737639504553444">Isprobajte putem Geminija u Braveu</translation>
<translation id="609743863669742325">Braveu je potreban pristup Bluetoothu da istraži 
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Prijavite se u FlyWeb na telefonu</translation>
<translation id="1330562121671411446">Otkrij jezik</translation>
<translation id="2276527911011636666">Također izbriši podatke iz Bravea (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Zakačeno! Mogućnost ponovnog pristupa pretraživanju pomoću slika putem novog dugmeta na alatnoj traci</translation>
<translation id="1383876407941801731">Traži</translation>
<translation id="1045149878186896649">Koristite aplikaciju FlyWeb da nastavite pregledati u pokretu</translation>
<translation id="141901961143729572">Podijelite svoje misli</translation>
<translation id="2758515779140515865">Da podijelite prozor, dozvolite snimanje ekrana za FlyWeb u Postavkama sistema.</translation>
<translation id="4713192356155907986">Potražite pomoć za FlyWeb for Testing</translation>
<translation id="4984443629206419460">Da dobijate sačuvane informacije i druge stavke s uređaja <ph name="DEVICE"/>, prijavite se u FlyWeb</translation>
<translation id="1497802159252041924">Greška prilikom instaliranja: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Stranica je zaštićena</translation>
<translation id="8962360511570172">Dijelite FlyWeb karticu</translation>
<translation id="2941487459666781243">Prijavite se u FlyWeb</translation>
<translation id="1547469039832541117">Završava istaknuti zadatak.</translation>
<translation id="3182893868355533457">Zakači FlyWeb</translation>
<translation id="852852907317361085">Braveovi sigurnosni alati</translation>
<translation id="481155564361715417">FlyWeb želi izbrisati vaše podatke iz Upravitelja lozinki. Unesite svoju lozinku za Windows da to dozvolite.</translation>
<translation id="2846999307505917298">Iskoristite sve prednosti Bravea putem aplikacije FlyWeb na telefonu</translation>
<translation id="3961251277542681013">Pregledajte ključne kontrole privatnosti i sigurnosti na Braveu</translation>
<translation id="1640672724030957280">Preuzimanje…</translation>
<translation id="1665602916345474427">Prijavljeni ste kao <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>. Članstvo. Otvaranje menija računa</translation>
<translation id="7625232007557474355">Možete koristiti FlyWeb svaki put kada kliknete na linkove u porukama, dokumentima i drugim aplikacijama. Također će se zakačiti na traku zadataka.</translation>
<translation id="1709772298389099340">Pruža dodatne ovlasti za preglednik <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">FlyWeb će uskoro izbrisati podatke o pregledanju</translation>
<translation id="8939535770474283898">FlyWeb će pokušati nadograditi kretanja na HTTPS</translation>
<translation id="2581127533455294937">FlyWeb podaci su obrisani</translation>
<translation id="7385422968404728039">FlyWeb će se ponovo pokrenuti za <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Kada HTTPS nije dostupan, FlyWeb će koristiti nesigurnu vezu bez upozorenja</translation>
<translation id="307170399141486420">FlyWeb može raditi u pozadini</translation>
<translation id="5006568136491721884">Kliknite na <ph name="BEGIN_BOLD"/>Da<ph name="END_BOLD"/> u obavještenju Windowsa da zakačite FlyWeb na traku zadataka radi brzog pristupa.</translation>
<translation id="2473319786107120819">Ponovo instaliraj FlyWeb</translation>
<translation id="2533324957407080119">FlyWeb pokušava <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> je već prijavljen(a). Da vaše pregledanje ostane odvojeno, prijavite se u FlyWeb na vlastitom profilu kao <ph name="USER_EMAIL_ADDRESS"/>. Također ćete dobiti ekstenzije i druge stavke koje sadržava <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Sljedeći put kada otvorite FlyWeb na uređaju <ph name="DEVICE_TYPE"/>, vidjet ćete upit da koristite FlyWeb upravitelj lozinki.</translation>
<translation id="1838374766361614909">Obriši pretraživanje</translation>
<translation id="3403116471618205223">Da izbrišete podatke pregledanja samo s ovog uređaja, a da ih zadržite na FlyWeb računu, <ph name="BEGIN_LINK"/>odjavite se iz Bravea<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Preuzmite FlyWeb na telefon da otvarate ili kreirate nove grupe kartica u pokretu.</translation>
<translation id="3285741355512747610">Možete upravljati FlyWeb računima na koje ste prijavljeni. Vaši FlyWeb računi se koriste za preglednik FlyWeb, Play trgovinu, Gmail i drugo. Ako želite dodati račun za nekog drugog, kao što je član porodice, umjesto računa dodajte novu osobu na svoj uređaj <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Saznajte više<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Pretražite pomoću slika</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> je već prijavljen(a). Da vaše pregledanje ostane odvojeno, prijavite se u FlyWeb na vlastitom profilu kao <ph name="USER_EMAIL_ADDRESS"/>. Također ćete dobiti svoje oznake i druge stavke sa <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Odaberite tekst</translation>
<translation id="4824940465467423308">Prijavljujete se s upravljanim računom i dajete njegovom administratoru kontrolu nad svojim FlyWeb profilom. Vaši podaci iz Bravea kao što su vaše aplikacije, oznake, historija, lozinke i druge postavke će biti trajno vezani za korisnika <ph name="USER_NAME"/>. Moći ćete izbrisati ove podatke na kontrolnoj tabli FlyWeb računa, ali nećete moći povezati ove podatke s drugim računom. Opcionalno možete kreirati novi profil da odvojite postojeće podatke iz Bravea. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb štedi energiju baterije ograničavanjem pozadinske aktivnosti i vizuelnih efekata, poput glatkog klizanja i broja slika u sekundi videozapisa. <ph name="BEGIN_LINK"/>Saznajte više o Uštedi energije<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Usluga za ažuriranje Bravea</translation>
<translation id="7390382558747224642">Isključivanjem ove postavke, možete se prijaviti na Braveove web lokacije poput Gmaila bez prijave na FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb ne reagira. Ponovo pokrenuti sada?</translation>
<translation id="5866699689358760578">Organizacija <ph name="MANAGER"/> zahtijeva da se prijavite u FlyWeb</translation>
<translation id="4035053306113201399">ChromeOS treba ponovo pokrenuti da se primijeni ažuriranje.</translation>
<translation id="3750729306035486751">FlyWeb je blokirao ovo preuzimanje jer se ta vrsta fajla ne preuzima često i fajl je možda opasan</translation>
<translation id="1953553007165777902">Preuzimanje… Preostalo je <ph name="MINUTE"/> min</translation>
<translation id="6956650624767954726">FlyWeb ne može odrediti ili postaviti zadani preglednik</translation>
<translation id="197326043290947695">Pregledajte pametnije uz pretraživanje pomoću slika</translation>
<translation id="130679046523922050">Informacije o tome zašto FlyWeb blokira neke fajlove; otvara se na novoj kartici</translation>
<translation id="8243822903505210769">Održava softver Bravea ažurnim. Ako se ova usluga onemogući ili zaustavi, softver Bravea se neće moći održavati ažurnim, što će značiti da se sigurnosne ranjivosti koje mogu nastati neće moći riješiti i da funkcije možda neće funkcionirati. Ova usluga se sama deinstalira kada ne postoji softver Bravea koji je koristi.</translation>
<translation id="6495079989036864983">Ovim će se izbrisati jedna stavka s uređaja. Za preuzimanje podataka kasnije, prijavite se u FlyWeb kao <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalacija nije uspjela. Pokušajte ponovo.</translation>
<translation id="2039417478970545937">Postavke.</translation>
<translation id="8544477465831682343">Odaberite želite li uključiti historiju Bravea da dodatno personalizirate iskustva na Braveovim uslugama</translation>
<translation id="328650761750741315">Ugrađen je u Braveu da vam pomogne da kreirate, pohranjujete i automatski popunjavate jake lozinke. Dodajte prečicu za lak pristup.</translation>
<translation id="2407746489237278840">Kliknite na dugme Prilagodite FlyWeb na stranici Nova kartica da Braveu dodijelite novi izgled</translation>
<translation id="8924891216494775926">FlyWeb je blokirao ovo preuzimanje jer je fajl obmanjujući i može izvršiti neočekivane izmjene na uređaju</translation>
<translation id="5728214838078602184">Vidjet ćete upit da isprobate funkciju <ph name="FEATURE_NAME"/> sljedeći put kada otvorite FlyWeb iOS.</translation>
<translation id="2058207584484841616">Lozinke i drugi podaci Bravea koji su sačuvani na FlyWeb računu će se ukloniti s uređaja. Da ih ponovo koristite u Braveu, prijavite se ponovo.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Organizacija automatski briše podatke o pregledanju kada se FlyWeb ne koristi 1 minutu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Organizacija automatski briše podatke o pregledanju kada se FlyWeb ne koristi # minutu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Organizacija automatski briše podatke o pregledanju kada se FlyWeb ne koristi # minute. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Organizacija automatski briše podatke o pregledanju kada se FlyWeb ne koristi # minuta. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2125838419757773031">Odaberite dio ekrana da pretražite</translation>
<translation id="2126108037660393668">Potvrda preuzetog fajla nije uspjela.</translation>
<translation id="2135919691573380097">Prijavite ovu web lokaciju</translation>
<translation id="2137162749895930932">Zatvaranje ekrana prevoda</translation>
<translation id="2147218225094845757">Sakrivanje bočne ploče</translation>
<translation id="4474394796469499134">FlyWeb je blokirao ovo preuzimanje jer web lokacija ne koristi sigurnu vezu i fajl je možda neovlašteno izmijenjen</translation>
<translation id="2170098639895543546">Odaberite bilo šta na stranici</translation>
<translation id="6765231735885996239">Prilagodite FlyWeb</translation>
<translation id="2174917724755363426">Instalacija nije završena. Jeste li sigurni da želite otkazati?</translation>
<translation id="2937508664417729967">FlyWeb – prijava na mrežu – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Greška provjere ažuriranja: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Ukloni račun iz Bravea</translation>
<translation id="744837314710861405">Koristite aplikaciju FlyWeb da imate najbolje alate za kupovinu u pokretu</translation>
<translation id="2745381939758295588">Budite sigurniji u pokretu uz poboljšano Sigurno pregledanje u Braveu za iOS</translation>
<translation id="6707114110652917144">Opasna web lokacija. FlyWeb je uklonio obavještenja.</translation>
<translation id="2236949375853147973">Moja aktivnost</translation>
<translation id="4646732243247482236">Da dobijate adrese i druge stavke na svim svojim uređajima, prijavite se u FlyWeb. Ova adresa će se sačuvati na FlyWeb račun nakon što se prijavite.</translation>
<translation id="2726680594710751908">Ako dijelite računar, prijatelji i porodica mogu odvojeno pretraživati i postaviti FlyWeb na način koji njima odgovara.</translation>
<translation id="4086571337340463916">Vještine u Braveu</translation>
<translation id="2283803047247799269">Pretraži ovu karticu putem pretraživanja pomoću slika</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb preporučuje da pauzirate karticu koja usporava preglednik}one{FlyWeb preporučuje da pauzirate kartice koje usporavaju preglednik}few{FlyWeb preporučuje da pauzirate kartice koje usporavaju preglednik}other{FlyWeb preporučuje da pauzirate kartice koje usporavaju preglednik}}</translation>
<translation id="2307973900865360088">Zadrži na donjoj traci</translation>
<translation id="5067150284614317159">Provjerava URL-ove s listom nesigurnih web lokacija pohranjenih u Braveu. Ako web lokacija pokuša ukrasti vašu lozinku ili kada preuzimate štetan fajl, FlyWeb može slati i URL-ove, uključujući dijelove sadržaja stranice, u Sigurno pregledanje.</translation>
<translation id="2356070529366658676">Pitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="7339360994527471629">Ekstenzija "<ph name="EXTENSION_NAME"/>" želi da se prijavite u FlyWeb</translation>
<translation id="8788732221355188962">Onemogući pokretanje Bravea u pozadini za aplikacije</translation>
<translation id="4126251160852694747">Da koristite ekstenziju kao <ph name="USER_EMAIL_ADDRESS"/>, prijavite se u FlyWeb.</translation>
<translation id="8418845734693287262">ChromeOS nije mogao sinhronizirati vaše podatke je su detalji za prijavu na vaš račun zastarjeli.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{1 uređaju s korisničkim interfejsom je pristupala jedna ili više ekstenzija za FlyWeb}=1{1 uređaju s korisničkim interfejsom pristupa jedna ili više ekstenzija za FlyWeb}one{# uređaju s korisničkim interfejsom pristupa jedna ili više ekstenzija za FlyWeb}few{# uređajima s korisničkim interfejsom pristupa jedna ili više ekstenzija za FlyWeb}other{# uređaja s korisničkim interfejsom pristupa jedna ili više ekstenzija za FlyWeb}}</translation>
<translation id="1364879203203742966">Braveu su za ovu web lokaciju potrebna odobrenja za kameru i mikrofon</translation>
<translation id="2403703063067034158">Došlo je do greške prilikom postavljanja. Trenutno se izvršava druga instanca postavljanja, Pokušajte ponovo kasnije.</translation>
<translation id="656987653252575654">Otvarajte linkove u Braveu iz bilo koje aplikacije i držite preglednik dostupnim na traci zadataka</translation>
<translation id="157662717324308283">Kliknite na dugme Sažmi da podijelite ovaj dokument s Geminijem u Braveu da dobijete brzi pregled i postavljate dodatna pitanja</translation>
<translation id="1968013196034892522">Pomoću <ph name="BEGIN_LINK"/>Braveovih alata<ph name="END_LINK"/> možete pregledati sigurno i zadržati kontrolu</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> je već prijavljen(a). Da vaše pregledanje ostane odvojeno, prijavite se u FlyWeb na vlastitom profilu kao <ph name="USER_EMAIL_ADDRESS"/>. Također ćete dobiti svoje lozinke i druge stavke na svim svojim uređajima.</translation>
<translation id="2451727308784734061">Koristite prečicu da brzo pristupite Upravitelju lozinki. Možete premjestiti prečicu na početni ekran računara ili u pokretač aplikacija.</translation>
<translation id="3224379053610845181">FlyWeb će se uskoro zatvoriti</translation>
<translation id="3840682988105604367">U Braveu</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je ponovno pokretanje: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Odaberite tekst putem pretraživanja pomoću slika</translation>
<translation id="6823116595279840454">FlyWeb pokušava zamijeniti postojeće lozinke. Upišite lozinku za Windows da ovo dozvolite.</translation>
<translation id="2691552788029831386">FlyWeb treba pristup pohrani zbog preuzimanja fajlova</translation>
<translation id="2275866327478859777">FlyWeb pomagač</translation>
<translation id="2575822587468774919">Odaberite bilo šta da pretražite pomoću slika</translation>
<translation id="683641781063074351">Da dobijate lozinke i drugo na svim svojim uređajima, prijavite se u FlyWeb</translation>
<translation id="1659167470250249643">Skenirajte QR kôd telefonom da preuzmete FlyWeb i prijavite se na FlyWeb račun.</translation>
<translation id="5353172248151202719">da pretražujete putem Bravea.</translation>
<translation id="3231856291920394348">Nastavi koristiti FlyWeb</translation>
<translation id="259935314519650377">Keširanje preuzetog programa za instaliranje nije uspjelo. Greška: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="7683745685556117660">Vaša organizacija može vidjeti podatke o pregledanju kao što su oznake, historija i lozinke te upravljati njima. Ne može vidjeti podatke o pregledanju na drugim FlyWeb profilima</translation>
<translation id="5862783156828836752">Potvrdite identitet da koristite i sačuvate podatke Bravea na računu <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="4450675160413947126">Pokreni FlyWeb</translation>
<translation id="3827993926722004004">Tokom instaliranja se pojavila greška operativnog sistema. Ponovo preuzmite FlyWeb.</translation>
<translation id="333184635927514678">Ako dijelite uređaj, prijatelji i porodica mogu odvojeno pregledati i postavljati FlyWeb na način koji njima odgovara</translation>
<translation id="3917488635054382918">Lak pristup za korištenje Geminija u Braveu na uređaju, čak i ako je FlyWeb minimiziran.</translation>
<translation id="1257705702166647105">Kartica Bravea</translation>
<translation id="2796283369875688710">FlyWeb će šifrirati vaše podatke radi dodatne sigurnosti.</translation>
