<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="1026101648481255140">Endelea na Usakinishaji</translation>
<translation id="7099479769133613710">Fungua tena ili usasishe Mfumo wa Uendeshaji wa FlyWeb</translation>
<translation id="291426170030461697">FlyWeb inapendekeza ukague kiendelezi hiki</translation>
<translation id="1549005488226693697">FlyWeb hutumia seva za FlyWeb, tovuti inapoomba viungo vipakiwe mapema kwenye ukurasa wake kwa njia ya faragha. Hali hii huficha utambulisho wako usionekane kwenye tovuti inayopakiwa mapema lakini FlyWeb hufahamu tovuti zinazopakiwa mapema.</translation>
<translation id="1065672644894730302">Mapendeleo yako hayawezi kusomwa.

Baadhi ya vipengele huenda visipatikane na mabadiliko katika mapendeleo hayatahifadhiwa.</translation>
<translation id="8908267645832965492">Mzazi wako amezima "Ruhusa za tovuti, programu na viendelezi" kwenye FlyWeb</translation>
<translation id="5557633153169217776">FlyWeb inahitaji uwezo wa kufikia mtandao wako wa karibu ili kugundua na kutumia vifaa vilivyo karibu</translation>
<translation id="6441390163669415879">Ili utafute kipengele au kiendelezi mahususi cha FlyWeb, andika njia yake ya mkato katika sehemu ya anwani, ikifuatiwa na kitufe cha kibodi ulichochagua</translation>
<translation id="9001750423919983557">Onyesha huduma ya kutafuta ukitumia FlyWeb katika ubao wa aikoni kisha uwashe mikato ya kibodi</translation>
<translation id="1368460307421081773">FlyWeb ingependa kuhamisha manenosiri yako. Andika nenosiri lako la Windows ili uruhusu shughuli hii.</translation>
<translation id="112640046208448578">Tambua vitu au maeneo kisha unakili au utafsiri maandishi. Unapotumia kipengele cha Kutafuta kwa Picha, picha ya skrini ya ukurasa hutumwa kwenye seva. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb ni kivinjari chako chaguomsingi</translation>
<translation id="4556715463645168547">Ili uangalie kama manenosiri yako ni salama dhidi ya ufichuzi haramu wa data na matatizo mengine ya usalama, <ph name="BEGIN_LINK"/>ingia katika akaunti kwenye FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Bofya menyu ya FlyWeb</translation>
<translation id="1157985233335035034">Lugha ulizotumia hivi majuzi</translation>
<translation id="1184145431117212167">Imeshindwa kuweka kwenye kifaa kwa sababu toleo la Windows ulilonalo halitumiki.</translation>
<translation id="4380351562011537903">Kuhusu FlyWeb</translation>
<translation id="853148447909557566">Pata arifa za ufuatiliaji wa bei ukitumia FlyWeb kwenye simu yako</translation>
<translation id="1203500561924088507">Asante kwa kusakinisha. Ni lazima uzime kisha uwashe tena kivinjari chako kabla ya kutumia <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Ukifungua kipengele cha Kutafuta kwa Picha, jina la ukurasa, URL na maudhui, ikiwa ni pamoja na PDF, yatatumwa kiotomatiki kwenye seva. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Wakati umeingia katika akaunti, unaweza kutumia manenosiri yako na mengineyo kwenye Akaunti yako ya FlyWeb katika FlyWeb. Ili ubadilishe mipangilio hii, nenda kwenye “Akaunti yako katika FlyWeb”.</translation>
<translation id="7614508617663739435">Onyesha Gemini kwenye FlyWeb katika upau wa menyu wa Mac</translation>
<translation id="832555967476614730">Tumia mikato ya kibodi kuchagua sehemu ya skrini katika Gemini kwenye FlyWeb.</translation>
<translation id="4750836834956739196">Kichupo hiki kilipokuwa hakitumiki, nafasi ya hifadhi ilirejeshwa ili FlyWeb iwe na kasi ya utendaji. Unaweza kuchagua tovuti hii iendelee kutumika kila wakati.</translation>
<translation id="3190759351483708314">FlyWeb imezuia upakuaji huu kwa sababu faili si salama</translation>
<translation id="5879469261638423015">Unapoingia katika akaunti za huduma za FlyWeb kama Gmail au YouTube ukitumia <ph name="USER_EMAIL"/>, unaweza kuingia katika akaunti kiotomatiki kwenye FlyWeb ukitumia akaunti ile ile</translation>
<translation id="7142135954326264349">Pakua FlyWeb kwenye simu yako</translation>
<translation id="1290883685122687410">Hitilafu ya kuweka mipangilio: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Weka mipangilio ya wasifu wako mpya wa FlyWeb</translation>
<translation id="5252737639504553444">Jaribu ukitumia Gemini kwenye FlyWeb</translation>
<translation id="609743863669742325">FlyWeb inahitaji ruhusa ya kufikia Bluetooth ili kugundua 
 vifaa vyenye Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Ingia katika FlyWeb kwenye simu yako</translation>
<translation id="1330562121671411446">Tambua lugha</translation>
<translation id="2276527911011636666">Futa pia data kutoka FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Kimebandikwa! Unaweza kufikia tena kipengele cha Kutafuta kwa Picha katika kitufe kipya kilicho kwenye upau wa vidhibiti</translation>
<translation id="1383876407941801731">Tafuta</translation>
<translation id="1045149878186896649">Tumia programu ya FlyWeb ili uendelee kuvinjari popote ulipo</translation>
<translation id="141901961143729572">Eleza mawazo yako</translation>
<translation id="2758515779140515865">Ili uonyeshe dirisha lako, washa kinasa skrini katika FlyWeb kwenye Mipangilio ya Mfumo.</translation>
<translation id="4713192356155907986">Pata usaidizi kuhusu FlyWeb ya Majaribio</translation>
<translation id="4984443629206419460">Ili upate taarifa ulizohifadhi na mengineyo kutoka <ph name="DEVICE"/>, ingia katika FlyWeb</translation>
<translation id="1497802159252041924">Hitilafu ya kusakinisha: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Ukurasa huu umelindwa</translation>
<translation id="8962360511570172">Shiriki kichupo cha FlyWeb</translation>
<translation id="2941487459666781243">Ingia katika FlyWeb</translation>
<translation id="1547469039832541117">Hukamilisha jukumu lililoangaziwa.</translation>
<translation id="3182893868355533457">Bandika FlyWeb</translation>
<translation id="852852907317361085">Zana usalama za FlyWeb</translation>
<translation id="481155564361715417">FlyWeb ingependa kufuta data yako ya Kidhibiti cha Manenosiri. Weka nenosiri lako la Windows ili uruhusu hatua hii.</translation>
<translation id="2846999307505917298">Nufaika zaidi na FlyWeb ukitumia programu ya FlyWeb kwenye simu yako</translation>
<translation id="3961251277542681013">Kagua vidhibiti muhimu vya faragha na usalama katika FlyWeb</translation>
<translation id="1640672724030957280">Inapakua...</translation>
<translation id="1665602916345474427">Umeingia ukitumia akaunti ya <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, uanachama. Fungua menyu ya akaunti</translation>
<translation id="7625232007557474355">Unaweza kutumia FlyWeb wakati wowote unapobofya viungo kwenye ujumbe, hati na programu nyingine. Pia itabandikwa kwenye upauzana wako.</translation>
<translation id="1709772298389099340">Huwezesha ufikiaji maalum wa <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">FlyWeb itafuta data ya kuvinjari hivi karibuni</translation>
<translation id="8939535770474283898">FlyWeb itajaribu kuboresha usogezaji ili utumie HTTPS</translation>
<translation id="2581127533455294937">Imefuta data ya FlyWeb</translation>
<translation id="7385422968404728039">FlyWeb itazima kisha iwake baada ya <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Wakati kiendelezi cha HTTPS hakipatikani, FlyWeb itatumia muunganisho usio salama bila kukutahadharisha</translation>
<translation id="307170399141486420">Acha FlyWeb iendeshe katika mandharinyuma</translation>
<translation id="5006568136491721884">Bofya <ph name="BEGIN_BOLD"/>Ndiyo<ph name="END_BOLD"/> kwenye arifa ya Windows ili ubandike FlyWeb kwenye upauzana wako ili uifikie kwa haraka.</translation>
<translation id="2473319786107120819">Sakinisha FlyWeb Upya</translation>
<translation id="2533324957407080119">FlyWeb inajaribu <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER"/>. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti kwenye FlyWeb katika wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS"/>. Pia utapata viendelezi vyako na zaidi kwenye <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Utakapofungua FlyWeb tena kwenye <ph name="DEVICE_TYPE"/> yako, utaona kidokezo cha kutumia Kidhibiti cha Manenosiri cha FlyWeb.</translation>
<translation id="1838374766361614909">Futa utafutaji</translation>
<translation id="3403116471618205223">Ili ufute data ya kuvinjari kwenye kifaa hiki pekee, bila kuifuta katika Akaunti yako ya FlyWeb, <ph name="BEGIN_LINK"/>ondoka kwenye akaunti ya FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Pakua FlyWeb kwenye simu yako ili ufungue au uanzishe vikundi vipya vya vichupo popote ulipo.</translation>
<translation id="3285741355512747610">Unaweza kudhibiti Akaunti zako za FlyWeb ulizotumia kuingia katika tovuti na programu. Akaunti zako za FlyWeb hutumiwa kwenye kivinjari cha FlyWeb, Duka la Google Play, Gmail na kwingineko. Iwapo ungependa kuweka akaunti ya mtu mwingine, kama vile mwanafamilia, ongeza mtu mpya kwenye <ph name="DEVICE_TYPE"/> yako badala yake. <ph name="LINK_BEGIN"/>Pata maelezo zaidi<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Tafuta ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="5054936737639982722">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER"/>. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya FlyWeb kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS"/>. Pia utapata alamisho zako na zaidi kwenye <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Chagua maandishi</translation>
<translation id="4824940465467423308">Unaingia katika akaunti ukitumia akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye FlyWeb. Data yako ya FlyWeb, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio nyingine itahusishwa na<ph name="USER_NAME"/> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za FlyWeb, lakini hutaweza  kuunganisha data hii na akaunti nyingine. Unaweza kwa hiari kuunda wasifu mpya ili kuweka data yako ya FlyWeb iliyo kando. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb huhifadhi chaji ya betri kwa kudhibiti shughuli za chinichini na madoido ya picha, kama vile usogezaji rahisi na kasi za picha za video. <ph name="BEGIN_LINK"/>Pata maelezo zaidi kuhusu Kiokoa Nishati<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Huduma ya Kisasishaji cha FlyWeb</translation>
<translation id="7390382558747224642">Kwa kuzima kipengele hiki, unaweza kuingia katika tovuti za FlyWeb kama vile Gmail bila kuingia katika akaunti ya FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb haiamiliki. Zindua upya sasa?</translation>
<translation id="5866699689358760578">Shirika lako, <ph name="MANAGER"/> linataka uingie katika akaunti ya FlyWeb</translation>
<translation id="4035053306113201399">Mfumo wa Uendeshaji wa FlyWeb unahitaji kuzimwa na kuwashwa ili utekeleze usasishaji.</translation>
<translation id="3750729306035486751">FlyWeb imezuia upakuaji huu kwa sababu aina hii ya faili kwa kawaida haipakuliwi na huenda si salama</translation>
<translation id="1953553007165777902">Inapakua... Zimesalia dakika <ph name="MINUTE"/></translation>
<translation id="6956650624767954726">FlyWeb haijafaulu kubainisha wala kuweka kivinjari chaguomsingi</translation>
<translation id="197326043290947695">Vinjari kwa umahiri ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="130679046523922050">Fahamu kwa nini FlyWeb huzuia baadhi ya faili, huzifungua kwenye kichupo kipya</translation>
<translation id="8243822903505210769">Husasisha programu yako ya FlyWeb. Huduma hii ikizimwa au kusimamishwa, programu yako ya FlyWeb haitasasishwa, hali inayomaanisha kuwa hatari za usalama zinazoweza kutokea haziwezi kurekebishwa na huenda vipengele visifanye kazi. Huduma hii hujiondoa kwenye kifaa ikiwa hakuna programu ya FlyWeb inayoitumia.</translation>
<translation id="6495079989036864983">Hatua hii itafuta kipengee 1 kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika FlyWeb ukitumia <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Imeshindwa kusakinisha. Tafadhali jaribu tena.</translation>
<translation id="2039417478970545937">Mipangilio.</translation>
<translation id="8544477465831682343">Chagua iwapo ungependa kujumuisha historia kwenye FlyWeb ili upate hali ya utumiaji inayokufaa zaidi katika huduma za FlyWeb</translation>
<translation id="328650761750741315">Kimejumuishwa kwenye FlyWeb ili kukusaidia kubuni, kuhifadhi na kujaza kiotomatiki manenosiri thabiti. Weka njia ya mkato ili ufikie kwa urahisi.</translation>
<translation id="2407746489237278840">Bofya kitufe cha Weka FlyWeb upendavyo kwenye Ukurasa Mpya wa Kichupo ili uipe FlyWeb mwonekano mpya</translation>
<translation id="8924891216494775926">FlyWeb imezuia upakuaji huu kwa sababu faili inapotosha na huenda ikafanya mabadiliko yasiyotarajiwa kwenye kifaa chako</translation>
<translation id="5728214838078602184">Utaona kidokezo cha kujaribu <ph name="FEATURE_NAME"/> utakapofungua FlyWeb kwenye kifaa cha iOS tena.</translation>
<translation id="2058207584484841616">Manenosiri na data yako nyingine ya FlyWeb uliyohifadhi kwenye Akaunti yako ya FlyWeb itaondolewa kwenye kifaa hiki. Ili uzitumie tena kwenye FlyWeb, ingia tena katika akaunti.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Shirika lako hufuta kiotomatiki data ya kuvinjari FlyWeb isipotumika kwa dakika 1. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}other{Shirika lako hufuta kiotomatiki data ya kuvinjari FlyWeb isipotumika kwa dakika #. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}}</translation>
<translation id="2125838419757773031">Chagua sehemu ya skrini ili utafute</translation>
<translation id="2126108037660393668">Faili iliyopakuliwa imeshindwa kuthibitishwa.</translation>
<translation id="2135919691573380097">Ripoti tovuti hii</translation>
<translation id="2137162749895930932">Funga skrini ya kutafsiri</translation>
<translation id="2147218225094845757">Ficha kidirisha cha pembeni</translation>
<translation id="4474394796469499134">FlyWeb imezuia upakuaji huu kwa sababu tovuti haitumii muunganisho salama na huenda faili imeharibiwa</translation>
<translation id="2170098639895543546">Chagua chochote kwenye ukurasa</translation>
<translation id="6765231735885996239">Weka mipangilio ya FlyWeb upendavyo</translation>
<translation id="2174917724755363426">Usakinishaji haujakamilika. Je, una uhakika unataka kughairi?</translation>
<translation id="2937508664417729967">FlyWeb - Kuingia katika Akaunti ya Mtandao - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Hitilafu ya ukaguzi wa sasisho: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Ondoa akaunti kwenye FlyWeb</translation>
<translation id="744837314710861405">Tumia programu ya FlyWeb ili upate zana bora za ununuzi popote ulipo</translation>
<translation id="2745381939758295588">Imarisha usalama wako popote ulipo kwa kutumia Kipengele cha Kuvinjari Salama Kilichoboreshwa katika FlyWeb kwenye iOS</translation>
<translation id="6707114110652917144">Tovuti hatari. FlyWeb imeondoa arifa.</translation>
<translation id="2236949375853147973">Shughuli Zangu</translation>
<translation id="4646732243247482236">Ingia kwenye FlyWeb ili upate anwani zako na vipengee vingine katika vifaa vyako vyote. Anwani hii itahifadhiwa kwenye Akaunti yako ya FlyWeb ukishaingia katika akaunti.</translation>
<translation id="2726680594710751908">Kama unatumia kompyuta pamoja na wengine, marafiki na familia wanaweza kuvinjari tofauti na kusanidi FlyWeb jinsi wapendavyo.</translation>
<translation id="4086571337340463916">Ujuzi kwenye FlyWeb</translation>
<translation id="2283803047247799269">Tafuta kichupo hiki ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb inapendekeza usitishe kichupo kinachopunguza kasi ya kivinjari chako}other{FlyWeb inapendekeza usitishe vichupo vinavyopunguza kasi ya kivinjari chako}}</translation>
<translation id="2307973900865360088">Weka katika sehemu ya Kupachika</translation>
<translation id="5067150284614317159">Hukagua URL ili kuona iwapo zipo kwenye orodha ya tovuti zisizo salama zilizohifadhiwa katika FlyWeb. Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, FlyWeb inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwa kipengele cha Kuvinjari Salama.</translation>
<translation id="2356070529366658676">Uliza</translation>
<translation id="2359808026110333948">Endelea</translation>
<translation id="7339360994527471629">Kiendelezi cha "<ph name="EXTENSION_NAME"/>" kinakuhitaji uingie katika FlyWeb</translation>
<translation id="8788732221355188962">Zima FlyWeb Inayotumika Chinichini kwenye Programu</translation>
<translation id="4126251160852694747">Ili utumie kiendelezi hiki ukitumia <ph name="USER_EMAIL_ADDRESS"/>, ingia katika FlyWeb.</translation>
<translation id="8418845734693287262">Mfumo wa Uendeshaji wa FlyWeb haukusawazisha data yako kwa sababu maelezo ya kuingia katika akaunti yako yamepitwa na wakati.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha FlyWeb kilikuwa kinafikia kifaa 1 cha HID}=1{Kiendelezi kimoja au zaidi cha FlyWeb kinafikia kifaa 1 cha HID}other{Kiendelezi kimoja au zaidi cha FlyWeb kinafikia vifaa # vya HID}}</translation>
<translation id="1364879203203742966">FlyWeb inahitaji ruhusa ya kufikia kamera na maikrofoni kwa ajili ya tovuti hii</translation>
<translation id="2403703063067034158">Hitilafu ya kuwasha: tukio jingine la uwekaji mipangilio linaendelea kwa sasa, tafadhali jaribu tena baadaye.</translation>
<translation id="656987653252575654">Fungua viungo katika FlyWeb kwenye programu yoyote na ufanye kivinjari kiweze kufikiwa kwenye upauzana wako</translation>
<translation id="157662717324308283">Ruhusu Gemini kwenye FlyWeb ifikie hati hii kwa kubofya kitufe cha Andaa muhtasari ili upate muhtasari wa haraka na uulize maswali ya nyongeza</translation>
<translation id="1968013196034892522">Kwa kutumia <ph name="BEGIN_LINK"/>zana kutoka FlyWeb<ph name="END_LINK"/>, unaweza kuvinjari kwa usalama na kuwa na udhibiti</translation>
<translation id="1716762085628757512">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER"/>. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya FlyWeb kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS"/>. Pia utapata manenosiri yako na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="2451727308784734061">Tumia njia yako ya mkato ili ufikie Kidhibiti cha Manenosiri kwa haraka. Unaweza kuhamishia njia yako ya mkato kwenye skrini ya kwanza ya kompyuta yako au kifungua programu.</translation>
<translation id="3224379053610845181">FlyWeb itafungwa hivi karibuni</translation>
<translation id="3840682988105604367">Katika FlyWeb</translation>
<translation id="2485422356828889247">Ondoa</translation>
<translation id="2513154137948333830">Unahitaji kuwashwa tena: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Chagua maandishi ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="6823116595279840454">FlyWeb inajaribu kubadilisha manenosiri yaliyopo. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="2691552788029831386">FlyWeb inahitaji ruhusa ya kufikia hifadhi ili ipakue faili</translation>
<translation id="2275866327478859777">Kisaidizi cha FlyWeb</translation>
<translation id="2575822587468774919">Chagua hoja yoyote ya kutafuta ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="683641781063074351">Ili upate manenosiri yako na zaidi kwenye vifaa vyako vyote, ingia katika akaunti kwenye FlyWeb</translation>
<translation id="1659167470250249643">Changanua msimbo wa QR ukitumia simu yako ili upakue FlyWeb kisha uingie katika Akaunti yako ya FlyWeb.</translation>
<translation id="5353172248151202719">ili utafute ukitumia FlyWeb.</translation>
<translation id="3231856291920394348">Endelea kutumia FlyWeb</translation>
<translation id="259935314519650377">Imeshindwa kuweka akiba ya kisakinishaji kilichopakuliwa. Hitilafu: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Mfumo</translation>
<translation id="7683745685556117660">Shirika lako linaweza kuona na kudhibiti data ya kuvinjari, kama vile alamisho, historia na manenosiri yako. Haliwezi kuona data ya kuvinjari katika wasifu mwingine kwenye FlyWeb</translation>
<translation id="5862783156828836752">Thibitisha kuwa ni wewe ili utumie na uhifadhi data ya FlyWeb katika akaunti yako, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="4450675160413947126">Anzisha FlyWeb</translation>
<translation id="3827993926722004004">Hitilafu ya mfumo wa uendeshaji imetokea wakati wa usakinishaji. Tafadhali pakua FlyWeb tena.</translation>
<translation id="333184635927514678">Kama unatumia kifaa pamoja na wengine, marafiki na familia wanaweza kuvinjari kivyao na kuweka mipangilio ya FlyWeb wapendavyo</translation>
