<translation id="1474676525193357364">तपाइँले FlyWeb सुरु गर्दा कुन पृष्ठ देखाउँछ भनेर पनि यसले नियन्त्रण गर्छ।</translation>
<translation id="648319183876919572">परिष्कृत Safe Browsing सुविधाले तपाईंलाई खतरनाक वेबसाइट तथा डाउनलोडबाट थप सुरक्षित राख्छ</translation>
<translation id="5777905264835557372">FlyWeb को स्थापना हटाउनुहोस्</translation>
<translation id="764623543427374554">सर्टकट FlyWeb मा खुल्छ</translation>
<translation id="3616832517943695570">तपाईं साइन इन अवस्थामा भएका बेला आफ्नो FlyWeb खातामा सेभ गरिएका पासवर्ड तथा अन्य कुराहरू FlyWeb मा प्रयोग गर्न सक्नुहुन्छ। तपाईं जुनसुकै बेला सेटिङमा गई यसलाई परिवर्तन गर्न सक्नुहुन्छ।</translation>
<translation id="8852057261917278552">तपाईंको सङ्गठनले तोकेको नियमअनुसार तपाईंले <ph name="TIMEOUT_DURATION"/> सम्म FlyWeb प्रयोग गर्नुभएन भने त्यो स्वतः बन्द हुन्छ। ब्राउजिङ डेटा मेटाइयो। यसअन्तर्गत हिस्ट्री, अटोफिल तथा डाउनलोड समावेश हुन सक्छन्।</translation>
<translation id="8592211619057897362">हरेक प्रोफाइलका आफ्नै बुकमार्क, इतिहास, पासवर्डलगायत FlyWeb का सबै जानकारी हुन्छन्</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb ले तपाईंको डेटा कसरी गोप्य राख्छ<ph name="END_LINK"/> भन्ने बारेमा थप जान्नुहोस्</translation>
<translation id="7489092380688543560">तपाईं FlyWeb को अर्कै प्रोफाइलमा सेभ गरिएका पासवर्डहरू हेर्न चाहनुहुन्छ भने प्रोफाइल बदल्न सक्नुहुन्छ</translation>
<translation id="8243012192239086369">FlyWeb ले तपाईंले पाठ क्षेत्रहरूमा टाइप गर्ने पाठ हिज्जेसम्बन्धी त्रुटि सच्याउने प्रयोजनका लागि FlyWeb मा पठाउँछ</translation>
<translation id="3927263773110604886">FlyWeb को सूचनासम्बन्धी सेटिङहरूमा जानुहोस्</translation>
<translation id="6888846095017247017">तपाईंले अर्को पटक FlyWeb लाई पुन: लन्च गर्दा तपाईंका परिवर्तनहरू प्रभावमा आउनेछन्।</translation>
<translation id="1886169834787876002">तपाईं वरपरको ठाउँको 3D नक्सा बनाउन FlyWeb लाई क्यामेरा प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
<translation id="7640394575797555654">साइटहरूले सम्भवतः तपाईंले अपेक्षा गरेअनुसार काम गर्ने छन् तर तपाईंले FlyWeb का सबै विन्डोहरू बन्द गरेपछि ती साइटहरूले तपाईंको जानकारी याद राख्ने छैनन्</translation>
<translation id="7570986009744020649">तपाईं आफ्ना बुकमार्कहरू FlyWeb खातामा पनि सेभ गर्नुहुन्छ भने तपाईं FlyWeb मा उत्पादनका मूल्यहरू ट्र्याक गर्न र मूल्य घट्दा सूचना प्राप्त गर्न सक्नुहुन्छ</translation>
<translation id="6676384891291319759">इन्टरनेट एक्सेस गर्नुहोस्</translation>
<translation id="1363996462118479832">साइन इन गर्ने क्रममा त्रुटि भएकाले ChromeOS ले तपाईंको डेटा सिंक गर्न सकेन।</translation>
<translation id="4748642594935526275">FlyWeb ले तपाईंले हेर्ने विज्ञापनहरूमा अझ बढी नियन्त्रण गर्छ र तपाईंलाई पर्सनलाइज गरिएका विज्ञापनहरू देखाउँदा ती साइटहरूले तपाईंका बारेमा जान्न सक्ने जानकारीको सीमा तोक्छ</translation>
<translation id="4152880912192471857">यो साइट चलाउन FlyWeb लाई माइक्रोफोन प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
<translation id="6712881677154121168">डाउनलोड गर्ने क्रममा त्रुटि भयो: <ph name="DOWNLOAD_ERROR"/>।</translation>
<translation id="2193001403607253406">तपाईंको प्रोफाइललाई प्रयोग गर्न सकिँदैन किनभने यो FlyWeb एउटा नयाँ संस्करणबाट ल्याइएको हो।

केही सुविधाहरू अनुपलब्ध हुन सक्छन्। कृपया एउटा भिन्न प्रोफाइल डाइरेक्टरी निर्दिष्ट गर्नुहोस् वा FlyWeb को कुनै अझ नया सँस्करण प्रयोग गर्नुहोस्।</translation>
<translation id="5528558621229392814">पर्सनलाइजेसन र अन्य सुविधाहरू प्राप्त गर्न FlyWeb लाई वेब तथा एपसम्बन्धी गतिविधि र FlyWeb का लिंक गरिएका सेवाहरूमा समावेश गर्नुहोस्</translation>
<translation id="7728046102681268859">तपाईँको कम्प्युटरमा पहिले नै सबै प्रयोगकर्ताहरूका लागि FlyWeb को स्थापना गरिएको छ।</translation>
<translation id="7030752319019635064">आफूले प्रयोग गर्ने जुनसुकै यन्त्रबाट FlyWeb मा रहेका आफ्ना डेटा हेर्न तथा प्रयोग गर्न सिंक गर्ने सुविधा अन गर्नुहोस्।</translation>
<translation id="199909180078651278">तपाईंले हालसालै कुनै पनि साइट खोल्नुभएको छैन। FlyWeb ले <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> र थप <ph name="COUNT"/> वटा अनुमति रद्द गरेको छ</translation>
<translation id="1292831930742306370">यो फाइल जोखिमपूर्ण हुन सक्ने भएकाले FlyWeb ले यो फाइल स्क्यान गर्न सिफारिस गर्छ।</translation>
<translation id="1547295885616600893">ChromeOS अतिरिक्त <ph name="BEGIN_LINK_CROS_OSS"/>खुला स्रोत सफ्टवेयर<ph name="END_LINK_CROS_OSS"/> प्रयोग गरी निर्माण गरिएको हो।</translation>
<translation id="6432682256389755533">तपाईंको पासवर्ड ह्याक भएको खण्डमा FlyWeb ले तपाईंलाई त्यसको जानकारी दिन्छ</translation>
<translation id="684888714667046800">इन्टरनेटमा कनेक्ट गर्न सकिएन। तपाईंले कुनै फायरवाल प्रयोग गरेका खण्डमा कृपया श्वेतसूचीमा <ph name="PRODUCT_EXE_NAME"/> समावेश गरिएको छ भन्ने कुरा सुनिश्चित गर्नुहोस्।</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="4695676871328690599">FlyWeb ले "<ph name="EXTENSION_NAME"/>" मा मालवेयर भएको कुरा पत्ता लगाएको छ</translation>
<translation id="5929819793040985066">ट्रायल अन भएका बेला तपाईंले खोल्ने साइटहरूले विज्ञापनको पर्फर्मेन्स मापन गर्ने सुविधाका सहायताले FlyWeb सँग साइटलाई त्यसका विज्ञापनहरूको पर्फर्मेन्स मापन गर्न सघाउने जानकारी माग्न सक्छन्। विज्ञापनको पर्फर्मेन्स मापन गर्ने सुविधाले विभिन्न साइटहरूका बिचमा सकेसम्म कम जानकारी ट्रान्स्फर गरेर ती साइटमा गरिने गतिविधि ट्र्याक गर्न दिँदैन।</translation>
<translation id="8806901087257994310">तपाईंले यसपछि खोल्ने साइटले FlyWeb सँग तपाईंलाई देखाइने विज्ञापनहरू पर्सनलाइज गर्ने प्रयोजनका लागि तपाईंका रुचिहरू हेर्ने अनुमति माग्न सक्छ। FlyWeb ले बढीमा ३ वटा रुचि सेयर गर्न सक्छ।</translation>
<translation id="2742103213766991703">लिंकलाई FlyWeb को इन्कोग्निटो विन्डोमा खोल्नुहोस्</translation>
<translation id="2553796189989827248">कमजोर पासवर्डहरू सजिलै अनुमान लगाउन सकिन्छ। FlyWeb लाई <ph name="BEGIN_LINK"/>तपाईंका लागि भरपर्दा पासवर्ड बनाउन र याद राख्न<ph name="END_LINK"/> दिनुहोस्।</translation>
<translation id="1749753408579541220">यो सेटिङ अन हुँदा FlyWeb ले निष्क्रिय ट्याबहरूले प्रयोग गरेको मेमोरी खाली गर्छ। मेमोरी खाली हुँदा सक्रिय ट्याब तथा अन्य एपहरूले कम्प्युटरका अझ बढी स्रोतहरू प्रयोग गर्न सक्छन् र FlyWeb पनि अझ छिटो चल्छ। तपाईंले आफ्ना निष्क्रिय ट्याबहरू फेरि खोलेपछि ती ट्याबहरू फेरि स्वतः सक्रिय हुन्छन्।</translation>
<translation id="3453763134178591239">ChromeOS का सर्तहरू</translation>
