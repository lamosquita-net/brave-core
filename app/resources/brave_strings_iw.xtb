<translation id="7753744564324413106">‏אפשר להתאים אישית את FlyWeb כדי לשנות את מראה הדפדפן</translation>
<translation id="3202882878525816493">‏התאמה אישית של FlyWeb</translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="4890947375650921286">‏<ph name="PAGE_TITLE"/> – כניסה לרשת – FlyWeb</translation>
<translation id="6368928751841546993">‏החשבון של <ph name="EXISTING_USER"/> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-FlyWeb בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS"/>. אפשר לקבל גם את רשימת הקריאה ופריטים נוספים בכל המכשירים.</translation>
<translation id="4007949387571083162">‏אפליקציות, משחקים, תוספים ועיצובים מעולים בשביל FlyWeb.</translation>
<translation id="4753212377237684548">‏כדי לקבל גישה לתוסף הזה ולנתונים נוספים בכל המחשבים, צריך להיכנס ל-FlyWeb</translation>
<translation id="4391959806766569994">‏כדי לשמור על הבטיחות אונליין בהתאם לאפשרויות שנבחרו על ידי ההורה שלך, עליך לעבור לפרופיל FlyWeb שבו כבר נכנסת לחשבון עם האימייל <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4224210481850767180">ההתקנה בוטלה.</translation>
<translation id="2564888740660198776">‏האם לקשר את הנתונים שלך ב-FlyWeb לחשבון זה?</translation>
<translation id="7337819873931851298">‏מקבלים אזהרות לגבי אתרים מסוכנים, גם כאלה שלא היו ידועים ל-FlyWeb לפני כן, בעזרת ניתוח של יותר נתונים מאתרים בהשוואה להגנה הרגילה. אפשר לדלג על האזהרות מ-FlyWeb.</translation>
<translation id="8391959103619318249">‏יציאה מ-FlyWeb</translation>
<translation id="8514458758262040082">‏עזרה בנושא FlyWeb</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="3393587701694585022">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם FlyWeb פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="271336227467646058">‏ייצוא סיסמאות מ-FlyWeb</translation>
<translation id="4304713468139749426">מנהל הסיסמאות</translation>
