<!DOCTYPE translationbundle>
<translationbundle lang="id">
<translation id="130631256467250065">Perubahan Anda akan diterapkan pada saat Anda nanti menyalakan ulang perangkat.</translation>
<translation id="125853961893919199">Tips FlyWeb: Simpan Sandi</translation>
<translation id="1589233279653618219">Buka
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          dan pastikan konfigurasi disetel ke "tidak ada proxy" atau "langsung".</translation>
<translation id="8359495463485001719">Pelaporan kerusakan tidak tersedia di FlyWeb.</translation>
<translation id="6338530717474923868">Anda melihat halaman FlyWeb yang aman</translation>
<translation id="5147169001159408844">FlyWeb mencoba mengubah setelan pengisian metode pembayaran.</translation>
<translation id="5702992568540613683">Logo FlyWeb</translation>
<translation id="8966580353365544289">Tips FlyWeb: Safe Browsing yang Disempurnakan</translation>
<translation id="510342522494506803">FlyWeb mencoba mengedit metode pembayaran.</translation>
<translation id="8375862260948854624">FlyWeb tercipta berkat proyek sumber terbuka <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> dan berbagai <ph name="BEGIN_LINK_OSS"/>software sumber terbuka<ph name="END_LINK_OSS"/> lainnya.</translation>
<translation id="5040124620086808431">Halaman ini telah diblokir oleh FlyWeb</translation>
<translation id="1953000035868532675">Izinkan FlyWeb untuk mengakses jaringan di setelan firewall atau antivirus
          Anda.</translation>
<translation id="4949828774841497663">Buka Aplikasi &gt; Setelan Sistem &gt; Jaringan, pilih
          jaringan aktif, klik tombol Detail..., dan batalkan pilihan proxy
          yang mungkin telah dipilih.</translation>
<translation id="7584668345330431749">Buka
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Jaringan &amp; internet &gt; Proxy
          dan batalkan pilihan "Otomatis deteksi setelan".</translation>
<translation id="3145451630329266064">Halaman ini ditujukan untuk digunakan oleh developer FlyWeb, dan mungkin tidak dikelola atau diuji secara aktif. Untuk mengaktifkannya, buka <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, klik tombol untuk mengaktifkan halaman debug, lalu buka lagi halaman ini.</translation>
<translation id="2681118099728446983">FlyWeb juga terwujud karena adanya <ph name="BEGIN_LINK_OSS"/>software open source<ph name="END_LINK_OSS"/> lainnya.</translation>
<translation id="6888846095017247017">Perubahan Anda akan berlaku saat berikutnya Anda membuka FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb memerlukan akses Bluetooth untuk melanjutkan 
 penyambungan. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb terwujud karena adanya project open source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Buka
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          dan batalkan pilihan "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Jika hal ini tidak menyelesaikan masalah, sebaiknya pilih lagi opsi ini
          untuk meningkatkan kinerja.</translation>
<translation id="4699594416850504200">Anda melihat halaman FlyWeb for Testing yang aman</translation>
<translation id="6224789938625024797">FlyWeb tidak menutup dengan benar.</translation>
<translation id="3593104813552438879">Tips FlyWeb: Telusuri Dengan Lens</translation>
