+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_LAYOUT_INLINE_LOGICAL_LINE_BUILDER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_LAYOUT_INLINE_LOGICAL_LINE_BUILDER_H_
+
+#include "third_party/blink/renderer/core/layout/ng/inline/ng_inline_item_result.h"
+#include "third_party/blink/renderer/core/layout/ng/inline/ng_inline_node.h"
+
+namespace blink {
+
+class NGConstraintSpace;
+class NGInlineBreakToken;
+class NGInlineChildLayoutContext;
+class NGInlineLayoutAlgorithm;
+class NGInlineLayoutStateStack;
+class NGLineInfo;
+class NGLogicalLineItems;
+struct NGInlineBoxState;
+struct LogicalRubyColumn;
+
+// This class is responsible to build a NGLogicalLineItems from a NGLineInfo.
+// It's a helper for NGInlineLayoutAlgorithm.
+class LogicalLineBuilder {
+  STACK_ALLOCATED();
+
+ public:
+  LogicalLineBuilder(NGInlineNode node,
+                     const NGConstraintSpace& constraint_space,
+                     const NGInlineBreakToken* break_token,
+                     NGInlineLayoutStateStack* state_stack,
+                     NGInlineChildLayoutContext* context);
+
+  void RebuildBoxStates(const NGLineInfo& line_info,
+                        wtf_size_t start_item_index,
+                        wtf_size_t end_item_index);
+
+  // `main_line_helper` can be nullptr if the line is for ruby annotations.
+  void CreateLine(NGLineInfo* line_info,
+                  NGLogicalLineItems* line_box,
+                  NGInlineLayoutAlgorithm* main_line_helper);
+
+  // The following four functions are available after calling CreateLine().
+  const NGInlineItemResult* InitialLetterItemResult() const {
+    return initial_letter_item_result_;
+  }
+  bool HasOutOfFlowPositionedItems() const {
+    return has_out_of_flow_positioned_items_;
+  }
+  bool HasFloatingItems() const { return has_floating_items_; }
+  bool HasRelativePositionedItems() const {
+    return has_relative_positioned_items_;
+  }
+
+ private:
+  NGInlineBoxState* HandleOpenTag(const NGInlineItem&,
+                                  const NGInlineItemResult&,
+                                  NGLogicalLineItems*);
+  NGInlineBoxState* HandleItemResults(const NGLineInfo& line_info,
+                                      NGInlineItemResults& line_items,
+                                      NGLogicalLineItems* line_box,
+                                      NGInlineLayoutAlgorithm* main_line_helper,
+                                      NGInlineBoxState* box);
+  NGInlineBoxState* HandleCloseTag(const NGInlineItem&,
+                                   const NGInlineItemResult&,
+                                   NGLogicalLineItems* line_box,
+                                   NGInlineBoxState*);
+
+  void PlaceControlItem(const NGInlineItem&,
+                        const String& text_content,
+                        NGInlineItemResult*,
+                        NGLogicalLineItems* line_box,
+                        NGInlineBoxState*);
+  void PlaceHyphen(const NGInlineItemResult&,
+                   LayoutUnit hyphen_inline_size,
+                   NGLogicalLineItems* line_box,
+                   NGInlineBoxState*);
+  NGInlineBoxState* PlaceAtomicInline(const NGInlineItem&,
+                                      NGInlineItemResult*,
+                                      NGLogicalLineItems* line_box);
+  void PlaceInitialLetterBox(const NGInlineItem&,
+                             NGInlineItemResult*,
+                             NGLogicalLineItems* line_box);
+  void PlaceLayoutResult(NGInlineItemResult*,
+                         NGLogicalLineItems* line_box,
+                         NGInlineBoxState*,
+                         LayoutUnit inline_offset = LayoutUnit());
+  NGInlineBoxState* PlaceRubyColumn(const NGLineInfo& line_info,
+                                    NGInlineItemResult& item_result,
+                                    NGLogicalLineItems& line_box,
+                                    NGInlineBoxState* box);
+  void PlaceRubyAnnotation(NGInlineItemResult& item_result,
+                           wtf_size_t index,
+                           NGLineInfo& annotation_line,
+                           LogicalRubyColumn& logical_column);
+  void PlaceListMarker(const NGInlineItem&, NGInlineItemResult*);
+
+  void BidiReorder(TextDirection base_direction,
+                   NGLogicalLineItems* line_box,
+                   HeapVector<Member<LogicalRubyColumn>>& column_list);
+
+  NGInlineNode node_;
+  const NGConstraintSpace& constraint_space_;
+  const NGInlineBreakToken* break_token_;
+  NGInlineLayoutStateStack* box_states_;
+  NGInlineChildLayoutContext* context_;
+  const FontBaseline baseline_type_;
+
+  // True if in quirks or limited-quirks mode, which require line-height quirks.
+  // https://quirks.spec.whatwg.org/#the-line-height-calculation-quirk
+  const bool quirks_mode_ : 1;
+
+  // Output of CreateLine():
+
+  bool has_out_of_flow_positioned_items_ : 1 = false;
+  bool has_floating_items_ : 1 = false;
+  bool has_relative_positioned_items_ : 1 = false;
+  const NGInlineItemResult* initial_letter_item_result_ = nullptr;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_LAYOUT_INLINE_LOGICAL_LINE_BUILDER_H_
