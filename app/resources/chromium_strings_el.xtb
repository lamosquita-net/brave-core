<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="7099479769133613710">Επανεκκίνηση για ενημέρωση του &amp;Chrome OS</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="6896681084876612310">Το FlyWeb μπορεί να σας βοηθήσει με την προστασία από παραβιάσεις δεδομένων, ακατάλληλες επεκτάσεις κ.α.</translation>
<translation id="1368460307421081773">Το FlyWeb θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="7307912249127683931">Το FlyWeb είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="4556715463645168547">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK"/>συνδεθείτε στο FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Κάντε κλικ στο μενού του FlyWeb</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{Οι επεκτάσεις FlyWeb είχαν πρόσβαση σε συσκευές HID}=1{Οι επεκτάσεις FlyWeb έχουν πρόσβαση σε συσκευές HID}other{Οι επεκτάσεις FlyWeb έχουν πρόσβαση σε # συσκευές HID}}</translation>
<translation id="4380351562011537903">Σχετικά με το FlyWeb</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="4876991604685198381">Η Εξοικονόμηση μνήμης έκανε το FlyWeb πιο γρήγορο</translation>
<translation id="4750836834956739196">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το FlyWeb. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="4549187150186083146">Ρυθμίστε το νέο σας προφίλ στο FlyWeb</translation>
<translation id="4150708158890309866">Έχετε συνδεθεί στο FlyWeb!</translation>
<translation id="4713192356155907986">Λήψη βοήθειας για το FlyWeb for Testing</translation>
<translation id="8962360511570172">Μοιραστείτε μια καρτέλα του FlyWeb</translation>
<translation id="8196829963313696543">Το FlyWeb χρειάζεται άδεια πρόσβασης στην κάμερά σας, για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="3961251277542681013">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο FlyWeb</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="5579294097895667826">Υπάρχει μια νέα, ασφαλέστερη έκδοση του FlyWeb.</translation>
<translation id="2383861520542390014">Μπορείτε να δείτε και να καταργήσετε τα θέματα ενδιαφέροντος που χρησιμοποιούν οι ιστότοποι για να σας εμφανίζουν διαφημίσεις. Το FlyWeb κάνει εκτιμήσεις για τα ενδιαφέροντά σας με βάση το πρόσφατο ιστορικό περιήγησής σας.</translation>
<translation id="5695205873161614119">Το FlyWeb θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="7385422968404728039">Θα γίνει επανεκκίνηση του FlyWeb σε <ph name="REMAINING_TIME"/></translation>
<translation id="307170399141486420">Να επιτρέπεται στο FlyWeb να εκτελείται στο παρασκήνιο</translation>
<translation id="2473319786107120819">Επανεγκατάσταση του FlyWeb</translation>
<translation id="2533324957407080119">Το FlyWeb προσπαθεί να <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6434738578659849497">Οι ιστότοποι μπορούν να αποθηκεύουν πληροφορίες σχετικά με τα ενδιαφέροντά σας στο FlyWeb. Για παράδειγμα, εάν επισκεφτείτε έναν ιστότοπο για να αγοράσετε παπούτσια για έναν μαραθώνιο, ο ιστότοπος μπορεί να ορίσει τους μαραθώνιους τρεξίματος ως ενδιαφέρον σας. Αργότερα, εάν επισκεφτείτε έναν διαφορετικό ιστότοπο για να εγγραφείτε σε έναν αγώνα, αυτός ο ιστότοπος μπορεί να σας εμφανίσει μια διαφήμιση για παπούτσια τρεξίματος με βάση τα ενδιαφέροντά σας.</translation>
<translation id="4824940465467423308">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο FlyWeb. Τα δεδομένα σας στο FlyWeb, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών FlyWeb, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του FlyWeb. <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους FlyWeb, όπως το Gmail, χωρίς να συνδεθείτε στο FlyWeb</translation>
<translation id="5714085538350759767">Το FlyWeb δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="4035053306113201399">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chrome OS.</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE"/> λεπτά</translation>
<translation id="6956650624767954726">Το FlyWeb δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="6495079989036864983">Με αυτήν την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="4252651275570549255">Για να ελέγξετε αν οι άλλοι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK"/>συνδεθείτε στο FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό FlyWeb για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες FlyWeb.</translation>
<translation id="1868972292925460871">Πληροφορίες σχετικά με το πώς το FlyWeb διαχειρίζεται τα πιστοποιητικά ρίζας του</translation>
<translation id="6765231735885996239">Προσαρμογή του FlyWeb</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="2937508664417729967">FlyWeb - Σύνδεση δικτύου - <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το FlyWeb ακριβώς όπως θέλουν.</translation>
<translation id="5067150284614317159">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο FlyWeb. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το FlyWeb μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="3256927121768528350">Για να στείλετε από εδώ έναν αριθμό στο τηλέφωνό σας Android, συνδεθείτε στο FlyWeb και στις δύο συσκευές.</translation>
<translation id="8776241960316471093">Αυτή η επέκταση άλλαξε τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb.</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="8418845734693287262">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="2100412893059179161">Η επέκταση <ph name="EXTENSION_NAME"/> άλλαξε τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb.</translation>
<translation id="1364879203203742966">Το FlyWeb χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="3224379053610845181">Το FlyWeb θα κλείσει σύντομα</translation>
<translation id="3840682988105604367">Στο FlyWeb</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="6823116595279840454">Το FlyWeb προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτήν την ενέργεια.</translation>
<translation id="2691552788029831386">Το FlyWeb χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="2275866327478859777">Πρόγραμμα βοήθειας FlyWeb</translation>
<translation id="7717615706977383025">Τυχόν δεδομένα FlyWeb που δημιουργούνται κατά τη χρήση αυτού του προφίλ (όπως η δημιουργία σελιδοδεικτών, ιστορικού, κωδικών πρόσβασης και άλλων ρυθμίσεων) μπορούν να καταργηθούν από τον διαχειριστή του προφίλ εργασίας. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">Συνέχεια χρήσης του FlyWeb</translation>
<translation id="3827993926722004004">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="333184635927514678">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το FlyWeb ακριβώς όπως θέλουν.</translation>
<translation id="8991987934418988501">Το FlyWeb απέκλεισε αυτό το αρχείο επειδή μπορεί να κρύβει κάποιο κακόβουλο πρόγραμμα.</translation>
<translation id="1661841342483968180">Καλώς ήρθατε στο FlyWeb, <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">Καρτέλα FlyWeb</translation>
<translation id="2796283369875688710">Για επιπλέον ασφάλεια, το FlyWeb θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="2770231113462710648">Αλλαγή προεπιλεγμένου προγράμματος περιήγησης σε:</translation>
<translation id="7907238427168022751">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το FlyWeb, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="8990114339313395142">Με αυτόν τον τρόπο θα δημιουργηθεί ένα νέο προφίλ FlyWeb για το <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="1339341044496643931">Κατάργηση από το FlyWeb…</translation>
<translation id="4922993584046885552">Διατηρεί την ασφάλειά σας στο FlyWeb και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές FlyWeb όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="3806033752149316261">Σχετικά με το &amp;FlyWeb</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="2928420929544864228">Η εγκατάσταση ολοκληρώθηκε.</translation>
<translation id="1661079783259785361">Το FlyWeb έχει ενημερωθεί</translation>
<translation id="5447533789927384736">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το FlyWeb μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="1244955229468464260">Το FlyWeb δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="8841609317523323027">Προσθήκη στο FlyWeb…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="7859502023458300952">Βοηθήστε μας να κάνουμε το FlyWeb καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK"/> στη FlyWeb</translation>
<translation id="4133194854947529871">Το ιστορικό περιήγησής σας επηρεάζει τις διαφημίσεις που βλέπετε και τις εκτιμήσεις για τα ενδιαφέροντά σας παρακάτω. Για την προστασία του απορρήτου σας, το FlyWeb διαγράφει αυτόματα τα ενδιαφέροντά σας σε κυλιόμενη βάση κάθε μήνα. Τα ενδιαφέροντα μπορούν να ανανεώνονται, εκτός εάν τα καταργήσετε.</translation>
<translation id="1407857531570256859">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="1309738977648134943">Το FlyWeb χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="6274649779206195384">Επανεκκίνηση FlyWeb</translation>
<translation id="6773570808762718524">Προσαρμόστε το νέο σας προφίλ FlyWeb</translation>
<translation id="2700572810650522793">Το FlyWeb παρουσίασε σφάλμα. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="5449297306961970452">Το FlyWeb δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="6755586344927335130">Έχει εγκατασταθεί η έκδοση FlyWeb <ph name="PRODUCT_VERSION"/>.</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="3900612994249740104">Λείπουν κλειδιά του FlyWeb API. Ορισμένες λειτουργίες του FlyWeb FlyWeb θα απενεργοποιηθούν.</translation>
<translation id="6824575001009586492">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το FlyWeb είναι κλειστό</translation>
<translation id="5399208721646088502">Υπάρχει ήδη προφίλ FlyWeb με αυτόν τον λογαριασμό.</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="7978410129406361692">Εναλλαγή σε υπάρχον προφίλ FlyWeb;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="847273641988291714">Με τα προφίλ του FlyWeb μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο FlyWeb. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="1558345997029205345">Το FlyWeb θα σας ειδοποιήσει όταν συνδεθείτε με έναν παραβιασμένο κωδικό πρόσβασης.</translation>
<translation id="956833467923764542">Με αυτήν την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT"/> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">Με τη συντόμευση <ph name="SHORTCUT"/> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ FlyWeb</translation>
<translation id="6724485219247982027">Κλείστε όλα τα παράθυρα του FlyWeb και δοκιμάστε ξανά.</translation>
<translation id="763231524941489073">Για την προστασία του απορρήτου σας, διαγράφουμε αυτόματα τα ενδιαφέροντα που είναι παλαιότερα των 4 εβδομάδων. Καθώς συνεχίζετε την περιήγηση, ενδέχεται να εμφανιστεί ξανά ένα ενδιαφέρον στη λίστα. Εναλλακτικά, μπορείτε να καταργήσετε τα ενδιαφέροντα που δεν θέλετε να λαμβάνει υπόψη το FlyWeb.</translation>
<translation id="4856314253538330936">Το ιστορικό περιήγησής σας, δηλαδή ένα αρχείο των ιστοτόπων που έχετε επισκεφτεί χρησιμοποιώντας το FlyWeb σε αυτήν τη συσκευή.</translation>
<translation id="1054901839328542426">Υπάρχει επιβλαβές λογισμικό στον υπολογιστή σας. Το FlyWeb μπορεί να το καταργήσει, να επαναφέρει τις ρυθμίσεις σας και να απενεργοποιήσει τις επεκτάσεις, προκειμένου το πρόγραμμα περιήγησής σας να επιστρέψει σε φυσιολογική λειτουργία.</translation>
<translation id="199853864262219284">Έχει ήδη συνδεθεί κάποιος άλλος λογαριασμός. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το FlyWeb μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="9154454584386840012">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε macOS 10.15 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 10.13.</translation>
<translation id="7465608402296261674">Για να στείλετε έναν αριθμό από το <ph name="ORIGIN"/> στο τηλέφωνό σας Android, συνδεθείτε στο FlyWeb και στις δύο συσκευές.</translation>
<translation id="1543563097158722437">Το FlyWeb δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε να ελέγξετε τη σύνδεσή σας στο διαδίκτυο.</translation>
<translation id="190360428475385352">Μάθετε περισσότερα σχετικά με την εξατομίκευση διαφημίσεων στο FlyWeb</translation>
<translation id="6611602069520888180">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα FlyWeb</translation>
<translation id="8701399577028839698">Το FlyWeb σάς επιτρέπει να κάνετε κλικ σε έναν τηλεφωνικό αριθμό στον ιστό και να τον καλέσετε με το Skype!</translation>
<translation id="2401189691232800402">Σύστημα Chrome OS</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">Λήψη βοήθειας σχετικά με το Chrome OS</translation>
<translation id="1864899808802540927">Λήψη του περιεχομένου του προγράμματος περιήγησης FlyWeb από <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="2736927994658608637">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε macOS 10.15 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 10.14.</translation>
<translation id="5175060854726708547">Προσαρμογή και έλεγχος του FlyWeb. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="606156353708638647">Κάντε κλικ στο όνομά σας, για να ανοίξετε το FlyWeb και να ξεκινήσετε την περιήγηση.</translation>
<translation id="5145107420478372433">Ο χρήστης <ph name="EXISTING_USER"/> είναι συνδεδεμένος ήδη με αυτό το προφίλ FlyWeb. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το FlyWeb μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="3376157109651222096">Η διαχείριση του λογαριασμού σας γίνεται από τον διαχειριστή <ph name="MANAGER_NAME"/>. Ο διαχειριστής σας μπορεί να δει και να επεξεργαστεί αυτό το προφίλ προγράμματος περιήγησης FlyWeb και τα δεδομένα του, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης.</translation>
<translation id="8536259619256229278">Το FlyWeb προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτήν την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="4041003017438130352">Το FlyWeb συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο</translation>
<translation id="5667414856761616811">Σχετικά με το &amp;FlyWeb for Testing</translation>
<translation id="1152920704813762236">Σχετικά με το Chrome OS</translation>
<translation id="3703994572283698466">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS"/>περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="504994999924593940">Συμβάλετε στη βελτίωση του FlyWeb, αναφέροντας τις <ph name="BEGIN_LINK"/>τρέχουσες ρυθμίσεις<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου - FlyWeb</translation>
<translation id="4007949387571083162">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το FlyWeb.</translation>
<translation id="1595210458721188387">Αυτή η γλώσσα χρησιμοποιείται για την προβολή της διεπαφής FlyWeb</translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="2564888740660198776">Να συνδεθούν τα δεδομένα σας στο FlyWeb με αυτόν το λογαριασμό;</translation>
<translation id="8514458758262040082">Λήψη βοήθειας σχετικά με το FlyWeb</translation>
<translation id="3393587701694585022">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το FlyWeb εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="4304713468139749426">Διαχειριστής κωδικών πρόσβασης</translation>
<translation id="4334294535648607276">Η λήψη ολοκληρώθηκε.</translation>
<translation id="1068681683510904753">Το <ph name="MANAGER"/> απαιτεί να διαβάσετε και να αποδεχτείτε τους παρακάτω Όρους Παροχής Υπηρεσιών πριν από τη χρήση αυτής της συσκευής. Οι συγκεκριμένοι όροι δεν επεκτείνουν, τροποποιούν ή περιορίζουν τους Όρους του Chrome OS.</translation>
<translation id="1376968889000878095">Να γίνει έξοδος από το FlyWeb ούτως ή άλλως;</translation>
<translation id="6360389033094512399">Να επιτρέπεται στο FlyWeb να εκτελείται στο παρασκήνιο</translation>
<translation id="4166347503469830337">Προσαρμογή και έλεγχος του FlyWeb</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="8791209382165811772">Σχετικά με το FlyWeb for Testing</translation>
<translation id="834808339160590901">Καλωσορίσατε στο FlyWeb. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="1304885695888649052">Δεν έγινε ενημέρωση του FlyWeb, παρουσιάστηκε κάποιο σφάλμα. <ph name="BEGIN_LINK"/>Επιδιορθώστε τα προβλήματα ενημέρωσης και αποτυχημένων ενημερώσεων του FlyWeb.<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">Συνέχεια σε νέο προφίλ FlyWeb;</translation>
<translation id="4567424176335768812">Έχετε συνδεθεί ως <ph name="USER_EMAIL_ADDRESS"/>. Τώρα μπορείτε να αποκτήσετε πρόσβαση στους σελιδοδείκτες, το ιστορικό και σε άλλες ρυθμίσεις από όλες τις συσκευές στις οποίες έχετε συνδεθεί.</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="6046424510733540251">Εφαρμογές FlyWeb</translation>
<translation id="4970880042055371251">Έκδοση Chrome OS</translation>
<translation id="1936188352112244665">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το FlyWeb για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="2962574118577609024">Εάν κοινοποιείτε επίσης αναφορές χρήσης του FlyWeb, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="9219132550163437762">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του FlyWeb (<ph name="PROCESS_ID"/>) σε άλλο υπολογιστή (<ph name="HOST_NAME"/>). Το FlyWeb έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το FlyWeb.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="5227023869666757348">Κάποιο άτομο συνδέθηκε προηγουμένως στο FlyWeb σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST"/>. Δημιουργήστε έναν νέο χρήστη του FlyWeb, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="1671154647029930623">Να τερματιστεί η λειτουργία του FlyWeb ούτως ή άλλως;</translation>
<translation id="4143239505982500022">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το FlyWeb. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="1347247057384060764">Μπορείτε να αλλάξετε γνώμη ανά πάσα στιγμή στις ρυθμίσεις του FlyWeb. Οι δοκιμές εκτελούνται παράλληλα με τον τρέχοντα τρόπο προβολής των διαφημίσεων, επομένως δεν θα παρατηρήσετε αλλαγές αμέσως.</translation>
<translation id="4259200560913816786">Το FlyWeb δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά μετά από 24 ώρες ή <ph name="BEGIN_LINK"/>ελέγξτε τους κωδικούς πρόσβασης στον Λογαριασμό σας FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση FlyWeb. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην FlyWeb. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="2991144524835127379">Εισερχόμενος κανόνας για το FlyWeb για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="6208903184719035736">Επανεκκίνηση για ενημέρωση του &amp;FlyWeb</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το FlyWeb δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι υπάρχουσες καρτέλες θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το FlyWeb δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι υπάρχουσες καρτέλες θα παραμείνουν ανοιχτές.}}</translation>
<translation id="7174589544844983914">Το FlyWeb εκτελείται στο παρασκήνιο.</translation>
<translation id="7792628702371319769">Οι επισκέπτες μπορούν να χρησιμοποιούν το FlyWeb χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="2760069255902967585">Προσθήκη του εαυτού σας στο FlyWeb</translation>
<translation id="4239638419916712076">Το FlyWeb εξερευνά νέες λειτουργίες που επιτρέπουν στους ιστοτόπους να προσφέρουν την ίδια εμπειρία περιήγησης χρησιμοποιώντας λιγότερες από τις πληροφορίες σας</translation>
<translation id="387444474697464273">Δεν υπάρχουν αποθηκευμένοι κωδικοί πρόσβασης. Το FlyWeb μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύσετε.</translation>
<translation id="520701392326482190">Ο χρήστης <ph name="EXISTING_USER"/> είναι συνδεδεμένος ήδη σε αυτό το προφίλ FlyWeb. Με αυτόν τον τρόπο θα δημιουργηθεί ένα νέο προφίλ FlyWeb για το <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="8295539942024823191">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το FlyWeb</translation>
<translation id="5374328929709976901">Όταν είναι ενεργοποιημένες οι δοκιμές και εάν το FlyWeb σας έχει τοποθετήσει τυχαία σε μια ενεργή δοκιμή, το ιστορικό περιήγησής σας επηρεάζει τις διαφημίσεις που βλέπετε και τις εκτιμήσεις για τα ενδιαφέροντά σας παρακάτω. Για την προστασία του απορρήτου σας, το FlyWeb διαγράφει τα ενδιαφέροντά σας σε κυλιόμενη βάση κάθε μήνα.</translation>
<translation id="8449603408481238073">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο FlyWeb. Τα δεδομένα σας στο FlyWeb, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών FlyWeb, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">Ενημέρωση του FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">Να επιτρέπεται η σύνδεση στο FlyWeb</translation>
<translation id="5965500511473700110">Μια νέα έκδοση του FlyWeb είναι διαθέσιμη.</translation>
<translation id="1827750898515917134">Κατάργηση από το FlyWeb</translation>
<translation id="5020755920249060562">Ορισμός του FlyWeb ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb Beta</translation>
<translation id="5385202369020319636">Το FlyWeb ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="5957333939864770801">Το FlyWeb χρειάζεται πρόσβαση στην τοποθεσία σας, για να την κοινοποιήσει σε αυτόν τον ιστότοπο</translation>
<translation id="780999790006298623">Για την προστασία του απορρήτου σας, διαγράφουμε αυτόματα τα ενδιαφέροντα που είναι παλαιότερα των 4 εβδομάδων. Καθώς συνεχίζετε την περιήγηση, ενδέχεται να εμφανιστεί ξανά ένα ενδιαφέρον στη λίστα. Και εάν το FlyWeb κάνει κάποιο λάθος ή δεν θέλετε να βλέπετε συγκεκριμένες διαφημίσεις, μπορείτε να καταργήσετε ένα ενδιαφέρον.</translation>
<translation id="2183749398075655200">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το FlyWeb.</translation>
<translation id="8996657165865563765">Το FlyWeb προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτήν την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="5738298079259740925">Άνοιγμα PDF στο FlyWeb</translation>
<translation id="9197514179291669592">Όταν είναι ενεργή η επιλογή, θα αποσυνδεθείτε και από το FlyWeb</translation>
<translation id="6096945112863785306">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του FlyWeb}=1{Υπάρχει μια διαθέσιμη ενημέρωση του FlyWeb}other{Υπάρχει μια διαθέσιμη ενημέρωση του FlyWeb για # ημέρες}}</translation>
<translation id="5666891644992637849">Επανεκκινήστε το FlyWeb τώρα</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Να εμφανίζεται το FlyWeb σε αυτήν τη γλώσσα</translation>
<translation id="8331941171144629807">Καλώς ήρθατε στο FlyWeb</translation>
<translation id="7581082856615467651">Το FlyWeb εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="483902194277448471">Εάν το FlyWeb σας έχει τοποθετήσει τυχαία σε μια ενεργή δοκιμή, το ιστορικό περιήγησής σας επηρεάζει τις διαφημίσεις που βλέπετε και τις εκτιμήσεις για τα ενδιαφέροντά σας παρακάτω. Για την προστασία του απορρήτου σας, το FlyWeb διαγράφει τα ενδιαφέροντά σας σε κυλιόμενη βάση κάθε μήνα. Τα ενδιαφέροντα ανανεώνονται, εκτός εάν τα καταργήσετε.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="4955869506208896934">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το FlyWeb</translation>
<translation id="63409513082302419">Είναι σύνηθες οι ιστότοποι που επισκέπτεστε να απομνημονεύουν τα ενδιαφέροντά σας για να εξατομικεύουν την εμπειρία σας. Οι ιστότοποι μπορούν να αποθηκεύουν επίσης πληροφορίες σχετικά με τα ενδιαφέροντά σας στο FlyWeb.</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS"/> ώρες</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="2904199563401682369">Υπάρχει μια νέα έκδοση του FlyWeb και είναι ταχύτερη από ποτέ.</translation>
<translation id="8714139918792771260">&amp;Άνοιγμα στο FlyWeb</translation>
<translation id="499541338626558192">Η επέκταση <ph name="EXTENSION_NAME"/> έχει προστεθεί στο FlyWeb</translation>
<translation id="3890023823480067024">Κάντε το FlyWeb πιο γρήγορο</translation>
<translation id="608006075545470555">Προσθήκη προφίλ εργασίας σε αυτό το πρόγραμμα περιήγησης</translation>
<translation id="5880307616068888895">Προσαρμόστε και ελέγξτε το FlyWeb. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="8890528681896757647">Όταν η ρύθμιση είναι ενεργή, το FlyWeb εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ του βίντεο.</translation>
<translation id="1683225514126450592">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του FlyWeb</translation>
<translation id="5171527334826689262">Το FlyWeb θα αποθηκεύσει αυτόν τον κωδικό πρόσβασης στον Λογαριασμό σας FlyWeb. Δεν χρειάζεται να τον απομνημονεύσετε.</translation>
<translation id="4809579265564854985">Το αρχείο <ph name="FILE_NAME"/> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="1773252983747911987">Το FlyWeb θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="3063780243670578104">Η Ασφαλής περιήγηση είναι απενεργοποιημένη. Το FlyWeb συνιστά να την ενεργοποιήσετε.</translation>
<translation id="1686760912855738719">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας FlyWeb</translation>
<translation id="4403968929742079769">Βεβαιωθείτε ότι έχετε συνδεθεί στο FlyWeb στη συσκευή σας <ph name="TARGET_DEVICE_NAME"/> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="1855179706668101462">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του FlyWeb. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το FlyWeb και κατεβάστε το ξανά.</translation>
<translation id="651290634887454330">{0,plural, =0{Η επανεκκίνηση του FlyWeb θα γίνει τώρα}=1{Η επανεκκίνηση του FlyWeb θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του FlyWeb θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="2586408713760853791">Το FlyWeb χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="1603558835003845196">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο FlyWeb</translation>
<translation id="5751080530525677552">Ορισμός FlyWeb ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="4804111781678641302">Το FlyWeb δεν μπορεί να ελέγξει για ενημερώσεις Δοκιμάστε να ελέγξετε τη σύνδεσή σας στο διαδίκτυο.</translation>
<translation id="3542157007113577464">Θέλετε να αποσυνδεθείτε από το FlyWeb;</translation>
<translation id="6273793429163604305">Λάβετε θέσεις…</translation>
<translation id="3794967601634523398">Προσαρμόστε το προφίλ σας FlyWeb</translation>
<translation id="6475001900959697061">Ονομάστε το προφίλ σας στο FlyWeb</translation>
<translation id="4465156155012748592">Το αρχείο <ph name="FILE_NAME"/> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="5523868569707953059">Το FlyWeb χρησιμοποιεί την κάμερά σας.</translation>
<translation id="5914697581312472089">Το FlyWeb απέκλεισε αυτό το αρχείο γιατί είναι επικίνδυνο</translation>
<translation id="6327105987658262776">Δεν υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="8226838065217375546">Μια άλλη λειτουργία στο FlyWeb βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6063700568539132984">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το FlyWeb με το Λογαριασμό σας FlyWeb και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="6890209090736444656">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του FlyWeb;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>Πώς χρησιμοποιούμε αυτά τα δεδομένα:<ph name="END_BOLD"/> Το FlyWeb μπορεί να κάνει εκτιμήσεις για τα ενδιαφέροντά σας. Αργότερα, ένας ιστότοπος που επισκέπτεστε μπορεί να ζητήσει από το FlyWeb να δει τα ενδιαφέροντά σας, προκειμένου να εξατομικεύσει τις διαφημίσεις που βλέπετε.</translation>
<translation id="6636986997730784876">Το FlyWeb είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="2139300032719313227">Επανεκκίνηση Chrome OS</translation>
<translation id="173462352822069427">Καλώς ήρθατε στα προφίλ του FlyWeb</translation>
<translation id="1474676525193357364">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="5777905264835557372">Απεγκατάσταση FlyWeb</translation>
<translation id="8852057261917278552">Ο οργανισμός σας κλείνει το FlyWeb όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="8592211619057897362">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο FlyWeb, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="7489092380688543560">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ FlyWeb</translation>
<translation id="8243012192239086369">Για τη διόρθωση ορθογραφικών λαθών, το FlyWeb στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο FlyWeb</translation>
<translation id="3927263773110604886">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του FlyWeb</translation>
<translation id="6888846095017247017">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το FlyWeb.</translation>
<translation id="1886169834787876002">Το FlyWeb χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="7640394575797555654">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο, αλλά δεν θα σας θυμούνται μετά το κλείσιμο όλων των παραθύρων του FlyWeb</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="1363996462118479832">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="4152880912192471857">Το FlyWeb χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="2193001403607253406">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του FlyWeb.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του FlyWeb.</translation>
<translation id="3260179770078760650">Η Εξοικονόμηση μνήμης έκανε το FlyWeb πιο γρήγορο</translation>
<translation id="7728046102681268859">Το FlyWeb είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="7030752319019635064">Για να αποκτήσετε πρόσβαση στο περιεχόμενό σας στο FlyWeb σε όλες τις συσκευές σας, συνδεθείτε και, στη συνέχεια, ενεργοποιήστε τον συγχρονισμό.</translation>
<translation id="1292831930742306370">Το FlyWeb συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="5612302437680103875">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το FlyWeb. Η ενεργοποίηση του στοιχείου <ph name="EXTENSION_TYPE_PARAMETER"/> δεν επιτρέπεται.</translation>
<translation id="1547295885616600893">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6432682256389755533">Το FlyWeb σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="178055475944027272">Το FlyWeb απέκλεισε αυτό το αρχείο επειδή περιέχει κακόβουλο πρόγραμμα</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="5712993149989886097">Google Pay (αντιγράφηκε στο FlyWeb)</translation>
<translation id="4695676871328690599">Το FlyWeb εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME"/>.</translation>
<translation id="76559364095325834">Το FlyWeb έχει ενημερωθεί, αλλά δεν το έχετε χρησιμοποιήσει για 30 ημέρες τουλάχιστον.</translation>
<translation id="8524328905288851065">Το FlyWeb χρειάζεται πρόσβαση στο Bluetooth για να συνεχιστεί 
 η σύζευξη. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="5929819793040985066">Όταν είναι ενεργοποιημένες οι δοκιμές, η Μέτρηση διαφημίσεων επιτρέπει στους ιστοτόπους που επισκέπτεστε να ζητούν πληροφορίες από το FlyWeb που βοηθούν τον ιστότοπο να μετρήσει την απόδοση των διαφημίσεών του. Η Μέτρηση διαφημίσεων περιορίζει την παρακολούθηση μεταξύ ιστοτόπων μεταφέροντας όσο το δυνατόν λιγότερες πληροφορίες μεταξύ των ιστοτόπων.</translation>
<translation id="8806901087257994310">Αργότερα, ένας ιστότοπος που επισκέπτεστε μπορεί να ζητήσει από το FlyWeb να δει τα ενδιαφέροντά σας, προκειμένου να εξατομικεύσει τις διαφημίσεις που βλέπετε. Το FlyWeb μπορεί να κοινοποιήσει έως και 3 ενδιαφέροντα.</translation>
<translation id="2553796189989827248">Είναι εύκολο να μαντέψει κανείς τους ασθενείς κωδικούς πρόσβασης. Επιτρέψτε στο FlyWeb να <ph name="BEGIN_LINK"/>δημιουργεί και να απομνημονεύει ισχυρούς κωδικούς πρόσβασης για εσάς<ph name="END_LINK"/>.</translation>
<translation id="1749753408579541220">Όταν η ρύθμιση είναι ενεργή, το FlyWeb αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το FlyWeb γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές.</translation>
<translation id="3453763134178591239">Όροι του Chrome OS</translation>
<translation id="8545123476334328275">Το FlyWeb χρειάζεται άδεια, για να αποκτήσει πρόσβαση στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="7025789849649390912">Η εγκατάσταση διακόπηκε.</translation>
<translation id="3945284827084409390">Ενημέρωση FlyWeb</translation>
<translation id="7886270027101123253">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το FlyWeb θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην FlyWeb.</translation>
<translation id="6017914745388312119">Ο οργανισμός σας διαγράφει τα δεδομένα του FlyWeb όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION"/>. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="3283953248242339756">Το FlyWeb χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="4729674580260824908">Δεν ήταν δυνατή η εκκίνηση του FlyWeb. Προσπάθησε ξανά.</translation>
<translation id="9165925035484501889">Το FlyWeb δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά σε 24 ώρες.</translation>
<translation id="1678436729108859736">Διαχείριση Εργασιών - FlyWeb</translation>
<translation id="6135229048093148288">Τα ενδιαφέροντά σας σύμφωνα με την εκτίμηση του FlyWeb</translation>
<translation id="7641415053133771502">Η Μέτρηση διαφημίσεων επιτρέπει στους ιστοτόπους που επισκέπτεστε να ζητούν πληροφορίες από το FlyWeb που βοηθούν τον ιστότοπο να μετρήσει την απόδοση των διαφημίσεών του. Η Μέτρηση διαφημίσεων περιορίζει την παρακολούθηση μεταξύ ιστοτόπων μεταφέροντας όσο το δυνατόν λιγότερες πληροφορίες μεταξύ των ιστοτόπων.</translation>
<translation id="2866611433272355726">Ενημέρωση του FlyWeb</translation>
<translation id="5013690772358862887">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το FlyWeb δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7339898014177206373">Νέο παράθυρο</translation>
<translation id="1123144153876435088">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του FlyWeb.</translation>
<translation id="6760192061736180746">Ο διαχειριστής συστήματος έχει διαμορφώσει το FlyWeb ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME"/> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="3225813655660631613">Με τα προφίλ του FlyWeb μπορείτε να διαχωρίσετε όλο το περιεχόμενό σας στο FlyWeb. Αυτό σας βοηθά να διαχωρίζετε την εργασία από την ψυχαγωγία.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="3787225360375979559">Το FlyWeb χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα για αυτόν τον ιστότοπο</translation>
<translation id="2431618580332826398">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="2154651873647244914">Επανεκκίνηση του FlyWeb;</translation>
<translation id="3137757192868162370">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του FlyWeb που εκτελείται αυτήν τη στιγμή. Κλείστε το FlyWeb και δοκιμάστε ξανά.</translation>
<translation id="4731230085409037950">{0,plural, =1{Η επανεκκίνηση του FlyWeb θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του FlyWeb θα γίνει σε # λεπτά}}</translation>
<translation id="2706045239797506060">Επίσης, να διαγραφούν δεδομένα από το FlyWeb (<ph name="URL"/>)</translation>
<translation id="5426732664223965459">Το FlyWeb μπορεί να κάνει εκτιμήσεις για τα ενδιαφέροντά σας. Αργότερα, ένας ιστότοπος που επισκέπτεστε μπορεί να ζητήσει από το FlyWeb να δει τα ενδιαφέροντά σας, προκειμένου να εξατομικεύσει τις διαφημίσεις που βλέπετε.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">Το FlyWeb χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="1381291360713116383">Το FlyWeb έγινε ακόμα καλύτερο</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="481435825250648341">Μπορείτε να μάθετε περισσότερα σχετικά με αυτές τις λειτουργίες στις ρυθμίσεις του FlyWeb.</translation>
<translation id="3079800650903360762">Το FlyWeb εξερευνά νέες λειτουργίες που επιτρέπουν στους ιστοτόπους να προσφέρουν την ίδια εμπειρία περιήγησης χρησιμοποιώντας λιγότερα από τα δεδομένα σας</translation>
<translation id="2230101319599356673">Το FlyWeb δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="3243257760331619874">Συγχρονίστε και εξατομικεύστε το FlyWeb στις συσκευές σας</translation>
<translation id="1549877678317463759">Με αυτήν την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="134973275687829726">Κάντε το FlyWeb πιο γρήγορο</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8463540467315366872">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ FlyWeb με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8611872055947278722">Δεν ήταν δυνατή η ενημέρωση του FlyWeb στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS"/> δευτερόλεπτα.</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>Πώς μπορείτε να διαχειριστείτε τα δεδομένα σας:<ph name="END_BOLD"/> Για την προστασία του απορρήτου σας, διαγράφουμε αυτόματα τα ενδιαφέροντα που είναι παλαιότερα των 4 εβδομάδων. Καθώς συνεχίζετε την περιήγηση, ενδέχεται να εμφανιστεί ξανά ένα ενδιαφέρον στη λίστα. Εναλλακτικά, μπορείτε να καταργήσετε τα ενδιαφέροντα που δεν θέλετε να λαμβάνει υπόψη το FlyWeb.</translation>
<translation id="3096730275883527801">Συνδεθήκατε στο FlyWeb ως <ph name="USER_EMAIL_ADDRESS"/>. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="9017338699075596174">Αυτή είναι μια δευτερεύουσα εγκατάσταση του FlyWeb και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5944585442866020176">Όταν το FlyWeb αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="3263664073045388929">Το FlyWeb χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="5334309298019785904">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="1597323875619800374">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="8455485678130879158">Το FlyWeb απέκλεισε αυτό το αρχείο επειδή αυτός ο τύπος αρχείου είναι επικίνδυνος.</translation>
<translation id="6756872644564483342">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το FlyWeb θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην FlyWeb. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="5792785787074426346">Το FlyWeb δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας επειδή δεν είστε συνδεδεμένοι.</translation>
<translation id="6627585369674499881">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο και έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="208266011144024011">Ο οργανισμός σας κλείνει το FlyWeb όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="3542611917357881417">Κάντε περισσότερα με το FlyWeb</translation>
<translation id="5565286784156841599">Συνδεθείτε, για να συγχρονίσετε και να εξατομικεύσετε το FlyWeb στις συσκευές σας</translation>
<translation id="9174706677133564856">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS"/> χρησιμοποιούσε το FlyWeb στο παρελθόν</translation>
<translation id="5975370349701995302">Για να έχετε πρόσβαση από όλες τις συσκευές σας στο περιεχόμενο που διαθέτετε στο πρόγραμμα περιήγησης FlyWeb, συνδεθείτε και, στη συνέχεια, ενεργοποιήστε τον συγχρονισμό.</translation>
<translation id="7408894216012529448">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="7256356679044945328">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το FlyWeb, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="5261590792975521002">{0,plural, =1{Επανεκκίνηση του FlyWeb σε μία ημέρα}other{Επανεκκίνηση του FlyWeb σε # ημέρες}}</translation>
<translation id="3101564993057563365">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="5316851838033144902">Το FlyWeb απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="6760691951531758781">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chrome OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην FlyWeb.</translation>
<translation id="6852836260419236265">Το FlyWeb δεν είναι ενημερωμένο</translation>
<translation id="8550334526674375523">Αυτό το προφίλ εργασίας είναι εντελώς ξεχωριστό από το προσωπικό προφίλ σας.</translation>
<translation id="538636623826336032">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το FlyWeb. Η προσθήκη του στοιχείου <ph name="EXTENSION_TYPE_PARAMETER"/> δεν επιτρέπεται.</translation>
<translation id="8842078659829047498">Το FlyWeb μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν συνδέεστε με τον Λογαριασμό σας FlyWeb.</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="6539417028609632917"><ph name="BEGIN_BOLD"/>Πώς χρησιμοποιούμε αυτά τα δεδομένα:<ph name="END_BOLD"/> Οι ιστότοποι μπορούν να αποθηκεύουν πληροφορίες σχετικά με τα ενδιαφέροντά σας στο FlyWeb. Για παράδειγμα, εάν επισκεφτείτε έναν ιστότοπο για να αγοράσετε παπούτσια για έναν μαραθώνιο, ο ιστότοπος μπορεί να ορίσει τους μαραθώνιους τρεξίματος ως ενδιαφέρον σας. Αργότερα, εάν επισκεφτείτε έναν διαφορετικό ιστότοπο για να εγγραφείτε σε έναν αγώνα, αυτός ο ιστότοπος μπορεί να σας εμφανίσει μια διαφήμιση για παπούτσια τρεξίματος με βάση τα ενδιαφέροντά σας.</translation>
<translation id="7129578417724116642">Εκκίνηση του FlyWeb…</translation>
<translation id="781795332371306113">Η εγκατάσταση απέτυχε λόγω μη καθορισμένου σφάλματος. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="5469043671012993003">Το FlyWeb for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="1074759999845943804">{NUM_DEVICES,plural, =0{Μια επέκταση FlyWeb είχε πρόσβαση σε συσκευές HID}=1{Μια επέκταση FlyWeb έχει πρόσβαση σε 1 συσκευή HID}other{Μια επέκταση FlyWeb έχει πρόσβαση σε # συσκευές HID}}</translation>
<translation id="1514450422236300417">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="573490495087487940">Ορίστε το δικό σας FlyWeb</translation>
<translation id="6779439179813982247">Το FlyWeb χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα και στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχειριστής κωδικών πρόσβασης</translation>
<translation id="6933858244219479645">Σύστημα Chrome OS</translation>
<translation id="7354175404728814475"><ph name="BEGIN_BOLD"/>Ποια δεδομένα χρησιμοποιούνται:<ph name="END_BOLD"/> Το ιστορικό περιήγησής σας, ένα αρχείο των ιστοτόπων που έχετε επισκεφτεί χρησιμοποιώντας το FlyWeb σε αυτήν τη συσκευή.</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="709828993049448700">Σε αυτήν την περίπτωση, επεξεργαστείτε τον αποθηκευμένο κωδικό πρόσβασής σας στο FlyWeb έτσι ώστε να ταιριάζει με τον νέο κωδικό πρόσβασής σας.</translation>
<translation id="1446416109379198698">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb ή όταν κάνετε κλικ στο κουμπί αρχικής σελίδας.</translation>
<translation id="4669168852412989042">Το FlyWeb προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="1343885466359249904">Το FlyWeb μπορεί να κάνει εκτιμήσεις για τα ενδιαφέροντά σας με βάση το ιστορικό περιήγησής σας τις τελευταίες εβδομάδες. Αυτές οι πληροφορίες παραμένουν στη συσκευή σας.</translation>
<translation id="1663379621921336006">Δεν είναι δυνατή η ενημέρωση του FlyWeb</translation>
<translation id="543915850302643692">Λογότυπο FlyWeb Enterprise</translation>
<translation id="8986207147630327271">Προσθέτετε ένα προφίλ εργασίας σε αυτό το πρόγραμμα περιήγησης και παραχωρείτε τον έλεγχο στον διαχειριστή σας μόνο για το προφίλ εργασίας.</translation>
<translation id="5804408305184682593">Σύνδεση στο FlyWeb</translation>
<translation id="8692043725449223663">Συνδεθείτε στο FlyWeb. Εάν θέλετε να συνδεθείτε σε έναν λογαριασμό μόνο μία φορά, μπορείτε να <ph name="GUEST_LINK_BEGIN"/>χρησιμοποιήσετε τη συσκευή ως επισκέπτης<ph name="GUEST_LINK_END"/>.</translation>
<translation id="8323442969389928559">Το FlyWeb έκλεισε αυτόματα</translation>
<translation id="7626272203917389133">Το FlyWeb δεν είναι ενημερωμένο</translation>
<translation id="1789655708880997767">{0,plural, =1{Η επανεκκίνηση του FlyWeb θα γίνει σε μία ώρα}other{Η επανεκκίνηση του FlyWeb θα γίνει σε # ώρες}}</translation>
<translation id="8970147445441095618">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="1208237657860748752">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα FlyWeb</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="1899793037348288257">Κατά τη διάρκεια των δοκιμών, μπορείτε να δείτε και να καταργήσετε θέματα ενδιαφέροντος που χρησιμοποιούν οι ιστότοποι για την εμφάνιση διαφημίσεων. Το FlyWeb κάνει εκτιμήσεις για τα ενδιαφέροντά σας με βάση το πρόσφατο ιστορικό περιήγησής σας.</translation>
<translation id="3926534790663909774">Ο διαχειριστής συστήματος έχει διαμορφώσει το FlyWeb έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="5022081608392609959">Επανεκκίνηση για ενημέρωση του &amp;FlyWeb</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Εξατομίκευση του FlyWeb</translation>
<translation id="3410331617397516204">Το FlyWeb μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="1641772209502041092">Πιστοποιητικά που διαχειρίζεται το FlyWeb</translation>
<translation id="1127626874097952395">Ποιος χρησιμοποιεί το FlyWeb;</translation>
<translation id="1626113414414104077">Λάβετε την ισχυρότερη προστασία του FlyWeb</translation>
<translation id="2952628102760787868">Να γίνεται πάντα διαγραφή των δεδομένων ιστοτόπων από τη συσκευή σας όταν κλείνετε το FlyWeb</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="4434689349450618970">Εάν θέλετε να χρησιμοποιήσετε αυτόν τον λογαριασμό μόνο μία φορά, μπορείτε να χρησιμοποιήσετε τη <ph name="GUEST_LINK_BEGIN"/>Λειτουργία επισκέπτη<ph name="GUEST_LINK_END"/> στο πρόγραμμα περιήγησης FlyWeb. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιον άλλο, <ph name="LINK_BEGIN"/>προσθέστε ένα νέο προφίλ<ph name="LINK_END"/> στο <ph name="DEVICE_TYPE"/> σας.

Τα δικαιώματα που έχετε ήδη δώσει σε ιστότοπους και εφαρμογές ενδέχεται να ισχύουν για αυτόν τον λογαριασμό. Μπορείτε να διαχειριστείτε τις αλυσίδες συγχρονισμού FlyWeb σας στις <ph name="SETTINGS_LINK_BEGIN"/>Ρυθμίσεις<ph name="SETTINGS_LINK_END"/>.</translation>
<translation id="2725795635123877647">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το FlyWeb συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="3470813199863172076">Η επέκταση αυτή παραβιάζει την πολιτική του διαδικτυακού καταστήματος. Αφαιρέστε τη από τον FlyWeb, για να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα στους ιστότοπους που επισκέπτεστε, ούτε τα προσωπικά στοιχεία σας.</translation>
<translation id="5382847955032513683">Προειδοποίηση: Το FlyWeb δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτήν την επέκταση σε Ιδιωτική λειτουργία, καταργήστε αυτήν την επιλογή.</translation>
<translation id="543905389684998697">Για να κάνουμε το FlyWeb πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="3914570680366033593">Για να κάνουμε το FlyWeb πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="3293172835368652510">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="2742103213766991703">Ανοίξτε τον σύνδεσμο σε &amp;ιδιωτικό παράθυρο FlyWeb</translation>
<translation id="1616978953472841483">Άνοιγμα συνδέσμου σε &amp;Ιδιωτικό παράθυρο FlyWeb</translation>
<translation id="2050263926423290804">{COUNT, plural,
          =0 {Μια νέα ενημέρωση για το FlyWeb είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}
          =1 {Μια νέα ενημέρωση για το FlyWeb είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
          other {Μια νέα ενημέρωση για το FlyWeb είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7488914907489544218">{COUNT, plural,
              =0 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το FlyWeb για να εφαρμόσετε αυτήν την ενημέρωση}
              =1 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το FlyWeb για να εφαρμόσετε αυτήν την ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας ζητά να επανεκκινήσετε το FlyWeb για να εφαρμόσετε αυτήν την ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7568541461974616693">{COUNT, plural,
              =0 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση}
              =1 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="4630629063306099328">Μπορείτε να διαχειρίζεστε τις αλυσίδες συγχρονισμού FlyWeb που βρίσκονται σε σύνδεση. Οι αλυσίδες συγχρονισμού FlyWeb χρησιμοποιούνται για το πρόγραμμα περιήγησης FlyWeb, το Play Store, το Gmail και άλλα. Αν θέλετε να προσθέσετε έναν λογαριασμό για κάποιον άλλο, όπως ένα μέλος οικογένειας, αντί για νέο λογαριασμό, προσθέστε ένα νέο προφίλ στο δικό σας <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Μάθετε περισσότερα<ph name="LINK_END"/></translation>
<translation id="4766381896251401675">Όταν πληκτρολογείτε κάτι στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το FlyWeb στέλνει το περιεχόμενο που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησής σας για να λαμβάνετε καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ιδιωτική λειτουργία.</translation>
<translation id="3665070894458449212">Όταν πληκτρολογείτε κάτι στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το FlyWeb στέλνει το περιεχόμενο που πληκτρολογείτε στο Google Drive για να λαμβάνετε προτάσεις στοιχείων. Αυτή η επιλογή είναι απενεργοποιημένη στην Ιδιωτική λειτουργία.</translation>
</translationbundle>
