<!DOCTYPE translationbundle>
<translationbundle lang="tr">
<translation id="130631256467250065">Yaptığınız değişiklikler cihazı yeniden başlattığınızda etkinleşecektir.</translation>
<translation id="1555506416658437797">Ödeme yöntemlerini düzenleyin.</translation>
<translation id="8359495463485001719">FlyWeb'da kilitlenmeyi raporlama özelliği yoktur.</translation>
<translation id="6338530717474923868">Güvenli bir FlyWeb sayfasını görüntülüyorsunuz</translation>
<translation id="5147169001159408844">FlyWeb, ödeme yöntemi girmeyle ilgili ayarları değiştirmeye çalışıyor.</translation>
<translation id="5702992568540613683">FlyWeb logosu</translation>
<translation id="510342522494506803">FlyWeb ödeme yöntemlerini düzenlemeye çalışıyor.</translation>
<translation id="8375862260948854624">FlyWeb, <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> açık kaynak projesi ve diğer <ph name="BEGIN_LINK_OSS"/>açık kaynak yazılımlar<ph name="END_LINK_OSS"/> ile hazırlanmıştır.</translation>
<translation id="4281953335231207224">FlyWeb menüsü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN Ayarları
          öğesine gidin ve "LAN için proxy sunucusu kullan" onay kutusunun seçimini kaldırın.</translation>
<translation id="5040124620086808431">Bu sayfa FlyWeb tarafından engellendi</translation>
<translation id="1953000035868532675">Güvenlik duvarınızın veya virüsten korunma programınızın ayarlarından,
        FlyWeb'un ağa erişmesine izin verin.</translation>
<translation id="3442058224540562441">FlyWeb menüsü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
           öğesine gidin ve yapılandırmanızın "proxy yok" veya "doğrudan" olarak ayarlandığından emin olun.</translation>
<translation id="585620188971323280">ödeme yöntemi girmeyle ilgili ayarları değiştirmeye çalışıyor.</translation>
<translation id="2681118099728446983">FlyWeb ayrıca diğer <ph name="BEGIN_LINK_OSS"/>açık kaynak yazılımlardan<ph name="END_LINK_OSS"/> yararlanılarak geliştirilmiştir.</translation>
<translation id="6888846095017247017">Değişiklikleriniz, FlyWeb tekrar başlatıldığında geçerli olacak.</translation>
<translation id="1017070759373671177">FlyWeb, <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> açık kaynak projesiyle hazırlanmıştır.</translation>
<translation id="7777112741998051633">FlyWeb menüsü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/> öğesine gidin
          ve "<ph name="NO_PREFETCH_DESCRIPTION"/>" seçeneğinin işaretini kaldırın.
          Bu işlem sorunu çözmezse performansın iyileşmesi için bu seçeneği tekrar işaretlemenizi öneririz.</translation>
<translation id="8187289872471304532">Uygulamalar &gt; Sistem Tercihleri &gt; Ağ &gt; Gelişmiş &gt; Proxy'ler
          öğesine gidin ve seçilmiş olabilecek proxy'lerin seçimini kaldırın.</translation>
<translation id="4699594416850504200">Güvenli bir FlyWeb for Testing sayfasını görüntülüyorsunuz</translation>
<translation id="6224789938625024797">FlyWeb düzgün bir şekilde kapatılmadı.</translation>
