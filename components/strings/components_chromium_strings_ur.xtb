<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ur">
<translation id="130631256467250065">اپنا آلہ اگلی بار دوبارہ شروع کرنے پر آپ کی تبدیلیاں مؤثر ہوں گی۔</translation>
<translation id="125853961893919199">‏‫FlyWeb کی تجویز: پاس ورڈز محفوظ کریں</translation>
<translation id="1589233279653618219">‏‫FlyWeb مینیو &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          پر جائیں اور یقینی بنائیں کہ آپ کی کنفیگریشن "کوئی پراکسی نہیں" یا "ڈائریکٹ" پر سیٹ ہے۔</translation>
<translation id="8359495463485001719">‏FlyWeb میں کریش رپورٹنگ دستیاب نہیں ہے۔</translation>
<translation id="6338530717474923868">‏آپ ایک محفوظ FlyWeb صفحہ دیکھ رہے ہیں</translation>
<translation id="5147169001159408844">‏ادائیگی کے طریقوں پُر کرنے کی خاطر ترتیبات میں ترمیم کرنے کے لیے FlyWeb کوشش کر رہا ہے۔</translation>
<translation id="5702992568540613683">‏FlyWeb کا لوگو</translation>
<translation id="8966580353365544289">‏‫FlyWeb کی تجویز: بہتر کردہ محفوظ براؤزنگ</translation>
<translation id="510342522494506803">‏FlyWeb ادائیگی کے طریقوں میں ترمیم کرنے کی کوشش کر رہا ہے۔</translation>
<translation id="8375862260948854624">‏FlyWeb کو ‎<ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>‎ اوپن سورس پروجیکٹ اور دیگر <ph name="BEGIN_LINK_OSS"/>اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS"/> کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="5040124620086808431">‏اس صفحے کو FlyWeb نے مسدود کر دیا ہے</translation>
<translation id="1953000035868532675">‏FlyWeb کو اپنے فائروال یا اینٹی وائرس کی
          ترتیبات میں نیٹ ورک تک رسائی حاصل کرنے کی اجازت دیں۔</translation>
<translation id="4949828774841497663">ایپلیکیشنز &gt; سسٹم کی ترتیبات &gt; نیٹ ورک پر جائیں، فعال نیٹ ورک منتخب کریں، تفصیلات... بٹن پر کلک کریں اور ممکنہ طور پر منتخب کردہ کسی بھی پراکسی کو غیر منتخب کریں۔</translation>
<translation id="7584668345330431749">‏‫FlyWeb مینیو &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          نیٹ ورک اور انٹرنیٹ &gt; پراکسی
          پر جائیں اور"خودکار طور پر ترتیبات کو منتخب کریں" کو غیر منتخب کریں۔</translation>
<translation id="3145451630329266064">‏یہ صفحات FlyWeb کے ڈویلپرز کے استعمال کے ارادے سے ہیں اور ہو سکتا ہے کہ ان کی فعال طور پر دیکھ بھال یا جانچ نہ کی جائے۔ ان کو فعال کرنے کے لیے، <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/> پر نیویگیٹ کریں، ڈیبگ صفحات کو فعال کرنے کے لیے بٹن پر کلک کریں اور پھر اس صفحہ پر دوبارہ نیویگیٹ کریں۔</translation>
<translation id="2681118099728446983">‏FlyWeb کو دوسرے <ph name="BEGIN_LINK_OSS"/>اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS"/> کے ذریعے بھی ممکن بنایا گیا ہے۔</translation>
<translation id="6888846095017247017">‏آپ کی تبدیلیاں FlyWeb کو اگلی بار آپ کے دوبارہ شروع کرنے کے وقت نافذ ہوں گی۔</translation>
<translation id="8524328905288851065">‏جوڑا بنانا جاری رکھنے کیلئے FlyWeb کو بلوٹوتھ رسائی کی ضرورت ہے۔ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">‏FlyWeb کو <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> اوپن سورس پروجیکٹ کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="7777112741998051633">‏FlyWeb مینیو &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          پر جائیں اور "<ph name="NO_PREFETCH_DESCRIPTION"/>" کو غیر منتخب کریں۔
          اگر اس سے مسئلہ حل نہیں ہوتا ہے تو ہم
          بہتر کارکردگی کیلئے یہ اختیار دوبارہ منتخب کرنے کی تجویز
          کرتے ہیں۔</translation>
<translation id="4699594416850504200">‏آپ محفوظ FlyWeb for Testing صفحہ دیکھ رہے ہیں</translation>
<translation id="6224789938625024797">‏FlyWeb صحیح سے بند نہیں ہوا۔</translation>
<translation id="3593104813552438879">‏‫FlyWeb تجویز: لینز کے ساتھ تلاش کریں</translation>
</translationbundle>