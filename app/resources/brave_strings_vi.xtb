<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1026101648481255140">Tiếp tục cài đặt</translation>
<translation id="7099479769133613710">Chạy lại để cập nhật &amp;ChromeOS</translation>
<translation id="291426170030461697">FlyWeb khuyên bạn nên xem xét tiện ích này</translation>
<translation id="1549005488226693697">Khi một trang web yêu cầu tải trước các đường liên kết trên trang ở chế độ riêng tư, FlyWeb sẽ sử dụng các máy chủ của FlyWeb. Điều này giúp ẩn danh tính của bạn khỏi trang web được tải trước, nhưng FlyWeb sẽ biết những trang web được tải trước.</translation>
<translation id="1065672644894730302">Không thể đọc tùy chọn của bạn. Một số tính năng có thể không khả dụng và các thay đổi đối với tùy chọn sẽ không được lưu.</translation>
<translation id="8908267645832965492">Cha mẹ bạn đã tắt tuỳ chọn "Quyền của các trang web, ứng dụng và tiện ích" đối với FlyWeb</translation>
<translation id="6896681084876612310">FlyWeb có thể giúp bảo vệ bạn trước các sự cố rò rỉ dữ liệu, tiện ích độc hại và những vấn đề khác</translation>
<translation id="1368460307421081773">FlyWeb muốn xuất các mật khẩu của bạn. Hãy nhập mật khẩu Windows để cho phép thực hiện việc này.</translation>
<translation id="7307912249127683931">FlyWeb là trình duyệt mặc định của bạn</translation>
<translation id="4556715463645168547">Để kiểm tra xem mật khẩu của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK"/>đăng nhập vào FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Nhấp vào trình đơn FlyWeb</translation>
<translation id="1184145431117212167">Không cài đặt được vì phiên bản Windows bạn đang sử dụng chưa được hỗ trợ.</translation>
<translation id="4380351562011537903">Giới thiệu về FlyWeb</translation>
<translation id="2593084789070248821">Để chia sẻ cửa sổ, hãy cho phép FlyWeb ghi màn hình trong phần Lựa chọn ưu tiên về hệ thống.</translation>
<translation id="1203500561924088507">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME"/>.</translation>
<translation id="4750836834956739196">Mặc dù thẻ này không hoạt động nhưng bộ nhớ đã được giải phóng để giúp FlyWeb luôn hoạt động nhanh. Bạn có thể chọn luôn loại trừ trang web này khỏi trạng thái không hoạt động.</translation>
<translation id="3190759351483708314">FlyWeb đã chặn tệp tải xuống này vì đây là tệp nguy hiểm</translation>
<translation id="5879469261638423015">Khi đăng nhập vào các dịch vụ của FlyWeb như Gmail hoặc YouTube bằng <ph name="USER_EMAIL"/>, bạn có thể tự động được đăng nhập vào FlyWeb bằng cùng một tài khoản</translation>
<translation id="1290883685122687410">Lỗi thiết lập: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Thiết lập hồ sơ FlyWeb mới</translation>
<translation id="609743863669742325">FlyWeb cần có quyền truy cập Bluetooth để tìm 
 các thiết bị Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">Cũng xoá dữ liệu khỏi FlyWeb (<ph name="URL"/>)</translation>
<translation id="4150708158890309866">Bạn đã đăng nhập vào FlyWeb!</translation>
<translation id="4713192356155907986">Nhận trợ giúp về FlyWeb for Testing</translation>
<translation id="1497802159252041924">Lỗi cài đặt: <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">Chia sẻ một thẻ FlyWeb</translation>
<translation id="8196829963313696543">FlyWeb cần có quyền sử dụng máy ảnh của bạn để tạo bản đồ 3D về các khu vực xung quanh bạn</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{Tiện ích này không còn được hỗ trợ nữa. FlyWeb khuyên bạn nên xoá tiện ích này.}other{Các tiện ích này không còn được hỗ trợ nữa. FlyWeb khuyên bạn nên xoá các tiện ích này.}}</translation>
<translation id="852852907317361085">Công cụ đảm bảo an toàn của FlyWeb</translation>
<translation id="4096742538387076253">FlyWeb cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản FlyWeb và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất, dữ liệu đó sẽ vẫn được lưu trên thiết bị này.</translation>
<translation id="481155564361715417">FlyWeb muốn xoá dữ liệu của bạn trong Trình quản lý mật khẩu. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="3961251277542681013">Xem các chế độ kiểm soát quan trọng đối với quyền riêng tư và tính bảo mật trong FlyWeb</translation>
<translation id="1640672724030957280">Đang tải xuống...</translation>
<translation id="6153580651793156880">FlyWeb sẽ gửi cho FlyWeb thông tin về hoạt động tương tác của bạn với những tính năng này để giúp cải thiện tính năng. Nhân viên đánh giá có thể đọc, xử lý và chú thích dữ liệu này.</translation>
<translation id="1722488837206509557">Thao tác này sẽ cho phép bạn chọn trong số các thiết bị có sẵn và hiển thị nội dung trên các thiết bị đó.</translation>
<translation id="2383861520542390014">Bạn có thể xem và xoá những chủ đề quan tâm mà các trang web dựa vào để hiện quảng cáo cho bạn. FlyWeb ước đoán các mối quan tâm dựa trên nhật ký duyệt web gần đây của bạn.</translation>
<translation id="5695205873161614119">FlyWeb sắp xoá dữ liệu duyệt web</translation>
<translation id="8939535770474283898">FlyWeb sẽ cố gắng nâng các hình thức chuyển hướng lên giao thức HTTPS</translation>
<translation id="7385422968404728039">FlyWeb sẽ khởi động lại sau <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Khi không có giao thức HTTPS, FlyWeb sẽ sử dụng kết nối không an toàn mà không cảnh báo bạn</translation>
<translation id="307170399141486420">Cho phép FlyWeb chạy dưới nền</translation>
<translation id="2473319786107120819">Cài đặt lại FlyWeb</translation>
<translation id="2533324957407080119">FlyWeb đang cố gắng <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="3403116471618205223">Để xoá dữ liệu duyệt web chỉ trên thiết bị này mà không xoá trong Tài khoản FlyWeb, hãy <ph name="BEGIN_LINK"/>đăng xuất khỏi FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="6434738578659849497">Các trang web có thể lưu trữ thông tin trên FlyWeb về mối quan tâm của bạn. Ví dụ: sau khi bạn truy cập một trang web bán giày chạy marathon, trang web đó có thể sẽ xác định rằng bạn quan tâm đến chạy marathon. Sau đó, nếu bạn truy cập một trang web khác để đăng ký thi chạy, thì trang web đó sẽ hiện quảng cáo giày chạy dựa trên mối quan tâm của bạn.</translation>
<translation id="4824940465467423308">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình FlyWeb của bạn. Dữ liệu FlyWeb của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME"/>. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản FlyWeb nhưng không thể liên kết dữ liệu này với tài khoản khác. Bạn có thể tùy chọn tạo cấu hình mới để giữ cho dữ liệu FlyWeb hiện có của bạn riêng biệt. <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">Bằng việc tắt tính năng này, bạn có thể đăng nhập vào các trang web của FlyWeb, chẳng hạn như Gmail mà không cần đăng nhập vào FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb không phản hồi. Chạy lại ngay bây giờ?</translation>
<translation id="4035053306113201399">ChromeOS cần được khởi động lại để áp dụng bản cập nhật.</translation>
<translation id="3750729306035486751">FlyWeb đã chặn tệp tải xuống này vì loại tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="1953553007165777902">Đang tải xuống... Còn <ph name="MINUTE"/> phút</translation>
<translation id="6956650624767954726">FlyWeb không thể xác định hoặc đặt trình duyệt mặc định</translation>
<translation id="6495079989036864983">Thao tác này sẽ xóa 1 mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào FlyWeb dưới dạng <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Không cài đặt được. Vui lòng thử lại.</translation>
<translation id="4252651275570549255">Để kiểm tra xem các mật khẩu khác của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK"/>đăng nhập vào FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">Chọn xem có bao gồm nhật ký duyệt web trên FlyWeb hay không để mang lại trải nghiệm phù hợp hơn trong các dịch vụ của FlyWeb</translation>
<translation id="8924891216494775926">FlyWeb đã chặn tệp tải xuống này vì tệp này chứa nội dung lừa đảo và có thể thực hiện các thay đổi không mong muốn đối với thiết bị của bạn</translation>
<translation id="1868972292925460871">Thông tin về cách FlyWeb quản lý các chứng chỉ gốc của FlyWeb</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau 1 phút bạn không dùng đến FlyWeb. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}other{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau # phút bạn không dùng đến FlyWeb. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}}</translation>
<translation id="2126108037660393668">Không xác minh được tệp tải xuống.</translation>
<translation id="4474394796469499134">FlyWeb đã chặn tệp tải xuống này vì trang web không sử dụng kết nối an toàn và tệp có thể đã bị can thiệp</translation>
<translation id="2482315227745493547">Bạn có thể mở dấu trang, chế độ đọc và nhiều nội dung khác từ trình đơn FlyWeb</translation>
<translation id="6765231735885996239">Tùy chỉnh FlyWeb</translation>
<translation id="2174917724755363426">Chưa cài đặt xong. Bạn có chắc chắn muốn huỷ không?</translation>
<translation id="2937508664417729967">FlyWeb – Đăng nhập vào mạng – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Lỗi khi kiểm tra bản cập nhật: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Xoá tài khoản khỏi FlyWeb</translation>
<translation id="6707114110652917144">Đây là trang web nguy hiểm. FlyWeb đã xoá quyền thông báo.</translation>
<translation id="5461117213064611992">Gần đây bạn không truy cập trang web này. FlyWeb đã xoá <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/></translation>
<translation id="2726680594710751908">Nếu bạn chia sẻ máy tính, bạn bè và gia đình có thể duyệt web một cách riêng biệt và thiết lập FlyWeb theo ý của họ.</translation>
<translation id="5067150284614317159">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong FlyWeb. Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì FlyWeb cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang.</translation>
<translation id="3002925333439341552">Khi bạn bật chế độ này, FlyWeb sẽ tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn.</translation>
<translation id="3256927121768528350">Để gửi số điện thoại từ thiết bị này đến điện thoại Android của bạn, hãy đăng nhập vào FlyWeb trên cả hai thiết bị.</translation>
<translation id="2359808026110333948">Tiếp tục</translation>
<translation id="7339360994527471629">Tiện ích "<ph name="EXTENSION_NAME"/>" muốn bạn đăng nhập vào FlyWeb</translation>
<translation id="4126251160852694747">Để sử dụng tiện ích này bằng tài khoản <ph name="USER_EMAIL_ADDRESS"/>, hãy đăng nhập vào FlyWeb.</translation>
<translation id="8418845734693287262">ChromeOS không thể đồng bộ hoá dữ liệu của bạn vì thông tin đăng nhập vào tài khoản của bạn đã lỗi thời.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích FlyWeb đã truy cập vào 1 thiết bị HID}=1{Một hoặc nhiều tiện ích FlyWeb đang truy cập vào 1 thiết bị HID}other{Một hoặc nhiều tiện ích FlyWeb đang truy cập vào # thiết bị HID}}</translation>
<translation id="1364879203203742966">FlyWeb cần có quyền truy cập máy ảnh và micrô đối với trang web này</translation>
<translation id="1968013196034892522">Với <ph name="BEGIN_LINK"/>các công cụ của FlyWeb<ph name="END_LINK"/>, bạn có thể duyệt web an toàn và luôn nắm quyền kiểm soát</translation>
<translation id="2451727308784734061">Sử dụng lối tắt để nhanh chóng truy cập vào Trình quản lý mật khẩu. Bạn có thể di chuyển lối tắt đến màn hình chính hoặc trình chạy ứng dụng của máy tính.</translation>
<translation id="3224379053610845181">FlyWeb sắp đóng</translation>
<translation id="3840682988105604367">Trong FlyWeb</translation>
<translation id="2485422356828889247">Gỡ cài đặt</translation>
<translation id="2513154137948333830">Yêu cầu khởi động lại: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="6823116595279840454">FlyWeb đang cố gắng thay thế các mật khẩu hiện tại. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="2691552788029831386">FlyWeb cần quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="2275866327478859777">Trình trợ giúp của FlyWeb</translation>
<translation id="683641781063074351">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào FlyWeb</translation>
<translation id="7717615706977383025">Quản trị viên hồ sơ công việc có thể xóa mọi dữ liệu trên FlyWeb được tạo trong quá trình sử dụng hồ sơ này (chẳng hạn như hoạt động tạo dấu trang, các trang web đã truy cập, mật khẩu và các tùy chọn cài đặt khác). <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">Tiếp tục sử dụng FlyWeb</translation>
<translation id="259935314519650377">Không thể lưu trình cài đặt đã tải xuống vào bộ nhớ đệm. Lỗi: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="6852129081045176385">FlyWeb sẽ hoạt động nhanh hơn và các tính năng sử dụng JavaScript sẽ hoạt động như dự kiến (nên chọn)</translation>
<translation id="3827993926722004004">Đã xảy ra lỗi hệ điều hành khi cài đặt. Hãy tải xuống FlyWeb lại lần nữa.</translation>
<translation id="333184635927514678">Nếu các bạn dùng chung một thiết bị, thì bạn bè và gia đình có thể duyệt web một cách riêng biệt cũng như thiết lập FlyWeb theo ý muốn</translation>
<translation id="1661841342483968180">Chào mừng <ph name="ACCOUNT_FIRST_NAME"/> đến với FlyWeb!</translation>
<translation id="1257705702166647105">Thẻ FlyWeb</translation>
<translation id="2796283369875688710">Để bảo mật hơn, FlyWeb sẽ mã hóa dữ liệu của bạn.</translation>
<translation id="1118215875395945816">Để xoá Tài khoản FlyWeb của bạn khỏi FlyWeb, hãy đăng xuất</translation>
<translation id="2738871930057338499">Không thể kết nối với Internet. HTTP 403 bị cấm. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="2770231113462710648">Thay đổi trình duyệt mặc định thành:</translation>
<translation id="7907238427168022751">Tiện ích này chứa phần mềm độc hại và không an toàn. Hãy xoá khỏi FlyWeb để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="2799223571221894425">Chạy lại</translation>
<translation id="8990114339313395142">Thao tác này sẽ tạo một hồ sơ mới trên FlyWeb cho <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="2846251086934905009">Lỗi cài đặt: Chưa hoàn tất trình cài đặt. Hoạt động cài đặt đã bị huỷ.</translation>
<translation id="1339341044496643931">Xóa khỏi FlyWeb...</translation>
<translation id="4922993584046885552">Giúp bạn an toàn trên FlyWeb và có thể dùng để cải thiện mức độ bảo mật cho bạn trong các ứng dụng khác của FlyWeb sau khi đăng nhập</translation>
<translation id="2885378588091291677">Trình quản lý tác vụ</translation>
<translation id="3806033752149316261">Giới thiệu về &amp;FlyWeb</translation>
<translation id="2915996080311180594">Khởi động lại sau</translation>
<translation id="2928420929544864228">Đã cài đặt xong.</translation>
<translation id="2945997411976714835">Lỗi cài đặt: Trình cài đặt không thể bắt đầu quá trình.</translation>
<translation id="1661079783259785361">FlyWeb đã được cập nhật</translation>
<translation id="5447533789927384736">Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì FlyWeb cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang</translation>
<translation id="1003068427103858026">FlyWeb có thể dừng hoạt động của các thẻ này để cải thiện trải nghiệm duyệt web của bạn và giải phóng tài nguyên.</translation>
<translation id="8404327407921790238">Mở <ph name="URL"/> trong một thẻ mới trên FlyWeb.</translation>
<translation id="1244955229468464260">FlyWeb không thể kiểm tra mật khẩu của bạn. Hãy thử lại sau.</translation>
<translation id="8841609317523323027">Đang thêm vào FlyWeb...</translation>
<translation id="3038232873781883849">Đang chờ cài đặt...</translation>
<translation id="4451837224464070850">Các hồ sơ khác trên FlyWeb</translation>
<translation id="7859502023458300952">Giúp cải thiện FlyWeb bằng cách gửi báo cáo sự cố và <ph name="UMA_LINK"/> tới FlyWeb</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích FlyWeb đã truy cập vào 1 thiết bị USB}=1{Một hoặc nhiều tiện ích FlyWeb đang truy cập vào 1 thiết bị USB}other{Một hoặc nhiều tiện ích FlyWeb đang truy cập vào # thiết bị USB}}</translation>
<translation id="4133194854947529871">Nhật ký duyệt web của bạn ảnh hưởng tới quảng cáo mà bạn thấy cũng như mối quan tâm được ước đoán như dưới đây. Để bảo vệ quyền riêng tư của bạn, FlyWeb tự động xoá thông tin về các mối quan tâm của bạn theo chu kỳ luân phiên mỗi tháng. Các mối quan tâm sẽ được làm mới trừ phi bạn xoá chúng.</translation>
<translation id="1407857531570256859">Trình cài đặt không thể giải nén tệp lưu trữ. Hãy tải xuống FlyWeb lại lần nữa.</translation>
<translation id="1309738977648134943">FlyWeb đang sử dụng micrô của bạn.</translation>
<translation id="2251813826843049011">Thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép FlyWeb dừng hoạt động của thẻ này.</translation>
<translation id="6274649779206195384">Chạy lại FlyWeb</translation>
<translation id="6773570808762718524">Tùy chỉnh hồ sơ mới của bạn trên FlyWeb</translation>
<translation id="2700572810650522793">Rất tiếc! FlyWeb đã gặp sự cố. Chạy lại ngay bây giờ?</translation>
<translation id="5958835776851191812">Để xoá Tài khoản FlyWeb của bạn khỏi FlyWeb, hãy vào trang Cài đặt rồi đăng xuất khỏi FlyWeb</translation>
<translation id="5449297306961970452">FlyWeb không thể đọc và ghi vào thư mục dữ liệu:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="7452618639149696924">V8 là công cụ WebAssembly và JavaScript của FlyWeb, có tác dụng cải thiện hiệu suất của trang web</translation>
<translation id="6755586344927335130">Bạn đã cài đặt FlyWeb phiên bản <ph name="PRODUCT_VERSION"/></translation>
<translation id="3286538390144397061">Khởi động lại Ngay bây giờ</translation>
<translation id="3900612994249740104">Khóa API của FlyWeb bị thiếu. Một số chức năng của FlyWeb sẽ bị tắt.</translation>
<translation id="6824575001009586492">Tiếp tục chạy các ứng dụng dưới nền khi FlyWeb bị đóng</translation>
<translation id="8400063458073122271">Trong khi chúng tôi thiết lập quyền truy cập vào tài khoản, bạn vẫn có thể sử dụng FlyWeb. Bạn có thể không truy cập được vào một số tài nguyên cho đến khi quá trình thiết lập hoàn tất.</translation>
<translation id="2595215790271940091">FlyWeb sẽ cảnh báo bạn trước khi tải trang web bằng kết nối không an toàn</translation>
<translation id="3701353923785984059">Khi đóng tất cả các cửa sổ FlyWeb, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản FlyWeb nếu bạn đã đăng nhập vào FlyWeb. Để cho phép trang web ghi nhớ bạn, hãy <ph name="SETTINGS_LINK"/>.</translation>
<translation id="5399208721646088502">Đã có một hồ sơ trên FlyWeb sử dụng tài khoản này</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">Chuyển sang hồ sơ hiện có trên FlyWeb?</translation>
<translation id="3412460710772753638">Trong Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="847273641988291714">Với các hồ sơ trên FlyWeb, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Tạo hồ sơ cho bạn bè và gia đình hoặc phân tách nội dung công việc với nội dung giải trí.</translation>
<translation id="1558345997029205345">FlyWeb sẽ thông báo cho bạn khi bạn đăng nhập bằng mật khẩu bị lộ</translation>
<translation id="956833467923764542">Thao tác này sẽ xóa <ph name="ITEMS_COUNT"/> mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào FlyWeb dưới dạng <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">Phím tắt <ph name="SHORTCUT"/> có thể giúp chuyển đổi giữa các hồ sơ trên FlyWeb</translation>
<translation id="6724485219247982027">Hãy đóng tất cả cửa sổ FlyWeb và thử lại.</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/> đã đăng nhập.  Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào FlyWeb bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="763231524941489073">Để bảo vệ quyền riêng tư của bạn, chúng tôi tự động xoá các mối quan tâm không được làm mới sau 4 tuần. Trong quá trình bạn duyệt web, các mối quan tâm có thể xuất hiện lại trong danh sách. Bạn cũng có thể xoá các mối quan tâm mà bạn không muốn FlyWeb xem xét.</translation>
<translation id="4856314253538330936">Nhật ký duyệt web của bạn, một bản ghi các trang web bạn từng truy cập bằng FlyWeb trên thiết bị này.</translation>
<translation id="3597003331831379823">Không thể chạy quy trình thiết lập bằng đặc quyền cấp cao. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="7465608402296261674">Để gửi số điện thoại từ <ph name="ORIGIN"/> đến điện thoại Android của bạn, hãy đăng nhập vào FlyWeb trên cả hai thiết bị.</translation>
<translation id="3667616615096815454">Không thể cài đặt, máy chủ không xác định được ứng dụng.</translation>
<translation id="1483758453057146021">Để chia sẻ màn hình, hãy cho phép FlyWeb ghi màn hình trong phần Lựa chọn ưu tiên về hệ thống.</translation>
<translation id="1543563097158722437">FlyWeb không thể kiểm tra mật khẩu của bạn. Hãy thử kiểm tra kết nối Internet.</translation>
<translation id="190360428475385352">Tìm hiểu thêm về chế độ cá nhân hoá quảng cáo trong FlyWeb</translation>
<translation id="6611602069520888180">Mở đường liên kết trong thẻ mới của FlyWeb</translation>
<translation id="2591356225047803326">Liên kết FlyWeb và các dịch vụ khác của FlyWeb cho mục đích cá nhân hoá và các mục đích khác</translation>
<translation id="1771882170639856394">Quản lý hồ sơ trên FlyWeb</translation>
<translation id="3782148374606932577">Tìm hiểu lý do FlyWeb chặn một số nội dung tải xuống</translation>
<translation id="4640643918757362950">FlyWeb sẽ thông báo cho bạn nếu có vấn đề cần bạn xem xét</translation>
<translation id="2179738813053854729">FlyWeb tải trước các trang mà bạn có thể sẽ truy cập để các trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="2401189691232800402">Hệ thống ChromeOS</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">Nhận trợ giúp về ChromeOS</translation>
<translation id="1864899808802540927">Lấy dữ liệu trình duyệt FlyWeb từ <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="5175060854726708547">Tùy chỉnh và kiểm soát FlyWeb. Bạn cần lưu ý - nhấp để xem thông tin chi tiết.</translation>
<translation id="606156353708638647">Nhấp vào tên của bạn để mở FlyWeb và bắt đầu duyệt web.</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> đã đăng nhập vào hồ sơ này trên FlyWeb. Để tách biệt hoạt động duyệt web của bạn, FlyWeb có thể tạo hồ sơ riêng cho bạn.</translation>
<translation id="3376157109651222096">Tài khoản của bạn do <ph name="MANAGER_NAME"/> quản lý. Quản trị viên của bạn có thể xem và chỉnh sửa hồ sơ trình duyệt FlyWeb này cũng như dữ liệu trong đó, chẳng hạn như dấu trang, lịch sử và mật khẩu.</translation>
<translation id="3941890832296813527">Lỗi cài đặt: Tên tệp của trình cài đặt không hợp lệ hoặc không được hỗ trợ.</translation>
<translation id="8536259619256229278">FlyWeb đang cố gắng sao chép mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="3849784651193576458">Tìm hiểu cách FlyWeb bảo vệ bạn</translation>
<translation id="5667414856761616811">Giới thiệu về &amp;FlyWeb for Testing</translation>
<translation id="1152920704813762236">Giới thiệu về ChromeOS</translation>
<translation id="3703994572283698466">ChromeOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS"/>phần mềm nguồn mở<ph name="END_LINK_CROS_OSS"/> bổ sung, tương tự như <ph name="BEGIN_LINK_LINUX_OSS"/>môi trường phát triển Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="504994999924593940">Giúp cải thiện FlyWeb bằng cách báo cáo <ph name="BEGIN_LINK"/>cài đặt hiện tại<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Cải thiện bảo mật quan trọng và tính năng mới có trong phiên bản mới nhất.</translation>
<translation id="4055805654398742145">Trình quản lý mật khẩu</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Tổ chức sẽ tự động đóng FlyWeb sau 1 phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}other{Tổ chức sẽ tự động đóng FlyWeb sau # phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}}</translation>
<translation id="4105099155797156500">Chuyển đến trang Giới thiệu về FlyWeb</translation>
<translation id="4148957013307229264">Đang cài đặt...</translation>
<translation id="815587935943511961">Tổ chức của bạn có thể xem và quản lý dữ liệu duyệt web, chẳng hạn như dấu trang, nhật ký và mật khẩu, trong hồ sơ công việc của bạn. Tổ chức không thể xem dữ liệu duyệt web trong hồ sơ FlyWeb cá nhân.</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> – Đăng nhập vào mạng – FlyWeb</translation>
<translation id="4007949387571083162">Khám phá các ứng dụng, trò chơi, tiện ích và chủ đề tuyệt vời cho FlyWeb.</translation>
<translation id="1595210458721188387">Ngôn ngữ này dùng để hiển thị giao diện người dùng của FlyWeb</translation>
<translation id="4222932583846282852">Đang hủy...</translation>
<translation id="4224210481850767180">Quá trình cài đặt đã bị huỷ.</translation>
<translation id="2564888740660198776">Bạn muốn liên kết dữ liệu FlyWeb của bạn với tài khoản này?</translation>
<translation id="7337819873931851298">Cảnh báo cho bạn về các trang web nguy hiểm, kể cả trang web mà FlyWeb chưa từng biết, bằng cách phân tích nhiều dữ liệu trên các trang web hơn so với chế độ bảo vệ tiêu chuẩn. Bạn có thể chọn bỏ qua cảnh báo của FlyWeb.</translation>
<translation id="8391959103619318249">Đăng xuất khỏi FlyWeb</translation>
<translation id="8514458758262040082">Nhận trợ giúp về FlyWeb</translation>
<translation id="4281844954008187215">Điều khoản dịch vụ</translation>
<translation id="3393587701694585022">Không thể cài đặt do lỗi chưa xác định. Nếu FlyWeb hiện đang chạy, hãy đóng FlyWeb và thử lại.</translation>
<translation id="4304713468139749426">Trình quản lý mật khẩu</translation>
<translation id="4334294535648607276">Quá trình tải xuống hoàn tất.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> yêu cầu bạn phải đọc và chấp nhận Điều khoản dịch vụ sau đây trước khi sử dụng thiết bị này. Những điều khoản này không mở rộng, sửa đổi hay giới hạn Điều khoản của ChromeOS.</translation>
<translation id="1376968889000878095">Bạn vẫn muốn thoát khỏi FlyWeb?</translation>
<translation id="6360389033094512399">Cho phép FlyWeb chạy trong nền</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{FlyWeb khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK"/>}other{FlyWeb khuyên bạn nên loại bỏ các tiện ích này. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK"/>.}}</translation>
<translation id="4166347503469830337">Tùy chỉnh và điều khiển FlyWeb</translation>
<translation id="4427306783828095590">Chế độ bảo vệ tăng cường giúp chặn phần mềm độc hại và hành vi lừa đảo hiệu quả hơn</translation>
<translation id="4434353761996769206">Lỗi trình cài đặt: <ph name="INSTALLER_ERROR"/></translation>
<translation id="8791209382165811772">Giới thiệu về FlyWeb for Testing</translation>
<translation id="4501471624619070934">Không cài đặt được do quyền truy cập bị giới hạn tại quốc gia này.</translation>
<translation id="3546782282376530369">Tiện ích này chưa công bố các phương thức bảo vệ quyền riêng tư, chẳng hạn như cách tiện ích thu thập và sử dụng dữ liệu. FlyWeb khuyên bạn nên xoá tiện ích này.</translation>
<translation id="834808339160590901">Chào mừng bạn đến với FlyWeb. Cửa sổ trình duyệt mới đã mở ra</translation>
<translation id="5094033276783634414">FlyWeb cần có quyền tạo bản đồ về các khu vực xung quanh và theo dõi tay bạn</translation>
<translation id="3363095592946520579">Bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS"/> trong một hồ sơ FlyWeb khác</translation>
<translation id="1304885695888649052">Đã xảy ra lỗi nên FlyWeb chưa cập nhật được. <ph name="BEGIN_LINK"/>Hãy khắc phục các vấn đề cập nhật và các bản cập nhật không thành công của FlyWeb.<ph name="END_LINK"/></translation>
<translation id="5889581962474103319">FlyWeb có thể dừng hoạt động của thẻ này để cải thiện và tăng tốc trải nghiệm duyệt web của bạn.</translation>
<translation id="7350427799239500204">Tiếp tục đăng nhập vào hồ sơ mới trên FlyWeb?</translation>
<translation id="4567424176335768812">Bạn đã đăng nhập với tên <ph name="USER_EMAIL_ADDRESS"/>. Bây giờ, bạn có thể truy cập dấu trang, lịch sử và các cài đặt khác trên tất cả những thiết bị đã đăng nhập của bạn.</translation>
<translation id="5891777644455025808">FlyWeb đã chặn tệp tải xuống này do không thể xác minh tệp (vì bạn đã tắt tính năng Duyệt web an toàn)</translation>
<translation id="4594305310729380060">Vào Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="6046424510733540251">Ứng dụng FlyWeb</translation>
<translation id="4970880042055371251">Phiên bản ChromeOS</translation>
<translation id="8084731767622512023">Để chia sẻ màn hình, hãy cho phép FlyWeb ghi màn hình trong phần System Preferences (Tuỳ chọn hệ thống)</translation>
<translation id="1936188352112244665">Gần được cập nhật! Hãy khởi chạy lại FlyWeb để hoàn tất cập nhật.</translation>
<translation id="2962574118577609024">Nếu bạn cũng chia sẻ báo cáo sử dụng của FlyWeb, thì các báo cáo đó sẽ bao gồm cả những URL bạn truy cập</translation>
<translation id="9219132550163437762">Dường như cấu hình này đang được quy trình FlyWeb khác (<ph name="PROCESS_ID"/>) trên máy tính khác (<ph name="HOST_NAME"/>) sử dụng. FlyWeb đã khóa cấu hình này để cấu hình không bị lỗi. Nếu bạn chắc chắn không có quy trình nào khác đang sử dụng cấu hình này, bạn có thể mở khóa cấu hình và chạy lại FlyWeb.</translation>
<translation id="4680828127924988555">Huỷ cài đặt</translation>
<translation id="6156840135417578237">Một số dữ liệu FlyWeb của bạn chưa được lưu vào Tài khoản FlyWeb. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này sẽ bị xoá.</translation>
<translation id="1474749355173247622">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản FlyWeb của mình trong FlyWeb. <ph name="SHORTCUT"/> có thể thay đổi chế độ cài đặt cho các dịch vụ của FlyWeb mà bạn sử dụng.</translation>
<translation id="5227023869666757348">Ai đó trước đây đã đăng nhập vào FlyWeb trên máy tính này bằng <ph name="ACCOUNT_EMAIL_LAST"/>. Vui lòng tạo người dùng FlyWeb mới để giữ riêng biệt thông tin của bạn.</translation>
<translation id="4724676981607797757">Không cài đặt được do lỗi giao thức không được hỗ trợ.</translation>
<translation id="1671154647029930623">Bạn vẫn muốn thoát khỏi FlyWeb?</translation>
<translation id="4143239505982500022">FlyWeb vừa áp dụng một bản cập nhật bảo mật đặc biệt. Vui lòng khởi động lại ngay bây giờ và chúng tôi sẽ khôi phục các thẻ của bạn.</translation>
<translation id="1347247057384060764">Bạn có thể thay đổi quyết định bất cứ lúc nào trong phần cài đặt trên FlyWeb. Chương trình dùng thử diễn ra đồng thời với cách phân phát quảng cáo hiện hành, nên bạn sẽ không thấy thay đổi ngay lập tức.</translation>
<translation id="4259200560913816786">FlyWeb không thể kiểm tra mật khẩu của bạn. Hãy thử lại sau 24 giờ hoặc <ph name="BEGIN_LINK"/>kiểm tra các mật khẩu trong Tài khoản FlyWeb của bạn<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">Dịch vụ này sử dụng cùng một trình kiểm tra chính tả dùng trong FlyWeb Tìm kiếm. Thông tin bạn nhập vào trình duyệt sẽ được gửi tới FlyWeb. Bạn luôn có thể thay đổi hành động này trong phần cài đặt.</translation>
<translation id="7460496601839821581">Dùng FlyWeb mà không cần tài khoản</translation>
<translation id="2991144524835127379">Quy tắc kết nối để FlyWeb cho phép lưu lượng truy cập mDNS.</translation>
<translation id="6208903184719035736">Chạy lại để cập nhật &amp;FlyWeb</translation>
<translation id="9083381064635607718">Để nhận các bản cập nhật FlyWeb sau này, bạn cần có macOS 11 trở lên. Máy tính này đang sử dụng macOS 10.15.</translation>
<translation id="7174589544844983914">FlyWeb đang chạy trong nền.</translation>
<translation id="9212977598552218412">Nhấp để đóng hộp thoại đăng nhập vào FlyWeb</translation>
<translation id="7792628702371319769">Khách có thể sử dụng FlyWeb mà không phải thoát khỏi bất cứ nội dung nào.</translation>
<translation id="2760069255902967585">Thêm chính bạn vào FlyWeb</translation>
<translation id="4239638419916712076">FlyWeb đang nghiên cứu các tính năng mới cho phép các trang web giữ nguyên trải nghiệm duyệt web nhưng dùng ít thông tin của bạn hơn</translation>
<translation id="4326845160190496236">Tài khoản FlyWeb cần được xác thực lại</translation>
<translation id="387444474697464273">Bạn chưa lưu mật khẩu nào. FlyWeb có thể kiểm tra các mật khẩu của bạn khi bạn lưu các mật khẩu đó.</translation>
<translation id="291933003154435191">Đăng xuất khỏi FlyWeb</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/> đã đăng nhập vào hồ sơ này trên FlyWeb. Thao tác này sẽ tạo một hồ sơ mới trên FlyWeb cho <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="8295539942024823191">Để áp dụng các mục thay đổi của bạn, hãy chạy lại FlyWeb</translation>
<translation id="5374328929709976901">Trong giai đoạn dùng thử và nếu FlyWeb ngẫu nhiên đưa bạn vào một giai đoạn dùng thử đang hoạt động, nhật ký duyệt web của bạn sẽ ảnh hưởng đến quảng cáo mà bạn thấy cũng như các mối quan tâm được ước đoán như dưới đây. Để bảo vệ quyền riêng tư của bạn, FlyWeb xoá thông tin về các mối quan tâm của bạn theo chu kỳ luân phiên mỗi tháng.</translation>
<translation id="1392114650763912227">Đăng nhập vào FlyWeb bằng <ph name="USER_EMAIL"/></translation>
<translation id="6178233095056047786">FlyWeb có một số ý kiến đề xuất về sự an toàn cần bạn xem xét</translation>
<translation id="8980390875915032396">Các hồ sơ khác trên FlyWeb</translation>
<translation id="8449603408481238073">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình FlyWeb của bạn. Dữ liệu FlyWeb của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME"/>. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản FlyWeb nhưng không thể liên kết dữ liệu này với tài khoản khác. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Mã bổ sung: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">Để sử dụng chế độ cá nhân hoá, hãy thêm FlyWeb vào mục Hoạt động trên web và ứng dụng</translation>
<translation id="1026219128963768190">Tìm hiểu lý do FlyWeb chặn một số tệp</translation>
<translation id="1284798564810038820">Đang cập nhật FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">Cho phép đăng nhập vào FlyWeb</translation>
<translation id="1827750898515917134">Xóa khỏi FlyWeb</translation>
<translation id="5020755920249060562">Đặt FlyWeb là trình duyệt mặc định của bạn</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb phiên bản beta</translation>
<translation id="5385202369020319636">FlyWeb có thể không hoạt động đúng cách do không còn được hỗ trợ trên bản phân phối Linux này</translation>
<translation id="362367838300880777">FlyWeb đã chặn tệp tải xuống này vì tệp có thể gây hại cho tài khoản cá nhân và tài khoản mạng xã hội của bạn</translation>
<translation id="5957333939864770801">FlyWeb cần quyền truy cập vào vị trí của bạn để chia sẻ thông tin vị trí với trang web này</translation>
<translation id="780999790006298623">Để bảo vệ quyền riêng tư của bạn, chúng tôi tự động xoá các mối quan tâm không được làm mới sau 4 tuần. Trong quá trình bạn duyệt web, các mối quan tâm có thể xuất hiện lại trong danh sách. Và nếu FlyWeb xác định nhầm hoặc bạn không muốn thấy một vài quảng cáo nhất định, bạn có thể xoá mối quan tâm tương ứng.</translation>
<translation id="2183749398075655200">Vui lòng đợi khi FlyWeb cài đặt các bản cập nhật hệ thống mới nhất.</translation>
<translation id="8996657165865563765">FlyWeb đang cố gắng chỉnh sửa mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="5738298079259740925">Mở tệp PDF trong FlyWeb</translation>
<translation id="6096945112863785306">{0,plural, =0{Đã có bản cập nhật FlyWeb}=1{Đã có bản cập nhật FlyWeb}other{Đã có bản cập nhật FlyWeb từ # ngày trước}}</translation>
<translation id="7698117871740446964">Luôn xoá dữ liệu trang web khỏi thiết bị của bạn khi bạn đóng FlyWeb</translation>
<translation id="5666891644992637849">Vui lòng khởi động lại FlyWeb ngay bây giờ</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Hiển thị FlyWeb bằng ngôn ngữ này</translation>
<translation id="569897634095159764">Không thể kết nối với Internet. Máy chủ proxy yêu cầu xác thực.</translation>
<translation id="3833333172002764160">Gần đây bạn không truy cập trang web này. FlyWeb đã xoá <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/></translation>
<translation id="4985665094509307744">Tuỳ chỉnh và kiểm soát FlyWeb. Đặt FlyWeb làm trình duyệt mặc định.</translation>
<translation id="5809516625706423866">Không thể kết nối với Internet. HTTP 401 không được phép. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="8331941171144629807">Chào mừng bạn đến với FlyWeb</translation>
<translation id="7581082856615467651">FlyWeb nhận thấy rằng các mục này chứa phần mềm độc hại:</translation>
<translation id="8117102597407263352">FlyWeb thường xuyên kiểm tra để đảm bảo trình duyệt của bạn có các chế độ cài đặt an toàn nhất. Chúng tôi sẽ thông báo cho bạn biết nếu có nội dung nào cần bạn xem xét.</translation>
<translation id="5895138241574237353">Khởi động lại</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> – Đăng nhập vào mạng</translation>
<translation id="5924017743176219022">Đang kết nối Internet...</translation>
<translation id="5383748137832083777">FlyWeb có thể dừng hoạt động của thẻ này để cải thiện trải nghiệm duyệt web của bạn và giải phóng tài nguyên.</translation>
<translation id="5941711191222866238">Thu nhỏ</translation>
<translation id="483902194277448471">Nếu FlyWeb ngẫu nhiên đưa bạn vào một giai đoạn dùng thử đang hoạt động, nhật ký duyệt web của bạn sẽ ảnh hưởng đến quảng cáo mà bạn thấy cũng như các mối quan tâm được ước đoán như dưới đây. Để bảo vệ quyền riêng tư của bạn, FlyWeb xoá thông tin về các mối quan tâm của bạn theo chu kỳ luân phiên mỗi tháng. Các mối quan tâm sẽ được làm mới trừ phi bạn xoá chúng.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Tổ chức sẽ tự động đóng FlyWeb sau 1 phút bạn không dùng đến.}other{Tổ chức sẽ tự động đóng FlyWeb sau # phút bạn không dùng đến.}}</translation>
<translation id="4955869506208896934">Cập nhật FlyWeb để bắt đầu đồng bộ hóa</translation>
<translation id="63409513082302419">Các trang web bạn truy cập thường ghi nhớ các mối quan tâm của bạn để cá nhân hoá trải nghiệm cho bạn. Các trang web cũng có thể lưu trữ thông tin trên FlyWeb về mối quan tâm của bạn.</translation>
<translation id="6003112304606738118">Đang tải xuống... Còn <ph name="HOURS"/> giờ.</translation>
<translation id="6888926086743577946">Bạn có thể mở dấu trang, chế độ đọc và nhiều nội dung khác từ trình đơn FlyWeb ở trên cùng bên phải</translation>
<translation id="6040143037577758943">Đóng</translation>
<translation id="619330138913595431">Để bảo vệ dữ liệu của bạn, hãy cho phép FlyWeb loại bỏ quyền khỏi các trang web mà gần đây bạn không truy cập. Bạn sẽ vẫn nhận được thông báo.</translation>
<translation id="8714139918792771260">&amp;Mở trong FlyWeb</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/> đã được thêm vào FlyWeb</translation>
<translation id="3890023823480067024">Giúp FlyWeb hoạt động nhanh hơn</translation>
<translation id="608006075545470555">Thêm Hồ sơ công việc vào trình duyệt này</translation>
<translation id="5880307616068888895">Tùy chỉnh và kiểm soát FlyWeb. Đã có bản cập nhật.</translation>
<translation id="8890528681896757647">Khi chế độ này bật, FlyWeb sẽ tiết kiệm pin bằng cách hạn chế hoạt động trong nền và hiệu ứng hình ảnh, chẳng hạn như hiệu ứng cuộn mượt và tốc độ khung hình của video.</translation>
<translation id="1429530657225981960">Bật • FlyWeb không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="1683225514126450592">Cho phép tiện ích hiện các yêu cầu truy cập trong thanh công cụ của FlyWeb</translation>
<translation id="5171527334826689262">FlyWeb sẽ lưu mật khẩu này trong Tài khoản FlyWeb của bạn. Bạn sẽ không phải nhớ mật khẩu này.</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> nguy hiểm, do đó FlyWeb đã chặn tệp.</translation>
<translation id="1773252983747911987">FlyWeb sắp đóng và xoá dữ liệu</translation>
<translation id="3063780243670578104">Tính năng Duyệt web an toàn đang tắt. Bạn nên bật tính năng này trên FlyWeb.</translation>
<translation id="1686760912855738719">Bạn có thể chuyển đổi giữa các hồ sơ trên FlyWeb tại đây</translation>
<translation id="5461795497268691356">Nếu bạn cho phép cookie thì FlyWeb có thể dùng các cookie này khi tải trước</translation>
<translation id="7031783851441272920">Tệp này có thể nguy hiểm<ph name="LINE_BREAK"/>FlyWeb có thể giúp bạn kiểm tra nội dung tải xuống này nếu bạn cung cấp mật khẩu. Thông tin về tệp sẽ được gửi tới dịch vụ Duyệt web An toàn của FlyWeb nhưng nội dung tệp và mật khẩu vẫn nằm trên thiết bị của bạn.</translation>
<translation id="6182736845697986886">Không cài đặt được do lỗi nội bộ của máy chủ cập nhật.</translation>
<translation id="4403968929742079769">Đảm bảo bạn đã đăng nhập vào FlyWeb trên <ph name="TARGET_DEVICE_NAME"/> của mình rồi thử gửi lại.</translation>
<translation id="1855179706668101462">Máy tính này đã có phiên bản FlyWeb mới hơn. Nếu phần mềm không hoạt động, hãy gỡ cài đặt FlyWeb và thử lại.</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb sẽ khởi động lại ngay bây giờ}=1{FlyWeb sẽ khởi động lại sau 1 giây}other{FlyWeb sẽ khởi động lại sau # giây}}</translation>
<translation id="2586408713760853791">FlyWeb cần có quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="1603558835003845196">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong FlyWeb</translation>
<translation id="5751080530525677552">Đặt FlyWeb làm trình duyệt mặc định</translation>
<translation id="4804111781678641302">FlyWeb không thể kiểm tra các bản cập nhật. Hãy thử kiểm tra kết nối Internet.</translation>
<translation id="3542157007113577464">Đăng xuất khỏi FlyWeb?</translation>
<translation id="2166321493116256664">Các thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép FlyWeb dừng hoạt động của các thẻ này.</translation>
<translation id="3794967601634523398">Tùy chỉnh hồ sơ FlyWeb của bạn</translation>
<translation id="6475001900959697061">Đặt tên cho hồ sơ của bạn trên FlyWeb</translation>
<translation id="6356094940346377065">Một tiện ích muốn bạn đăng nhập vào FlyWeb</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> có thể nguy hiểm, do đó FlyWeb đã chặn tệp.</translation>
<translation id="5523868569707953059">FlyWeb đang sử dụng máy ảnh của bạn.</translation>
<translation id="6327105987658262776">Hiện không có bản cập nhật nào.</translation>
<translation id="8226838065217375546">Một hoạt động khác trên FlyWeb đang diễn ra. Vui lòng thử lại sau.</translation>
<translation id="6063700568539132984">Giờ đây, việc sử dụng FlyWeb bằng tài khoản FlyWeb của bạn và trên máy tính dùng chung trở nên dễ dàng hơn.</translation>
<translation id="2451285993204064190">FlyWeb có thể dừng hoạt động của các thẻ này để cải thiện và tăng tốc trải nghiệm duyệt web của bạn.</translation>
<translation id="4709797814274745581">Lối tắt tới FlyWeb</translation>
<translation id="6595693843242836271">FlyWeb đã chặn tệp tải xuống này vì tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="6890209090736444656">Bạn có chắc chắn muốn gỡ cài đặt FlyWeb không?</translation>
<translation id="6375219077595103062">Thêm lối tắt vào Trình quản lý mật khẩu</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>Cách chúng tôi sử dụng dữ liệu này:<ph name="END_BOLD"/> FlyWeb có thể ước đoán mối quan tâm của bạn. Sau đó, trang web mà bạn truy cập có thể đề nghị FlyWeb cung cấp mối quan tâm của bạn nhằm cá nhân hoá quảng cáo mà bạn thấy.</translation>
<translation id="2104550252781001709">Biểu trưng FlyWeb trên màn hình máy tính.</translation>
<translation id="6636986997730784876">FlyWeb là trình duyệt web chạy các trang web và ứng dụng với tốc độ cực nhanh. Đây là một trình duyệt web nhanh, ổn định và dễ sử dụng. Duyệt web trở nên an toàn hơn với tính năng bảo vệ chống lại phần mềm độc hại và lừa đảo được tích hợp sẵn vào FlyWeb.</translation>
<translation id="2139300032719313227">Khởi động lại ChromeOS</translation>
<translation id="7560906925528428585">FlyWeb tải trước thêm nhiều trang mà bạn có thể sẽ truy cập để những trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="2970877059928503461">Tắt • FlyWeb không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="173462352822069427">Chào mừng bạn đến với hồ sơ trên FlyWeb</translation>
<translation id="3484308111967198595">Xoá tài khoản khỏi FlyWeb</translation>
<translation id="1474676525193357364">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động FlyWeb.</translation>
<translation id="648319183876919572">Tính năng Duyệt web an toàn có tăng cường bảo vệ hoạt động hiệu quả hơn để bảo vệ bạn khỏi các tệp đã tải xuống và trang web nguy hiểm</translation>
<translation id="5777905264835557372">Gỡ cài đặt FlyWeb</translation>
<translation id="764623543427374554">Phím tắt mở ra trong FlyWeb</translation>
<translation id="3616832517943695570">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản FlyWeb của mình trong FlyWeb. Bạn có thể thay đổi lựa chọn này bất cứ lúc nào trong phần cài đặt.</translation>
<translation id="8852057261917278552">Tổ chức của bạn sẽ đóng FlyWeb khi FlyWeb không được dùng đến trong <ph name="TIMEOUT_DURATION"/>. Dữ liệu duyệt web đã bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="8592211619057897362">Mỗi hồ sơ đều có thông tin riêng trên FlyWeb, chẳng hạn như dấu trang, các trang web đã truy cập, mật khẩu và nhiều thông tin khác</translation>
<translation id="4273595998837775033">Tìm hiểu thêm về <ph name="BEGIN_LINK"/>cách FlyWeb bảo mật dữ liệu của bạn<ph name="END_LINK"/></translation>
<translation id="7489092380688543560">Bạn có thể chuyển để xem mật khẩu trong một hồ sơ FlyWeb khác</translation>
<translation id="8243012192239086369">Để sửa lỗi chính tả, FlyWeb sẽ gửi cho FlyWeb nội dung bạn nhập vào các trường văn bản</translation>
<translation id="3927263773110604886">Chuyển đến phần cài đặt thông báo của FlyWeb</translation>
<translation id="6888846095017247017">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại FlyWeb.</translation>
<translation id="1886169834787876002">FlyWeb cần có quyền truy cập máy ảnh để tạo bản đồ 3D về các khu vực xung quanh bạn</translation>
<translation id="7640394575797555654">Các trang web có thể sẽ hoạt động như mong đợi nhưng sẽ không ghi nhớ thông tin của bạn sau khi bạn đóng tất cả cửa sổ FlyWeb</translation>
<translation id="7570986009744020649">Nếu cũng lưu dấu trang trong Tài khoản FlyWeb, bạn có thể theo dõi giá sản phẩm trong FlyWeb và nhận thông báo khi sản phẩm giảm giá</translation>
<translation id="6676384891291319759">Truy cập Internet</translation>
<translation id="1363996462118479832">ChromeOS không thể đồng bộ hoá dữ liệu của bạn do lỗi khi đăng nhập.</translation>
<translation id="4748642594935526275">FlyWeb giúp bạn có nhiều quyền kiểm soát hơn đối với những quảng cáo mà bạn thấy và hạn chế những thông tin mà các trang web có thể tìm hiểu về bạn khi cho bạn xem quảng cáo được cá nhân hoá</translation>
<translation id="4152880912192471857">FlyWeb cần có quyền truy cập micrô đối với trang web này</translation>
<translation id="6712881677154121168">Lỗi khi tải xuống: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">Không thể sử dụng cấu hình của bạn do cấu hình này đến từ một phiên bản FlyWeb mới hơn.

Một số tính năng có thể không khả dụng. Hãy chỉ định thư mục cấu hình khác hoặc sử dụng phiên bản FlyWeb mới hơn.</translation>
<translation id="5528558621229392814">Để sử dụng chế độ cá nhân hoá và các tính năng khác, hãy thêm FlyWeb vào mục Hoạt động trên web và ứng dụng cũng như các dịch vụ của FlyWeb được liên kết</translation>
<translation id="7728046102681268859">FlyWeb đã được cài đặt cho tất cả người dùng trên máy tính của bạn.</translation>
<translation id="7030752319019635064">Để truy cập vào nội dung của bạn trên FlyWeb bằng mọi thiết bị, hãy đăng nhập rồi bật tính năng đồng bộ hóa.</translation>
<translation id="199909180078651278">Gần đây bạn không truy cập trang web này. FlyWeb đã xoá <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> và <ph name="COUNT"/> quyền khác</translation>
<translation id="1292831930742306370">FlyWeb đề xuất quét tệp này vì tệp này có thể nguy hiểm.</translation>
<translation id="1547295885616600893">ChromeOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS"/>phần mềm nguồn mở<ph name="END_LINK_CROS_OSS"/> bổ sung.</translation>
<translation id="6432682256389755533">FlyWeb cho bạn biết mật khẩu của bạn có bị đánh cắp hay không</translation>
<translation id="684888714667046800">Không kết nối được với Internet. Nếu bạn sử dụng tường lửa, vui lòng đảm bảo <ph name="PRODUCT_EXE_NAME"/> có trong danh sách cho phép.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="4695676871328690599">FlyWeb nhận thấy rằng "<ph name="EXTENSION_NAME"/>" chứa phần mềm độc hại</translation>
<translation id="5929819793040985066">Trong giai đoạn thử nghiệm, tính năng Đo lường quảng cáo cho phép các trang web bạn truy cập yêu cầu FlyWeb cung cấp thông tin để đo lường hiệu quả quảng cáo. Tính năng Đo lường quảng cáo hạn chế hoạt động theo dõi qua nhiều trang web bằng cách chuyển ít thông tin nhất có thể giữa các trang web.</translation>
<translation id="8806901087257994310">Sau đó, trang web mà bạn truy cập có thể đề nghị FlyWeb cung cấp mối quan tâm của bạn nhằm cá nhân hoá quảng cáo mà bạn thấy. FlyWeb có thể chia sẻ tối đa 3 mối quan tâm.</translation>
<translation id="2553796189989827248">Mật khẩu yếu thường dễ đoán. FlyWeb có thể <ph name="BEGIN_LINK"/>tạo mật khẩu mạnh và ghi nhớ mật khẩu này cho bạn<ph name="END_LINK"/>.</translation>
<translation id="1749753408579541220">Khi bạn bật chế độ này, FlyWeb sẽ giải phóng bộ nhớ khỏi các thẻ không hoạt động. Nhờ đó, các thẻ đang hoạt động và ứng dụng khác sẽ được sử dụng nhiều tài nguyên máy tính hơn, còn FlyWeb thì hoạt động nhanh chóng. Các thẻ không hoạt động sẽ tự động hoạt động trở lại khi bạn quay lại các thẻ đó.</translation>
<translation id="3453763134178591239">Điều khoản của ChromeOS</translation>
<translation id="8545123476334328275">FlyWeb cần có quyền truy cập vào micrô của bạn cho trang web này</translation>
<translation id="7011190694940573312">Cài đặt không thành công vì phiên bản hệ điều hành này không được hỗ trợ.</translation>
<translation id="7024536598735240744">Lỗi khi giải nén: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">Đã dừng cài đặt.</translation>
<translation id="8144357648892716751">Biến FlyWeb thành trình duyệt của riêng bạn</translation>
<translation id="3945284827084409390">Cập nhật FlyWeb</translation>
<translation id="7886270027101123253">FlyWeb sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến FlyWeb.</translation>
<translation id="5695394421048248926">Tuỳ chỉnh FlyWeb for Testing</translation>
<translation id="8694083743003679818">Xoá <ph name="EXTENSION_NAME"/> khỏi FlyWeb</translation>
<translation id="6017914745388312119">Tổ chức của bạn sẽ xoá dữ liệu FlyWeb khi dữ liệu này không được dùng đến trong <ph name="TIMEOUT_DURATION"/>. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="3283953248242339756">FlyWeb cần có quyền truy cập máy ảnh đối với trang web này</translation>
<translation id="4729674580260824908">Không thể mở FlyWeb. Hãy thử lại.</translation>
<translation id="9165925035484501889">FlyWeb không thể kiểm tra mật khẩu của bạn. Hãy thử lại sau 24 giờ.</translation>
<translation id="935820624106805690">Dùng FlyWeb mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="1678436729108859736">Trình quản lý tác vụ - FlyWeb</translation>
<translation id="6135229048093148288">Mối quan tâm của bạn theo ước đoán của FlyWeb</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{FlyWeb khuyên bạn nên xoá tiện ích đó}other{FlyWeb khuyên bạn nên xoá các tiện ích đó}}</translation>
<translation id="7641415053133771502">Tính năng Đo lường quảng cáo cho phép các trang web bạn truy cập đề nghị FlyWeb cung cấp thông tin để đo lường hiệu quả quảng cáo. Tính năng Đo lường quảng cáo hạn chế hoạt động theo dõi qua nhiều trang web bằng cách chuyển ít thông tin nhất có thể giữa các trang web.</translation>
<translation id="2866611433272355726">Đang cập nhật FlyWeb</translation>
<translation id="5013690772358862887">Tệp tùy chọn của bạn bị hỏng hoặc không hợp lệ. 

FlyWeb không thể khôi phục cài đặt của bạn.</translation>
<translation id="7339898014177206373">Cửa sổ mới</translation>
<translation id="1123144153876435088">Web, dấu trang và các nội dung khác của bạn trên FlyWeb đều có ở đây.</translation>
<translation id="6760192061736180746">Quản trị viên hệ thống đã định cấu hình FlyWeb để mở <ph name="ALTERNATIVE_BROWSER_NAME"/> khi truy cập vào <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="3597072490217949295">FlyWeb đã chặn tệp tải xuống này vì tệp có thể gây hại cho tài khoản cá nhân và tài khoản mạng xã hội của bạn, bao gồm cả <ph name="USER_EMAIL"/></translation>
<translation id="5674884821459478726">Tiện ích này không còn được hỗ trợ nữa. FlyWeb khuyên bạn nên xoá tiện ích.</translation>
<translation id="3225813655660631613">Với các hồ sơ trên FlyWeb, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Nhờ vậy, việc phân tách nội dung công việc với nội dung giải trí sẽ trở nên dễ dàng hơn.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb dành cho nhà phát triển</translation>
<translation id="3787225360375979559">FlyWeb cần có quyền truy cập vào máy ảnh của bạn cho trang web này</translation>
<translation id="2431618580332826398">Để nhận các bản cập nhật FlyWeb sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 7.</translation>
<translation id="2154651873647244914">Chạy lại FlyWeb?</translation>
<translation id="3137757192868162370">Không thể cài đặt phiên bản FlyWeb giống với phiên bản hiện đang chạy. Hãy đóng FlyWeb và thử lại.</translation>
<translation id="4027434552262956425">Các trang web có thể sẽ hoạt động như dự kiến. Khi đóng tất cả các cửa sổ FlyWeb, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản FlyWeb nếu bạn đã đăng nhập vào FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb sẽ khởi động lại sau 1 phút}other{FlyWeb sẽ khởi động lại sau # phút}}</translation>
<translation id="2681961630847487657">Để chia sẻ cửa sổ, hãy cho phép FlyWeb ghi màn hình trong phần System Preferences (Tuỳ chọn hệ thống)</translation>
<translation id="5426732664223965459">FlyWeb có thể ước đoán các mối quan tâm của bạn. Sau đó, trang web mà bạn truy cập có thể đề nghị FlyWeb cung cấp mối quan tâm của bạn nhằm cá nhân hoá quảng cáo mà bạn thấy.</translation>
<translation id="7583399374488819119">Trình cài đặt <ph name="COMPANY_NAME"/></translation>
<translation id="6174417243847172547">Gần đây bạn không truy cập trang web này. FlyWeb đã xoá <ph name="PERMISSION"/></translation>
<translation id="3067364763515000789">FlyWeb đang sử dụng máy ảnh và micrô của bạn.</translation>
<translation id="1381291360713116383">FlyWeb được cải tiến hơn</translation>
<translation id="7649070708921625228">Trợ giúp</translation>
<translation id="481435825250648341">Bạn có thể tìm hiểu thêm về những tính năng này trong phần cài đặt trên FlyWeb.</translation>
<translation id="2230101319599356673">FlyWeb không phải là trình duyệt mặc định của bạn</translation>
<translation id="3243257760331619874">Đồng bộ hóa và cá nhân hóa FlyWeb trên các thiết bị của bạn</translation>
<translation id="3836891631266228927">Cập nhật FlyWeb</translation>
<translation id="1549877678317463759">Thao tác này sẽ xóa dữ liệu duyệt web của bạn khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào FlyWeb dưới dạng <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Trình cài đặt không thể tạo thư mục tạm thời. Vui lòng kiểm tra dung lượng ổ đĩa còn trống và quyền cài đặt phần mềm.</translation>
<translation id="134973275687829726">Giúp FlyWeb hoạt động nhanh hơn</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8463540467315366872">Thiết bị này đã có một hồ sơ trên FlyWeb sử dụng tài khoản này</translation>
<translation id="7845233973568007926">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại máy tính trước khi sử dụng <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8611872055947278722">FlyWeb không thể cập nhật lên phiên bản mới nhất nên bạn đang bỏ lỡ các tính năng và bản vá bảo mật mới.</translation>
<translation id="7872446069773932638">Đang tải xuống... Còn <ph name="SECONDS"/> giây</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>Cách bạn có thể quản lý dữ liệu của mình:<ph name="END_BOLD"/> Để bảo vệ quyền riêng tư của bạn, chúng tôi tự động xoá các mối quan tâm không được làm mới sau 4 tuần. Trong quá trình bạn duyệt web, các mối quan tâm có thể xuất hiện lại trong danh sách. Bạn cũng có thể xoá những mối quan tâm mà bạn không muốn FlyWeb xem xét.</translation>
<translation id="6798431672720500005">Đặt FlyWeb làm trình duyệt mặc định</translation>
<translation id="3096730275883527801">Bạn đã đăng nhập vào FlyWeb là <ph name="USER_EMAIL_ADDRESS"/>. Vui lòng sử dụng cùng tài khoản để đăng nhập lại.</translation>
<translation id="9017338699075596174">Đây là cài đặt thứ cấp của FlyWeb và không thể trở thành trình duyệt mặc định của bạn.</translation>
<translation id="5944585442866020176">Sau khi FlyWeb có quyền truy cập, các trang web sẽ có thể yêu cầu bạn cấp quyền truy cập.</translation>
<translation id="80471789339884597">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại tất cả trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8086881907087796310">Cài đặt không thành công vì máy tính của bạn không đáp ứng được các yêu cầu tối thiểu về phần cứng.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> – FlyWeb for Testing</translation>
<translation id="3263664073045388929">FlyWeb cần có quyền truy cập thông tin vị trí đối với trang web này</translation>
<translation id="5334309298019785904">ChromeOS không thể đồng bộ hoá dữ liệu của bạn vì miền của bạn không dùng được tính năng Đồng bộ hoá.</translation>
<translation id="813913629614996137">Đang khởi chạy...</translation>
<translation id="1446402395644795187">Bật chế độ bảo vệ bổ sung trong công cụ WebAssembly và JavaScript của FlyWeb</translation>
<translation id="1597323875619800374">Tệp này nguy hiểm, do đó FlyWeb đã chặn tệp.</translation>
<translation id="4749458995158778066">FlyWeb không thể xác minh nguồn gốc của tiện ích này. Tiện ích này có thể không an toàn. Hãy xoá khỏi FlyWeb để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web mà bạn truy cập nữa.</translation>
<translation id="6756872644564483342">FlyWeb sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến FlyWeb. Bạn có thể tắt dịch vụ này trong phần cài đặt bất kỳ lúc nào.</translation>
<translation id="9179486248398668702">Bạn muốn đăng nhập vào FlyWeb bằng hồ sơ mới?</translation>
<translation id="5792785787074426346">FlyWeb không thể kiểm tra mật khẩu của bạn vì bạn chưa đăng nhập</translation>
<translation id="9102959605052547519"><ph name="BEGIN_LINK"/>FlyWeb cảnh báo bạn<ph name="END_LINK"/> về các trang web và nội dung tải xuống không an toàn</translation>
<translation id="208266011144024011">Tổ chức của bạn sẽ đóng FlyWeb khi FlyWeb không được dùng đến trong <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="5565286784156841599">Đăng nhập để đồng bộ hóa và cá nhân hóa FlyWeb trên các thiết bị của bạn</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> trước đó đã sử dụng FlyWeb</translation>
<translation id="5975370349701995302">Để truy cập vào nội dung của bạn trên trình duyệt FlyWeb bằng mọi thiết bị, hãy đăng nhập rồi bật tính năng đồng bộ hóa</translation>
<translation id="7408894216012529448">Để nhận các bản cập nhật FlyWeb sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.</translation>
<translation id="5020916672477085422">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào FlyWeb. Mật khẩu này sẽ được lưu trong Tài khoản FlyWeb của bạn sau khi bạn đăng nhập.</translation>
<translation id="5417365165109189454">Sau đó, bạn cần khởi động lại FlyWeb.</translation>
<translation id="4212474799248200893">FlyWeb khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">Tiện ích này đã bị nhà phát triển huỷ phát hành và có thể không an toàn. Hãy xoá khỏi FlyWeb để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="5261590792975521002">{0,plural, =1{Khởi động lại FlyWeb trong vòng một ngày}other{Khởi động lại FlyWeb trong vòng # ngày}}</translation>
<translation id="3101564993057563365">Tệp lưu trữ trình cài đặt bị hỏng hoặc không hợp lệ. Hãy tải xuống FlyWeb lại lần nữa.</translation>
<translation id="5316851838033144902">FlyWeb yêu cầu Windows 10 trở lên.</translation>
<translation id="6760691951531758781">Không bắt buộc: Giúp cải thiện hiệu suất và các tính năng của ChromeOS bằng cách tự động gửi dữ liệu sử dụng và chẩn đoán cho FlyWeb.</translation>
<translation id="6852836260419236265">FlyWeb đã lỗi thời</translation>
<translation id="797182360653885317">FlyWeb có thể kiểm tra mật khẩu của bạn khi bạn lưu các mật khẩu đó</translation>
<translation id="8550334526674375523">Hồ sơ công việc này hoàn toàn riêng biệt với hồ sơ cá nhân của bạn.</translation>
<translation id="8555465886620020932">Lỗi dịch vụ: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8842078659829047498">FlyWeb có thể kiểm tra mật khẩu khi bạn đăng nhập bằng Tài khoản FlyWeb của mình</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="6539417028609632917"><ph name="BEGIN_BOLD"/>Cách chúng tôi sử dụng dữ liệu này:<ph name="END_BOLD"/> Các trang web có thể lưu trữ thông tin trên FlyWeb về mối quan tâm của bạn. Ví dụ: sau khi bạn truy cập một trang web bán giày chạy marathon, trang web đó có thể sẽ xác định rằng bạn quan tâm đến chạy marathon. Sau đó, nếu bạn truy cập một trang web khác để đăng ký thi chạy, thì trang web đó sẽ hiện quảng cáo giày chạy dựa trên mối quan tâm của bạn.</translation>
<translation id="7129578417724116642">Đang khởi động FlyWeb...</translation>
<translation id="781795332371306113">Không thể cài đặt do xảy ra lỗi không xác định. Hãy tải xuống FlyWeb lại lần nữa.</translation>
<translation id="5469043671012993003">Bạn không thể đặt FlyWeb for Testing làm trình duyệt mặc định.</translation>
<translation id="1514450422236300417">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động FlyWeb hoặc tìm kiếm từ Thanh địa chỉ.</translation>
<translation id="573490495087487940">Đây là FlyWeb của bạn</translation>
<translation id="2666961286257416158">Bạn muốn đăng nhập vào FlyWeb?</translation>
<translation id="878572486461146056">Lỗi cài đặt: Quản trị viên mạng của bạn đã áp dụng Chính sách nhóm ngăn chặn hoạt động cài đặt: <ph name="INSTALL_ERROR"/></translation>
<translation id="6779439179813982247">FlyWeb cần có quyền truy cập vào máy ảnh và micrô của bạn cho trang web này</translation>
<translation id="6808406663598665473">Bạn muốn đăng nhập vào FlyWeb?</translation>
<translation id="8826492472752484139">Nhấp vào "Trình quản lý mật khẩu"</translation>
<translation id="6933858244219479645">Hệ thống ChromeOS</translation>
<translation id="7354175404728814475"><ph name="BEGIN_BOLD"/>Loại dữ liệu được sử dụng:<ph name="END_BOLD"/> Nhật ký duyệt web của bạn, một bản ghi các trang web bạn từng truy cập bằng FlyWeb trên thiết bị này.</translation>
<translation id="8862326446509486874">Bạn không có quyền thích hợp để cài đặt cấp hệ thống. Thử chạy lại trình cài đặt với vai trò Quản trị viên.</translation>
<translation id="709828993049448700">Nếu vậy, vui lòng chỉnh sửa mật khẩu đã lưu trong FlyWeb để khớp với mật khẩu mới.</translation>
<translation id="4669168852412989042">FlyWeb đang cố gắng hiển thị mật khẩu. Nhập mật khẩu Windows của bạn để cho phép thực hiện việc này.</translation>
<translation id="1343885466359249904">FlyWeb có thể ước đoán các mối quan tâm của bạn dựa trên nhật ký duyệt web trong những tuần gần đây. Thông tin này được lưu trong thiết bị của bạn.</translation>
<translation id="1663379621921336006">Không thể cập nhật FlyWeb</translation>
<translation id="543915850302643692">Biểu tượng FlyWeb Enterprise</translation>
<translation id="8986207147630327271">Bạn đang thêm một hồ sơ công việc vào trình duyệt này và chỉ quản trị viên của bạn mới có quyền kiểm soát hồ sơ công việc này.</translation>
<translation id="8422308271795251425">Quản lý hồ sơ trên FlyWeb</translation>
<translation id="5804408305184682593">Đăng nhập vào FlyWeb</translation>
<translation id="2138383893834402906">FlyWeb đã chặn tệp tải xuống này vì tệp lưu trữ gồm các tệp khác có thể ẩn chứa phần mềm độc hại</translation>
<translation id="7813768067688376455">Đăng nhập vào FlyWeb khi bạn đăng nhập vào các dịch vụ khác của FlyWeb</translation>
<translation id="8692043725449223663">Đăng nhập vào FlyWeb. Nếu chỉ muốn đăng nhập vào tài khoản một lần, bạn có thể <ph name="GUEST_LINK_BEGIN"/>dùng thiết bị với tư cách khách<ph name="GUEST_LINK_END"/>.</translation>
<translation id="8323442969389928559">FlyWeb đã tự động đóng</translation>
<translation id="7626272203917389133">FlyWeb đã lỗi thời</translation>
<translation id="1789655708880997767">{0,plural, =1{FlyWeb sẽ khởi động lại sau một giờ}other{FlyWeb sẽ khởi động lại sau # giờ}}</translation>
<translation id="8970147445441095618">Để nhận các bản cập nhật FlyWeb sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.1.</translation>
<translation id="1208237657860748752">Mở đường liên kết trong thẻ mới của FlyWeb</translation>
<translation id="911206726377975832">Bạn cũng muốn xóa dữ liệu duyệt web của mình?</translation>
<translation id="1899793037348288257">Trong thời gian thử nghiệm, bạn có thể xem và xoá những chủ đề quan tâm mà các trang web dựa vào để hiện quảng cáo cho bạn. FlyWeb ước đoán các mối quan tâm của bạn dựa trên nhật ký duyệt web gần đây của bạn.</translation>
<translation id="3926534790663909774">Quản trị viên hệ thống của bạn đã định cấu hình FlyWeb để mở một trình duyệt thay thế khi truy cập vào <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="5022081608392609959">Chạy lại để cập nhật &amp;FlyWeb</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Biến FlyWeb thành trình duyệt của riêng bạn</translation>
<translation id="3410331617397516204">FlyWeb có thể không hoạt động chính xác do không được hỗ trợ trên Windows XP hoặc Windows Vista nữa</translation>
<translation id="1641772209502041092">Chứng chỉ do FlyWeb quản lý</translation>
<translation id="1127626874097952395">Ai đang sử dụng FlyWeb?</translation>
<translation id="1626113414414104077">Có được chế độ bảo mật mạnh nhất của FlyWeb</translation>
<translation id="983803489796659991">Không cài đặt được do máy chủ cập nhật không có dữ liệu băm nào cho ứng dụng.</translation>
<translation id="839475718250652248">Dùng FlyWeb mà không cần tài khoản</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="4434689349450618970">Nếu bạn chỉ muốn sử dụng tài khoản này một lần, bạn có thể sử dụng <ph name="GUEST_LINK_BEGIN"/>chế độ Khách<ph name="GUEST_LINK_END"/> trong trình duyệt FlyWeb. Nếu bạn muốn thêm tài khoản cho người khác, <ph name="LINK_BEGIN"/>thêm hồ sơ<ph name="LINK_END"/> vào <ph name="DEVICE_TYPE"/> của bạn.

Các quyền bạn đã cấp cho các trang web và ứng dụng có thể áp dụng cho tài khoản này. Bạn có thể quản lý chuỗi đồng bộ hóa FlyWeb của mình trong <ph name="SETTINGS_LINK_BEGIN"/>Cài đặt<ph name="SETTINGS_LINK_END"/>.</translation>
<translation id="2725795635123877647">Các tiện ích mở rộng, ứng dụng và chủ đề từ các nguồn không xác định có thể gây hại cho thiết bị của bạn. FlyWeb khuyên bạn chỉ nên cài đặt chúng từ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="3470813199863172076">Tiện ích mở rộng này vi phạm chính sách của Cửa hàng trực tuyến và có thể không an toàn. Xóa tiện ích này khỏi FlyWeb để tiện ích này không còn có thể nhìn thấy và thay đổi dữ liệu của bạn trên các trang web bạn truy cập, bao gồm cả thông tin cá nhân của bạn.</translation>
<translation id="5382847955032513683">Cảnh báo: FlyWeb không thể ngăn các tiện ích mở rộng ghi lại lịch sử duyệt web của bạn. Để tắt tiện ích này ở chế độ Riêng tư, hãy bỏ chọn tùy chọn này.</translation>
<translation id="543905389684998697">Để làm cho FlyWeb an toàn hơn, chúng tôi đã vô hiệu hóa một số tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="3914570680366033593">Để làm cho FlyWeb an toàn hơn, chúng tôi đã vô hiệu hóa tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="3293172835368652510">Dữ liệu duyệt web của người này sẽ bị xóa khỏi thiết bị này. Để khôi phục dữ liệu, hãy đăng nhập vào FlyWeb bằng <ph name="USER_EMAIL"/>.</translation>
<translation id="2742103213766991703">Mở liên kết trong cửa sổ ẩn danh của FlyWeb</translation>
<translation id="1616978953472841483">Mở liên kết trong cửa sổ ẩn danh của FlyWeb</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{Đã có bản cập nhật FlyWeb mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại FlyWeb.}=1{Đã có bản cập nhật FlyWeb mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại FlyWeb. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Đã có bản cập nhật FlyWeb mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại FlyWeb. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại FlyWeb để áp dụng bản cập nhật này}=1{Quản trị viên của bạn yêu cầu bạn chạy lại FlyWeb để áp dụng bản cập nhật này. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại FlyWeb để áp dụng bản cập nhật này. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại FlyWeb để áp dụng bản cập nhật}=1{Quản trị viên của bạn yêu cầu bạn chạy lại FlyWeb để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại FlyWeb để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="8560501749799359076">Làm cho các cấu hình có quyền truy cập vào lưu lượng truy cập Internet của bạn gặp khó khăn hơn trong việc xem bạn truy cập trang web nào. FlyWeb sử dụng kết nối an toàn để tra cứu địa chỉ IP của trang web trong DNS (Hệ thống tên miền).</translation>
<translation id="4630629063306099328">Bạn có thể quản lý chuỗi đồng bộ hóa FlyWeb đã đăng nhập của mình. Chuỗi đồng bộ hóa FlyWeb của bạn được sử dụng cho trình duyệt FlyWeb, Cửa hàng Play, Gmail, v.v. Nếu bạn muốn thêm tài khoản cho người khác, chẳng hạn như một thành viên trong gia đình, hãy thêm hồ sơ mới vào <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Tìm hiểu thêm<ph name="LINK_END"/></translation>
<translation id="4766381896251401675">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, FlyWeb sẽ gửi nội dung bạn nhập tới công cụ tìm kiếm mặc định của bạn để nhận các đề xuất tốt hơn. Điều này được tắt trong Riêng tư.</translation>
<translation id="3665070894458449212">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, FlyWeb sẽ gửi nội dung bạn nhập tới Google Drive để nhận đề xuất mục. Điều này được tắt trong Riêng tư.</translation>
<translation id="2832552148674305108">FlyWeb Riêng tư</translation>
<translation id="611606920944085547">Khi duyệt ở chế độ Riêng tư, FlyWeb sẽ cảnh báo bạn trước khi tải trang web bằng kết nối không an toàn</translation>
</translationbundle>