<translation id="5013690772358862887">तपाइँको प्राथमिकता फाइल दूषित वा अवैध छ।

FlyWeb ले तपाइँका सेटिङहरू पुनर्प्राप्त गर्न असक्षम छ।.</translation>
<translation id="7339898014177206373">नयाँ विन्डो</translation>
<translation id="1123144153876435088">तपाईंको वेब, बुकमार्कहरू, र अन्य FlyWeb सामान यहाँ रहन्छन्।</translation>
<translation id="6760192061736180746">तपाईंको प्रणालीका प्रशासकले <ph name="TARGET_URL_HOSTNAME"/> माथि पहुँच गर्नका लागि <ph name="ALTERNATIVE_BROWSER_NAME"/> खोल्न FlyWeb कन्फिगर गरेको छ।</translation>
<translation id="3597072490217949295">यो फाइलले <ph name="USER_EMAIL"/> लगायतका तपाईंका व्यक्तिगत तथा सामाजिक सञ्जाल खाताहरूमा हानि पुर्‍याउन सक्ने भएकाले FlyWeb ले यो फाइल डाउनलोड गर्न रोक लगाएको छ</translation>
<translation id="5674884821459478726">यो एक्स्टेन्सन अब प्रयोग गर्न मिल्दैन। बरु FlyWeb ले तपाईंलाई यो एक्स्टेन्सन हटाउन सिफारिस गर्छ।</translation>
<translation id="3225813655660631613">तपाईं FlyWeb का प्रोफाइल प्रयोग गरी FlyWeb मा भएका आफ्ना सबै कुराहरू छुट्याएर राख्न सक्नुहुन्छ। त्यसकारण तपाईं काम र मनोरञ्जनसँग सम्बन्धित कुराहरू अझ सजिलैसँग छुट्याएर राख्न सक्नुहुन्छ।</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="3787225360375979559">FlyWeb लाई यो साइटका लागि तपाईंको क्यामेरामाथि पहुँच राख्ने अनुमति चाहिन्छ</translation>
<translation id="2431618580332826398">तपाईंको कम्प्युटरमा Windows १० वा सोभन्दा नयाँ संस्करण छ भने मात्र तपाईं भविष्यमा FlyWeb का अपडेट प्राप्त गर्नुहुन्छ। यो कम्प्युटरमा Windows ७ प्रयोग भइरहेको छ।</translation>
<translation id="2154651873647244914">FlyWeb बन्द गरेर फेरि खोल्ने हो?</translation>
<translation id="3137757192868162370">हाल चलिरहेको समान FlyWeb संस्करण स्थापना गर्न सकिंदैन। कृपया Braveलाई बन्द गरि पुन: प्रयास गर्नुहोस्।</translation>
<translation id="4027434552262956425">साइटहरूले अपेक्षित रूपमा काम गर्ने छन्। तपाईंले FlyWeb का सबै विन्डो बन्द गर्नुभयो भने तपाईंलाई अधिकांश साइटहरूबाट साइन आउट गरिने छ तर तपाईं FlyWeb मा साइन इन अवस्थामा हुनुहुन्छ भने तपाईंलाई तपाईंको FlyWeb खाताबाट भने साइन आउट गरिने छैन।</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb १ मिनेटमा पुनः सुरु हुने छ}other{FlyWeb # मिनेटमा पुनः सुरु हुने छ}}</translation>
<translation id="2681961630847487657">आफ्नो विन्डो सेयर गर्न सिस्टमका प्राथमिकताहरूमा गई FlyWeb लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्</translation>
<translation id="5426732664223965459">FlyWeb ले तपाईंका रुचिहरू अनुमान ‌गर्न सक्छ। तपाईंले यसपछि खोल्ने साइटले FlyWeb सँग तपाईंलाई देखाइने विज्ञापनहरू पर्सनलाइज गर्ने प्रयोजनका लागि तपाईंका रुचिहरू हेर्ने अनुमति माग्न सक्छ।</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> इन्स्टलर</translation>
<translation id="6174417243847172547">तपाईंले हालसालै कुनै पनि साइट खोल्नुभएको छैन। FlyWeb ले <ph name="PERMISSION"/> रद्द गरेको छ</translation>
<translation id="3067364763515000789">FlyWeb ले तपइँको क्यामेरा र माइक्रोफोन प्रयोग गर्दैछ।</translation>
<translation id="1381291360713116383">FlyWeb भर्खरै झन राम्रो भयो</translation>
<translation id="7649070708921625228">मद्दत</translation>
<translation id="481435825250648341">तपाईं FlyWeb का सेटिङमा गई यी सुविधाहरूका बारेमा थप जान्न सक्नुहुन्छ।</translation>
<translation id="2230101319599356673">FlyWeb तपाईंको डिफल्ट ब्राउजर होइन</translation>
<translation id="3243257760331619874">आफ्ना यन्त्रहरूभरि FlyWeb लाई सिंक तथा वैयक्तीकृत गर्नुहोस्</translation>
<translation id="3836891631266228927">FlyWeb अपडेट</translation>
<translation id="1549877678317463759">यसले यो डिभाइसको तपाईंको ब्राउजिङ सम्बन्धी डेटा मेट्नेछ। पछि आफ्नो डेटा प्राप्त गर्न FlyWeb मा <ph name="USER_EMAIL"/> को रूपमा साइन इन गर्नुहोस्।</translation>
<translation id="7747138024166251722">स्थापनाकर्ताले एक अस्थायी डाइरेक्टरी सिर्जना गर्न सकेन। कृपया खाली डिस्क स्थान र सफ्टवेयर स्थापना गर्न अनुमति जाँच गर्नुहोस् ।</translation>
<translation id="134973275687829726">FlyWeb लाई अझ छिटो काम गर्ने बनाउनुहोस्</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8560501749799359076">तपाईंको इन्टरनेट ट्राफिक प्रयोग गर्न सक्ने मान्छेहरूलाई तपाईं कुन कुन वेबसाइटहरूमा जानुहुन्छ भन्ने कुरा हेर्न अझ कठिन बनाइदिनुहोस्। FlyWeb ले DNS (डोमेन नेम सिस्टम) मा कुनै वेबसाइटको IP एड्रेस हेर्न सुरक्षित कनेक्सन प्रयोग गर्छ।</translation>
<translation id="8463540467315366872">यस यन्त्रमा यो खाता प्रयोग गरेर FlyWeb प्रोफाइल बनाइसकिएको छ</translation>
<translation id="7845233973568007926">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो कम्प्युटर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="4766381896251401675">तपाईंले एड्रेस बार वा खोज बाकसमा टाइप गर्दा तपाईंलाई अझ राम्रा सुझावहरू देखाउन सकियोस् भन्नाका लागि FlyWeb ले तपाईंले टाइप गर्ने कुरा तपाईंको डिफल्ट सर्च इन्जिनमा पठाउँछ। इन्कोग्निटो मोडमा यो सुविधा अफ हुन्छ।</translation>
<translation id="8611872055947278722">FlyWeb लाई नवीनतम संस्करणमा अद्यावधिक गर्न सकिएन, जसका कारण तपाईं नयाँ सुविधाहरू तथा सुरक्षासम्बन्धी समाधानहरू चलाउनबाट वञ्चित भइराख्नुभएको छ।</translation>
<translation id="7872446069773932638">डाउनलोड गरिँदै छ... <ph name="SECONDS"/> सेकेन्ड बाँकी छ</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>तपाईं आफ्नो जानकारी कसरी व्यवस्थापन गर्न सक्नुहुन्छ:<ph name="END_BOLD"/> तपाईंको गोपनीयताको सुरक्षार्थ हामी ४ हप्ताभन्दा पुराना तपाईंका रुचिहरू स्वतः मेटाउँछौँ। तपाईंले विभिन्न साइटहरू ब्राउज गरिराख्ने क्रममा कुनै रुचि यो सूचीमा फेरि देखिन सक्छ। अथवा तपाईं FlyWeb ले कुनै रुचिसँग सम्बन्धित सामग्री नदेखाओस् भन्ने चाहनुहुन्छ भने तपाईं उक्त रुचि हटाउन सक्नुहुन्छ।</translation>
<translation id="6798431672720500005">FlyWeb लाई डिफल्ट ब्राउजर बनाउनुहोस्</translation>
<translation id="3096730275883527801">तपाईंलाई FlyWeb मा <ph name="USER_EMAIL_ADDRESS"/> को रूपमा साइन इन गरिएको थियो। कृपया फेरि साइन इन गर्न यही खाता प्रयोग गर्नुहोस्।</translation>
<translation id="9017338699075596174">यो FlyWeb को एउटा सहायक स्थापना हो र यसलाई तपाईँको डिफल्ट ब्राउजर बनाउन सकिँदैन।</translation>
<translation id="2725795635123877647">अज्ञात स्रोतबाट डाउनलोड गरिएका एक्स्टेन्सन, एप र थिमहरूले तपाईंको डिभाइसमा हानि पुर्‍याउन सक्छन्। FlyWeb त्यस्ता कुराहरू<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> बाट मात्र इन्स्टल गर्न सिफारिस गर्छ</translation>
<translation id="5944585442866020176">FlyWeb ले पहुँच प्राप्त गरेपछि, वेबसाइटहरू तपाईंसँग पहुँच माग्न सक्ने छन्।</translation>
<translation id="80471789339884597">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्ना सबै ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="8086881907087796310">तपाईंको कम्प्युटरले हार्डवेयरसम्बन्धी न्यूनतम मापदण्डहरू पूरा नगर्ने भएकाले इन्स्टल गर्ने प्रक्रिया पूरा हुन सकेन।</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">यो साइट चलाउन FlyWeb लाई लोकेसन प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
