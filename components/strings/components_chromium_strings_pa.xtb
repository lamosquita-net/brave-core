<!DOCTYPE translationbundle>
<translationbundle lang="pa">
<translation id="130631256467250065">ਤੁਹਾਡੀਆਂ ਤਬਦੀਲੀਆਂ ਅਗਲੀ ਵਾਰ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਨੂੰ ਮੁੜ ਚਾਲੂ ਕਰਨ 'ਤੇ ਲਾਗੂ ਹੋਣਗੀਆਂ।</translation>
<translation id="1555506416658437797">ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਦਾ ਸੰਪਾਦਨ ਕਰੋ।</translation>
<translation id="8359495463485001719">ਕ੍ਰੈਸ਼ ਰਿਪੋਰਟਿੰਗ FlyWeb ਵਿੱਚ ਉਪਲਬਧ ਨਹੀਂ ਹੈ।</translation>
<translation id="6338530717474923868">ਤੁਸੀਂ ਇੱਕ ਸੁਰੱਖਿਅਤ FlyWeb ਪੰਨਾ  ਦੇਖ  ਰਹੇ ਹੋ</translation>
<translation id="5147169001159408844">ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਨੂੰ ਭਰਨ ਲਈ FlyWeb ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੋਧ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਿਹਾ ਹੈ।</translation>
<translation id="5702992568540613683">FlyWeb ਲੋਗੋ</translation>
<translation id="510342522494506803">FlyWeb ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਦਾ ਸੰਪਾਦਨ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਿਹਾ ਹੈ।</translation>
<translation id="8375862260948854624">FlyWeb ਨੂੰ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਪ੍ਰੋਜੈਕਟ ਅਤੇ ਹੋਰ <ph name="BEGIN_LINK_OSS"/>ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਸਾਫ਼ਟਵੇਅਰ<ph name="END_LINK_OSS"/> ਵੱਲੋਂ ਸੰਭਵ ਬਣਾਇਆ ਗਿਆ ਹੈ।</translation>
<translation id="4281953335231207224">FlyWeb ਮੀਨੂ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN ਸੈਟਿੰਗਾਂ ਤੇ ਜਾਓ
          ਅਤੇ "ਆਪਣੇ LAN ਚੈੱਕ-ਬਾਕਸ ਲਈ ਇੱਕ ਪ੍ਰੌਕਸੀ ਸਰਵਰ ਵਰਤੋ" ਨੂੰ ਅਣ-ਚੁਣਿਆ ਕਰੋ।</translation>
<translation id="5040124620086808431">ਇਸ ਪੰਨੇ ਨੂੰ FlyWeb ਵੱਲੋਂ ਬਲਾਕ ਕੀਤਾ ਗਿਆ ਹੈ</translation>
<translation id="1953000035868532675">FlyWeb ਨੂੰ ਆਪਣੀਆਂ ਫ਼ਾਇਰਵਾਲ ਜਾਂ ਐਂਟੀਵਾਇਰਸ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਨੈੱਟਵਰਕ ਤੱਕ ਪਹੁੰਚ ਕਰਨ ਦਿਓ।</translation>
<translation id="3442058224540562441">FlyWeb ਮੀਨੂ&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/> ਤੇ ਜਾਓ 
          ਅਤੇ ਯਕੀਨੀ ਬਣਾਓ ਕਿ ਤੁਹਾਡੀ ਕੌਂਫਿਗਰੇਸ਼ਨ "ਕੋਈ ਪ੍ਰੌਕਸੀ ਨਹੀਂ" ਜਾਂ "ਡਾਇਰੈਕਟ" ਤੇ ਸੈਟ ਹੈ।</translation>
<translation id="585620188971323280">ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਨੂੰ ਭਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੋਧ ਕਰੋ।</translation>
<translation id="2681118099728446983">FlyWeb ਨੂੰ ਹੋਰ <ph name="BEGIN_LINK_OSS"/>ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਸਾਫ਼ਟਵੇਅਰ<ph name="END_LINK_OSS"/> ਦੀ ਮਦਦ ਨਾਲ ਵੀ ਸੰਭਵ ਬਣਾਇਆ ਗਿਆ ਹੈ।</translation>
<translation id="6888846095017247017">ਤੁਹਾਡੀਆਂ ਤਬਦੀਲੀਆਂ ਅਗਲੀ ਵਾਰ ਤੁਹਾਡੇ ਵੱਲੋਂ FlyWeb ਨੂੰ ਰੀਲੌਂਚ ਕਰਨ 'ਤੇ ਲਾਗੂ ਹੋਣਗੀਆਂ।</translation>
<translation id="1017070759373671177">FlyWeb ਨੂੰ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਪ੍ਰੋਜੈਕਟ ਦੀ ਮਦਦ ਨਾਲ ਸੰਭਵ ਬਣਾਇਆ ਗਿਆ ਹੈ।</translation>
<translation id="7777112741998051633">FlyWeb ਮੀਨੂ&gt; ਤੇ ਜਾਓ
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          ਅਤੇ "<ph name="NO_PREFETCH_DESCRIPTION"/>" ਨੂੰ ਅਚੋਣਵਾਂ ਕਰੋ।
          ਜੇਕਰ ਇਸ ਨਾਲ ਸਮੱਸਿਆ ਹੱਲ ਨਹੀਂ ਹੁੰਦੀ , ਤਾਂ ਅਸੀਂ ਬਿਹਤਰ ਪ੍ਰਦਰਸ਼ਨ ਲਈ ਇਸ ਚੋਣ ਨੂੰ ਦੁਬਾਰਾ
          ਚੁਣਨ ਦੀ ਸਲਾਹ ਦਿੰਦੇ ਹਾਂ।</translation>
<translation id="8187289872471304532">ਐਪਲੀਕੇਸ਼ਨਾਂ&gt; ਸਿਸਟਮ ਤਰਜੀਹਾਂ &gt; ਨੈੱਟਵਰਕ &gt; ਉੱਨਤ &gt; ਪ੍ਰੌਕਸੀਆਂ 'ਤੇ ਜਾਓ ਅਤੇ ਕਿਸੇ ਵੀ ਉਹਨਾਂ 
          ਪ੍ਰੌਕਸੀਆਂ ਨੂੰ ਅਚੋਣਵਾਂ ਕਰੋ ਜੋ ਚੁਣੀਆਂ ਗਈਆਂ ਹਨ।</translation>
<translation id="4699594416850504200">ਤੁਸੀਂ ਇੱਕ ਸੁਰੱਖਿਅਤ FlyWeb for Testing ਪੰਨਾ ਦੇਖ ਰਹੇ ਹੋ</translation>
<translation id="6224789938625024797">FlyWeb ਸਹੀ ਢੰਗ ਨਾਲ ਬੰਦ ਨਹੀਂ ਹੋਇਆ।</translation>
</translationbundle>