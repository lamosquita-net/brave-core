<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="130631256467250065">تسري التغييرات في المرة التالية التي تعيد فيها تشغيل الجهاز.</translation>
<translation id="125853961893919199">‏نصيحة من FlyWeb: حفظ كلمات المرور أولوية</translation>
<translation id="1589233279653618219">‏يُرجى الانتقال إلى
          قائمة FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          والتأكّد من ضبط الإعدادات على "بلا خادم وكيل" أو "مباشر.".</translation>
<translation id="8359495463485001719">‏تقارير الأعطال غير متاحة في FlyWeb.</translation>
<translation id="6338530717474923868">‏أنت تعرض صفحة FlyWeb آمنة</translation>
<translation id="5147169001159408844">‏يحاول FlyWeb تعديل إعدادات ميزة "الملء التلقائي" لبيانات طُرق الدفع.</translation>
<translation id="5702992568540613683">‏شعار FlyWeb</translation>
<translation id="8966580353365544289">‏نصيحة من FlyWeb: حان وقت "الحماية المحسّنة للتصفّح الآمن"</translation>
<translation id="510342522494506803">‏يحاول FlyWeb تعديل طُرق الدفع.</translation>
<translation id="8375862260948854624">‏أصبح FlyWeb الآن متاحًا بفضل المشروع المفتوح المصدر <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> و<ph name="BEGIN_LINK_OSS"/>برامج أخرى مفتوحة المصدر<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">‏تم حظر هذه الصفحة بواسطة متصفّح FlyWeb.</translation>
<translation id="1953000035868532675">‏اسمح لـ FlyWeb بالدخول إلى الشبكة من خلال إعدادات جدار الحماية أو
        برنامج مكافحة الفيروسات.</translation>
<translation id="4949828774841497663">‏يُرجى الانتقال إلى "التطبيقات" (Applications) &gt; "إعدادات النظام" (System Settings) &gt; "الشبكة" (Network)، ثم اختيار
          الشبكة النشطة، والنقر على زر "التفاصيل…" (Details…‎) وإلغاء اختيار أي خوادم وكيلة
          سبق اختيارها.</translation>
<translation id="7584668345330431749">‏يُرجى الانتقال إلى
          قائمة FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          الشبكة والإنترنت &gt; الخادم الوكيل
          وإلغاء اختيار "رصد الإعدادات تلقائيًا".</translation>
<translation id="3145451630329266064">‏هذه الصفحات مخصّصة لمطوّري FlyWeb، وقد لا تتم صيانتها أو اختبارها بشكلٍ منتظم. لتفعيلها، يُرجى الانتقال إلى <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/> والنقر على زر تفعيل صفحات تصحيح الأخطاء، ثم الانتقال إلى هذه الصفحة مرة أخرى.</translation>
<translation id="2681118099728446983">‏أصبح FlyWeb متاحًا من خلال <ph name="BEGIN_LINK_OSS"/>برنامج آخر مفتوح المصدر<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل FlyWeb.</translation>
<translation id="8524328905288851065">‏يجب منح FlyWeb الإذن بالوصول إلى البلوتوث لمواصلة عملية 
الإقران. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">‏أصبح FlyWeb متاحًا من خلال مشروع <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> المفتوح المصدر.</translation>
<translation id="7777112741998051633">‏انتقل إلى
        قائمة FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        وألغ اختيار "<ph name="NO_PREFETCH_DESCRIPTION"/>"
        في حالة ما إذا لم يؤد ذلك إلى حل المشكلة، نوصي بتحديد هذا الخيار
        مرة أخرى من أجل أداء أفضل.</translation>
<translation id="4699594416850504200">‏أنت تعرض صفحة FlyWeb for Testing آمنة.</translation>
<translation id="6224789938625024797">‏لم يغلق FlyWeb بشكل صحيح.</translation>
<translation id="3593104813552438879">‏نصيحة من FlyWeb: البحث باستخدام "عدسة FlyWeb"</translation>
</translationbundle>