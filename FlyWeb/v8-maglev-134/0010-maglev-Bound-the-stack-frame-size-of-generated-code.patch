From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 09:23:38 +0000
Subject: [PATCH 10/20] [maglev] Bound the stack frame size of generated code

Port of v8 d6a92ca485 (M144 0313bc720f; crbugs 536945254, 539805182), with its mjsunit test. Both bail-outs live in MaglevCompiler::Compile, whose failure 13.3 already handles, so compiler.cc and the dispatcher are not changed (the function is not marked as not optimizable). FlyWeb Maglev debt for level 134.

(cherry picked from commit 76aa0cb8dd15e76415025ce9abde8f3c75120fa9)
(cherry picked from commit 1efec56b4b97d1b6a5625c2509f7ed88ce3b7ab7)
---
 src/maglev/maglev-compiler.cc            | 16 +++++-
 test/mjsunit/maglev/regress-536945254.js | 62 ++++++++++++++++++++++++
 2 files changed, 77 insertions(+), 1 deletion(-)
 create mode 100644 test/mjsunit/maglev/regress-536945254.js

diff --git a/src/maglev/maglev-compiler.cc b/src/maglev/maglev-compiler.cc
index 3d6c5b13..a6195985 100644
--- a/src/maglev/maglev-compiler.cc
+++ b/src/maglev/maglev-compiler.cc
@@ -55,6 +55,8 @@ namespace v8 {
 namespace internal {
 namespace maglev {
 
+constexpr uint32_t kMaxStackSlots = 4 * KB / kSystemPointerSize;
+
 // static
 bool MaglevCompiler::Compile(LocalIsolate* local_isolate,
                              MaglevCompilationInfo* compilation_info) {
@@ -108,11 +110,14 @@ bool MaglevCompiler::Compile(LocalIsolate* local_isolate,
     //   a bytecode shorter than kMaxInputs / 2 cannot get there (TurboFan stops
     //   at 60 KB anyway). Inlined functions are far below that.
     {
+      // Like TurboFan, also bail out on max_optimized_bytecode_size (v8
+      // d6a92ca485, crbug 536945254).
       MaglevCompilationUnit* unit = compilation_info->toplevel_compilation_unit();
       if (unit->parameter_count() + unit->register_count() +
                   GeneratorStore::kFixedInputCount >
               Node::kMaxInputs ||
-          unit->bytecode().length() >= Node::kMaxInputs / 2) {
+          unit->bytecode().length() >= Node::kMaxInputs / 2 ||
+          unit->bytecode().length() > v8_flags.max_optimized_bytecode_size) {
         return false;
       }
     }
@@ -227,6 +232,15 @@ bool MaglevCompiler::Compile(LocalIsolate* local_isolate,
     }
   }
 
+  // The prologue grows the frame with a single stack pointer decrement, before
+  // FunctionEntryStackCheck runs. A frame no larger than the smallest OS page
+  // cannot step over a guard page, so bail out rather than emit an unchecked
+  // stack pointer jump of arbitrary size (FlyWeb: port of v8 d6a92ca485).
+  if (graph->tagged_stack_slots() + graph->untagged_stack_slots() >
+      kMaxStackSlots) {
+    return false;
+  }
+
   {
     TRACE_EVENT0(TRACE_DISABLED_BY_DEFAULT("v8.compile"),
                  "V8.Maglev.CodeAssembly");
diff --git a/test/mjsunit/maglev/regress-536945254.js b/test/mjsunit/maglev/regress-536945254.js
new file mode 100644
index 00000000..522bcfd8
--- /dev/null
+++ b/test/mjsunit/maglev/regress-536945254.js
@@ -0,0 +1,62 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax --maglev --no-turbofan
+
+// Keeps `count` Int32 and Float64 values live at once, so Maglev needs roughly
+// two stack slots per value while the bytecode stays small.
+function buildWideFrame(count, osr) {
+  let preload = '';
+  let integerFold = '';
+  let doubleFold = '';
+  for (let i = 0; i < count; ++i) {
+    preload += `0.5 + (input ^ ${i});`;
+    integerFold += `integer ^= (input ^ ${i});`;
+    doubleFold += `double += (input ^ ${i});`;
+  }
+  return Function(`
+    return function wide(input) {
+      input |= 0;
+      let result = 0;
+      for (let iteration = 0; iteration < 20; ++iteration) {
+        ${osr ? 'if (iteration === 5) %OptimizeOsr();' : ''}
+        ${preload}
+        let integer = 0;
+        ${integerFold}
+        let double = 0.5;
+        ${doubleFold}
+        result = (integer + double) | 0;
+      }
+      return result;
+    };
+  `)();
+}
+
+// ~750 stack slots, ~16KB of bytecode.
+const kWideValueCount = 400;
+
+const wide = buildWideFrame(kWideValueCount, false);
+%PrepareFunctionForOptimization(wide);
+const expected = wide(1);
+%OptimizeMaglevOnNextCall(wide);
+assertEquals(expected, wide(1));
+assertFalse(isOptimized(wide));
+
+const wideOsr = buildWideFrame(kWideValueCount, true);
+%PrepareFunctionForOptimization(wideOsr);
+assertEquals(expected, wideOsr(1));
+
+// One live value, but more bytecode than Maglev is willing to compile.
+function buildLongBytecode(count) {
+  let body = '';
+  for (let i = 0; i < count; ++i) body += `sum += ${i};`;
+  return Function(`return function long(sum) { ${body} return sum; };`)();
+}
+
+const long = buildLongBytecode(12000);
+%PrepareFunctionForOptimization(long);
+const expectedLong = long(0);
+%OptimizeMaglevOnNextCall(long);
+assertEquals(expectedLong, long(0));
+assertFalse(isOptimized(long));
