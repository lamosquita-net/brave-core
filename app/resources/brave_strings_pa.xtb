<translation id="5651107152880556886">ਆਪਣੇ FlyWeb ਖਾਤੇ ਵਿੱਚ FlyWeb ਡਾਟੇ ਨੂੰ ਵਰਤਣ ਅਤੇ ਰੱਖਿਅਤ ਕਰਨ ਲਈ, ਆਪਣਾ ਪਾਸਫਰੇਜ਼ ਦਾਖਲ ਕਰੋ</translation>
<translation id="4493028449971051158">ਸਟਾਰਟ-ਅੱਪ ਸੰਬੰਧੀ ਗੜਬੜ: ਕਿਰਪਾ ਕਰਕੇ ਸਥਾਪਨਾਕਾਰ ਨੂੰ ਪ੍ਰਸ਼ਾਸਕ ਵਜੋਂ ਚਲਾਓ।</translation>
<translation id="4501471624619070934">ਇਸ ਦੇਸ਼ ਵਿੱਚ ਪਹੁੰਚ ਪ੍ਰਤਿਬੰਧਿਤ ਹੋਣ ਕਾਰਨ ਸਥਾਪਤ ਕਰਨਾ ਅਸਫਲ ਰਿਹਾ।</translation>
<translation id="3546782282376530369">ਇਸ ਐਕਸਟੈਂਸ਼ਨ ਨੇ ਇਸ ਵੱਲੋਂ ਡਾਟੇ ਨੂੰ ਇਕੱਤਰ ਕਰਨ ਅਤੇ ਉਸਦੀ ਵਰਤੋਂ ਦੇ ਤਰੀਕੇ ਵਰਗੇ ਪਰਦੇਦਾਰੀ ਵਿਹਾਰਾਂ ਨੂੰ ਪ੍ਰਕਾਸ਼ਿਤ ਨਹੀਂ ਕੀਤਾ ਹੈ। FlyWeb ਸਿਫ਼ਾਰਸ਼ ਕਰਦਾ ਹੈ ਕਿ ਤੁਸੀਂ ਇਸਨੂੰ ਹਟਾ ਦਿਓ।</translation>
<translation id="834808339160590901">FlyWeb ਵਿੱਚ ਜੀ ਆਇਆਂ ਨੂੰ; ਨਵੀਂ ਬ੍ਰਾਊਜ਼ਰ ਵਿੰਡੋ ਖੋਲ੍ਹੀ ਗਈ</translation>
<translation id="5094033276783634414">FlyWeb ਨੂੰ ਤੁਹਾਡੇ ਆਲੇ-ਦੁਆਲੇ ਦਾ ਨਕਸ਼ਾ ਬਣਾਉਣ ਅਤੇ ਤੁਹਾਡੇ ਹੱਥਾਂ ਨੂੰ ਟਰੈਕ ਕਰਨ ਲਈ ਇਜਾਜ਼ਤ ਦੀ ਲੋੜ ਹੈ</translation>
<translation id="3363095592946520579">ਤੁਸੀਂ ਪਹਿਲਾਂ ਹੀ ਕਿਸੇ ਹੋਰ FlyWeb ਪ੍ਰੋਫਾਈਲ ਵਿੱਚ <ph name="USER_EMAIL_ADDRESS"/> ਵਜੋਂ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਹੋਇਆ ਹੈ</translation>
<translation id="8767255662414713095">FlyWeb ਉਨ੍ਹਾਂ ਪੰਨਿਆਂ ਨੂੰ ਪ੍ਰੀਲੋਡ ਕਰਦਾ ਹੈ ਜੋ ਬ੍ਰਾਊਜ਼ ਅਤੇ ਖੋਜ ਕਰਨ ਵਿੱਚ ਤੇਜ਼ੀ ਲਿਆਉਂਦੇ ਹਨ। <ph name="BEGIN_LINK"/>ਪ੍ਰੀਲੋਡ ਪੰਨਿਆਂ ਬਾਰੇ ਹੋਰ ਜਾਣੋ<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">ਜਦੋਂ ਤੁਸੀਂ ਕਿਸੇ ਅਜਿਹੀ ਸਾਈਟ ਦੀ ਰਿਪੋਰਟ ਕਰਦੇ ਹੋ, ਜਿਸ ਬਾਰੇ ਤੁਹਾਨੂੰ ਲੱਗਦਾ ਹੈ ਕਿ ਇਹ ਨੁਕਸਾਨਦੇਹ ਹੈ, ਤਾਂ ਤੁਸੀਂ ਹਰੇਕ ਲਈ ਆਨਲਾਈਨ ਸੁਰੱਖਿਆ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਂਦੇ ਹੋ।</translation>
<translation id="5891777644455025808">FlyWeb ਨੇ ਇਸ ਡਾਊਨਲੋਡ ਨੂੰ ਬਲਾਕ ਕਰ ਦਿੱਤਾ ਹੈ ਕਿਉਂਕਿ ਤੁਸੀਂ ਸੁਰੱਖਿਅਤ ਬ੍ਰਾਊਜ਼ਿੰਗ ਨੂੰ ਬੰਦ ਕਰ ਦਿੱਤਾ ਹੈ ਅਤੇ ਫ਼ਾਈਲ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ</translation>
<translation id="8775108347138515815">ਆਪਣੇ ਫ਼ੋਨ 'ਤੇ FlyWeb ਨਾਲ Google Lens ਅਜ਼ਮਾਓ</translation>
<translation id="4594305310729380060">ਇਸ ਡੀਵਾਈਸ 'ਤੇ Password Manager 'ਤੇ</translation>
<translation id="3349475100979552835">FlyWeb ਐਪਸ</translation>
<translation id="4598116752460667024">ਸੂਚੀ ਵਿੱਚੋਂ ਕੋਈ ਵੀ ਪ੍ਰਕਿਰਿਆ ਖੋਜੋ।</translation>
<translation id="4970880042055371251">ChromeOS ਵਰਜਨ</translation>
<translation id="1936188352112244665">ਲਗਭਗ ਅੱਪ ਟੂ ਡੇਟ! ਅੱਪਡੇਟ ਕਰਨਾ ਪੂਰਾ ਕਰਨ ਲਈ FlyWeb ਨੂੰ ਦੁਬਾਰਾ ਲਾਂਚ ਕਰੋ।</translation>
<translation id="7657326395720709145">ਇਸ ਨਾਲ FlyWeb ਦੇ V8 ਇੰਜਣ ਨਾਲ ਸਾਈਟਾਂ ਦੀ ਗਤੀ ਵਧ ਜਾਂਦੀ ਹੈ, ਪਰ FlyWeb 'ਤੇ ਅਟੈਕਾਂ ਤੋਂ ਸੁਰੱਖਿਆ ਘਟ ਜਾਂਦੀ ਹੈ</translation>
<translation id="7966026667528388481">FlyWeb ਨਾਲ ਖੋਜ ਨੂੰ ਖੋਲ੍ਹੋ</translation>
<translation id="7949810958067850297">FlyWeb ਪ੍ਰੋਫਾਈਲ</translation>
<translation id="2962574118577609024">ਜੇ ਤੁਸੀਂ FlyWeb ਵਰਤੋਂ ਸੰਬੰਧੀ ਰਿਪੋਰਟਾਂ ਨੂੰ ਵੀ ਸਾਂਝਾ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਨ੍ਹਾਂ ਰਿਪੋਰਟਾਂ ਵਿੱਚ ਤੁਹਾਡੇ ਵੱਲੋਂ ਖੋਲ੍ਹੇ ਜਾਣ ਵਾਲੇ URL ਵੀ ਸ਼ਾਮਲ ਹੁੰਦੇ ਹਨ</translation>
<translation id="4673710618874938871"><ph name="USER_NAME"/> ਵਜੋਂ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਗਿਆ, ਮੈਂਬਰਸ਼ਿਪ। ਖਾਤਾ ਮੀਨੂ ਖੋਲ੍ਹੋ</translation>
<translation id="9219132550163437762">ਇੰਜ ਜਾਪਦਾ ਹੈ ਕਿ ਪ੍ਰੋਫਾਈਲ ਨੂੰ ਕਿਸੇ ਹੋਰ ਕੰਪਿਊਟਰ <ph name="HOST_NAME"/> 'ਤੇ ਦੂਜੀ FlyWeb ਪ੍ਰਕਿਰਿਆ (<ph name="PROCESS_ID"/>) ਵਿੱਚ ਵਰਤਿਆ ਜਾ ਰਿਹਾ ਹੈ। FlyWeb ਨੇ ਪ੍ਰੋਫਾਈਲ ਲਾਕ ਕਰ ਦਿੱਤੀ ਹੈ ਤਾਂ ਜੋ ਇਹ ਖਰਾਬ ਹੋਣ ਤੋਂ ਬੱਚ ਸਕੇ। ਜੇਕਰ ਤੁਹਾਨੂੰ ਪੱਕਾ ਪਤਾ ਹੈ ਕਿ ਕੋਈ ਹੋਰ ਪ੍ਰਕਿਰਿਆਵਾਂ ਇਹ ਪ੍ਰੋਫਾਈਲ ਨਹੀਂ ਵਰਤ ਰਹੀਆਂ, ਤਾਂ ਤੁਸੀਂ ਪ੍ਰੋਫਾਈਲ ਨੂੰ ਅਣਲਾਕ ਕਰ ਸਕਦੇ ਹੋ ਅਤੇ FlyWeb ਨੂੰ ਮੁੜ-ਲਾਂਚ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="4680828127924988555">ਸਥਾਪਨਾ ਰੱਦ ਕਰੋ</translation>
<translation id="6156840135417578237">ਤੁਹਾਡੇ ਕੁਝ FlyWeb ਡਾਟੇ ਨੂੰ ਹਾਲੇ ਤੁਹਾਡੇ FlyWeb ਖਾਤੇ ਵਿੱਚ ਰੱਖਿਅਤ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ। ਸਾਈਨ-ਆਊਟ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ, ਕੁਝ ਮਿੰਟਾਂ ਲਈ ਉਡੀਕ ਕਰ ਕੇ ਦੇਖੋ। ਜੇ ਤੁਸੀਂ ਹੁਣੇ ਸਾਈਨ-ਆਊਟ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਸ ਡਾਟੇ ਨੂੰ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="1474749355173247622">ਜਦੋਂ ਤੁਸੀਂ ਸਾਈਨ-ਇਨ ਹੁੰਦੇ ਹੋ, ਤਾਂ ਤੁਸੀਂ FlyWeb ਵਿੱਚ ਆਪਣੇ FlyWeb ਖਾਤੇ ਤੋਂ ਆਪਣੇ ਪਾਸਵਰਡ ਅਤੇ ਹੋਰ ਬਹੁਤ ਕੁਝ ਦੀ ਵਰਤੋਂ ਕਰ ਸਕਦੇ ਹੋ। <ph name="SHORTCUT"/> ਨਾਲ ਕਿਸੇ ਵੀ ਵੇਲੇ ਤੁਹਾਡੀਆਂ FlyWeb ਸੇਵਾਵਾਂ ਸੰਬੰਧੀ ਸੈਟਿੰਗਾਂ ਨੂੰ ਬਦਲਿਆ ਜਾ ਸਕਦਾ ਹੈ।</translation>
<translation id="5227023869666757348">ਕਿਸੇ ਵਿਅਕਤੀ ਨੇ ਪਹਿਲਾਂ ਹੀ <ph name="ACCOUNT_EMAIL_LAST"/> ਵਜੋਂ ਇਸ ਕੰਪਿਊਟਰ 'ਤੇ FlyWeb 'ਤੇ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਹੋਇਆ ਹੈ। ਆਪਣੀ ਜਾਣਕਾਰੀ ਵੱਖਰੀ ਰੱਖਣ ਲਈ ਕਿਰਪਾ ਕਰਕੇ ਇੱਕ ਨਵਾਂ FlyWeb ਵਰਤੋਂਕਾਰ ਬਣਾਓ।</translation>
<translation id="4724676981607797757">ਅਸਮਰਥਿਤ ਪ੍ਰੋਟੋਕੋਲ ਕਾਰਨ ਸਥਾਪਤ ਕਰਨਾ ਅਸਫਲ ਰਿਹਾ।</translation>
<translation id="1671154647029930623">ਕੀ ਫਿਰ ਵੀ FlyWeb ਨੂੰ ਛੱਡਣਾ ਹੈ?</translation>
<translation id="4143239505982500022">FlyWeb ਲਈ ਇੱਕ ਖਾਸ ਸੁਰੱਖਿਆ ਅੱਪਡੇਟ ਹੁਣੇ ਲਾਗੂ ਕੀਤਾ ਗਿਆ ਸੀ। ਹੁਣੇ ਇਸਨੂੰ ਮੁੜ-ਸ਼ੁਰੂ ਕਰੋ ਅਤੇ ਅਸੀਂ ਤੁਹਾਡੀਆਂ ਟੈਬਾਂ ਨੂੰ ਮੁੜ-ਬਹਾਲ ਕਰਾਂਗੇ।</translation>
<translation id="82292346243148940">ਜਿਨ੍ਹਾਂ 'ਤੇ ਤੁਸੀਂ ਹਾਲ ਹੀ ਵਿੱਚ ਨਹੀਂ ਗਏ ਹੋ। FlyWeb ਨੇ <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> ਅਤੇ <ph name="COUNT"/> ਹੋਰ ਨੂੰ ਹਟਾ ਦਿੱਤਾ ਹੈ।</translation>
<translation id="1802926274661855018">ਜੇ FlyWeb ਵਿੱਚ Gemini ਖੁੱਲ੍ਹਾ ਹੈ, ਤਾਂ ਨਵੀਆਂ ਟੈਬਾਂ ਬਣਾਉਣ ਵੇਲੇ ਸਾਈਡ ਪੈਨਲ ਖੁੱਲ੍ਹਾ ਰਹਿੰਦਾ ਹੈ</translation>
<translation id="3469649164996417993">ਇਹ Brave Search ਵੇਲੇ ਵਰਤੇ ਜਾਣ ਵਾਲੇ ਸਪੈੱਲ-ਚੈਕਰ ਨੂੰ ਹੀ ਵਰਤਦਾ ਹੈ। ਬ੍ਰਾਊਜ਼ਰ ਵਿੱਚ ਤੁਹਾਡੇ ਵੱਲੋਂ ਟਾਈਪ ਕੀਤੀ ਜਾਣ ਵਾਲੀ ਲਿਖਤ FlyWeb ਨੂੰ ਭੇਜੀ ਜਾਵੇਗੀ। ਤੁਸੀਂ ਹਮੇਸ਼ਾਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਸ ਵਤੀਰੇ ਨੂੰ ਬਦਲ ਸਕਦੇ ਹੋ।</translation>
<translation id="7460496601839821581">ਖਾਤੇ ਤੋਂ ਬਿਨਾਂ FlyWeb ਵਰਤੋ</translation>
<translation id="2991144524835127379">mDNS ਟ੍ਰੈਫਿਕ ਦੀ ਆਗਿਆ ਦੇਣ ਲਈ FlyWeb ਲਈ ਇਨਬਾਊਂਡ ਨਿਯਮ।</translation>
<translation id="6208903184719035736">&amp;FlyWeb ਨੂੰ ਅੱਪਡੇਟ ਕਰਨ ਲਈ ਮੁੜ-ਲਾਂਚ ਕਰੋ</translation>
<translation id="4918086044614829423">ਸਵੀਕਾਰ ਕਰੋ</translation>
<translation id="4918844574251943176">ਚਿੱਤਰ ਕਾਪੀ ਕੀਤਾ ਗਿਆ</translation>
<translation id="5477235053075501816">ਆਪਣੇ ਸਾਰੇ ਡੀਵਾਈਸਾਂ 'ਤੇ ਆਪਣੀ ਪੜ੍ਹਨ-ਸੂਚੀ ਅਤੇ ਹੋਰ ਬਹੁਤ ਕੁਝ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, FlyWeb 'ਤੇ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="7174589544844983914">FlyWeb ਪਿਛੋਕੜ ਮੋਡ ਵਿੱਚ ਹੈ।</translation>
<translation id="9212977598552218412">FlyWeb ਦੀ ਸਾਈਨ-ਇਨ ਵਿੰਡੋ ਨੂੰ ਬੰਦ ਕਰਨ ਲਈ ਕਲਿੱਕ ਕਰੋ</translation>
<translation id="8366169706197332122">FlyWeb ਪ੍ਰੋਫਾਈਲਾਂ ਨਾਲ ਤੁਸੀਂ ਆਪਣੀ ਸਾਰੀ FlyWeb ਸਮੱਗਰੀ ਨੂੰ ਵੱਖ ਕਰ ਸਕਦੇ ਹੋ। ਦੋਸਤਾਂ ਅਤੇ ਪਰਿਵਾਰ ਲਈ ਪ੍ਰੋਫਾਈਲਾਂ ਬਣਾਓ ਜਾਂ ਕੰਮ ਅਤੇ ਮੌਜ-ਮਸਤੀ ਲਈ ਵੱਖ-ਵੱਖ ਪ੍ਰੋਫਾਈਲਾਂ ਬਣਾਓ।</translation>
<translation id="7792628702371319769">ਮਹਿਮਾਨ ਕੁਝ ਵੀ ਪਿੱਛੇ ਛੱਡੇ ਬਿਨਾਂ FlyWeb ਵਰਤ ਸਕਦੇ ਹਨ।</translation>
<translation id="7370618680298767482">FlyWeb ਵਿੱਚ ਤੁਹਾਡਾ ਖਾਤਾ</translation>
<translation id="2760069255902967585">ਖੁਦ ਨੂੰ FlyWeb ਵਿੱਚ ਜੋੜੋ</translation>
<translation id="504699503110800016">ਓਵਰਫ਼ਲੋ ਮੀਨੂ ਖੋਲ੍ਹੋ</translation>
<translation id="6686344057006524628">ਆਪਣੇ <ph name="DEVICE_TYPE"/> 'ਤੇ FlyWeb ਨਾਲ ਆਪਣੀਆਂ ਸਾਰੀਆਂ ਮਨਪਸੰਦ FlyWeb ਸੇਵਾਵਾਂ ਤੱਕ ਪਹੁੰਚ ਕਰੋ</translation>
<translation id="2515109138500267971">FlyWeb ਨੂੰ ਤੁਹਾਡੇ ਹੱਥਾਂ ਨੂੰ ਟਰੈਕ ਕਰਨ ਲਈ ਇਜਾਜ਼ਤ ਦੀ ਲੋੜ ਹੈ</translation>
<translation id="3910606758302645363">ਜਿਨ੍ਹਾਂ 'ਤੇ ਤੁਸੀਂ ਹਾਲ ਹੀ ਵਿੱਚ ਨਹੀਂ ਗਏ ਹੋ। FlyWeb ਨੇ <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> ਨੂੰ ਹਟਾ ਦਿੱਤਾ ਹੈ।</translation>
<translation id="5174969993834422967">ਆਮ ਤੌਰ 'ਤੇ ਤੁਸੀਂ ਸੂਚਨਾਵਾਂ ਨੂੰ ਬਲਾਕ ਕਰਦੇ ਹੋ। ਆਪਣੀ ਟਿਕਾਣਾ ਪੱਟੀ ਦੇ ਸੱਜੇ ਕੋਨੇ 'ਤੇ ਸੂਚਨਾ ਪ੍ਰਤੀਕ 'ਤੇ ਕਲਿੱਕ ਕਰੋ, ਤਾਂ ਜੋ ਇਹ ਸਾਈਟ ਤੁਹਾਨੂੰ ਸੂਚਿਤ ਕਰ ਸਕੇ।</translation>
<translation id="5174983315706567306">ਡਿਸਕ ਵਿੱਚ ਜਗ੍ਹਾ ਕਾਫ਼ੀ ਨਹੀਂ ਹੈ।</translation>
<translation id="4326845160190496236">FlyWeb ਖਾਤੇ ਨੂੰ ਮੁੜ-ਪ੍ਰਮਾਣੀਕਰਨ ਦੀ ਲੋੜ ਹੈ</translation>
<translation id="3540715470656277664">iOS 'ਤੇ FlyWeb ਨਾਲ ਜਿੱਥੇ ਛੱਡਿਆ ਸੀ, ਉੱਥੋਂ ਹੀ ਦੇਖਣਾ ਸ਼ੁਰੂ ਕਰੋ।</translation>
<translation id="291933003154435191">FlyWeb ਤੋਂ ਸਾਈਨ-ਆਊਟ ਕਰੋ</translation>
<translation id="5234764350956374838">ਬਰਖ਼ਾਸਤ ਕਰੋ</translation>
<translation id="9098587825736815971">ਤੁਰਦੇ-ਫਿਰਦੇ ਪਾਸਵਰਡ ਰੱਖਿਅਤ ਕਰਨ ਲਈ FlyWeb ਐਪ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="8295539942024823191">ਆਪਣੀਆਂ ਤਬਦੀਲੀਆਂ ਲਾਗੂ ਕਰਨ ਲਈ, FlyWeb ਨੂੰ ਮੁੜ-ਲਾਂਚ ਕਰੋ</translation>
<translation id="5286907366254680517">ਪਤਾ ਲੱਗਿਆ</translation>
<translation id="626007313130236514">FlyWeb ਐਪ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="5361365805808004630">FlyWeb ਨਾਲ ਖੋਜੋ</translation>
<translation id="8888283148421206435">FlyWeb ਅੱਪਡੇਟਰ ਅੰਦਰੂਨੀ ਸੇਵਾ</translation>
<translation id="3025882852178035952">ਉਨ੍ਹਾਂ ਨੂੰ FlyWeb ਵਿੱਚ ਹੋਰ Gemini ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਦੇ ਨਾਲ-ਨਾਲ ਵਰਤੋ</translation>
<translation id="5346389065299425353">ਇੱਕ ਤੋਂ ਵੱਧ ਟੈਬਾਂ, ਫ਼ਾਈਲਾਂ ਅਤੇ ਟੂਲਾਂ ਨੂੰ ਸ਼ਾਮਲ ਕਰ ਕੇ ਆਪਣੀ ਖੋਜ ਨੂੰ ਬਿਹਤਰ ਬਣਾਓ</translation>
<translation id="8330248712705246714">FlyWeb ਵਿੱਚ Gemini ਨਾਲ ਇਸ ਦਸਤਾਵੇਜ਼ ਦੀ ਤਤਕਾਲ ਰੂਪ-ਰੇਖਾ ਪ੍ਰਾਪਤ ਕਰੋ ਅਤੇ ਸਵਾਲ ਪੁੱਛੋ</translation>
<translation id="6178233095056047786">FlyWeb ਨੂੰ ਤੁਹਾਡੀ ਸਮੀਖਿਆ ਲਈ ਕੁਝ ਸੁਰੱਖਿਆ ਸਿਫ਼ਾਰਸ਼ਾਂ ਮਿਲੀਆਂ ਹਨ</translation>
<translation id="8980390875915032396">ਹੋਰ FlyWeb ਪ੍ਰੋਫਾਈਲਾਂ</translation>
<translation id="2441009746272048284">ChromeOS ਤੁਹਾਡੇ FlyWeb ਖਾਤੇ ਵਿੱਚ FlyWeb ਡਾਟਾ ਰੱਖਿਅਤ ਨਹੀਂ ਕਰ ਸਕਿਆ ਕਿਉਂਕਿ ਤੁਹਾਡੇ ਖਾਤੇ ਦੇ ਸਾਈਨ-ਇਨ ਵੇਰਵੇ ਪੁਰਾਣੇ ਹਨ</translation>
<translation id="8449603408481238073">ਤੁਸੀਂ ਇੱਕ ਪ੍ਰਬੰਧਿਤ ਕੀਤੇ ਖਾਤੇ ਨਾਲ ਸਾਈਨ-ਇਨ ਕਰ ਰਹੇ ਹੋ ਅਤੇ ਇਸ ਦੇ ਪ੍ਰਸ਼ਾਸਕ ਨੂੰ ਆਪਣੇ FlyWeb ਪ੍ਰੋਫਾਈਲ ਦਾ ਕੰਟਰੋਲ ਦੇ ਰਹੇ ਹੋ। ਤੁਹਾਡਾ FlyWeb ਡਾਟਾ, ਜਿਵੇਂ ਕਿ ਤੁਹਾਡੀਆਂ ਐਪਾਂ, ਬੁੱਕਮਾਰਕ, ਇਤਿਹਾਸ, ਪਾਸਵਰਡ, ਅਤੇ ਹੋਰ ਸੈਟਿੰਗਾਂ <ph name="USER_NAME"/> ਨਾਲ ਸਥਾਈ ਤੌਰ 'ਤੇ ਜੋੜੇ ਜਾਣਗੇ। ਤੁਸੀਂ ਇਸ ਡਾਟੇ ਨੂੰ FlyWeb ਖਾਤੇ ਡੈਸ਼ਬੋਰਡ ਰਾਹੀਂ ਮਿਟਾ ਸਕੋਗੇ, ਪਰ ਤੁਸੀਂ ਇਸ ਡਾਟੇ ਨੂੰ ਦੂਜੇ ਖਾਤੇ ਨਾਲ ਨਹੀਂ ਜੋੜ ਸਕੋਗੇ। <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">ਵਾਧੂ ਕੋਡ: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">ਵਿਅਕਤੀਗਤਕਰਨ ਲਈ, 'ਵੈੱਬ ਅਤੇ ਐਪ ਸਰਗਰਮੀ' ਵਿੱਚ FlyWeb ਸ਼ਾਮਲ ਕਰੋ</translation>
<translation id="1456957080321742545">FlyWeb ਨਾਲ ਖੋਜ ਨੂੰ ਖੋਲ੍ਹੋ</translation>
<translation id="1026219128963768190">ਜਾਣੋ ਕਿ FlyWeb ਕੁਝ ਫ਼ਾਈਲਾਂ ਨੂੰ ਬਲਾਕ ਕਿਉਂ ਕਰਦਾ ਹੈ</translation>
