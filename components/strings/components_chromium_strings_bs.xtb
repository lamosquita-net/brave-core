<translation id="130631256467250065">Vaše promjene će stupiti na snagu kada sljedeći put ponovo pokrenete uređaj.</translation>
<translation id="1555506416658437797">urediti načine plaćanja.</translation>
<translation id="8359495463485001719">Izrada izvještaja o padovima aplikacije nije dostupna na Braveu.</translation>
<translation id="6338530717474923868">Prikazana vam je sigurna stranica Bravea</translation>
<translation id="5147169001159408844">FlyWeb pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="5702992568540613683">Logotip Bravea</translation>
<translation id="510342522494506803">FlyWeb pokušava urediti načine plaćanja.</translation>
<translation id="8375862260948854624">FlyWeb je dostupan zahvaljujući <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> projektu otvorenog koda i drugom <ph name="BEGIN_LINK_OSS"/>softveru otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Idite na
          FlyWeb meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN postavke
          i poništite odabir u polju za potvrdu "Koristi proksi server za svoj LAN".</translation>
<translation id="5040124620086808431">Ovu stranicu je blokirao FlyWeb</translation>
<translation id="1953000035868532675">U postavkama zaštitnog zida ili antivirusnog programa dozvolite Braveu da pristupi
          mreži.</translation>
<translation id="3442058224540562441">Idite u
          meni Bravea&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          i provjerite je li vaša konfiguracija postavljena na "bez proksi servera" ili "direktno".</translation>
<translation id="585620188971323280">izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="2681118099728446983">FlyWeb su omogućili i drugi <ph name="BEGIN_LINK_OSS"/>softveri otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Vaše promjene će stupiti na snagu kada sljedeći put budete ponovo pokrenuli FlyWeb.</translation>
<translation id="1017070759373671177">FlyWeb je omogućio <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> projekat otvorenog koda.</translation>
<translation id="7777112741998051633">Idite na
          meni u Braveu &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          i poništite odabir za "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Ako ovo ne riješi problem, preporučujemo vam da ponovo odaberete
          ovu opcija za unapređenje performansi.</translation>
<translation id="8187289872471304532">Idite na
          Aplikacije &gt; Postavke sistema &gt; Mreža &gt; Napredno &gt; Proksiji
          i poništite odabir svih odabranih proksija.</translation>
<translation id="4699594416850504200">Gledate sigurnu stranicu verzije FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb se nije ispravno zatvorio.</translation>
