<translation id="1603558835003845196">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-FlyWeb</translation>
<translation id="5751080530525677552">‏יש להפוך את FlyWeb לדפדפן ברירת המחדל</translation>
<translation id="4804111781678641302">‏FlyWeb לא יכול לחפש עדכונים. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="3542157007113577464">‏האם לצאת מ-FlyWeb?</translation>
<translation id="6273793429163604305">למקומות…</translation>
<translation id="3794967601634523398">‏התאמה אישית של פרופיל FlyWeb</translation>
<translation id="6475001900959697061">‏בחירת שם לפרופיל FlyWeb שלך</translation>
<translation id="4465156155012748592">‏<ph name="FILE_NAME"/> עלול להיות מסוכן, ולכן FlyWeb חסם אותו.</translation>
<translation id="5523868569707953059">‏FlyWeb משתמש במצלמה שלך.</translation>
<translation id="5914697581312472089">‏הקובץ הזה מסוכן ולכן הוא נחסם על ידי FlyWeb</translation>
<translation id="6327105987658262776">אין עדכונים זמינים.</translation>
<translation id="8226838065217375546">‏מתבצעת כרגע פעולה אחרת ב-FlyWeb. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="6063700568539132984">‏קל יותר כעת להשתמש ב-FlyWeb באמצעות חשבון FlyWeb שלך ובמחשבים משותפים.</translation>
<translation id="6890209090736444656">‏ברצונך באמת להסיר את התקנת FlyWeb?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="8218289771633351023">‏<ph name="BEGIN_BOLD"/>איך אנחנו משתמשים בנתונים האלה:<ph name="END_BOLD"/> FlyWeb יכול להעריך מהם תחומי העניין שלך. לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-FlyWeb כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
<translation id="6636986997730784876">‏FlyWeb הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-FlyWeb.</translation>
<translation id="2139300032719313227">‏הפעלה מחדש של ChromeOS</translation>
<translation id="173462352822069427">‏ברוך בואך לפרופילים של FlyWeb</translation>
<translation id="1474676525193357364">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את FlyWeb.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="5777905264835557372">‏הסרה של התקנת FlyWeb</translation>
<translation id="8852057261917278552">‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION"/>. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="8592211619057897362">‏בכל פרופיל מאוחסנים נתוני FlyWeb משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="7489092380688543560">‏אפשר לעבור לפרופיל FlyWeb אחר כדי לראות סיסמאות</translation>
<translation id="8243012192239086369">‏FlyWeb שולח את הטקסט שמוקלד בשדות טקסט ל-FlyWeb כדי לתקן שגיאות כתיב</translation>
<translation id="3927263773110604886">‏מעבר אל הגדרות ההודעות של FlyWeb</translation>
<translation id="6888846095017247017">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את FlyWeb‏.</translation>
<translation id="1886169834787876002">‏נדרשת הרשאת גישה למצלמה ב-FlyWeb כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="7640394575797555654">‏סביר להניח שאתרים יפעלו כצפוי, אבל ההעדפות שלך באתרים האלו יימחקו לאחר סגירת כל החלונות ב-FlyWeb</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="1363996462118479832">‏לא בוצע סנכרון של הנתונים ב-ChromeOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="4152880912192471857">‏נדרשת הרשאת גישה למיקרופון ב-FlyWeb עבור האתר הזה</translation>
<translation id="2193001403607253406">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של FlyWeb.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של FlyWeb.</translation>
<translation id="3260179770078760650">‏FlyWeb פועל מהר יותר בזכות מצב החיסכון בזיכרון</translation>
<translation id="7728046102681268859">‏FlyWeb כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="7030752319019635064">‏כדי לקבל גישה אל הפריטים שלך ב-FlyWeb בכל המכשירים, יש להיכנס לחשבון ולהפעיל את הסנכרון.</translation>
<translation id="1292831930742306370">‏ההמלצה של FlyWeb היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="5612302437680103875">‏אחד מההורים השבית ב-FlyWeb את ההגדרה "הרשאות לאתרים, אפליקציות ותוספים". לא ניתן להפעיל את <ph name="EXTENSION_TYPE_PARAMETER"/>.</translation>
<translation id="1547295885616600893">‏<ph name="BEGIN_LINK_CROS_OSS"/>תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS"/> נוספת מאפשרת את השימוש ב-ChromeOS.</translation>
