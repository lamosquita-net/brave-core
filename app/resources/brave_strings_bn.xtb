<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="bn">
<translation id="1026101648481255140">ইনস্টলেশন আবার চালু করুন</translation>
<translation id="7099479769133613710">&amp;ChromeOS আপডেট করতে আবার লঞ্চ করুন</translation>
<translation id="291426170030461697">এই এক্সটেনশন পর্যালোচনা করার জন্য FlyWeb সাজেশন দেয়</translation>
<translation id="1549005488226693697">কোনও সাইট তার পৃষ্ঠায় লিঙ্ক ব্যক্তিগতভাবে প্রিলোড করতে বললে, FlyWeb, FlyWeb সার্ভার ব্যবহার করে। এর ফলে প্রিলোড করা সাইটের থেকে আপনার পরিচয় লুকানো থাকে, কিন্তু FlyWeb জানতে পারে কোন সাইটগুলি প্রিলোড করা হয়েছে।</translation>
<translation id="1065672644894730302">আপনার অভিরুচিগুলি পড়া যাবে না৷ কিছু বৈশিষ্ট্য অনুপলব্ধ থাকতে পারে ও অভিরুচিগুলিতে করা পরিবর্তনগুলি সংরক্ষিত হবে না৷</translation>
<translation id="8908267645832965492">তোমার অভিভাবক FlyWeb-এর জন্য "সাইট, অ্যাপ ও এক্সটেনশনের অনুমতি" বন্ধ করে দিয়েছেন</translation>
<translation id="6896681084876612310">ডেটার নিরাপত্তা লঙ্ঘন, এক্সটেনশন এবং আরও অনেক কিছুর থেকে FlyWeb আপনাকে সুরক্ষিত রাখতে সাহায্য করে</translation>
<translation id="1368460307421081773">FlyWeb আপনার পাসওয়ার্ড এক্সপোর্ট করতে চাইছে। অনুমতি দিতে Windows এর পাসওয়ার্ড টাইপ করুন।</translation>
<translation id="7307912249127683931">FlyWeb আপনার ডিফল্ট ব্রাউজার</translation>
<translation id="4556715463645168547">আপনার পাসওয়ার্ড ডেটার নিরাপত্তা লঙ্ঘন এবং অন্যান্য নিরাপত্তা সংক্রান্ত সমস্যা থেকে সুরক্ষিত কিনা তা চেক করতে <ph name="BEGIN_LINK"/>FlyWeb-এ সাইন-ইন করুন<ph name="END_LINK"/>।</translation>
<translation id="2076135703183650206">FlyWeb মেনুতে ক্লিক করুন</translation>
<translation id="1184145431117212167">আপনার Windows-এর ভার্সনে কাজ করছে না তাই ইনস্টল করা যায়নি।</translation>
<translation id="4380351562011537903">FlyWeb সম্পর্কে</translation>
<translation id="2593084789070248821">আপনার উইন্ডো শেয়ার করতে, সিস্টেম প্রেফারেন্স থেকে FlyWeb-এর জন্য স্ক্রিন রেকর্ডিং চালু করতে হবে।</translation>
<translation id="1203500561924088507">ইনস্টল করার জন্য ধন্যবাদ। <ph name="BUNDLE_NAME"/> ব্যবহার করার আগে আপনাকে অবশ্যই ব্রাউজার রিস্টার্ট করতে হবে।</translation>
<translation id="4750836834956739196">FlyWeb যাতে দ্রুত কাজ করে সেই জন্য এই ট্যাব বন্ধ থাকাকালীন মেমরি খালি করা হয়েছে। এই সাইটটি অ্যাক্টিভ রাখার বিকল্প সব সময় বেছে নিতে পারবেন।</translation>
<translation id="3190759351483708314">এই ফাইলটি বিপজ্জনক, তাই FlyWeb এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="5879469261638423015">Gmail বা YouTube-এর মতো FlyWeb পরিষেবায় <ph name="USER_EMAIL"/> দিয়ে সাইন-ইন করার সময় আপনি একই অ্যাকাউন্ট দিয়ে FlyWeb-এ অটোমেটিক সাইন-ইন করতে পারবেন</translation>
<translation id="1290883685122687410">সেট-আপ সংক্রান্ত সমস্যা: <ph name="METAINSTALLER_EXIT_CODE"/>। <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">আপনার নতুন FlyWeb প্রোফাইল সেট আপ করুন</translation>
<translation id="609743863669742325">ব্লুটুথ ডিভাইসগুলি এক্সপ্লোর করতে 
 FlyWeb-কে ব্লুটুথের অ্যাক্সেস দিতে হবে। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">এছাড়া, FlyWeb থেকেও ডেটা মুছে দিন (<ph name="URL"/>)</translation>
<translation id="4150708158890309866">আপনি FlyWeb এ প্রবেশ করেছেন!</translation>
<translation id="4713192356155907986">FlyWeb for Testing ব্যবহার করে সহায়তা পান</translation>
<translation id="1497802159252041924">ইনস্টলেশন সংক্রান্ত সমস্যা: <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">একটি FlyWeb ট্যাব শেয়ার করুন</translation>
<translation id="8196829963313696543">আপনার আশেপাশের 3D ম্যাপ তৈরি করতে এই সাইটটির জন্য FlyWeb-কে আপনার ক্যামেরা অ্যাক্সেস করার অনুমতি দিতে হবে</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{এই এক্সটেনশন আর কাজ করবে না। FlyWeb আপনাকে এটি সরিয়ে দেওয়ার সাজেশন দেয়।}one{এইসব এক্সটেনশন আর কাজ করবে না। FlyWeb আপনাকে এগুলি সরিয়ে দেওয়ার সাজেশন দেয়।}other{এইসব এক্সটেনশন আর কাজ করবে না। FlyWeb আপনাকে এগুলি সরিয়ে দেওয়ার সাজেশন দেয়।}}</translation>
<translation id="852852907317361085">FlyWeb-এর নিরাপত্তা টুল</translation>
<translation id="4096742538387076253">আপনার FlyWeb অ্যাকাউন্টে কিছু ডেটা সেভ এবং সবকটি ডিভাইসে তা ব্যবহার করতে পারার আগে, FlyWeb-কে আপনার পরিচয় যাচাই করতে দিতে হবে। আপনি সাইন-আউট করলে, এই ডেটা এই ডিভাইসে থেকে যাবে।</translation>
<translation id="481155564361715417">FlyWeb আপনার Password Manager সম্পর্কিত ডেটা মুছতে চায়। এটি করার অনুমতি দিতে, আপনার Windows-এর পাসওয়ার্ড টাইপ করুন।</translation>
<translation id="3961251277542681013">FlyWeb-এ মূল গোপনীয়তা এবং নিরাপত্তা নিয়ন্ত্রণ পর্যালোচনা করুন</translation>
<translation id="1640672724030957280">ডাউনলোড হচ্ছে...</translation>
<translation id="6153580651793156880">এইসব ফিচার উন্নত করতে, FlyWeb, এগুলির সাথে আপনার ইন্ট্যার‌্যাকশন সংক্রান্ত তথ্য FlyWeb-এর কাছে পাঠায়। এই ডেটা হিউম্যান রিভিউয়ারের দ্বারা পড়া, প্রসেস করা ও অ্যানোটেট করা হতে পারে।</translation>
<translation id="1722488837206509557">এর ফলে আপনি উপলভ্য় ডিভাইসগুলি থেকে বেছে নিতে পারবেন এবং সেগুলিতে কন্টেন্ট দেখাতে পারবেন।</translation>
<translation id="2383861520542390014">আগ্রহের যেসব বিষয়ের উপর ভিত্তি করে সাইট আপনাকে বিজ্ঞাপন দেখায়, আপনি সেগুলি দেখতে ও সরিয়ে দিতে পারবেন। FlyWeb আপনার সাম্প্রতিক ব্রাউজিং ইতিহাসের উপর ভিত্তি করে আপনার আগ্রহ সম্পর্কে ধারণা করতে পারে।</translation>
<translation id="5695205873161614119">FlyWeb শীঘ্রই ব্রাউজ করা ডেটা মুছে ফেলবে</translation>
<translation id="8939535770474283898">FlyWeb নেভিগেশনকে HTTPS-তে আপগ্রেড করার চেষ্টা করবে</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/>-এর মধ্যে রিস্টার্ট হবে</translation>
<translation id="6903827847227122616">HTTPS উপলভ্য না থাকলে, FlyWeb আপনাকে সতর্ক না করেই অসুরক্ষিত কানেকশন ব্যবহার করবে</translation>
<translation id="307170399141486420">FlyWeb-কে ব্যাকগ্রাউন্ডে চলতে দিন</translation>
<translation id="2473319786107120819">FlyWeb আবার ইন্সটল করুন</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/>-এর চেষ্টা করছে</translation>
<translation id="3403116471618205223">শুধুমাত্র এই ডিভাইস থেকে ব্রাউজ করা ডেটা মুছে দিতে, তা নিজের FlyWeb অ্যাকাউন্টে রেখে দেওয়ার সময়, <ph name="BEGIN_LINK"/>FlyWeb থেকে সাইন-আউট করুন<ph name="END_LINK"/>।</translation>
<translation id="6434738578659849497">FlyWeb-এর মাধ্যমে আপনার আগ্রহের বিষয়ে তথ্যগুলি সাইট স্টোর করতে পারে। যেমন, আপনি যদি ম্যারাথনের জন্য জুতো কেনার একটি সাইট ভিজিট করেন, তাহলে সাইটটি আপনার আগ্রহকে ম্যারাথন দৌড় হিসেবে বিবেচনা করবে। পরে আপনি যদি রেসের জন্য রেজিস্ট্রেশন করতে অন্য একটি সাইটে যান, তাহলে আপনার আগ্রহের উপর ভিত্তি করে সাইটটি আপনাকে দৌড়ানোর জুতোর বিজ্ঞাপন দেখাবে।</translation>
<translation id="4824940465467423308">আপনি একটি পরিচালিত অ্যাকাউন্টের মাধ্যমে সাইন-ইন করুন করছেন এবং এর অ্যাডমিনিস্ট্রেটরকে আপনার FlyWeb প্রোফাইলের উপরে নিয়ন্ত্রণ দিচ্ছেন৷ আপনার FlyWeb ডেটা, যেমন অ্যাপ, বুকমার্ক, ইতিহাস, পাসওয়ার্ড এবং অন্যান্য সেটিংস <ph name="USER_NAME"/> এতে স্থায়ীভাবে সম্পৃক্ত হবে৷ আপনি FlyWeb অ্যাকাউন্টগুলির ড্যাশবোর্ডের মাধ্যমে এই ডেটাগুলি মুছতে চালু হবেন, কিন্তু অন্য অ্যাকাউন্টের সাথে এই ডেটা সংশ্লিষ্ট করতে পারবেন না৷ বিকল্প হিসেবে আপনি আপনার বিদ্যমান FlyWeb তথ্য আলাদা রাখার জন্য একটি নতুন প্রোফাইল তৈরি করতে পারেন৷ <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">এটি বন্ধ করার মানে হল, আপনি FlyWeb-এ সাইন-ইন না করে Gmail এর মতো FlyWeb সাইটগুলিতে সাইন-ইন করতে পারেন</translation>
<translation id="5714085538350759767">FlyWeb সাড়া দিচ্ছে না৷ আবার শুরু করবেন?</translation>
<translation id="4035053306113201399">আপডেটটি প্রয়োগ করতে ChromeOS আবার চালু করা প্রয়োজন।</translation>
<translation id="3750729306035486751">এই ধরনের ফাইল সাধারণত ডাউনলোড করা হয় না এবং এটি বিপজ্জনক হতে পারে, তাই FlyWeb এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="1953553007165777902">ডাউনলোড হচ্ছে... <ph name="MINUTE"/> মিনিট বাকি আছে</translation>
<translation id="6956650624767954726">FlyWeb ডিফল্ট ব্রাউজার নির্ধারণ বা সেট করতে পারছে না</translation>
<translation id="6495079989036864983">এটি এই ডিভাইস থেকে ১টি আইটেম মুছে দেবে। আপনার ডেটা পরে পুনরুদ্ধার করার জন্য, FlyWeb-এ <ph name="USER_EMAIL"/> হিসেবে সাইন-ইন করুন।</translation>
<translation id="2018879682492276940">ইনস্টল করা যায়নি। আবার চেষ্টা করুন।</translation>
<translation id="4252651275570549255">আপনার অন্যান্য পাসওয়ার্ড ডেটার নিরাপত্তা লঙ্ঘন এবং অন্যান্য নিরাপত্তা সংক্রান্ত সমস্যা থেকে সুরক্ষিত কিনা তা চেক করতে <ph name="BEGIN_LINK"/>FlyWeb-এ সাইন-ইন করুন<ph name="END_LINK"/>।</translation>
<translation id="8544477465831682343">FlyWeb পরিষেবাতে আরও পছন্দমতো অভিজ্ঞতার জন্য FlyWeb ইতিহাস অন্তর্ভুক্ত করবেন কিনা তা বেছে নিন</translation>
<translation id="8924891216494775926">এই ফাইলটি প্রতারণামূলক এবং এটি ডিভাইসে অপ্রত্যাশিত পরিবর্তন করে দিতে পারে, তাই FlyWeb এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="1868972292925460871">FlyWeb কীভাবে মূল সার্টিফিকেট ম্যানেজ করে সেই বিষয়ে তথ্য</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{FlyWeb ১ মিনিট ধরে ব্যবহার না করলে, আপনার সংস্থা অটোমেটিক এটির ব্রাউজ করা ডেটা মুছে দেয়। এর মধ্যে ইতিহাস, অটোফিল এবং ডাউনলোড সংক্রান্ত ডেটা থাকতে পারে। আপনার ট্যাব খোলা থাকবে।}one{FlyWeb # মিনিট ধরে ব্যবহার না করলে, আপনার সংস্থা অটোমেটিক এটির ব্রাউজ করা ডেটা মুছে দেয়। এর মধ্যে ইতিহাস, অটোফিল এবং ডাউনলোড সংক্রান্ত ডেটা থাকতে পারে। আপনার ট্যাব খোলা থাকবে।}other{FlyWeb # মিনিট ধরে ব্যবহার না করলে, আপনার সংস্থা অটোমেটিক এটির ব্রাউজ করা ডেটা মুছে দেয়। এর মধ্যে ইতিহাস, অটোফিল এবং ডাউনলোড সংক্রান্ত ডেটা থাকতে পারে। আপনার ট্যাব খোলা থাকবে।}}</translation>
