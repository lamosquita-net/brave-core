<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="7099479769133613710">Επανεκκίνηση για ενημέρωση του &amp;Chrome OS</translation>
<translation id="291426170030461697">Το FlyWeb συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="1549005488226693697">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το FlyWeb χρησιμοποιεί τους διακομιστές της FlyWeb. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η FlyWeb μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="8908267645832965492">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το FlyWeb</translation>
<translation id="5557633153169217776">Το FlyWeb χρειάζεται πρόσβαση στο τοπικό δίκτυό σας για την ανακάλυψη και τη χρήση συσκευών σε κοντινή απόσταση</translation>
<translation id="6441390163669415879">Για να αναζητήσετε μια συγκεκριμένη λειτουργία ή επέκταση του FlyWeb, πληκτρολογήστε τη συντόμευσή της στη γραμμή διευθύνσεων και, στη συνέχεια, το επιλεγμένο πλήκτρο πληκτρολογίου</translation>
<translation id="9001750423919983557">Εμφάνιση της αναζήτησης με το FlyWeb στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="1368460307421081773">Το FlyWeb θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">Το FlyWeb είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="4556715463645168547">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK"/>συνδεθείτε στο FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Κάντε κλικ στο μενού του FlyWeb</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="4380351562011537903">Σχετικά με το FlyWeb</translation>
<translation id="853148447909557566">Λήψη ειδοποιήσεων παρακολούθησης τιμής με το FlyWeb στο τηλέφωνό σας</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας FlyWeb στο FlyWeb. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο FlyWeb.</translation>
<translation id="7614508617663739435">Εμφάνιση του Gemini στο FlyWeb στη γραμμή μενού του Mac</translation>
<translation id="832555967476614730">Για να επιλέξετε ένα μέρος της οθόνης στο Gemini στο FlyWeb, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="4750836834956739196">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το FlyWeb. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="3190759351483708314">Το FlyWeb απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="5879469261638423015">Όταν συνδέεστε σε υπηρεσίες FlyWeb, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL"/>, μπορείτε να συνδέεστε αυτόματα στο FlyWeb με τον ίδιο λογαριασμό</translation>
<translation id="7142135954326264349">Λήψη του FlyWeb στο τηλέφωνό σας</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Ρυθμίστε το νέο σας προφίλ στο FlyWeb</translation>
<translation id="5252737639504553444">Δοκιμάστε τη με το Gemini στο FlyWeb</translation>
<translation id="609743863669742325">Το FlyWeb χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση 
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Συνδεθείτε στο FlyWeb από το τηλέφωνό σας</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="2276527911011636666">Να διαγραφούν επίσης δεδομένα από το FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="1045149878186896649">Χρησιμοποιήστε την εφαρμογή FlyWeb για να συνεχίσετε την περιήγηση εν κινήσει</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="2758515779140515865">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το FlyWeb στις Ρυθμίσεις συστήματος.</translation>
<translation id="4713192356155907986">Λήψη βοήθειας για το FlyWeb for Testing</translation>
<translation id="4984443629206419460">Για να έχετε πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>, συνδεθείτε στο FlyWeb</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="8962360511570172">Μοιραστείτε μια καρτέλα του FlyWeb</translation>
<translation id="2941487459666781243">Σύνδεση στο FlyWeb</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="3182893868355533457">Καρφίτσωμα FlyWeb</translation>
<translation id="852852907317361085">Εργαλεία ασφάλειας του FlyWeb</translation>
<translation id="481155564361715417">Το FlyWeb θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="2846999307505917298">Αξιοποιήστε τις καλύτερες λειτουργίες της FlyWeb με την εφαρμογή FlyWeb στο τηλέφωνό σας</translation>
<translation id="3961251277542681013">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο FlyWeb</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1665602916345474427">Συνδεθήκατε ως <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="7625232007557474355">Μπορείτε να χρησιμοποιείτε το FlyWeb κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές. Επίσης, θα καρφιτσωθεί στη γραμμή εργαλείων.</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">Το FlyWeb θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="8939535770474283898">Το FlyWeb θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="2581127533455294937">Διαγρ. δεδ. FlyWeb</translation>
<translation id="7385422968404728039">Θα γίνει επανεκκίνηση του FlyWeb σε <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Όταν δεν είναι διαθέσιμο το HTTPS, το FlyWeb θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="307170399141486420">Να επιτρέπεται στο FlyWeb να εκτελείται στο παρασκήνιο</translation>
<translation id="5006568136491721884">Κάντε κλικ στο κουμπί <ph name="BEGIN_BOLD"/>Ναι<ph name="END_BOLD"/> στην ειδοποίηση των Windows, για να καρφιτσώσετε το FlyWeb στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="2473319786107120819">Επανεγκατάσταση του FlyWeb</translation>
<translation id="2533324957407080119">Το FlyWeb προσπαθεί να <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Την επόμενη φορά που θα ανοίξετε το FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης FlyWeb.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="3403116471618205223">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας FlyWeb, <ph name="BEGIN_LINK"/>αποσυνδεθείτε από το FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Κατεβάστε το FlyWeb στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="3285741355512747610">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας FlyWeb. Οι Λογαριασμοί σας FlyWeb χρησιμοποιούνται για το πρόγραμμα περιήγησης FlyWeb, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Μάθετε περισσότερα<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="5054936737639982722">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="4824940465467423308">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο FlyWeb. Τα δεδομένα σας στο FlyWeb, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών FlyWeb, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του FlyWeb. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">Το FlyWeb εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Υπηρεσία FlyWeb Updater</translation>
<translation id="7390382558747224642">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους FlyWeb, όπως το Gmail, χωρίς να συνδεθείτε στο FlyWeb</translation>
<translation id="5714085538350759767">Το FlyWeb δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="5866699689358760578">Ο οργανισμός σας, <ph name="MANAGER"/>, απαιτεί να συνδεθείτε στο FlyWeb</translation>
<translation id="4035053306113201399">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chrome OS.</translation>
<translation id="3750729306035486751">Το FlyWeb απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE"/> λεπτά</translation>
<translation id="6956650624767954726">Το FlyWeb δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="197326043290947695">Περιηγηθείτε πιο έξυπνα με την Αναζήτηση με εικόνες</translation>
<translation id="130679046523922050">Μάθετε γιατί το FlyWeb αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="8243822903505210769">Διατηρεί το λογισμικό FlyWeb ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό FlyWeb δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό FlyWeb που να τη χρησιμοποιεί.</translation>
<translation id="6495079989036864983">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="8544477465831682343">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό FlyWeb για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες FlyWeb.</translation>
<translation id="328650761750741315">Είναι ενσωματωμένη στο FlyWeb για να σας βοηθά να δημιουργείτε, να αποθηκεύετε και να συμπληρώνετε αυτόματα ισχυρούς κωδικούς πρόσβασης. Προσθέστε τη συντόμευση για εύκολη πρόσβαση.</translation>
<translation id="2407746489237278840">Κάντε κλικ στο κουμπί Προσαρμογή FlyWeb στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο FlyWeb</translation>
<translation id="8924891216494775926">Το FlyWeb απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="5728214838078602184">Την επόμενη φορά που θα ανοίξετε το FlyWeb iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME"/>.</translation>
<translation id="2058207584484841616">Οι κωδικοί πρόσβασης και άλλα δεδομένα του FlyWeb που αποθηκεύσατε στον Λογαριασμό σας FlyWeb θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο FlyWeb, συνδεθείτε ξανά.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το FlyWeb δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το FlyWeb δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2125838419757773031">Επιλέξτε περιοχή της οθόνης για αναζήτηση</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="2147218225094845757">Απόκρυψη πλαϊνού πλαισίου</translation>
<translation id="4474394796469499134">Το FlyWeb απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="6765231735885996239">Προσαρμογή του FlyWeb</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="2937508664417729967">FlyWeb - Σύνδεση δικτύου - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Κατάργηση λογαριασμού από το FlyWeb</translation>
<translation id="744837314710861405">Χρησιμοποιήστε την εφαρμογή FlyWeb για να έχετε τα καλύτερα εργαλεία αγορών εν κινήσει</translation>
<translation id="2745381939758295588">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο FlyWeb για iOS</translation>
<translation id="6707114110652917144">Επικίνδυνος ιστότοπος. Το FlyWeb κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="4646732243247482236">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας FlyWeb μετά τη σύνδεσή σας.</translation>
<translation id="2726680594710751908">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το FlyWeb ακριβώς όπως θέλουν.</translation>
<translation id="4086571337340463916">Δεξιότητες στο FlyWeb</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{Το FlyWeb συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το FlyWeb συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="5067150284614317159">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο FlyWeb. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το FlyWeb μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="7339360994527471629">Η επέκταση <ph name="EXTENSION_NAME"/> θέλει να συνδεθείτε στο FlyWeb</translation>
<translation id="8788732221355188962">Απενεργοποίηση του FlyWeb, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="4126251160852694747">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS"/>, συνδεθείτε στο FlyWeb.</translation>
<translation id="8418845734693287262">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις FlyWeb}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις FlyWeb}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις FlyWeb}}</translation>
<translation id="1364879203203742966">Το FlyWeb χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="656987653252575654">Ανοίξτε συνδέσμους στο FlyWeb από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="157662717324308283">Κάντε κλικ στο κουμπί Σύνοψη, για να κοινοποιήσετε αυτό το έγγραφο στο Gemini στο FlyWeb, να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="1968013196034892522">Με τα <ph name="BEGIN_LINK"/>εργαλεία του FlyWeb<ph name="END_LINK"/>, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="1716762085628757512">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="3224379053610845181">Το FlyWeb θα κλείσει σύντομα</translation>
<translation id="3840682988105604367">Στο FlyWeb</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="6823116595279840454">Το FlyWeb προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="2691552788029831386">Το FlyWeb χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="2275866327478859777">Πρόγραμμα βοήθειας FlyWeb</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="683641781063074351">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="1659167470250249643">Σαρώστε τον κωδικό QR με το τηλέφωνό σας, για να κατεβάσετε το FlyWeb και να συνδεθείτε στον Λογαριασμό σας FlyWeb.</translation>
<translation id="5353172248151202719">για αναζήτηση με το FlyWeb.</translation>
<translation id="3231856291920394348">Συνέχεια χρήσης του FlyWeb</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="7683745685556117660">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο FlyWeb</translation>
<translation id="5862783156828836752">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="4450675160413947126">Έναρξη του FlyWeb</translation>
<translation id="3827993926722004004">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="333184635927514678">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το FlyWeb ακριβώς όπως θέλουν.</translation>
<translation id="3917488635054382918">Εύκολη πρόσβαση για χρήση του Gemini στο FlyWeb σε όλη τη συσκευή σας, ακόμα και αν το FlyWeb είναι ελαχιστοποιημένο.</translation>
<translation id="1257705702166647105">Καρτέλα FlyWeb</translation>
<translation id="2796283369875688710">Για επιπλέον ασφάλεια, το FlyWeb θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="1118215875395945816">Για να καταργήσετε τον Λογαριασμό σας FlyWeb από το FlyWeb, αποσυνδεθείτε</translation>
<translation id="3320675843036708646">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="8027563534376000179">Ορισμός του FlyWeb ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="7907238427168022751">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το FlyWeb, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="1489590198317876070">Το δικό σας FlyWeb</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="6850011743146651977">Ανακαλύψτε προϊόντα με την κάμερα, παρακολουθήστε τις πτώσεις τιμών και πολλά άλλα εν κινήσει με το FlyWeb σε iOS.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="1339341044496643931">Κατάργηση από το FlyWeb…</translation>
<translation id="4922993584046885552">Διατηρεί την ασφάλειά σας στο FlyWeb και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές FlyWeb όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="3806033752149316261">Σχετικά με το &amp;FlyWeb</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="3497031519171753772">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον Λογαριασμό σας FlyWeb.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="1784605133570901105">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το FlyWeb σε iOS</translation>
<translation id="5383705372991100927">Ο οργανισμός σας διαχειρίζεται το FlyWeb</translation>
<translation id="1661079783259785361">Το FlyWeb έχει ενημερωθεί</translation>
<translation id="5447533789927384736">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το FlyWeb μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="3208925917545144893">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο FlyWeb</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="1216763100505470452">{count,plural, =1{Το FlyWeb πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας FlyWeb και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το FlyWeb πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας FlyWeb και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="8404327407921790238">Άνοιγμα της διεύθυνσης <ph name="URL"/> σε νέα καρτέλα στο FlyWeb.</translation>
<translation id="5184501306555415561">Οι καινοτομίες AI, όπως οι δεξιότητες, αποθηκεύονται στον Λογαριασμό σας FlyWeb και η διαχείρισή τους γίνεται ξεχωριστά από τον συγχρονισμό του FlyWeb</translation>
<translation id="4409390320695765203">Για να έχετε πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="8841609317523323027">Προσθήκη στο FlyWeb…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="2666189940580882376">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>.</translation>
<translation id="4451837224464070850">Άλλα προφίλ FlyWeb</translation>
<translation id="4351369660845291597">Οι επεκτάσεις είναι πρόσθετα που σας επιτρέπουν να προσαρμόζετε το FlyWeb. Από την οργάνωση έως την απλοποίηση των καθημερινών εργασιών, οι επεκτάσεις σάς βοηθούν να προσαρμόζετε το FlyWeb στις ανάγκες σας.</translation>
<translation id="7859502023458300952">Βοηθήστε μας να κάνουμε το FlyWeb καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK"/> στην FlyWeb</translation>
<translation id="1125501479713660011">Χρησιμοποιήστε την εφαρμογή FlyWeb για να έχετε μαζί σας την ασφάλεια της FlyWeb</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις FlyWeb}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις FlyWeb}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις FlyWeb}}</translation>
<translation id="6017373390117959211">Για να έχετε πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>, συνδεθείτε στο FlyWeb</translation>
<translation id="7898392424469957829">Ιστορικό FlyWeb</translation>
<translation id="1407857531570256859">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="4706932464498663870">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το FlyWeb ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="1309738977648134943">Το FlyWeb χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="2251813826843049011">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο FlyWeb να την απενεργοποιήσει.</translation>
<translation id="2664701271733223256">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το FlyWeb στις Ρυθμίσεις συστήματος</translation>
<translation id="6274649779206195384">Επανεκκίνηση FlyWeb</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="6773570808762718524">Προσαρμόστε το νέο σας προφίλ FlyWeb</translation>
<translation id="8965010907836433875">Μπορείτε να συνεχίσετε να συνομιλείτε με τη Λειτουργία AI χωρίς να αλλάξετε καρτέλες. Για να ξεκινήσετε, συνδεθείτε στο FlyWeb. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="5958835776851191812">Για να καταργήσετε τον Λογαριασμό σας FlyWeb από το FlyWeb, αποσυνδεθείτε από το FlyWeb στη σελίδα Ρυθμίσεις</translation>
<translation id="4217346567895356023">Αργότερα, το FlyWeb μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="5449297306961970452">Το FlyWeb δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">Μεταφέρετε μαζί σας τα αγαπημένα σας εργαλεία FlyWeb AI με το FlyWeb σε iOS.</translation>
<translation id="8090118570458552025">Για να έχετε πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>, συνδεθείτε στο FlyWeb</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="3900612994249740104">Λείπουν κλειδιά του FlyWeb API. Ορισμένες λειτουργίες του FlyWeb FlyWeb θα απενεργοποιηθούν.</translation>
<translation id="6824575001009586492">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το FlyWeb είναι κλειστό</translation>
<translation id="2595215790271940091">Το FlyWeb θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="3701353923785984059">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του FlyWeb, εκτός από τον Λογαριασμό σας FlyWeb εάν είστε συνδεδεμένοι στο FlyWeb. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT"/>%, επάνω <ph name="TOP"/>%</translation>
<translation id="8629055140319079166">Δεδομένα FlyWeb στον λογαριασμό σας</translation>
<translation id="1943161457314845496">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το FlyWeb στο τηλέφωνό σας</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="7978410129406361692">Εναλλαγή σε υπάρχον προφίλ FlyWeb;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="1568435374218487057">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>, συνδεθείτε στο FlyWeb</translation>
<translation id="3438772217992559640">Αναζήτηση αυτής της καρτέλας με την Αναζήτηση με εικόνες</translation>
<translation id="6301354573631022693">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το FlyWeb στο τηλέφωνό σας</translation>
<translation id="7625477329092296018">Προσαρμογή του FlyWeb…</translation>
<translation id="956833467923764542">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT"/> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">Με τη συντόμευση <ph name="SHORTCUT"/> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ FlyWeb</translation>
<translation id="6724485219247982027">Κλείστε όλα τα παράθυρα του FlyWeb και δοκιμάστε ξανά.</translation>
<translation id="5048962017649434283">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το FlyWeb στις Ρυθμίσεις συστήματος</translation>
<translation id="1582211253241551883">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="408747932595284596">Κωδικός QR για τη λήψη του προγράμματος περιήγησης FlyWeb σε κινητές συσκευές</translation>
<translation id="1413410454753055427">Υπενθύμιση: Οι καλύτερες λειτουργίες ασφαλείας της FlyWeb στην τσέπη σας</translation>
<translation id="7831730508158736496">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το FlyWeb στις Ρυθμίσεις συστήματος.</translation>
<translation id="9006158231572141726">Η Βελτιωμένη προστασία απενεργοποιεί τη βελτιστοποίηση JavaScript για ιστοτόπους που δεν αναγνωρίζει το FlyWeb</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">Σύνδεση στο FlyWeb</translation>
<translation id="6970052268542136081">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="2438845157914027912">Χρησιμοποιήστε τη <ph name="BEGIN_LINK"/>δική σας φράση πρόσβασης<ph name="END_LINK"/> για την κρυπτογράφηση όλων των δεδομένων FlyWeb στον Λογαριασμό σας FlyWeb. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το FlyWeb δεν θα συγχρονίζεται.</translation>
<translation id="6611602069520888180">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα FlyWeb</translation>
<translation id="2591356225047803326">Σύνδεση του FlyWeb και άλλων υπηρεσιών FlyWeb για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="1771882170639856394">Διαχείριση προφίλ FlyWeb</translation>
<translation id="3782148374606932577">Μάθετε γιατί το FlyWeb αποκλείει ορισμένες λήψεις</translation>
<translation id="4640643918757362950">Το FlyWeb θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="2179738813053854729">Το FlyWeb προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="5026502787439628947">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το FlyWeb για iOS και συνδεθείτε στον Λογαριασμό σας FlyWeb</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="5175060854726708547">Προσαρμογή και έλεγχος του FlyWeb. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="606156353708638647">Κάντε κλικ στο όνομά σας, για να ανοίξετε το FlyWeb και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="5145107420478372433">Ο χρήστης <ph name="EXISTING_USER"/> είναι συνδεδεμένος ήδη με αυτό το προφίλ FlyWeb. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το FlyWeb μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="8536259619256229278">Το FlyWeb προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="7965008434896274911">Για να έχετε πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="4540773594514226705">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας FlyWeb θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο FlyWeb, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="3849784651193576458">Μάθετε πώς σας προστατεύει το FlyWeb</translation>
<translation id="3967822245660637423">Ολοκλήρωση λήψης</translation>
<translation id="562495843857641474">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το FlyWeb στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="5667414856761616811">Σχετικά με το &amp;FlyWeb for Testing</translation>
<translation id="1152920704813762236">Σχετικά με το Chrome OS</translation>
<translation id="4920206821838432969">Όταν επισκέπτεστε έναν ιστότοπο, το FlyWeb στέλνει ένα παραμορφωμένο τμήμα του URL στην <ph name="BEGIN_LINK"/>Ασφαλή περιήγηση FlyWeb<ph name="END_LINK"/> μέσω ενός διακομιστή απορρήτου που αποκρύπτει τη διεύθυνση IP σας. Εάν ένας ιστότοπος κάνει κάτι ύποπτο, αποστέλλονται επίσης πλήρη URL και τμήματα περιεχομένου της σελίδας.</translation>
<translation id="4016217212818346953">Μείνετε ασφαλείς με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="3703994572283698466">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS"/>περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">Ανοίξτε συνδέσμους στο FlyWeb από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="504994999924593940">Συμβάλετε στη βελτίωση του FlyWeb, αναφέροντας τις <ph name="BEGIN_LINK"/>τρέχουσες ρυθμίσεις<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="4105099155797156500">Μετάβαση στη σελίδα Σχετικά με το FlyWeb</translation>
<translation id="7753744564324413106">Προσαρμόστε το FlyWeb για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="3202882878525816493">Π&amp;ροσαρμογή του FlyWeb</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου - FlyWeb</translation>
<translation id="6368928751841546993">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4007949387571083162">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το FlyWeb.</translation>
<translation id="4753212377237684548">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="4391959806766569994">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ FlyWeb στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="2564888740660198776">Να συνδεθούν τα δεδομένα σας στο FlyWeb με αυτόν το λογαριασμό;</translation>
<translation id="7337819873931851298">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η FlyWeb στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του FlyWeb.</translation>
<translation id="8391959103619318249">Αποσύνδεση από το FlyWeb</translation>
<translation id="8514458758262040082">Λήψη βοήθειας σχετικά με το FlyWeb</translation>
<translation id="4281844954008187215">Όροι παροχής υπηρεσιών</translation>
<translation id="3393587701694585022">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το FlyWeb εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="271336227467646058">Εξαγωγή κωδικών πρόσβασης από το FlyWeb</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="125418423241058931">Άνοιγμα του FlyWeb κατά την εκκίνηση των Windows</translation>
<translation id="4400772909124543403">Δεν υπάρχει διαθέσιμη ενημέρωση</translation>
<translation id="1376968889000878095">Να γίνει έξοδος από το FlyWeb ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="6360389033094512399">Να επιτρέπεται στο FlyWeb να εκτελείται στο παρασκήνιο</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{Το FlyWeb προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/>}other{Το FlyWeb προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">Προσαρμογή και έλεγχος του FlyWeb</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR"/></translation>
<translation id="1198322798411238228">Ο οργανισμός <ph name="MANAGER"/> διαχειρίζεται το FlyWeb</translation>
<translation id="6643422079097100220">Προσθήκη προφίλ FlyWeb</translation>
<translation id="8791209382165811772">Σχετικά με το FlyWeb for Testing</translation>
<translation id="5651107152880556886">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον Λογαριασμό σας FlyWeb, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="3546782282376530369">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το FlyWeb προτείνει να την καταργήσετε.</translation>
<translation id="834808339160590901">Καλωσορίσατε στο FlyWeb. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="5094033276783634414">Το FlyWeb χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="3363095592946520579">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS"/> σε άλλο προφίλ FlyWeb</translation>
<translation id="8767255662414713095">Το FlyWeb προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="5891777644455025808">Το FlyWeb απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="8775108347138515815">Δοκιμάστε το Google Lens με το FlyWeb στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="3349475100979552835">Εφαρμογές FlyWeb</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4970880042055371251">Έκδοση Chrome OS</translation>
<translation id="1936188352112244665">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το FlyWeb για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="7657326395720709145">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του FlyWeb, αλλά καθιστά το FlyWeb ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="7966026667528388481">Άνοιγμα Αναζήτησης με το FlyWeb</translation>
<translation id="7949810958067850297">Προφίλ FlyWeb</translation>
<translation id="2962574118577609024">Εάν κοινοποιείτε επίσης αναφορές χρήσης του FlyWeb, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="4673710618874938871">Συνδεθήκατε ως <ph name="USER_NAME"/>: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="9219132550163437762">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του FlyWeb (<ph name="PROCESS_ID"/>) σε άλλο υπολογιστή (<ph name="HOST_NAME"/>). Το FlyWeb έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το FlyWeb.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="6156840135417578237">Ορισμένα δεδομένα του FlyWeb δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας FlyWeb. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="1474749355173247622">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας FlyWeb στο FlyWeb. Η συντόμευση <ph name="SHORTCUT"/> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών FlyWeb.</translation>
<translation id="5227023869666757348">Κάποιο άτομο συνδέθηκε προηγουμένως στο FlyWeb σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST"/>. Δημιουργήστε έναν νέο χρήστη του FlyWeb, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="1671154647029930623">Να τερματιστεί η λειτουργία του FlyWeb ούτως ή άλλως;</translation>
<translation id="4143239505982500022">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το FlyWeb. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="82292346243148940">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το FlyWeb κατάργησε τις άδειες <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> και <ph name="COUNT"/> ακόμη.</translation>
<translation id="1802926274661855018">Εάν το Gemini στο FlyWeb είναι ανοικτό, το πλαϊνό πλαίσιο παραμένει ανοικτό κατά τη δημιουργία νέων καρτελών</translation>
<translation id="3469649164996417993">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση FlyWeb. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην FlyWeb. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="7460496601839821581">Χρήση του FlyWeb χωρίς λογαριασμό</translation>
<translation id="2991144524835127379">Εισερχόμενος κανόνας για το FlyWeb για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="6208903184719035736">Επανεκκίνηση για ενημέρωση του &amp;FlyWeb</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="5477235053075501816">Για να έχετε πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="7174589544844983914">Το FlyWeb εκτελείται στο παρασκήνιο.</translation>
<translation id="9212977598552218412">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του FlyWeb</translation>
<translation id="8366169706197332122">Με τα προφίλ του FlyWeb μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο FlyWeb. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="7792628702371319769">Οι επισκέπτες μπορούν να χρησιμοποιούν το FlyWeb χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="7370618680298767482">Ο λογαριασμός σας στο FlyWeb</translation>
<translation id="2760069255902967585">Προσθήκη του εαυτού σας στο FlyWeb</translation>
<translation id="504699503110800016">Ανοίξτε το μενού υπερχείλισης</translation>
<translation id="6686344057006524628">Αποκτήστε πρόσβαση σε όλες τις αγαπημένες λειτουργίες της FlyWeb με το FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="2515109138500267971">Το FlyWeb χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="3910606758302645363">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το FlyWeb κατάργησε τις άδειες <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> και <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="4326845160190496236">Ο λογαριασμός FlyWeb απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="3540715470656277664">Συνεχίστε ακριβώς από εκεί που είχατε σταματήσει με το FlyWeb σε iOS.</translation>
<translation id="291933003154435191">Αποσύνδεση από το FlyWeb</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="9098587825736815971">Αποκτήστε την εφαρμογή FlyWeb για να αποθηκεύετε κωδικούς πρόσβασης εν κινήσει</translation>
<translation id="8295539942024823191">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το FlyWeb</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="626007313130236514">Λήψη της εφαρμογής FlyWeb</translation>
<translation id="5361365805808004630">Αναζήτηση με το FlyWeb</translation>
<translation id="8888283148421206435">Εσωτερική υπηρεσία FlyWeb Updater</translation>
<translation id="3025882852178035952">Χρησιμοποιήστε τις μαζί με άλλες λειτουργίες του Gemini στο FlyWeb</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="8330248712705246714">Δείτε μια γρήγορη επισκόπηση αυτού του εγγράφου και κάντε ερωτήσεις με το Gemini στο FlyWeb</translation>
<translation id="6178233095056047786">Το FlyWeb εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="8980390875915032396">Άλλα προφίλ FlyWeb</translation>
<translation id="2441009746272048284">Δεν ήταν δυνατή η αποθήκευση δεδομένων FlyWeb στον Λογαριασμό σας FlyWeb από το ChromeOS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα</translation>
<translation id="8449603408481238073">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο FlyWeb. Τα δεδομένα σας στο FlyWeb, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών FlyWeb, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">Για εξατομίκευση, συμπεριλάβετε το FlyWeb στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="1456957080321742545">Άνοιγμα αναζήτησης με το FlyWeb</translation>
<translation id="1026219128963768190">Μάθετε γιατί το FlyWeb αποκλείει ορισμένα αρχεία</translation>
<translation id="1284798564810038820">Ενημέρωση του FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="4384293746734222420">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="3872448231555118416">Να επιτρέπεται η σύνδεση στο FlyWeb</translation>
<translation id="1827750898515917134">Κατάργηση από το FlyWeb</translation>
<translation id="7460715011003906078">Μειώνει την απόδοση αλλά καθιστά το FlyWeb πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="5020755920249060562">Ορισμός του FlyWeb ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb Beta</translation>
<translation id="1842654828911709974">{NUM_TABS,plural, =1{Το FlyWeb συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το FlyWeb συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="5385202369020319636">Το FlyWeb ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="362367838300880777">Το FlyWeb απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="2183749398075655200">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το FlyWeb.</translation>
<translation id="8996657165865563765">Το FlyWeb προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="832204641669191126">Εργαστείτε απρόσκοπτα με τις αγαπημένες σας εφαρμογές, όπως το Google Drive και το YouTube, εν κινήσει με το FlyWeb.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT"/>%, επάνω <ph name="TOP"/>%</translation>
<translation id="5738298079259740925">Άνοιγμα PDF στο FlyWeb</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK"/>σχετικά με αυτή την καρτέλα</translation>
<translation id="6197315294677032380">Για λόγους ασφαλείας, το FlyWeb απενεργοποιεί τη βελτιστοποίηση JavaScript όταν επισκέπτεστε έναν ιστότοπο για πρώτη φορά.

Εάν αυτή η σελίδα δεν λειτουργεί με τον αναμενόμενο τρόπο, δοκιμάστε να επιτρέψετε τη βελτιστοποίηση.</translation>
<translation id="2009834183541338014">Εμφάνιση του Gemini στο FlyWeb στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="1307223624786767430">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από <ph name="DEVICE"/>.</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="4770353132265458564">Χρήση FlyWeb από προεπιλογή και καρφίτσωμα</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="6096945112863785306">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του FlyWeb}=1{Υπάρχει μια διαθέσιμη ενημέρωση του FlyWeb}other{Υπάρχει μια διαθέσιμη ενημέρωση του FlyWeb για # ημέρες}}</translation>
<translation id="7698117871740446964">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το FlyWeb</translation>
<translation id="5666891644992637849">Επανεκκινήστε το FlyWeb τώρα</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Να εμφανίζεται το FlyWeb σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="5406894461513282158">Το FlyWeb αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το FlyWeb γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK"/></translation>
<translation id="4909672456103357452">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK"/> τα δεδομένα του FlyWeb στον λογαριασμό σας</translation>
<translation id="4985665094509307744">Προσαρμογή και έλεγχος του FlyWeb. Ορίστε το FlyWeb ως προεπιλογή.</translation>
<translation id="6646499372922411025">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές, ορίζοντας το FlyWeb ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="5890196138054330443">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του FlyWeb, αλλά καθιστά το FlyWeb ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="8651664269417935890">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον Λογαριασμό σας FlyWeb, ενημερώστε το FlyWeb</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="8331941171144629807">Καλώς ήρθατε στο FlyWeb</translation>
<translation id="5831968418530309689">Ενεργοποιεί πρόσθετες λειτουργίες για την παροχή των ισχυρότερων μέτρων προστασίας του FlyWeb</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="7581082856615467651">Το FlyWeb εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="8117102597407263352">Το FlyWeb ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="7740963625398321937">Gemini Enterprise στο FlyWeb</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="6669708050135513710">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb</translation>
<translation id="3358004031263458708">Εξατομίκευση του FlyWeb</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="5977420883993828287">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά τις Εργασίες με βάση τα συμφραζόμενα από τη γραμμή εργαλείων</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το FlyWeb όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="4955869506208896934">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το FlyWeb</translation>
<translation id="5990360079535151574">Από το κουμπί Εργασίες με βάση τα συμφραζόμενα στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS"/> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="4530644097272078700">Αξιοποιήστε περισσότερο τις ηλεκτρονικές αγορές όταν χρησιμοποιείτε την εφαρμογή FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="619330138913595431">Για την προστασία των δεδομένων σας, επιτρέψτε στο FlyWeb να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="8714139918792771260">&amp;Άνοιγμα στο FlyWeb</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="499541338626558192">Η επέκταση <ph name="EXTENSION_NAME"/> έχει προστεθεί στο FlyWeb</translation>
<translation id="5880307616068888895">Προσαρμόστε και ελέγξτε το FlyWeb. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="1429530657225981960">Ενεργή • Το FlyWeb δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="8056369489402655495">Ο λογαριασμός σας στο FlyWeb</translation>
<translation id="1683225514126450592">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του FlyWeb</translation>
<translation id="4809579265564854985">Το αρχείο <ph name="FILE_NAME"/> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="1773252983747911987">Το FlyWeb θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="1686760912855738719">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας FlyWeb</translation>
<translation id="5461795497268691356">Εάν επιτρέπεται η λήψη cookie, το FlyWeb μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="1292852397592425449">Διαγράψετε τα δεδομένα του FlyWeb στον λογαριασμό σας</translation>
<translation id="7031783851441272920">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK"/>Το FlyWeb μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση FlyWeb, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="4403968929742079769">Βεβαιωθείτε ότι έχετε συνδεθεί στο FlyWeb στη συσκευή σας <ph name="TARGET_DEVICE_NAME"/> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="8345188246355148375">Αναζητήστε και κάντε ερωτήσεις από οπουδήποτε, ακόμα και αν το FlyWeb είναι ελαχιστοποιημένο. Επιτρέπει στο FlyWeb να εκτελείται στο παρασκήνιο.</translation>
<translation id="1855179706668101462">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του FlyWeb. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το FlyWeb και κατεβάστε το ξανά.</translation>
<translation id="651290634887454330">{0,plural, =0{Η επανεκκίνηση του FlyWeb θα γίνει τώρα}=1{Η επανεκκίνηση του FlyWeb θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του FlyWeb θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="2586408713760853791">Το FlyWeb χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="1603558835003845196">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο FlyWeb</translation>
<translation id="5751080530525677552">Ορισμός FlyWeb ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6248988683584659830">Αναζήτηση ρυθμίσεων</translation>
<translation id="6342238100521499844">Αποκτήστε τις καλύτερες λειτουργίες ασφάλειας της FlyWeb εν κινήσει, με την εφαρμογή FlyWeb στο τηλέφωνό σας</translation>
<translation id="3542157007113577464">Θέλετε να αποσυνδεθείτε από το FlyWeb;</translation>
<translation id="2166321493116256664">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο FlyWeb να τις απενεργοποιήσει.</translation>
<translation id="3794967601634523398">Προσαρμόστε το προφίλ σας FlyWeb</translation>
<translation id="6475001900959697061">Ονομάστε το προφίλ σας στο FlyWeb</translation>
<translation id="6356094940346377065">Μια επέκταση θέλει να συνδεθείτε στο FlyWeb</translation>
<translation id="4465156155012748592">Το αρχείο <ph name="FILE_NAME"/> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="5523868569707953059">Το FlyWeb χρησιμοποιεί την κάμερά σας.</translation>
<translation id="8226838065217375546">Μια άλλη λειτουργία στο FlyWeb βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6063700568539132984">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το FlyWeb με το Λογαριασμό σας FlyWeb και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="5622088198573179705">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το FlyWeb ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="4709797814274745581">Συντόμευση FlyWeb</translation>
<translation id="6595693843242836271">Το FlyWeb απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="6890209090736444656">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του FlyWeb;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="8407518452288816185">Για να συνεχίσετε, συνδεθείτε στο FlyWeb ως <ph name="EMAIL"/>. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="2104550252781001709">Λογότυπο FlyWeb μέσα σε οθόνη υπολογιστή.</translation>
<translation id="6636986997730784876">Το FlyWeb είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="4359872290500912570">Για να βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε και να αποθηκεύετε πάντα δεδομένα FlyWeb στον Λογαριασμό σας FlyWeb, επαληθεύστε την ταυτότητά σας</translation>
<translation id="3141715584864891679">Το FlyWeb εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2139300032719313227">Επανεκκίνηση Chrome OS</translation>
<translation id="7560906925528428585">Το FlyWeb προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="5806916401157869650">Κατεβάστε το FlyWeb στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="2970877059928503461">Ανενεργή • Το FlyWeb δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="173462352822069427">Καλώς ήρθατε στα προφίλ του FlyWeb</translation>
<translation id="8914008746092110409">Την επόμενη φορά που θα ανοίξετε το FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="3484308111967198595">Κατάργηση λογαριασμού από το FlyWeb</translation>
<translation id="1474676525193357364">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="5777905264835557372">Απεγκατάσταση FlyWeb</translation>
<translation id="764623543427374554">Οι συντομεύσεις ανοίγουν στο FlyWeb</translation>
<translation id="8852057261917278552">Ο οργανισμός σας κλείνει το FlyWeb όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="8592211619057897362">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο FlyWeb, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="6556755379298048869">Κάντε αναζήτηση με συντόμευση πληκτρολογίου.</translation>
<translation id="4273595998837775033">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK"/>πώς το FlyWeb διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK"/></translation>
<translation id="654107331777480705">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του FlyWeb.</translation>
<translation id="3594828538355548672">Διαχειριστείτε τις επεκτάσεις σας, κάνοντας κλικ στην επιλογή Επεκτάσεις στο κύριο μενού του FlyWeb.</translation>
<translation id="7489092380688543560">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ FlyWeb</translation>
<translation id="472958395762114471">Χρησιμοποιήστε την εφαρμογή FlyWeb για να έχετε μαζί σας τα καλύτερα εργαλεία AI</translation>
<translation id="8243012192239086369">Για τη διόρθωση ορθογραφικών λαθών, το FlyWeb στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο FlyWeb</translation>
<translation id="3927263773110604886">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του FlyWeb</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="6888846095017247017">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το FlyWeb.</translation>
<translation id="4481788155537463533">Το FlyWeb ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="1116311888485102603">Συνεχίστε από εκεί που σταματήσατε: Το FlyWeb έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="1886169834787876002">Το FlyWeb χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="7570986009744020649">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας FlyWeb, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο FlyWeb και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="1363996462118479832">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="5743696427773796626">Κατάργηση των δεδομένων αυτής της εφαρμογής από το FlyWeb</translation>
<translation id="4152880912192471857">Το FlyWeb χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του FlyWeb.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του FlyWeb.</translation>
<translation id="5528558621229392814">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το FlyWeb στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες FlyWeb</translation>
<translation id="7728046102681268859">Το FlyWeb είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="2006421382007321898">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας FlyWeb αφού συνδεθείτε.</translation>
<translation id="4328426102261301637">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του FlyWeb, αλλά καθιστά το FlyWeb ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="207175655966839154">{count,plural, =1{Ορισμένα δεδομένα του FlyWeb δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας FlyWeb. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του FlyWeb δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας FlyWeb. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="1292831930742306370">Το FlyWeb συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="1547295885616600893">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="6432682256389755533">Το FlyWeb σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME"/> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="6869568587896659271">Εύκολη πρόσβαση σε ιστοτόπους κάτω από τη γραμμή διευθύνσεων</translation>
<translation id="4695676871328690599">Το FlyWeb εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME"/>.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT"/>%, κάτω <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6898028264630240901">Μπορείτε να καρφιτσώσετε τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="8416061171168102237">Ορίστε το FlyWeb ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="3503126745419877918">&amp;Διαχείριση προφίλ FlyWeb</translation>
<translation id="4397299252625349918">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS"/>
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK"/>
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK"/>
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAK"/>
            • Θα επαναφέρει τις συντομεύσεις του FlyWeb
            <ph name="LINE_BREAKS"/>
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="2640214066670118583">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT"/> σελιδοδεικτών του FlyWeb, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας FlyWeb.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="3453763134178591239">Όροι του Chrome OS</translation>
<translation id="1163386134146281359">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">Προσαρμόστε το FlyWeb για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="3945284827084409390">Ενημέρωση FlyWeb</translation>
<translation id="7886270027101123253">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το FlyWeb θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην FlyWeb.</translation>
<translation id="8434939140421950539">Αξιοποιήστε τη δύναμη του AI όταν χρησιμοποιείτε την εφαρμογή FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="2647329478963461727">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή FlyWeb στο τηλέφωνό σας</translation>
<translation id="5695394421048248926">Προσαρμογή του FlyWeb for Testing</translation>
<translation id="6802544479988856975">Μπορείτε να χρησιμοποιείτε το FlyWeb κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="8694083743003679818">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME"/> από το FlyWeb</translation>
<translation id="6017914745388312119">Ο οργανισμός σας διαγράφει τα δεδομένα του FlyWeb όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION"/>. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="3283953248242339756">Το FlyWeb χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="4729674580260824908">Δεν ήταν δυνατή η εκκίνηση του FlyWeb. Προσπάθησε ξανά.</translation>
<translation id="805403942934515799">Ρωτήστε οτιδήποτε, όπου κι αν βρίσκεστε, με το Gemini στο FlyWeb</translation>
<translation id="7093403858436459499">Διατηρήστε το FlyWeb στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="935820624106805690">Χρησιμοποιήστε το FlyWeb κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7216228761061470870">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες σε υπολογιστή, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή</translation>
<translation id="1678436729108859736">Διαχείριση Εργασιών - FlyWeb</translation>
<translation id="7587087358591725059">Ρωτήστε σχετικά με περιεχόμενο εκτός του FlyWeb, όπως για άλλες εφαρμογές ή αρχεία</translation>
<translation id="7013534648688018698">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4889865510625659193">Ξεκινήστε άμεσα την περιήγηση: Το FlyWeb μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{Το FlyWeb προτείνει να την καταργήσετε}other{Το FlyWeb προτείνει να τις καταργήσετε}}</translation>
<translation id="5321339461210685340">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το FlyWeb. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το FlyWeb.</translation>
<translation id="7299899569525778554">Αναζήτηση από υπολογιστή</translation>
<translation id="2866611433272355726">Ενημέρωση του FlyWeb</translation>
<translation id="5013690772358862887">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το FlyWeb δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7324051657739063017">Μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="1123144153876435088">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του FlyWeb.</translation>
<translation id="8915041713909379783">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην FlyWeb, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK"/>διαγράψετε τα δεδομένα του FlyWeb στον λογαριασμό σας<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">Ο διαχειριστής συστήματος έχει διαμορφώσει το FlyWeb ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME"/> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="7601756527349047847">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="3916387280110223245">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το FlyWeb κατάργησε τις άδειες <ph name="PERMISSION_1"/> και <ph name="PERMISSION_2"/>.</translation>
<translation id="3313237823190188892">Εμφάνιση του Gemini στο FlyWeb στην περιοχή ειδοποιήσεων</translation>
<translation id="7401687852903179959">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="6624551989332401777">Το FlyWeb είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="277733508197886564">Συνεχίστε από το σημείο που σταματήσατε: Το FlyWeb επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="948152006162936800">Εισαγωγή κωδικών πρόσβασης στο FlyWeb</translation>
<translation id="4755314372270379254">1. Κάντε κλικ στο κουμπί <ph name="BUTTON_LABEL"/> παρακάτω
2. Κάντε κλικ στο κουμπί <ph name="BUTTON_2"/> στις ρυθμίσεις των Windows
3. Κάντε κλικ στο κουμπί <ph name="BUTTON_3"/> στην ειδοποίηση των Windows για να καρφιτσώσετε το FlyWeb στη γραμμή εργαλείων για γρήγορη πρόσβαση</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="7472280958921965834">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο FlyWeb στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="2431618580332826398">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="2154651873647244914">Επανεκκίνηση του FlyWeb;</translation>
<translation id="3137757192868162370">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του FlyWeb που εκτελείται αυτήν τη στιγμή. Κλείστε το FlyWeb και δοκιμάστε ξανά.</translation>
<translation id="3065486555702061722">Υπενθύμιση: Οι καλύτερες λειτουργίες της FlyWeb στην τσέπη σας</translation>
<translation id="4027434552262956425">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του FlyWeb, εκτός από τον Λογαριασμό σας FlyWeb εάν είστε συνδεδεμένοι στο FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{Η επανεκκίνηση του FlyWeb θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του FlyWeb θα γίνει σε # λεπτά}}</translation>
<translation id="301074550630080641">Για την προστασία των δεδομένων σας, επιτρέψτε στο FlyWeb να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="3930051800510118744">Ανοίξτε αυτόματα το FlyWeb, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">Το FlyWeb χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="1381291360713116383">Το FlyWeb έγινε ακόμα καλύτερο</translation>
<translation id="3892366519980032442">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο FlyWeb</translation>
<translation id="7624307931717240213">Χρησιμοποιούμε πληροφορίες για τη βελτίωση αυτής της υπηρεσίας. Ανατρέξτε στην Πολιτική απορρήτου και στους Όρους παροχής υπηρεσιών.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="7733015548570443346">Λήψη της εφαρμογής FlyWeb</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="2230101319599356673">Το FlyWeb δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="3243257760331619874">Συγχρονίστε και εξατομικεύστε το FlyWeb στις συσκευές σας</translation>
<translation id="3836891631266228927">Ενημέρωση FlyWeb</translation>
<translation id="7362833186911891234">Η εργασία σας προστατεύεται στο FlyWeb</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME"/>. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="1549877678317463759">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο FlyWeb ως <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="104221467268393661">Επαναφορά της προεπιλογής FlyWeb</translation>
<translation id="2414061498125565915">Για την προστασία της εργασίας σας στο FlyWeb, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες όταν είστε συνδεδεμένοι στο FlyWeb.</translation>
<translation id="494195283222791090">Ορίστε το FlyWeb ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="134973275687829726">Κάντε το FlyWeb πιο γρήγορο</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το FlyWeb χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="6059158364953614237">Επιλέξτε τι θα κοινοποιείτε στο FlyWeb</translation>
<translation id="8463540467315366872">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ FlyWeb με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="3682929584258119691">Η μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του FlyWeb. Για την προστασία σας, το FlyWeb την επανέφερε στην αρχική προεπιλογή. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">Προσαρμόστε το FlyWeb για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="8611872055947278722">Δεν ήταν δυνατή η ενημέρωση του FlyWeb στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS"/> δευτερόλεπτα.</translation>
<translation id="3999247564452560622">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK"/>διαγράψτε τα δεδομένα του FlyWeb στον λογαριασμό σας<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">Ανοίξτε γρήγορα το Gemini στο FlyWeb όποτε το χρειάζεστε</translation>
<translation id="6798431672720500005">Ορισμός του FlyWeb ως προεπιλογής</translation>
<translation id="332151924263389003">Το FlyWeb αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="3096730275883527801">Συνδεθήκατε στο FlyWeb ως <ph name="USER_EMAIL_ADDRESS"/>. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="7097534420680357688">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="9017338699075596174">Αυτή είναι μια δευτερεύουσα εγκατάσταση του FlyWeb και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2888168499066553233">Αξιοποιήστε τις καλύτερες λειτουργίες της FlyWeb με την εφαρμογή FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="5944585442866020176">Όταν το FlyWeb αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="4462215250900528778">Καρφιτσώστε το FlyWeb στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="8069447462453318634">Επιλέξτε "Καρφίτσωμα στη γραμμή εργαλείων"</translation>
<translation id="3685797926747054412">Απενεργοποίηση του FlyWeb, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> – FlyWeb for Testing</translation>
<translation id="3263664073045388929">Το FlyWeb χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="5289593085778678155">Την επόμενη φορά που θα ανοίξετε το FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="7635444121786764725">Λάβετε ειδοποιήσεις για πτώση τιμής σε προϊόντα που σας ενδιαφέρουν με την εφαρμογή FlyWeb στο τηλέφωνό σας</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="5770057404954060005">Εξατομικεύστε το FlyWeb</translation>
<translation id="5334309298019785904">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="6992240065504496864">Ανοίξτε το Gemini στο FlyWeb με μια συντόμευση πληκτρολογίου.</translation>
<translation id="6334554715655789744">Πρόσθετοι όροι παροχής υπηρεσιών του FlyWeb</translation>
<translation id="1597323875619800374">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το FlyWeb.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="2214224574148863941">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον λογαριασμό σας, <ph name="USER_EMAIL"/></translation>
<translation id="820759916613250543">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="2459467374982542273">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο FlyWeb στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="4749458995158778066">Το FlyWeb δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το FlyWeb, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="6756872644564483342">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το FlyWeb θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην FlyWeb. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="9179486248398668702">Σύνδεση στο FlyWeb με νέο προφίλ;</translation>
<translation id="1470002120352085290">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο FlyWeb με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία από <ph name="DEVICE"/>.</translation>
<translation id="8901123396574346662">Εμφάνιση του Gemini στο FlyWeb στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="9102959605052547519"><ph name="BEGIN_LINK"/>Το FlyWeb σας προειδοποιεί<ph name="END_LINK"/> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="669999719045196468">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το FlyWeb κατάργησε την άδεια <ph name="PERMISSION"/>.</translation>
<translation id="7136168924180047124">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή FlyWeb iOS</translation>
<translation id="867002910715789721">Κωδικός QR για σύνδεση στο FlyWeb ως <ph name="USER_NAME"/></translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">Ο οργανισμός σας κλείνει το FlyWeb όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="9174706677133564856">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS"/> χρησιμοποιούσε το FlyWeb στο παρελθόν</translation>
<translation id="7009033378151348624">Ενεργοποίηση Δεξιοτήτων στο FlyWeb</translation>
<translation id="338142060986183805">Ενημερώστε το FlyWeb, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του FlyWeb στον Λογαριασμό σας FlyWeb, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7408894216012529448">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="5020916672477085422">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο FlyWeb. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας FlyWeb αφού συνδεθείτε.</translation>
<translation id="5417365165109189454">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το FlyWeb.</translation>
<translation id="4212474799248200893">Το FlyWeb προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το FlyWeb, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="3669395395617655404">Το FlyWeb πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας FlyWeb και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="5261590792975521002">{0,plural, =1{Επανεκκίνηση του FlyWeb σε μία ημέρα}other{Επανεκκίνηση του FlyWeb σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο FlyWeb</translation>
<translation id="3101564993057563365">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="5316851838033144902">Το FlyWeb απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="6760691951531758781">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chrome OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην FlyWeb.</translation>
<translation id="2523037024749170569">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα FlyWeb στον Λογαριασμό σας FlyWeb, επαληθεύστε την ταυτότητά σας</translation>
<translation id="5989540778099253163">Εμφάνιση οδηγιών για σύνδεση στο FlyWeb</translation>
<translation id="6852836260419236265">Το FlyWeb δεν είναι ενημερωμένο</translation>
<translation id="360892078644515524">Σας ευχαριστούμε που ορίσατε το FlyWeb ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="797182360653885317">Το FlyWeb μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="8525579356836940628">Η εγκατάσταση διακόπηκε</translation>
<translation id="8340284327429540526">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="7498776423722712116">Λάβετε ειδοποίηση, εάν το FlyWeb εντοπίσει έναν από τους κωδικούς πρόσβασής σας σε μια δημόσια παραβίαση δεδομένων</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">Ορισμένες λειτουργίες και επεκτάσεις του FlyWeb διαθέτουν συντομεύσεις. Μπορείτε να επιλέξετε να τις ενεργοποιήσετε ξανά.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="5128162742812353891">Πολλοί οργανισμοί διαχειρίζονται το FlyWeb</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="7129578417724116642">Εκκίνηση του FlyWeb…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="5469043671012993003">Το FlyWeb for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="3892251159131070138">Αναζήτηση με το FlyWeb από οπουδήποτε</translation>
<translation id="1514450422236300417">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του FlyWeb ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="573490495087487940">Ορίστε το δικό σας FlyWeb</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="2666961286257416158">Σύνδεση στο FlyWeb;</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT"/>%, κάτω <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="4243214377720481697">Μοιραστείτε αυτό το έγγραφο με το Gemini στο FlyWeb για να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="6808406663598665473">Σύνδεση στο FlyWeb;</translation>
<translation id="7022252178852457880">Ορισμός FlyWeb ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="6933858244219479645">Σύστημα Chrome OS</translation>
<translation id="1501202286854500367">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο FlyWeb</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="2405293075272280413">Προσθήκη προφίλ FlyWeb</translation>
<translation id="2096285611267043007">Δεν ήταν δυνατή η αποθήκευση δεδομένων FlyWeb στον Λογαριασμό σας FlyWeb από το ChromeOS λόγω σφάλματος κατά τη σύνδεση</translation>
<translation id="9046344742397901138">Ο οργανισμός σας απαιτεί να συνδεθείτε στο FlyWeb</translation>
<translation id="4669168852412989042">Το FlyWeb προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="2704405030486981087">Το FlyWeb δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το FlyWeb ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="1663379621921336006">Δεν είναι δυνατή η ενημέρωση του FlyWeb</translation>
<translation id="8944232836376404813">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS"/>
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK"/>
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK"/>
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS"/>
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="188856534838382513">Εμφάνιση συντομεύσεων ιστοτόπων στο FlyWeb</translation>
<translation id="543915850302643692">Λογότυπο FlyWeb Enterprise</translation>
<translation id="4417647437359346154">Απολαύστε την ασφάλεια της FlyWeb εν κινήσει με την εφαρμογή FlyWeb στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="6976267397714240800">Δεν είναι δυνατή η έναρξη του FlyWeb, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το FlyWeb.</translation>
<translation id="8952346994182255880">για αναζήτηση με το FlyWeb ή προσαρμογή στις <ph name="BEGIN_LINK"/>Ρυθμίσεις<ph name="END_LINK"/></translation>
<translation id="8422308271795251425">Διαχείριση προφίλ FlyWeb</translation>
<translation id="519942585686549229">Χρησιμοποιήστε το πληκτρολόγιό σας για να πλοηγηθείτε μεταξύ του Gemini στο FlyWeb και της ανοιχτής καρτέλας σας.</translation>
<translation id="9018218886431812662">Η εγκατάσταση ολοκληρώθηκε</translation>
<translation id="5804408305184682593">Σύνδεση στο FlyWeb</translation>
<translation id="7410599202980023102">Εμφάνιση της αναζήτησης με το FlyWeb στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="2138383893834402906">Το FlyWeb απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="8884768769854521848">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το FlyWeb ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το FlyWeb θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="3668027737318668659">Χρησιμοποιήστε τα καλύτερα εργαλεία AI της FlyWeb με την εφαρμογή FlyWeb στο τηλέφωνό σας</translation>
<translation id="1257818515846885633">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE"/>, συνδεθείτε στο FlyWeb</translation>
<translation id="7813768067688376455">Σύνδεση στο FlyWeb όταν συνδέεστε σε άλλες υπηρεσίες FlyWeb</translation>
<translation id="8323442969389928559">Το FlyWeb έκλεισε αυτόματα</translation>
<translation id="7626272203917389133">Το FlyWeb δεν είναι ενημερωμένο</translation>
<translation id="1789655708880997767">{0,plural, =1{Η επανεκκίνηση του FlyWeb θα γίνει σε μία ώρα}other{Η επανεκκίνηση του FlyWeb θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="8970147445441095618">Για τη λήψη μελλοντικών ενημερώσεων του FlyWeb, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="1208237657860748752">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα FlyWeb</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="1592415213971909403">Συνεχίστε από το σημείο που σταματήσατε: Το FlyWeb μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="3926534790663909774">Ο διαχειριστής συστήματος έχει διαμορφώσει το FlyWeb έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="5022081608392609959">Επανεκκίνηση για ενημέρωση του &amp;FlyWeb</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Εξατομίκευση του FlyWeb</translation>
<translation id="3410331617397516204">Το FlyWeb μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="3613308994653366133">Μεταφέρετε μαζί σας τις καλύτερες λειτουργίες ασφαλείας της FlyWeb με το FlyWeb.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="1127626874097952395">Ποιος χρησιμοποιεί το FlyWeb;</translation>
<translation id="1626113414414104077">Λάβετε την ισχυρότερη προστασία του FlyWeb</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="839475718250652248">Χρήση του FlyWeb χωρίς λογαριασμό</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="7783156808075587495">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο FlyWeb στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">Η εγκατάσταση απέτυχε λόγω μη καθορισμένου σφάλματος. Κατεβάστε το FlyWeb ξανά.</translation>
<translation id="2725795635123877647">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το FlyWeb συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="5840822070878669614">Ανοίξτε το Διαδικτυακό κατάστημα</translation>
<translation id="3470813199863172076">Η επέκταση αυτή παραβιάζει την πολιτική του διαδικτυακού καταστήματος. Αφαιρέστε τη από τον FlyWeb, για να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα στους ιστότοπους που επισκέπτεστε, ούτε τα προσωπικά στοιχεία σας.</translation>
<translation id="5382847955032513683">Προειδοποίηση: Το FlyWeb δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτήν την επέκταση σε Ιδιωτική λειτουργία, καταργήστε αυτήν την επιλογή.</translation>
<translation id="543905389684998697">Για να κάνουμε το FlyWeb πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="3914570680366033593">Για να κάνουμε το FlyWeb πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="2742103213766991703">Ανοίξτε τον σύνδεσμο σε &amp;ιδιωτικό παράθυρο FlyWeb</translation>
<translation id="5606966092070089147">Άνοιγμα συνδέσμου στο FlyWeb &amp;σε παράθυρο ανώνυμης περιήγησης</translation>
<translation id="1616978953472841483">Άνοιγμα συνδέσμου σε &amp;Ιδιωτικό παράθυρο FlyWeb</translation>
<translation id="2050263926423290804">{COUNT, plural,
          =0 {Μια νέα ενημέρωση για το FlyWeb είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}
          =1 {Μια νέα ενημέρωση για το FlyWeb είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
          other {Μια νέα ενημέρωση για το FlyWeb είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="8494512118209691256">Αυτό θα σας επιτρέψει να κοινοποιείτε περιεχόμενο από το FlyWeb στις τοπικές σας συσκευές, όπως μια τηλεόραση ή ένας ηχείο.</translation>
<translation id="7488914907489544218">{COUNT, plural,
              =0 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το FlyWeb για να εφαρμόσετε αυτήν την ενημέρωση}
              =1 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το FlyWeb για να εφαρμόσετε αυτήν την ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας ζητά να επανεκκινήσετε το FlyWeb για να εφαρμόσετε αυτήν την ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7568541461974616693">{COUNT, plural,
              =0 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση}
              =1 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="6998204082704836463">{COUNT, plural,
              =0 {Η προηγμένη προστασία απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση}
              =1 {Η προηγμένη προστασία απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση. Το ιδιωτικό σας παράθυρο δεν ανοίγει ξανά.}
              other {Η Προστασία για προχωρημένους απαιτεί να επανεκκινήσετε το FlyWeb για να εφαρμόσετε μια ενημέρωση. Τα # ιδιωτικά παράθυρα δεν ανοίγουν ξανά.}}</translation>
<translation id="5749154344207139683">Βοηθήστε μας να βελτιώσουμε το Private, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="4766381896251401675">Όταν πληκτρολογείτε κάτι στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το FlyWeb στέλνει το περιεχόμενο που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησής σας για να λαμβάνετε καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ιδιωτική λειτουργία.</translation>
<translation id="2832552148674305108">Ιδιωτική λειτουργία FlyWeb</translation>
<translation id="611606920944085547">Κατά την Ανώνυμη Περιήγηση, ο FlyWeb θα σας προειδοποιεί πριν φορτώσετε κάποια ιστοσελίδα με μη ασφαλή σύνδεση</translation>
</translationbundle>