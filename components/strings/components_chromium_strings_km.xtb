<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="130631256467250065">ការប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលអ្នកចាប់ផ្តើមឧបករណ៍របស់អ្នកឡើងវិញពេលបន្ទាប់។</translation>
<translation id="125853961893919199">គន្លឹះ FlyWeb៖ រក្សាទុក​ពាក្យ​សម្ងាត់</translation>
<translation id="1589233279653618219">ចូល​ទៅកាន់​ម៉ឺនុយ FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ហើយ​ត្រូវប្រាកដថា​ការកំណត់រចនាសម្ព័ន្ធ​របស់អ្នក​ត្រូវបាន​កំណត់ទៅ "គ្មាន​ប្រូកស៊ី" ឬ "ដោយផ្ទាល់"។</translation>
<translation id="8359495463485001719">ការរាយការណ៍ពីការគាំងមិនមាននៅក្នុង FlyWeb ទេ។</translation>
<translation id="6338530717474923868">អ្នក​កំពុង​មើល​ទំព័រ FlyWeb ដែល​មាន​សុវត្ថិភាព</translation>
<translation id="5147169001159408844">FlyWeb កំពុងព្យាយាម​កែប្រែ​ការកំណត់​សម្រាប់​ការបំពេញ​វិធីបង់ប្រាក់។</translation>
<translation id="5702992568540613683">និមិត្តសញ្ញា FlyWeb</translation>
<translation id="8966580353365544289">គន្លឹះ FlyWeb៖ ការរុករក​ដោយសុវត្ថិភាពបន្ថែម</translation>
<translation id="510342522494506803">FlyWeb កំពុង​ព្យាយាម​កែ​វិធីបង់ប្រាក់។</translation>
<translation id="8375862260948854624">FlyWeb អាចបង្កើតឡើងបានដោយគម្រោងប្រភពបើកចំហរ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> និង <ph name="BEGIN_LINK_OSS"/>កម្មវិធីប្រភពបើកចំហរ<ph name="END_LINK_OSS"/> ផ្សេងទៀត។</translation>
<translation id="5040124620086808431">ទំព័រនេះត្រូវបានទប់ស្កាត់ដោយ FlyWeb</translation>
<translation id="1953000035868532675">អនុញ្ញាតឲ្យ FlyWeb ចូលប្រើបណ្តាញនៅក្នុងការកំណត់ firewall ឬកម្មវិធីកម្ចាត់មេរោគ
        របស់អ្នក។</translation>
<translation id="4949828774841497663">ចូល​ទៅកាន់ កម្មវិធី &gt; ការកំណត់​ប្រព័ន្ធ &gt; បណ្ដាញ ជ្រើសរើស​បណ្តាញ​ដែលកំពុង​ដំណើរការ ចុច​ប៊ូតុង​ព័ត៌មានលម្អិត រួច​ដក​ការ​ជ្រើសរើស​ប្រូកស៊ីដែលអាច​ត្រូវបាន​ជ្រើសរើស។</translation>
<translation id="7584668345330431749">ចូលទៅកាន់​ម៉ឺនុយ FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          បណ្ដាញ និង​អ៊ីនធឺណិត &gt; ប្រូកស៊ី
          ហើយ​ដក​ការ​ជ្រើសរើស "ចាប់ដឹងការកំណត់​ដោយ​ស្វ័យប្រវត្តិ"។</translation>
<translation id="3145451630329266064">ទំព័រ​ទាំងនេះ​គឺសម្រាប់ប្រើ​ដោយ​អ្នក​អភិវឌ្ឍន៍ FlyWeb និង​ប្រហែលជា​មិនត្រូវបាន​ថែទាំ ឬ​ធ្វើតេស្ត​យ៉ាងសកម្ម​នោះទេ។ ដើម្បី​បើក​ទំព័រ​ទាំងនេះ សូម​ទៅកាន់ <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, ចុចប៊ូតុង ដើម្បីបើក​ទំព័រ​ជួសជុល បន្ទាប់មក​ទៅកាន់​ទំព័រនេះ​ម្ដងទៀត។</translation>
<translation id="2681118099728446983">FlyWeb អាច​បង្កើត​ឡើង​បាន​ដោយ<ph name="BEGIN_LINK_OSS"/>កម្មវិធីកូដ​ចំហ<ph name="END_LINK_OSS"/>ផ្សេង​ទៀត​ផងដែរ។</translation>
<translation id="6888846095017247017">ការផ្លាស់ប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលបើកដំណើរការ FlyWeb ឡើងវិញពេលក្រោយ។</translation>
<translation id="8524328905288851065">FlyWeb ត្រូវការសិទ្ធិ​ចូលប្រើប៊្លូធូស ដើម្បីបន្ត
ផ្គូផ្គង។ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb អាច​បង្កើត​ឡើង​បាន​ដោយគម្រោងកូដ​ចំហ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>។</translation>
<translation id="7777112741998051633">ទៅកាន់
        ម៉ឺនុយ FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ហើយ ដកការជ្រើសរើស "<ph name="NO_PREFETCH_DESCRIPTION"/>."
        ប្រសិនបើវាមិនដោះស្រាយបញ្ហានេះ យើងអាចណែនាំការជ្រើសរើសជម្រើសនេះ
        ម្តងទៀតសម្រាប់ប្រតិបត្តិការដែលបានធ្វើឲ្យប្រសើរឡើង។</translation>
<translation id="4699594416850504200">អ្នកកំពុងមើលទំព័រ FlyWeb for Testing ដែលមានសុវត្ថិភាព</translation>
<translation id="6224789938625024797">FlyWeb មិនបានបិទត្រឹមត្រូវទេ។</translation>
<translation id="3593104813552438879">គន្លឹះ FlyWeb៖ ស្វែងរក​ដោយប្រើ Lens</translation>
</translationbundle>