<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="1026101648481255140">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ಪುನರಾರಂಭಿಸಿ</translation>
<translation id="7099479769133613710">&amp;ChromeOS ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="291426170030461697">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು FlyWeb ನಿಮಗೆ ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ</translation>
<translation id="1549005488226693697">ತಮ್ಮ ಪುಟದಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ಖಾಸಗಿಯಾಗಿ ಪ್ರಿಲೋಡ್ ಮಾಡಲು ಸೈಟ್ ಕೇಳಿದಾಗ, FlyWeb, FlyWeb ಸರ್ವರ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಇದು ಪ್ರಿಲೋಡ್ ಮಾಡಿದ ಸೈಟ್‌ನಿಂದ ನಿಮ್ಮ ಗುರುತನ್ನು ಮರೆಮಾಡುತ್ತದೆ, ಆದರೆ ಯಾವ ಸೈಟ್‌ಗಳು ಪ್ರಿಲೋಡ್ ಆಗುತ್ತವೆ ಎಂಬುದನ್ನು FlyWeb ತಿಳಿಯುತ್ತದೆ.</translation>
<translation id="1065672644894730302">ನಿಮ್ಮ ಪ್ರಾಶಸ್ತ್ಯಗಳನ್ನು ರೀಡ್‌ ಮಾಡಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಅಲ್ಲದೇ, ಕೆಲವು ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿಲ್ಲದಿರಬಹುದು ಮತ್ತು ಪ್ರಾಶಸ್ತ್ಯಗಳಲ್ಲಿ ಮಾಡಿದ ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="8908267645832965492">ನಿಮ್ಮ ಪೋಷಕರು FlyWeb ನಲ್ಲಿ "ಸೈಟ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ವಿಸ್ತರಣೆಗಳಿಗಾಗಿ ಅನುಮತಿಗಳನ್ನು" ಆಫ್ ಮಾಡಿದ್ದಾರೆ</translation>
<translation id="5557633153169217776">ಸಮೀಪದ ಸಾಧನಗಳನ್ನು ಅನ್ವೇಷಿಸಲು ಮತ್ತು ಬಳಸಲು FlyWeb ಗೆ ನಿಮ್ಮ ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್‌ನ ಅಗತ್ಯವಿದೆ</translation>
<translation id="6441390163669415879">ನಿರ್ದಿಷ್ಟ FlyWeb ಫೀಚರ್ ಅಥವಾ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಹುಡುಕಲು, ವಿಳಾಸ ಪಟ್ಟಿಯಲ್ಲಿ ಅದರ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ, ನಂತರ ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಕೀಬೋರ್ಡ್ ಕೀಯನ್ನು ಟೈಪ್ ಮಾಡಿ</translation>
<translation id="9001750423919983557">ಸಿಸ್ಟಮ್ ಟ್ರೇನಲ್ಲಿ FlyWeb ಮೂಲಕ ಹುಡುಕಿ ಅನ್ನು ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="1368460307421081773">FlyWeb ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ರಫ್ತು ಮಾಡಲು ಬಯಸುತ್ತದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="112640046208448578">ವಸ್ತುಗಳನ್ನು ಅಥವಾ ಸ್ಥಳಗಳನ್ನು ಗುರುತಿಸಿ ಮತ್ತು ಪಠ್ಯವನ್ನು ಕಾಪಿ ಮಾಡಿ ಅಥವಾ ಅನುವಾದಿಸಿ. ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, ಪುಟದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿದೆ.</translation>
<translation id="4556715463645168547">ನಿಮ್ಮ ಇತರ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಡೇಟಾ ಉಲ್ಲಂಘನೆ ಮತ್ತು ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳಿಂದ ಸುರಕ್ಷಿತವಾಗಿವೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲು, <ph name="BEGIN_LINK"/>FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb ಮೆನು ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="1157985233335035034">ಇತ್ತೀಚಿನ ಭಾಷೆಗಳು</translation>
<translation id="1184145431117212167">ನಿಮ್ಮ Windows ಆವೃತ್ತಿಯನ್ನು ಬೆಂಬಲಿಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="4380351562011537903">FlyWeb ಕುರಿತು</translation>
<translation id="853148447909557566">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಮೂಲಕ ದರ ಟ್ರ್ಯಾಕಿಂಗ್ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="1203500561924088507">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME"/> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನೀವು ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="1232234696885483911">ನೀವು ಇಮೇಜ್‌ ಹುಡುಕಾಟವನ್ನು ತೆರೆದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">ನೀವು ಸೈನ್ ಇನ್ ಆಗಿರುವಾಗ, FlyWeb ನಲ್ಲಿ ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿನ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟನ್ನು ನೀವು ಬಳಸಬಹುದು. ಇದನ್ನು ಬದಲಾಯಿಸಲು, "FlyWeb ನಲ್ಲಿ ನಿಮ್ಮ ಖಾತೆ" ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ.</translation>
<translation id="7614508617663739435">FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು Mac ಮೆನು ಬಾರ್‌ನಲ್ಲಿ ತೋರಿಸಿ</translation>
<translation id="832555967476614730">FlyWeb ನಲ್ಲಿ Gemini ಬಳಸುವಾಗ ಸ್ಕ್ರೀನ್‌ನ ಒಂದು ಭಾಗವನ್ನು ಆಯ್ಕೆ ಮಾಡಲು, ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಬಳಸಿ.</translation>
<translation id="4750836834956739196">ಈ ಟ್ಯಾಬ್ ನಿಷ್ಕ್ರಿಯವಾಗಿದ್ದಾಗ, FlyWeb ವೇಗವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸಲು ಮೆಮೊರಿಯನ್ನು ಮುಕ್ತಗೊಳಿಸಿದೆ. ಈ ಸೈಟ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯವಾಗಿರದಂತೆ ಎಲ್ಲಾ ಸಮಯದಲ್ಲೂ ಹೊರಗಿಡಲು ನೀವು ಆಯ್ಕೆ ಮಾಡಬಹುದು.</translation>
<translation id="3190759351483708314">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿರುವ ಕಾರಣ FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/> ಬಳಸಿಕೊಂಡು Gmail ಅಥವಾ YouTube ನಂತಹ FlyWeb ಸೇವೆಗಳಿಗೆ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದರೆ, ನೀವು ಅದೇ ಖಾತೆಯೊಂದಿಗೆ FlyWeb ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="7142135954326264349">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಪಡೆಯಿರಿ</translation>
<translation id="1290883685122687410">ಸೆಟಪ್ ದೋಷ: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">ನಿಮ್ಮ ಹೊಸ FlyWeb ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="5252737639504553444">FlyWeb ನಲ್ಲಿ Gemini ಜೊತೆಗೆ ಬಳಸಿ ನೋಡಿ</translation>
<translation id="609743863669742325">ಬ್ಲೂಟೂತ್ ಸಾಧನಗಳನ್ನು
ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಮಾಡಲು FlyWeb ಗೆ ಬ್ಲೂಟೂತ್ ಆ್ಯಕ್ಸೆಸ್‌ನ ಅಗತ್ಯವಿದೆ. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="1330562121671411446">ಭಾಷೆಯನ್ನು ಪತ್ತೆ ಮಾಡಿ</translation>
<translation id="2276527911011636666">FlyWeb (<ph name="URL"/>) ನಿಂದ ಡೇಟಾವನ್ನು ಸಹ ಅಳಿಸಿ</translation>
<translation id="1345251407431278948">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಲ್ಲಿರುವ ಹೊಸ ಬಟನ್‌ನಿಂದ ನೀವು ಮತ್ತೊಮ್ಮೆ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು</translation>
<translation id="1383876407941801731">ಹುಡುಕಿ</translation>
<translation id="1045149878186896649">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಮುಂದುವರಿಸಲು FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="141901961143729572">ನಿಮ್ಮ ವಿಚಾರಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="2758515779140515865">ನಿಮ್ಮ ವಿಂಡೋ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ FlyWeb ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ.</translation>
<translation id="4713192356155907986">FlyWeb for Testing ನ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಲಾದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="1497802159252041924">ಇನ್‌ಸ್ಟಾಲ್ ದೋಷ: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ಈ ಪುಟವನ್ನು ರಕ್ಷಿಸಲಾಗಿದೆ</translation>
<translation id="8962360511570172">FlyWeb ಟ್ಯಾಬ್ ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="2941487459666781243">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="1547469039832541117">ಹೈಲೈಟ್ ಮಾಡಿದ ಕಾರ್ಯವನ್ನು ಕೊನೆಗೊಳಿಸುತ್ತದೆ.</translation>
<translation id="3182893868355533457">FlyWeb ಅನ್ನು ಪಿನ್ ಮಾಡಿ</translation>
<translation id="852852907317361085">FlyWeb ನ ಸುರಕ್ಷತೆ ಟೂಲ್‌ಗಳು</translation>
<translation id="481155564361715417">FlyWeb ನಿಮ್ಮ Password Manager ಡೇಟಾವನ್ನು ಅಳಿಸಲು ಬಯಸುತ್ತದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="2846999307505917298">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್ ಮೂಲಕ FlyWeb ನ ಅತ್ಯುತ್ತಮವಾದದ್ದನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="3961251277542681013">FlyWeb ನಲ್ಲಿ ಪ್ರಮುಖ ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತಾ ನಿಯಂತ್ರಣಗಳನ್ನು ಪರಿಶೀಲಿಸಿ</translation>
<translation id="1640672724030957280">ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, ಸದಸ್ಯತ್ವ ಎಂಬುದಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ಖಾತೆಯ ಮೆನುವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="7625232007557474355">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ FlyWeb ಅನ್ನು ಬಳಸಬಹುದು. ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಸಹ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> ಗಾಗಿ ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಅನ್ನು ಒದಗಿಸುತ್ತದೆ.</translation>
<translation id="5695205873161614119">FlyWeb ಶೀಘ್ರದಲ್ಲೇ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
<translation id="8939535770474283898">ನ್ಯಾವಿಗೇಶನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಲು FlyWeb ಪ್ರಯತ್ನಿಸುತ್ತದೆ</translation>
<translation id="2581127533455294937">FlyWeb ಡೇಟಾ ತೆರವುಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="7385422968404728039"><ph name="REMAINING_TIME"/> ಸೆಕೆಂಡ್‌ಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ</translation>
<translation id="6903827847227122616">HTTPS ಲಭ್ಯವಿಲ್ಲದಿದ್ದಾಗ, FlyWeb ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡದೆ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತದೆ</translation>
<translation id="307170399141486420">FlyWeb ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಚಾಲನೆಗೊಳ್ಳಲು ಅನುಮತಿಸಿ</translation>
<translation id="5006568136491721884">ತ್ವರಿತ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ FlyWeb ಅನ್ನು ಪಿನ್ ಮಾಡಲು Windows ನೋಟಿಫಿಕೇಶನ್‌ನಲ್ಲಿ <ph name="BEGIN_BOLD"/>ಹೌದು<ph name="END_BOLD"/> ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="2473319786107120819">FlyWeb ಅನ್ನು ಮರುಸ್ಥಾಪಿಸು</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> ಅನ್ನು ಮಾಡಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="3547283483106013256">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ ನೀವು FlyWeb ಅನ್ನು ತೆರೆದಾಗ, FlyWeb Password Manager ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="1838374766361614909">ಹುಡುಕಾಟ ತೆರವುಗೊಳಿಸಿ</translation>
<translation id="3403116471618205223">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು FlyWeb ಖಾತೆಯಲ್ಲಿ ಇರಿಸಿಕೊಂಡು, ಅದನ್ನು ಈ ಸಾಧನದಿಂದ ಮಾತ್ರ ಅಳಿಸಲು, <ph name="BEGIN_LINK"/>FlyWeb ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಹೊಸ ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ತೆರೆಯಲು ಅಥವಾ ರಚಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="3285741355512747610">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ FlyWeb ಖಾತೆಗಳನ್ನು ನೀವು ನಿರ್ವಹಿಸಬಹುದು. ನಿಮ್ಮ FlyWeb ಖಾತೆಗಳನ್ನು FlyWeb ಬ್ರೌಸರ್, Play Store ‌‌, Gmail ಹಾಗೂ ಮುಂತಾದವುಗಳಲ್ಲಿ ಬಳಸಲಾಗುತ್ತದೆ. ಕುಟುಂಬದ ಸದಸ್ಯರಂತಹ ಬೇರೊಬ್ಬರಿಗೆ ನೀವು ಖಾತೆಯನ್ನು ಸೇರಿಸಲು ಬಯಸಿದರೆ, ಬದಲಿಗೆ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ಗೆ ಹೊಸ ವ್ಯಕ್ತಿಯನ್ನು ಸೇರಿಸಿ. <ph name="LINK_BEGIN"/>ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಿ</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="1880677175115548835">ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="4824940465467423308">ನೀವು ನಿರ್ವಹಿಸಲಾದ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತಿರುವಿರಿ ಮತ್ತು ನಿಮ್ಮ FlyWeb ಪ್ರೊಫೈಲ್ ಮೂಲಕ ಅದರ ನಿರ್ವಾಹಕ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತಿರುವಿರಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಹಾಗೂ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ನಿಮ್ಮ FlyWeb ಡೇಟಾವನ್ನು <ph name="USER_NAME"/> ಅವರಿಗೆ ಶಾಶ್ವತವಾಗಿ ಬಂಧಿಸಲಾಗುತ್ತದೆ. FlyWeb ಖಾತೆಗಳ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಮೂಲಕ ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯ, ಆದರೆ ಬೇರೊಂದು ಖಾತೆಯೊಂದಿಗೆ ಈ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ FlyWeb ಡೇಟಾವನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ನೀವು ಐಚ್ಛಿಕವಾಗಿ ಹೊಸ ಪ್ರೊಫೈಲ್ ಅನ್ನು ರಚಿಸಬಹುದು. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">ಹಿನ್ನೆಲೆ ಚಟುವಟಿಕೆ ಮತ್ತು ಮೃದುವಾಗಿ ಸ್ಕ್ರೋಲ್ ಮಾಡುವುದು ಹಾಗೂ ವೀಡಿಯೊ ಫ್ರೇಮ್ ರೇಟ್‌ಗಳಂತಹ ವಿಷುವಲ್ ಎಫೆಕ್ಟ್‌ಗಳನ್ನು ಮಿತಿಗೊಳಿಸುವ ಮೂಲಕ ಬ್ಯಾಟರಿ ಪವರ್ ಅನ್ನು FlyWeb ಸಂರಕ್ಷಿಸುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಎನರ್ಜಿ ಸೇವರ್‌ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb ಅಪ್‌ಡೇಟರ್ ಸೇವೆ</translation>
<translation id="7390382558747224642">ಇದನ್ನು ಆಫ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡದೆಯೇ Gmail ನಂತಹ FlyWeb ಸೈಟ್‌ಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="5714085538350759767">FlyWeb ಸ್ಪಂದಿಸುತ್ತಿಲ್ಲ. ಇದೀಗ ಮರುಪ್ರಾರಂಭಿಸುವುದೇ?</translation>
<translation id="5866699689358760578">ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆ, <ph name="MANAGER"/> ಗೆ ಅಗತ್ಯವಿದೆ</translation>
<translation id="4035053306113201399">ಅಪ್‌ಡೇಟ್ ಅನ್ವಯಿಸಲು ChromeOS ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="3750729306035486751">ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
<translation id="1953553007165777902">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="MINUTE"/> ನಿಮಿಷ(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ</translation>
<translation id="6956650624767954726">ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು ನಿರ್ಧರಿಸಲು ಅಥವಾ ಹೊಂದಿಸಲು FlyWeb ಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ</translation>
<translation id="197326043290947695">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟದಿಂದ ಸ್ಮಾರ್ಟ್ ಬ್ರೌಸಿಂಗ್</translation>
<translation id="130679046523922050">FlyWeb ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ, ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ</translation>
<translation id="8243822903505210769">ನಿಮ್ಮ FlyWeb ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಅಪ್ ಟು ಡೇಟ್ ಆಗಿರಿಸುತ್ತದೆ. ಈ ಸೇವೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ ಅಥವಾ ಸ್ಥಗಿತಗೊಳಿಸಿದರೆ, ನಿಮ್ಮ FlyWeb ಸಾಫ್ಟ್‌‌ವೇರ್ ಅನ್ನು ಅಪ್ ಟು ಡೇಟ್ ಆಗಿರಿಸಲಾಗುವುದಿಲ್ಲ, ಅದರರ್ಥ ಸಂಭವಿಸಬಹುದಾದ ಭದ್ರತಾ ದೌರ್ಬಲ್ಯಗಳನ್ನು ಸರಿಪಡಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ ಮತ್ತು ಫೀಚರ್‌ಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು. ಈ ಸೇವೆಯನ್ನು ಯಾವುದೇ FlyWeb ಸಾಫ್ಟ್‌ವೇರ್ ಬಳಸದೇ ಇದ್ದಾಗ ಅದು ತಾನಾಗಿಯೇ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಆಗುತ್ತದೆ.</translation>
<translation id="6495079989036864983">ಈ ಸಾಧನದಿಂದ 1 ಐಟಂ ಅನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL"/> ನಂತೆ FlyWeb ಗೆ ಸೈನ್‌ಇನ್ ಮಾಡಿ.</translation>
<translation id="2018879682492276940">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2039417478970545937">ಸೆಟ್ಟಿಂಗ್‌ಗಳು.</translation>
<translation id="8544477465831682343">FlyWeb ಸೇವೆಗಳಲ್ಲಿ ಹೆಚ್ಚು ವೈಯಕ್ತೀಕರಿಸಿದ ಅನುಭವಗಳಿಗಾಗಿ FlyWeb ಇತಿಹಾಸವನ್ನು ಸೇರಿಸಬೇಕೆ ಬೇಡವೇ ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="328650761750741315">ಸದೃಢ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ರಚಿಸಲು, ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಆಟೋಫಿಲ್ ಮಾಡಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡಲು FlyWeb ನಲ್ಲಿ ಬಿಲ್ಟ್ ಇನ್ ಆಗಿದೆ. ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಸೇರಿಸಿ.</translation>
<translation id="2407746489237278840">FlyWeb ಗೆ ಹೊಸ ಲುಕ್ ನೀಡಲು, ಹೊಸ ಟ್ಯಾಬ್ ಎಂಬ ಪುಟದಲ್ಲಿ FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಎಂಬ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="8924891216494775926">ಈ ಫೈಲ್ ಮೋಸದಾಯಕವಾಗಿದೆ ಮತ್ತು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಅನಿರೀಕ್ಷಿತ ಬದಲಾವಣೆಗಳನ್ನು ಮಾಡಬಹುದಾದ ಕಾರಣದಿಂದ FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="5728214838078602184">ನೀವು ಮುಂದಿನ ಬಾರಿ FlyWeb iOS ಅನ್ನು ತೆರೆದಾಗ <ph name="FEATURE_NAME"/> ಅನ್ನು ಪ್ರಯತ್ನಿಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="2058207584484841616">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ನೀವು ಸೇವ್ ಮಾಡಿರುವ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತರ FlyWeb ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. FlyWeb ನಲ್ಲಿ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬಳಸಲು, ಮರಳಿ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{FlyWeb ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}one{FlyWeb ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}other{FlyWeb ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}}</translation>
<translation id="2125838419757773031">ಹುಡುಕಲು ಸ್ಕ್ರೀನ್‌ನ ಪ್ರದೇಶವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="2126108037660393668">ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಫೈಲ್‌ನ ಪರಿಶೀಲನೆ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="2135919691573380097">ಈ ಸೈಟ್ ಕುರಿತು ವರದಿ ಮಾಡಿ</translation>
<translation id="2137162749895930932">ಅನುವಾದದ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಮುಚ್ಚಿರಿ</translation>
<translation id="2147218225094845757">ಪಾರ್ಶ್ವ ಫಲಕವನ್ನು ಮರೆಮಾಡಿ</translation>
<translation id="4474394796469499134">ಈ ಸೈಟ್ ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತಿಲ್ಲ ಮತ್ತು ಫೈಲ್ ಅನ್ನು ಟ್ಯಾಂಪರ್ ಮಾಡಿರಬಹುದಾದ ಕಾರಣದಿಂದ FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="2170098639895543546">ಪುಟದಲ್ಲಿ ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="6765231735885996239">FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="2174917724755363426">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ನೀವು ಖಂಡಿತವಾಗಿಯೂ ರದ್ದುಮಾಡಲು ಬಯಸುವಿರಾ?</translation>
<translation id="2937508664417729967">FlyWeb - ನೆಟ್‌ವರ್ಕ್ ಸೈನ್ ಇನ್ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">ಅಪ್‌ಡೇಟ್‌‌ ಪರಿಶೀಲನೆ ದೋಷ: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">FlyWeb ನಿಂದ ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="744837314710861405">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಅತ್ಯುತ್ತಮ ಶಾಪಿಂಗ್ ಟೂಲ್‌ಗಳ ಪ್ರಯೋಜನ ಪಡೆಯಲು FlyWeb ಆ್ಯಪ್ ಬಳಸಿ</translation>
<translation id="2745381939758295588">iOS ಗಾಗಿ FlyWeb ನಲ್ಲಿ ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ನೊಂದಿಗೆ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಸುರಕ್ಷಿತವಾಗಿರಿ</translation>
<translation id="6707114110652917144">ಅಪಾಯಕಾರಿ ಸೈಟ್. FlyWeb ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="2236949375853147973">ನನ್ನ ಚಟುವಟಿಕೆ</translation>
<translation id="4646732243247482236">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ವಿಳಾಸಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ವಿಳಾಸವನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="2726680594710751908">ನೀವು ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಹಂಚಿಕೊಂಡರೆ, ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು FlyWeb ಅನ್ನು ಅವರಿಗೆ ಬೇಕಾದಂತೆ ಹೊಂದಿಸಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="4086571337340463916">FlyWeb ನಲ್ಲಿ ಕೌಶಲ್ಯಗಳು</translation>
<translation id="2283803047247799269">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಎಂಬ ಫೀಚರ್ ಬಳಸಿಕೊಂಡು ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್ ಅನ್ನು ವಿರಾಮಗೊಳಿಸಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="2307973900865360088">ಡಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="5067150284614317159">FlyWeb ನಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಮಾಡಲಾಗಿರುವ ಅಸುರಕ್ಷಿತ ಸೈಟ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ, URL ಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ. ಯಾವುದಾದರೂ ಸೈಟ್, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಕದಿಯಲು ಪ್ರಯತ್ನಿಸಿದರೆ ಅಥವಾ ನೀವು ಹಾನಿಕಾರಕ ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಪುಟದ ಕಂಟೆಂಟ್‌ನ ತುಣುಕುಗಳನ್ನು ಒಳಗೊಂಡ URL ಗಳನ್ನು ಸಹ FlyWeb, ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ಗೆ ಕಳುಹಿಸಬಹುದು.</translation>
<translation id="2356070529366658676">ಕೇಳಿ</translation>
<translation id="2359808026110333948">ಮುಂದುವರೆಸಿ</translation>
<translation id="7339360994527471629">"<ph name="EXTENSION_NAME"/>" ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯ ಮೂಲಕ ಬಳಸುವುದಕ್ಕಾಗಿ ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕಿದೆ</translation>
<translation id="8788732221355188962">ಆ್ಯಪ್‌ಗಳಿಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ FlyWeb ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="4126251160852694747"><ph name="USER_EMAIL_ADDRESS"/> ಮೂಲಕ ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಬಳಸಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="8418845734693287262">ನಿಮ್ಮ ಖಾತೆಯ ಸೈನ್ ಇನ್ ವಿವರಗಳು ತೀರಾ ಹಳೆಯದಾಗಿರುವ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{1 HID ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}=1{1 HID ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}one{# HID ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}other{# HID ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}}</translation>
<translation id="1364879203203742966">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ FlyWeb ಗೆ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿಗಳ ಅಗತ್ಯವಿದೆ</translation>
<translation id="2403703063067034158">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಸೆಟಪ್‌ನ ಮತ್ತೊಂದು ನಿದರ್ಶನ ಪ್ರಸ್ತುತ ರನ್ ಆಗುತ್ತಿದೆ, ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="656987653252575654">ಯಾವುದೇ ಆ್ಯಪ್‌ನಿಂದ FlyWeb ನಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ನಲ್ಲಿ ಬ್ರೌಸರ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡುವ ಹಾಗೆ ಇರಿಸಿ</translation>
<translation id="157662717324308283">ತ್ವರಿತ ಅವಲೋಕನವನ್ನು ಪಡೆಯಲು ಮತ್ತು ಫಾಲೋ-ಅಪ್ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು FlyWeb ನಲ್ಲಿ Gemini ಜೊತೆಗೆ ಈ ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ಸಾರಾಂಶಗೊಳಿಸಿ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>FlyWeb ನಲ್ಲಿನ ಟೂಲ್‌ಗಳ<ph name="END_LINK"/> ಮೂಲಕ ನೀವು ಸುರಕ್ಷಿತವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು ನಿಯಂತ್ರಣದಲ್ಲಿರಬಹುದು</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="2451727308784734061">Password Manager ಗೆ ತ್ವರಿತವಾಗಿ ಹೋಗಲು ನಿಮ್ಮ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಬಳಸಿ. ನಿಮ್ಮ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನ ಹೋಮ್‌ ಸ್ಕ್ರೀನ್ ಅಥವಾ ಆ್ಯಪ್ ಲಾಂಚರ್‌ಗೆ ನೀವು ಸರಿಸಬಹುದು.</translation>
<translation id="3224379053610845181">FlyWeb ಶೀಘ್ರದಲ್ಲೇ ಮುಚ್ಚಲ್ಪಡುತ್ತದೆ</translation>
<translation id="3840682988105604367">FlyWeb ನಲ್ಲಿ</translation>
<translation id="2485422356828889247">ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್</translation>
<translation id="2513154137948333830">ರೀಬೂಟ್ ಮಾಡುವ ಅಗತ್ಯವಿದೆ: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="6823116595279840454">ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು FlyWeb ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="2691552788029831386">ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು FlyWeb ಗೆ ಸಂಗ್ರಹಣೆಯನ್ನು ಪ್ರವೇಶಿಸುವ ಅಗತ್ಯವಿದೆ</translation>
<translation id="2275866327478859777">FlyWeb ಸಹಾಯಕ</translation>
<translation id="2575822587468774919">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಲು ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="683641781063074351">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="1659167470250249643">FlyWeb ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ FlyWeb ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ನಿಮ್ಮ ಫೋನ್ ಮೂಲಕ QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ.</translation>
<translation id="5353172248151202719">FlyWeb ಮೂಲಕ ಹುಡುಕಲು.</translation>
<translation id="3231856291920394348">FlyWeb ಬಳಸಿಕೊಂಡು ಮುಂದುವರಿಯಿರಿ</translation>
<translation id="259935314519650377">ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ಕ್ಯಾಷ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ. ದೋಷ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">ಸಿಸ್ಟಂ</translation>
<translation id="7683745685556117660">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್‌ಗಳಂತಹ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ನೋಡಬಹುದು ಮತ್ತು ನಿರ್ವಹಿಸಬಹುದು. ಅದಕ್ಕೆ ಇತರ FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳಲ್ಲಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ನೋಡಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ</translation>
<translation id="5862783156828836752">ನಿಮ್ಮ ಖಾತೆ <ph name="ACCOUNT_EMAIL"/> ನಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ಇದು ನೀವೇ ಎಂಬುದನ್ನು ದೃಢೀಕರಿಸಿ</translation>
<translation id="4450675160413947126">FlyWeb ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3827993926722004004">ಸ್ಥಾಪಿಸುತ್ತಿರುವಾಗ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂ ದೋಷ ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು FlyWeb ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="333184635927514678">ನೀವು ಸಾಧನವನ್ನು ಹಂಚಿಕೊಂಡರೆ, ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು FlyWeb ಅನ್ನು ಅವರಿಗೆ ಬೇಕಾದಂತೆ ಸೆಟಪ್ ಮಾಡಬಹುದು</translation>
<translation id="3917488635054382918">FlyWeb ಅನ್ನು ಮಿನಿಮೈಸ್ ಮಾಡಿದ್ದರೂ ಸಹ, ನಿಮ್ಮ ಸಾಧನದಾದ್ಯಂತ FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು ಬಳಸಲು ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯಿರಿ.</translation>
<translation id="1257705702166647105">FlyWeb ಟ್ಯಾಬ್</translation>
<translation id="2796283369875688710">ಹೆಚ್ಚುವರಿ ಭದ್ರತೆಗಾಗಿ, FlyWeb ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡುತ್ತದೆ.</translation>
<translation id="1118215875395945816">FlyWeb ನಿಂದ ನಿಮ್ಮ FlyWeb ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೈನ್ ಔಟ್ ಮಾಡಿ</translation>
<translation id="3320675843036708646">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="2738871930057338499">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. HTTP 403 ನಿಷೇಧಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಪ್ರಾಕ್ಸಿ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="2753623023919742414">ಹುಡುಕಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="8027563534376000179">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ PDF ವೀಕ್ಷಕವನ್ನಾಗಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="7907238427168022751">ಈ ವಿಸ್ತರಣೆಯು ಮಾಲ್‌ವೇರ್ ಅನ್ನು ಹೊಂದಿದೆ ಮತ್ತು ಸುರಕ್ಷಿತವಾಗಿಲ್ಲ. FlyWeb ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="2799223571221894425">ಮರುಪ್ರಾರಂಭಿಸು</translation>
<translation id="1489590198317876070">ನಿಮ್ಮ FlyWeb</translation>
<translation id="2816462166102338036">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಬಳಸಿಕೊಂಡು ಈ ವೀಡಿಯೊವನ್ನು ಹುಡುಕಿ</translation>
<translation id="6850011743146651977">ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಮೂಲಕ ಉತ್ಪನ್ನಗಳನ್ನು ಹುಡುಕಿ, ದರ ಇಳಿಕೆಯ ಮಾಹಿತಿ ಪಡೆಯಿರಿ ಮತ್ತು iOS ನಲ್ಲಿ FlyWeb ಬಳಸುವ ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಇನ್ನೂ ಹೆಚ್ಚಿನದನ್ನು ಮಾಡಿ.</translation>
<translation id="2841525013647267359">ಈ ಭಾಷೆಯಿಂದ ಅನುವಾದಿಸಿ</translation>
<translation id="2846251086934905009">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="1339341044496643931">FlyWeb ನಿಂದ ತೆಗೆದುಹಾಕಿ...</translation>
<translation id="4922993584046885552">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, FlyWeb ನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಮತ್ತು ಇತರ FlyWeb ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಸುರಕ್ಷತೆಯನ್ನು ಸುಧಾರಿಸಲು ಬಳಸಬಹುದು</translation>
<translation id="2885378588091291677">ಕಾರ್ಯ ನಿರ್ವಾಹಕ</translation>
<translation id="3806033752149316261">&amp;FlyWeb ಕುರಿತು</translation>
<translation id="2915996080311180594">ನಂತರ ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3497031519171753772">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಮೂಲಕ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ.</translation>
<translation id="2945997411976714835">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಪ್ರಕ್ರಿಯೆಯು ಪ್ರಾರಂಭಿಸಲು ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="1784605133570901105">iOS ನಲ್ಲಿ FlyWeb ಗಾಗಿ ಸೇವ್ ಮಾಡಲಾದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಸೈಟ್‌ಗಳಿಗೆ ವೇಗವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5383705372991100927">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು FlyWeb ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ</translation>
<translation id="1661079783259785361">FlyWeb ಅಪ್‌ ಟು ಡೇಟ್‌ ಆಗಿದೆ</translation>
<translation id="5447533789927384736">ಯಾವುದಾದರೂ ಸೈಟ್ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಕದಿಯಲು ಪ್ರಯತ್ನಿಸಿದರೆ ಅಥವಾ ನೀವು ಹಾನಿಕಾರಕ ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಪುಟದ ವಿಷಯದ ತುಣುಕುಗಳನ್ನು ಒಳಗೊಂಡ URL ಗಳನ್ನು ಸಹ FlyWeb, ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ಗೆ ಕಳುಹಿಸುತ್ತದೆ</translation>
<translation id="3208925917545144893">ನಿಮ್ಮ ಪೋಷಕರ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3003694935412297923">ಎಲ್ಲಾ ಕಾರ್ಯಗಳು</translation>
<translation id="1216763100505470452">{count,plural, =1{ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು FlyWeb ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು (1 ಐಟಂ) ಅಳಿಸಲಾಗುತ್ತದೆ.}one{ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು FlyWeb ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}other{ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು FlyWeb ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}}</translation>
<translation id="8404327407921790238">FlyWeb ನಲ್ಲಿ <ph name="URL"/> ಅನ್ನು ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ.</translation>
<translation id="5184501306555415561">ಕೌಶಲ್ಯಗಳಂತಹ AI ನಾವೀನ್ಯತೆಗಳನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ ಮತ್ತು FlyWeb ಸಿಂಕ್‌ನಿಂದ ಪ್ರತ್ಯೇಕವಾಗಿ ನಿರ್ವಹಿಸಲಾಗುತ್ತದೆ</translation>
<translation id="4409390320695765203">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="8841609317523323027">FlyWeb ಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3038232873781883849">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನಿರೀಕ್ಷಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3045032126857188731">ಅನುವಾದಿಸಿದ ಭಾಷೆ: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ಫೀಡ್‌ಬ್ಯಾಕ್ ಡೈಲಾಗ್ ಅನ್ನು ಮುಚ್ಚಿ</translation>
<translation id="2666189940580882376"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="4451837224464070850">ಇತರ FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="4351369660845291597">ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಆ್ಯಡ್-ಆನ್‌ಗಳಾಗಿದ್ದು, ಅವು FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಲು ನಿಮಗೆ ಅವಕಾಶ ನೀಡುತ್ತವೆ. ವ್ಯವಸ್ಥಿತವಾಗಿರುವುದರಿಂದ ಹಿಡಿದು ದೈನಂದಿನ ಕಾರ್ಯಗಳನ್ನು ಸರಳಗೊಳಿಸುವವರೆಗೆ, ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು FlyWeb ಅನ್ನು ನಿಮಗೆ ಬೇಕಾದ ಹಾಗೆ ಕಸ್ಟಮೈಸ್ ಮಾಡಲು ನೆರವಾಗುತ್ತವೆ.</translation>
<translation id="7859502023458300952">FlyWeb ಗೆ ಕ್ರ್ಯಾಶ್ ವರದಿಗಳನ್ನು ಮತ್ತು <ph name="UMA_LINK"/> ಕಳುಹಿಸುವುದರಿಂದ FlyWeb ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="1125501479713660011">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ FlyWeb ನ ಸುರಕ್ಷತೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{1 USB ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}=1{1 USB ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}one{# USB ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}other{# USB ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ FlyWeb ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}}</translation>
<translation id="6017373390117959211"><ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="7898392424469957829">FlyWeb ಇತಿಹಾಸ</translation>
<translation id="1407857531570256859">ಆರ್ಕೈವ್ ಅನ್ನು ಸಂಕ್ಷೇಪ ಮಾಡದಿರಲು ಸ್ಥಾಪಕ ವಿಫಲಗೊಂಡಿದೆ. ದಯವಿಟ್ಟು FlyWeb ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="310459126943037700">ಕಾರ್ಯವನ್ನು(ಗಳು) ಅಂತ್ಯಗೊಳಿಸಲು ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="3104828284009500087">ಪುಟದಲ್ಲಿ ಏನನ್ನಾದರೂ ಹುಡುಕಿ</translation>
<translation id="4706932464498663870">ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಿಂಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು FlyWeb ಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ ಮತ್ತು ಇಷ್ಟಪಡುವ ಫೀಚರ್‌ಗಳನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ.</translation>
<translation id="1309738977648134943">FlyWeb ನಿಮ್ಮ ಮೈಕ್ರೋಫೋನ್ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="3130333203120345554">ಹೊಸ ಹುಡುಕಾಟ</translation>
<translation id="3137969841538672700">ಹುಡುಕಲು ಡ್ರ್ಯಾಗ್ ಮಾಡಿ</translation>
<translation id="2251813826843049011">ಈ ಟ್ಯಾಬ್ ಇನ್ನಷ್ಟು ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತಿದೆ. ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು, ಅದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು FlyWeb ಅನ್ನು ಅನುಮತಿಸಿ.</translation>
<translation id="2664701271733223256">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ FlyWeb ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ</translation>
<translation id="6274649779206195384">FlyWeb ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3161522574479303604">ಎಲ್ಲಾ ಭಾಷೆಗಳು</translation>
<translation id="6773570808762718524">ನಿಮ್ಮ ಹೊಸ FlyWeb ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="8965010907836433875">ಟ್ಯಾಬ್‌ಗಳನ್ನು ಬದಲಿಸದೆಯೇ ನೀವು AI ಮೋಡ್‌ನೊಂದಿಗೆ ಚಾಟ್ ಮಾಡುವುದನ್ನು ಮುಂದುವರಿಸಬಹುದು. ಪ್ರಾರಂಭಿಸಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="5958835776851191812">FlyWeb ನಿಂದ ನಿಮ್ಮ FlyWeb ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪುಟದಲ್ಲಿ FlyWeb ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ</translation>
<translation id="4217346567895356023">ನಂತರ, ನಿಮಗಾಗಿ ಫಾರ್ಮ್‌ಗಳನ್ನು ಆಟೋಫಿಲ್ ಮಾಡಲು, ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿಯನ್ನು ಬಳಸಲು ನೀವು ಬಯಸುತ್ತೀರಾ ಎಂದು FlyWeb ಕೇಳಬಹುದು</translation>
<translation id="5449297306961970452">FlyWeb ಗೆ ಇದರ ಡೇಟಾ ಡೈರೆಕ್ಟರಿಯನ್ನು ಓದಲಾಗುವುದಿಲ್ಲ ಮತ್ತು ಬರೆಯಲಾಗುವುದಿಲ್ಲ: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">iOS ನಲ್ಲಿ FlyWeb ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ನಿಮ್ಮ ನೆಚ್ಚಿನ FlyWeb AI ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಿ.</translation>
<translation id="8090118570458552025"><ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3286538390144397061">ಈಗ ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3900612994249740104">FlyWeb API ಕೀಗಳು ಕಾಣೆಯಾಗಿವೆ. FlyWeb ನ ಕೆಲವು ಕಾರ್ಯವಿಧಾನಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="6824575001009586492">FlyWeb ಮುಚ್ಚಿದಾಗ ರನ್‌ ಆಗುತ್ತಿರುವ ಹಿನ್ನೆಲೆ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮುಂದುವರಿಸು</translation>
<translation id="2595215790271940091">ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಯಾವುದೇ ಸೈಟ್ ಅನ್ನು ಲೋಡ್ ಮಾಡುವ ಮೊದಲು FlyWeb ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ</translation>
<translation id="3701353923785984059">ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಆಗಿದ್ದರೆ, ನಿಮ್ಮ FlyWeb ಖಾತೆಯನ್ನು ಹೊರತುಪಡಿಸಿ ಎಲ್ಲಾ FlyWeb ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚುವುದರಿಂದ ಹೆಚ್ಚಿನ ಸೈಟ್‌ಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲಾಗುತ್ತದೆ. ಸೈಟ್‌ಗಳು ನಿಮ್ಮನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಲು ಅವಕಾಶ ಮಾಡಿಕೊಡಲು, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಮೇಲಿನ ಬಲ ಮೂಲೆ: ಬಲಕ್ಕೆ <ph name="RIGHT"/>%, ಮೇಲಕ್ಕೆ <ph name="TOP"/>%</translation>
<translation id="8629055140319079166">ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾ</translation>
<translation id="1943161457314845496">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ FlyWeb ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">ಈಗಿರುವ FlyWeb ಪ್ರೊಫೈಲ್‌ಗೆ ಬದಲಿಸಬೇಕೆ?</translation>
<translation id="3412460710772753638">ಈ ಸಾಧನದಲ್ಲಿನ Password Manager ನಲ್ಲಿ</translation>
<translation id="1568435374218487057"><ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3438772217992559640">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="6301354573631022693">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ FlyWeb ಮೂಲಕ ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ವಿಸ್ತರಿಸಿ</translation>
<translation id="7625477329092296018">FlyWeb ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿಕೊಳ್ಳಲಾಗುತ್ತಿದೆ...</translation>
<translation id="956833467923764542">ಈ ಸಾಧನದಿಂದ <ph name="ITEMS_COUNT"/> ಐಟಂಗಳನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL"/> ನಂತೆ FlyWeb ಗೆ ಸೈನ್‌ಇನ್ ಮಾಡಿ.</translation>
<translation id="4772642827282964272">FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು <ph name="SHORTCUT"/> ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="6724485219247982027">ದಯವಿಟ್ಟು ಎಲ್ಲಾ FlyWeb ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚಿರಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5048962017649434283">ನಿಮ್ಮ ವಿಂಡೋ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ FlyWeb ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ.  ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, ನಿಮ್ಮ ಸ್ವಂತ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ನಂತೆ FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="408747932595284596">ಮೊಬೈಲ್ ಸಾಧನಗಳಲ್ಲಿ FlyWeb ಬ್ರೌಸರ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು QR ಕೋಡ್</translation>
<translation id="1413410454753055427">ರಿಮೈಂಡರ್: ನಿಮ್ಮ ಜೇಬಿನಲ್ಲಿ FlyWeb ನ ಅತ್ಯುತ್ತಮ ಸುರಕ್ಷತಾ ಫೀಚರ್‌ಗಳು</translation>
<translation id="7831730508158736496">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ FlyWeb ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ.</translation>
<translation id="9006158231572141726">FlyWeb ಗುರುತಿಸದ ಸೈಟ್‌ಗಳಿಗೆ ವರ್ಧಿತ ಸುರಕ್ಷತೆಯು JavaScript ಆಪ್ಟಿಮೈಸೇಷನ್ ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="3597003331831379823">ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಮೂಲಕ ಸೆಟಪ್ ಅನ್ನು ರನ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="6970052268542136081">ಈ ವ್ಯಕ್ತಿಯ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ಅಳಿಸಲಾಗುತ್ತದೆ. ಡೇಟಾವನ್ನು ಪುನಃ ಪಡೆದುಕೊಳ್ಳಲು, FlyWeb ನಲ್ಲಿ <ph name="USER_EMAIL"/> ಎಂದು ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="3667616615096815454">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ, ಅಪ್ಲಿಕೇಶನ್ ಸರ್ವರ್‌ಗೆ ತಿಳಿದಿಲ್ಲ.</translation>
<translation id="2438845157914027912">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿರುವ ಎಲ್ಲಾ FlyWeb ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲು ನಿಮ್ಮ <ph name="BEGIN_LINK"/>ಸ್ವಂತ ಪಾಸ್‌ಫ್ರೇಸ್<ph name="END_LINK"/> ಬಳಸಿ. Google Pay ನಲ್ಲಿನ ಪಾವತಿ ವಿಧಾನಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ. FlyWeb ನ ಬ್ರೌಸಿಂಗ್ ಇತಿಹಾಸವು ಸಿಂಕ್ ಆಗುವುದಿಲ್ಲ.</translation>
<translation id="6611602069520888180">ಹೊಸ FlyWeb &amp;ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="2591356225047803326">ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಇತರ ಉದ್ದೇಶಗಳಿಗಾಗಿ FlyWeb ಮತ್ತು ಇತರ FlyWeb ಸೇವೆಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಿ</translation>
<translation id="3729187154190517324">"ಟ್ಯಾಬ್ ಮತ್ತು ಇನ್ನಷ್ಟು ಸೇರಿಸಿ" ಬಟನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಬಹು ಟ್ಯಾಬ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಟೂಲ್‌ಗಳನ್ನು ಸೇರಿಸುವ ಮೂಲಕ ನಿಮ್ಮ ಹುಡುಕಾಟವನ್ನು ಇನ್ನಷ್ಟು ಆಳವಾಗಿಸಿ.</translation>
<translation id="1771882170639856394">FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="3782148374606932577">FlyWeb ಕೆಲವು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="4640643918757362950">ನಿಮ್ಮ ಪರಿಶೀಲನೆಗೆ ಏನಾದರೂ ಅಗತ್ಯವಿದ್ದರೆ FlyWeb ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="2179738813053854729">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಪುಟಗಳನ್ನು FlyWeb ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="3810973564298564668">ನಿರ್ವಹಿಸಿ</translation>
<translation id="5026502787439628947">ನೀವು ಸೇವ್ ಮಾಡಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಲು, QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ, FlyWeb iOS ಆ್ಯಪ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ FlyWeb ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3846683726093018685">**ಸಾರಾಂಶಗೊಳಿಸಿ:** 30 ಪದಗಳ ಒಳಗೆ ಒಂದೇ ವಾಕ್ಯದಲ್ಲಿ, ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ನಲ್ಲಿರುವ ಕಂಟೆಂಟ್‌ನ ಪ್ರಾಥಮಿಕ ವಿಷಯ ಮತ್ತು ಉದ್ದೇಶವನ್ನು ವಿವರಿಸಿ.

          **ಪ್ರಶ್ನೆಗಳನ್ನು ಸೂಚಿಸಿ:** ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಚೆನ್ನಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಬಳಕೆದಾರರು ಕೇಳಬಹುದಾದ 3-5 ಚಿಂತನೆಗೆ ಒರೆ ಹಚ್ಚುವ ಪ್ರಶ್ನೆಗಳ ಬುಲೆಟ್ ಪಟ್ಟಿಯನ್ನು ರಚಿಸಿ. ಈ ಪ್ರಶ್ನೆಗಳು ವಿಷುವಲ್‌ ಆಬ್ಜೆಕ್ಟ್, ಅದರ ವಿನ್ಯಾಸ ಅಥವಾ ಅದರ ಪ್ಲೇಸ್‌ಮೆಂಟ್‌‌ನ ಬಗ್ಗೆ ನಿರ್ದಿಷ್ಟವಾಗಿ ಇವುಗಳಲ್ಲಿ ಕನಿಷ್ಠ ಒಂದನ್ನಾದರೂ ಒಳಗೊಂಡಿರಬೇಕು.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3885770153807205175">ಭಾಷಾ ಪಿಕರ್‌</translation>
<translation id="5175060854726708547">FlyWeb ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ. ನೀವು ಕೆಲವು ಸಂಗತಿಗಳ ಕುರಿತು ಗಮನಹರಿಸಬೇಕಿದೆ - ವಿವರಗಳಿಗಾಗಿ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="606156353708638647">FlyWeb ತೆರೆಯಲು ಮತ್ತು ಬ್ರೌಸ್ ಮಾಡುವುದನ್ನು ಪ್ರಾರಂಭಿಸಲು ನಿಮ್ಮ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="3892148308691398805">ಪಠ್ಯ ಕಾಪಿ ಮಾಡಿ</translation>
<translation id="5145107420478372433">ಈ FlyWeb ಪ್ರೊಫೈಲ್‌ಗೆ ಈಗಾಗಲೇ <ph name="EXISTING_USER"/> ಅವರು ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ನಿಮಗಾಗಿ ನಿಮ್ಮ ಸ್ವಂತ ಪ್ರೊಫೈಲ್ ಅನ್ನು ರಚಿಸಬಹುದು.</translation>
<translation id="3941890832296813527">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಫೈಲ್ ಹೆಸರು ಅಮಾನ್ಯವಾಗಿದೆ ಅಥವಾ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ.</translation>
<translation id="8536259619256229278">FlyWeb, ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ನಕಲಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="7965008434896274911">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="4540773594514226705">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ನೀವು ಸೇವ್ ಮಾಡದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಪಾವತಿ ವಿಧಾನಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. FlyWeb ನಲ್ಲಿ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬಳಸಲು, ಮರಳಿ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="395904275706073188">ಸಂರಕ್ಷಿತ ಪುಟಗಳನ್ನು ಓದಲಾಗುವುದಿಲ್ಲ. ಬೇರೆ ಪುಟವನ್ನು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="3849784651193576458">FlyWeb ನಿಮ್ಮನ್ನು ಹೇಗೆ ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="3967822245660637423">ಡೌನ್‌ಲೋಡ್‌‌ ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="562495843857641474">ನೀವು ವಿಳಾಸ ಪಟ್ಟಿ ಅಥವಾ ಸರ್ಚ್ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಸಲಹೆಗಳನ್ನು ಪಡೆಯಲು FlyWeb ನೀವು ಟೈಪ್ ಮಾಡುವುದನ್ನು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಹುಡುಕಾಟ, AI ಮತ್ತು ಏಜೆಂಟ್ ಟೂಲ್‌ಗಳಿಗೆ ಕಳುಹಿಸುತ್ತದೆ.</translation>
<translation id="5667414856761616811">FlyWeb for Testing ಕುರಿತು</translation>
<translation id="1152920704813762236">ChromeOS ಕುರಿತು</translation>
<translation id="4920206821838432969">ನೀವು ಸೈಟ್‌ಗೆ ಭೇಟಿ ನೀಡಿದಾಗ, FlyWeb ನಿಮ್ಮ IP ವಿಳಾಸವನ್ನು ಮರೆಮಾಡುವ ಗೌಪ್ಯತೆ ಸರ್ವರ್ ಮೂಲಕ URL ನ ಮಬ್ಬುಗೊಳಿಸಿದ ಭಾಗವನ್ನು <ph name="BEGIN_LINK"/>Google Safe Browsing<ph name="END_LINK"/> ಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಸೈಟ್ ಅನುಮಾನಾಸ್ಪದವಾಗಿ ಏನಾದರೂ ಮಾಡಿದರೆ, ಪೂರ್ಣ URL ಗಳು ಮತ್ತು ಪುಟದ ಕಂಟೆಂಟ್‌ನ ಬಿಟ್‌ಗಳನ್ನು ಸಹ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="4016217212818346953">Password Manager ಮೂಲಕ ಸುರಕ್ಷಿತವಾಗಿರಿ</translation>
<translation id="3703994572283698466">ಹೆಚ್ಚುವರಿ <ph name="BEGIN_LINK_CROS_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್‌<ph name="END_LINK_CROS_OSS"/> ನಿಂದ ChromeOS ನ ರಚನೆ, ಹಾಗೆಯೇ <ph name="BEGIN_LINK_LINUX_OSS"/>Linux ಡೆವಲಪ್‌ಮೆಂಟ್ ಎನ್ವಿರಾನ್‌ಮೆಂಟ್<ph name="END_LINK_LINUX_OSS"/> ರಚನೆ ಸಹ ಸಾಧ್ಯವಾಯಿತು.</translation>
<translation id="4022972681110646219">ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಅನುವಾದಿಸಿ</translation>
<translation id="4023601594785368013">ಮೂಲ ಭಾಷೆ: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">ಯಾವುದೇ ಆ್ಯಪ್‌ನಿಂದ FlyWeb ನಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ. ಜೊತೆಗೆ ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ, ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>ಪ್ರಸ್ತುತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="END_LINK"/> ವರದಿ ಮಾಡುವ ಮೂಲಕ FlyWeb ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="4050175100176540509">ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಯಲ್ಲಿ ಪ್ರಮುಖವಾದ ಭದ್ರತಾ ಸುಧಾರಣೆಗಳು ಮತ್ತು ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿದೆ.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{FlyWeb ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.}one{FlyWeb ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.}other{FlyWeb ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.}}</translation>
<translation id="4105099155797156500">FlyWeb ಕುರಿತ ಪುಟಕ್ಕೆ ಹೋಗಿ</translation>
<translation id="7753744564324413106">ನಿಮ್ಮ ಬ್ರೌಸರ್‌ಗೆ ಹೊಸ ಲುಕ್ ಅನ್ನು ನೀಡಲು FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="3202882878525816493">ನಿಮ್ಮ FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="4148957013307229264">ಸ್ಥಾಪನೆಗೊಳ್ಳುತ್ತಿದೆ...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - ನೆಟ್‌ವರ್ಕ್ ಸೈನ್ ಇನ್ - FlyWeb</translation>
<translation id="6368928751841546993"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="4007949387571083162">FlyWeb ಗಾಗಿ ಅದ್ಭುತ ಅಪ್ಲಿಕೇಶನ್‌‌ಗಳು, ಗೇಮ್‌ಗಳು, ಎಕ್ಸ್‌ಟೆನ್ಷನ್‌‌ಗಳು ಹಾಗೂ ಥೀಮ್‌ಗಳನ್ನು ಅನ್ವೇಷಿಸಿ.</translation>
<translation id="4753212377237684548">ನಿಮ್ಮ ಎಲ್ಲಾ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="4391959806766569994">ನಿಮ್ಮ ಪೋಷಕರ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರಲು, ನೀವು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಿರುವ ನಿಮ್ಮ FlyWeb ಪ್ರೊಫೈಲ್‌ <ph name="USER_EMAIL_ADDRESS"/> ಗೆ ಬದಲಿಸಿ</translation>
<translation id="4222932583846282852">ರದ್ದುಗೊಳಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="4224210481850767180">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="2564888740660198776">ಈ ಖಾತೆಗೆ ನಿಮ್ಮ FlyWeb ಡೇಟಾವನ್ನು ಲಿಂಕ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="7337819873931851298">ಪ್ರಮಾಣಿತ ಸುರಕ್ಷತೆಗಿಂತ ಹೆಚ್ಚಿನ ಡೇಟಾವನ್ನು ವೆಬ್‌ಸೈಟ್‌ಗಳಿಂದ ವಿಶ್ಲೇಷಿಸುವ ಮೂಲಕ FlyWeb ತಿಳಿದಿರದಂತಹ ಅಪಾಯಕಾರಿ ವೆಬ್‌ಸೈಟ್‌ಗಳ ಕುರಿತು ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ. ನೀವು FlyWeb ಎಚ್ಚರಿಕೆಗಳನ್ನು ಸ್ಕಿಪ್ ಮಾಡಲು ಆಯ್ಕೆಮಾಡಬಹುದು.</translation>
<translation id="8391959103619318249">FlyWeb ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="8514458758262040082">FlyWeb ಜೊತೆಗೆ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="4281844954008187215">ಸೇವೆಯ ನಿಯಮಗಳು</translation>
<translation id="3393587701694585022">ಅನಿರ್ದಿಷ್ಟ ದೋಷದಿಂದಾಗಿ ಸ್ಥಾಪನೆಯು ವಿಫಲಗೊಂಡಿದೆ. FlyWeb ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿದ್ದರೆ, ದಯವಿಟ್ಟು ಅದನ್ನು ಮುಚ್ಚಿರಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="271336227467646058">FlyWeb ನಿಂದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಮಾಡಿ</translation>
<translation id="4304713468139749426">ಪಾಸ್‌ವರ್ಡ್ ನಿರ್ವಾಹಕ</translation>
<translation id="4334241893986177674">ಈ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="125418423241058931">Windows ಪ್ರಾರಂಭವಾದಾಗ FlyWeb ಅನ್ನು ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4400772909124543403">ಯಾವುದೇ ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿಲ್ಲ</translation>
<translation id="1376968889000878095">ಹೇಗಿದ್ದರೂ FlyWeb ನಿಂದ ನಿರ್ಗಮಿಸುವುದೇ?</translation>
<translation id="4413205837991854510">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಯಾವಾಗಲೂ ತೋರಿಸಿ</translation>
<translation id="6360389033094512399">FlyWeb ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗಲು ಅನುಮತಿಸಿ</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/>}one{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/>}other{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ</translation>
<translation id="4427306783828095590">ಫಿಶಿಂಗ್ ಮತ್ತು ಮಾಲ್‌ವೇರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲು ವರ್ಧಿತ ಸುರಕ್ಷತೆ ಹೆಚ್ಚಿನ ಸಹಾಯ ಮಾಡುತ್ತದೆ</translation>
<translation id="4434353761996769206">ಇನ್‌ಸ್ಟಾಲರ್‌‌ ದೋಷ: <ph name="INSTALLER_ERROR"/></translation>
<translation id="1198322798411238228"><ph name="MANAGER"/> FlyWeb ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ</translation>
<translation id="6643422079097100220">FlyWeb ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="8791209382165811772">FlyWeb for Testing ಕುರಿತು</translation>
<translation id="5651107152880556886">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಉಳಿಸಲು, ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="4493028449971051158">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ನಿರ್ವಾಹಕರಾಗಿ ರನ್ ಮಾಡಿ.</translation>
<translation id="4501471624619070934">ಈ ರಾಷ್ಟ್ರದಲ್ಲಿ ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿರುವುದರ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="3546782282376530369">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಡೇಟಾವನ್ನು ಹೇಗೆ ಸಂಗ್ರಹಿಸುತ್ತದೆ ಮತ್ತು ಬಳಸುತ್ತದೆ ಎಂಬಂತಹ ಗೌಪ್ಯತೆಯ ರೂಢಿಗಳನ್ನು ಪ್ರಕಟಿಸಿಲ್ಲ. ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="834808339160590901">FlyWeb ಗೆ ಸುಸ್ವಾಗತ; ಹೊಸ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಹೊಸ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗಿದೆ</translation>
<translation id="5094033276783634414">ನಿಮ್ಮ ಸುತ್ತಲಿನ ಪರಿಸರವನ್ನು ನಕ್ಷೆ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ ಕೈಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು FlyWeb ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="3363095592946520579">ನೀವು ಈಗಾಗಲೇ ಮತ್ತೊಂದು FlyWeb ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಮೂಲಕ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ</translation>
<translation id="8767255662414713095">FlyWeb, ಪುಟಗಳನ್ನು ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ಬ್ರೌಸಿಂಗ್ ಹಾಗೂ ಹುಡುಕಾಟ ವೇಗವಾಗುತ್ತದೆ. <ph name="BEGIN_LINK"/> ಪ್ರಿಲೋಡ್‌ ಪುಟಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">ನೀವು ಹಾನಿಕಾರಕವೆಂದು ಭಾವಿಸುವ ಸೈಟ್ ಕುರಿತು ನೀವು ವರದಿ ಮಾಡಿದಾಗ ಎಲ್ಲರಿಗೂ ಆನ್‌ಲೈನ್ ಸುರಕ್ಷತೆಯನ್ನು ಸುಧಾರಿಸಿ.</translation>
<translation id="5891777644455025808">ನೀವು ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಫೀಚರ್‌ ಅನ್ನು ಆಫ್ ಮಾಡಿರುವುದರಿಂದ ಮತ್ತು ಈ ಫೈಲ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗದ ಕಾರಣ FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="8775108347138515815">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ FlyWeb ಮೂಲಕ Google Lens ಅನ್ನು ಬಳಸಿ ನೋಡಿ</translation>
<translation id="4594305310729380060">ಈ ಸಾಧನದಲ್ಲಿನ Password Manager ಗೆ</translation>
<translation id="3349475100979552835">FlyWeb ಅಪ್ಲಿಕೇಶನ್‌ಗಳು</translation>
<translation id="4598116752460667024">ಪಟ್ಟಿಯಿಂದ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಾಗಿ ಹುಡುಕಿ.</translation>
<translation id="4970880042055371251">ChromeOS ಆವೃತ್ತಿ</translation>
<translation id="1936188352112244665">ಬಹುಪಾಲು ನವೀಕೃತವಾಗಿದೆ! ಅಪ್‌ಡೇಟ್ ಮಾಡುವುದನ್ನು ಮುಗಿಸಲು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="7657326395720709145">FlyWeb ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ FlyWeb ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ</translation>
<translation id="7966026667528388481">FlyWeb ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="7949810958067850297">FlyWeb ಪ್ರೊಫೈಲ್</translation>
<translation id="2962574118577609024">ನೀವು FlyWeb ಬಳಕೆಯ ವರದಿಗಳನ್ನು ಸಹ ಹಂಚಿಕೊಂಡರೆ, ಆ ವರದಿಗಳು ನೀವು ಭೇಟಿ ನೀಡುವ URL ಗಳನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="4673710618874938871"><ph name="USER_NAME"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ, ಸದಸ್ಯತ್ವ. ಖಾತೆಯ ಮೆನುವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="9219132550163437762">ಮತ್ತೊಂದು ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ (<ph name="HOST_NAME"/>) ಇನ್ನೊಂದು FlyWeb ಪ್ರಕ್ರಿಯೆಯ (<ph name="PROCESS_ID"/>) ಮೂಲಕ ಪ್ರೊಫೈಲ್ ಬಳಕೆಯಲ್ಲಿರುವಂತೆ ತೋರುತ್ತಿದೆ. ಪ್ರೊಫೈಲ್ ದೋಷಪೂರಿತಗೊಳ್ಳದಂತೆ ಅದನ್ನು FlyWeb ಲಾಕ್ ಮಾಡಿದೆ. ಇತರ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಳು ಈ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸುತ್ತಿಲ್ಲವೆಂದು ನಿಮಗೆ ಖಚಿತವಾಗಿದ್ದರೆ, ನೀವು ಪ್ರೊಫೈಲ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="4680828127924988555">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ರದ್ದುಮಾಡಿ</translation>
<translation id="6156840135417578237">ನಿಮ್ಮ ಕೆಲವು FlyWeb ಡೇಟಾವನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="1474749355173247622">ನೀವು ಸೈನ್ ಇನ್ ಆಗಿರುವಾಗ, FlyWeb ನಲ್ಲಿ ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿನ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟನ್ನು ನೀವು ಬಳಸಬಹುದು. <ph name="SHORTCUT"/> ನಿಮ್ಮ FlyWeb ಸೇವೆಗಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="5227023869666757348">ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ <ph name="ACCOUNT_EMAIL_LAST"/> ನಂತೆ FlyWeb ಗೆ ಯಾರೋ ಈ ಹಿಂದೆಯೇ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ಹೊಸ FlyWeb ಬಳಕೆದಾರರನ್ನು ರಚಿಸಿ.</translation>
<translation id="4724676981607797757">ಬೆಂಬಲವಿಲ್ಲದ ಪ್ರೊಟೊಕಾಲ್ ದೋಷದಿಂದಾಗಿ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="1671154647029930623">ಹೇಗಿದ್ದರೂ FlyWeb ಅನ್ನು ಮುಚ್ಚುವುದೇ?</translation>
<translation id="4143239505982500022">FlyWeb ಗೆ ವಿಶೇಷ ಸುರಕ್ಷತೆಯ ಅಪ್‌ಡೇಟ್‌‌ ಅನ್ನು ಈಗ ತಾನೇ ಅನ್ವಯಿಸಲಾಗಿದೆ. ಇದೀಗ ಮರುಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ನಾವು ಮರುಸ್ಥಾಪಿಸುತ್ತೇವೆ.</translation>
<translation id="82292346243148940">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, ಮತ್ತು ಇನ್ನೂ <ph name="COUNT"/> ಅನ್ನು FlyWeb ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="1802926274661855018">FlyWeb ನಲ್ಲಿ Gemini ತೆರೆದಿದ್ದರೆ, ನೀವು ಹೊಸ ಟ್ಯಾಬ್‌ಗಳನ್ನು ತೆರೆದಾಗಲೂ ಸೈಡ್ ಪ್ಯಾನೆಲ್ ತೆರೆದ ಸ್ಥಿತಿಯಲ್ಲಿಯೇ ಇರುತ್ತದೆ</translation>
<translation id="3469649164996417993">ಇದು FlyWeb ಹುಡುಕಾಟದಲ್ಲಿ ಬಳಸಲಾದ ಅದೇ ಕಾಗುಣಿತ ಪರೀಕ್ಷೆಯನ್ನು ಬಳಸುತ್ತದೆ. ನೀವು ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡುವ ಪಠ್ಯವನ್ನು FlyWeb ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನೀವು ಈ ವರ್ತನೆಯನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="7460496601839821581">FlyWeb ಅನ್ನು ಖಾತೆಯಿಲ್ಲದೆಯೇ ಬಳಸಿ</translation>
<translation id="2991144524835127379">mDNS ಟ್ರಾಫಿಕ್‌ಗೆ ಅನುಮತಿಸುವ ನಿಟ್ಟಿನಲ್ಲಿ FlyWeb ಗೆ ಒಳಬರುವ ನಿಯಮ.</translation>
<translation id="6208903184719035736">&amp;FlyWeb ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4918086044614829423">ಸಮ್ಮತಿಸು</translation>
<translation id="4918844574251943176">ಚಿತ್ರವನ್ನು ಕಾಪಿ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="5477235053075501816">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="7174589544844983914">FlyWeb ಹಿನ್ನೆಲೆ ಮೋಡ್‌ನಲ್ಲಿದೆ.</translation>
<translation id="9212977598552218412">FlyWeb ಸೈನ್ ಇನ್ ಡೈಲಾಗ್ ಅನ್ನು ಮುಚ್ಚಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="8366169706197332122">FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು FlyWeb ಗೆ ಸಂಬಂಧಿಸಿದ ನಿಮ್ಮ ಎಲ್ಲಾ ಸಂಗತಿಗಳನ್ನು ನೀವು ಪ್ರತ್ಯೇಕವಾಗಿಸಬಹುದು. ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರಿಗಾಗಿ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ರಚಿಸಿ ಅಥವಾ ಕೆಲಸ ಮತ್ತು ಮೋಜಿನ ವಿಷಯಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿಸಿ.</translation>
<translation id="7792628702371319769">ಅತಿಥಿಗಳು ಏನನ್ನೂ ಉಳಿಸದೆಯೇ FlyWeb ಬಳಸಬಹುದು.</translation>
<translation id="7370618680298767482">FlyWeb ನಲ್ಲಿನ ನಿಮ್ಮ ಖಾತೆ</translation>
<translation id="2760069255902967585">ನೀವಾಗಿಯೇ FlyWeb ಗೆ ಸೇರಿಕೊಳ್ಳಿ</translation>
<translation id="504699503110800016">ಓವರ್‌ಫ್ಲೋ ಮೆನು ತೆರೆಯಿರಿ</translation>
<translation id="6686344057006524628">ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ FlyWeb ಮೂಲಕ ನಿಮ್ಮ ಎಲ್ಲಾ FlyWeb ಮೆಚ್ಚಿನವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ</translation>
<translation id="2515109138500267971">ನಿಮ್ಮ ಹ್ಯಾಂಡ್‌ಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು FlyWeb ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="3910606758302645363">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> ಅನ್ನು FlyWeb ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="5174969993834422967">ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತೀರಿ. ನಿಮಗೆ ಸೂಚನೆ ನೀಡಲು ಈ ಸೈಟ್‌ಗೆ ಅನುಮತಿಸುವುದಕ್ಕಾಗಿ, ನಿಮ್ಮ ಸ್ಥಳ ಪಟ್ಟಿಯ ಬಲ ಮೂಲೆಯಲ್ಲಿರುವ ನೋಟಿಫಿಕೇಶನ್ ಐಕಾನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="5174983315706567306">ಸಾಕಷ್ಟು ಡಿಸ್ಕ್ ಸ್ಪೇಸ್ ಇಲ್ಲ.</translation>
<translation id="4326845160190496236">FlyWeb ಖಾತೆಗೆ ಸಂಬಂಧಿಸಿದಂತೆ ಮರು-ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ</translation>
<translation id="3540715470656277664">iOS ನಲ್ಲಿ FlyWeb ಬಳಸುವ ಮೂಲಕ ನೀವು ಎಲ್ಲಿ ನಿಲ್ಲಿಸಿದ್ದಿರೋ ಅಲ್ಲಿಂದಲೇ ಮುಂದುವರಿಸಿ.</translation>
<translation id="291933003154435191">FlyWeb ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="5234764350956374838">ವಜಾಗೊಳಿಸಿ</translation>
<translation id="5606966092070089147">ಲಿಂಕ್ ಅನ್ನು FlyWeb ಅಜ್ಞಾತ ವಿಂಡೋದಲ್ಲಿ ತೆರೆಯಿರಿ</translation>
<translation id="9098587825736815971">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಲು FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8295539942024823191">ನಿಮ್ಮ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲು, FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="5286907366254680517">ಪತ್ತೆಹಚ್ಚಲಾಗಿದೆ</translation>
<translation id="626007313130236514">FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="5361365805808004630">FlyWeb ಮೂಲಕ ಹುಡುಕಿ</translation>
<translation id="8888283148421206435">FlyWeb ಅಪ್‌ಡೇಟರ್ ಆಂತರಿಕ ಸೇವೆ</translation>
<translation id="3025882852178035952">FlyWeb ನಲ್ಲಿ ಇತರ Gemini ಫೀಚರ್‌ಗಳ ಜೊತೆಗೆ ಅವುಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="5346389065299425353">ಹಲವಾರು ಟ್ಯಾಬ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಟೂಲ್‌ಗಳನ್ನು ಸೇರಿಸುವ ಮೂಲಕ ನಿಮ್ಮ ಹುಡುಕಾಟವನ್ನು ಇನ್ನಷ್ಟು ಆಳವಾಗಿಸಿ</translation>
<translation id="8330248712705246714">ಈ ಡಾಕ್ಯುಮೆಂಟ್‌ನ ತ್ವರಿತ ಓವರ್‌ವ್ಯೂ ಪಡೆಯಿರಿ ಮತ್ತು FlyWeb ನಲ್ಲಿ Gemini ಮೂಲಕ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ</translation>
<translation id="6178233095056047786">FlyWeb ನಿಮ್ಮ ಪರಿಶೀಲನೆಗಾಗಿ ಕೆಲವು ಸುರಕ್ಷತೆಯ ಶಿಫಾರಸುಗಳನ್ನು ಕಂಡುಕೊಂಡಿದೆ</translation>
<translation id="8980390875915032396">ಇತರ FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="2441009746272048284">ನಿಮ್ಮ ಖಾತೆಯ ಸೈನ್ ಇನ್ ವಿವರಗಳು ತೀರಾ ಹಳೆಯದಾಗಿರುವ ಕಾರಣ ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="8449603408481238073">ನೀವು ನಿರ್ವಹಿಸಲಾದ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತಿರುವಿರಿ ಮತ್ತು ನಿಮ್ಮ FlyWeb ಪ್ರೊಫೈಲ್ ಮೂಲಕ ಅದರ ನಿರ್ವಾಹಕ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತಿರುವಿರಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಹಾಗೂ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ನಿಮ್ಮ FlyWeb ಡೇಟಾವನ್ನು <ph name="USER_NAME"/> ಅವರಿಗೆ ಶಾಶ್ವತವಾಗಿ ಬಂಧಿಸಲಾಗುತ್ತದೆ. FlyWeb ಖಾತೆಗಳ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಮೂಲಕ ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯ, ಆದರೆ ಬೇರೊಂದು ಖಾತೆಯೊಂದಿಗೆ ಈ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">ಹೆಚ್ಚುವರಿ ಕೋಡ್: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">ವೈಯಕ್ತೀಕರಣವನ್ನು ಪಡೆಯಲು, ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆಯಲ್ಲಿ FlyWeb ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="1456957080321742545">FlyWeb ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="1026219128963768190">FlyWeb ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="1284798564810038820">FlyWeb ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="4384293746734222420"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="3872448231555118416">FlyWeb ಸೈನ್-ಇನ್ ಅನ್ನು ಅನುಮತಿಸಿ</translation>
<translation id="1827750898515917134">FlyWeb ನಿಂದ ತೆಗೆದುಹಾಕಿ</translation>
<translation id="7460715011003906078">ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಕಡಿಮೆ ಮಾಡುತ್ತದೆ ಆದರೆ FlyWeb ಅನ್ನು ಅಸಿಮೆಟ್ರಿಕ್ ಎನ್‌ಕ್ರಿಪ್ಶನ್‌ಗಳ ವಿರುದ್ದ ಮತ್ತಷ್ಟು ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ</translation>
<translation id="5020755920249060562">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್‌ ರೂಪದಲ್ಲಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb ಬೀಟಾ</translation>
<translation id="1842654828911709974">{NUM_TABS,plural, =1{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್ ಅನ್ನು ವಿರಾಮಗೊಳಿಸಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="5385202369020319636">ಈ Linux ವಿತರಣೆಯಲ್ಲಿ ಇನ್ನು ಮುಂದೆ FlyWeb ಬೆಂಬಲಿಸದಿರುವ ಕಾರಣ, ಅದು ಸರಿಯಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು</translation>
<translation id="362367838300880777">FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಏಕೆಂದರೆ ಫೈಲ್ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮತ್ತು ಸಾಮಾಜಿಕ ನೆಟ್‌ವರ್ಕ್ ಖಾತೆಗಳಿಗೆ ಹಾನಿಯುಂಟುಮಾಡಬಹುದು</translation>
<translation id="2183749398075655200">ದಯವಿಟ್ಟು ಇತ್ತೀಚಿನ ಸಿಸ್ಟಂ ನವೀಕರಣಗಳನ್ನು FlyWeb ಸ್ಥಾಪಿಸುವಾಗ ಕಾಯಿರಿ.</translation>
<translation id="8996657165865563765">FlyWeb, ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="832204641669191126">FlyWeb ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ Google Drive ಮತ್ತು YouTube ನಂತಹ ನಿಮ್ಮ ಮೆಚ್ಚಿನ ಆ್ಯಪ್‌ಗಳೊಂದಿಗೆ ತಡೆರಹಿತವಾಗಿ ಕೆಲಸ ಮಾಡಿ.</translation>
<translation id="5524890928877629608">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಮೇಲಿನ ಎಡ ಮೂಲೆ: ಎಡಕ್ಕೆ <ph name="LEFT"/>%, ಮೇಲಕ್ಕೆ <ph name="TOP"/>%</translation>
<translation id="5738298079259740925">FlyWeb ನಲ್ಲಿ PDF ಗಳನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="5536164441519929134">ಈ ಟ್ಯಾಬ್ ಕುರಿತು<ph name="LINE_BREAK"/>ಕೇಳಿ</translation>
<translation id="6197315294677032380">ಭದ್ರತೆಗಾಗಿ, ನೀವು ಮೊದಲ ಬಾರಿಗೆ ಸೈಟ್‌ಗೆ ಭೇಟಿ ನೀಡಿದಾಗ JavaScript ಆಪ್ಟಿಮೈಸೇಷನ್ ಅನ್ನು FlyWeb ಆಫ್ ಮಾಡುತ್ತದೆ.

ಈ ಪುಟವು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ಆಪ್ಟಿಮೈಸೇಷನ್‌ ಅನ್ನು ಅನುಮತಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2009834183541338014">FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು Mac ಮೆನು ಬಾರ್‌ನಲ್ಲಿ ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="1307223624786767430"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="5579324208890605088">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ಸಾಮಾನ್ಯ ಬಳಕೆದಾರರಂತೆ ರನ್ ಮಾಡಿ, ನಿರ್ವಾಹಕರಾಗಿ ಅಲ್ಲ.</translation>
<translation id="4770353132265458564">FlyWeb ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಬಳಸಿ ಮತ್ತು ಅದು ಪಿನ್ ಆಗಿರಲಿ</translation>
<translation id="5596627076506792578">ಇನ್ನಷ್ಟು ಆಯ್ಕೆಗಳು</translation>
<translation id="5605834417512968703">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಲು ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನಿಂದ ನಿರ್ಗಮಿಸಲು Escape ಒತ್ತಿರಿ</translation>
<translation id="5618818588972826921">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಹುಡುಕಲು ಯಾವುದೇ ಪಠ್ಯ ಅಥವಾ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ ಅಥವಾ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನಿಂದ ಹೊರಬರಲು escape ಅನ್ನು ಒತ್ತಿ</translation>
<translation id="6096945112863785306">{0,plural, =0{FlyWeb ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}=1{FlyWeb ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}one{# ದಿನಗಳ ಮಟ್ಟಿಗೆ FlyWeb ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}other{# ದಿನಗಳ ಮಟ್ಟಿಗೆ FlyWeb ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}}</translation>
<translation id="7698117871740446964">ನೀವು FlyWeb ಅನ್ನು ಮುಚ್ಚಿದಾಗ ನಿಮ್ಮ ಸಾಧನದಿಂದ ಸೈಟ್ ಡೇಟಾವನ್ನು ಯಾವಾಗಲೂ ಅಳಿಸಿ</translation>
<translation id="5666891644992637849">ಇದೀಗ FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">ಈ ಭಾಷೆಯಲ್ಲಿ FlyWeb ಪ್ರದರ್ಶಿಸು</translation>
<translation id="569897634095159764">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್‌ಗೆ ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="5406894461513282158">FlyWeb ನಿಷ್ಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳಿಂದ ಮೆಮೊರಿಯನ್ನು ಮುಕ್ತಗೊಳಿಸುತ್ತದೆ. ಸಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳು ಹಾಗೂ ಇತರ ಆ್ಯಪ್‌ಗಳಿಗೆ ಇದು ಹೆಚ್ಚು ಕಂಪ್ಯೂಟರ್ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ ಮತ್ತು FlyWeb ಅನ್ನು ವೇಗವಾಗಿಡುತ್ತದೆ. ನಿಮ್ಮ ನಿಷ್ಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳಿಗೆ ನೀವು ಮರಳಿದಾಗ, ಅವು ಮತ್ತೆ ಸಕ್ರಿಯವಾಗುತ್ತವೆ. <ph name="BEGIN_LINK"/>ಮೆಮೊರಿ ಸೇವರ್‌ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="4909672456103357452">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನೀವು ಮರೆತಿದ್ದರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ FlyWeb ಡೇಟಾವನ್ನು <ph name="SETTINGS_LINK"/></translation>
<translation id="4985665094509307744">FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ. FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ.</translation>
<translation id="6646499372922411025">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಸೆಟ್ ಮಾಡುವ ಮೂಲಕ ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಿಂಕ್ ಮಾಡಿ.</translation>
<translation id="5809516625706423866">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. HTTP 401 ಅನಧಿಕೃತವಾಗಿದೆ. ನಿಮ್ಮ ಪ್ರಾಕ್ಸಿ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="5890196138054330443">FlyWeb ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ FlyWeb ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ. ಈ ಸೆಟ್ಟಿಂಗ್ ಆಫ್ ಆಗಿದೆ.</translation>
<translation id="8651664269417935890">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, FlyWeb ಅನ್ನು ಅಪ್‌ಡೇಟ್‌ ಮಾಡಿ</translation>
<translation id="5824893331272123205">ಈ ಪ್ಯಾನೆಲ್ ಅನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಪುನಃ ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="8331941171144629807">FlyWeb ಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="5831968418530309689">FlyWeb ನ ಪ್ರಬಲ ರಕ್ಷಣೆಗಳನ್ನು ಒದಗಿಸಲು ಹೆಚ್ಚುವರಿ ಫೀಚರ್‌ಗಳನ್ನು ಆನ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="5871205389137001634">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನಿಂದ ನಿರ್ಗಮಿಸಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="7581082856615467651">ಈ ಐಟಂಗಳಲ್ಲಿ ಮಾಲ್‌ವೇರ್ ಇರುವುದನ್ನು FlyWeb ಪತ್ತೆಹಚ್ಚಿದೆ:</translation>
<translation id="8117102597407263352">ನಿಮ್ಮ ಬ್ರೌಸರ್ ಸುರಕ್ಷಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಹೊಂದಿದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಲು FlyWeb ನಿಯಮಿತವಾಗಿ ಪರಿಶೀಲಿಸುತ್ತದೆ. ನಿಮ್ಮ ಪರಿಶೀಲನೆ ಏನಾದರೂ ಅಗತ್ಯವಿದ್ದರೆ ನಾವು ನಿಮಗೆ ತಿಳಿಸುತ್ತೇವೆ.</translation>
<translation id="5895138241574237353">ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="7740963625398321937">FlyWeb ನಲ್ಲಿ Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - ನೆಟ್‌ವರ್ಕ್ ಸೈನ್ ಇನ್</translation>
<translation id="5924017743176219022">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ...</translation>
<translation id="5941711191222866238">ಕುಗ್ಗಿಸಿ</translation>
<translation id="6669708050135513710">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಈ ಬುಕ್‌ಮಾರ್ಕ್ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3358004031263458708">FlyWeb ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿ</translation>
<translation id="5960071705175224773">ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅಪರಿಚಿತ ಆ್ಯಪ್‌ನಿಂದ ಬದಲಾಯಿಸಲಾಗಿದೆ</translation>
<translation id="5977420883993828287">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಿಂದ ಮತ್ತೊಮ್ಮೆ ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="348384176991400026">{COUNT,plural, =1{FlyWeb ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ.}one{FlyWeb ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ.}other{FlyWeb ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ.}}</translation>
<translation id="4955869506208896934">ಸಿಂಕ್ ಪ್ರಾರಂಭಿಸಲು FlyWeb ಅಪ್‌ಡೇಟ್ ಮಾಡಿ</translation>
<translation id="5990360079535151574">ಟೂಲ್‌ಬಾರ್‌ನಲ್ಲಿರುವ "ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳು" ಬಟನ್‌ನಿಂದ, ನೀವು ಬ್ರೌಸ್ ಮಾಡುವಾಗ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು ನೀವು ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳನ್ನು ಪುನಃ ತೆರೆಯಬಹುದು</translation>
<translation id="6003112304606738118">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="HOURS"/> ಗಂಟೆ(ಗಳು) ಬಾಕಿಯಿವೆ.</translation>
<translation id="6009821354356307391">ಫಾಲೋ ಅಪ್‌ಗಾಗಿ ಕೇಳಿ</translation>
<translation id="6040143037577758943">ಮುಚ್ಚಿರಿ</translation>
<translation id="4530644097272078700">ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿದಾಗ ಆನ್‌ಲೈನ್ ಶಾಪಿಂಗ್‌ನಿಂದ ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="619330138913595431">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು, ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡದ ಸೈಟ್‌ಗಳಿಂದ ಅನುಮತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಲು FlyWeb ಗೆ ಅನುಮತಿಸಿ. ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ನಿಲ್ಲಿಸುವುದಿಲ್ಲ.</translation>
<translation id="8714139918792771260">&amp;FlyWeb ನಲ್ಲಿ ತೆರೆಯಿರಿ</translation>
<translation id="6069027071882229820">ಚಿತ್ರದ ರೂಪದಲ್ಲಿ ಕಾಪಿ ಮಾಡಿ</translation>
<translation id="499541338626558192">FlyWeb ಗೆ <ph name="EXTENSION_NAME"/> ಅನ್ನು ಸೇರಿಸಲಾಗಿದೆ</translation>
<translation id="5880307616068888895">FlyWeb ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ. ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ.</translation>
<translation id="1429530657225981960">ಆನ್ • ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು FlyWeb ಗೆ ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="8056369489402655495">FlyWeb ನಲ್ಲಿನ ನಿಮ್ಮ ಖಾತೆ</translation>
<translation id="1683225514126450592">FlyWeb ಪರಿಕರಪಟ್ಟಿಯಲ್ಲಿ ಆ್ಯಕ್ಸೆಸ್ ವಿನಂತಿಗಳನ್ನು ತೋರಿಸಲು ವಿಸ್ತರಣೆಯನ್ನು ಅನುಮತಿಸಿ</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> ಅಪಾಯಕಾರಿಯಾಗಿದೆ, ಹಾಗಾಗಿ FlyWeb ಅದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="1773252983747911987">FlyWeb ಶೀಘ್ರದಲ್ಲೇ ಮುಚ್ಚಲ್ಪಡುತ್ತದೆ ಮತ್ತು ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
<translation id="1686760912855738719">ನೀವು ಇಲ್ಲಿ FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು</translation>
<translation id="5461795497268691356">ನೀವು ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸಿದರೆ, ಪ್ರಿಲೋಡ್ ಮಾಡುವಾಗ FlyWeb ಅವುಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="6165508094623778733">ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="1292852397592425449">ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ FlyWeb ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸಿ</translation>
<translation id="7031783851441272920">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಬಹುದು<ph name="LINE_BREAK"/>ನೀವು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಒದಗಿಸಿದರೆ FlyWeb ನಿಮಗಾಗಿ ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಬಹುದು. ಫೈಲ್ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು Google Safe Browsing ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ, ಆದರೆ ಫೈಲ್‌ನ ವಿಷಯಗಳು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಉಳಿಯುತ್ತದೆ.</translation>
<translation id="6182736845697986886">ಅಪ್‌ಡೇಟ್ ಸರ್ವರ್ ಆಂತರಿಕ ದೋಷದಿಂದಾಗಿ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="4403968929742079769">ನಿಮ್ಮ <ph name="TARGET_DEVICE_NAME"/> ನಲ್ಲಿ ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ನಂತರ ಪುನಃ ಕಳುಹಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8345188246355148375">FlyWeb ಅನ್ನು ಮಿನಿಮೈಸ್ ಮಾಡಿದ್ದರೂ ಸಹ, ಎಲ್ಲಿಂದಲಾದರೂ ಹುಡುಕಿ ಮತ್ತು ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ. FlyWeb ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗಲು ಅನುಮತಿಸುತ್ತದೆ.</translation>
<translation id="1855179706668101462">ಈ ಕಂಪ್ಯೂಟರ್ FlyWeb ನ ಇತ್ತೀಚಿನ ಹೆಚ್ಚಿನ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿದೆ. ಸಾಫ್ಟ್‌ವೇರ್ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ದಯವಿಟ್ಟು FlyWeb ಅನ್ನು ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="651290634887454330">{0,plural, =0{ಇದೀಗ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}=1{1 ಸೆಕೆಂಡಿನಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ಸೆಕೆಂಡುಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ಸೆಕೆಂಡುಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="2586408713760853791">ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು FlyWeb ಗೆ ಸಂಗ್ರಹಣೆಯ ಪ್ರವೇಶದ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="1603558835003845196">FlyWeb ನಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಮಾಡಲಾಗಿರುವ ಅಸುರಕ್ಷಿತ ಸೈಟ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ, URL ಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ</translation>
<translation id="5751080530525677552">FlyWeb ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಮಾಡಿ</translation>
<translation id="6248988683584659830">ಸೆಟ್ಟಿಂಗ್‌‌ಗಳಲ್ಲಿ ಹುಡುಕಿ</translation>
<translation id="6342238100521499844">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ FlyWeb ಆ್ಯಪ್ ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ FlyWeb ನ ಅತ್ಯುತ್ತಮ ಸುರಕ್ಷತಾ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="3542157007113577464">FlyWeb ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಬೇಕೆ?</translation>
<translation id="2166321493116256664">ಈ ಟ್ಯಾಬ್‌ಗಳು ಹೆಚ್ಚುವರಿ ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತಿವೆ. ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು, ಅವುಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು FlyWeb ಅನ್ನು ಅನುಮತಿಸಿ.</translation>
<translation id="3794967601634523398">ನಿಮ್ಮ FlyWeb ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="6475001900959697061">ನಿಮ್ಮ FlyWeb ಪ್ರೊಫೈಲ್ ಅನ್ನು ಹೆಸರಿಸಿ</translation>
<translation id="6356094940346377065">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ನಿಮ್ಮನ್ನು ಕೇಳುತ್ತದೆ</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಹಾಗಾಗಿ FlyWeb ಅದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="5523868569707953059">FlyWeb ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="8226838065217375546">FlyWeb ನಲ್ಲಿ ಬೇರೆ ಕಾರ್ಯಾಚರಣೆಯು ಪ್ರಗತಿಯಲ್ಲಿದೆ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6063700568539132984">ನಿಮ್ಮ FlyWeb ಖಾತೆಯ ಮೂಲಕ ಮತ್ತು ಹಂಚಿದ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ FlyWeb ಬಳಕೆಯು ಇದೀಗ ತುಂಬಾ ಸುಲಭವಾಗಿದೆ.</translation>
<translation id="5622088198573179705">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಸೆಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ, ಇಷ್ಟಪಡುವ ಮತ್ತು ವಿಶ್ವಾಸವಿಡುವ ಫೀಚರ್‌ಗಳಿಗೆ ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯಿರಿ.</translation>
<translation id="4709797814274745581">FlyWeb ಶಾರ್ಟ್‌ಕಟ್</translation>
<translation id="6595693843242836271">ಈ ಫೈಲ್ ಅನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
<translation id="6890209090736444656">FlyWeb ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ?</translation>
<translation id="6375219077595103062">Password Manager ಗೆ ಶಾರ್ಟ್‌ಕಟ್ ಸೇರಿಸಿ</translation>
<translation id="6388799252195623474">ಈ ಕುರಿತು ನನಗೆ ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="8407518452288816185">ಮುಂದುವರಿಯಲು, FlyWeb ಗೆ <ph name="EMAIL"/> ಎಂಬುದಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ಇದು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ನೀತಿಗಳನ್ನು ನೀವು ಪಡೆದುಕೊಂಡಿದ್ದೀರಿ ಎಂದು ಖಚಿತಪಡಿಸುತ್ತದೆ.</translation>
<translation id="2104550252781001709">ಕಂಪ್ಯೂಟರ್ ಸ್ಕ್ರೀನ್‌ನೊಳಗೆ FlyWeb ಲೋಗೋ.</translation>
<translation id="6636986997730784876">FlyWeb ಒಂದು ವೆಬ್ ಬ್ರೌಸರ್ ಆಗಿದ್ದು ವೆಬ್‌ಪುಟಗಳನ್ನು ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ವೇಗದೊಂದಿಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ. ಇದು ವೇಗವಾದ, ಸ್ಥಿರವಾದ, ಮತ್ತು ಬಳಸಲು ಸುಲಭವಾಗಿದೆ. ಮಾಲ್‌ವೇರ್‌ನೊಂದಿಗೆ ಹೆಚ್ಚು ಸುರಕ್ಷಿತವಾಗಿ ಹಾಗೂ FlyWeb ನಲ್ಲಿ ವಿನ್ಯಾಸಗೊಳಿಸಲಾದ ಫಿಶಿಂಗ್ ಸುರಕ್ಷೆಯೊಂದಿಗೆ ವೆಬ್ ಅನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ.</translation>
<translation id="4359872290500912570">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ನೀವು ಯಾವಾಗಲೂ FlyWeb ಡೇಟಾವನ್ನು ಬಳಸಬಹುದು ಮತ್ತು ಸೇವ್ ಮಾಡಬಹುದು ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಲು, ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸಿ</translation>
<translation id="3141715584864891679">FlyWeb ವೇಗವಾಗಿ ರನ್ ಆಗುತ್ತದೆ ಮತ್ತು JavaScript ಅನ್ನು ಬಳಸುವ ಫೀಚರ್‌ಗಳು, ವಿನ್ಯಾಸಗೊಳಿಸಿದಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸಬೇಕು</translation>
<translation id="6436260184216827876">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಲಭ್ಯವಿಲ್ಲ. ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2139300032719313227">ChromeOS ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="7560906925528428585">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಇನ್ನೂ ಹೆಚ್ಚಿನ ಪುಟಗಳನ್ನು FlyWeb ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="5806916401157869650">ದರಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಮತ್ತು ಯಾವುದೇ ಸೈಟ್‌ನಲ್ಲಿ ದರ ಇಳಿಕೆಯಾದಾಗ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ</translation>
<translation id="2970877059928503461">ಆಫ್ • ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು FlyWeb ಗೆ ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="173462352822069427">FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳಿಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="8914008746092110409">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ ನೀವು FlyWeb ಅನ್ನು ತೆರೆದಾಗ, ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="3484308111967198595">FlyWeb ನಿಂದ ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="1474676525193357364">ನೀವು FlyWeb ಪ್ರಾರಂಭಿಸಿದಾಗ ತೋರಿಸಬೇಕಾದ ಪುಟವನ್ನು ಕೂಡಾ ಇದು ನಿಯಂತ್ರಿಸುತ್ತದೆ.</translation>
<translation id="648319183876919572">ಅಪಾಯಕಾರಿ ವೆಬ್‌ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ವಿರುದ್ಧ ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಲು ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಹೆಚ್ಚಿನ ಸಹಾಯ ಮಾಡುತ್ತದೆ</translation>
<translation id="5777905264835557372">FlyWeb ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="764623543427374554">FlyWeb ನಲ್ಲಿ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳು ತೆರೆದಿರುತ್ತವೆ</translation>
<translation id="8852057261917278552">FlyWeb ಅನ್ನು <ph name="TIMEOUT_DURATION"/> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.</translation>
<translation id="8592211619057897362">ಪ್ರತಿಯೊಂದು ಪ್ರೊಫೈಲ್ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟವುಗಳಂತಹ ತನ್ನ ಸ್ವಂತ FlyWeb ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="6556755379298048869">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಮೂಲಕ ಹುಡುಕಿ.</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೇಗೆ ಖಾಸಗಿಯಾಗಿ ಇರಿಸುತ್ತದೆ<ph name="END_LINK"/> ಎಂಬುದರ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="654107331777480705">FlyWeb ಮರುಪ್ರಾರಂಭಗೊಂಡ ನಂತರ ಈ ಸೆಟ್ಟಿಂಗ್‌ಗೆ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="3594828538355548672">FlyWeb ಮುಖ್ಯ ಮೆನುವಿನಲ್ಲಿರುವ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡುವ ಮೂಲಕ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ.</translation>
<translation id="7489092380688543560">ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಲು ನೀವು ಇನ್ನೊಂದು FlyWeb ಪ್ರೊಫೈಲ್‌ಗೆ ಬದಲಾಯಿಸಬಹುದು</translation>
<translation id="472958395762114471">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಅತ್ಯುತ್ತಮ AI ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಲು FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="8243012192239086369">ಕಾಗುಣಿತ ದೋಷಗಳನ್ನು ಸರಿಪಡಿಸಲು, ನೀವು ಪಠ್ಯ ಕ್ಷೇತ್ರಗಳಲ್ಲಿ ಟೈಪ್ ಮಾಡುವ ಪಠ್ಯವನ್ನು FlyWeb, FlyWeb ಗೆ ಕಳುಹಿಸುತ್ತದೆ</translation>
<translation id="3927263773110604886">FlyWeb ನೋಟಿಫಿಕೇಶನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ</translation>
<translation id="6600016381025017075">ಈ ಪುಟದಲ್ಲಿ ಯಾವುದನ್ನಾದರೂ ಹುಡುಕಿ</translation>
<translation id="6888846095017247017">ನೀವು ಮುಂದಿನ ಬಾರಿ FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="4481788155537463533">Windows ಪ್ರಾರಂಭವಾದಾಗ FlyWeb ಈಗ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ನೀವು ತಕ್ಷಣವೇ ಬ್ರೌಸ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಬಹುದು. ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಇದನ್ನು ಆಫ್ ಮಾಡಬಹುದು.</translation>
<translation id="1116311888485102603">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಯಿರಿ: FlyWeb ನಿಮ್ಮ ಕೊನೆಯ ಸೆಶನ್‌ನಿಂದ ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿದೆ. ನೀವು ಇದನ್ನು ಇದರಲ್ಲಿ ಆಫ್ ಮಾಡಬಹುದು</translation>
<translation id="1886169834787876002">ನಿಮ್ಮ ಸುತ್ತಮುತ್ತಲಿನ ಪ್ರದೇಶದ 3D ನಕ್ಷೆಯನ್ನು ರಚಿಸಲು FlyWeb ಗೆ ಕ್ಯಾಮರಾ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="7570986009744020649">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸಹ ನೀವು ಸೇವ್ ಮಾಡಿದರೆ, ನೀವು FlyWeb ನಲ್ಲಿ ಉತ್ಪನ್ನದ ಬೆಲೆಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು ಬೆಲೆ ಕಡಿಮೆಯಾದಾಗ ಸೂಚನೆ ಪಡೆಯಬಹುದು</translation>
<translation id="6676384891291319759">ಇಂಟರ್ನೆಟ್ ಅನ್ನು ಪ್ರವೇಶಿಸಿ</translation>
<translation id="1363996462118479832">ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ ದೋಷವಿರುವ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="5743696427773796626">FlyWeb ನಿಂದ ಈ ಆ್ಯಪ್‌ನ ಡೇಟಾವನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="4152880912192471857">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ FlyWeb ಗೆ ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="6712881677154121168">ಡೌನ್‌ಲೋಡ್ ದೋಷ: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">FlyWeb ನ ಹೊಸ ಆವೃತ್ತಿಯಾಗಿರುವುದರಿಂದ ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ. ಕೆಲವೊಂದು ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿಲ್ಲದಿರಬಹುದು. ದಯವಿಟ್ಟು ಬೇರೆ ಒಂದು ಪೊಫೈಲ್ ಡೈರೆಕ್ಟರಿ ಅನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ ಅಥವಾ FlyWeb ನ ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಿ.</translation>
<translation id="5528558621229392814">ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಇತರ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಲು, ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆ ಹಾಗೂ ಲಿಂಕ್ ಮಾಡಲಾದ FlyWeb ಸೇವೆಗಳಲ್ಲಿ FlyWeb ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="7728046102681268859">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿನ ಎಲ್ಲ ಬಳಕೆದಾರರಿಗೆ ಈಗಾಗಲೇ FlyWeb ಸ್ಥಾಪಿತವಾಗಿದೆ.</translation>
<translation id="2006421382007321898">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ಬುಕ್‌ಮಾರ್ಕ್ ಅನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="4328426102261301637">FlyWeb ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ FlyWeb ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ. ಈ ಸೆಟ್ಟಿಂಗ್ ಆನ್ ಆಗಿದೆ.</translation>
<translation id="207175655966839154">{count,plural, =1{ನಿಮ್ಮ ಕೆಲವು FlyWeb ಡೇಟಾವನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು (1 ಐಟಂ) ಅಳಿಸಲಾಗುತ್ತದೆ.}one{ನಿಮ್ಮ ಕೆಲವು FlyWeb ಡೇಟಾವನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}other{ನಿಮ್ಮ ಕೆಲವು FlyWeb ಡೇಟಾವನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}}</translation>
<translation id="1292831930742306370">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಆದ್ದರಿಂದ ಇದನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಬೇಕೆಂದು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="1547295885616600893">ಹೆಚ್ಚುವರಿ <ph name="BEGIN_LINK_CROS_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_CROS_OSS"/> ನಿಂದ ChromeOS ಮಾಡಲು ಸಾಧ್ಯ.</translation>
<translation id="6831043979455480757">Translate</translation>
<translation id="6432682256389755533">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಎಂದಾದರೂ ಹ್ಯಾಕ್‌ ಆಗಿವೆಯೇ ಎಂಬುದನ್ನು FlyWeb ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="684888714667046800">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ನೀವು ಫೈರ್‌ವಾಲ್ ಅನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ, <ph name="PRODUCT_EXE_NAME"/> ಅನುಮತಿ ಪಟ್ಟಿಯಲ್ಲಿ ಇದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">ಮುಂದುವರಿಸಲು ಟ್ಯಾಬ್ ಅನ್ನು ಒತ್ತಿರಿ</translation>
<translation id="6862030660799253820">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಬಳಸಿಕೊಂಡು ಈ ಚಿತ್ರವನ್ನು ಹುಡುಕಿ</translation>
<translation id="6869568587896659271">ವಿಳಾಸ ಪಟ್ಟಿಯ ಕೆಳಗಿನ ವೆಬ್‌ಸೈಟ್‌ಗಳಿಗೆ ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್</translation>
<translation id="4695676871328690599">"<ph name="EXTENSION_NAME"/>" ನಲ್ಲಿ ಮಾಲ್‌ವೇರ್ ಇರುವುದನ್ನು FlyWeb ಪತ್ತೆಹಚ್ಚಿದೆ</translation>
<translation id="6877155553248388166">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಕೆಳಗಿನ ಬಲ ಮೂಲೆ: ಬಲಕ್ಕೆ <ph name="RIGHT"/>%, ಕೆಳಕ್ಕೆ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">ನಕಲಿಸು</translation>
<translation id="6898028264630240901">ನೀವು ಬ್ರೌಸ್ ಮಾಡುವಾಗ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು ನೀವು ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳನ್ನು ಪಿನ್ ಮಾಡಬಹುದು</translation>
<translation id="8416061171168102237">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="3503126745419877918">&amp;FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="4397299252625349918">ಈ ಕ್ರಿಯೆಯು:
          <ph name="LINE_BREAKS"/>
            • ನಿಮ್ಮ ಆರಂಭಿಕ ಪುಟ, ಹೊಸ ಟ್ಯಾಬ್ ಪುಟ, ಸರ್ಚ್ ಎಂಜಿನ್ ಮತ್ತು ಪಿನ್ ಮಾಡಿದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
            <ph name="LINE_BREAK"/>
            • ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAK"/>
            • ಕುಕೀಗಳು ಮತ್ತು ಇತರ ತಾತ್ಕಾಲಿಕ ಸೈಟ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAK"/>
            • FlyWeb ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
            <ph name="LINE_BREAKS"/>
            ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಸೇವ್ ಮಾಡಿದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳ ಮೇಲೆ ಇದು ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.</translation>
<translation id="2640214066670118583">ನೀವು FlyWeb ನ <ph name="BOOKMARK_LIMIT"/> ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳ ಮಿತಿಯನ್ನು ತಲುಪಿದ್ದೀರಿ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಕೆಲವು ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಇನ್ನೂ ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ.

ನೀವು ಕೆಲವು ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಅಳಿಸುವವರೆಗೆ ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ ಹೊಸ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಸೇವ್ ಮಾಡದ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="6965382102122355670">ಸರಿ</translation>
<translation id="3453763134178591239">ChromeOS ನಿಯಮಗಳು</translation>
<translation id="1163386134146281359">ನಿಮ್ಮ ಖಾತೆ <ph name="ACCOUNT_EMAIL"/> ನಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="7011190694940573312">ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂನ ಈ ಆವೃತ್ತಿಯನ್ನು ಬೆಂಬಲಿಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="7024536598735240744">ಅನ್‌ಪ್ಯಾಕ್ ದೋಷ: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">ನಿಮ್ಮ ಸ್ವಂತ FlyWeb ಅನ್ನು ರಚಿಸಿ</translation>
<translation id="7047386856539490735">ಈ ಫಲಿತಾಂಶಗಳು ಉಪಯುಕ್ತವಾಗಿವೆಯೇ?</translation>
<translation id="3945284827084409390">FlyWeb ಅಪ್‌ಡೇಟ್‌ ಮಾಡಿ</translation>
<translation id="7886270027101123253">ಚಿತ್ರದಲ್ಲಿ ಉಪಯುಕ್ತ ವಿವರಣೆಯು ಇಲ್ಲದಿದ್ದರೆ, FlyWeb ನಿಮಗಾಗಿ ಒಂದು ವಿವರಣೆಯನ್ನು ಒದಗಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ವಿವರಣೆಗಳನ್ನು ರಚಿಸಲು, ಚಿತ್ರಗಳನ್ನು FlyWeb ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="8434939140421950539">ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಬಳಸುವಾಗ AI ನ ಪವರ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="2647329478963461727">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ FlyWeb ಆ್ಯಪ್‌ ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ನಿಮ್ಮ ಜೊತೆಗೇ ಇರಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="5695394421048248926">FlyWeb for Testing ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="6802544479988856975">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ FlyWeb ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="8694083743003679818">FlyWeb ನಿಂದ <ph name="EXTENSION_NAME"/> ಅನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="6017914745388312119">FlyWeb ಅನ್ನು <ph name="TIMEOUT_DURATION"/> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದರ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.</translation>
<translation id="3283953248242339756">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ FlyWeb ಗೆ ಕ್ಯಾಮರಾ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="4729674580260824908">FlyWeb ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="805403942934515799">ನೀವು ಎಲ್ಲಿದ್ದರೂ, FlyWeb ನಲ್ಲಿ Gemini ಮೂಲಕ ಏನನ್ನಾದರೂ ಕೇಳಿ</translation>
<translation id="7093403858436459499">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ತ್ವರಿತವಾಗಿ ಪಡೆಯಲು FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="935820624106805690">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ FlyWeb ಅನ್ನು ಬಳಸಿ</translation>
<translation id="7216228761061470870">ನೀವು ಡೆಸ್ಕ್‌ಟಾಪ್‌ನಲ್ಲಿ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="1678436729108859736">ಕಾರ್ಯನಿರ್ವಾಹಕ - FlyWeb</translation>
<translation id="7587087358591725059">ಇತರ ಆ್ಯಪ್‌ಗಳು ಅಥವಾ ಫೈಲ್‌ಗಳಂತಹ FlyWeb ನ ಹೊರಗಿನ ಕಂಟೆಂಟ್ ಕುರಿತು ಕೇಳಿ</translation>
<translation id="7013534648688018698"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="4889865510625659193">ತಕ್ಷಣವೇ ಬ್ರೌಸ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿ: Windows ಪ್ರಾರಂಭವಾದಾಗ FlyWeb ಈಗ ಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="7274695763216404502">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಿಂದ ಮತ್ತೊಮ್ಮೆ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="7288567540154601580">ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="5321339461210685340">ಸಿಸ್ಟಂ ಆಡಿಯೊವನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು FlyWeb ಗಾಗಿ 'ಸಿಸ್ಟಂ ಆಡಿಯೊ ರೆಕಾರ್ಡಿಂಗ್ ಮಾತ್ರ' ಎಂಬುದನ್ನು ಅನುಮತಿಸಿ. ನಂತರ ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="7299899569525778554">ಡೆಸ್ಕ್‌ಟಾಪ್‌ನಿಂದ ಹುಡುಕಿ</translation>
<translation id="2866611433272355726">FlyWeb ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="5013690772358862887">ನಿಮ್ಮ ಪ್ರಾಶಸ್ತ್ಯಗಳ ಫೈಲ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಅಮಾನ್ಯವಾಗಿದೆ. ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರುಪಡೆದುಕೊಳ್ಳುವಲ್ಲಿ FlyWeb ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="7324051657739063017">ನೀವು ಬ್ರೌಸ್ ಮಾಡುವಾಗ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು ನೀವು ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳನ್ನು ಪುನಃ ತೆರೆಯಬಹುದು</translation>
<translation id="1123144153876435088">ನಿಮ್ಮ ವೆಬ್, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತರ FlyWeb ಸಂಗತಿಗಳು ಇಲ್ಲಿ ಲೈವ್ ಆಗುತ್ತವೆ.</translation>
<translation id="8915041713909379783">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಹೊಂದಿರುವವರು ಮಾತ್ರ ನಿಮ್ಮ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಡೇಟಾವನ್ನು ಓದಬಹುದು. ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು FlyWeb ಗೆ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಅದನ್ನು FlyWeb ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ. ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನೀವು ಮರೆತರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, ನೀವು <ph name="BEGIN_LINK"/>ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ FlyWeb ಡೇಟಾವನ್ನು ಅಳಿಸಬೇಕಾಗುತ್ತದೆ<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746"><ph name="TARGET_URL_HOSTNAME"/> ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯುವುದಕ್ಕಾಗಿ <ph name="ALTERNATIVE_BROWSER_NAME"/> ಅನ್ನು ತೆರೆಯಲು, ನಿಮ್ಮ ಸಿಸ್ಟಂ ನಿರ್ವಾಹಕರು FlyWeb ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ್ದಾರೆ.</translation>
<translation id="7352651011704765696">ಯಾವುದೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="7601756527349047847">ಭವಿಷ್ಯದ FlyWeb ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನಿಮಗೆ macOS 13 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಗಳ ಅಗತ್ಯವಿದೆ. ಈ ಕಂಪ್ಯೂಟರ್ macOS 12 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="3916387280110223245">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> ಅನ್ನು FlyWeb ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="3313237823190188892">FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು ಸಿಸ್ಟಮ್ ಟ್ರೇನಲ್ಲಿ ತೋರಿಸಿ</translation>
<translation id="7401687852903179959">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಈ ವೀಡಿಯೊವನ್ನು ಹುಡುಕಿ</translation>
<translation id="6624551989332401777">FlyWeb ಈಗ ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿದೆ</translation>
<translation id="277733508197886564">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಸಿ: ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗಲೆಲ್ಲಾ FlyWeb ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ. ಇದನ್ನು ಆಫ್ ಮಾಡಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ</translation>
<translation id="948152006162936800">FlyWeb ಗೆ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಇಂಪೋರ್ಟ್ ಮಾಡಿ</translation>
<translation id="4755314372270379254">1. ಕೆಳಗಿನ <ph name="BUTTON_LABEL"/> ಅನ್ನು ಕ್ಲಿಕ್‌ ಮಾಡಿ
2. ನಿಮ್ಮ Windows ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ <ph name="BUTTON_2"/> ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ
3. ತ್ವರಿತ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ FlyWeb ಅನ್ನು ಪಿನ್ ಮಾಡಲು Windows ನೋಟಿಫಿಕೇಶನ್‌ನಲ್ಲಿ <ph name="BUTTON_3"/> ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="7450541714075000668">ಪಠ್ಯವನ್ನು ಕಾಪಿ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="7472280958921965834">ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್ ಬಳಸಲು, <ph name="BEGIN_LINK"/>ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> FlyWeb ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="2431618580332826398">ಭವಿಷ್ಯದ FlyWeb ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 7 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="2154651873647244914">FlyWeb ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆ?</translation>
<translation id="3137757192868162370">ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿರುವ FlyWeb ನ ಅದೇ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು FlyWeb ಅನ್ನು ಮುಚ್ಚಿರಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="3065486555702061722">ನೆನಪಿರಲಿ: FlyWeb ನ ಅತ್ಯುತ್ತಮ ಅನುಭವ ಈಗ ನಿಮ್ಮ ಜೇಬಿನಲ್ಲಿದೆ</translation>
<translation id="4027434552262956425">ಸೈಟ್‌ಗಳು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ. ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಆಗಿದ್ದರೆ, ಎಲ್ಲಾ FlyWeb ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚುವುದರಿಂದ ನಿಮ್ಮ FlyWeb ಖಾತೆಯನ್ನು ಹೊರತುಪಡಿಸಿ ಹೆಚ್ಚಿನ ಸೈಟ್‌ಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="4731230085409037950">{0,plural, =1{1 ನಿಮಿಷದಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ನಿಮಿಷಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ನಿಮಿಷಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="301074550630080641">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು, ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡದ ಸೈಟ್‌ಗಳಿಂದ ಅನುಮತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಲು FlyWeb ಗೆ ಅವಕಾಶ ನೀಡಿ.</translation>
<translation id="3930051800510118744">ತಕ್ಷಣವೇ ಬ್ರೌಸಿಂಗ್ ಪ್ರಾರಂಭಿಸಲು FlyWeb ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ಇನ್‌ಸ್ಟಾಲರ್‌‌</translation>
<translation id="3067364763515000789">FlyWeb ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೋಫೋನ್ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="1381291360713116383">FlyWeb ಇದೀಗ ಉತ್ತಮಗೊಂಡಿದೆ</translation>
<translation id="3892366519980032442">ಈಗ ನೀವು FlyWeb ನಲ್ಲಿ ಇನ್ನಷ್ಟು ಫೀಚರ್‌ಗಳನ್ನು ಹೊಂದಿದ್ದೀರಿ</translation>
<translation id="7624307931717240213">ಈ ಸೇವೆಯನ್ನು ಸುಧಾರಿಸಲು ನಾವು ಮಾಹಿತಿಯನ್ನು ಬಳಸುತ್ತೇವೆ. ಗೌಪ್ಯತೆ ನೀತಿ ಮತ್ತು ಸೇವಾ ನಿಯಮಗಳನ್ನು ನೋಡಿ.</translation>
<translation id="7649070708921625228">ಸಹಾಯ</translation>
<translation id="7733015548570443346">FlyWeb ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="7658239707568436148">ರದ್ದುಮಾಡಿ</translation>
<translation id="2230101319599356673">FlyWeb ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅಲ್ಲ</translation>
<translation id="3243257760331619874">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ FlyWeb ಅನ್ನು ಸಿಂಕ್ ಮಾಡಿ ಮತ್ತು ವೈಯಕ್ತೀಕರಿಸಿ</translation>
<translation id="3836891631266228927">FlyWeb ಅಪ್‌ಡೇಟ್</translation>
<translation id="7362833186911891234">FlyWeb ನಲ್ಲಿ ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="7716950018788545737">ಕಾರ್ಯ(ಗಳು) ಮುಗಿದಿದೆ.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> ಗಾಗಿ ಸಿಸ್ಟಮ್‌ ಟ್ರೇಸಿಂಗ್‌ ಸೇವೆಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ. ಈ ಸೇವೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ, ಬ್ರೌಸರ್‌ನಿಂದ ರಚಿಸಲಾದ ಪರ್ಫಾರ್ಮೆನ್ಸ್‌ ಟ್ರೇಸ್‌ಗಳು ಕಂಟೆಕ್ಸ್‌ಟ್‌ ಸ್ವಿಚ್‌ ಮತ್ತು ಸಿದ್ಧ ಥ್ರೆಡ್ ಈವೆಂಟ್‌ಗಳಂತಹ ಸಿಸ್ಟಮ್-ವೈಡ್‌ ಈವೆಂಟ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರುವುದಿಲ್ಲ.</translation>
<translation id="1549877678317463759">ಈ ಸಾಧನದಿಂದ ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL"/> ನಂತೆ FlyWeb ಗೆ ಸೈನ್‌ ಇನ್ ಮಾಡಿ.</translation>
<translation id="7747138024166251722">ಇನ್‌ಸ್ಟಾಲರ್‌‌‌ಗೆ ತಾತ್ಕಾಲಿಕ ಡೈರೆಕ್ಟರಿಯನ್ನು ರಚಿಸಲಾಗಲಿಲ್ಲ. ಸಾಫ್ಟ್‌ವೇರ್ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಮುಕ್ತ ಡಿಸ್ಕ್ ಜಾಗ ಮತ್ತು ಅನುಮತಿಗಾಗಿ ದಯವಿಟ್ಟು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="104221467268393661">ಡೀಫಾಲ್ಟ್ FlyWeb ಗೆ ರೀಸೆಟ್ ಮಾಡಿ</translation>
<translation id="2414061498125565915">FlyWeb ನಲ್ಲಿ ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸುವ ಸಲುವಾಗಿ, ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಕೆಲವು ಮಾಹಿತಿಯನ್ನು ವೀಕ್ಷಿಸಲು ಅಥವಾ ನಿರ್ವಹಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತದೆ.</translation>
<translation id="494195283222791090">FlyWeb ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="134973275687829726">FlyWeb ಅನ್ನು ವೇಗಗೊಳಿಸಿ</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಟ್ರಾಫಿಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಹೊಂದಿರುವ ಜನರಿಗೆ ನೀವು ಯಾವ ಸೈಟ್‌ಗಳಿಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಲು ಕಷ್ಟವಾಗುವಂತೆ ಮಾಡಿ. DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವೊಂದನ್ನು ಹುಡುಕಲು FlyWeb ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಒಂದನ್ನು ಬಳಸುತ್ತದೆ.</translation>
<translation id="7810005234485217901">ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಪಿನ್ ಮಾಡಬಹುದು</translation>
<translation id="6059158364953614237">FlyWeb ಜೊತೆ ಏನನ್ನು ಹಂಚಿಕೊಳ್ಳಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8463540467315366872">ಈ ಸಾಧನದಲ್ಲಿ ಈ ಖಾತೆಯೊಂದಿಗಿನ FlyWeb ಪ್ರೊಫೈಲ್ ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ</translation>
<translation id="7845233973568007926">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME"/> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನೀವು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="3682929584258119691">ನಿಮ್ಮ ಸರ್ಚ್ ಎಂಜಿನ್ ಅನ್ನು FlyWeb ನ ಹೊರಗಿನಿಂದ ಬದಲಾಯಿಸಲಾಗಿದೆ. ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಲು, FlyWeb ಅದನ್ನು ಅದರ ಮೂಲ ಡೀಫಾಲ್ಟ್‌ಗೆ ರೀಸೆಟ್ ಮಾಡಿದೆ. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">FlyWeb ಗೆ ಹೊಸ ಲುಕ್ ನೀಡಲು ಅದನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="8611872055947278722">FlyWeb ಗೆ ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಈ ಮೂಲಕ ನೀವು ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಭದ್ರತೆ ಸರಿಪಡಿಸುವಿಕೆಗಳನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಿರಬಹುದು.</translation>
<translation id="7872446069773932638">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="SECONDS"/> ಸೆಕೆಂಡ್(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ.</translation>
<translation id="3999247564452560622">ನೀವು ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಮರೆತಿದ್ದರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, <ph name="BEGIN_LINK"/>ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ FlyWeb ಡೇಟಾವನ್ನು ಅಳಿಸಿ<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">ನಿಮಗೆ ಅಗತ್ಯವಿರುವಾಗ FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು ತ್ವರಿತವಾಗಿ ತೆರೆಯಿರಿ</translation>
<translation id="6798431672720500005">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="332151924263389003">ಸಾಧ್ಯವಾದಾಗ, FlyWeb ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="3096730275883527801"><ph name="USER_EMAIL_ADDRESS"/> ನಂತೆ FlyWeb ಅನ್ನು ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿರುವಿರಿ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಅದೇ ಖಾತೆಯನ್ನು ಬಳಸಿ.</translation>
<translation id="7097534420680357688"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="9017338699075596174">ಇದು FlyWeb ನ ದ್ವಿತೀಯ ಸ್ಥಾಪನೆಯಾಗಿದೆ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="2888168499066553233">ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್ ಬಳಸುವ ಮೂಲಕ FlyWeb ನ ಅತ್ಯುತ್ತಮ ಅನುಭವವನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8004582292198964060">ಬ್ರೌಸರ್</translation>
<translation id="8010081455002666927">ಸ್ವಯಂ ಪತ್ತೆಮಾಡುವಿಕೆ</translation>
<translation id="5944585442866020176">FlyWeb ಒಮ್ಮೆ ಪ್ರವೇಶವನ್ನು ಪಡೆದ ಬಳಿಕ, ಪ್ರವೇಶಕ್ಕಾಗಿ ನಿಮ್ಮನ್ನು ಕೇಳಲು ವೆಬ್‍ಸೈಟ್‍ಗಳಿಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆ.</translation>
<translation id="4462215250900528778">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ತ್ವರಿತವಾಗಿ ಪಡೆಯಲು FlyWeb ಅನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="80471789339884597">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME"/> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನಿಮ್ಮ ಎಲ್ಲಾ ಬ್ರೌಸರ್ ಅನ್ನು ಮರು ಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="8054112667659782652">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಯಾವಾಗಲೂ ತೋರಿಸಿ</translation>
<translation id="8069447462453318634">"ಟೂಲ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ" ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="3685797926747054412">ಆ್ಯಪ್‌ಗಳಿಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ FlyWeb ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="80790299200510644">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ</translation>
<translation id="8086881907087796310">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಕನಿಷ್ಠ ಹಾರ್ಡ್‌ವೇರ್ ಅಗತ್ಯತೆಗಳನ್ನು ಪೂರೈಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ FlyWeb ಗೆ ಸ್ಥಳ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="5289593085778678155">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ ನೀವು FlyWeb ಅನ್ನು ತೆರೆದಾಗ, ದರ ಟ್ರ್ಯಾಕಿಂಗ್ ಅಲರ್ಟ್‌ಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="7635444121786764725">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ FlyWeb ಆ್ಯಪ್ ಮೂಲಕ ನಿಮಗೆ ಆಸಕ್ತಿಯಿರುವ ಐಟಂಗಳ ಬೆಲೆ ಇಳಿಕೆಯ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8118331347066725040">Lens ಬಳಸಿಕೊಂಡು ಹುಡುಕಲು ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="5770057404954060005">FlyWeb ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿ</translation>
<translation id="5334309298019785904">ನಿಮ್ಮ ಡೊಮೇನ್‌ನಲ್ಲಿ ಸಿಂಕ್ ಮಾಡುವ ಸೌಲಭ್ಯವಿಲ್ಲದ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="813913629614996137">ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="6992240065504496864">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಮೂಲಕ FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು ತೆರೆಯಿರಿ.</translation>
<translation id="6334554715655789744">FlyWeb ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳು</translation>
<translation id="1597323875619800374">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿದೆ, ಹೀಗಾಗಿ FlyWeb ಇದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="8177472873527554730">ಪುಟದಲ್ಲಿ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಹುಡುಕಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="2214224574148863941">ನಿಮ್ಮ ಖಾತೆ <ph name="USER_EMAIL"/> ನಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="820759916613250543">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಈ ಚಿತ್ರವನ್ನು ಹುಡುಕಿ</translation>
<translation id="8221491193165283816">ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತೀರಿ. ನಿಮಗೆ ಸೂಚನೆ ನೀಡಲು ಈ ಸೈಟ್‌ಗೆ ಅನುಮತಿಸುವುದಕ್ಕಾಗಿ, ಇಲ್ಲಿ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="2459467374982542273">ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಲು, <ph name="BEGIN_LINK"/>ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> FlyWeb ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="4749458995158778066">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ದೃಢೀಕರಿಸಲು FlyWeb ಗೆ ಸಾಧ್ಯವಿಲ್ಲ ಮತ್ತು ಇದು ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದು. FlyWeb ನಿಂದ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="6756872644564483342">ಚಿತ್ರದಲ್ಲಿ ಉಪಯುಕ್ತ ವಿವರಣೆಯು ಇಲ್ಲದಿದ್ದರೆ, FlyWeb ನಿಮಗಾಗಿ ಒಂದು ವಿವರಣೆಯನ್ನು ಒದಗಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ವಿವರಣೆಗಳನ್ನು ರಚಿಸಲು, ಚಿತ್ರಗಳನ್ನು FlyWeb ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಆಫ್ ಮಾಡಬಹುದು.</translation>
<translation id="9179486248398668702">ಹೊಸ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ FlyWeb ಗೆ ಸೈನ್‌ ಇನ್‌ ಮಾಡಬೇಕೆ?</translation>
<translation id="1470002120352085290"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, FlyWeb ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು <ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="8901123396574346662">FlyWeb ನಲ್ಲಿ Gemini ಅನ್ನು ಸಿಸ್ಟಮ್ ಟ್ರೇನಲ್ಲಿ ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="9102959605052547519">ಸುರಕ್ಷಿತವಲ್ಲದ ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ಕುರಿತು <ph name="BEGIN_LINK"/>FlyWeb ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ<ph name="END_LINK"/></translation>
<translation id="669999719045196468">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION"/> ಅನ್ನು FlyWeb ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="7136168924180047124">FlyWeb iOS ಆ್ಯಪ್ ಮೂಲಕ, ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಿಕೊಂಡು ನಿಮ್ಮ ಕಣ್ಣಿಗೆ ಬೀಳುವ ವಸ್ತುಗಳನ್ನು ಶಾಪಿಂಗ್ ಮಾಡಿ, ಪಠ್ಯಗಳನ್ನು ಅನುವಾದಿಸಿ ಹಾಗೂ ಸುತ್ತಮುತ್ತಲಿನ ವಿಷಯಗಳನ್ನು ಗುರುತಿಸಿ</translation>
<translation id="867002910715789721"><ph name="USER_NAME"/> ಆಗಿ FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು QR ಕೋಡ್</translation>
<translation id="8313851650939857356">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">FlyWeb ಅನ್ನು <ph name="TIMEOUT_DURATION"/> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ.</translation>
<translation id="8321888067342493336">ಚಿತ್ರದ ರೂಪದಲ್ಲಿ ಸೇವ್ ಮಾಡಿ</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> ಅವರು ಮೊದಲಿನಿಂದಲೆ FlyWeb ಬಳಸುತ್ತಿದ್ದರು</translation>
<translation id="7009033378151348624">FlyWeb ನಲ್ಲಿ ಕೌಶಲ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="338142060986183805">ನಿಮ್ಮ FlyWeb ಖಾತೆ <ph name="ACCOUNT_EMAIL"/> ನಲ್ಲಿ FlyWeb ಡೇಟಾ ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು FlyWeb ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ</translation>
<translation id="7408894216012529448">ಭವಿಷ್ಯದ FlyWeb ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 8 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="8362914115861174987">ಈ ಭಾಷೆಗೆ ಅನುವಾದಿಸಿ</translation>
<translation id="8367705492654390392">ಏನನ್ನಾದರೂ ಕೇಳಿ</translation>
<translation id="5020916672477085422">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಉಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="5417365165109189454">ನಂತರ ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="4212474799248200893">ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">ಈ ವಿಸ್ತರಣೆಯನ್ನು ಅದರ ಡೆವಲಪರ್‌ನಿಂದ ಪ್ರಕಟಣೆಯನ್ನು ರದ್ದುಮಾಡಿದೆ ಮತ್ತು ಸುರಕ್ಷಿತ ಆಗಿಲ್ಲದಿರಬಹುದು. FlyWeb ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="3669395395617655404">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು FlyWeb ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="5261590792975521002">{0,plural, =1{ಒಂದು ದಿನದ ಒಳಗೆ FlyWeb ಮರುಪ್ರಾರಂಭಿಸಿ}one{# ದಿನಗಳ ಒಳಗೆ FlyWeb ಮರುಪ್ರಾರಂಭಿಸಿ}other{# ದಿನಗಳ ಒಳಗೆ FlyWeb ಮರುಪ್ರಾರಂಭಿಸಿ}}</translation>
<translation id="8438543370129609977">ನೀವು ಇಮೇಜ್‌ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.<ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">FlyWeb ನಲ್ಲಿ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟದ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="3101564993057563365">ಸ್ಥಾಪಕ ಆರ್ಕೈವ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಅಮಾನ್ಯವಾಗಿದೆ. ದಯವಿಟ್ಟು FlyWeb ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="5316851838033144902">FlyWeb ಗೆ Windows 10 ಅಥವಾ ಹೆಚ್ಚಿನ ಆವೃತ್ತಿಯ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="6760691951531758781">ಐಚ್ಛಿಕ: ಡಯಗ್ನೊಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾವನ್ನು FlyWeb ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಳುಹಿಸುವ ಮೂಲಕ ChromeOS ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="2523037024749170569">ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸಿ</translation>
<translation id="5989540778099253163">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಪ್ರಾಂಪ್ಟ್ ಅನ್ನು ತೋರಿಸುತ್ತದೆ</translation>
<translation id="6852836260419236265">FlyWeb ನ ಅವಧಿ ಮುಗಿದಿದೆ</translation>
<translation id="360892078644515524">FlyWeb ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಆಯ್ಕೆ ಮಾಡಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು!</translation>
<translation id="797182360653885317">ನೀವು ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಿದಾಗ, FlyWeb ಅವುಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು</translation>
<translation id="8525579356836940628">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ನಿಲ್ಲಿಸಲಾಗಿದೆ</translation>
<translation id="8340284327429540526">ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್ ಬಳಸುವ ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ನಿಮ್ಮ ಜೊತೆಗೆ ಇರಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="7498776423722712116">ಸಾರ್ವಜನಿಕ ಡೇಟಾ ಉಲ್ಲಂಘನೆಯಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳಲ್ಲಿ ಒಂದು FlyWeb ಗೆ ಕಂಡುಬಂದರೆ ಎಚ್ಚರಿಕೆ ಪಡೆಯಿರಿ</translation>
<translation id="8555465886620020932">ಸೇವಾ ದೋಷ: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">ಕೆಲವು FlyWeb ಫೀಚರ್‌ಗಳು ಮತ್ತು ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಶಾರ್ಟ್‌ಕಟ್‌ಗಳೊಂದಿಗೆ ಬರುತ್ತವೆ. ನೀವು ಅವುಗಳನ್ನು ಮರಳಿ ಆನ್ ಮಾಡಲು ಆಯ್ಕೆ ಮಾಡಬಹುದು.</translation>
<translation id="8556420416730706394">ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಪಿನ್ ಮಾಡಬಹುದು; ಸೈಡ್ ಪ್ಯಾನಲ್‌ನ ಮೇಲ್ಭಾಗದಲ್ಲಿರುವ ಪಿನ್ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="856656450041460113">ಭಾಷೆಯ ಪಟ್ಟಿಯನ್ನು ಹುಡುಕಿ</translation>
<translation id="5128162742812353891">ಬಹು ಸಂಸ್ಥೆಗಳು FlyWeb ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತವೆ</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="7129578417724116642">FlyWeb ಅನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="8624541899164515475">ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ.</translation>
<translation id="5469043671012993003">FlyWeb for Testing ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="3892251159131070138">ಎಲ್ಲಿಂದಲಾದರೂ FlyWeb ಮೂಲಕ ಹುಡುಕಿ</translation>
<translation id="1514450422236300417">ನೀವು FlyWeb ಪ್ರಾರಂಭಿಸಿದಾಗ ಅಥವಾ ಓಮ್ನಿಬಾಕ್ಸ್‌ನಿಂದ ಹುಡುಕಿದಾಗ ತೋರಿಸಬೇಕಾದ ಪುಟವನ್ನು ಕೂಡಾ ಇದು ನಿಯಂತ್ರಿಸುತ್ತದೆ.</translation>
<translation id="573490495087487940">ಇದು ನಿಮ್ಮ FlyWeb</translation>
<translation id="8712637175834984815">ಅರ್ಥವಾಯಿತು</translation>
<translation id="2666961286257416158">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="8747073452963259673">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಕೆಳಗಿನ ಎಡ ಮೂಲೆ: ಎಡಕ್ಕೆ <ph name="LEFT"/>%, ಕೆಳಕ್ಕೆ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ನಿರ್ವಾಹಕರು ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ತಡೆಯುವ ಗುಂಪು ನೀತಿಯನ್ನು ಅನ್ವಯಿಸಿದ್ದಾರೆ: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">ನಂತರ ನನಗೆ ಜ್ಞಾಪಿಸಿ</translation>
<translation id="4243214377720481697">ತ್ವರಿತ ಅವಲೋಕನವನ್ನು ಪಡೆಯಲು ಮತ್ತು ಫಾಲೋ ಅಪ್ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು FlyWeb ನಲ್ಲಿ Gemini ಜೊತೆಗೆ ಈ ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="6808406663598665473">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="7022252178852457880">FlyWeb ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಿ ಮತ್ತು ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="8826492472752484139">“Password Manager” ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6933858244219479645">ChromeOS ಸಿಸ್ಟಂ</translation>
<translation id="1501202286854500367">FlyWeb ನಲ್ಲಿ ಮೆನುಗಳು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಎಚ್ಚರಿಕೆಗಳು ಮತ್ತು ಇತರ ಪಠ್ಯವನ್ನು ಪ್ರದರ್ಶಿಸಲು ಈ ಭಾಷೆಯನ್ನು ಬಳಸಲಾಗುತ್ತದೆ</translation>
<translation id="8862326446509486874">ಸಿಸ್ಟಂ ಮಟ್ಟದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನೀವು ಸರಿಯಾದ ಹಕ್ಕುಗಳನ್ನು ಹೊಂದಿಲ್ಲ. ನಿರ್ವಾಹಕರಂತೆ ಮತ್ತೆ ಇನ್‌ಸ್ಟಾಲರ್ ಅನ್ನು ರನ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2405293075272280413">FlyWeb ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="2096285611267043007">ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ ದೋಷವಿರುವ ಕಾರಣ ನಿಮ್ಮ FlyWeb ಖಾತೆಯಲ್ಲಿ FlyWeb ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="9046344742397901138">ನೀವು FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆಗೆ ಅಗತ್ಯವಿದೆ</translation>
<translation id="4669168852412989042">FlyWeb ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪ್ರದರ್ಶಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="2704405030486981087">FlyWeb ಇನ್ನು ಮುಂದೆ ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿರುವುದಿಲ್ಲ. FlyWeb ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="1663379621921336006">FlyWeb ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="8944232836376404813">ಈ ಕ್ರಿಯೆಯು:
          <ph name="LINE_BREAKS"/>
            • ನಿಮ್ಮ ಆರಂಭಿಕ ಪುಟ, ಹೊಸ ಟ್ಯಾಬ್ ಪುಟ, ಸರ್ಚ್ ಎಂಜಿನ್ ಮತ್ತು ಪಿನ್ ಮಾಡಲಾದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
            <ph name="LINE_BREAK"/>
            • ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAK"/>
            • ಕುಕೀಗಳು ಮತ್ತು ಇತರ ತಾತ್ಕಾಲಿಕ ಸೈಟ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAKS"/>
            ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಸೇವ್ ಮಾಡಿದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳ ಮೇಲೆ ಇದು ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.</translation>
<translation id="188856534838382513">FlyWeb ಸೈಟ್ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ತೋರಿಸಿ</translation>
<translation id="543915850302643692">FlyWeb Enterprise ಲೋಗೋ</translation>
<translation id="4417647437359346154">ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್ ಬಳಸುವ ಮೂಲಕ FlyWeb ನ ಸುರಕ್ಷತೆಯನ್ನು ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ನಿಮ್ಮ ಜೊತೆಗೆ ಇರಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="6976267397714240800">ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಅನ್ನು ತೆರೆಯುವಾಗ ಏನೋ ತಪ್ಪಾಗಿರುವ ಕಾರಣ FlyWeb ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8952346994182255880">FlyWeb ಮೂಲಕ ಹುಡುಕಲು ಅಥವಾ <ph name="BEGIN_LINK"/>ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> ಕಸ್ಟಮೈಸ್ ಮಾಡಲು</translation>
<translation id="8422308271795251425">FlyWeb ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="519942585686549229">FlyWeb ನಲ್ಲಿ Gemini ಮತ್ತು ನಿಮ್ಮ ತೆರೆದ ಟ್ಯಾಬ್ ನಡುವೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು ನಿಮ್ಮ ಕೀಬೋರ್ಡ್ ಬಳಸಿ.</translation>
<translation id="9018218886431812662">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಿಕೆಯು ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="5804408305184682593">FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="7410599202980023102">Mac ಮೆನು ಬಾರ್‌ನಲ್ಲಿ FlyWeb ಮೂಲಕ ಹುಡುಕಿ ಅನ್ನು ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="2138383893834402906">FlyWeb ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಏಕೆಂದರೆ ಆರ್ಕೈವ್ ಫೈಲ್ ಮಾಲ್‌ವೇರ್ ಅನ್ನು ಮರೆಮಾಡಬಹುದಾದ ಇತರ ಫೈಲ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿದೆ</translation>
<translation id="8884768769854521848">ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಿಂಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು FlyWeb ಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ ಮತ್ತು ಇಷ್ಟಪಡುವ ಫೀಚರ್‌ಗಳನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ. ತ್ವರಿತವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡುವುದಕ್ಕಾಗಿ FlyWeb ಅನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="3668027737318668659">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ FlyWeb ಆ್ಯಪ್‌ನ ಮೂಲಕ FlyWeb ನ ಅತ್ಯುತ್ತಮ AI ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="1257818515846885633"><ph name="DEVICE"/> ನಿಂದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="7813768067688376455">ನೀವು ಇತರ FlyWeb ಸೇವೆಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ FlyWeb ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="8323442969389928559">FlyWeb ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚಲಾಗಿದೆ</translation>
<translation id="7626272203917389133">FlyWeb ನ ಅವಧಿ ಮುಗಿದಿದೆ</translation>
<translation id="1789655708880997767">{0,plural, =1{ಒಂದು ಗಂಟೆಯಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ಗಂಟೆಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ಗಂಟೆಗಳಲ್ಲಿ FlyWeb ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="9106236359747881194">ಹುಡುಕಲು ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8970147445441095618">ಭವಿಷ್ಯದ FlyWeb ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 8.1 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="1208237657860748752">ಹೊಸ FlyWeb &amp;ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="911206726377975832">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಸಹ ಅಳಿಸುವುದೇ?</translation>
<translation id="9134482777260927479">ಹೋಮ್‌ವರ್ಕ್ ಸಹಾಯ</translation>
<translation id="9148058034647219655">ನಿರ್ಗಮಿಸಿ</translation>
<translation id="1592415213971909403">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಸಿ: ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗಲೆಲ್ಲಾ FlyWeb ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಬಹುದು. ಇದನ್ನು ಆನ್ ಮಾಡಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ</translation>
<translation id="3926534790663909774"><ph name="TARGET_URL_HOSTNAME"/> ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ಒಂದು ಪರ್ಯಾಯ ಬ್ರೌಸರ್ ತೆರೆಯುವಂತೆ ನಿಮ್ಮ ಸಿಸ್ಟಂ ನಿರ್ವಾಹಕರು FlyWeb ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ್ದಾರೆ.</translation>
<translation id="5022081608392609959">&amp;FlyWeb ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">ನಿಮ್ಮ ಸ್ವಂತ FlyWeb ಅನ್ನು ರಚಿಸಿ</translation>
<translation id="3410331617397516204">Windows XP ಅಥವಾ Windows Vista ದಲ್ಲಿ FlyWeb ಗೆ ಈಗ ಬೆಂಬಲವಿಲ್ಲದೇ ಇರುವುದರಿಂದ ಅದು ಸರಿಯಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು</translation>
<translation id="3613308994653366133">FlyWeb ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ FlyWeb ನ ಅತ್ಯುತ್ತಮ ಸುರಕ್ಷತಾ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ.</translation>
<translation id="945522503751344254">ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="1127626874097952395">FlyWeb ಅನ್ನು ಯಾರು ಬಳಸುತ್ತಿದ್ದಾರೆ?</translation>
<translation id="1626113414414104077">FlyWeb ನ ಪ್ರಬಲ ಭದ್ರತೆಯನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="983803489796659991">ಅಪ್‌ಡೇಟ್ ಸರ್ವರ್, ಅಪ್ಲಿಕೇಶನ್‌ಗಾಗಿ ಯಾವುದೇ ಹ್ಯಾಶ್ ಡೇಟಾವನ್ನು ಹೊಂದಿಲ್ಲದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="839475718250652248">FlyWeb ಅನ್ನು ಖಾತೆಯಿಲ್ಲದೆಯೇ ಬಳಸಿ</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಹುಡುಕಲು ಯಾವುದೇ ಪಠ್ಯ ಅಥವಾ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="7783156808075587495">ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಬಳಸಲು, <ph name="BEGIN_LINK"/>ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> FlyWeb ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="137466361146087520">Google Chrome ಬೀಟಾ</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">ಅನಿರ್ದಿಷ್ಟ ದೋಷದಿಂದಾಗಿ ಸ್ಥಾಪನೆ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೊಮ್ಮೆ FlyWeb ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="2725795635123877647">ಅಜ್ಞಾತ ಮೂಲಗಳಿಂದ ವಿಸ್ತರಣೆಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಥೀಮ್‌ಗಳು ನಿಮ್ಮ ಸಾಧನವನ್ನು ಹಾನಿಗೊಳಿಸಬಹುದು. <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>ನಿಂದ ಮಾತ್ರ ಅವುಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು FlyWeb ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ</translation>
<translation id="5840822070878669614">FlyWeb ವೆಬ್‌ ಸ್ಟೋರ್ ತೆರೆಯಿರಿ</translation>
<translation id="3470813199863172076">ಈ ವಿಸ್ತರಣೆಯು ವೆಬ್ ಸ್ಟೋರ್ ನೀತಿಯನ್ನು ಉಲ್ಲಂಘಿಸುತ್ತಿರುವುದರಿಂದ ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದು. Braveನಿಂದ ಅದನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಸೇರಿದಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್ ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ನೋಡಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ.</translation>
<translation id="5382847955032513683">ಎಚ್ಚರಿಕೆ: ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್‌ ಇತಿಹಾಸದಲ್ಲಿ ರೆಕಾರ್ಡಿಂಗ್‌ನಿಂದ ವಿಸ್ತರಣೆಗಳನ್ನು ತಡೆಯುವುದಿಲ್ಲ. ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿ ವಿಸ್ತರಣೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು ಈ ಆಯ್ಕೆಯನ್ನು ಆರಿಸಬೇಡಿ.</translation>
<translation id="543905389684998697">FlyWeb  ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ನಲ್ಲಿ ನಾವು ಪಟ್ಟಿ ಮಾಡಲಾದ ಕೆಲವು ವಿಸ್ತರಣೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಿರಬಹುದು.</translation>
<translation id="3914570680366033593">FlyWeb ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ನಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡದಿರುವ ಕೆಳಗಿನ ವಿಸ್ತರಣೆಯನ್ನು ನಾವು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ನಿಮ್ಮ ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಲಾಗಿರಬಹುದು.</translation>
<translation id="2742103213766991703">FlyWeb ಅ&amp;ದೃಶ್ಯ ವಿಂಡೋದಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="1616978953472841483">FlyWeb ಅ&amp;ದೃಶ್ಯ ವಿಂಡೋದಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{FlyWeb ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ.}=1{FlyWeb ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{FlyWeb ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{FlyWeb ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="8494512118209691256">ಇದು ನಿಮ್ಮ ಸ್ಥಳೀಯ ಸಾಧನಗಳಿಗೆ, ಉದಾಹರಣೆಗೆ ಟಿವಿ ಅಥವಾ ಸ್ಪೀಕರ್‌ನಂತಹ FlyWeb ನಿಂದ ವಿಷಯವನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ನಿಮಗೆ ಅನುಮತಿ ನೀಡುತ್ತದೆ.</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ}=1{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ}=1{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="6998204082704836463">{COUNT, plural, =0 {ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು FlyWeb ಅನ್ನು ಪುನರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ Advanced Protection ಗೆ} =1 {ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು FlyWeb ಅನ್ನು ಪುನರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ Advanced Protection ಗೆ. ನಿಮ್ಮ ಖಾಸಗಿ ವಿಂಡೋ ಪುನರಾರಂಭವಾಗಲ್ಲ.} other {ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು FlyWeb ಅನ್ನು ಪುನರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ Advanced Protection ಗೆ. ನಿಮ್ಮ # ಖಾಸಗಿ ವಿಂಡೋಗಳು ಪುನರಾರಂಭವಾಗಲ್ಲ.}}</translation>
<translation id="5749154344207139683">ಈ 1 ನಿಮಿಷದ ಸಮೀಕ್ಷೆಯಲ್ಲಿ ಭಾಗವಹಿಸುವ ಮೂಲಕ ಖಾಸಗಿಯನ್ನು ಸುಧಾರಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="4766381896251401675">ನೀವು ವಿಳಾಸ ಬಾರ್ ಅಥವಾ ಹುಡುಕಾಟ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಉತ್ತಮ ಸಲಹೆಗಳನ್ನು ಪಡೆಯುವುದಕ್ಕಾಗಿ ನೀವು ಟೈಪ್ ಮಾಡುವುದನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಹುಡುಕಾಟ ಇಂಜಿನ್‌ಗೆ FlyWeb ಕಳುಹಿಸುತ್ತದೆ. ಇದು ಖಾಸಗಿ ಎಂಬಲ್ಲಿ ಆಫ್ ಆಗಿದೆ.</translation>
<translation id="2832552148674305108">FlyWeb ಖಾಸಗಿ</translation>
<translation id="611606920944085547">ಖಾಸಗಿ ಮೋಡ್‌ನಲ್ಲಿ ಬ್ರೌಸಿಂಗ್ ಮಾಡುವಾಗ, ಅಸುರಕ್ಷಿತ ಸಂಪರ್ಕವನ್ನು ಬಳಸಿಕೊಂಡು ಸೈಟ್ ಅನ್ನು ಲೋಡ್ ಮಾಡುವುದಕ್ಕೂ ಮೊದಲು FlyWeb ನಿಮ್ಮನ್ನು ಎಚ್ಚರಿಸುತ್ತದೆ</translation>
</translationbundle>