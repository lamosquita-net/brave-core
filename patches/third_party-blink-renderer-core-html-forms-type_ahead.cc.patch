+        // Fold the option string and check if its prefix is equal to the folded
+        // prefix.
+        String text = data_source_->OptionAtIndex(index);
+        if (StripLeadingWhiteSpace(text).FoldCase().StartsWith(
+                prefix_with_case_folded)) {
+          return index;
+        }
+      }
     }
