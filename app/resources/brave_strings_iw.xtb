<translation id="8624541899164515475">הגדרות, ייפתחו בכרטיסייה חדשה.</translation>
<translation id="5469043671012993003">‏לא ניתן להגדיר את FlyWeb for Testing כדפדפן ברירת המחדל.</translation>
<translation id="3892251159131070138">‏חיפוש באמצעות FlyWeb מכל מקום</translation>
<translation id="1514450422236300417">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את FlyWeb או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="573490495087487940">‏זהו ה-FlyWeb שלך</translation>
<translation id="8712637175834984815">הבנתי</translation>
<translation id="2666961286257416158">‏להיכנס אל FlyWeb?</translation>
<translation id="8747073452963259673">‏הפינה השמאלית התחתונה של אזור החיפוש: ‎<ph name="LEFT"/>%‎ משמאל, ‎<ph name="BOTTOM"/>%‎ מלמטה</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">אני רוצה לקבל תזכורת אחר כך</translation>
<translation id="4243214377720481697">‏כדי לקבל סקירה כללית זריזה ולשאול שאלות המשך, אפשר לשתף את המסמך הזה עם Gemini ב-FlyWeb</translation>
<translation id="6808406663598665473">‏להיכנס אל FlyWeb?</translation>
<translation id="7022252178852457880">‏הגדרת FlyWeb כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="6933858244219479645">‏מערכת ChromeOS</translation>
<translation id="1501202286854500367">‏זו השפה שבה מוצגים תפריטים, הגדרות, התראות וטקסטים אחרים ב-FlyWeb</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="2405293075272280413">‏הוספת פרופיל FlyWeb</translation>
<translation id="2096285611267043007">‏הנתונים מ-FlyWeb לא נשמרו בחשבון FlyWeb שלך ב-ChromeOS בגלל שגיאה בתהליך הכניסה</translation>
<translation id="9046344742397901138">‏לפי דרישת הארגון שלך, עליך להיכנס לחשבון ב-FlyWeb</translation>
<translation id="4669168852412989042">‏FlyWeb מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="2704405030486981087">‏‫FlyWeb כבר לא מוגדר כדפדפן ברירת המחדל שלך. אני רוצה ש-FlyWeb יהיה דפדפן ברירת המחדל</translation>
<translation id="1663379621921336006">‏לא ניתן לעדכן את FlyWeb</translation>
<translation id="8944232836376404813">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS"/>
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK"/>
            • התוספים יושבתו
            <ph name="LINE_BREAK"/>
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAKS"/>
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="188856534838382513">‏הצגת קיצורי דרך לאתרים ב-FlyWeb</translation>
<translation id="543915850302643692">‏הלוגו של FlyWeb Enterprise</translation>
<translation id="4417647437359346154">‏עם אפליקציית FlyWeb במכשיר <ph name="DEVICE_TYPE"/>, תכונות הבטיחות של FlyWeb הולכות איתך לכל מקום</translation>
<translation id="6976267397714240800">‏אי אפשר להפעיל את FlyWeb בגלל שמשהו השתבש בפתיחת הפרופיל. כדאי לנסות להפעיל מחדש את FlyWeb.</translation>
<translation id="8952346994182255880">‏כדי לחפש באמצעות FlyWeb או להתאים אישית ב<ph name="BEGIN_LINK"/>הגדרות<ph name="END_LINK"/></translation>
<translation id="8422308271795251425">‏ניהול הפרופילים ב-FlyWeb</translation>
<translation id="519942585686549229">‏כדי לעבור בין Gemini ב-FlyWeb לבין הכרטיסייה הפתוחה, אפשר להשתמש במקלדת.</translation>
<translation id="9018218886431812662">ההתקנה הושלמה</translation>
<translation id="5804408305184682593">‏כניסה אל FlyWeb</translation>
<translation id="7410599202980023102">‏הצגת החיפוש באמצעות FlyWeb בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="2138383893834402906">‏‫FlyWeb חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="8884768769854521848">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-FlyWeb. לגישה מהירה, FlyWeb יוצמד לסרגל האפליקציות.</translation>
<translation id="3668027737318668659">‏רוצה להשתמש בכלי ה-AI הטובים ביותר של FlyWeb? כשאפליקציית FlyWeb מותקנת בטלפון שלך זה אפשרי</translation>
<translation id="1257818515846885633">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים מתוך <ph name="DEVICE"/>, צריך להיכנס ל-FlyWeb</translation>
<translation id="7813768067688376455">‏כניסה אל FlyWeb כשנכנסים לשירותי FlyWeb אחרים</translation>
<translation id="8323442969389928559">‏FlyWeb נסגר באופן אוטומטי</translation>
