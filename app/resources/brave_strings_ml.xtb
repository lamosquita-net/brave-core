<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="1026101648481255140">ഇൻസ്റ്റാൾ ചെയ്യൽ പുനരാരംഭിക്കുക</translation>
<translation id="7099479769133613710">&amp;ChromeOS അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="291426170030461697">ഈ വിപുലീകരണം അവലോകനം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു</translation>
<translation id="1549005488226693697">ഒരു സൈറ്റ് അതിലെ പേജിലെ ലിങ്കുകൾ സ്വകാര്യമായി മുൻകൂട്ടി ലോഡ് ചെയ്യാൻ ആവശ്യപ്പെടുമ്പോൾ FlyWeb, FlyWeb സെർവറുകൾ ഉപയോഗിക്കുന്നു. മുൻകൂട്ടി ലോഡ് ചെയ്ത സൈറ്റിൽ നിന്ന് ഇത് നിങ്ങളുടെ ഐഡന്റിറ്റി മറയ്ക്കുന്നു, എന്നാൽ ഏതൊക്കെ സൈറ്റുകളാണ് മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നതെന്ന് FlyWeb മനസ്സിലാക്കുന്നു.</translation>
<translation id="1065672644894730302">നിങ്ങളുടെ മുൻഗണനകൾ വായിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമല്ലായിരിക്കാം ഒപ്പം മുൻഗണനകളിലേക്കുള്ള മാറ്റങ്ങൾ സംരക്ഷിക്കപ്പെടുന്നതുമല്ല.</translation>
<translation id="8908267645832965492">നിങ്ങളുടെ രക്ഷിതാവ് FlyWeb-നുള്ള "സൈറ്റുകൾക്കും ആപ്പുകൾക്കും വിപുലീകരണങ്ങൾക്കുമുള്ള അനുമതികൾ" ഓഫാക്കി</translation>
<translation id="5557633153169217776">സമീപമുള്ള ഉപകരണങ്ങൾ കണ്ടെത്താനും ഉപയോഗിക്കാനും FlyWeb-ന് നിങ്ങളുടെ പ്രാദേശിക നെറ്റ്‌വർക്കിലേക്ക് ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="6441390163669415879">ഒരു നിർദ്ദിഷ്ട FlyWeb ഫീച്ചറോ വിപുലീകരണമോ തിരയാൻ, വിലാസ ബാറിൽ അതിന്റെ കുറുക്കുവഴി ടൈപ്പ് ചെയ്ത ശേഷം നിങ്ങൾ തിരഞ്ഞെടുത്ത കീബോർഡ് കീ അമർത്തുക</translation>
<translation id="9001750423919983557">സിസ്റ്റം ട്രേയിൽ FlyWeb ഉപയോഗിച്ചുള്ള തിരയൽ കാണിക്കുക, കീബോർഡ് കുറുക്കുവഴി ഓണാക്കുക</translation>
<translation id="1368460307421081773">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എക്‌സ്‌പോർട്ട് ചെയ്യാൻ FlyWeb ആഗ്രഹിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="112640046208448578">വസ്തുക്കളോ സ്ഥലങ്ങളോ കണ്ടെത്തൂ, ടെക്‌സ്റ്റ് വിവർത്തനം ചെയ്യുകയോ പകർത്തുകയോ ചെയ്യൂ. നിങ്ങൾ ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിക്കുമ്പോൾ, പേജിന്റെ ഒരു സ്ക്രീൻഷോട്ട് സെർവറിലേക്ക് അയയ്ക്കും. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാണ്</translation>
<translation id="4556715463645168547">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK"/>FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb മെനുവിൽ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="1157985233335035034">അടുത്തിടെ ഉപയോഗിച്ച ഭാഷകൾ</translation>
<translation id="1184145431117212167">നിങ്ങളുടെ Windows പതിപ്പിന് പിന്തുണയില്ലാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="4380351562011537903">FlyWeb-ത്തിനെക്കുറിച്ച്</translation>
<translation id="853148447909557566">നിങ്ങളുടെ ഫോണിൽ FlyWeb ഉപയോഗിച്ച് നിരക്ക് ട്രാക്ക് ചെയ്യൽ അലേർട്ടുകൾ നേടുക</translation>
<translation id="1203500561924088507">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ ബ്രൗസർ റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="1232234696885483911">നിങ്ങൾ ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ തുറക്കുമ്പോൾ, പേജിന്റെ പേരും URL-ലും PDF-കൾ ഉൾപ്പെടെയുള്ള ഉള്ളടക്കവും സെർവറിലേക്ക് സ്വയമേവ അയയ്ക്കും. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിരിക്കുമ്പോൾ, FlyWeb-ൽ നിങ്ങളുടെ FlyWeb sync chain-ൽ നിന്നുള്ള പാസ്‌വേഡുകളും മറ്റും ഉപയോഗിക്കാനാകും. ഇത് മാറ്റാൻ, “FlyWeb-ലെ നിങ്ങളുടെ അക്കൗണ്ട്” എന്നതിലേക്ക് പോകുക.</translation>
<translation id="7614508617663739435">Mac മെനു ബാറിൽ FlyWeb-ലെ Gemini കാണിക്കുക</translation>
<translation id="832555967476614730">FlyWeb-ലെ Gemini-യിൽ സ്ക്രീനിന്റെ ഭാഗം തിരഞ്ഞെടുക്കാൻ, കീബോർഡ് കുറുക്കുവഴി ഉപയോഗിക്കുക.</translation>
<translation id="4750836834956739196">ഈ ടാബ് നിഷ്ക്രിയമായിരുന്നപ്പോൾ, FlyWeb വേഗത്തിൽ നിലനിർത്താൻ മെമ്മറിയിൽ ഇടമുണ്ടാക്കി. ഈ സൈറ്റ് എല്ലായ്‌പ്പോഴും നിഷ്‌ക്രിയമായിരിക്കുന്നതിൽ നിന്ന് ഒഴിവാക്കാൻ നിങ്ങൾക്ക് തിരഞ്ഞെടുക്കാം.</translation>
<translation id="3190759351483708314">ഫയൽ അപകടകരമായതിനാൽ FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/> ഉപയോഗിച്ച് Gmail അല്ലെങ്കിൽ Youtube പോലുള്ള FlyWeb സേവനങ്ങളിലേക്ക് സൈൻ ഇൻ ചെയ്യുമ്പോൾ, അതേ അക്കൗണ്ട് ഉപയോഗിച്ച് നിങ്ങൾക്ക് FlyWeb-ലേക്കും സ്വയമേവ സൈൻ ഇൻ ചെയ്യാം</translation>
<translation id="7142135954326264349">നിങ്ങളുടെ ഫോണിൽ FlyWeb നേടുക</translation>
<translation id="1290883685122687410">സജ്ജീകരണത്തിലെ പിശക്: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">നിങ്ങളുടെ പുതിയ FlyWeb പ്രൊഫൈൽ സജ്ജീകരിക്കുക</translation>
<translation id="5252737639504553444">FlyWeb-ലെ Gemini ഉപയോഗിച്ച് പരീക്ഷിക്കൂ</translation>
<translation id="609743863669742325">Bluetooth ഉപകരണങ്ങൾ 
 അടുത്തറിയാൻ FlyWeb-ന് Bluetooth ആക്‌സസ് ആവശ്യമാണ്. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">നിങ്ങളുടെ ഫോണിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="1330562121671411446">ഭാഷ കണ്ടെത്തുക</translation>
<translation id="2276527911011636666">FlyWeb-ൽ നിന്നുള്ള ഡാറ്റയും ഇല്ലാതാക്കുക (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">പിൻ ചെയ്‌തു! ടൂൾബാറിലെ പുതിയ ബട്ടൺ വഴി നിങ്ങൾക്ക് ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ വീണ്ടും ആക്സസ് ചെയ്യാനാകും</translation>
<translation id="1383876407941801731">തിരയുക</translation>
<translation id="1045149878186896649">എവിടെയായിരുന്നാലും ബ്രൗസിംഗ് തുടരാൻ FlyWeb ആപ്പ് ഉപയോഗിക്കുക</translation>
<translation id="141901961143729572">നിങ്ങളുടെ ചിന്തകൾ പങ്കിടുക</translation>
<translation id="2758515779140515865">നിങ്ങളുടെ വിൻഡോ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക.</translation>
<translation id="4713192356155907986">FlyWeb for Testing-മായി ബന്ധപ്പെട്ട സഹായം നേടൂ</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ സംരക്ഷിച്ച വിവരങ്ങളും മറ്റും ലഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="1497802159252041924">ഇൻസ്‌റ്റാൾ ചെയ്യലിൽ പിശക്: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ഈ പേജ് പരിരക്ഷിതമാണ്</translation>
<translation id="8962360511570172">ഒരു FlyWeb ടാബ് പങ്കിടുക</translation>
<translation id="2941487459666781243">FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="1547469039832541117">ഹൈലൈറ്റ് ചെയ്ത ടാസ്‌ക് അവസാനിപ്പിക്കുന്നു.</translation>
<translation id="3182893868355533457">FlyWeb പിൻ ചെയ്യുക</translation>
<translation id="852852907317361085">FlyWeb-ന്റെ സുരക്ഷാ ടൂളുകൾ</translation>
<translation id="481155564361715417">നിങ്ങളുടെ Password Manager ഡാറ്റ ഇല്ലാതാക്കാൻ FlyWeb താൽപ്പര്യപ്പെടുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് ടൈപ്പ് ചെയ്യുക.</translation>
<translation id="2846999307505917298">നിങ്ങളുടെ ഫോണിലെ FlyWeb ആപ്പ് ഉപയോഗിച്ച് FlyWeb പരമാവധി പ്രയോജനപ്പെടുത്തൂ</translation>
<translation id="3961251277542681013">FlyWeb-ലെ പ്രധാന സ്വകാര്യതാ, സുരക്ഷാ നിയന്ത്രണങ്ങൾ അവലോകനം ചെയ്യുക</translation>
<translation id="1640672724030957280">ഡൗൺലോഡുചെയ്യുന്നു...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME"/>, <ph name="USER_EMAIL"/> ആയി സൈൻ ഇൻ ചെയ്തു, അംഗത്വം. അക്കൗണ്ട് മെനു തുറക്കുക</translation>
<translation id="7625232007557474355">സന്ദേശങ്ങൾ, ഡോക്യുമെന്റുകൾ, മറ്റ് ആപ്പുകൾ എന്നിവയിലെ ലിങ്കുകളിൽ ക്ലിക്ക് ചെയ്യുമ്പോഴെല്ലാം നിങ്ങൾക്ക് FlyWeb ഉപയോഗിക്കാം. ഇത് നിങ്ങളുടെ ടാസ്‌ക്ബാറിലും പിൻ ചെയ്യും.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> എന്നതിനുള്ള കൂടിയ അവകാശങ്ങൾ നൽകുന്നു.</translation>
<translation id="5695205873161614119">FlyWeb ഉടൻ തന്നെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും</translation>
<translation id="8939535770474283898">നാവിഗേഷനുകൾ HTTPS-ലേക്ക് അപ്‌ഗ്രേഡ് ചെയ്യാൻ FlyWeb ശ്രമിക്കും</translation>
<translation id="2581127533455294937">FlyWeb ഡാറ്റ മായ്‌‌ച്ചു</translation>
<translation id="7385422968404728039"><ph name="REMAINING_TIME"/>-നുള്ളിൽ FlyWeb റീസ്റ്റാർട്ട് ചെയ്യും</translation>
<translation id="6903827847227122616">HTTPS ലഭ്യമല്ലാത്തപ്പോൾ, നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകാതെ FlyWeb ഒരു സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിക്കും</translation>
<translation id="307170399141486420">FlyWeb-ത്തെ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കാൻ അനുവദിക്കുക</translation>
<translation id="5006568136491721884">അതിവേഗ ആക്‌സസിനായി നിങ്ങളുടെ ടാസ്‌ക്‌ബാറിലേക്ക് FlyWeb പിൻ ചെയ്യാൻ Windows അറിയിപ്പിലെ <ph name="BEGIN_BOLD"/>അതെ<ph name="END_BOLD"/> ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="2473319786107120819">FlyWeb വീണ്ടും ഇൻസ്‌റ്റാളുചെയ്യുക</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> എന്നതിനുവേണ്ടി ശ്രമിക്കുന്നു</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്. നിങ്ങളുടെ ബ്രൗസിംഗ് പ്രത്യേകമായി നിലനിർത്താൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. <ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ വിപുലീകരണങ്ങളും മറ്റും ലഭിക്കുകയും ചെയ്യും.</translation>
<translation id="3547283483106013256">അടുത്ത തവണ <ph name="DEVICE_TYPE"/> എന്നതിൽ FlyWeb തുറക്കുമ്പോൾ, FlyWeb Password Manager ഉപയോഗിക്കാനുള്ള ഒരു പ്രോംപ്റ്റ് നിങ്ങൾ കാണും.</translation>
<translation id="1838374766361614909">തിരയൽ മായ്ക്കുക</translation>
<translation id="3403116471618205223">നിങ്ങളുടെ FlyWeb sync chain-ൽ ബ്രൗസിംഗ് ഡാറ്റ നിലനിർത്തിക്കൊണ്ട് ഈ ഉപകരണത്തിൽ നിന്ന് മാത്രം അത് ഇല്ലാതാക്കാൻ, <ph name="BEGIN_LINK"/>FlyWeb-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">എവിടെയായിരുന്നാലും ടാബ് ഗ്രൂപ്പുകൾ തുറക്കാനോ പുതിയ ടാബ് ഗ്രൂപ്പുകൾ സൃഷ്ടിക്കാനോ നിങ്ങളുടെ ഫോണിൽ FlyWeb ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="3285741355512747610">സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്ന FlyWeb അക്കൗണ്ടുകൾ നിങ്ങൾക്ക് മാനേജ് ചെയ്യാം. FlyWeb ബ്രൗസർ, Play Store, Gmail എന്നിവയ്ക്കും മറ്റുമായി നിങ്ങളുടെ FlyWeb അക്കൗണ്ടുകൾ ഉപയോഗിക്കുന്നു. കുടുംബാംഗത്തെ പോലുള്ള മറ്റാർക്കെങ്കിലും വേണ്ടി ഒരു അക്കൗണ്ട് ചേർക്കണമെങ്കിൽ, പകരം നിങ്ങളുടെ <ph name="DEVICE_TYPE"/> എന്നതിലേക്ക് പുതിയൊരു വ്യക്തിയെ ചേർക്കുക. <ph name="LINK_BEGIN"/>കൂടുതലറിയുക<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് തിരയുക</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്. നിങ്ങളുടെ ബ്രൗസിംഗ് പ്രത്യേകമായി നിലനിർത്താൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. <ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ ബുക്ക്‌മാർക്കുകളും മറ്റും ലഭിക്കുകയും ചെയ്യും.</translation>
<translation id="1880677175115548835">ടെക്‌സ്‌റ്റ് തിരഞ്ഞെടുക്കുക</translation>
<translation id="4824940465467423308">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിന് നിങ്ങളുടെ FlyWeb പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള FlyWeb ഡാറ്റ <ph name="USER_NAME"/> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. FlyWeb അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാനാകുമെങ്കിലും, ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. നിങ്ങളുടെ നിലവിലെ FlyWeb ഡാറ്റ പ്രത്യേകമായി സൂക്ഷിക്കുന്നതിന് നിങ്ങൾക്ക് ഒരു പുതിയ പ്രൊഫൈൽ ഓപ്‌ഷണലായി സൃഷ്‌ടിക്കാനാകും. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">പശ്ചാത്തല ആക്റ്റിവിറ്റിയും സ്‌മൂത്ത് സ്ക്രോളിംഗ്, വീഡിയോ ഫ്രെയിം റേറ്റുകൾ എന്നിവ പോലുള്ള വിഷ്വൽ ഇഫക്റ്റുകളും പരിമിതപ്പെടുത്തി FlyWeb ബാറ്ററി പവർ ലാഭിക്കുന്നു. <ph name="BEGIN_LINK"/>എനർജി സേവറിനെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb അപ്ഡേറ്റർ സേവനം</translation>
<translation id="7390382558747224642">ഇത് ഓഫാക്കുന്നതിലൂടെ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാതെ തന്നെ Gmail പോലുള്ള FlyWeb സൈറ്റുകളിൽ നിങ്ങൾക്ക് സൈൻ ഇൻ ചെയ്യാനാവും</translation>
<translation id="5714085538350759767">FlyWeb പ്രതികരിക്കുന്നില്ല. ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കണോ?</translation>
<translation id="5866699689358760578">നിങ്ങളുടെ സ്ഥാപനം, <ph name="MANAGER"/>, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="4035053306113201399">അപ്ഡേറ്റ് ബാധകമാക്കാൻ ChromeOS റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="3750729306035486751">ഈ ഫയൽ തരം സാധാരണയായി ഡൗൺലോഡ് ചെയ്യാത്തതിനാലും ഇത് അപകടകരമായേക്കാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="1953553007165777902">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="MINUTE"/> മിനിറ്റ് ശേഷിക്കുന്നു</translation>
<translation id="6956650624767954726">FlyWeb-ത്തിന് ഡിഫോൾട്ട് ബ്രൗസർ നിർണ്ണയിക്കാനോ സജ്ജമാക്കാനോ കഴിയില്ല</translation>
<translation id="197326043290947695">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് സ്‌മാർട്ടായി ബ്രൗസ് ചെയ്യുക</translation>
<translation id="130679046523922050">ചില ഫയലുകൾ പുതിയ ടാബിൽ തുറക്കുന്നത് FlyWeb ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="8243822903505210769">നിങ്ങളുടെ FlyWeb സോഫ്റ്റ്‌വെയർ അപ് ടു ഡേറ്റായി നിലനിർത്തുന്നു. ഈ സേവനം പ്രവർത്തനരഹിതമാക്കുകയോ നിർത്തുകയോ ചെയ്‌താൽ, നിങ്ങളുടെ FlyWeb സോഫ്റ്റ്‌വെയർ അപ് ടു ഡേറ്റായി നിലനിർത്തില്ല, അതായത്, സുരക്ഷാ പ്രശ്നങ്ങൾ സംഭവിക്കുകയാണെങ്കിൽ അവ പരിഹരിക്കാനാകില്ല, ഫീച്ചറുകൾ പ്രവർത്തിക്കാനും സാധ്യതയില്ല. FlyWeb സോഫ്റ്റ്‌വെയർ ഉപയോഗിക്കാത്തപ്പോൾ, ഈ സേവനം സ്വയം അൺഇൻസ്റ്റാൾ ചെയ്യുന്നു.</translation>
<translation id="6495079989036864983">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും ഒരിനം ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2018879682492276940">ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="2039417478970545937">ക്രമീകരണം.</translation>
<translation id="8544477465831682343">FlyWeb സേവനങ്ങളിൽ കൂടുതൽ വ്യക്തിപരമാക്കിയ അനുഭവം ലഭ്യമാകാൻ FlyWeb ചരിത്രം ഉൾപ്പെടുത്തണോ എന്ന് തിരഞ്ഞെടുക്കുക</translation>
<translation id="328650761750741315">ശക്തമായ പാസ്‌വേഡുകൾ സൃഷ്ടിക്കാനും സംരക്ഷിക്കാനും സ്വയമേവ പൂരിപ്പിക്കാനും നിങ്ങളെ സഹായിക്കുന്നതിന് FlyWeb-ൽ ഉൾപ്പെടുത്തിയിരിക്കുന്നു. എളുപ്പത്തിൽ ആക്‌സസ് ചെയ്യാൻ കുറുക്കുവഴി ചേർക്കുക.</translation>
<translation id="2407746489237278840">FlyWeb-ന് പുതിയ രൂപം നൽകാൻ പുതിയ ടാബ് പേജിലെ 'FlyWeb ഇഷ്ടാനുസൃതമാക്കുക' ബട്ടൺ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="8924891216494775926">ഫയൽ വഞ്ചനാപരമായതിനാലും നിങ്ങളുടെ ഉപകരണത്തിൽ അപ്രതീക്ഷിത മാറ്റങ്ങൾ വരുത്തിയേക്കാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="5728214838078602184">അടുത്ത തവണ FlyWeb iOS തുറക്കുമ്പോൾ <ph name="FEATURE_NAME"/> പരീക്ഷിച്ച് നോക്കാനുള്ള ഒരു പ്രോംപ്റ്റ് നിങ്ങൾ കാണും.</translation>
<translation id="2058207584484841616">നിങ്ങളുടെ FlyWeb sync chain-ൽ സംരക്ഷിച്ചിട്ടുള്ള പാസ്‌വേഡുകളും മറ്റ് FlyWeb ഡാറ്റയും ഈ ഉപകരണത്തിൽ നിന്ന് നീക്കം ചെയ്യും. FlyWeb-ൽ അവ വീണ്ടും ഉപയോഗിക്കാൻ, വീണ്ടും സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{ഒരു മിനിറ്റ് FlyWeb ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും. നിങ്ങളുടെ ടാബുകൾ ഓണാക്കിയ നിലയിൽ തുടരും.}other{# മിനിറ്റ് FlyWeb ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും. നിങ്ങളുടെ ടാബുകൾ ഓണാക്കിയ നിലയിൽ തുടരും.}}</translation>
<translation id="2125838419757773031">തിരയാൻ സ്ക്രീനിലെ ഒരു നിർദ്ദിഷ്ട ഇടം തിരഞ്ഞെടുക്കുക</translation>
<translation id="2126108037660393668">ഡൗൺലോഡ് ചെയ്ത ഫയൽ പരിശോധിച്ചുറപ്പിക്കാനായില്ല.</translation>
<translation id="2135919691573380097">ഈ സൈറ്റ് റിപ്പോർട്ട് ചെയ്യുക</translation>
<translation id="2137162749895930932">വിവർത്തന സ്ക്രീൻ അടയ്ക്കുക</translation>
<translation id="2147218225094845757">സൈഡ് പാനൽ മറയ്‌ക്കുക</translation>
<translation id="4474394796469499134">സൈറ്റ് സുരക്ഷിത കണക്ഷൻ ഉപയോഗിക്കാത്തതിനാലും ഫയലിൽ തകരാർ സംഭവിച്ചിട്ടുണ്ടാകാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="2170098639895543546">പേജിലുള്ള എന്തെങ്കിലും തിരഞ്ഞെടുക്കുക</translation>
<translation id="6765231735885996239">FlyWeb ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="2174917724755363426">ഇൻസ്റ്റാൾ ചെയ്യൽ പൂർത്തിയായിട്ടില്ല. റദ്ദാക്കണമെന്ന് ഉറപ്പാണോ?</translation>
<translation id="2937508664417729967">FlyWeb - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">അപ്ഡേറ്റ് പരിശോധനയിലെ പിശക്: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">FlyWeb-ൽ നിന്ന് അക്കൗണ്ട് നീക്കം ചെയ്യുക</translation>
<translation id="744837314710861405">എവിടെയായിരുന്നാലും മികച്ച ഷോപ്പിംഗ് ടൂളുകൾക്ക് FlyWeb ആപ്പ് ഉപയോഗിക്കുക</translation>
<translation id="2745381939758295588">iOS-നുള്ള FlyWeb-ലെ മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് ഉപയോഗിച്ച് എവിടെയായിരുന്നാലും സുരക്ഷിതരായിരിക്കുക</translation>
<translation id="6707114110652917144">അപകടകരമായ സൈറ്റ്. അറിയിപ്പുകൾ FlyWeb നീക്കം ചെയ്തു.</translation>
<translation id="2236949375853147973">എന്റെ ആക്റ്റിവിറ്റി</translation>
<translation id="4646732243247482236">വിലാസങ്ങളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. സൈൻ ഇൻ ചെയ്‌തുകഴിഞ്ഞാൽ ഈ വിലാസം നിങ്ങളുടെ FlyWeb sync chain-ൽ സംരക്ഷിക്കും.</translation>
<translation id="2726680594710751908">നിങ്ങളൊരു കമ്പ്യൂട്ടർ പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് ആവശ്യമുള്ള രീതിയിൽ FlyWeb സജ്ജീകരിക്കാനുമാകും.</translation>
<translation id="4086571337340463916">FlyWeb-ലെ Skills</translation>
<translation id="2283803047247799269">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ ടാബ് തിരയുക</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{നിങ്ങളുടെ ബ്രൗസറിന്റെ വേഗത കുറയ്ക്കുന്ന ടാബ് താൽക്കാലികമായി നിർത്താൻ FlyWeb നിർദ്ദേശിക്കുന്നു}other{നിങ്ങളുടെ ബ്രൗസറിന്റെ വേഗത കുറയ്ക്കുന്ന ടാബുകൾ താൽക്കാലികമായി നിർത്താൻ FlyWeb നിർദ്ദേശിക്കുന്നു}}</translation>
<translation id="2307973900865360088">ഡോക്കിൽ നിലനിർത്തൂ</translation>
<translation id="5067150284614317159">FlyWeb-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു. ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുമ്പോഴോ നിങ്ങൾ ഒരു ദോഷകരമായ ഫയൽ ഡൗൺലോഡ് ചെയ്യുമ്പോഴോ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കൾ സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് FlyWeb അയയ്ക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="2356070529366658676">ചോദിക്കുക</translation>
<translation id="2359808026110333948">തുടരുക</translation>
<translation id="7339360994527471629">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ "<ph name="EXTENSION_NAME"/>" എന്ന വിപുലീകരണം നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="8788732221355188962">ആപ്പുകൾക്കായി പശ്ചാത്തലത്തിൽ റൺ ചെയ്യുന്ന FlyWeb പ്രവർത്തനരഹിതമാക്കുക</translation>
<translation id="4126251160852694747"><ph name="USER_EMAIL_ADDRESS"/> എന്നയാളായി ഈ വിപുലീകരണം ഉപയോഗിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8418845734693287262">നിങ്ങളുടെ അക്കൗണ്ടിന്റെ സൈൻ ഇൻ വിശദാംശങ്ങൾ കാലഹരണപ്പെട്ടതിനാൽ ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു HID ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ടായിരുന്നു}=1{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു HID ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ട്}other{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ # HID ഉപകരണങ്ങൾ ആക്‌സസ് ചെയ്യുന്നുണ്ട്}}</translation>
<translation id="1364879203203742966">FlyWeb-ന് ഈ സൈറ്റിനായി ക്യാമറ, മൈക്രോഫോൺ അനുമതികൾ ആവശ്യമാണ്</translation>
<translation id="2403703063067034158">സ്റ്റാർട്ടപ്പിലെ പിശക്: സജ്ജീകരണത്തിന്റെ മറ്റൊരു ഇൻസ്റ്റൻസ് നിലവിൽ റൺ ചെയ്യുന്നുണ്ട്, പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="656987653252575654">ഏതൊരു ആപ്പിൽ നിന്നുമുള്ള ലിങ്കുകൾ FlyWeb-ൽ തുറക്കുക, നിങ്ങളുടെ ടാസ്‌ക്ബാറിൽ ബ്രൗസർ ആക്‌സസ് ചെയ്യാവുന്ന നിലയിൽ നിലനിർത്തുക</translation>
<translation id="157662717324308283">ദ്രുത അവലോകനം നേടാനും ഫോളോ അപ്പ് ചോദ്യങ്ങൾ ചോദിക്കാനും ഈ ഡോക്യുമെന്റ് FlyWeb-ലെ Gemini-യുമായി പങ്കിടാൻ 'സംഗ്രഹിക്കുക' ബട്ടൺ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>FlyWeb-ൽ നിന്നുള്ള ടൂളുകൾ<ph name="END_LINK"/> ഉപയോഗിച്ച്, നിങ്ങൾക്ക് സുരക്ഷിതമായി ബ്രൗസ് ചെയ്യാനും നിയന്ത്രണത്തിൽ തുടരാനുമാകും</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്. നിങ്ങളുടെ ബ്രൗസിംഗ് പ്രത്യേകമായി നിലനിർത്താൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും പാസ്‌വേഡുകളും മറ്റും ലഭിക്കുകയും ചെയ്യും.</translation>
<translation id="2451727308784734061">Password Manager-ലേക്ക് വേഗത്തിൽ എത്താൻ നിങ്ങളുടെ കുറുക്കുവഴി ഉപയോഗിക്കുക. നിങ്ങളുടെ കമ്പ്യൂട്ടറിന്റെ ഹോം സ്‌ക്രീനിലേക്കോ ആപ്പ് ലോഞ്ചറിലേക്കോ കുറുക്കുവഴി നീക്കാം.</translation>
<translation id="3224379053610845181">FlyWeb ഉടൻ അടയ്‌ക്കും</translation>
<translation id="3840682988105604367">FlyWeb-ത്തിൽ</translation>
<translation id="2485422356828889247">അണ്‍‌ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യുക</translation>
<translation id="2513154137948333830">റീബൂട്ട് ചെയ്യേണ്ടതുണ്ട്: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് ടെക്സ്റ്റ് തിരഞ്ഞെടുക്കുക</translation>
<translation id="6823116595279840454">നിലവിലുള്ള പാസ്‌വേഡുകൾ മാറ്റി പകരം പുതിയവ ചേർക്കാൻ FlyWeb ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="2691552788029831386">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ FlyWeb-ത്തിന് സ്റ്റോറേജ് ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="2275866327478859777">FlyWeb ഹെൽപ്പർ</translation>
<translation id="2575822587468774919">'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് തിരയാൻ എന്തെങ്കിലും തിരഞ്ഞെടുക്കുക</translation>
<translation id="683641781063074351">പാസ്‌വേഡുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="1659167470250249643">FlyWeb ഡൗൺലോഡ് ചെയ്യാനും നിങ്ങളുടെ FlyWeb sync chain-ലേക്ക് സൈൻ ഇൻ ചെയ്യാനും നിങ്ങളുടെ ഫോൺ ഉപയോഗിച്ച് ഈ QR കോഡ് സ്കാൻ ചെയ്യുക.</translation>
<translation id="5353172248151202719">FlyWeb ഉപയോഗിച്ച് തിരയാൻ.</translation>
<translation id="3231856291920394348">FlyWeb ഉപയോഗിക്കുന്നത് തുടരുക</translation>
<translation id="259935314519650377">ഡൗൺലോഡ് ചെയ്ത ഇൻസ്റ്റാളർ കാഷെ ചെയ്യാനായില്ല. പിശക്: <ph name="UNPACK_CACHING_ERROR_CODE"/></translation>
<translation id="2620436844016719705">സിസ്റ്റം</translation>
<translation id="7683745685556117660">നിങ്ങളുടെ ഓർഗനൈസേഷന് നിങ്ങളുടെ ബുക്ക്‌മാർക്കുകളും ചരിത്രവും പാസ്‌വേഡുകളും പോലുള്ള ബ്രൗസിംഗ് ഡാറ്റ കാണാനും മാനേജ് ചെയ്യാനും കഴിയും. മറ്റ് FlyWeb പ്രൊഫൈലുകളിലെ ബ്രൗസിംഗ് ഡാറ്റ അതിന് കാണാനാകില്ല</translation>
<translation id="5862783156828836752"><ph name="ACCOUNT_EMAIL"/> അക്കൗണ്ടിൽ FlyWeb ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും ഇത് നിങ്ങൾ തന്നെയാണെന്ന് പരിശോധിച്ചുറപ്പിക്കുക</translation>
<translation id="4450675160413947126">FlyWeb ആരംഭിക്കുക</translation>
<translation id="3827993926722004004">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിനിടെ ഒരു ഓപ്പറേറ്റിംഗ് സിസ്റ്റം പിശക് സംഭവിച്ചു. FlyWeb വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="333184635927514678">നിങ്ങളൊരു ഉപകരണം പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് താൽപ്പര്യമുള്ള തരത്തിൽ FlyWeb സജ്ജീകരിക്കാനുമാകും</translation>
<translation id="3917488635054382918">FlyWeb ചെറുതാക്കിയിട്ടുണ്ടെങ്കിൽ പോലും, നിങ്ങളുടെ ഉപകരണത്തിലുടനീളം FlyWeb-ലെ Gemini എളുപ്പത്തിൽ ആക്സസ് ചെയ്യാം.</translation>
<translation id="1257705702166647105">FlyWeb ടാബ്</translation>
<translation id="2796283369875688710">അധിക സുരക്ഷക്കായി, FlyWeb നിങ്ങളുടെ ഡാറ്റ എന്‍‌ക്രിപ്റ്റ് ചെയ്യും.</translation>
<translation id="1118215875395945816">FlyWeb-ൽ നിന്ന് നിങ്ങളുടെ FlyWeb sync chain നീക്കം ചെയ്യാൻ, സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="3320675843036708646">പാസ്‌വേഡുകളും ബുക്ക്‌മാർക്കുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="2738871930057338499">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. HTTP 403 നിരോധിച്ചിരിക്കുന്നു. നിങ്ങളുടെ പ്രോക്‌സി കോൺഫിഗറേഷൻ പരിശോധിക്കുക.</translation>
<translation id="2753623023919742414">തിരയാൻ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="8027563534376000179">FlyWeb നിങ്ങളുടെ ഡിഫോൾട്ട് PDF വ്യൂവറായി സജ്ജീകരിക്കുക</translation>
<translation id="7907238427168022751">ഈ വിപുലീകരണത്തിൽ മാല്‍വെയർ അടങ്ങിയിരിക്കുന്നു, ഇത് സുരക്ഷിതമല്ല. FlyWeb-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="2799223571221894425">വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="1489590198317876070">നിങ്ങളുടെ FlyWeb</translation>
<translation id="2816462166102338036">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ വീഡിയോ തിരയുക</translation>
<translation id="6850011743146651977">എവിടെയായിരുന്നാലും iOS-ലെ FlyWeb-ലൂടെ നിങ്ങളുടെ ക്യാമറ ഉപയോഗിച്ച് ഉൽപ്പന്നങ്ങൾ കണ്ടെത്തുകയും വിലക്കുറവ് ട്രാക്ക് ചെയ്യുകയും മറ്റും ചെയ്യൂ.</translation>
<translation id="2841525013647267359">ഈ ഭാഷയിൽ നിന്ന് വിവർത്തനം ചെയ്യുക</translation>
<translation id="2846251086934905009">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാളർ പൂർത്തിയായില്ല. ഇൻസ്റ്റാൾ ചെയ്യൽ റദ്ദാക്കി.</translation>
<translation id="1339341044496643931">FlyWeb-ൽ നിന്ന് നീക്കംചെയ്യുക...</translation>
<translation id="4922993584046885552">നിങ്ങൾ സൈൻ ഇൻ ചെയ്തിരിക്കുമ്പോൾ FlyWeb-ൽ നിങ്ങളെ സുരക്ഷിതരാക്കുകയും മറ്റ് FlyWeb ആപ്പുകളിൽ നിങ്ങളുടെ സുരക്ഷ മെച്ചപ്പെടുത്താൻ ഉപയോഗിക്കുകയും ചെയ്യും</translation>
<translation id="2885378588091291677">ടാസ്‌ക് മാനേജര്‍</translation>
<translation id="3806033752149316261">&amp;FlyWeb-നെക്കുറിച്ച്</translation>
<translation id="2915996080311180594">പിന്നീട് റീസ്‌റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="3497031519171753772">നിങ്ങളുടെ പാസ്ഫ്രെയ്‌സ് ഉപയോഗിച്ച് നിങ്ങളുടെ ഡാറ്റ എൻക്രിപ്റ്റ് ചെയ്‌തു. നിങ്ങളുടെ FlyWeb sync chain-ൽ FlyWeb ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും അത് നൽകുക.</translation>
<translation id="2945997411976714835">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാൾ ചെയ്യൽ പ്രക്രിയ ആരംഭിക്കാനായില്ല.</translation>
<translation id="1784605133570901105">iOS-ൽ FlyWeb-നായി സംരക്ഷിച്ച പാസ്‌വേഡുകൾ ഉപയോഗിച്ച് സൈറ്റുകളിലേക്ക് കൂടുതൽ വേഗത്തിൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="5383705372991100927">നിങ്ങളുടെ സ്ഥാപനം FlyWeb മാനേജ് ചെയ്യുന്നു</translation>
<translation id="1661079783259785361">FlyWeb അപ്‌‌ടുഡേറ്റാണ്</translation>
<translation id="5447533789927384736">ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുകയോ നിങ്ങൾ ദോഷകരമായ ഒരു ഫയൽ ഡൗൺലോഡ് ചെയ്യുകയോ ആണെങ്കിൽ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കളും സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് FlyWeb അയച്ചേക്കാം</translation>
<translation id="3208925917545144893">നിങ്ങളുടെ രക്ഷിതാവിന്റെ ചോയ്‌സുകൾ ഉപയോഗിച്ച് ഓൺലൈനിൽ സുരക്ഷിതരായിരിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3003694935412297923">എല്ലാ ടാസ്‌ക്കുകളും</translation>
<translation id="1216763100505470452">{count,plural, =1{നിങ്ങളുടെ FlyWeb sync chain-ൽ ചില ഡാറ്റ സംരക്ഷിക്കുന്നതിനും അത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഉപയോഗിക്കുന്നതിനും മുമ്പ് ഇത് നിങ്ങൾ തന്നെയാണെന്ന് FlyWeb-ന് പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ, ഈ ഡാറ്റ (1 ഇനം) ഇല്ലാതാക്കും.}other{നിങ്ങളുടെ FlyWeb sync chain-ൽ ചില ഡാറ്റ സംരക്ഷിക്കുന്നതിനും അത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഉപയോഗിക്കുന്നതിനും മുമ്പ് ഇത് നിങ്ങൾ തന്നെയാണെന്ന് FlyWeb-ന് പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ ഈ ഡാറ്റ ({count} ഇനങ്ങൾ) ഇല്ലാതാക്കും.}}</translation>
<translation id="8404327407921790238">FlyWeb-ലെ പുതിയ ടാബിൽ <ph name="URL"/> തുറക്കുക.</translation>
<translation id="5184501306555415561">Skills പോലുള്ള AI നവീകരണങ്ങൾ നിങ്ങളുടെ FlyWeb sync chain-ൽ സംരക്ഷിക്കുകയും FlyWeb സമന്വയത്തിൽ നിന്ന് വേറിട്ട് മാനേജ് ചെയ്യുകയും ചെയ്യുന്നു</translation>
<translation id="4409390320695765203">നിങ്ങളുടെ വിപുലീകരണങ്ങളും മറ്റും എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="8841609317523323027">FlyWeb-ലേക്ക് ചേർക്കുന്നു...</translation>
<translation id="3038232873781883849">ഇൻസ്റ്റാൾ ചെയ്യാൻ കാത്തിരിക്കുന്നു...</translation>
<translation id="3045032126857188731">വിവർത്തനം ചെയ്‌ത ഭാഷ: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ഫീഡ്ബാക്ക് ഡയലോഗ് അടയ്ക്കുക</translation>
<translation id="2666189940580882376"><ph name="EXISTING_USER"/> ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്. നിങ്ങളുടെ ബ്രൗസിംഗ് പ്രത്യേകമായി നിലനിർത്താൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. <ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ വായിക്കാനുള്ളവയുടെ ലിസ്‌റ്റും മറ്റും ലഭിക്കുകയും ചെയ്യും.</translation>
<translation id="4451837224464070850">മറ്റ് FlyWeb പ്രൊഫൈലുകൾ</translation>
<translation id="4351369660845291597">FlyWeb ഇഷ്ടാനുസൃതമാക്കാൻ നിങ്ങളെ അനുവദിക്കുന്ന ആഡ് ഓണുകളാണ് വിപുലീകരണങ്ങൾ. ഓർഗനൈസ് ചെയ്ത് നിലനിർത്തുന്നത് മുതൽ ദൈനംദിന ടാസ്‌ക്കുകൾ ലളിതമാക്കുന്നത് വരെ, FlyWeb നിങ്ങൾക്ക് അനുയോജ്യമാക്കി മാറ്റാൻ വിപുലീകരണങ്ങൾ സഹായിക്കുന്നു.</translation>
<translation id="7859502023458300952">FlyWeb-ലേക്ക് ക്രാഷ് റിപ്പോർട്ടുകളും <ph name="UMA_LINK"/> എന്നതും അയയ്‌ക്കുന്നതിലൂടെ FlyWeb മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="1125501479713660011">എവിടെയായിരുന്നാലും FlyWeb-ന്റെ സുരക്ഷ ആസ്വദിക്കാൻ FlyWeb ആപ്പ് ഉപയോഗിക്കുക</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു USB ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ടായിരുന്നു}=1{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു USB ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ട്}other{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ # USB ഉപകരണങ്ങൾ ആക്‌സസ് ചെയ്യുന്നുണ്ട്}}</translation>
<translation id="6017373390117959211"><ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ വായിക്കാനുള്ളവയുടെ ലിസ്റ്റും മറ്റും ലഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="7898392424469957829">FlyWeb ചരിത്രം</translation>
<translation id="1407857531570256859">ആര്‍ക്കൈവ് അണ്‍‌കം‌പ്രസ് ചെയ്യാന്‍ ഇന്‍സ്റ്റാളറിന് കഴിഞ്ഞില്ല. FlyWeb വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="310459126943037700">ടാസ്‌ക്(കൾ) അവസാനിപ്പിക്കാനായില്ല.</translation>
<translation id="3104828284009500087">പേജിൽ എന്തും തിരയുക</translation>
<translation id="4706932464498663870">നിങ്ങളുടെ പാസ്‌വേഡുകളും ബുക്ക്‌മാർക്കുകളും ചരിത്രവും ഉപകരണങ്ങളിലുടനീളം കൃത്യമായി സമന്വയിപ്പിച്ച് നിലനിർത്തുക. നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസർ FlyWeb-ലേക്ക് അപ്ഡേറ്റ് ചെയ്ത് നിങ്ങൾക്ക് അറിയാവുന്നതും ഇഷ്ടമുള്ളതുമായ ഫീച്ചറുകൾ എളുപ്പത്തിൽ ആക്സസ് ചെയ്യുക.</translation>
<translation id="1309738977648134943">FlyWeb നിങ്ങളുടെ മൈക്രോഫോൺ ഉപയോഗിക്കുന്നു.</translation>
<translation id="3130333203120345554">പുതിയ തിരയൽ</translation>
<translation id="3137969841538672700">തിരയാൻ വലിച്ചിടുക</translation>
<translation id="2251813826843049011">ഈ ടാബ് അധിക ഉറവിടങ്ങൾ ഉപയോഗിക്കുന്നു. നിങ്ങളുടെ പ്രകടനം മെച്ചപ്പെടുത്താനായി അതിനെ നിഷ്ക്രിയമാക്കാൻ FlyWeb-നെ അനുവദിക്കുക.</translation>
<translation id="2664701271733223256">നിങ്ങളുടെ സ്‌ക്രീൻ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക</translation>
<translation id="6274649779206195384">FlyWeb വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="3161522574479303604">എല്ലാ ഭാഷകളും</translation>
<translation id="6773570808762718524">നിങ്ങളുടെ പുതിയ FlyWeb പ്രൊഫൈൽ ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="8965010907836433875">ടാബുകൾ മാറാതെ തന്നെ നിങ്ങൾക്ക് AI മോഡുമായി ചാറ്റ് ചെയ്യുന്നത് തുടരാം. ആരംഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും പാസ്‌വേഡുകളും മറ്റും ലഭിക്കുകയും ചെയ്യും.</translation>
<translation id="5958835776851191812">FlyWeb-ൽ നിന്ന് നിങ്ങളുടെ FlyWeb sync chain നീക്കം ചെയ്യാൻ, ക്രമീകരണം പേജിൽ FlyWeb-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="4217346567895356023">പിന്നീട്, സംരക്ഷിച്ച വിവരങ്ങൾ സ്വയമേവ ഫോമുകൾ പൂരിപ്പിക്കാൻ ഉപയോഗിക്കണമെന്നുണ്ടോ എന്ന് FlyWeb നിങ്ങളോട് ചോദിക്കും</translation>
<translation id="5449297306961970452">FlyWeb-ത്തിന് ഡാറ്റാ ഡയറക്‌റ്ററി വായിക്കാനോ അതിൽ എഴുതാനോ കഴിയില്ല:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">എവിടെയായിരുന്നാലും iOS-ലെ FlyWeb ഉപയോഗിച്ച് നിങ്ങളുടെ പ്രിയപ്പെട്ട FlyWeb AI ടൂളുകൾ ഉപയോഗിക്കൂ.</translation>
<translation id="8090118570458552025"><ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ വിപുലീകരണങ്ങളും മറ്റും ലഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3286538390144397061">ഇപ്പോള്‍ പുനരാരംഭിക്കുക</translation>
<translation id="3900612994249740104">FlyWeb API കീകൾ നഷ്‌ടമായി. FlyWeb-ന്‍റെ ചില പ്രവർത്തനങ്ങൾ പ്രവർത്തനരഹിതമാകും.</translation>
<translation id="6824575001009586492">FlyWeb അടയ്‌ക്കുമ്പോൾ അപ്ലിക്കേഷനുകൾ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കുന്നത് തുടരുക</translation>
<translation id="2595215790271940091">സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിച്ച് ഏതെങ്കിലും സൈറ്റ് ലോഡ് ചെയ്യുന്നതിന് മുമ്പ് FlyWeb നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകും</translation>
<translation id="3701353923785984059">FlyWeb-ൽ സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ടെങ്കിൽ എല്ലാ FlyWeb വിൻഡോകളും അടയ്ക്കുമ്പോൾ, നിങ്ങളുടെ FlyWeb sync chain ഒഴികെ മിക്ക സൈറ്റുകളിൽ നിന്നും നിങ്ങൾ സൈൻ ഔട്ട് ആകും. നിങ്ങളെ ഓർക്കാൻ സൈറ്റുകളെ അനുവദിക്കുന്നതിന്, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">തിരയൽ ഏരിയയുടെ മുകളിലെ വലത് മൂല: വലതുഭാഗത്ത് <ph name="RIGHT"/>%, മുകളിൽ <ph name="TOP"/>%</translation>
<translation id="8629055140319079166">നിങ്ങളുടെ അക്കൗണ്ടിലെ FlyWeb ഡാറ്റ</translation>
<translation id="1943161457314845496">നിങ്ങളുടെ ഫോണിലെ FlyWeb-ൽ നിങ്ങളുടെ പാസ്‌വേഡുകൾ ഉപയോഗിക്കുക</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">നിലവിലുള്ള FlyWeb പ്രൊഫൈലിലേക്ക് മാറണോ?</translation>
<translation id="3412460710772753638">ഈ ഉപകരണത്തിലെ Password Manager-ൽ</translation>
<translation id="1568435374218487057"><ph name="DEVICE"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ ബുക്ക്‌മാർക്കുകളും മറ്റും ലഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3438772217992559640">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ ടാബ് തിരയുക</translation>
<translation id="6301354573631022693">നിങ്ങളുടെ ഫോണിലെ FlyWeb ഉപയോഗിച്ച് മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് പ്രയോജനപ്പെടുത്തൂ</translation>
<translation id="7625477329092296018">നിങ്ങൾക്ക് അനുയോജ്യമായ രീതിയിൽ FlyWeb സജ്ജീകരിക്കുക...</translation>
<translation id="956833467923764542">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും <ph name="ITEMS_COUNT"/> ഇനങ്ങൾ ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി FlyWeb-ത്തിൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> എന്നതിന് FlyWeb പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
<translation id="6724485219247982027">എല്ലാ FlyWeb വിൻഡോകളും അടച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5048962017649434283">നിങ്ങളുടെ വിൻഡോ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/>, ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്.  നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="408747932595284596">മൊബൈലുകളിൽ FlyWeb ബ്രൗസർ ഡൗൺലോഡ് ചെയ്യാനുള്ള QR കോഡ്</translation>
<translation id="1413410454753055427">റിമൈൻഡർ: FlyWeb-ന്റെ മികച്ച സുരക്ഷാ ഫീച്ചറുകൾ നിങ്ങളുടെ കൈയിൽ</translation>
<translation id="7831730508158736496">നിങ്ങളുടെ സ്‌ക്രീൻ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക.</translation>
<translation id="9006158231572141726">മെച്ചപ്പെടുത്തിയ പരിരക്ഷ, FlyWeb തിരിച്ചറിയാത്ത സൈറ്റുകൾക്കുള്ള JavaScript ഒപ്റ്റിമൈസേഷൻ ഓഫാക്കുന്നു</translation>
<translation id="3597003331831379823">പ്രത്യേക പ്രിവിലേജുകൾ ആവശ്യമുള്ള സജ്ജീകരണം റൺ ചെയ്യാനായില്ല. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="6970052268542136081">ഈ ഉപകരണത്തിൽ നിന്ന് ഈ വ്യക്തിയുടെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഡാറ്റ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നതായി FlyWeb-ത്തിലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="3667616615096815454">ഇൻസ്റ്റാൾ ചെയ്യാനാകുന്നില്ല, സെർവറിന് ഈ ആപ്പ് പരിചിതമല്ല.</translation>
<translation id="2438845157914027912">നിങ്ങളുടെ <ph name="BEGIN_LINK"/>സ്വന്തം പാസ്ഫ്രെയ്‌സ്<ph name="END_LINK"/> ഉപയോഗിച്ച് FlyWeb sync chain-ലെ എല്ലാ FlyWeb ഡാറ്റയും എൻക്രിപ്റ്റ് ചെയ്യുക. Google Pay-യിൽ നിന്നുള്ള പേയ്‌മെന്റ് രീതികളും വിലാസങ്ങളും എൻക്രിപ്റ്റ് ചെയ്യില്ല. FlyWeb-ൽ നിന്നുള്ള ബ്രൗസിംഗ് ചരിത്രം സമന്വയിപ്പിക്കില്ല.</translation>
<translation id="6611602069520888180">FlyWeb അദൃശ്യ വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="2591356225047803326">വ്യക്തിപരമാക്കലിനും മറ്റ് ആവശ്യങ്ങൾക്കുമായി FlyWeb-ഉം മറ്റ് FlyWeb സേവനങ്ങളും ലിങ്ക് ചെയ്യുക</translation>
<translation id="3729187154190517324">"ടാബും മറ്റും ചേർക്കുക" ബട്ടൺ ഉപയോഗിച്ച് ഒന്നിലധികം ടാബുകളും ഫയലുകളും ടൂളുകളും ചേർത്ത് നിങ്ങളുടെ തിരയലിന്റെ വ്യാപ്‌തി വർദ്ധിപ്പിക്കുക.</translation>
<translation id="1771882170639856394">FlyWeb പ്രൊഫൈലുകൾ മാനേജ് ചെയ്യുക</translation>
<translation id="3782148374606932577">ചില ഡൗൺലോഡുകൾ FlyWeb ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="4640643918757362950">നിങ്ങളുടെ അവലോകനം ആവശ്യമുള്ള എന്തെങ്കിലും ഉണ്ടെങ്കിൽ FlyWeb നിങ്ങളെ അറിയിക്കും</translation>
<translation id="2179738813053854729">നിങ്ങൾ സന്ദർശിക്കാനിടയുള്ള പേജുകൾ FlyWeb മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു, ഇതുവഴി നിങ്ങൾ ആ പേജുകൾ സന്ദർശിക്കുമ്പോൾ അവ അതിവേഗം ലോഡ് ചെയ്യും</translation>
<translation id="3810973564298564668">നിയന്ത്രിക്കൂ</translation>
<translation id="5026502787439628947">സംരക്ഷിച്ച പാസ്‌വേഡുകൾ ഉപയോഗിക്കാൻ, QR കോഡ് ഉപയോഗിച്ച്, iOS-നുള്ള FlyWeb ഡൗൺലോഡ് ചെയ്‌ത ശേഷം നിങ്ങളുടെ FlyWeb sync chain-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3846683726093018685">**സംഗ്രഹിക്കുക:** 30 വാക്കുകൾക്കുള്ളിൽ ഒറ്റ വാചകത്തിൽ, സ്‌ക്രീൻഷോട്ടിലെ ഉള്ളടക്കത്തിന്റെ പ്രാഥമിക വിഷയവും ലക്ഷ്യവും വിവരിക്കുക.

          **ചോദ്യങ്ങൾ നിർദ്ദേശിക്കുക:** സ്‌ക്രീൻഷോട്ട് മനസ്സിലാക്കുന്നതിന് ഉപയോക്താവ് ചോദിക്കാനിടയുള്ള, ചിന്ദോദ്ദീപകമായ 3-5 ചോദ്യങ്ങൾ അടങ്ങുന്ന ബുള്ളറ്റ് ചെയ്ത ഒരു ലിസ്റ്റ് ജനറേറ്റ് ചെയ്യുക. വിഷ്വൽ ഒബ്‌ജക്റ്റിനെ കുറിച്ചോ അതിന്റെ ഡിസൈനിനെ കുറിച്ചോ പ്ലേസ്‌മെന്റിനെ കുറിച്ചോ ഉള്ള ഒരു ചോദ്യമെങ്കിലും ഈ ചോദ്യങ്ങളിൽ ഉണ്ടായിരിക്കണം.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">ബുക്ക്‌മാർക്കുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3885770153807205175">ഭാഷാ പിക്കർ</translation>
<translation id="5175060854726708547">FlyWeb ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക. എന്തോ ഒന്നിന് നിങ്ങളുടെ ശ്രദ്ധ വേണം -വിശദാംശങ്ങൾക്ക് ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="606156353708638647">FlyWeb തുറന്ന് ബ്രൗസിംഗ് ആരംഭിക്കാൻ നിങ്ങളുടെ പേരിൽ ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="3892148308691398805">ടെക്‌സ്‌റ്റ് പകർത്തുക</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> ഇതിനകം ഈ FlyWeb പ്രൊഫൈലിലേക്ക് സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു. നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, FlyWeb-ന് നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈൽ സൃഷ്‌ടിക്കാനാകും.</translation>
<translation id="3941890832296813527">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാളർ ഫയൽ നാമം അസാധുവാണ് അല്ലെങ്കിൽ പിന്തുണയില്ല.</translation>
<translation id="8536259619256229278">പാസ്‌വേഡുകൾ പകർത്താൻ FlyWeb ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="7965008434896274911">സംരക്ഷിച്ച വിവരങ്ങളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭ്യമാക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="4540773594514226705">FlyWeb sync chain-ൽ സംരക്ഷിച്ചിരിക്കുന്ന നിങ്ങളുടെ പാസ്‌വേഡുകൾ, പേയ്‌മെന്റ് രീതികൾ, വിലാസങ്ങൾ എന്നിവ ഈ ഉപകരണത്തിൽ നിന്ന് നീക്കം ചെയ്യും. FlyWeb-ൽ അവ വീണ്ടും ഉപയോഗിക്കാൻ, വീണ്ടും സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="395904275706073188">പരിരക്ഷിത പേജുകൾ വായിക്കാനാകില്ല. മറ്റൊരു പേജ് പരീക്ഷിക്കുക.</translation>
<translation id="3849784651193576458">FlyWeb നിങ്ങളെ എങ്ങനെ സുരക്ഷിതരായി സൂക്ഷിക്കുന്നുവെന്ന് അറിയുക</translation>
<translation id="3967822245660637423">ഡൗൺലോഡ് പൂർത്തിയായി</translation>
<translation id="562495843857641474">നിങ്ങൾ വിലാസ ബാറിലോ സെർച്ച് ബോക്സിലോ ടൈപ്പ് ചെയ്യുമ്പോൾ, നിർദ്ദേശങ്ങൾ ലഭിക്കുന്നതിന് FlyWeb നിങ്ങളുടെ സ്ഥാപനത്തിന്റെ തിരയൽ, AI, ഏജന്റ് ടൂളുകളിലേക്ക് നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്നത് അയയ്ക്കുന്നു.</translation>
<translation id="5667414856761616811">&amp;FlyWeb for Testing-നെക്കുറിച്ച്</translation>
<translation id="1152920704813762236">ChromeOS-നെ കുറിച്ച്</translation>
<translation id="4920206821838432969">നിങ്ങൾ ഒരു സൈറ്റ് സന്ദർശിക്കുമ്പോൾ, നിങ്ങളുടെ IP വിലാസം മറയ്ക്കുന്ന ഒരു സ്വകാര്യതാ സെർവർ വഴി, URL-ന്റെ സ്‌പഷ്‌ടമല്ലാത്ത ഭാഗം <ph name="BEGIN_LINK"/>FlyWeb സുരക്ഷിത ബ്രൗസിംഗിലേക്ക്<ph name="END_LINK"/> FlyWeb അയയ്ക്കുന്നു. ഒരു സൈറ്റ് സംശയാസ്പദമായ എന്തെങ്കിലും ചെയ്താൽ, മുഴുവൻ URL-കളും പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകളും അയയ്ക്കും.</translation>
<translation id="4016217212818346953">Password Manager ഉപയോഗിച്ച് സുരക്ഷിതരായിരിക്കൂ</translation>
<translation id="3703994572283698466">ChromeOS സാധ്യമാക്കിയത് <ph name="BEGIN_LINK_LINUX_OSS"/>Linux വികസന പരിതസ്ഥിതി<ph name="END_LINK_LINUX_OSS"/> പോലുള്ള അധിക <ph name="BEGIN_LINK_CROS_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_CROS_OSS"/> ഉപയോഗിച്ചാണ്.</translation>
<translation id="4022972681110646219">സ്‌ക്രീൻ വിവർത്തനം ചെയ്യുക</translation>
<translation id="4023601594785368013">ഒറിജിനൽ ഭാഷ: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">ഏത് ആപ്പിൽ നിന്നും FlyWeb-ൽ ലിങ്കുകൾ തുറക്കുക. കൂടാതെ എളുപ്പത്തിലുള്ള ആക്‌സസിനായി, അത് നിങ്ങളുടെ ടാസ്‌ക്‌ബാറിൽ പിൻ ചെയ്യും.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>നിലവിലെ ക്രമീകരണം<ph name="END_LINK"/> റിപ്പോർട്ട് ചെയ്‌തുകൊണ്ട് FlyWeb മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="4050175100176540509">ഏറ്റവും പുതിയ പതിപ്പിൽ പ്രധാനപ്പെട്ട സുരക്ഷാ മെച്ചപ്പെടുത്തലുകളും പുതിയ ഫീച്ചറുകളും ലഭ്യമാണ്.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{ഒരു മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ FlyWeb അടയ്‌ക്കും. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.}other{# മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ FlyWeb അടയ്‌ക്കും. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.}}</translation>
<translation id="4105099155797156500">'FlyWeb-ത്തെ കുറിച്ച്' പേജിലേക്ക് പോകുക</translation>
<translation id="7753744564324413106">നിങ്ങളുടെ ബ്രൗസറിന് പുതിയ രൂപം നൽകാൻ FlyWeb ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="3202882878525816493">നിങ്ങളുടെ FlyWeb ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="4148957013307229264">ഇന്‍സ്റ്റാളുചെയ്യുന്നു...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - FlyWeb</translation>
<translation id="6368928751841546993"><ph name="EXISTING_USER"/> ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്. നിങ്ങളുടെ ബ്രൗസിംഗ് പ്രത്യേകമായി നിലനിർത്താൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും വായിക്കാനുള്ളവയുടെ ലിസ്റ്റും മറ്റും ലഭിക്കുകയും ചെയ്യും.</translation>
<translation id="4007949387571083162">FlyWeb-നായി മികച്ച അപ്ലിക്കേഷനുകളും വിപുലീകരണങ്ങളും തീമുകളും കണ്ടെത്തുക.</translation>
<translation id="4753212377237684548">ഈ വിപുലീകരണവും മറ്റും നിങ്ങളുടെ എല്ലാ കമ്പ്യൂട്ടറുകളിലും ലഭിക്കാൻ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="4391959806766569994">നിങ്ങളുടെ രക്ഷിതാക്കളുടെ ചോയ്‌സുകൾ ഉപയോഗിച്ച് ഓൺലൈനിൽ സുരക്ഷിതരായിരിക്കാൻ, <ph name="USER_EMAIL_ADDRESS"/> ആയി ഇതിനകം സൈൻ ഇൻ ചെയ്ത നിങ്ങളുടെ FlyWeb പ്രൊഫൈലിലേക്ക് മാറുക</translation>
<translation id="4222932583846282852">റദ്ദാക്കുന്നു...</translation>
<translation id="4224210481850767180">ഇൻസ്റ്റാൾ ചെയ്യുന്നത് റദ്ദാക്കി.</translation>
<translation id="2564888740660198776">നിങ്ങളുടെ FlyWeb ഡാറ്റ ഈ അക്കൗണ്ടുമായി ലിങ്ക് ചെയ്യണോ?</translation>
<translation id="7337819873931851298">സ്റ്റാൻഡേർഡ് പരിരക്ഷയ്‌ക്ക് പുറമെ, സൈറ്റുകളിൽ നിന്നുള്ള കൂടുതൽ ഡാറ്റ വിശകലനം ചെയ്യുന്നതിലൂടെ, FlyWeb-ന് മുമ്പ് അറിയാത്തവ ഉൾപ്പെടെയുള്ള അപകടകരമായ സൈറ്റുകളെക്കുറിച്ച് മുന്നറിയിപ്പ് നൽകുന്നു. നിങ്ങൾക്ക് FlyWeb മുന്നറിയിപ്പുകൾ ഒഴിവാക്കാൻ തീരുമാനിക്കാം.</translation>
<translation id="8391959103619318249">FlyWeb-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="8514458758262040082">FlyWeb ഉപയോഗിക്കുന്നതിനുള്ള സഹായം തേടുക</translation>
<translation id="4281844954008187215">സേവന നിബന്ധനകൾ</translation>
<translation id="3393587701694585022">അവ്യക്തമായ പിശകിനാൽ ഇൻസ്റ്റാൾ ചെയ്യൽ പരാജയപ്പെട്ടു. FlyWeb നിലവിൽ പ്രവർത്തിക്കുന്നുണ്ടെങ്കിൽ, അത് അടച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="271336227467646058">FlyWeb-ൽ നിന്ന് പാസ്‌വേഡുകൾ എക്‌സ്പോർട്ട് ചെയ്യുക</translation>
<translation id="4304713468139749426">പാസ്‌വേഡ് മാനേജർ</translation>
<translation id="4334241893986177674">ഈ സ്ക്രീൻഷോട്ട് തിരയുക</translation>
