<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1026101648481255140">इन्स्टल गर्ने प्रक्रिया सुचारु गर्नुहोस्</translation>
<translation id="7099479769133613710">&amp;ChromeOS अपडेट गर्न यसलाई रिलन्च गर्नुहोस्</translation>
<translation id="291426170030461697">FlyWeb तपाईंलाई यो एक्स्टेन्सनको समीक्षा गर्न सिफारिस गर्छ</translation>
<translation id="1549005488226693697">कुनै साइटले आफ्नो पेजमा भएका लिंकहरू गोप्य तरिकाले प्रिलोड गर्न लगाएका खण्डमा FlyWeb ले FlyWeb का सर्भरहरू प्रयोग गर्छ। यसो गर्दा प्रिलोड गरिएको साइटमा भएको तपाईंको पहिचान खुलाउने जानकारी लुकाइन्छ तर FlyWeb ले कुन कुन साइट प्रिलोड गरिन्छन् भन्ने कुरा सिक्छ।</translation>
<translation id="1065672644894730302">तपाइँका प्राथमिकातहरू पढ्न सकिदैन।

केही सुविधाहरू अनुपलब्ध हुन सक्छन् र प्राथमिकताहरूमा परिवर्तनहरू बचत हुने छैनन्।</translation>
<translation id="8908267645832965492">तपाईंका अभिभावकले FlyWeb का हकमा "साइट, एप तथा एक्सटेन्सनसम्बन्धी अनुमति" अफ गर्नुभएको छ</translation>
<translation id="6896681084876612310">FlyWeb ले तपाईंलाई डेटा चोरीका घटना, हानिकारक एक्स्टेन्सन र थप समस्याहरूबाट सुरक्षित रहन मद्दत गर्न सक्छ</translation>
<translation id="1368460307421081773">FlyWeb तपाईंका पासवर्डहरू निर्यात गर्न चाहन्छ। यसो गर्ने अनुमति दिन Windows को आफ्नो पासवर्ड टाइप गर्नुहोस्‌।</translation>
<translation id="7307912249127683931">FlyWeb तपाईंको डिफल्ट ब्राउजर हो</translation>
<translation id="4556715463645168547">तपाईंका पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK"/>FlyWeb मा साइन इन गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="2076135703183650206">FlyWeb मेनुमा क्लिक गर्नुहोस्</translation>
<translation id="1184145431117212167">तपाईंको डिभाइसमा भएको Windows को संस्करणमा नचल्ने भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="4380351562011537903">FlyWeb का बारेमा</translation>
<translation id="2593084789070248821">आफ्नो विन्डो सेयर गर्न सिस्टमका प्राथमिकताहरूमा गई FlyWeb लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्।</translation>
<translation id="1203500561924088507">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="4750836834956739196">यो ट्याब निष्क्रिय हुँदा FlyWeb छिटो चल्ने बनाइराख्न मेमोरी खाली गरिएको थियो। तपाईं यो साइटलाई जुनसुकै बेला सक्रिय राखिराख्ने विकल्प छनौट गर्न सक्नुहुन्छ।</translation>
<translation id="3190759351483708314">यो फाइल खतरनाक भएकाले FlyWeb ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/> मार्फत FlyWeb का Gmail वा YouTube लगायतका सेवाहरूमा साइन इन गर्दा तपाईं उही खातामार्फत FlyWeb मा स्वतः साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="1290883685122687410">सेटअप गर्ने क्रममा निम्न त्रुटि भयो: <ph name="METAINSTALLER_EXIT_CODE"/>। <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">FlyWeb मा आफ्नो नयाँ प्रोफाइल सेटअप गर्नुहोस्</translation>
<translation id="609743863669742325">FlyWeb सँग ब्लुटुथ डिभाइसहरू खोज्नका निम्ति 
 ब्लुटुथको एक्सेस हुनु पर्छ। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">यो जानकारी FlyWeb बाट पनि मेटाउनुहोस् (<ph name="URL"/>)</translation>
<translation id="4150708158890309866">तपाइँ FlyWeb मा साइन इन</translation>
<translation id="4713192356155907986">FlyWeb for Testing का सम्बन्धमा मद्दत प्राप्त गर्नुहोस्</translation>
<translation id="1497802159252041924">इन्स्टल गर्ने क्रममा त्रुटि भयो: <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">FlyWeb को ट्याब सेयर गर्नुहोस्</translation>
<translation id="8196829963313696543">FlyWeb लाई तपाईं वरपरको ठाउँको 3D नक्सा बनाउन तपाईंको क्यामेरा प्रयोग गर्ने अनुमति चाहिन्छ</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{यो एक्स्टेन्सन अब प्रयोग गर्न मिल्दैन। FlyWeb ले तपाईंलाई यो एक्स्टेन्सन हटाउन सिफारिस गर्छ।}other{यी एक्स्टेन्सनहरू अब प्रयोग गर्न मिल्दैनन्। FlyWeb ले तपाईंलाई यी एक्स्टेन्सनहरू हटाउन सिफारिस गर्छ।}}</translation>
<translation id="852852907317361085">FlyWeb का सुरक्षासम्बन्धी टुलहरू</translation>
<translation id="4096742538387076253">FlyWeb ले तपाईंको पहिचान पुष्टि गरेपछि मात्र तपाईं आफ्नो FlyWeb खातामा कुनै डेटा सेभ गर्न र उक्त डेटा आफ्ना सबै डिभाइसहरूमा प्रयोग गर्न सक्नुहुन्छ। तपाईंले साइन आउट गर्नुभयो भने उक्त डेटा यो डिभाइसमा रहिरहने छ।</translation>
<translation id="481155564361715417">FlyWeb तपाईंको पासवर्ड म्यानेजरमा भएको जानकारी मेटाउन चाहन्छ। यसो गर्ने अनुमति दिन Windows को पासवर्ड टाइप गर्नुहोस्।</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{तपाईंका व्यवस्थापकका अनुसार तपाईंले यो अद्यावधिक लागू गर्न FlyWeb पुनः सुरु गर्नु पर्ने हुन्छ}=1{तपाईंका व्यवस्थापकका अनुसार तपाईंले यो अद्यावधिक लागू गर्न FlyWeb पुनः सुरु गर्नु पर्ने हुन्छ। तपाईंको इन्कोग्निटो विन्डो पुनः खुल्ने छैन।}other{तपाईंका व्यवस्थापकका अनुसार तपाईंले यो अद्यावधिक लागू गर्न FlyWeb पुनः सुरु गर्नु पर्ने हुन्छ। तपाईंका # वटा इन्कोग्निटो विन्डो पुनः खुल्ने छैनन्।}}</translation>
<translation id="3961251277542681013">FlyWeb मा भएका गोपनीयता र सुरक्षासम्बन्धी मुख्य नियन्त्रण सुविधाहरूको समीक्षा गर्नुहोस्</translation>
<translation id="4434689349450618970">तपाईं यो खाता एक पटक मात्र प्रयोग गर्न चाहनुहुन्छ भने तपाईं FlyWeb ब्राउजरमार्फत <ph name="GUEST_LINK_BEGIN"/>गेस्ट मोड<ph name="GUEST_LINK_END"/> प्रयोग गर्न सक्नुहुन्छ। तपाईं अरू कसैको खाता लिंक गर्न चाहनुहुन्छ भने उहाँलाई <ph name="LINK_BEGIN"/>नयाँ व्यक्तिका रूपमा<ph name="LINK_END"/> आफ्नो <ph name="DEVICE_TYPE"/> मा सामेल गराउनुहोस्।

तपाईंले वेबसाइट तथा एपहरूलाई दिइसक्नुभएका अनुमति यो खाताका हकमा पनि लागू हुन सक्छ। तपाईं <ph name="SETTINGS_LINK_BEGIN"/>सेटिङ<ph name="SETTINGS_LINK_END"/>मा गई आफ्ना FlyWeb खाताहरू व्यवस्थापन गर्न सक्नुहुन्छ।</translation>
<translation id="1640672724030957280">डाउनलोड गरिँदै छ...</translation>
<translation id="6153580651793156880">यी सुविधाहरूको गुणस्तर सुधार्ने प्रयोजनका लागि FlyWeb ले तपाईंले यी सुविधासँग गरेका अन्तर्क्रियासम्बन्धी जानकारी FlyWeb लाई पठाउँछ। समीक्षकहरू यो जानकारी पढ्न, प्रोसेस गर्न र एनोटेट गर्न सक्छन्।</translation>
<translation id="1722488837206509557">तपाईंले यो अनुमति दिनुभयो भने तपाईं उपलब्ध डिभाइसहरूमध्येबाट कुनै डिभाइस चयन गर्न र उक्त डिभाइसमा सामग्री देखाउन सक्नु हुने छ।</translation>
<translation id="2383861520542390014">तपाईं वेबसाइटहरूले तपाईंलाई विज्ञापन देखाउन प्रयोग गर्ने रुचिका विषयहरू हेर्न तथा हटाउन सक्नुहुन्छ। FlyWeb ले तपाईंको हालसालैको ब्राउजिङ इतिहासका आधारमा तपाईंलाई रुचि लाग्न सक्ने विषयहरू पत्ता लगाउँछ।</translation>
<translation id="5695205873161614119">FlyWeb ले चाँडै नै ब्राउजिङ डेटा मेटाउने छ</translation>
<translation id="8939535770474283898">FlyWeb ले वेबपेजहरू लोड गर्न HTTPS प्रयोग गर्ने प्रयास गर्ने छ</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/> पछि रिस्टार्ट हुने छ</translation>
<translation id="6903827847227122616">HTTPS उपलब्ध नहुँदा FlyWeb ले तपाईंलाई चेतावनी नदिइकनै असुरक्षित कनेक्सन प्रयोग गर्ने छ</translation>
<translation id="307170399141486420">FlyWeb पृष्ठभूमिमा चलाउछन्</translation>
<translation id="543905389684998697">FlyWeb लाई अझ सुरक्षित बनाउनको लागि, हामीले <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> मा सूचीकृत नगरिएका केही एक्स्टेन्सनहरूलाई अक्षम बनाएका छौँ र तपाईंलाई थाहा दिए बिना थपिएको हुन सक्छ।</translation>
<translation id="2473319786107120819">FlyWeb पुनर्स्थापित गर्नुहोस्</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> प्रयास गर्दै छ</translation>
<translation id="3403116471618205223">तपाईंको FlyWeb खातामा ब्राउजिङ डेटा यथावत् राखी यो डिभाइसबाट मात्र ब्राउजिङ डेटा मेटाउन <ph name="BEGIN_LINK"/>FlyWeb बाट साइन आउट गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="4630629063306099328">तपाईं साइन इन गरिएका आफ्ना FlyWeb खाताहरू व्यवस्थापन गर्न सक्नुहुन्छ। तपाईंका FlyWeb खाताहरू FlyWeb ब्राउजर, Play स्टोर, Gmail र अन्य एपहरूमा प्रयोग गरिन्छन्। तपाईं परिवारका सदस्य जस्ता अरू कसैको खाता थप्न चाहनुहुन्छ भने उहाँको खाता थप्नुको साटो उहाँलाई नयाँ व्यक्तिका रूपमा आफ्नो <ph name="DEVICE_TYPE"/> मा सामेल गराउनुहोस्। <ph name="LINK_BEGIN"/>थप जान्नुहोस्<ph name="LINK_END"/></translation>
<translation id="6434738578659849497">साइटहरूले FlyWeb मा तपाईंका रुचिसम्बन्धी जानकारी भण्डारण गर्न सक्छन्। उदाहरणका लागि, तपाईंले कुनै साइटमा गएर म्याराथनमा दौडिँदा लगाइने जुत्ता किन्नुभयो भने उक्त साइटले तपाईं म्याराथन दौडमा रुचि राख्नुहुन्छ भन्ने कुरा बुझ्न सक्छ। पछि तपाईं दौड प्रतियोगितामा आफ्नो नाम लेखाउन अर्कै साइटमा जानुभयो भने उक्त साइटले तपाईंको रुचिका आधारमा तपाईंलाई दौडिँदा लगाइने जुत्ताको विज्ञापन देखाउन सक्छ।</translation>
<translation id="4824940465467423308">तपाईंले व्यवस्थित खातासँगै साइन इन गरि यसको व्यवस्थापकलाई तपाईंको FlyWeb प्रोफाइल माथि नियन्त्रण दिइरहनुभएको छ। तपाईंको FlyWeb डाटा, जस्तै तपाईंका एप्स, बुकमार्कहरू, इतिहास, पासवर्डहरू, र अन्य सेटिङहरू <ph name="USER_NAME"/> मा स्थायी रूपमा बाँधिनेछन्। तपाईं यस डाटालाई गूगल खाता ड्यासबोर्ड मार्फत मेटाउन सक्षम हुनुहुनेछ, तर तपाईं यस खातालाई अर्को खातामा संलग्न गर्न सक्षम हुनुहुनेछैन। तपाईंले आफ्नो विद्यमान FlyWeb डाटालाई अलग राख्न वैकल्पिक रूपमा नयाँ प्रोफाइल सिर्जना गर्न सक्नुहुन्छ। <ph name="LEARN_MORE"/></translation>
<translation id="3665070894458449212">तपाईंले एड्रेस बार वा खोज बाकसमा टाइप गर्दा तपाईंलाई सामग्रीसम्बन्धी सुझावहरू देखाउन सकियोस् भन्नाका लागि FlyWeb ले तपाईंले टाइप गर्ने कुरा Google Drive मा पठाउँछ। इन्कोग्निटो मोडमा यो सुविधा अफ हुन्छ।</translation>
<translation id="7390382558747224642">यसलाई निष्क्रिय पारेर, तपाईं FlyWeb मा साइन इन नगरिकनै Gmail जस्ता FlyWeb का साइटहरूमा साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="5714085538350759767">FlyWeb ले कुनै प्रतिक्रिया जनाइरहेको छैन। अहिले नै पुन: लन्च गर्ने?</translation>
<translation id="4035053306113201399">यो अपडेट लागू गर्न ChromeOS रिस्टार्ट गर्नु पर्ने हुन्छ।</translation>
<translation id="3750729306035486751">यस प्रकारको फाइल सामान्यतया डाउनलोड नगरिने र खतरनाक हुन सक्ने भएकाले FlyWeb ले उक्त प्रकारको फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="1953553007165777902">डाउनलोड गरिँदै छ... <ph name="MINUTE"/> मिनेट बाँकी छ</translation>
<translation id="6956650624767954726">FlyWeb ले डिफल्ट ब्राउजर निर्धारण वा सेट गर्न सक्दैन</translation>
<translation id="6495079989036864983">यसले यो डिभाइसको १ वस्तु मेट्नेछ। पछि आफ्नो डेटा प्राप्त गर्न FlyWeb मा <ph name="USER_EMAIL"/> को रूपमा साइन इन गर्नुहोस्।</translation>
<translation id="2018879682492276940">इन्स्टल गर्न सकिएन। कृपया फेरि प्रयास गर्नुहोस्।</translation>
<translation id="4252651275570549255">तपाईंका अन्य पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK"/>FlyWeb मा साइन इन गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="8544477465831682343">FlyWeb का सेवाहरूमा आफ्नो आवश्यकताअनुसारका सुविधाहरू पाउन FlyWeb को ब्राउजिङ इतिहास समावेश गर्ने कि नगर्ने भन्ने कुरा छनौट गर्नुहोस्</translation>
<translation id="8924891216494775926">यो फाइल भ्रामक भएको र यसले तपाईंको डिभाइसमा अनपेक्षित परिवर्तन गर्न सक्ने भएकाले FlyWeb ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="1868972292925460871">FlyWeb ले आफ्ना मूल प्रमाणपत्र कसरी व्यवस्थापन गर्छ भन्ने कुरासम्बन्धी जानकारी</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{FlyWeb १ मिनेटसम्म प्रयोग नगरिएका खण्डमा तपाईंको सङ्गठनले ब्राउजिङ डेटा स्वतः मेटाउँछ। यसअन्तर्गत हिस्ट्री, अटोफिल तथा डाउनलोड समावेश हुन सक्छन्। तपाईंका ट्याबहरू खुलै रहने छन्।}other{FlyWeb # मिनेटसम्म प्रयोग नगरिएका खण्डमा तपाईंको सङ्गठनले ब्राउजिङ डेटा स्वतः मेटाउँछ। यसअन्तर्गत हिस्ट्री, अटोफिल तथा डाउनलोड समावेश हुन सक्छन्। तपाईंका ट्याबहरू खुलै रहने छन्।}}</translation>
<translation id="2126108037660393668">डाउनलोड गरिएको फाइल पुष्टि गर्न सकिएन।</translation>
<translation id="4474394796469499134">यो साइटले सुरक्षित कनेक्सन प्रयोग नगरिरहेको र यो फाइलमा छेडखानी गरिएको हुन सक्ने भएकाले FlyWeb ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="2482315227745493547">तपाईं FlyWeb मेनुबाट बुकमार्क, रिडिङ मोड र अन्य कुराहरू खोल्न सक्नुहुन्छ</translation>
