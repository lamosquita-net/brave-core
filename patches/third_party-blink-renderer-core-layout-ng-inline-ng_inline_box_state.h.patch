+// Represents a ruby column.  This associates NGLogicalLineItems for a ruby-base
+// and NGLogicalLineItems for a ruby-text.
+struct CORE_EXPORT LogicalRubyColumn
+    : public GarbageCollected<LogicalRubyColumn> {
+  // Start index of a ruby-base for the corresponding NGLogicalLineItems.
+  unsigned start_index;
+  // The number of ruby-base items in the corresponding NGLogicalLineItems.
+  unsigned size;
+
+  Member<NGLogicalLineItems> annotation_items;
+
+  // Nested <ruby>s in `annotation_items`.
+  HeapVector<Member<LogicalRubyColumn>> ruby_column_list;
+
+  // `ruby-position` property value.
+  RubyPosition ruby_position = RubyPosition::kBefore;
+
+  void Trace(Visitor* visitor) const;
+  unsigned EndIndex() const { return start_index + size; }
+};
