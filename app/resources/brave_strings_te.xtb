<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1026101648481255140">ఇన్‌స్టలేషన్‌ను కొనసాగించండి</translation>
<translation id="7099479769133613710">&amp;ChromeOSను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="291426170030461697">ఈ ఎక్స్‌టెన్షన్‌ను రివ్యూ చేయమని FlyWeb మీకు సిఫార్సు చేస్తోంది</translation>
<translation id="1549005488226693697">వారి పేజీలో లింక్‌లను ప్రైవేట్‌గా ప్రీ - లోడ్ చేయమని సైట్ కోరినప్పుడు, FlyWeb, FlyWeb సర్వర్‌లను ఉపయోగిస్తుంది. ఇది ప్రీ - లోడ్ చేయబడిన సైట్ నుండి మీ గుర్తింపును దాచిపెడుతుంది, కానీ ఏ సైట్‌లు ప్రీ - లోడ్ అయ్యాయి అనేది Braveకు తెలుస్తుంది.</translation>
<translation id="1065672644894730302">మీ ప్రాధాన్యతలు చదవబడలేవు. కొన్ని లక్షణాలు అందుబాటులో ఉండకపోవచ్చు మరియు ప్రాధాన్యతలకు మార్పులు సేవ్ చేయబడకపోవచ్చు.</translation>
<translation id="8908267645832965492">Braveలో సైట్‌లు, యాప్‌లు, ఎక్స్‌టెన్షన్‌లకు సంబంధించిన అనుమతులను మీ తల్లి/తండ్రి ఆఫ్ చేశారు</translation>
<translation id="5557633153169217776">సమీపంలోని డివైజ్‌లను కనుగొనడానికి, ఉపయోగించడానికి Braveకు మీ లోకల్ నెట్‌వర్క్‌కు యాక్సెస్ అవసరం</translation>
<translation id="6441390163669415879">నిర్దిష్ట FlyWeb ఫీచర్ లేదా ఎక్స్‌టెన్షన్‌ను సెర్చ్ చేయడానికి, అడ్రస్ బార్‌లో దాని షార్ట్‌కట్‌ను టైప్ చేసి, ఆపై మీరు ఎంచుకున్న కీబోర్డ్ కీని టైప్ చేయండి</translation>
<translation id="9001750423919983557">సిస్టమ్ ట్రేలో Braveతో సెర్చ్‌ను చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="1368460307421081773">FlyWeb మీ పాస్‌వర్డ్‌లను ఎగుమతి చేయాలనుకుంటోంది. దీనిని అనుమతించడం కోసం మీ Windows పాస్‌వర్డ్‌ని టైప్ చేయండి.</translation>
<translation id="112640046208448578">వస్తువులను లేదా ప్రదేశాలను గుర్తించండి, టెక్స్ట్‌ను కాపీ చేయండి లేదా అనువదించండి. మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీకి సంబంధించిన స్క్రీన్‌షాట్, సర్వర్‌కు పంపబడుతుంది. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">మీ డిఫాల్ట్ బ్రౌజర్ FlyWeb</translation>
<translation id="4556715463645168547">డేటా ఉల్లంఘనల నుండి, ఇతర భద్రతా సమస్యల నుండి మీ పాస్‌వర్డ్‌లు సురక్షితంగా ఉన్నాయో లేదో చెక్ చేయడానికి, <ph name="BEGIN_LINK"/>Braveకు సైన్ ఇన్ చేయండి<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb మెనూను క్లిక్ చేయండి</translation>
<translation id="1157985233335035034">ఇటీవలి భాషలు</translation>
<translation id="1184145431117212167">మీ Windows వెర్షన్‌ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="4380351562011537903">FlyWeb గురించి</translation>
<translation id="853148447909557566">మీ ఫోన్‌లో Braveతో ధర ట్రాకింగ్ అలర్ట్‌లను పొందండి</translation>
<translation id="1203500561924088507">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME"/>‌ను ఉపయోగించడానికి ముందు మీరు బ్రౌజర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="1232234696885483911">మీరు ఇమేజ్ సెర్చ్‌ను తెరిచినప్పుడు, PDFలతో సహా పేజీ టైటిల్, URL, కంటెంట్ ఆటోమేటిక్‌గా సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">మీరు సైన్ ఇన్ చేసినప్పుడు, Braveలో మీ FlyWeb ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. దీన్ని మార్చడానికి, “Braveలో మీ ఖాతా”కు వెళ్లండి.</translation>
<translation id="7614508617663739435">Mac మెనూ బార్‌లో Braveలో Geminiని చూపండి</translation>
<translation id="832555967476614730">Braveలోని Geminiలో స్క్రీన్ మీద మీకు కావాల్సిన భాగాన్ని ఎంచుకోవడానికి, కీబోర్డ్ షార్ట్‌కట్‌ను ఉపయోగించండి.</translation>
<translation id="4750836834956739196">ఈ ట్యాబ్ ఇన్‌యాక్టివ్‌గా ఉన్నప్పుడు, Braveను వేగంగా ఉంచడానికి మెమరీ ఖాళీ చేయబడింది. మీరు ఏ సమయంలోనైనా ఈ సైట్ ఇన్‌యాక్టివ్‌గా ఉండకుండా మినహాయించడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="3190759351483708314">ఫైల్ ప్రమాదకరంగా ఉన్నందున FlyWeb ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/>‌తో Gmail లేదా YouTube వంటి FlyWeb సర్వీస్‌లకు ఆటోమేటిక్‌గా సైన్ ఇన్ చేస్తున్నప్పుడు, మీరు అదే ఖాతాతో Braveకి సైన్ ఇన్ చేయవచ్చు</translation>
<translation id="7142135954326264349">మీ ఫోన్‌లో Braveను పొందండి</translation>
<translation id="1290883685122687410">సెటప్ ఎర్రర్: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">మీ కొత్త FlyWeb ప్రొఫైల్‍ను సెట్ అప్ చేయండి</translation>
<translation id="5252737639504553444">Braveలో Geminiని ట్రై చేయండి</translation>
<translation id="609743863669742325">బ్లూటూత్ పరికరాలను 
 అన్వేషించడానికి Braveకు బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">మీ ఫోన్‌లో Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="1330562121671411446">భాషను గుర్తించండి</translation>
<translation id="2276527911011636666">FlyWeb (<ph name="URL"/>) నుండి కూడా డేటాను తొలగించండి</translation>
<translation id="1345251407431278948">పిన్ చేశారు! మీరు టూల్‌బార్‌లోని కొత్త బటన్‌ను ఉపయోగించి ఇమేజ్ సెర్చ్‌ను మళ్లీ యాక్సెస్ చేయవచ్చు</translation>
<translation id="1383876407941801731">సెర్చ్</translation>
<translation id="1045149878186896649">ప్రయాణంలోనూ బ్రౌజింగ్‌ను కొనసాగించడానికి FlyWeb యాప్‌ను ఉపయోగించండి</translation>
<translation id="141901961143729572">మీ ఆలోచనలను షేర్ చేయండి</translation>
<translation id="2758515779140515865">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో FlyWeb కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="4713192356155907986">FlyWeb for Testingకు సంబంధించి సహాయాన్ని పొందండి</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> నుండి మీరు సేవ్ చేసిన సమాచారాన్ని, అలాగే మరిన్ని వివరాలను పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="1497802159252041924">ఇన్‌స్టాలేషన్ ఎర్రర్: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ఈ పేజీకి ప్రొటెక్షన్ జోడించబడింది</translation>
<translation id="8962360511570172">FlyWeb ట్యాబ్‌ను షేర్ చేయండి</translation>
<translation id="2941487459666781243">Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="1547469039832541117">హైలైట్ అయిన టాస్క్‌ను ముగిస్తుంది.</translation>
<translation id="3182893868355533457">Braveను పిన్ చేయండి</translation>
<translation id="852852907317361085">FlyWeb భద్రతా టూల్స్</translation>
<translation id="481155564361715417">FlyWeb మీ Password Manager డేటాను తొలగించాలనుకుంటోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="2846999307505917298">మీ ఫోన్‌లోని FlyWeb యాప్‌తో FlyWeb అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="3961251277542681013">Braveలోని ముఖ్య గోప్యతా, సెక్యూరిటీ కంట్రోల్స్‌ను రివ్యూ చేయండి</translation>
<translation id="1640672724030957280">డౌన్‌లోడ్ చేయబడుతోంది...</translation>
<translation id="1665602916345474427">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME"/>‌గా, <ph name="USER_EMAIL"/> ఈమెయిల్‌తో సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="7625232007557474355">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Braveను ఉపయోగించవచ్చు. ఇది మీ టాస్క్‌బార్‌కు కూడా పిన్ చేయబడుతుంది.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> కోసం అదనపు అధికారాలను అందిస్తుంది.</translation>
<translation id="5695205873161614119">FlyWeb త్వరలోనే బ్రౌజింగ్ డేటాను తొలగిస్తుంది</translation>
<translation id="8939535770474283898">FlyWeb నావిగేషన్‌లను HTTPSకి అప్‌గ్రేడ్ చేయడానికి ట్రై చేస్తుంది</translation>
<translation id="2581127533455294937">FlyWeb డేటా తీసేసింది</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/> సమయంలో రీస్టార్ట్ అవుతుంది</translation>
<translation id="6903827847227122616">HTTPS అందుబాటులో లేనప్పుడు, FlyWeb మిమ్మల్ని హెచ్చరించకుండా సురక్షితం కాని కనెక్షన్‌ను ఉపయోగిస్తుంది</translation>
<translation id="307170399141486420">బ్యాక్‌గ్రౌండ్‌లో Braveని అమలు చేయడానికి అనుమతించండి</translation>
<translation id="5006568136491721884">Braveను మీ టాస్క్‌బార్‌కు పిన్ చేసి, దాన్ని ఫాస్ట్‌గా యాక్సెస్ చేసేందుకు, Windows నోటిఫికేషన్‌లో <ph name="BEGIN_BOLD"/>Yes<ph name="END_BOLD"/>ను క్లిక్ చేయండి</translation>
<translation id="2473319786107120819">Braveను మళ్లీ ఇన్‌స్టాల్ చేయి</translation>
<translation id="2533324957407080119"><ph name="AUTHENTICATION_PURPOSE"/> కోసం FlyWeb ట్రై చేస్తోంది</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE"/> నుండి మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="3547283483106013256">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE"/>‌లో Braveను తెరిచినప్పుడు, FlyWeb Password Managerను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="1838374766361614909">శోధనను తీసివేయండి</translation>
<translation id="3403116471618205223">ఈ పరికరం నుండి మాత్రమే బ్రౌజింగ్ డేటాను తొలగించడానికి, దీన్ని మీ FlyWeb ఖాతాలో ఉంచుతూ, <ph name="BEGIN_LINK"/>FlyWeb నుండి సైన్ అవుట్ చేయండి<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">ప్రయాణంలో ఉన్నప్పుడు కొత్త ట్యాబ్ గ్రూప్‌లను తెరవడానికి లేదా క్రియేట్ చేయడానికి మీ ఫోన్‌లో Braveను డౌన్‌లోడ్ చేసుకోండి.</translation>
<translation id="3285741355512747610">మీరు సైన్ ఇన్ చేసిన FlyWeb ఖాతాలను మీరు మేనేజ్ చేయవచ్చు. FlyWeb బ్రౌజర్, Play Store, Gmail, ఇంకా మరిన్నింటి కోసం మీ FlyWeb ఖాతాలు ఉపయోగించబడతాయి. ఫ్యామిలీ మెంబర్ వంటి వారి కోసం మీరు ఖాతాను జోడించాలనుకుంటే, బదులుగా కొత్త వ్యక్తిని మీ <ph name="DEVICE_TYPE"/>కు జోడించండి. <ph name="LINK_BEGIN"/>మరింత తెలుసుకోండి<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయండి</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE"/> నుండి మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1880677175115548835">టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="4824940465467423308">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ FlyWeb ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ FlyWeb డేటా శాశ్వతంగా <ph name="USER_NAME"/>కు అనుబంధించబడుతుంది. మీరు FlyWeb ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. మీరు ప్రస్తుతం ఉన్న మీ FlyWeb డేటాను వేరుగా ఉంచడానికి ఐచ్ఛికంగా కొత్త ప్రొఫైల్‌ను క్రియేట్ చేయవచ్చు. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb బ్యాక్‌గ్రౌండ్ యాక్టివిటీని, స్మూత్ స్క్రోలింగ్, వీడియో ఫ్రేమ్ రేట్‌ల వంటి విజువల్ ఎఫెక్ట్‌లను పరిమితం చేయడం ద్వారా బ్యాటరీ పవర్‌ను ఆదా చేస్తుంది. <ph name="BEGIN_LINK"/>ఎనర్జీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb అప్‌డేటర్ సర్వీస్</translation>
<translation id="7390382558747224642">దీనిని ఆఫ్ చేయడం ద్వారా, మీరు Braveకి సైన్ ఇన్ చేయకుండానే Gmail లాంటి FlyWeb సైట్‌లలో సైన్ ఇన్ చేయగలరు</translation>
<translation id="5714085538350759767">FlyWeb ప్రతిస్పందించడం లేదు. ఇప్పుడు మళ్లీ ప్రారంభించాలా?</translation>
<translation id="5866699689358760578">మీ సంస్థ పాలసీ, <ph name="MANAGER"/> ప్రకారం మీరు Braveకు సైన్ ఇన్ చేయాలి</translation>
<translation id="4035053306113201399">అప్‌డేట్‌ను వర్తింపజేయడానికి ChromeOSను రీస్టార్ట్ చేయాలి.</translation>
<translation id="3750729306035486751">ఫైల్ రకం సాధారణంగా డౌన్‌లోడ్ అవ్వదు, అలాగే ఇది ప్రమాదకరమైనది అయినందున FlyWeb ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1953553007165777902">డౌన్‌లోడ్ అవుతోంది... <ph name="MINUTE"/> నిమిషం(లు) సమయం మిగిలి ఉంది</translation>
<translation id="6956650624767954726">FlyWeb డిఫాల్ట్ బ్రౌజర్‌ను నిశ్చయించలేదు లేదా సెట్ చేయలేదు</translation>
<translation id="197326043290947695">ఇమేజ్ సెర్చ్‌తో స్మార్ట్‌గా బ్రౌజ్ చేయండి</translation>
<translation id="130679046523922050">FlyWeb కొన్ని ఫైళ్లను బ్లాక్ చేసి, కొత్త ట్యాబ్‌లో ఎందుకు తెరుస్తుందో తెలుసుకోండి</translation>
<translation id="8243822903505210769">మీ FlyWeb సాఫ్ట్‌వేర్‌ను అప్‌డేట్‌గా ఉంచుతుంది. ఈ సర్వీస్ డిజేబుల్ చేయబడినా లేదా ఆపివేయబడినా, మీ FlyWeb సాఫ్ట్‌వేర్ అప్‌డేట్ చేసి ఉంచబడదు, అంటే సంభవించే సెక్యూరిటీ లోపాలను పరిష్కరించడం సాధ్యం కాదు, ఫీచర్‌లు పని చేయకపోవచ్చు. FlyWeb సాఫ్ట్‌వేర్ ఉపయోగించనప్పుడు ఈ సర్వీస్ దానికదే అన్‌ఇన్‌స్టాల్ అవుతుంది.</translation>
<translation id="6495079989036864983">ఇది ఈ పరికరం నుండి 1 అంశాన్ని తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Braveకు <ph name="USER_EMAIL"/> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="2018879682492276940">ఇన్‌స్టాల్ చేయడం విఫలమైంది. దయచేసి మళ్లీ ట్రై చేయండి.</translation>
<translation id="2039417478970545937">సెట్టింగ్‌లు.</translation>
<translation id="8544477465831682343">FlyWeb సర్వీస్‌లలో మరింత వ్యక్తిగతీకరించిన అనుభవం కోసం FlyWeb హిస్టరీని చేర్చాలో, లేదో ఎంచుకోండి</translation>
<translation id="328650761750741315">మీరు బలమైన పాస్‌వర్డ్‌లను క్రియేట్ చేయడానికి, సేవ్ చేయడానికి, ఆటోఫిల్ చేయడానికి సాయపడేలా ఇది Braveలో బిల్ట్-ఇన్‌గా వస్తుంది. సులభంగా యాక్సెస్ చేయడానికి షార్ట్‌కట్‌ను జోడించండి.</translation>
<translation id="2407746489237278840">Braveకు కొత్త రూపాన్ని అందించడానికి కొత్త ట్యాబ్ పేజీలో Braveను అనుకూలంగా మార్చండి బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="8924891216494775926">ఫైల్ మోసపూరితమైనది అలాగే మీ పరికరానికి ఊహించని మార్పులు చేసే అవకాశం ఉన్నందున FlyWeb ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="5728214838078602184">మీరు నెక్స్ట్ టైమ్ FlyWeb iOSను తెరిచినప్పుడు, <ph name="FEATURE_NAME"/>‌ను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="2058207584484841616">మీ FlyWeb ఖాతాలో మీరు సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, ఇతర FlyWeb డేటా ఈ డివైజ్ నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Braveలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Braveను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}other{Braveను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}}</translation>
<translation id="2125838419757773031">సెర్చ్ చేయడానికి స్క్రీన్‌పై భాగాన్ని ఎంచుకోండి</translation>
<translation id="2126108037660393668">డౌన్‌లోడ్ చేయబడిన ఫైల్ వెరిఫికేషన్ విఫలమైంది.</translation>
<translation id="2135919691573380097">ఈ సైట్‌ను రిపోర్ట్ చేయండి</translation>
<translation id="2137162749895930932">స్క్రీన్‌ను అనువదించండి అనే ఆప్షన్‌ను మూసివేయండి</translation>
<translation id="2147218225094845757">సైడ్ ప్యానెల్‌ను దాచండి</translation>
<translation id="4474394796469499134">సైట్ సురక్షిత కనెక్షన్‌ను ఉపయోగించని అలాగే ఫైల్ ట్యాంపర్ చేయబడిన కారణంగా FlyWeb ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="2170098639895543546">పేజీలో ఏదైనా ఎంచుకోండి</translation>
<translation id="6765231735885996239">Braveను అనుకూలంగా మార్చండి</translation>
<translation id="2174917724755363426">ఇన్‌స్టాలేషన్ పూర్తి కాలేదు. మీరు ఖచ్చితంగా రద్దు చేయాలనుకుంటున్నారా?</translation>
<translation id="2937508664417729967">FlyWeb - నెట్‌వర్క్ సైన్ ఇన్ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">అప్‌డేట్‌ల కోసం చెక్ చేసేటప్పుడు ఎర్రర్ ఏర్పడింది: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">FlyWeb నుండి ఖాతాను తీసివేయండి</translation>
<translation id="744837314710861405">అత్యుత్తమ షాపింగ్ టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి FlyWeb యాప్‌ను ఉపయోగించండి</translation>
<translation id="2745381939758295588">iOS కోసం Braveలో మెరుగైన సురక్షిత బ్రౌజింగ్‌కు సంబంధించి ప్రయాణంలో సురక్షితంగా ఉండండి</translation>
<translation id="6707114110652917144">హానికరమైన సైట్. FlyWeb నోటిఫికేషన్‌లను తీసివేసింది.</translation>
<translation id="2236949375853147973">నా యాక్టివిటీ</translation>
<translation id="4646732243247482236">Braveకు సైన్ ఇన్ చేసి, మీ పరికరాలన్నింటిలో మీ అడ్రస్‌లను, ఇంకా మరిన్నింటిని పొందండి. మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ అడ్రస్ మీ FlyWeb ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="2726680594710751908">మీరు కంప్యూటర్‌ను షేర్‌ చేస్తే, స్నేహితులు, ఫ్యామిలీ మెంబర్‌లు విడివిడిగా బ్రౌజ్ చేయవచ్చు. Braveను వారికి నచ్చిన రీతిలో సెటప్ చేసుకోవచ్చు.</translation>
<translation id="4086571337340463916">Braveలో స్కిల్స్</translation>
<translation id="2283803047247799269">ఇమేజ్ సెర్చ్‌తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని FlyWeb సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని FlyWeb సిఫార్సు చేస్తుంది}}</translation>
<translation id="2307973900865360088">డాక్‌లో ఉంచండి</translation>
<translation id="5067150284614317159">Braveలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది. ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా FlyWeb, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు.</translation>
<translation id="2356070529366658676">అడుగు</translation>
<translation id="2359808026110333948">కొనసాగించండి</translation>
<translation id="7339360994527471629">ఎక్స్‌టెన్షన్ "<ph name="EXTENSION_NAME"/>" కోసం, మీరు Braveకు సైన్ ఇన్ చేయాలి</translation>
<translation id="8788732221355188962">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Braveను డిజేబుల్ చేయండి</translation>
<translation id="4126251160852694747"><ph name="USER_EMAIL_ADDRESS"/>‌గా ఈ ఎక్స్‌టెన్షన్‌ను ఉపయోగించడానికి, Braveకు సైన్ ఇన్ చేయండి.</translation>
<translation id="8418845734693287262">మీ ఖాతా సైన్ ఇన్ వివరాల గడువు ముగిసినందున ChromeOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ FlyWeb ఎక్స్‌టెన్షన్‌లు 1 HID డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 HID డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ FlyWeb ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ FlyWeb ఎక్స్‌టెన్షన్‌లు # HID డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="1364879203203742966">ఈ సైట్ కోసం Braveకు కెమెరా, ఇంకా మైక్రోఫోన్ అనుమతులు అవసరం</translation>
<translation id="2403703063067034158">స్టార్టప్ ఎర్రర్: ప్రస్తుతం వేరొక సెటప్ రన్ అవుతోంది, దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="656987653252575654">ఏదైనా యాప్ నుండి Braveలో లింక్‌లను తెరవండి, మీ టాస్క్‌బార్‌లో బ్రౌజర్‌ను యాక్సెస్ చేయండి</translation>
<translation id="157662717324308283">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి ఈ డాక్యుమెంట్‌ను Braveలోని Geminiకి షేర్ చేసేందుకు 'సారాంశం' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>FlyWeb నుండి టూల్స్‌<ph name="END_LINK"/>‌తో, మీరు సురక్షితంగా బ్రౌజ్ చేయవచ్చు, కంట్రోల్‌లో ఉండవచ్చు</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="2451727308784734061">Password Managerను త్వరగా చేరుకోవడానికి మీ షార్ట్‌కట్‌ను ఉపయోగించండి. మీరు మీ షార్ట్‌కట్‌ను మీ కంప్యూటర్ మొదటి స్క్రీన్ లేదా యాప్ లాంచర్‌కు తరలించవచ్చు.</translation>
<translation id="3224379053610845181">FlyWeb త్వరలోనే మూసివేయబడుతుంది</translation>
<translation id="3840682988105604367">Braveలో</translation>
<translation id="2485422356828889247">అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="2513154137948333830">రీబూట్ అవసరం: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">ఇమేజ్ సెర్చ్‌ను ఉపయోగించి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="6823116595279840454">FlyWeb ఇప్పటికే ఉన్న పాస్‌వర్డ్‌లను రీప్లేస్ చేయడానికి ట్రై చేస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="2691552788029831386">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Braveకు స్టోరేజ్‌ యాక్సెస్ అవసరం</translation>
<translation id="2275866327478859777">FlyWeb సహాయకం</translation>
<translation id="2575822587468774919">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి</translation>
<translation id="683641781063074351">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="1659167470250249643">Braveను డౌన్‌లోడ్ చేసి, మీ FlyWeb ఖాతాకు సైన్ ఇన్ చేయడానికి మీ ఫోన్‌తో QR కోడ్‌ను స్కాన్ చేయండి.</translation>
<translation id="5353172248151202719">Braveతో సెర్చ్ చేయడానికి.</translation>
<translation id="3231856291920394348">Braveని ఉపయోగించడం కొనసాగించండి</translation>
<translation id="259935314519650377">డౌన్‌లోడ్ చేసిన ఇన్‌స్టాలర్‌ను కాష్ చేయడంలో విఫలమైంది. ఎర్రర్: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">సిస్టమ్</translation>
<translation id="7683745685556117660">మీ సంస్థ మీ బుక్‌మార్క్‌లు, హిస్టరీ, అలాగే పాస్‌వర్డ్‌ల వంటి బ్రౌజింగ్ డేటాను చూడగలదు, మేనేజ్ చేయగలదు. ఇతర FlyWeb ప్రొఫైల్స్‌లోని బ్రౌజింగ్ డేటాను ఇది చూడలేదు</translation>
<translation id="5862783156828836752">మీ ఖాతా <ph name="ACCOUNT_EMAIL"/>‌లో FlyWeb డేటాను ఉపయోగించింది, సేవ్ చేసింది మీరేనని వెరిఫై చేయండి</translation>
<translation id="4450675160413947126">Braveని ప్రారంభించండి</translation>
<translation id="3827993926722004004">ఇన‌స్ట‌లేష‌న్‌ సమయంలో ఆపరేటింగ్ సిస్టమ్ ఎర్ర‌ర్‌ ఏర్పడింది. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="333184635927514678">మీరు ఒక డివైజ్‌ను షేర్ చేస్తే, ఫ్రెండ్స్, ఫ్యామిలీ విడివిడిగా బ్రౌజ్ చేయవచ్చు, Braveను వారికి నచ్చిన విధంగా సెటప్ చేసుకోవచ్చు</translation>
<translation id="3917488635054382918">FlyWeb మినిమైజ్ చేయబడినప్పటికీ, మీ డివైజ్‌లో ఎక్కడి నుండైనా Geminiని సులభంగా యాక్సెస్ చేసి ఉపయోగించుకోండి.</translation>
<translation id="1257705702166647105">FlyWeb ట్యాబ్</translation>
<translation id="2796283369875688710">అదనపు భద్రత కోసం, FlyWeb మీ డేటాను ఎన్‌క్రిప్ట్ చేస్తుంది.</translation>
<translation id="1118215875395945816">FlyWeb నుండి మీ FlyWeb ఖాతాను తీసివేయడానికి, సైన్ అవుట్ చేయండి</translation>
<translation id="3320675843036708646">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="2738871930057338499">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 403 అనుమతి లేదు. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="2753623023919742414">సెర్చ్ చేయడానికి క్లిక్ చేయండి</translation>
<translation id="8027563534376000179">మీ ఆటోమేటిక్ సెట్టింగ్ PDF వ్యూయర్‌గా Braveను సెట్ చేయండి</translation>
<translation id="7907238427168022751">ఈ ఎక్స్‌టెన్షన్‌లో మాల్‌వేర్ ఉంది, ఇది సురక్షితం కాకపోవచ్చు. FlyWeb నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="2799223571221894425">మళ్లీ ప్రారంభించండి</translation>
<translation id="1489590198317876070">మీ FlyWeb</translation>
<translation id="2816462166102338036">ఇమేజ్ సెర్చ్‌తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="6850011743146651977">iOSలోని Braveతో ప్రయాణంలోనూ మీ కెమెరాతో ప్రోడక్ట్‌లను కనుగొనండి, ధరల తగ్గుదలను ట్రాక్ చేయండి, ఇంకా మరెన్నో చేయండి.</translation>
<translation id="2841525013647267359">ఈ భాష నుండి అనువదించండి</translation>
<translation id="2846251086934905009">ఇన్‌స్టాల్ లోపం: ఇన్‌స్టాలర్ ప్రాసెస్‌ను పూర్తి చేయలేదు. ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="1339341044496643931">FlyWeb నుండి తీసివేయండి...</translation>
<translation id="4922993584046885552">Braveలో మిమ్మల్ని సురక్షితంగా ఉంచుతుంది, మీరు సైన్ ఇన్ చేసినప్పుడు ఇతర FlyWeb యాప్‌లలో మీ సెక్యూరిటీని మెరుగుపరచడానికి ఉపయోగించబడవచ్చు</translation>
<translation id="2885378588091291677">విధి సంచాలకులు</translation>
<translation id="3806033752149316261">&amp;FlyWeb గురించి</translation>
<translation id="2915996080311180594">తర్వాత రీస్టార్ట్ చేయండి</translation>
<translation id="3497031519171753772">మీ రహస్య పదబంధంతో మీ డేటా ఎన్‌క్రిప్ట్ అయింది. మీ FlyWeb ఖాతాలో FlyWeb డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి దాన్ని ఎంటర్ చేయండి.</translation>
<translation id="2945997411976714835">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ప్రాసెస్‌ను ప్రారంభించడంలో విఫలమైంది.</translation>
<translation id="1784605133570901105">iOSలో FlyWeb కోసం సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించి సైట్‌లకు వేగంగా సైన్ ఇన్ చేయండి</translation>
<translation id="5383705372991100927">మీ సంస్థ Braveను మేనేజ్ చేస్తుంది</translation>
<translation id="1661079783259785361">FlyWeb తాజాగా ఉంది</translation>
<translation id="5447533789927384736">ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా FlyWeb, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు</translation>
<translation id="3208925917545144893">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3003694935412297923">అన్ని టాస్క్‌లు</translation>
<translation id="1216763100505470452">{count,plural, =1{మీ FlyWeb ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని FlyWeb ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ FlyWeb ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని FlyWeb ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="8404327407921790238"><ph name="URL"/> ను Braveలో కొత్త ట్యాబ్‌లో తెరవండి.</translation>
<translation id="5184501306555415561">స్కిల్స్ వంటి AI ఆవిష్కరణలు మీ FlyWeb ఖాతాలో సేవ్ చేయబడతాయి, FlyWeb సింక్ నుండి విడిగా మేనేజ్ చేయబడతాయి</translation>
<translation id="4409390320695765203">మీ అన్ని డివైజ్‌లలో మీ ఎక్స్‌టెన్షన్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="8841609317523323027">Braveకి జోడిస్తోంది...</translation>
<translation id="3038232873781883849">ఇన్‌స్టాల్ చేయడానికి వేచి ఉంది...</translation>
<translation id="3045032126857188731">అనువదించిన భాష: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ఫీడ్‌బ్యాక్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="2666189940580882376"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE"/> నుండి మీ చదవాల్సిన లిస్ట్‌ను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="4451837224464070850">ఇతర FlyWeb ప్రొఫైల్స్</translation>
<translation id="4351369660845291597">ఎక్స్‌టెన్షన్‌లు అనేవి Braveను అనుకూలంగా మార్చడానికి మిమ్మల్ని అనుమతించే యాడ్-ఆన్‌లు. ఆర్గనైజ్డ్‌గా ఉండటం నుండి రోజువారీ టాస్క్‌లను సులభతరం చేయడం వరకు, Braveను మీ స్వంతం చేసుకోవడంలో ఎక్స్‌టెన్షన్‌లు మీకు సహాయపడతాయి.</translation>
<translation id="7859502023458300952">Braveకు వినియోగ గణాంకాలు, <ph name="UMA_LINK"/>ను పంపడం ద్వారా Braveను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="1125501479713660011">ప్రయాణంలోనూ FlyWeb భద్రతను పొందడానికి FlyWeb యాప్‌ను ఉపయోగించండి</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ FlyWeb ఎక్స్‌టెన్షన్‌లు 1 USB డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 USB డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ FlyWeb ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ FlyWeb ఎక్స్‌టెన్షన్‌లు # USB డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="6017373390117959211"><ph name="DEVICE"/> నుండి మీ చదవాల్సిన లిస్ట్‌ను, మరిన్నింటిని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="7898392424469957829">FlyWeb హిస్టరీ</translation>
<translation id="1407857531570256859">ఇన్‌స్టాలర్ ఆర్కైవ్‌ను వాస్తవ పరిమాణానికి తీసుకుని రావడంలో విఫలమైంది. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="310459126943037700">టాస్క్(లు) ముగించడంలో విఫలమైంది.</translation>
<translation id="3104828284009500087">పేజీలో ఏదైనా సెర్చ్ చేయండి</translation>
<translation id="4706932464498663870">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Braveకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి.</translation>
<translation id="1309738977648134943">FlyWeb మీ మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3130333203120345554">కొత్త సెర్చ్</translation>
<translation id="3137969841538672700">సెర్చ్ చేయడానికి ఇమేజ్‌లో కొంత భాగాన్ని ఎంచుకోండి</translation>
<translation id="2251813826843049011">ఈ ట్యాబ్ అదనపు రిసోర్స్‌లను ఉపయోగిస్తోంది. మీ పనితీరును మెరుగుపరచడానికి, దాన్ని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Braveకు అనుమతినివ్వండి.</translation>
<translation id="2664701271733223256">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో FlyWeb కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="6274649779206195384">Braveను పునఃప్రారంభించండి</translation>
<translation id="3161522574479303604">అన్ని భాషలు</translation>
<translation id="6773570808762718524">మీ కొత్త FlyWeb ప్రొఫైల్‌ను అనుకూలంగా మార్చుకోండి</translation>
<translation id="8965010907836433875">మీరు ట్యాబ్‌లను మార్చకుండానే AI మోడ్‌తో చాట్ చేయవచ్చు. ప్రారంభించడానికి, Braveకు సైన్ ఇన్ చేయండి. మీ డివైజ్‌లన్నిటిలో మీ పాస్‌వర్డ్‌లు, మరిన్ని ప్రయోజనాలను కూడా పొందుతారు.</translation>
<translation id="5958835776851191812">FlyWeb నుండి మీ FlyWeb ఖాతాను తీసివేయడానికి, సెట్టింగ్‌ల పేజీలోని FlyWeb నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="4217346567895356023">తర్వాత, మీ కోసం ఫారమ్‌లను ఆటోఫిల్ చేయడానికి సేవ్ చేసిన సమాచారాన్ని ఉపయోగించాలనుకుంటున్నారా అని FlyWeb అడగవచ్చు</translation>
<translation id="5449297306961970452">FlyWeb దీని డేటా డైరెక్టరీని చదవలేదు మరియు దీనిలో రాయ‌లేదు: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">iOSలోని Braveతో మీకు నచ్చిన FlyWeb AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="8090118570458552025"><ph name="DEVICE"/> నుండి మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3286538390144397061">ఇప్పుడు పునఃప్రారంభించండి</translation>
<translation id="3900612994249740104">FlyWeb API కీలు లేవు. FlyWeb కార్యాచరణలో కొంత భాగం నిలిపివేయబడుతుంది.</translation>
<translation id="6824575001009586492">FlyWeb మూసివేయబడినప్పుడు నేపథ్య యాప్‌లను అమలు చేయడాన్ని కొనసాగించండి</translation>
<translation id="2595215790271940091">సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి ఏదైనా సైట్‌ను లోడ్ చేసే ముందు FlyWeb మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="3701353923785984059">మీరు Braveకు సైన్ ఇన్ చేసినట్లయితే, FlyWeb విండోలన్నింటినీ మూసివేసినప్పుడు, మీ FlyWeb ఖాతా మినహా, దాదాపుగా సైట్‌లన్నింటి నుండి సైన్ అవుట్ అవుతారు. మిమ్మల్ని సైట్‌లు గుర్తుంచుకోవడానికి, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">సెర్చ్ ఏరియాకు ఎగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT"/>%, ఎగువ <ph name="TOP"/>%</translation>
<translation id="8629055140319079166">మీ ఖాతాలోని FlyWeb డేటా</translation>
<translation id="1943161457314845496">మీ ఫోన్‌లో Braveతో మీ పాస్‌వర్డ్‌లను ఉపయోగించండి</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">ప్రస్తుతం ఉన్న FlyWeb ప్రొఫైల్‌కు స్విచ్ చేయాలా?</translation>
<translation id="3412460710772753638">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌లో</translation>
<translation id="1568435374218487057"><ph name="DEVICE"/> నుండి మీ బుక్‌మార్క్‌లను, మరిన్నింటిని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3438772217992559640">"ఇమేజ్ సెర్చ్‌"తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="6301354573631022693">మీ ఫోన్‌లో Braveతో మెరుగైన సురక్షిత బ్రౌజింగ్‌ను విస్తరించండి</translation>
<translation id="7625477329092296018">మీరు కోరుకున్న విధంగా FlyWeb వ్యక్తిగతీకరించబడుతోంది...</translation>
<translation id="956833467923764542">ఇది ఈ పరికరం నుండి <ph name="ITEMS_COUNT"/> అంశాలను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Braveకు <ph name="USER_EMAIL"/> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> FlyWeb ప్రొఫైళ్ల మధ్య స్విచ్ చేయగలదు</translation>
<translation id="6724485219247982027">దయచేసి అన్ని FlyWeb విండోలను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="5048962017649434283">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో FlyWeb కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/>‌తో ఇప్పటికే సైన్ ఇన్ చేశారు.  మీ బ్రౌజింగ్‌ను ప్రత్యేకంగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>‌గా మీ స్వంత ప్రొఫైల్‌లో Braveకి సైన్ ఇన్ చేయండి.</translation>
<translation id="408747932595284596">మొబైల్ డివైజ్‌లలో FlyWeb బ్రౌజర్‌ను డౌన్‌లోడ్ చేయడానికి QR కోడ్</translation>
<translation id="1413410454753055427">రిమైండర్: FlyWeb అత్యుత్తమ భద్రతా ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="7831730508158736496">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో FlyWeb కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="9006158231572141726">FlyWeb గుర్తించని సైట్‌లకు మెరుగైన రక్షణ JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది</translation>
<translation id="3597003331831379823">అదనపు అధికారాలతో సెటప్‌ను రన్ చేయడం విఫలమైంది. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="6970052268542136081">ఈ వ్యక్తి బ్రౌజింగ్ డేటా‌ ఈ పరికరం నుండి తొలగించబడుతుంది. డేటాను పునరుద్ధరించడానికి, <ph name="USER_EMAIL"/>గా Braveకు సైన్ ఇన్ చేయండి.</translation>
<translation id="3667616615096815454">ఇన్‌స్టాల్ చేయడం సాధ్యపడలేదు, అప్లికేషన్‌ను సర్వర్ గుర్తించలేదు.</translation>
<translation id="2438845157914027912">మీ FlyWeb ఖాతాలో FlyWeb డేటా మొత్తాన్ని ఎన్‌క్రిప్ట్ చేయడానికి మీ <ph name="BEGIN_LINK"/>స్వంత రహస్య పదబంధాన్ని<ph name="END_LINK"/> ఉపయోగించండి. Google Pay నుండి పేమెంట్ ఆప్షన్‌లు, అడ్రస్‌లు ఎన్‌క్రిప్ట్ అవ్వవు. Braveకు చెందిన బ్రౌజింగ్ హిస్టరీ సింక్ అవ్వదు.</translation>
<translation id="6611602069520888180">కొత్త FlyWeb &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="2591356225047803326">వ్యక్తిగతీకరణ, ఇతర ప్రయోజనాల కోసం FlyWeb, ఇతర FlyWeb సర్వీస్‌లను లింక్ చేయండి</translation>
<translation id="3729187154190517324">"ట్యాబ్‌ను, మరిన్నింటిని జోడించండి" బటన్‌ను ఉపయోగించి పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి.</translation>
<translation id="1771882170639856394">FlyWeb ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="3782148374606932577">FlyWeb కొన్ని డౌన్‌లోడ్‌లను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="4640643918757362950">దేనికైనా మీ రివ్యూ అవసరం అయితే, FlyWeb మీకు తెలియజేస్తుంది</translation>
<translation id="2179738813053854729">FlyWeb మీరు చూసే అవకాశం ఉన్న పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని చూసినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="3810973564298564668">మేనేజ్ చేయండి</translation>
<translation id="5026502787439628947">మీరు సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించడానికి, QR కోడ్‌ను ఫాలో అయ్యి, iOSకు సంబంధించిన Braveను డౌన్‌లోడ్ చేసి, ఆపై మీ FlyWeb ఖాతాకు సైన్ ఇన్ చేయండి</translation>
<translation id="3846683726093018685">**సారాంశం:** 30 పదాల కన్నా తక్కువ ఉన్న ఒక వాక్యంలో, స్క్రీన్‌షాట్‌లో ప్రధాన సబ్జెక్ట్, కంటెంట్ ఉద్దేశాన్ని వివరించండి.

          **ప్రశ్నలను సూచించండి:** స్క్రీన్‌షాట్‌ను బాగా అర్థం చేసుకోవడానికి యూజర్ అడగగలిగే ఆలోచనను రేకెత్తించే విధంగా ఉండే 3-5 ప్రశ్నల బుల్లెట్‌లతో కూడిన లిస్ట్‌ను జెనరేట్ చేయండి. ఈ ప్రశ్నలలో కనీసం ఒక విజువల్ ఆబ్జెక్ట్, దాని డిజైన్, లేదా దాని లొకేషన్‌కు సంబంధించి నిర్దిష్టంగా ఒక ప్రశ్న అయినా ఉండాలి.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">మీ డివైజ్‌లన్నింటిలో మీ బుక్‌మార్క్‌లను, మరిన్నింటిని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3885770153807205175">భాష సెలెక్టర్</translation>
<translation id="5175060854726708547">Braveను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. మీరు గమనించాల్సిన విషయం ఒకటి ఉంది - వివరాల కోసం క్లిక్ చేయండి.</translation>
<translation id="606156353708638647">Braveను తెరిచి, బ్రౌజింగ్‌ను ప్రారంభించడానికి మీ పేరును క్లిక్ చేయండి.</translation>
<translation id="3892148308691398805">టెక్స్ట్‌ను కాపీ చేయి</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> ఇప్పటికే ఈ FlyWeb ప్రొఫైల్‌కు సైన్ ఇన్ చేశారు. మీరు బ్రౌజ్ చేసిన వాటిని విడిగా ఉంచడానికి, FlyWeb మీ కోసం మీ సొంత ప్రొఫైల్‌ను క్రియేట్ చేయగలదు.</translation>
<translation id="3941890832296813527">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ఫైల్ పేరు చెల్లదు లేదా సపోర్ట్ చేయదు.</translation>
<translation id="8536259619256229278">పాస్‌వర్డ్‌లను కాపీ చేయడానికి FlyWeb ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="7965008434896274911">మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, ఇంకా మరెన్నో వివరాలను పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="4540773594514226705">మీరు FlyWeb ఖాతాలో సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, పేమెంట్ ఆప్షన్‌లు, ఇంకా అడ్రస్‌లు ఈ పరికరం నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Braveలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="395904275706073188">ప్రొటెక్షన్ ఉన్న పేజీలను రీడ్ చేయడం సాధ్యం కాలేదు. వేరే పేజీని ట్రై చేయండి.</translation>
<translation id="3849784651193576458">FlyWeb మిమ్మల్ని ఎలా సురక్షితంగా ఉంచుతుందో తెలుసుకోండి</translation>
<translation id="3967822245660637423">డౌన్‌లోడ్ పూర్తయింది</translation>
<translation id="562495843857641474">మీరు అడ్రస్ బార్ లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, FlyWeb మీరు టైప్ చేసే దాన్ని మీ సంస్థకు సంబంధించిన సెర్చ్, AI, ఇంకా ఏజెంట్ టూల్స్‌కు పంపి, మీకు సూచనలను అందిస్తుంది.</translation>
<translation id="5667414856761616811">&amp;FlyWeb for Testing పరిచయం</translation>
<translation id="1152920704813762236">ChromeOS గురించి</translation>
<translation id="4920206821838432969">మీరు సైట్‌కు వెళ్లినప్పుడు, FlyWeb మీ IP అడ్రస్‌ను దాచిపెట్టే గోప్యతా సర్వర్ ద్వారా URLకు సంబంధించిన గందరగోళానికి గురి చేసే భాగాన్ని <ph name="BEGIN_LINK"/>FlyWeb సురక్షిత బ్రౌజింగ్<ph name="END_LINK"/>కు పంపుతుంది. ఏదైనా సైట్ అనుమానాస్పదంగా ఉంటే, పూర్తి URLలు, పేజీ కంటెంట్‌కు సంబంధించిన బిట్‌లు కూడా పంపబడతాయి.</translation>
<translation id="4016217212818346953">Password Managerతో సురక్షితంగా ఉండండి</translation>
<translation id="3703994572283698466">ChromeOS అనేది <ph name="BEGIN_LINK_LINUX_OSS"/>Linux డెవలప్‌మెంట్ ఎన్విరాన్‌మెంట్<ph name="END_LINK_LINUX_OSS"/> తరహాలోనే, అదనపు <ph name="BEGIN_LINK_CROS_OSS"/>ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS"/> ద్వారా సాధ్యమైంది.</translation>
<translation id="4022972681110646219">స్క్రీన్‌ను అనువదించండి</translation>
<translation id="4023601594785368013">అసలు భాష: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">ఏదైనా యాప్ నుండి Braveలో లింక్‌లను తెరవండి. అలాగే సులభంగా యాక్సెస్ చేయడానికి, అది మీ టాస్క్‌బార్‌కు పిన్ అవుతుంది.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>ప్రస్తుత సెట్టింగ్‌లను<ph name="END_LINK"/> రిపోర్ట్ చేయడం ద్వారా Braveను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="4050175100176540509">ముఖ్యమైన భద్రతా మెరుగుదలలు మరియు కొత్త ఫీచర్‌లు తాజా వెర్షన్‌లో అందుబాటులో ఉన్నాయి.</translation>
<translation id="4055805654398742145">Password Manager</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Braveను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}other{Braveను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}}</translation>
<translation id="4105099155797156500">FlyWeb పేజీ వివరాలకు వెళ్లండి</translation>
<translation id="7753744564324413106">మీ బ్రౌజర్‌కు కొత్త రూపాన్ని అందించడానికి Braveను అనుకూలంగా మార్చండి</translation>
<translation id="3202882878525816493">మీ Braveను అనుకూలంగా మార్చండి</translation>
<translation id="4148957013307229264">వ్యవస్థాపిస్తోంది...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - నెట్‌వర్క్ సైన్ ఇన్ - FlyWeb</translation>
<translation id="6368928751841546993"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ చదవాల్సిన లిస్ట్‌ను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="4007949387571083162">FlyWeb కోసం గొప్ప యాప్‌లు, ఆటలు, ఎక్స్‌టెన్షన్‌లు మరియు థీమ్‌లను కనుగొనండి.</translation>
<translation id="4753212377237684548">మీ కంప్యూటర్‌లన్నింటిలో ఈ ఎక్స్‌టెన్షన్‌తో పాటు మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="4391959806766569994">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, మీరు ఇప్పటికే <ph name="USER_EMAIL_ADDRESS"/>‌గా సైన్ ఇన్ చేసిన మీ FlyWeb ప్రొఫైల్‌కు మారండి</translation>
<translation id="4222932583846282852">రద్దు చేస్తోంది...</translation>
<translation id="4224210481850767180">ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="2564888740660198776">మీ FlyWeb డేటాను ఈ ఖాతాకు జోడించాలా?</translation>
<translation id="7337819873931851298">స్టాండర్డ్ రక్షణ కంటే ఎక్కువగా సైట్‌లలోని డేటాను విశ్లేషించి, Braveకు మనుపెన్నడూ తెలియని ప్రమాదకరమైన సైట్‌ల గురించి కూడా ఇది హెచ్చరిస్తుంది. FlyWeb హెచ్చరికలను స్కిప్ చేయడానికి మీరు ఎంచుకోవచ్చు.</translation>
<translation id="8391959103619318249">FlyWeb నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="8514458758262040082">FlyWeb గురించి సహాయాన్ని పొందండి</translation>
<translation id="4281844954008187215">సర్వీస్ నియమాలు</translation>
<translation id="3393587701694585022">పేర్కొనబడని ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది. ప్రస్తుతం FlyWeb అమలు చేయబడుతుంటే, దయచేసి దీనిని మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="271336227467646058">FlyWeb నుండి పాస్‌వర్డ్‌లను ఎగుమతి చేయండి</translation>
<translation id="4304713468139749426">పాస్‌వర్డ్ మేనేజర్</translation>
<translation id="4334241893986177674">ఈ స్క్రీన్‌షాట్ కోసం సెర్చ్ చేయండి</translation>
<translation id="125418423241058931">Windows ప్రారంభమైనప్పుడు Braveను ప్రారంభించండి</translation>
<translation id="4400772909124543403">అప్‌డేట్ ఏదీ అందుబాటులో లేదు</translation>
<translation id="1376968889000878095">ఏదేమైనా FlyWeb నుండి నిష్క్రమించాలా?</translation>
<translation id="4413205837991854510">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="6360389033094512399">బ్యాక్‌గ్రౌండ్‌లో అమలయ్యేందుకు Braveని అనుమతించండి</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా FlyWeb సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK"/>సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/>}other{మీరు వాటిని తీసివేయవలసిందిగా FlyWeb సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK"/>సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">Braveను అనుకూలంగా మార్చండి మరియు నియంత్రించండి</translation>
<translation id="4427306783828095590">ఫిషింగ్, అలాగే మాల్‌వేర్‌ను బ్లాక్ చేయడానికి మెరుగుపరచిన రక్షణ మరింత చేయగలదు</translation>
<translation id="4434353761996769206">ఇన్‌స్టాలర్ ఎర్రర్: <ph name="INSTALLER_ERROR"/></translation>
<translation id="1198322798411238228"><ph name="MANAGER"/>, Braveను మేనేజ్ చేస్తుంది</translation>
<translation id="6643422079097100220">FlyWeb ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="8791209382165811772">FlyWeb for Testing పరిచయం</translation>
<translation id="5651107152880556886">మీ FlyWeb ఖాతాలోని FlyWeb డేటాను ఉపయోగించడానికి, అందులో డేటాను సేవ్ చేయడానికి, మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="4493028449971051158">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా రన్ చేయండి.</translation>
<translation id="4501471624619070934">ఈ దేశంలో యాక్సెస్ పరిమితం చేయబడినందున ఇన్‌స్టలేషన్ విఫలమైంది.</translation>
<translation id="3546782282376530369">ఈ ఎక్స్‌టెన్షన్ అది డేటాను ఎలా సేకరిస్తుంది, దాన్ని ఎలా ఉపయోగిస్తుంది వంటి గోప్యతా పద్ధతులను పబ్లిష్ చేయలేదు. మీరు దాన్ని తీసివేయవలసిందిగా FlyWeb సిఫార్సు చేస్తోంది.</translation>
<translation id="834808339160590901">Braveకు స్వాగతం; కొత్త బ్రౌజర్ విండో తెరవబడింది</translation>
<translation id="5094033276783634414">మీ పరిసరాలను మ్యాప్ చేయడానికి, మీ చేతి సంజ్ఞలు అలాగే కదలికలను ట్రాక్ చేయడానికి Braveకి అనుమతి అవసరం</translation>
<translation id="3363095592946520579">మీరు ఇప్పటికే మరొక FlyWeb ప్రొఫైల్‌లో <ph name="USER_EMAIL_ADDRESS"/>‌గా సైన్ ఇన్ చేశారు</translation>
<translation id="8767255662414713095">FlyWeb పేజీలను ప్రీ - లోడ్ చేస్తుంది, దీని వల్ల బ్రౌజింగ్, సెర్చింగ్ త్వరగా అవుతుంది. <ph name="BEGIN_LINK"/>ప్రీ - లోడ్ పేజీల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">మీరు హానికరమని భావించే సైట్‌ను రిపోర్ట్ చేసినప్పుడు అందరికీ ఆన్‌లైన్ భద్రతను మెరుగుపరచండి.</translation>
<translation id="5891777644455025808">మీరు సురక్షిత బ్రౌజింగ్‌ను ఆఫ్ చేశారు అలాగే ఫైల్‌ను వెరిఫై చేయడం సాధ్యం కానందున FlyWeb ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="8775108347138515815">మీ ఫోన్‌లో Braveతో Google Lensను ట్రై చేయండి</translation>
<translation id="4594305310729380060">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌కు</translation>
<translation id="3349475100979552835">FlyWeb యాప్‌లు</translation>
<translation id="4598116752460667024">లిస్ట్ నుండి ఏదైనా ప్రాసెస్ కోసం సెర్చ్ చేయండి.</translation>
<translation id="4970880042055371251">ChromeOS వెర్షన్</translation>
<translation id="1936188352112244665">దాదాపుగా నవీకృతంగా ఉంది! అప్‌డేట్‌ను పూర్తి చేయడానికి Braveని పునఃప్రారంభించండి.</translation>
<translation id="7657326395720709145">Braveకు చెందిన V8 ఇంజిన్, వెబ్‌సైట్లను స్పీడ్‌గా లోడ్ చేస్తుంది. అయితే సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో తక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="7966026667528388481">Braveతో Searchను ఓపెన్ చేయండి</translation>
<translation id="7949810958067850297">FlyWeb ప్రొఫైల్</translation>
<translation id="2962574118577609024">మీరు FlyWeb వినియోగ రిపోర్ట్‌లను కూడా షేర్ చేస్తున్నట్లయితే, ఆ రిపోర్ట్‌లలో మీరు సందర్శించే URLలు ఉంటాయి</translation>
<translation id="4673710618874938871">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME"/>‌గా సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="9219132550163437762">ఈ ప్రొఫైల్‌ను మరొక కంప్యూటర్ (<ph name="HOST_NAME"/>)లో మరో FlyWeb ప్రాసెస్ (<ph name="PROCESS_ID"/>) ఉపయోగిస్తున్నట్లు కనిపిస్తోంది. FlyWeb ప్రొఫైల్‌ను లాక్ చేసినందున అది పాడవదు. ఈ ప్రొఫైల్‌ను వేరే ప్రాసెస్‌లు ఏవీ ఉపయోగించడం లేదని మీకు ఖచ్చితంగా తెలిస్తే, ప్రొఫైల్‌ను అన్‌లాక్ చేసి Braveను మళ్లీ ప్రారంభించవచ్చు.</translation>
<translation id="4680828127924988555">ఇన్‌స్టాలేషన్‌ను రద్దు చేయండి</translation>
<translation id="6156840135417578237">మీ FlyWeb డేటాలో కొంత భాగం ఇంకా మీ FlyWeb ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="1474749355173247622">మీరు సైన్ ఇన్ చేసినప్పుడు, Braveలో మీ FlyWeb ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. <ph name="SHORTCUT"/> మీ FlyWeb సర్వీస్‌ల సెట్టింగ్‌లను మార్చగలదు.</translation>
<translation id="5227023869666757348">ఒకరు ఈ కంప్యూటర్‌లో మునుపు <ph name="ACCOUNT_EMAIL_LAST"/> లాగా Braveకు సైన్ ఇన్ చేశారు. దయచేసి మీ సమాచారాన్ని విడిగా ఉంచేందుకు కొత్త FlyWeb వినియోగదారును క్రియేట్ చేయండి.</translation>
<translation id="4724676981607797757">సపోర్ట్ చేయని ప్రోటోకాల్ ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="1671154647029930623">ఏదేమైనా Braveని మూసివేయాలా?</translation>
<translation id="4143239505982500022">Braveకి సంబంధించిన ప్రత్యేక భద్రతా అప్‌డేట్ వర్తింపజేయబడింది. ఇప్పుడే పునఃప్రారంభించండి, మేము మీ ట్యాబ్‌లను పునరుద్ధరిస్తాము.</translation>
<translation id="82292346243148940">మీరు ఇటీవల వెళ్లలేదు. FlyWeb <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, మరో <ph name="COUNT"/>‌ను తీసివేసింది.</translation>
<translation id="1802926274661855018">Braveలో Gemini తెరిచి ఉంటే, కొత్త ట్యాబ్‌లను క్రియేట్ చేసేటప్పుడు సైడ్ ప్యానెల్ తెరిచి ఉంటుంది</translation>
<translation id="3469649164996417993">FlyWeb Searchలో ఉపయోగించే స్పెల్ చెకర్‌నే ఇది ఉపయోగిస్తుంది. మీరు బ్రౌజర్‌లో టైప్ చేసే టెక్స్ట్‌ను Braveకు పంపుతుంది. ఈ ఆప్షన్‌ను తర్వాత ఎప్పుడైనా మీరు సెట్టింగ్‌లలో మార్చవచ్చు.</translation>
<translation id="7460496601839821581">ఖాతా లేకుండా Braveను ఉపయోగించండి</translation>
<translation id="2991144524835127379">mDNS ట్రాఫిక్‌ను అనుమతించడానికి FlyWeb ఇన్‌బౌండ్ నియమం.</translation>
<translation id="6208903184719035736">&amp;Braveను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4918086044614829423">ఆమోదించు</translation>
<translation id="4918844574251943176">ఇమేజ్ కాపీ చేయబడింది</translation>
<translation id="5477235053075501816">మీ డివైజ్‌లన్నింటిలో మీ చదవాల్సిన లిస్ట్‌ను, మరిన్నింటిని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="7174589544844983914">FlyWeb నేపథ్య మోడ్‌లో ఉంది.</translation>
<translation id="9212977598552218412">క్లిక్ చేసి, FlyWeb సైన్ ఇన్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="8366169706197332122">FlyWeb ప్రొఫైళ్లతో, మీ FlyWeb సంబంధిత అంశాలన్నింటినీ విభజించవచ్చు. ఫ్రెండ్స్, ఫ్యామిలీ కోసం ప్రొఫైళ్లను క్రియేట్ చేయండి, లేదా ఆఫీస్, వినోదం మధ్య ప్రొఫైళ్లను విభజించి ఉపయోగించండి.</translation>
<translation id="7792628702371319769">గెస్ట్‌లు ఎటువంటి హిస్టరీని వదలకుండానే Braveను ఉపయోగించవచ్చు.</translation>
<translation id="7370618680298767482">Braveలో మీ ఖాతా</translation>
<translation id="2760069255902967585">Braveకు మిమ్మల్ని జోడించుకోండి</translation>
<translation id="504699503110800016">ఓవర్‌ఫ్లో మెనూను ఓపెన్ చేయండి</translation>
<translation id="6686344057006524628">మీ <ph name="DEVICE_TYPE"/>‌లో Braveతో మీకు ఇష్టమైన FlyWeb ఫీచర్‌లన్నింటినీ యాక్సెస్ చేయండి</translation>
<translation id="2515109138500267971">FlyWeb మీ హ్యాండ్స్‌ను ట్రాక్ చేయడానికి అనుమతి అవసరం</translation>
<translation id="3910606758302645363">మీరు ఇటీవల వెళ్లలేదు. FlyWeb <ph name="PERMISSION_1"/>,‌ <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>ను తీసివేసింది.</translation>
<translation id="5174969993834422967">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, మీ లొకేషన్ బార్ కుడి మూలన ఉన్న నోటిఫికేషన్ చిహ్నాన్ని క్లిక్ చేయండి.</translation>
<translation id="5174983315706567306">తగినంత డిస్క్ స్పేస్ లేదు.</translation>
<translation id="4326845160190496236">FlyWeb ఖాతాకు మళ్లీ ప్రామాణీకరణ అనసరమవుతుంది</translation>
<translation id="3540715470656277664">iOSలో Braveతో మీరు ఎక్కడ ఆపారో అక్కడి నుండే కొనసాగించండి.</translation>
<translation id="291933003154435191">FlyWeb నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="5234764350956374838">తొలగించండి</translation>
<translation id="9098587825736815971">ప్రయాణంలో పాస్‌వర్డ్‌లను సేవ్ చేయడానికి FlyWeb యాప్‌ను పొందండి</translation>
<translation id="8295539942024823191">మీ మార్పులను వర్తింపజేయడానికి, Braveని పునఃప్రారంభించండి</translation>
<translation id="5286907366254680517">గుర్తించబడింది</translation>
<translation id="626007313130236514">FlyWeb యాప్‌ను పొందండి</translation>
<translation id="5361365805808004630">Braveతో సెర్చ్ చేయండి</translation>
<translation id="8888283148421206435">FlyWeb అప్‌డేటర్ ఇంటర్నల్ సర్వీస్</translation>
<translation id="3025882852178035952">Braveలో ఇతర Gemini ఫీచర్‌లతో పాటు వాటిని ఉపయోగించండి</translation>
<translation id="5346389065299425353">పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి</translation>
<translation id="8330248712705246714">ఈ డాక్యుమెంట్ క్విక్ ఓవర్‌వ్యూను పొందండి, Braveలో Geminiతో ప్రశ్నలు అడగండి</translation>
<translation id="6178233095056047786">FlyWeb మీ రివ్యూ కోసం కొన్ని భద్రతా సిఫార్సులను కనుగొంది</translation>
<translation id="8980390875915032396">ఇతర FlyWeb ప్రొఫైల్స్</translation>
<translation id="2441009746272048284">మీ ఖాతా సైన్-ఇన్ వివరాలు అవుట్-ఆఫ్-డేట్ అయినందున (కాలం చెల్లినందున), ChromeOS మీ FlyWeb ఖాతాలో FlyWeb డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="8449603408481238073">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ FlyWeb ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ FlyWeb డేటా శాశ్వతంగా <ph name="USER_NAME"/>కు అనుబంధించబడుతుంది. మీరు FlyWeb ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">అదనపు కోడ్: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">వ్యక్తిగతీకరణను పొందడానికి, వెబ్ &amp; యాప్ యాక్టివిటీలో Braveను చేర్చండి</translation>
<translation id="1456957080321742545">Braveతో సెర్చ్‌ను ఓపెన్ చేయండి</translation>
<translation id="1026219128963768190">FlyWeb కొన్ని ఫైల్స్‌ను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="1284798564810038820">FlyWeb నవీకరించబడుతోంది (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="4384293746734222420"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="3872448231555118416">FlyWeb సైన్-ఇన్‌ని అనుమతించండి</translation>
<translation id="1827750898515917134">FlyWeb నుండి తీసివేయండి</translation>
<translation id="7460715011003906078">పనితీరును తగ్గిస్తుంది, కానీ FlyWeb, సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో ఎక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="5020755920249060562">Braveను మీ డిఫాల్ట్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb బీటా</translation>
<translation id="1842654828911709974">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని FlyWeb సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని FlyWeb సిఫార్సు చేస్తుంది}}</translation>
<translation id="5385202369020319636">Braveకు ఇక ఈ Linux డిస్ట్రిబ్యూషన్‌లో సపోర్ట్ లేనందున అది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="362367838300880777">ఈ డౌన్‌లోడ్‌ను FlyWeb బ్లాక్ చేసింది, ఎందుకంటే మీ వ్యక్తిగత, సోషల్ నెట్‌వర్క్ ఖాతాలకు ఆ ఫైల్ హాని కలిగించగలదు</translation>
<translation id="2183749398075655200">దయచేసి FlyWeb తాజా సిస్టమ్ అప్‌డేట్‌లను ఇన్‌స్టాల్ చేస్తున్నప్పుడు వేచి ఉండండి.</translation>
<translation id="8996657165865563765">పాస్‌వర్డ్‌లను ఎడిట్ చేయడానికి FlyWeb ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="832204641669191126">Braveతో ప్రయాణంలోనూ Google Drive, YouTube వంటి మీకు ఇష్టమైన యాప్‌లను అవాంతరాలు లేకుండా సులభంగా ఉపయోగించుకోండి.</translation>
<translation id="5524890928877629608">సెర్చ్ ఏరియాకు ఎగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT"/>%, ఎగువ <ph name="TOP"/>%</translation>
<translation id="5738298079259740925">Braveలో PDFలను తెరవండి</translation>
<translation id="5536164441519929134">ఈ ట్యాబ్ గురించి<ph name="LINE_BREAK"/>అడగండి</translation>
<translation id="6197315294677032380">సెక్యూరిటీ కోసం, మీరు మొదటిసారి సైట్‌ను సందర్శించినప్పుడు FlyWeb, JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది.

ఈ పేజీ ఆశించిన విధంగా పని చేయకపోతే, ఆప్టిమైజేషన్‌ను అనుమతించడానికి ట్రై చేయండి.</translation>
<translation id="2009834183541338014">Mac మెనూ బార్‌లో Braveలో Geminiని కనిపించేలా చేసి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="1307223624786767430"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE"/> నుండి సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5579324208890605088">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా కాకుండా ఒక సాధారణ యూజర్‌గా రన్ చేయండి.</translation>
<translation id="4770353132265458564">పిన్ అయ్యేలా చేయడానికి ఆటోమేటిక్‌గా Braveను ఉపయోగించండి</translation>
<translation id="5596627076506792578">మరిన్ని ఆప్షన్‌లు</translation>
<translation id="5605834417512968703">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="5618818588972826921">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా టెక్స్ట్ లేదా ఇమేజ్‌ను ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="6096945112863785306">{0,plural, =0{ఒక FlyWeb అప్‌డేట్ అందుబాటులో ఉంది}=1{ఒక FlyWeb అప్‌డేట్ అందుబాటులో ఉంది}other{ఒక FlyWeb అప్‌డేట్ # రోజులుగా అందుబాటులో ఉంది}}</translation>
<translation id="7698117871740446964">మీరు Braveను మూసివేసినప్పుడల్లా మీ పరికరంలోని సైట్ డేటాను తొలగించండి</translation>
<translation id="5666891644992637849">దయచేసి ఇప్పుడు Braveను మళ్ళీ ప్రారంభించండి</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Braveను ఈ భాషలో ప్రదర్శించు</translation>
<translation id="569897634095159764">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. ప్రాక్సీ సర్వర్ ప్రామాణీకరణ కోరుతోంది.</translation>
<translation id="5406894461513282158">FlyWeb ఇన్‌యాక్టివ్ ట్యాబ్‌ల నుండి మెమరీని ఖాళీ చేస్తుంది. దీని ద్వారా యాక్టివ్ ట్యాబ్‌లకు, ఇతర యాప్‌లకు మరిన్ని కంప్యూటర్ రిసోర్స్‌లు లభిస్తాయి, దీనితో FlyWeb వేగంగా పని చేస్తుంది. మీ ఇన్‌యాక్టివ్ ట్యాబ్‌లకు మీరు తిరిగి వచ్చినప్పుడు, అవి ఆటోమేటిక్‌గా మళ్లీ యాక్టివ్‌గా మారతాయి. <ph name="BEGIN_LINK"/>మెమరీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="4909672456103357452">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, మీ ఖాతాలోని FlyWeb డేటాను <ph name="SETTINGS_LINK"/></translation>
<translation id="4985665094509307744">Braveను అనుకూలంగా మార్చండి, కంట్రోల్ చేయండి. Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి.</translation>
<translation id="6646499372922411025">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసుకోవడం ద్వారా, మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి.</translation>
<translation id="5809516625706423866">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 401 అనధికార యాక్సెస్. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="5890196138054330443">FlyWeb V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ FlyWeb అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆఫ్ చేయబడింది.</translation>
<translation id="8651664269417935890">మీ FlyWeb ఖాతాలో FlyWeb డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, Braveను అప్‌డేట్ చేయండి</translation>
<translation id="5824893331272123205">ఈ ప్యానెల్‌ను లోడ్ చేయడం సాధ్యపడలేదు, మళ్లీ ట్రై చేయండి</translation>
<translation id="8331941171144629807">Braveకు స్వాగతం</translation>
<translation id="5831968418530309689">FlyWeb అత్యంత శక్తివంతమైన రక్షణలను అందించడానికి అదనపు ఫీచర్‌లను ఆన్ చేస్తుంది</translation>
<translation id="5871205389137001634">ఇమేజ్ సెర్చ్‌ నుండి ఎగ్జిట్ అవ్వడానికి క్లిక్ చేయండి</translation>
<translation id="7581082856615467651">ఈ ఐటెమ్‌లు మాల్‌వేర్‌ను కలిగి ఉన్నట్టుగా FlyWeb కనుగొన్నది:</translation>
<translation id="8117102597407263352">మీ బ్రౌజర్ సెట్టింగ్‌లు అత్యంత సురక్షితంగా ఉండేలా చూసుకోవడానికి FlyWeb క్రమం తప్పకుండా చెక్ చేస్తూ ఉంటుంది. దేనికైనా మీ రివ్యూ అవసరం అయితే, మేము మీకు తెలియజేస్తాము.</translation>
<translation id="5895138241574237353">మళ్ళీ ప్రారంభించండి</translation>
<translation id="7740963625398321937">Braveలో Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - నెట్‌వర్క్ సైన్ ఇన్</translation>
<translation id="5924017743176219022">ఇంటర్నెట్‌కు కనెక్ట్ చేస్తోంది...</translation>
<translation id="5941711191222866238">కనిష్టీకరించు</translation>
<translation id="6669708050135513710">మీ పరికరాలన్నింటిలో ఈ బుక్‌మార్క్‌తో పాటు మరిన్ని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3358004031263458708">Braveను మీకు నచ్చినట్లు సెటప్ చేయండి</translation>
<translation id="5960071705175224773">మీ సెట్టింగ్‌లు తెలియని యాప్ ద్వారా మార్చబడ్డాయి</translation>
<translation id="5977420883993828287">పిన్ చేశారు! టూల్‌బార్ నుండి సందర్భోచితమైన టాస్క్‌లను మళ్లీ ఉపయోగించండి</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Braveను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}other{Braveను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}}</translation>
<translation id="4955869506208896934">సింక్‌ను ప్రారంభించడానికి Braveను అప్‌డేట్ చేయండి</translation>
<translation id="5990360079535151574">టూల్‌బార్‌లోని "సందర్భోచితమైన టాస్క్‌లు" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="6003112304606738118">డౌన్‌లోడ్ అవుతోంది... <ph name="HOURS"/> గంట(లు) సమయం మిగిలి ఉంది</translation>
<translation id="6009821354356307391">అదనపు క్వెరీని అడగండి</translation>
<translation id="6040143037577758943">మూసివేయండి</translation>
<translation id="4530644097272078700">మీ <ph name="DEVICE_TYPE"/>‌లో FlyWeb యాప్‌ను ఉపయోగించినప్పుడు, ఆన్‌లైన్ షాపింగ్‌లో మరిన్ని ప్రయోజనాలను పొందండి</translation>
<translation id="619330138913595431">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Braveకు అనుమతినివ్వండి. నోటిఫికేషన్‌లు అందుతూనే ఉంటాయి.</translation>
<translation id="8714139918792771260">&amp;Braveలో తెరవండి</translation>
<translation id="6069027071882229820">ఇమేజ్‌గా కాపీ చేయండి</translation>
<translation id="499541338626558192">Braveకు <ph name="EXTENSION_NAME"/> జోడించబడింది</translation>
<translation id="5880307616068888895">Braveను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. అప్‌డేట్ అందుబాటులో ఉంది.</translation>
<translation id="1429530657225981960">ఆన్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో FlyWeb వెరిఫై చేయలేదు</translation>
<translation id="8056369489402655495">Braveలో మీ ఖాతా</translation>
<translation id="1683225514126450592">FlyWeb టూల్‌బార్‌లో యాక్సెస్ రిక్వెస్ట్‌లను చూపడానికి ఎక్స్‌టెన్షన్‌ను అనుమతించండి</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> హానికరం, కావున FlyWeb దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="1773252983747911987">FlyWeb త్వరలోనే మూసివేయబడుతుంది, డేటా తొలగించబడుతుంది</translation>
<translation id="1686760912855738719">మీరు ఇక్కడ FlyWeb ప్రొఫైళ్ల మధ్య స్విచ్ అవ్వవచ్చు</translation>
<translation id="5461795497268691356">మీరు కుక్కీలను అనుమతిస్తే, ప్రీ - లోడ్ చేసేటప్పుడు FlyWeb వాటిని ఉపయోగించవచ్చు</translation>
<translation id="6165508094623778733">మరింత తెలుసుకోండి</translation>
<translation id="1292852397592425449">మీ ఖాతాలో FlyWeb డేటాను క్లియర్ చేయండి</translation>
<translation id="7031783851441272920">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు<ph name="LINE_BREAK"/>మీరు పాస్‌వర్డ్‌ను అందించినట్లయితే FlyWeb మీ కోసం ఈ డౌన్‌లోడ్‌ను చెక్ చేస్తుంది. ఫైల్ గురించిన సమాచారం FlyWeb సురక్షిత బ్రౌజింగ్‌కు పంపబడుతుంది, అయితే ఫైల్ కంటెంట్, పాస్‌వర్డ్ మీ పరికరంలో ఉంటాయి.</translation>
<translation id="6182736845697986886">అప్‌డేట్ సర్వర్ అంతర్గత ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="4403968929742079769">మీ <ph name="TARGET_DEVICE_NAME"/>లో మీరు Braveకు సైన్ ఇన్ చేశారని నిర్ధారించుకుని, ఆపై మళ్లీ పంపడానికి ట్రై చేయండి.</translation>
<translation id="8345188246355148375">FlyWeb మినిమైజ్ అయి ఉన్నా, ఎక్కడి నుండైనా సెర్చ్ చేయవచ్చు, ప్రశ్నలు అడగవచ్చు. Braveను బ్యాక్‌గ్రౌండ్‌లో రన్ చేయడానికి అనుమతిస్తుంది.</translation>
<translation id="1855179706668101462">ఈ కంప్యూటర్‌లో ఇప్పటికే మరింత తాజాదైన FlyWeb వెర్షన్ ఉంది. సాఫ్ట్‌వేర్ పని చేయకపోతే, దయచేసి Braveను అన్ఇన్‌స్టాల్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb ఇప్పుడు తిరిగి ప్రారంభించబడుతుంది}=1{1 సెకనులో FlyWeb తిరిగి ప్రారంభించబడుతుంది}other{# సెకన్లలో FlyWeb తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="2586408713760853791">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Braveకు స్టోరేజ్ యాక్సెస్‌కు సంబంధించిన అనుమతి అవసరం</translation>
<translation id="1603558835003845196">Braveలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది</translation>
<translation id="5751080530525677552">Braveను డిఫాల్ట్ బ్రౌజర్‌గా చేయి</translation>
<translation id="6248988683584659830">సెర్చ్ సెట్టింగ్‌లు</translation>
<translation id="6342238100521499844">మీ ఫోన్‌లోని FlyWeb యాప్‌తో, ప్రయాణంలోనూ FlyWeb అత్యుత్తమ సేఫ్టీ ఫీచర్‌లను పొందండి</translation>
<translation id="3542157007113577464">FlyWeb నుండి సైన్ అవుట్ చేయాలా?</translation>
<translation id="2166321493116256664">ఈ ట్యాబ్‌లు అదనపు రిసోర్స్‌లను ఉపయోగిస్తున్నాయి. మీ పనితీరును మెరుగుపరచడానికి, వాటిని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Braveకు అనుమతినివ్వండి.</translation>
<translation id="3794967601634523398">మీ FlyWeb ప్రొఫైల్‌ను అనుకూలంగా మార్చండి</translation>
<translation id="6475001900959697061">మీ FlyWeb ప్రొఫైల్‌కు పేరు పెట్టండి</translation>
<translation id="6356094940346377065">ఒక ఎక్స్‌టెన్షన్ మీరు Braveకి సైన్ ఇన్ చేయాల్సిందిగా కోరుతోంది</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> హానికరం కావచ్చు, కావున FlyWeb దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="5523868569707953059">FlyWeb మీ కెమెరాను ఉపయోగిస్తోంది.</translation>
<translation id="8226838065217375546">Braveలో మరొక వ్యవస్థాపన జరుగుతోంది. దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="6063700568539132984">ఇప్పుడు మీ FlyWeb ఖాతాతో, షేర్ చేయ‌బ‌డిన కంప్యూట‌ర్‌ల‌లో Braveను సులభంగా ఉపయోగించవచ్చు.</translation>
<translation id="5622088198573179705">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే, విశ్వసించే ఫీచర్‌లకు యాక్సెస్‌ను సులభంగా పొందండి.</translation>
<translation id="4709797814274745581">FlyWeb షార్ట్‌కట్</translation>
<translation id="6595693843242836271">ఫైల్ సాధారణంగా డౌన్‌లోడ్ అవ్వని, అలాగే ఇది ప్రమాదకరమైనది అయినందున FlyWeb ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="6890209090736444656">మీరు ఖచ్చితంగా Braveను అన్ఇన్‌స్టాల్ చేయాలనుకుంటున్నారా?</translation>
<translation id="6375219077595103062">Password Managerకు షార్ట్‌కట్‌ను జోడించండి</translation>
<translation id="6388799252195623474">ఈ విషయంలో నాకు సహాయం కావాలి</translation>
<translation id="8407518452288816185">కొనసాగించడానికి, Braveకి <ph name="EMAIL"/>‌తో సైన్ ఇన్ చేయండి. ఇది మీ సంస్థకు సంబంధించిన పాలసీలను మీరు పొందారని నిర్ధారిస్తుంది.</translation>
<translation id="2104550252781001709">కంప్యూటర్ స్క్రీన్‌లో FlyWeb లోగో.</translation>
<translation id="6636986997730784876">FlyWeb అనేది మెరుపు వేగంతో వెబ్‌పేజీలను మరియు యాప్‌ల‌ను అమలు చేసే వెబ్ బ్రౌజర్. ఇది వేగవంతమైనది, స్థిరమైనది మరియు ఉపయోగించడానికి సులభమైనది. Braveలో రూపొందించిన మాల్‌వేర్‌ మరియు ఫిషింగ్ రక్షణతో మరింత సురక్షితంగా వెబ్‌లో బ్రౌజ్ చేయండి.</translation>
<translation id="4359872290500912570">మీరు మీ FlyWeb ఖాతాలో FlyWeb డేటాను ఎల్లప్పుడూ ఉపయోగించగలరని, సేవ్ చేయగలరని నిర్ధారించుకోవడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="3141715584864891679">FlyWeb మరింత వేగంగా పని చేస్తుంది, JavaScriptను ఉపయోగించే ఫీచర్‌లు డిజైన్ చేసిన విధంగానే పని చేస్తాయి</translation>
<translation id="6436260184216827876">ఇమేజ్ సెర్చ్ అందుబాటులో లేదు. తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="2139300032719313227">ChromeOSను రీస్టార్ట్ చేయండి</translation>
<translation id="7560906925528428585">FlyWeb మీరు సందర్శించే అవకాశం ఉన్న ఇంకా మరిన్ని పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని సందర్శించినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="5806916401157869650">ధరలను ట్రాక్ చేయడానికి, ఏదైనా సైట్‌లో ధర తగ్గినప్పుడు అలర్ట్‌లను పొందడానికి మీ ఫోన్‌లో Braveను డౌన్‌లోడ్ చేసుకోండి</translation>
<translation id="2970877059928503461">ఆఫ్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో FlyWeb వెరిఫై చేయలేదు</translation>
<translation id="173462352822069427">FlyWeb ప్రొఫైళ్లకు స్వాగతం</translation>
<translation id="8914008746092110409">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE"/>‌లో Braveను తెరిచినప్పుడు, ట్యాబ్ గ్రూప్‌లను ఉపయోగించమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="3484308111967198595">FlyWeb నుండి ఖాతాను తీసివేయండి</translation>
<translation id="1474676525193357364">ఇది మీరు Braveని ప్రారంభించేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="648319183876919572">ప్రమాదకరమైన వెబ్‌సైట్‌ల నుండి, డౌన్‌లోడ్‌ల నుండి మెరుగైన సురక్షిత బ్రౌజింగ్ మీకు మరింత రక్షణను అందిస్తుంది</translation>
<translation id="5777905264835557372">Braveను అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="764623543427374554">షార్ట్‌కట్‌లు Braveలో తెరవబడతాయి</translation>
<translation id="8852057261917278552">Braveను <ph name="TIMEOUT_DURATION"/> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది. బ్రౌజింగ్ డేటా తొలగించబడింది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="8592211619057897362">ప్రతి ప్రొఫైల్‌లో బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు లాంటి దాని సొంత FlyWeb సమాచారం ఉంటుంది</translation>
<translation id="6556755379298048869">కీబోర్డ్ షార్ట్‌కట్‌తో సెర్చ్ చేయండి.</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb మీ డేటాను ఎలా ప్రైవేట్‌గా ఉంచుతుంది<ph name="END_LINK"/> అనే దాని గురించి మరింత తెలుసుకోండి</translation>
<translation id="654107331777480705">FlyWeb రీస్టార్ట్ అయిన తర్వాత ఈ సెట్టింగ్‌కు మార్పులు వర్తింపజేయడం జరుగుతుంది.</translation>
<translation id="3594828538355548672">FlyWeb ప్రధాన మెనూలోని ఎక్స్‌టెన్షన్‌లను క్లిక్ చేయడం ద్వారా మీ ఎక్స్‌టెన్షన్‌లను మేనేజ్ చేయండి.</translation>
<translation id="7489092380688543560">మీరు మరొక FlyWeb ప్రొఫైల్‌కు మారి, పాస్‌వర్డ్‌లను చూడవచ్చు</translation>
<translation id="472958395762114471">అత్యుత్తమ AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి FlyWeb యాప్‌ను ఉపయోగించండి</translation>
<translation id="8243012192239086369">అక్షరక్రమ లోపాలను పరిష్కరించడానికి, మీరు వచన ఫీల్డ్‌లలో టైప్ చేసే వచనాన్ని, FlyWeb Braveకు పంపుతుంది</translation>
<translation id="3927263773110604886">FlyWeb నోటిఫికేషన్ సెట్టింగ్‌లకు వెళ్లు</translation>
<translation id="6600016381025017075">ఈ పేజీలో దేన్నైనా సెర్చ్ చేయండి</translation>
<translation id="6888846095017247017">మీ మార్పులు మీరు Braveని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="4481788155537463533">Windows ప్రారంభమైనప్పుడు FlyWeb ఇప్పుడు ప్రారంభమవుతుంది, కాబట్టి మీరు తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించవచ్చు. మీరు దీన్ని సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="1116311888485102603">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: FlyWeb మీ చివరి సెషన్ నుండి మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. మీరు వీటిలో ఆఫ్ చేయవచ్చు</translation>
<translation id="1886169834787876002">మీ పరిసరాల 3D మ్యాప్‌ను క్రియేట్ చేయడానికి Braveకు కెమెరా అనుమతి అవసరం</translation>
<translation id="7570986009744020649">మీ బుక్‌మార్క్‌లను FlyWeb ఖాతాలో కూడా సేవ్ చేస్తే, మీరు Braveలో ప్రోడక్ట్ ధరలను ట్రాక్ చేయవచ్చు, ధర తగ్గినప్పుడు తెలియజేయబడుతుంది</translation>
<translation id="6676384891291319759">ఇంటర్నెట్‌ను యాక్సెస్ చేయండి</translation>
<translation id="1363996462118479832">సైన్ ఇన్ చేయడంలో ఎర్రర్ ఏర్పడినందున ChromeOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="5743696427773796626">FlyWeb నుండి ఈ యాప్ డేటాను తీసివేయండి</translation>
<translation id="4152880912192471857">ఈ సైట్ కోసం Braveకు మైక్రోఫోన్ అనుమతి అవసరం</translation>
<translation id="6712881677154121168">డౌన్‌లోడ్ చేయడంలో ఎర్రర్ ఏర్పడింది: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">మీ ప్రొఫైల్, కొత్త FlyWeb వెర్షన్‌కు చెందినది కాబట్టి, దీనిని ఉపయోగించడం సాధ్యపడదు.

కొన్ని ఫీచర్‌లు అందుబాటులో ఉండకపోవచ్చు. దయచేసి వేరొక ప్రొఫైల్ డైరెక్టరీని పేర్కొనండి లేదా FlyWeb యొక్క కొత్త వెర్షన్‌ను ఉపయోగించండి.</translation>
<translation id="5528558621229392814">వ్యక్తిగతీకరణను, ఇతర ఫీచర్‌లను పొందడానికి, Braveను 'వెబ్ &amp; యాప్ యాక్టివిటీ'లో, లింక్ అయిన FlyWeb సర్వీస్‌లలో చేర్చండి</translation>
<translation id="7728046102681268859">మీ కంప్యూటర్‌లోని వినియోగదారులందరికీ FlyWeb ఇప్పటికే ఇన్‌స్టాల్ చేయబడింది.</translation>
<translation id="2006421382007321898">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ బుక్‌మార్క్ మీ FlyWeb ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="4328426102261301637">FlyWeb V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ FlyWeb అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆన్ చేయబడింది.</translation>
<translation id="207175655966839154">{count,plural, =1{మీ FlyWeb డేటాలో కొంత భాగం, ఇంకా మీ FlyWeb ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ FlyWeb డేటాలో కొంత భాగం, ఇంకా మీ FlyWeb ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="1292831930742306370">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు, కాబట్టి దీనిని స్కాన్ చేయమని FlyWeb సిఫార్సు చేస్తోంది.</translation>
<translation id="1547295885616600893">ChromeOS అనేది అదనపు <ph name="BEGIN_LINK_CROS_OSS"/>ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS"/> ద్వారా సాధ్యమైంది.</translation>
<translation id="6831043979455480757">అనువదించు</translation>
<translation id="6432682256389755533">మీ పాస్‌వర్డ్‌లు ఎప్పుడైనా హ్యాక్ అయితే, FlyWeb మీకు తెలియచేస్తుంది</translation>
<translation id="684888714667046800">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. మీరు ఫైర్‌వాల్‌ను ఉపయోగిస్తుంటే, దయచేసి <ph name="PRODUCT_EXE_NAME"/> వైట్‌లిస్ట్‌లో ఉందని నిర్ధారించుకోండి.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">కొనసాగించడానికి ట్యాబ్ చేయండి</translation>
<translation id="6862030660799253820">ఇమేజ్ సెర్చ్‌తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="6869568587896659271">అడ్రస్ బార్ కింద వెబ్‌సైట్‌లకు సులభమైన యాక్సెస్</translation>
<translation id="4695676871328690599">"<ph name="EXTENSION_NAME"/>"లో మాల్‌వేర్ ఉన్నట్టుగా FlyWeb కనుగొన్నది</translation>
<translation id="6877155553248388166">సెర్చ్ ఏరియాకు దిగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT"/>%, దిగువ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">కాపీ చేయండి</translation>
<translation id="6898028264630240901">మీరు బ్రౌజ్ చేస్తున్నప్పుడు సులభంగా ప్రశ్నలు అడిగేందుకు సందర్భోచితమైన టాస్క్‌లను పిన్ చేయవచ్చు</translation>
<translation id="8416061171168102237">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, దానిని మీ టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="3503126745419877918">&amp;FlyWeb ప్రొఫైల్స్‌ను మేనేజ్ చేయండి</translation>
<translation id="4397299252625349918">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS"/>
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAK"/>
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ అవుతాయి
            <ph name="LINE_BREAK"/>
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAK"/>
            • FlyWeb షార్ట్‌కట్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAKS"/>
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="2640214066670118583">మీరు FlyWeb పరిమితి అయిన <ph name="BOOKMARK_LIMIT"/> బుక్‌మార్క్‌లను చేరుకున్నారు, కాబట్టి మీ బుక్‌మార్క్‌లలో కొన్ని ఇంకా మీ FlyWeb ఖాతాలో సేవ్ కాలేదు.

మీరు కొన్ని బుక్‌మార్క్‌లను తొలగించే వరకు మీ ఖాతాలో కొత్త బుక్‌మార్క్‌లను సేవ్ చేయడం సాధ్యపడదు. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, సేవ్ చేయని బుక్‌మార్క్‌లు తొలగించబడతాయి.</translation>
<translation id="6965382102122355670">సరే</translation>
<translation id="3453763134178591239">ChromeOS నియమాలు</translation>
<translation id="1163386134146281359">మీ ఖాతా <ph name="ACCOUNT_EMAIL"/>‌లో FlyWeb డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="7011190694940573312">ఈ వెర్షన్ ఆపరేటింగ్ సిస్టమ్ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="7024536598735240744">డెవలపర్ మోడ్‌లో ఉన్న ఎర్రర్: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">Braveను మీకు నచ్చిన విధంగా తయారు చేసుకోండి</translation>
<translation id="7047386856539490735">ఈ ఫలితాలు ఉపయోగకరంగా ఉన్నాయా?</translation>
<translation id="3945284827084409390">Braveను అప్‌డేట్ చేయి</translation>
<translation id="7886270027101123253">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి FlyWeb ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Braveకు పంపబడతాయి.</translation>
<translation id="8434939140421950539">మీ <ph name="DEVICE_TYPE"/>‌లో FlyWeb యాప్‌ను ఉపయోగించి AI సామర్థ్యాలను పొందండి</translation>
<translation id="2647329478963461727">మీ ఫోన్‌లోని FlyWeb యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="5695394421048248926">FlyWeb for Testingను అనుకూలంగా మార్చండి</translation>
<translation id="6802544479988856975">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Braveను ఉపయోగించవచ్చు</translation>
<translation id="8694083743003679818">FlyWeb నుండి <ph name="EXTENSION_NAME"/>‌ను తీసివేయండి</translation>
<translation id="6017914745388312119">FlyWeb డేటాను <ph name="TIMEOUT_DURATION"/> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని తొలగిస్తుంది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="3283953248242339756">ఈ సైట్ కోసం Braveకు కెమెరా అనుమతి అవసరం</translation>
<translation id="4729674580260824908">Braveను ప్రారంభించడం సాధ్యపడలేదు. మళ్లీ ట్రై చేయండి.</translation>
<translation id="805403942934515799">Braveలో Geminiతో, మీరు ఎక్కడ ఉన్నా సరే, ఏదైనా అడగండి</translation>
<translation id="7093403858436459499">Braveను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని మీ డాక్‌లో ఉంచుకోండి</translation>
<translation id="935820624106805690">మీరు మెసేజ్‌లలో, డాక్యుమెంట్‌లలో, ఇంకా ఇతర యాప్‌లలో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Braveను ఉపయోగించండి</translation>
<translation id="7216228761061470870">మీరు డెస్క్‌టాప్‌లో ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీ టైటిల్, URL, అలాగే PDFలతో సహా అందులోని కంటెంట్ అంతా సర్వర్‌కు వెళుతుంది.</translation>
<translation id="1678436729108859736">విధి నిర్వాహకుడు - FlyWeb</translation>
<translation id="7587087358591725059">ఇతర యాప్‌లు లేదా ఫైల్స్ వంటి FlyWeb వెలుపల ఉన్న కంటెంట్ గురించి అడగండి</translation>
<translation id="7013534648688018698"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="4889865510625659193">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించండి: Windows ప్రారంభమైనప్పుడు FlyWeb ఇప్పుడు ప్రారంభించబడుతుంది.</translation>
<translation id="7274695763216404502">పిన్ చేశారు! టూల్‌బార్ నుండి ఇమేజ్ సెర్చ్‌ను మళ్లీ ఉపయోగించండి</translation>
<translation id="7288567540154601580">ట్యాబ్‌లు, ఎక్స్‌టెన్షన్‌లు</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా FlyWeb సిఫార్సు చేస్తోంది}other{మీరు వాటిని తీసివేయవలసిందిగా FlyWeb సిఫార్సు చేస్తోంది}}</translation>
<translation id="5321339461210685340">సిస్టమ్ ఆడియోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లను తెరిచి, FlyWeb కోసం 'సిస్టమ్ ఆడియో రికార్డింగ్ మాత్రమే'ను అనుమతించండి. ఆపై మీరు Braveను రీస్టార్ట్ చేయాలి.</translation>
<translation id="7299899569525778554">డెస్క్‌టాప్ నుండి సెర్చ్ చేయండి</translation>
<translation id="2866611433272355726">Braveని అప్‌డేట్ చేస్తోంది</translation>
<translation id="5013690772358862887">మీ ప్రాధాన్యతల ఫైల్ పాడైంది లేదా చెల్లదు. FlyWeb మీ సెట్టింగ్‌లను పునరుద్ధరించలేకపోయింది.</translation>
<translation id="7324051657739063017">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి మీరు సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="1123144153876435088">మీ వెబ్, బుక్‌మార్క్‌లు మరియు ఇతర FlyWeb అంశాలు ఇక్కడ చూపబడతాయి.</translation>
<translation id="8915041713909379783">మీ రహస్య పదబంధం ఉన్న కొంతమంది మాత్రమే ఎన్‌క్రిప్ట్ చేసిన మీ డేటాను చదవగలరు. రహస్య పదబంధం Braveకు పంపబడదు లేదా Braveలో స్టోర్ అవ్వదు. మీరు మీ రహస్య పదభందాన్ని మర్చిపోతే లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకుంటే, మీరు <ph name="BEGIN_LINK"/>మీ ఖాతాలోని FlyWeb డేటాను తొలగించాల్సి ఉంటుంది<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746"><ph name="TARGET_URL_HOSTNAME"/>ను యాక్సెస్ చేయడం కోసం <ph name="ALTERNATIVE_BROWSER_NAME"/>ను తెరిచే విధంగా Braveను మీ సిస్టమ్ నిర్వాహకుడు కాన్ఫిగర్ చేశారు.</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="7601756527349047847">భవిష్యత్తులో FlyWeb అప్‌డేట్‌లను పొందడానికి, మీకు macOS 13 కానీ, అంతకన్నా లేటెస్ట్ వెర్షన్ కానీ ఉండాలి. ఈ కంప్యూటర్ macOS 12 వెర్షన్‌ను ఉపయోగిస్తోంది.</translation>
<translation id="3916387280110223245">మీరు ఇటీవల వెళ్లలేదు. FlyWeb <ph name="PERMISSION_1"/>,‌ <ph name="PERMISSION_2"/>ను తీసివేసింది.</translation>
<translation id="3313237823190188892">సిస్టమ్ ట్రేలో Braveలో Geminiని చూడండి</translation>
<translation id="7401687852903179959">"ఇమేజ్ సెర్చ్‌"తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="6624551989332401777">FlyWeb ఇప్పుడు మీ ఆటోమేటిక్ బ్రౌజర్</translation>
<translation id="277733508197886564">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ FlyWeb మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. దీన్ని ఆఫ్ చేసి, ఇక్కడికి వెళ్లండి</translation>
<translation id="948152006162936800">Braveకు పాస్‌వర్డ్‌లను దిగుమతి చేయండి</translation>
<translation id="4755314372270379254">1. దిగువున <ph name="BUTTON_LABEL"/> ఆప్షన్‌ను క్లిక్ చేయండి
2. మీ Windows సెట్టింగ్‌లలో <ph name="BUTTON_2"/>‌ను క్లిక్ చేయండి
3. క్విక్ యాక్సెస్ కోసం Braveను మీ టాస్క్‌బార్‌కు పిన్ చేయడానికి, Windows నోటిఫికేషన్‌లో <ph name="BUTTON_3"/>‌ను క్లిక్ చేయండి</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="7450541714075000668">టెక్స్ట్ కాపీ చేయబడింది</translation>
<translation id="7472280958921965834">మైక్రోఫోన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK"/>సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK"/>‌లో Braveకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="2431618580332826398">భవిష్యత్తులో FlyWeb అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 7ను ఉపయోగిస్తోంది.</translation>
<translation id="2154651873647244914">Braveను రీ-లాంచ్ చేయాలా?</translation>
<translation id="3137757192868162370">ప్రస్తుతం అమలు అవుతోన్న అదే FlyWeb వెర్షన్‌ను ఇన్‌స్టాల్ చేయలేరు. దయచేసి Braveను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="3065486555702061722">రిమైండర్: FlyWeb అత్యుత్తమ ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="4027434552262956425">సైట్‌లు బహుశా ఊహించిన విధంగా పని చేస్తాయి. మీరు Braveకు సైన్ ఇన్ చేసినట్లయితే మీ FlyWeb ఖాతా మినహా అన్ని FlyWeb విండోలను మూసివేసినప్పుడు మీరు చాలా సైట్‌ల నుండి సైన్ అవుట్ చేయబడతారు.</translation>
<translation id="4731230085409037950">{0,plural, =1{1 నిమిషంలో FlyWeb తిరిగి ప్రారంభించబడుతుంది}other{# నిమిషాల్లో FlyWeb తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="301074550630080641">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Braveకు అనుమతినివ్వండి.</translation>
<translation id="3930051800510118744">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించడానికి Braveను ఆటోమేటిక్‌గా లాంచ్ చేయండి.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ఇన్‌స్టాలర్</translation>
<translation id="3067364763515000789">FlyWeb మీ కెమెరా మరియు మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="1381291360713116383">FlyWeb ఇప్పుడు మెరుగైంది</translation>
<translation id="3892366519980032442">ఇప్పుడు మీకు Braveలో మరిన్ని ఫీచర్లు అందుబాటులో ఉన్నాయి</translation>
<translation id="7624307931717240213">ఈ సర్వీస్‌ను మెరుగుపరచడానికి మేము సమాచారాన్ని ఉపయోగిస్తాము. గోప్యతా పాలసీని, సర్వీస్ నియమాలను చూడండి.</translation>
<translation id="7649070708921625228">సహాయం</translation>
<translation id="7733015548570443346">FlyWeb యాప్‌ను పొందండి</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="2230101319599356673">FlyWeb మీ డిఫాల్ట్ బ్రౌజర్ కాదు</translation>
<translation id="3243257760331619874">మీ పరికరాల అంతటా Braveను సింక్ చేయండి మరియు వ్యక్తిగతీకరించండి</translation>
<translation id="3836891631266228927">FlyWeb అప్‌డేట్</translation>
<translation id="7362833186911891234">Braveలో మీ వర్క్ సురక్షితంగా ఉంటుంది</translation>
<translation id="7716950018788545737">టాస్క్(లు) ముగిసింది.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/>‌కు సిస్టమ్‌ను ట్రేస్ చేసే సర్వీస్‌లను అందిస్తోంది. ఈ సర్వీస్ డిజేబుల్ అయితే, బ్రౌజర్ ద్వారా క్రియేట్ అయిన పనితీరు ట్రేస్‌లలో కాంటెక్స్ట్ స్విచ్, సిద్ధంగా ఉన్న థ్రెడ్ ఈవెంట్‌ల వంటి సిస్టమ్ అంతటికీ సంబంధించిన ఈవెంట్‌లు ఉండవు.</translation>
<translation id="1549877678317463759">ఇది ఈ పరికరం నుండి మీ బ్రౌజింగ్ డేటాను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Braveకు <ph name="USER_EMAIL"/> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="7747138024166251722">ఇన్‌స్టాలర్ ఒక తాత్కాలిక డైరక్టరీని సృష్టించలేకపోయింది. సాఫ్ట్‌వేర్‌ను ఇన్‌స్టాల్ చేయడానికి దయచేసి ఖాళీ డిస్క్ స్థలం, అనుమతిని చెక్ చేయండి.</translation>
<translation id="104221467268393661">ఆటోమేటిక్‌గా ఉండే FlyWeb రూపానికి రీసెట్ చేయండి</translation>
<translation id="2414061498125565915">Braveలో మీ వర్క్‌ను సురక్షితంగా ఉంచేందుకు, మీరు Braveకు సైన్-ఇన్ చేసినప్పుడు మీ సంస్థ నిర్దిష్ట సమాచారాన్ని చూడగలదు లేదా మేనేజ్ చేయగలదు.</translation>
<translation id="494195283222791090">Braveను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="134973275687829726">Braveను వేగవంతం చేయండి</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">మీ ఇంటర్నెట్ ట్రాఫిక్‌కు యాక్సెస్ ఉన్న వ్యక్తులు మీరు బ్రౌజ్ చేసే సైట్‌లను చూడటం కష్టతరం చేయండి. DNS (డొమైన్ నేమ్ సిస్టమ్)లో సైట్ IP అడ్రస్‌ను చూసేందుకు FlyWeb సురక్షితమైన కనెక్షన్‌ను ఉపయోగిస్తుంది.</translation>
<translation id="7810005234485217901">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు</translation>
<translation id="6059158364953614237">Braveతో దేనిని షేర్ చేయాలో ఎంచుకోండి</translation>
<translation id="8463540467315366872">ఈ పరికరంలో ఇప్పటికే ఈ ఖాతాతో ఒక FlyWeb ప్రొఫైల్ ఉంది</translation>
<translation id="7845233973568007926">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME"/>‌ను ఉపయోగించడానికి ముందు మీరు కంప్యూటర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="3682929584258119691">మీ సెర్చ్ ఇంజిన్ FlyWeb వెలుపల నుండి మార్చబడింది. మిమ్మల్ని రక్షించడానికి, దాని ఒరిజినల్ ఆటోమేటిక్ సెట్టింగ్‌కు FlyWeb దాన్ని రీసెట్ చేసింది. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">Braveకు కొత్త రూపాన్ని అందించడానికి దాన్ని అనుకూలంగా మార్చండి</translation>
<translation id="8611872055947278722">Braveను తాజా వెర్షన్‌కు అప్‌డేట్ చేయడం సాధ్యం కాలేదు, కాబట్టి మీరు కొత్త ఫీచర్‌లు మరియు భద్రతా పరిష్కారాలను పొందడం లేదు.</translation>
<translation id="7872446069773932638">డౌన్‌లోడ్ అవుతోంది... <ph name="SECONDS"/> సెకను(లు) సమయం మిగిలి ఉంది</translation>
<translation id="3999247564452560622">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, <ph name="BEGIN_LINK"/>మీ ఖాతాలోని FlyWeb డేటాను తొలగించండి<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">మీకు అవసరమైనప్పుడల్లా Braveలో Geminiని త్వరగా తెరవండి</translation>
<translation id="6798431672720500005">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="332151924263389003">వీలైనప్పుడు, FlyWeb ఆటోమేటిక్‌గా సురక్షితం కాని కనెక్షన్‌లను HTTPSకు అప్‌గ్రేడ్ చేస్తుంది</translation>
<translation id="3096730275883527801">మీరు <ph name="USER_EMAIL_ADDRESS"/>గా Braveకు సైన్ ఇన్ చేశారు. దయచేసి మళ్లీ సైన్ ఇన్ చేయడానికి ఇదే ఖాతాను ఉపయోగించండి.</translation>
<translation id="7097534420680357688"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు మీ అన్ని డివైజ్‌లలో మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="9017338699075596174">ఇది FlyWeb రెండవ ఇన‌స్ట‌లేష‌న్. దీన్ని మీ డిఫాల్ట్ బ్రౌజర్‌గా చేయడం సాధ్యపడదు.</translation>
<translation id="2888168499066553233">మీ<ph name="DEVICE_TYPE"/>‌లోని FlyWeb యాప్‌తో FlyWeb అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="8004582292198964060">బ్రౌజర్</translation>
<translation id="8010081455002666927">ఆటోమేటిక్ గుర్తింపు</translation>
<translation id="5944585442866020176">ఓసారి Braveకి యాక్సెస్ లభించాక, ఆపై వెబ్‌సైట్‌లకు ఏమైనా యాక్సెస్‌ కావాలంటే అవి మిమ్మల్ని అడగవచ్చు.</translation>
<translation id="4462215250900528778">Braveను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="80471789339884597">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME"/>‌ను ఉపయోగించే ముందు మీరు తప్పకుండా మీ అన్ని బ్రౌజర్‌లను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8054112667659782652">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="8069447462453318634">"టూల్‌బార్‌కు పిన్ చేయండి" ఆప్షన్‌ను ఎంచుకోండి</translation>
<translation id="3685797926747054412">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Braveను డిజేబుల్ చేయండి</translation>
<translation id="80790299200510644">ఇమేజ్ సెర్చ్</translation>
<translation id="8086881907087796310">మీ కంప్యూటర్ కనీస హార్డ్‌వేర్ అవసరాలకు అనుగుణంగా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">ఈ సైట్ కోసం Braveకు లొకేషన్ అనుమతి అవసరం</translation>
<translation id="5289593085778678155">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE"/>‌లో Braveను తెరిచినప్పుడు, ధర ట్రాకింగ్ అలర్ట్‌లను ఎనేబుల్ చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="7635444121786764725">మీ ఫోన్‌లోని FlyWeb యాప్‌తో మీకు నచ్చిన వస్తువుల ధరలు తగ్గినప్పుడు అలర్ట్‌లను పొందండి</translation>
<translation id="8118331347066725040">Lensతో సెర్చ్ చేయడం కోసం ఫీడ్‌బ్యాక్‌ను పంపండి</translation>
<translation id="5770057404954060005">ఇక మీకు నచ్చినట్లుగా FlyWeb</translation>
<translation id="5334309298019785904">మీ డొమైన్ కోసం సింక్ అందుబాటులో లేనందున, ChromeOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="813913629614996137">ప్రారంభిస్తోంది...</translation>
<translation id="6992240065504496864">కీబోర్డ్ షార్ట్‌కట్‌తో Braveలో Geminiని తెరవండి.</translation>
<translation id="6334554715655789744">FlyWeb అదనపు సర్వీస్ నియమాలు</translation>
<translation id="1597323875619800374">ఈ ఫైల్ అపాయకరమైనది, కాబట్టి FlyWeb దీన్ని బ్లాక్ చేసింది.</translation>
<translation id="8177472873527554730">పేజీలో కంటెంట్ కనుగొనడం సాధ్యం కాలేదు</translation>
<translation id="2214224574148863941">మీ ఖాతా, <ph name="USER_EMAIL"/>‌లో FlyWeb డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="820759916613250543">"ఇమేజ్ సెర్చ్‌"తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8221491193165283816">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, ఇక్కడ క్లిక్ చేయండి.</translation>
<translation id="2459467374982542273">మీ కెమెరాను ఉపయోగించడానికి, <ph name="BEGIN_LINK"/>సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK"/>‌లో Braveకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="4749458995158778066">ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో FlyWeb వెరిఫై చేయడం సాధ్యం కాదు, ఇది సురక్షితం కాకపోవచ్చు. FlyWeb నుండి దాన్ని తీసివేయండి, తద్వారా ఇది వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="6756872644564483342">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి FlyWeb ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Braveకు పంపబడతాయి. మీరు దీన్ని ఎప్పుడైనా సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="9179486248398668702">కొత్త ప్రొఫైల్‌లో Braveకి సైన్ ఇన్ చేయాలా?</translation>
<translation id="1470002120352085290"><ph name="EXISTING_USER"/> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>గా మీ స్వంత ప్రొఫైల్‌తో Braveకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE"/> నుండి మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="8901123396574346662">సిస్టమ్ ట్రేలో Braveలో Geminiని చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="9102959605052547519">సురక్షితం కాని సైట్‌లు, డౌన్‌లోడ్‌ల గురించి <ph name="BEGIN_LINK"/>FlyWeb మిమ్మల్ని హెచ్చరిస్తుంది<ph name="END_LINK"/></translation>
<translation id="669999719045196468">మీరు ఇటీవల వెళ్లలేదు. FlyWeb <ph name="PERMISSION"/>‌ను తీసివేసింది.</translation>
<translation id="7136168924180047124">FlyWeb iOS యాప్‌లో మీ కెమెరాతో మీరు చూసే వాటిని షాపింగ్ చేయండి, అనువదించండి, అలాగే గుర్తించండి</translation>
<translation id="867002910715789721">Braveకు <ph name="USER_NAME"/>‌గా సైన్ ఇన్ చేయడానికి QR కోడ్</translation>
<translation id="8313851650939857356">స్టార్టప్ ఎర్రర్: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">Braveను <ph name="TIMEOUT_DURATION"/> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది.</translation>
<translation id="8321888067342493336">ఇమేజ్‌గా సేవ్ చేయండి</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> మునుపు Braveని ఉపయోగించింది</translation>
<translation id="7009033378151348624">Braveలో స్కిల్స్‌ను ఎనేబుల్ చేయండి</translation>
<translation id="338142060986183805">మీ FlyWeb ఖాతా <ph name="ACCOUNT_EMAIL"/>‌లోని FlyWeb డేటాను ఉపయోగించేందుకు Braveను అప్‌డేట్ చేయండి</translation>
<translation id="7408894216012529448">భవిష్యత్తు FlyWeb అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8ను ఉపయోగిస్తోంది.</translation>
<translation id="8362914115861174987">ఈ భాషలోకి అనువదించండి</translation>
<translation id="8367705492654390392">ఏదైనా అడగండి</translation>
<translation id="5020916672477085422">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి. ఈ పాస్‌వర్డ్, మీరు సైన్ ఇన్ చేసిన తర్వాత మీ FlyWeb ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="5417365165109189454">ఆపై మీరు Braveను రీస్టార్ట్ చేయాలి.</translation>
<translation id="4212474799248200893">మీరు దాన్ని తీసివేయవలసిందిగా FlyWeb సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK"/>సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">ఈ ఎక్స్‌టెన్షన్ పబ్లిషింగ్‌ను దాని డెవలపర్ రద్దు చేశారు, ఇది సురక్షితం కాకపోవచ్చు. FlyWeb నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="3669395395617655404">మీ FlyWeb ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు FlyWeb ఇది మీరేనని వెరిఫై చేయాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="5261590792975521002">{0,plural, =1{ఒక రోజులోపు Braveను తిరిగి ప్రారంభించండి}other{# రోజులలోపు Braveను తిరిగి ప్రారంభించండి}}</translation>
<translation id="8438543370129609977">మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించడం ద్వారా, PDFలతో పాటు పేజీ టైటిల్, URL, ఇంకా కంటెంట్ సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">Braveలో ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="3101564993057563365">ఇన్‌స్టాలర్ ఆర్కైవ్ పాడైంది లేదా చెల్లదు. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="5316851838033144902">Braveకు Windows 10 లేదా అంతకంటే ఆధునికమైన వెర్షన్ అవసరం.</translation>
<translation id="6760691951531758781">ఆప్షనల్: Braveకు సమస్య విశ్లేషణ, అలాగే వినియోగ డేటాను ఆటోమేటిక్‌గా పంపడం ద్వారా ChromeOS ఫీచర్‌లను, ఇంకా పనితీరును మెరుగుపరచడంలో సహాయపడండి.</translation>
<translation id="2523037024749170569">మీ FlyWeb ఖాతాలో FlyWeb డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="5989540778099253163">Braveకు సైన్ ఇన్ చేయడానికి ప్రాంప్ట్‌లను చూపిస్తుంది</translation>
<translation id="6852836260419236265">FlyWeb కాలం చెల్లినది</translation>
<translation id="360892078644515524">మీ ఆటోమేటిక్ బ్రౌజర్‌గా Braveను ఎంచుకున్నందుకు ధన్యవాదాలు!</translation>
<translation id="797182360653885317">మీరు వాటిని సేవ్ చేసినప్పుడు FlyWeb మీ పాస్‌వర్డ్‌లను చెక్ చేయగలదు</translation>
<translation id="8525579356836940628">ఇన్‌స్టాలేషన్ ఆగిపోయింది</translation>
<translation id="8340284327429540526">మీ <ph name="DEVICE_TYPE"/>‌లోని FlyWeb యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="7498776423722712116">FlyWeb మీ పాస్‌వర్డ్‌లలో ఒకదానిని పబ్లిక్ డేటా ఉల్లంఘనలో కనుగొంటే హెచ్చరికను పొందండి</translation>
<translation id="8555465886620020932">సర్వీస్ ఎర్రర్: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">కొన్ని FlyWeb ఫీచర్‌లు, ఎక్స్‌టెన్షన్‌లు షార్ట్‌కట్‌లతో వస్తాయి. మీరు వాటిని తిరిగి ఆన్ చేయడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="8556420416730706394">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు; సైడ్ ప్యానెల్‌లో ఎగువున ఉన్న 'పిన్ చేయండి' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="856656450041460113">భాష లిస్ట్‌ను సెర్చ్ చేయండి</translation>
<translation id="5128162742812353891">పలు సంస్థలు Braveను మేనేజ్ చేస్తాయి</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="7129578417724116642">Braveని ప్రారంభిస్తోంది...</translation>
<translation id="8624541899164515475">సెట్టింగ్‌లు, కొత్త ట్యాబ్‌లో తెరుచుకుంటాయి.</translation>
<translation id="5469043671012993003">FlyWeb for Testingను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం సాధ్యపడదు.</translation>
<translation id="3892251159131070138">Braveతో ఎక్కడి నుండైనా సెర్చ్ చేయండి</translation>
<translation id="1514450422236300417">ఇది మీరు Braveను ప్రారంభించేటప్పుడు లేదా ఓమ్నిబాక్స్ నుండి వెతికేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="573490495087487940">ఇది మీ FlyWeb</translation>
<translation id="8712637175834984815">అర్థమైంది</translation>
<translation id="2666961286257416158">Braveకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="8747073452963259673">సెర్చ్ ఏరియాకు దిగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT"/>%, దిగువ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">ఇన్‌స్టలేషన్ ఎర్రర్: మీ నెట్‌వర్క్ అడ్మినిస్ట్రేటర్ ఇన్‌స్టాలేషన్‌ను నిరోధించే గ్రూప్ పాలసీని వర్తింపజేశారు: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">నాకు తర్వాత గుర్తు చేయి</translation>
<translation id="4243214377720481697">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి, FlyWeb లోని Gemini తో ఈ డాక్యుమెంట్‌ను షేర్ చేయండి</translation>
<translation id="6808406663598665473">Braveకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="7022252178852457880">Braveను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="8826492472752484139">“Password Manager”ను క్లిక్ చేయండి</translation>
<translation id="6933858244219479645">ChromeOS సిస్టమ్</translation>
<translation id="1501202286854500367">Braveలో మెనూలు, సెట్టింగ్‌లు, అలర్ట్‌లు, ఇతర టెక్స్ట్‌ను డిస్‌ప్లే చేయడానికి ఈ భాష ఉపయోగించబడుతుంది</translation>
<translation id="8862326446509486874">సిస్టమ్-స్థాయిలో ఇన్‌స్టాల్‌ చేయ‌డానికి మీకు సరైన హక్కులు లేవు. నిర్వాహకుడి లాగా ఇన్‌స్టాలర్‌ను మ‌ళ్లీ రన్ చేయ‌డానికి ప్రయత్నించండి.</translation>
<translation id="2405293075272280413">FlyWeb ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="2096285611267043007">సైన్-ఇన్ చేయడంలో ఎర్రర్ వచ్చింది. అందువల్ల ChromeOS మీ FlyWeb ఖాతాలో FlyWeb డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="9046344742397901138">మీ సంస్థ పాలసీ ప్రకారం మీరు Braveకు సైన్ ఇన్ చేయాలి</translation>
<translation id="4669168852412989042">FlyWeb పాస్‌వర్డ్‌లను చూపడానికి ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="2704405030486981087">FlyWeb ఇకపై మీ ఆటోమేటిక్ బ్రౌజర్‌గా ఉండదు. Braveను ఆటోమేటిక్ బ్రౌజర్‌గా చేయాలా?</translation>
<translation id="1663379621921336006">Braveని అప్‌డేట్ చేయడం సాధ్యం కాదు</translation>
<translation id="8944232836376404813">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS"/>
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ చేయబడతాయి
            <ph name="LINE_BREAK"/>
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ చేయబడతాయి
            <ph name="LINE_BREAK"/>
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAKS"/>
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="188856534838382513">FlyWeb సైట్ షార్ట్‌కట్‌లను చూడండి</translation>
<translation id="543915850302643692">FlyWeb Enterprise లోగో</translation>
<translation id="4417647437359346154">మీ <ph name="DEVICE_TYPE"/>‌లోని FlyWeb యాప్‌తో FlyWeb భద్రతను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="6976267397714240800">మీ ప్రొఫైల్‌ను తెరుస్తున్నప్పుడు ఏదో పొరపాటు జరిగినందున Braveను ప్రారంభించడం సాధ్యపడలేదు. Braveను రీస్టార్ట్ చేయడానికి ట్రై చేయండి.</translation>
<translation id="8952346994182255880">Braveతో సెర్చ్ చేయడానికి లేదా <ph name="BEGIN_LINK"/>సెట్టింగ్స్‌<ph name="END_LINK"/>లో అనుకూలంగా మార్చడానికి</translation>
<translation id="8422308271795251425">FlyWeb ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="519942585686549229">Braveలోని Gemini, మీరు తెరిచిన ట్యాబ్ మధ్య నావిగేట్ చేయడానికి మీ కీబోర్డ్‌ను ఉపయోగించండి.</translation>
<translation id="9018218886431812662">ఇన్‌స్టాలేషన్ పూర్తయింది</translation>
<translation id="5804408305184682593">Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="7410599202980023102">Mac మెనూ బార్‌లో Braveతో సెర్చ్‌ను చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="2138383893834402906">ఈ డౌన్‌లోడ్‌ను FlyWeb బ్లాక్ చేసింది, ఎందుకంటే ఆ ఆర్కైవ్ ఫైల్‌లో మాల్‌వేర్‌ను దాచి ఉంచగల ఇతర ఫైల్స్ ఉన్నాయి</translation>
<translation id="8884768769854521848">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Braveకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి. క్విక్ యాక్సెస్ కోసం FlyWeb మీ టాస్క్‌బార్‌కు పిన్ చేయబడుతుంది.</translation>
<translation id="3668027737318668659">మీ ఫోన్‌లోని FlyWeb యాప్‌తో Braveకు చెందిన అత్యుత్తమ AI టూల్స్‌ను ఉపయోగించుకోండి</translation>
<translation id="1257818515846885633"><ph name="DEVICE"/> నుండి మీ పాస్‌వర్డ్‌లను, మరిన్నింటిని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="7813768067688376455">మీరు ఇతర FlyWeb సర్వీస్‌లకు సైన్ ఇన్ చేసినప్పుడు Braveకి సైన్ ఇన్ చేయండి</translation>
<translation id="8323442969389928559">FlyWeb ఆటోమేటిక్‌గా మూసివేయబడింది</translation>
<translation id="7626272203917389133">FlyWeb కాలం చెల్లినది</translation>
<translation id="1789655708880997767">{0,plural, =1{ఒక గంటలో FlyWeb తిరిగి ప్రారంభించబడుతుంది}other{# గంటల్లో FlyWeb తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="9106236359747881194">సెర్చ్ చేయడానికి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="8970147445441095618">భవిష్యత్తులో FlyWeb అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8.1ను ఉపయోగిస్తోంది.</translation>
<translation id="1208237657860748752">కొత్త FlyWeb &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="911206726377975832">మీ బ్రౌజింగ్ డేటాను కూడా తొలగించాలా?</translation>
<translation id="9134482777260927479">హోమ్‌వర్క్‌లో సహాయం</translation>
<translation id="9148058034647219655">నిష్క్రమించండి</translation>
<translation id="1592415213971909403">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ FlyWeb మీ ట్యాబ్‌లను రీస్టోర్ చేయగలదు. దీన్ని ఆన్ చేయడానికి, వీటికి వెళ్లండి</translation>
<translation id="3926534790663909774"><ph name="TARGET_URL_HOSTNAME"/>‌ను యాక్సెస్ చేయడం కోసం ఒక ప్రత్యామ్నాయ బ్రౌజర్‌ను తెరిచే విధంగా Braveను మీ సిస్టమ్ నిర్వాహకులు కాన్ఫిగర్ చేశారు.</translation>
<translation id="5022081608392609959">&amp;Braveను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Braveను మీకు అనుకూలంగా ఉండే విధంగా వ్యక్తిగతీకరించుకోండి</translation>
<translation id="3410331617397516204">Braveకి ఇప్పుడు Windows XP లేదా Windows Vistaలో మద్దతు లేనందున ఇది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="3613308994653366133">ప్రయాణంలోనూ FlyWeb అత్యుత్తమ భద్రతా ఫీచర్‌లను Braveతో పొందండి.</translation>
<translation id="945522503751344254">ఫీడ్‌బ్యాక్ పంపండి</translation>
<translation id="1127626874097952395">Braveను ఎవరు ఉపయోగిస్తున్నారు?</translation>
<translation id="1626113414414104077">FlyWeb అత్యంత సురక్షితమైన సెక్యూరిటీని పొందండి</translation>
<translation id="983803489796659991">అప్‌డేట్ సర్వర్‌లో అప్లికేషన్ కోసం హ్యాష్ డేటా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="839475718250652248">ఖాతా లేకుండా Braveను ఉపయోగించండి</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">"ఇమేజ్ సెర్చ్‌"తో సెర్చ్ చేయడానికి టెక్స్ట్‌ను లేదా ఇమేజ్‌ను ఎంచుకోండి</translation>
<translation id="7783156808075587495">మీ లొకేషన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK"/>సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK"/>‌లో Braveకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="137466361146087520">Google Chrome బీటా</translation>
<translation id="7535429826459677826">Google Chrome డెవలపర్</translation>
<translation id="6283840329609797763">తెలియ‌ని ఎర్ర‌ర్‌ కారణంగా ఇన‌స్ట‌లేష‌న్‌ విఫలమైంది. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="2725795635123877647">తెలియని మూలాలకు చెందిన ఎక్స్‌టెన్షన్‌లు, యాప్‌లు, రూపాలు మీ పరికరానికి హాని కలిగించవచ్చు. <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> నుండి మాత్రమే వాటిని ఇన్‌స్టాల్ చేయని FlyWeb సిఫార్సు చేస్తోంది</translation>
<translation id="5840822070878669614">FlyWeb వెబ్ స్టోర్‌ను తెరువు</translation>
<translation id="3470813199863172076">ఈ ఎక్స్‌టెన్ష‌న్ FlyWeb వెబ్ స్టోర్ పాలసీని ఉల్లంఘిస్తోంది, ఇది సురక్షితం కాకపోవచ్చు. FlyWeb నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="5382847955032513683">హెచ్చరిక: FlyWeb మీ బ్రౌజింగ్ హిస్టరీను రికార్డ్ చేయకుండా ఎక్స్‌టెన్ష‌న్‌లను నివారించలేదు. ఈ ఎక్స్‌టెన్ష‌న్‌ను అజ్ఞాత మోడ్‌లో డిజేబుల్ చేయడానికి, ఈ ఆప్షన్‌ను రద్దు చేయండి.</translation>
<translation id="543905389684998697">Braveను సురక్షితం చేయడానికి, మేము <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>లో జాబితా చేయబడని మరియు మీకు తెలియకుండానే జోడించబడిన కొన్ని పొడిగింపులను నిలిపివేసాము.</translation>
<translation id="3914570680366033593">Braveని సురక్షితం చేయడానికి, మేము క్రింది పొడిగింపుని నిలిపివేసాము, ఇది <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>లో జాబితా చేయబడలేదు మరియు మీకు తెలియకుండా జోడించబడి ఉండవచ్చు.</translation>
<translation id="2742103213766991703">FlyWeb అజ్ఞా&amp;త విండోలో లింక్‌ని తెరువు</translation>
<translation id="5606966092070089147">లింక్‌ను బ్రేవ్ ప్రైవేట్ విండోలో తెరవండి &amp;</translation>
<translation id="1616978953472841483">FlyWeb అజ్ఞా&amp;త విండోలో లింక్‌ని తెరువు</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{Braveకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది.}=1{Braveకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{Braveకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="8494512118209691256">ఇది బ్రేవ్ నుండి మీ స్థానిక పరికరాలకు, టీవీ లేదా స్పీకర్ వంటివాటికి కంటెంట్‌ను భాగస్వామ్యం చేయడానికి మిమ్మల్ని అనుమతిస్తుంది.</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="6998204082704836463">{COUNT, plural, =0 {అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Braveని మళ్లీ ప్రారంభించాలి — Advanced Protectionకి ఇది అవసరం.} =1 {అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Braveని మళ్లీ ప్రారంభించాలి — Advanced Protectionకి ఇది అవసరం. మీ వ్యక్తిగత విండో తిరిగి ఓపెన్ కాదవుతుంది.} other {అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Braveని మళ్లీ ప్రారంభించాలి — Advanced Protectionకి ఇది అవసరం. మీ # వ్యక్తిగత విండోలు తిరిగి ఓపెన్ కాదవుతాయి.}}</translation>
<translation id="5749154344207139683">గోప్యత మెరుగుపర్చడంలో సహాయపడడానికి ఈ 1 నిమిషం సర్వే చేయండి.</translation>
<translation id="4766381896251401675">మీరు అడ్రస్ బార్‌లో లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, మెరుగైన సూచనలను పొందడానికి FlyWeb మీరు టైప్ చేసిన దానిని మీ ఆటోమేటిక్ సెర్చ్ ఇంజిన్‌కు పంపుతుంది. అజ్ఞాత మోడ్‌లో ఇది ఆఫ్‌లో ఉంటుంది.</translation>
<translation id="2832552148674305108">FlyWeb అజ్ఞాత మోడ్</translation>
<translation id="611606920944085547">అజ్ఞాత మోడ్‌లో బ్రౌజ్ చేస్తున్నప్పుడు, సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి సైట్‌ను లోడ్ చేసే ముందు FlyWeb మిమ్మల్ని హెచ్చరిస్తుంది</translation>
</translationbundle>