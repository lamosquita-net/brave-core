+      return network::mojom::CTLogInfo::LogType::kStaticCTAPI;
+    default:
+      // FlyWeb: upstream has NOTREACHED(); a log type from a newer list must
+      // not crash the browser.
+      return network::mojom::CTLogInfo::LogType::kUnspecified;
+  }
