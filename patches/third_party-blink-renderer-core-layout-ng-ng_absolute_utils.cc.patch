+// FlyWeb: align-self/justify-self for absolutely positioned boxes (Chromium
+// d5e6d59db47c, LayoutAlignForPositioned; engine level 122). Chromium 122
+// does this through the "inset-modified containing block", which 116 does
+// not have; this applies the same rules to the insets/sizes of 116.
+enum class OofAlignmentBias { kStart, kCenter, kEnd };
+
+StyleSelfAlignmentData OofAlignSelf(const ComputedStyle& style) {
+  return RuntimeEnabledFeatures::LayoutAlignForPositionedEnabled()
+             ? style.ResolvedAlignSelf(ItemPosition::kNormal)
+             : StyleSelfAlignmentData(ItemPosition::kNormal,
+                                      OverflowAlignment::kDefault);
+}
+
+StyleSelfAlignmentData OofJustifySelf(const ComputedStyle& style) {
+  return RuntimeEnabledFeatures::LayoutAlignForPositionedEnabled()
+             ? style.ResolvedJustifySelf(ItemPosition::kNormal)
+             : StyleSelfAlignmentData(ItemPosition::kNormal,
+                                      OverflowAlignment::kDefault);
+}
+
+// The alignment of |style| in its inline (|is_inline_axis|) or block axis.
+// justify-self applies to the inline axis of the containing block.
+StyleSelfAlignmentData OofAlignmentForAxis(
+    const ComputedStyle& style,
+    WritingDirectionMode container_writing_direction,
+    bool is_inline_axis) {
+  const bool is_parallel = IsParallelWritingMode(
+      container_writing_direction.GetWritingMode(), style.GetWritingMode());
+  const bool is_justify_axis = is_parallel == is_inline_axis;
+  return is_justify_axis ? OofJustifySelf(style) : OofAlignSelf(style);
+}
+
+// Which edge (relative to the box's own writing direction) the box keeps when
+// both insets are set and its size does not fill the space between them.
+// |is_start_dominant| tells whether the box's start edge is the containing
+// block's start edge in this axis.
+OofAlignmentBias OofAlignmentBiasForAxis(
+    const StyleSelfAlignmentData& alignment,
+    WritingDirectionMode container_writing_direction,
+    bool is_start_dominant,
+    bool is_justify_axis,
+    absl::optional<OofAlignmentBias>* safe_bias) {
+  const OofAlignmentBias container_start =
+      is_start_dominant ? OofAlignmentBias::kStart : OofAlignmentBias::kEnd;
+  const OofAlignmentBias container_end =
+      is_start_dominant ? OofAlignmentBias::kEnd : OofAlignmentBias::kStart;
+  if (alignment.Overflow() == OverflowAlignment::kSafe) {
+    *safe_bias = container_start;
+  }
+  switch (alignment.GetPosition()) {
+    case ItemPosition::kCenter:
+      return OofAlignmentBias::kCenter;
+    case ItemPosition::kEnd:
+    case ItemPosition::kFlexEnd:
+    case ItemPosition::kLastBaseline:
+      return container_end;
+    case ItemPosition::kSelfStart:
+      return OofAlignmentBias::kStart;
+    case ItemPosition::kSelfEnd:
+      return OofAlignmentBias::kEnd;
+    case ItemPosition::kLeft:
+      if (!is_justify_axis) {
+        return container_start;
+      }
+      return container_writing_direction.IsLtr() ? container_start
+                                                 : container_end;
+    case ItemPosition::kRight:
+      if (!is_justify_axis) {
+        return container_start;
+      }
+      return container_writing_direction.IsRtl() ? container_start
+                                                 : container_end;
+    default:
+      // start, flex-start, baseline, stretch, normal.
+      return container_start;
+  }
+}
