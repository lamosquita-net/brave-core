<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="af">
<translation id="130631256467250065">Jou veranderinge sal in werking tree wanneer jy jou toestel herbegin.</translation>
<translation id="125853961893919199">FlyWeb-wenk: Stoor wagwoorde</translation>
<translation id="1589233279653618219">Gaan na
          die FlyWeb-kieslys &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          en maak seker jou opstelling is op “geen instaanbediener nie” of “direk” gestel.</translation>
<translation id="8359495463485001719">Omvalrapportering is nie beskikbaar in FlyWeb nie.</translation>
<translation id="6338530717474923868">Jy bekyk tans 'n veilige FlyWeb-bladsy</translation>
<translation id="5147169001159408844">FlyWeb probeer tans instellings vir die invul van betaalmetodes wysig.</translation>
<translation id="5702992568540613683">FlyWeb-logo</translation>
<translation id="8966580353365544289">FlyWeb-wenk: Verbeterde Veiligblaai</translation>
<translation id="510342522494506803">FlyWeb probeer tans om betaalmetodes te wysig.</translation>
<translation id="8375862260948854624">FlyWeb word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>-oopbronprojek en ander <ph name="BEGIN_LINK_OSS"/>oopbronsagteware<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Hierdie bladsy is deur FlyWeb geblokkeer</translation>
<translation id="1953000035868532675">Laat FlyWeb in jou brandmuur- of antivirusinstellings toe om by jou netwerk
          in te gaan.</translation>
<translation id="4949828774841497663">Gaan na Apps &gt; Stelselinstellings &gt; Netwerk, kies die
          aktiewe netwerk, klik die Besonderhedeknoppie, en ontkies enige instaanbedieners
          wat dalk gekies is.</translation>
<translation id="7584668345330431749">Gaan na
          die FlyWeb-kieslys &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netwerk en internet &gt; Instaanbediener
          en ontkies “Vind instellings outomaties”.</translation>
<translation id="3145451630329266064">Hierdie bladsye is bedoel vir gebruik deur FlyWeb-ontwikkelaars en word dalk nie aktief onderhou of getoets nie. As jy hulle wil aktiveer, navigeer na <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, klik die knoppie om ontfoutbladsye te aktiveer en navigeer dan terug na hierdie bladsy toe.</translation>
<translation id="2681118099728446983">FlyWeb word ook moontlik gemaak deur ander <ph name="BEGIN_LINK_OSS"/>oopbronsagteware<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Jou veranderinge sal in werking tree wanneer jy FlyWeb weer herbegin.</translation>
<translation id="8524328905288851065">FlyWeb het Bluetooth-toegang nodig om voort te gaan met 
 saambinding. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>-oopbronprojek.</translation>
<translation id="7777112741998051633">Gaan na
        die FlyWeb-kieslys &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        en ontmerk "<ph name="NO_PREFETCH_DESCRIPTION"/>."
        As dit nie die probleem oplos nie, beveel ons aan dat hierdie opsie
        weer gekies word vir verbeterde werkverrigting.</translation>
<translation id="4699594416850504200">Jy bekyk tans ’n veilige FlyWeb-toetsweergawe-bladsy</translation>
<translation id="6224789938625024797">FlyWeb het nie reg toegemaak nie.</translation>
<translation id="3593104813552438879">FlyWeb-wenk: Soek met Lens</translation>
</translationbundle>