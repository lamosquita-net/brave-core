<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه FlyWeb به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه FlyWeb به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه FlyWeb به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه FlyWeb به # دستگاه USB دسترسی دارند}}</translation>
<translation id="6017373390117959211">‏برای دریافت فهرست خواندن و سایر موارد از <ph name="DEVICE"/>، به سیستم FlyWeb وارد شوید</translation>
