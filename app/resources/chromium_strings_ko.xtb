<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ko">
<translation id="1026101648481255140">설치 다시 시작</translation>
<translation id="7099479769133613710">다시 실행하여 ChromeOS 업데이트</translation>
<translation id="1065672644894730302">환경설정을 읽을 수 없습니다.

일부 기능을 사용할 수 없으며 환경설정의 변경사항이 저장되지 않습니다.</translation>
<translation id="6896681084876612310">Brave이 정보 유출, 유해한 확장 프로그램 등으로부터 사용자를 보호해 줍니다.</translation>
<translation id="1368460307421081773">Brave에서 비밀번호를 내보내려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="7307912249127683931">Brave이 기본 브라우저로 설정되어 있습니다.</translation>
<translation id="4556715463645168547">암호가 정보 유출 및 다른 보안 문제로부터 안전한지 확인하려면 <ph name="BEGIN_LINK"/>Brave에 로그인<ph name="END_LINK"/>하세요.</translation>
<translation id="2076135703183650206">FlyWeb 메뉴를 클릭합니다</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{FlyWeb 확장 프로그램에서 HID 기기에 액세스함}=1{FlyWeb 확장 프로그램에서 HID 기기에 액세스하는 중}other{FlyWeb 확장 프로그램에서 #대의 HID 기기에 액세스하는 중}}</translation>
<translation id="4380351562011537903">FlyWeb 정보</translation>
<translation id="1203500561924088507">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME"/>을(를) 사용하려면 브라우저를 다시 시작해야 합니다.</translation>
<translation id="4876991604685198381">메모리 절약 모드로 더 빨라진 FlyWeb</translation>
<translation id="4750836834956739196">이 탭이 비활성 상태인 동안 Brave의 속도를 빠르게 유지하기 위해 메모리를 확보했습니다. 이 사이트가 비활성 상태가 되지 않도록 항상 제외할 수 있습니다.</translation>
<translation id="4549187150186083146">새 FlyWeb 프로필 설정</translation>
<translation id="4150708158890309866">Brave에 로그인했습니다.</translation>
<translation id="4713192356155907986">FlyWeb for Testing 관련 지원받기</translation>
<translation id="8962360511570172">FlyWeb 탭 공유</translation>
<translation id="8196829963313696543">Brave에서 주변 3D 지도를 만들려면 카메라 액세스 권한이 필요합니다.</translation>
<translation id="3961251277542681013">Brave의 주요 개인 정보 보호 및 보안 제어 기능을 검토합니다.</translation>
<translation id="1640672724030957280">다운로드 중...</translation>
<translation id="5579294097895667826">새롭고 안전한 Brave의 새 버전을 사용할 수 있습니다.</translation>
<translation id="2383861520542390014">사이트에서 광고 표시를 위해 사용하는 관심분야의 주제를 내가 확인하고 삭제할 수 있습니다. Brave에서는 사용자의 최근 방문 기록을 기반으로 관심분야를 추정합니다.</translation>
<translation id="5695205873161614119">Brave에서 곧 인터넷 사용 기록이 삭제됩니다</translation>
<translation id="7385422968404728039"><ph name="REMAINING_TIME"/> 후에 FlyWeb 다시 시작</translation>
<translation id="307170399141486420">백그라운드에서 Brave을 실행</translation>
<translation id="2473319786107120819">FlyWeb 재설치</translation>
<translation id="2533324957407080119">Brave에서 <ph name="AUTHENTICATION_PURPOSE"/>을(를) 시도하는 중입니다.</translation>
<translation id="6434738578659849497">사이트에서는 Brave에 내 관심분야에 관한 정보를 저장할 수 있습니다. 예를 들어 마라톤화를 구매하려고 사이트를 방문하면 사이트에서 내 관심분야를 마라톤으로 정의할 수 있습니다. 나중에 마라톤 대회에 등록하기 위해 다른 사이트에 방문하면 관심분야를 토대로 마라톤화 광고가 표시될 수 있습니다.</translation>
<translation id="4824940465467423308">관리 계정으로 로그인하고 FlyWeb 프로필에 대한 관리자 제어권을 부여하려고 합니다. 앱, 북마크, 방문 기록, 비밀번호 및 기타 설정 등 FlyWeb 데이터가 <ph name="USER_NAME"/> 계정에 영구적으로 연결됩니다. 이후 이 데이터를 FlyWeb 계정 대시보드에서 삭제할 수는 있지만 다른 계정에 연결할 수는 없습니다. 기존 FlyWeb 데이터를 유지하려면 새 프로필을 만드는 방법이 있습니다. <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">이 기능을 사용 중지하면 Brave에 로그인하지 않고도 Gmail 등의 FlyWeb 사이트에 로그인할 수 있습니다.</translation>
<translation id="5714085538350759767">Brave이 응답하지 않습니다. 다시 시작하시겠습니까?</translation>
<translation id="4035053306113201399">업데이트를 적용하려면 ChromeOS를 다시 시작해야 합니다.</translation>
<translation id="1953553007165777902">다운로드 중... <ph name="MINUTE"/>분 남음</translation>
<translation id="6956650624767954726">Brave에서 기본 브라우저를 확인하거나 설정할 수 없습니다.</translation>
<translation id="6495079989036864983">항목 1개가 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Brave에 <ph name="USER_EMAIL"/>(으)로 로그인하세요.</translation>
<translation id="2018879682492276940">설치할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="4252651275570549255">다른 암호가 정보 유출 및 다른 보안 문제로부터 안전한지 확인하려면 <ph name="BEGIN_LINK"/>Brave에 로그인<ph name="END_LINK"/>하세요.</translation>
<translation id="8544477465831682343">보다 맞춤설정된 FlyWeb 서비스 환경을 사용하기 위해 FlyWeb 방문 기록을 포함할지 선택하세요.</translation>
<translation id="1868972292925460871">Brave의 루트 인증서 관리 방식에 관한 정보</translation>
<translation id="6765231735885996239">FlyWeb 맞춤설정</translation>
<translation id="2174917724755363426">설치가 완료되지 않았습니다. 취소하시겠습니까?</translation>
<translation id="2937508664417729967">FlyWeb - 네트워크 로그인 - <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">컴퓨터를 공유하는 경우 친구와 가족이 개별적으로 탐색하고 원하는 대로 Brave을 설정할 수 있습니다.</translation>
<translation id="5067150284614317159">Brave에 저장된 안전하지 않은 사이트 목록을 사용하여 URL을 검사합니다. 사이트에서 사용자의 비밀번호를 도용하려고 하거나 사용자가 유해한 파일을 다운로드하는 경우, Brave에서 페이지 콘텐츠 일부를 비롯한 URL을 세이프 브라우징 서비스에 보낼 수 있습니다.</translation>
<translation id="3256927121768528350">여기에서 Android 휴대전화로 번호를 전송하려면 두 기기 모두에서 Brave에 로그인하세요.</translation>
<translation id="8776241960316471093">Brave을 시작하면 표시되는 페이지가 이 확장 프로그램으로 인해 변경되었습니다.</translation>
<translation id="2359808026110333948">계속</translation>
<translation id="8418845734693287262">계정의 로그인 세부정보가 오래되어 ChromeOS에서 데이터를 동기화할 수 없습니다.</translation>
<translation id="2100412893059179161">Brave을 시작하면 표시되는 페이지가 '<ph name="EXTENSION_NAME"/>' 확장 프로그램으로 인해 변경되었습니다.</translation>
<translation id="1364879203203742966">Brave에서 사이트에 대한 카메라 및 마이크 권한이 필요합니다.</translation>
<translation id="2451727308784734061">바로가기를 사용하여 비밀번호 관리자로 빠르게 이동하세요. 바로가기는 컴퓨터의 홈 화면이나 앱 런처로 이동할 수 있습니다.</translation>
<translation id="3224379053610845181">Brave이 곧 종료됩니다</translation>
<translation id="3840682988105604367">Brave에서</translation>
<translation id="2485422356828889247">제거</translation>
<translation id="6823116595279840454">Brave에서 기존 비밀번호를 바꾸려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="2691552788029831386">파일을 다운로드하려면 Brave에 저장소 액세스 권한이 있어야 합니다</translation>
<translation id="2275866327478859777">FlyWeb 도우미</translation>
<translation id="7717615706977383025">북마크, 방문 기록, 비밀번호, 기타 설정 생성 등 이 프로필을 사용하는 동안 생성된 모든 FlyWeb 데이터는 직장 프로필 관리자가 삭제할 수 있습니다. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">FlyWeb 계속 사용</translation>
<translation id="3827993926722004004">설치 중 운영체제 오류가 발생했습니다. Brave을 다시 다운로드하세요.</translation>
<translation id="333184635927514678">기기를 공유하는 경우 친구와 가족이 개별적으로 탐색하고 원하는 대로 Brave을 설정할 수 있습니다.</translation>
<translation id="8991987934418988501">멀웨어가 숨겨져 있을 수 있어 Brave에서 이 보관 파일을 차단했습니다.</translation>
<translation id="1661841342483968180"><ph name="ACCOUNT_FIRST_NAME"/>님, Brave에 오신 것을 환영합니다</translation>
<translation id="1257705702166647105">FlyWeb 탭</translation>
<translation id="2796283369875688710">보안 강화를 위해 Brave에서 사용자 데이터를 암호화합니다.</translation>
<translation id="2770231113462710648">다음으로 기본 브라우저 변경:</translation>
<translation id="7907238427168022751">이 확장 프로그램에는 멀웨어가 포함되어 있으며, 안전하지 않습니다. 더 이상 개인 정보를 비롯한 방문 사이트의 데이터를 확인하고 변경할 수 없도록 Brave에서 이 확장 프로그램을 삭제하세요.</translation>
<translation id="2799223571221894425">다시 시작</translation>
<translation id="8990114339313395142"><ph name="USER_EMAIL_ADDRESS"/>님을 위한 새 FlyWeb 프로필이 생성됩니다.</translation>
<translation id="1339341044496643931">Brave에서 제거...</translation>
<translation id="4922993584046885552">로그인 상태일 때 Brave에서 사용자를 보호하고 기타 FlyWeb 앱에서 사용자의 보안을 강화하는 데 사용될 수 있습니다.</translation>
<translation id="2885378588091291677">작업 관리자</translation>
<translation id="3806033752149316261">FlyWeb 정보</translation>
<translation id="2915996080311180594">나중에 다시 시작</translation>
<translation id="2928420929544864228">설치가 완료되었습니다.</translation>
<translation id="1661079783259785361">Brave이 최신 버전임</translation>
<translation id="5447533789927384736">사이트에서 사용자의 비밀번호를 도용하려고 하거나 사용자가 유해한 파일을 다운로드하는 경우, Brave에서 페이지 콘텐츠 일부를 비롯한 URL을 세이프 브라우징 서비스에 보낼 수 있습니다.</translation>
<translation id="1244955229468464260">Brave에서 비밀번호를 확인할 수 없습니다. 나중에 다시 시도하세요.</translation>
<translation id="8841609317523323027">Brave에 추가하는 중...</translation>
<translation id="3038232873781883849">설치 대기 중...</translation>
<translation id="7859502023458300952">비정상 종료 보고서와 <ph name="UMA_LINK"/>을(를) Brave로 전송하여 FlyWeb 개선에 참여합니다.</translation>
<translation id="4133194854947529871">방문 기록에 따라 표시되는 광고 및 아래의 예측 관심분야가 달라집니다. 개인 정보를 보호하기 위해 Brave에서는 매월 최소 한 번씩 수시로 관심분야를 자동 삭제합니다. 관심분야는 직접 삭제하지 않는 한 새로고침될 수 있습니다.</translation>
<translation id="1407857531570256859">설치 프로그램이 보관 파일 압축 풀기에 실패했습니다. Brave을 다시 다운로드하세요.</translation>
<translation id="1309738977648134943">Brave이 마이크를 사용 중입니다.</translation>
<translation id="6274649779206195384">FlyWeb 다시 시작</translation>
<translation id="6773570808762718524">새로운 FlyWeb 프로필 맞춤설정</translation>
<translation id="2700572810650522793">Brave이 다운되었습니다. 다시 시작하시겠습니까?</translation>
<translation id="5449297306961970452">Brave에서 데이터 디렉터리를 읽고 쓸 수 없습니다.

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="6755586344927335130">FlyWeb 버전 <ph name="PRODUCT_VERSION"/>이(가)가 설치됩니다.</translation>
<translation id="3286538390144397061">지금 다시 시작</translation>
<translation id="3900612994249740104">FlyWeb API 키가 누락되었습니다. Brave의 일부 기능이 사용 중지됩니다.</translation>
<translation id="6824575001009586492">FlyWeb 종료 후에도 백그라운드 앱을 계속 실행</translation>
<translation id="5399208721646088502">이 계정을 사용하는 FlyWeb 프로필이 이미 존재합니다.</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">기존 FlyWeb 프로필로 전환하시겠습니까?</translation>
<translation id="3412460710772753638">기기의 비밀번호 관리자에 업데이트합니다.</translation>
<translation id="847273641988291714">FlyWeb 프로필을 사용하면 모든 FlyWeb 데이터를 분리할 수 있습니다. 친구와 가족을 위한 프로필을 만들거나 업무용과 개인용 프로필을 구분하세요.</translation>
<translation id="1558345997029205345">유출된 비밀번호로 로그인하면 Brave에서 알림을 표시합니다.</translation>
<translation id="956833467923764542">항목 <ph name="ITEMS_COUNT"/>개가 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Brave에 <ph name="USER_EMAIL"/>(으)로 로그인하세요.</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> 바로가기를 사용하여 FlyWeb 프로필 간에 전환하세요</translation>
<translation id="6724485219247982027">FlyWeb 창을 모두 닫고 다시 시도해 보세요.</translation>
<translation id="763231524941489073">개인 정보를 보호하기 위해 Brave에서는 4주가 지난 관심분야를 자동 삭제합니다. 인터넷 사용에 따라 특정 관심분야가 목록에 다시 표시될 수 있습니다. Brave에서 고려하지 않았으면 하는 관심분야가 있으면 직접 삭제하세요.</translation>
<translation id="4856314253538330936">이 기기에서 Brave을 사용해 방문한 사이트의 기록인 방문 기록이 사용됩니다.</translation>
<translation id="1054901839328542426">컴퓨터에 유해한 소프트웨어가 있습니다. Brave에서 유해한 소프트웨어를 삭제하고, 설정을 복원하고, 확장 프로그램을 사용 중지하여 브라우저가 다시 정상적으로 작동하도록 할 수 있습니다.</translation>
<translation id="199853864262219284">이미 다른 계정으로 로그인되어 있습니다. 인터넷 사용 기록을 별도로 보관하기 위해 Brave에서 나만의 프로필을 만들 수 있습니다.</translation>
<translation id="9154454584386840012">향후 FlyWeb 업데이트를 받으려면 macOS 10.15 이상이 필요합니다. 이 컴퓨터에서는 macOS 10.13을 사용 중입니다.</translation>
<translation id="7465608402296261674"><ph name="ORIGIN"/>에서 Android 휴대전화로 번호를 전송하려면 두 기기 모두에서 Brave에 로그인하세요.</translation>
<translation id="1543563097158722437">Brave에서 비밀번호를 확인할 수 없습니다. 인터넷 연결 상태를 확인하세요.</translation>
<translation id="190360428475385352">Brave의 광고 개인 최적화에 관해 자세히 알아보기</translation>
<translation id="6611602069520888180">새 FlyWeb 탭에서 링크 열기(&amp;T)</translation>
<translation id="8701399577028839698">Brave을 사용하면 웹에서 전화번호를 클릭하여 Skype로 통화할 수 있습니다.</translation>
<translation id="2401189691232800402">ChromeOS 시스템</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">ChromeOS 도움말 보기</translation>
<translation id="1864899808802540927"><ph name="ACCOUNT_EMAIL"/> 계정으로 FlyWeb 브라우저 기능을 이용해 보세요</translation>
<translation id="2736927994658608637">향후 FlyWeb 업데이트를 받으려면 macOS 10.15 이상이 필요합니다. 이 컴퓨터에서는 macOS 10.14를 사용 중입니다.</translation>
<translation id="5175060854726708547">Brave을 맞춤설정 및 제어합니다. 확인이 필요한 항목이 있습니다. 클릭하여 세부정보를 보세요.</translation>
<translation id="606156353708638647">Brave을 열고 탐색을 시작하려면 내 이름을 클릭하세요.</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/>님이 이미 FlyWeb 프로필에 로그인되어 있습니다. 인터넷 사용 기록을 별도로 보관하기 위해 Brave에서 나만의 프로필을 만들 수 있습니다.</translation>
<translation id="3376157109651222096">내 계정은 <ph name="MANAGER_NAME"/>에서 관리합니다. 관리자가 이 FlyWeb 브라우저 프로필과 북마크, 방문 기록, 비밀번호 등의 데이터를 보고 수정할 수 있습니다.</translation>
<translation id="8536259619256229278">Brave에서 비밀번호를 복사하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="4041003017438130352">위험할 수 있는 파일이므로 검사하는 것이 좋습니다.</translation>
<translation id="5667414856761616811">&amp;FlyWeb for Testing 정보</translation>
<translation id="1152920704813762236">ChromeOS 정보</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_LINUX_OSS"/>Linux 개발 환경<ph name="END_LINK_LINUX_OSS"/>과 마찬가지로, ChromeOS는 추가 <ph name="BEGIN_LINK_CROS_OSS"/>오픈소스 소프트웨어<ph name="END_LINK_CROS_OSS"/>를 사용하여 개발되었습니다.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>현재 설정<ph name="END_LINK"/>을 보고하여 FlyWeb 개선에 참여</translation>
<translation id="4050175100176540509">최신 버전에는 중요한 보안 개선사항 및 새로운 기능이 포함되어 있습니다.</translation>
<translation id="4055805654398742145">비밀번호 관리자(&amp;A)</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Brave을 1분 동안 사용하지 않으면 조직에서 자동으로 종료합니다. 인터넷 사용 기록이 삭제됩니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.}other{Brave을 #분 동안 사용하지 않으면 조직에서 자동으로 종료합니다. 인터넷 사용 기록이 삭제됩니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.}}</translation>
<translation id="4148957013307229264">설치 중...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - 네트워크 로그인 - FlyWeb</translation>
<translation id="4007949387571083162">Brave에 유용한 앱, 게임, 확장 프로그램, 테마를 찾아보세요.</translation>
<translation id="1595210458721188387">FlyWeb UI가 이 언어로 표시됩니다.</translation>
<translation id="4222932583846282852">취소 중...</translation>
<translation id="2564888740660198776">FlyWeb 데이터를 이 계정에 연결하시겠습니까?</translation>
<translation id="8514458758262040082">FlyWeb 도움말 보기</translation>
<translation id="3393587701694585022">확인되지 않은 오류로 설치에 실패했습니다. Brave이 실행 중인 경우 종료한 후 다시 실행하세요.</translation>
<translation id="4304713468139749426">비밀번호 관리자</translation>
<translation id="4334294535648607276">다운로드가 완료되었습니다.</translation>
<translation id="1068681683510904753">기기를 사용하기 전에 <ph name="MANAGER"/>에서 다음 서비스 약관을 읽고 이에 동의해야 합니다. 이 약관은 ChromeOS 약관을 확대, 수정 또는 제한하지 않습니다</translation>
<translation id="1376968889000878095">Brave을 종료하시겠습니까?</translation>
<translation id="6360389033094512399">백그라운드에서 Brave을 실행</translation>
<translation id="4166347503469830337">FlyWeb 맞춤설정 및 제어</translation>
<translation id="4427306783828095590">향상된 보호 기능이 피싱 및 멀웨어를 더욱 효과적으로 차단합니다.</translation>
<translation id="8791209382165811772">FlyWeb for Testing 정보</translation>
<translation id="834808339160590901">Brave에 오신 것을 환영합니다. 새 브라우저 창이 열렸습니다</translation>
<translation id="1304885695888649052">문제가 발생하여 Brave을 업데이트할 수 없습니다. <ph name="BEGIN_LINK"/>FlyWeb 업데이트 문제 및 업데이트 실패 문제 해결하기<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">새 FlyWeb 프로필로 계속하시겠습니까?</translation>
<translation id="4567424176335768812"><ph name="USER_EMAIL_ADDRESS"/>(으)로 로그인되어 있습니다. 이제 로그인한 모든 기기에서 북마크, 방문 기록 및 기타 설정에 액세스할 수 있습니다.</translation>
<translation id="4594305310729380060">기기의 비밀번호 관리자에 저장합니다.</translation>
<translation id="6046424510733540251">FlyWeb 앱</translation>
<translation id="4970880042055371251">ChromeOS 버전</translation>
<translation id="1936188352112244665">업데이트가 거의 완료되었습니다. 업데이트를 완료하려면 Brave을 다시 시작하세요.</translation>
<translation id="2962574118577609024">FlyWeb 사용 보고서도 공유하면 내가 방문한 URL이 해당 보고서에 포함됩니다.</translation>
<translation id="9219132550163437762">다른 컴퓨터(<ph name="HOST_NAME"/>)의 다른 FlyWeb 프로세스(<ph name="PROCESS_ID"/>)에서 프로필을 사용 중인 것 같습니다. 프로필이 손상되지 않도록 Brave에서 잠금 설정했습니다. 다른 프로세스에서 프로필을 사용 중이지 않은 것이 확실한 경우 프로필을 잠금 해제하고 Brave을 다시 시작하세요.</translation>
<translation id="4680828127924988555">설치 취소</translation>
<translation id="5227023869666757348">다른 사용자가 이전에 이 컴퓨터에서 <ph name="ACCOUNT_EMAIL_LAST"/>(으)로 Brave에 로그인했습니다. 새로운 FlyWeb 사용자를 만들어 정보를 별도로 관리하세요.</translation>
<translation id="1671154647029930623">Brave을 종료하시겠습니까?</translation>
<translation id="4143239505982500022">FlyWeb 특별 보안 업데이트를 방금 적용했습니다. 다시 시작하면 탭이 복원됩니다.</translation>
<translation id="1347247057384060764">언제든지 FlyWeb 설정에서 선택을 변경할 수 있습니다. 시험 버전은 현재의 광고 게재 방식을 기반으로 실행되므로 변경사항이 당장 적용되는 것은 아닙니다.</translation>
<translation id="4259200560913816786">Brave에서 비밀번호를 확인할 수 없습니다. 24시간 후에 다시 시도해 보거나 <ph name="BEGIN_LINK"/>FlyWeb 계정에서 비밀번호를 확인<ph name="END_LINK"/>하세요.</translation>
<translation id="3469649164996417993">FlyWeb 검색과 동일한 맞춤법 검사기가 사용됩니다. 브라우저에 입력되는 텍스트는 Brave로 전송됩니다. 설정에서 언제든지 이 동작을 변경할 수 있습니다.</translation>
<translation id="2991144524835127379">Brave이 mDNS 트래픽을 허용하는 인바운드 규칙입니다.</translation>
<translation id="6208903184719035736">다시 실행하여 FlyWeb 업데이트</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{Brave을 1분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 기존 탭은 계속 열려 있습니다.}other{Brave을 #분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 기존 탭은 계속 열려 있습니다.}}</translation>
<translation id="7174589544844983914">Brave이 백그라운드 모드로 실행 중입니다.</translation>
<translation id="7792628702371319769">게스트로 사용 기록을 남기지 않고 Brave을 사용할 수 있습니다.</translation>
<translation id="2760069255902967585">Brave에 본인 추가</translation>
<translation id="4239638419916712076">Brave은 사이트에서 내 정보를 더 적게 사용하면서도 동일한 인터넷 사용 환경을 제공할 수 있는 새로운 기능을 모색하고 있습니다.</translation>
<translation id="387444474697464273">저장된 비밀번호가 없습니다. 비밀번호를 저장하면 Brave에서 확인할 수 있습니다.</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/>님이 이미 FlyWeb 프로필에 로그인되어 있습니다. <ph name="USER_EMAIL_ADDRESS"/>님을 위한 새 FlyWeb 프로필이 생성됩니다.</translation>
<translation id="8295539942024823191">변경사항을 적용하려면 Brave을 다시 실행하세요.</translation>
<translation id="5374328929709976901">무료 체험이 사용 설정되어 있는 경우와 Brave에서 임의로 나에게 현재 진행 중인 무료 체험을 적용한 경우, 표시되는 광고 및 아래의 예측 관심분야에 방문 기록이 영향을 미칩니다. 개인 정보를 보호하기 위해 Brave에서는 매월 최소 한 번씩 수시로 관심분야를 삭제합니다.</translation>
<translation id="8449603408481238073">관리 계정으로 로그인하고 FlyWeb 프로필에 대한 관리자 제어권을 부여하려고 합니다. 앱, 북마크, 방문 기록, 비밀번호 및 기타 설정 등 FlyWeb 데이터가 <ph name="USER_NAME"/> 계정에 영구적으로 연결됩니다. 이후 이 데이터를 FlyWeb 계정 대시보드에서 삭제할 수는 있지만 다른 계정에 연결할 수는 없습니다. <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">FlyWeb 업데이트 중(<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">FlyWeb 로그인 허용</translation>
<translation id="5965500511473700110">Brave의 새 버전이 출시되었습니다.</translation>
<translation id="1827750898515917134">Brave에서 제거</translation>
<translation id="5020755920249060562">Brave을 기본 브라우저로 설정</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb 베타</translation>
<translation id="5385202369020319636">이 Linux 배포판에서 더 이상 Brave을 지원하지 않으므로 Brave이 올바르게 작동하지 않을 수 있습니다.</translation>
<translation id="5957333939864770801">이 사이트와 위치를 공유하려면 Brave에 내 위치 액세스 권한이 있어야 합니다</translation>
<translation id="780999790006298623">개인 정보를 보호하기 위해 Brave에서는 4주가 지난 관심분야를 자동 삭제합니다. 인터넷 사용에 따라 특정 관심분야가 목록에 다시 표시될 수 있습니다. Brave에서 관심분야를 잘못 예측했거나 특정 광고를 보고 싶지 않다면 직접 관심분야를 삭제하세요.</translation>
<translation id="2183749398075655200">Brave에서 최신 시스템 업데이트를 설치하는 동안 잠시 기다려 주세요.</translation>
<translation id="8996657165865563765">Brave에서 비밀번호를 수정하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="5738298079259740925">Brave에서 PDF 열기</translation>
<translation id="9197514179291669592">사용하게 되면 Brave에서도 로그아웃됩니다.</translation>
<translation id="6096945112863785306">{0,plural, =0{FlyWeb 업데이트 출시}=1{FlyWeb 업데이트 출시}other{FlyWeb 업데이트가 출시된 지 #일 지남}}</translation>
<translation id="5666891644992637849">지금 Brave을 다시 시작하세요</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">이 언어로 FlyWeb 표시</translation>
<translation id="8331941171144629807">Brave에 오신 것을 환영합니다.</translation>
<translation id="7581082856615467651">Brave에서 다음 항목에 멀웨어가 포함된 것을 발견했습니다.</translation>
<translation id="5895138241574237353">다시 시작</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - 네트워크 로그인</translation>
<translation id="5924017743176219022">인터넷에 연결 중...</translation>
<translation id="5941711191222866238">최소화</translation>
<translation id="483902194277448471">Brave에서 임의로 나에게 현재 진행 중인 무료 체험을 적용한 경우, 표시되는 광고 및 아래의 예측 관심분야에 방문 기록이 영향을 미칩니다. 개인 정보를 보호하기 위해 Brave에서는 매월 최소 한 번씩 수시로 관심분야를 삭제합니다. 관심분야는 직접 삭제하지 않는 한 새로고침됩니다.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Brave을 1분 동안 사용하지 않으면 조직에서 자동으로 종료합니다.}other{Brave을 #분 동안 사용하지 않으면 조직에서 자동으로 종료합니다.}}</translation>
<translation id="4955869506208896934">동기화를 시작하려면 Brave을 업데이트하세요.</translation>
<translation id="63409513082302419">방문하는 사이트에서는 일반적으로 사용 경험을 개인화하기 위해 내가 관심을 보인 항목을 기억합니다. 또한 사이트에서는 내 관심분야에 관한 정보를 Brave에 저장할 수 있습니다.</translation>
<translation id="6003112304606738118">다운로드 중... <ph name="HOURS"/>시간 남음</translation>
<translation id="6040143037577758943">닫기</translation>
<translation id="2904199563401682369">이전보다 더 빨라진 FlyWeb 새 버전을 사용할 수 있습니다.</translation>
<translation id="8714139918792771260">&amp;Brave에서 열기</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/>이(가) Brave에 추가됨</translation>
<translation id="3890023823480067024">Brave의 속도를 높여보세요</translation>
<translation id="608006075545470555">이 브라우저에 직장 프로필 추가</translation>
<translation id="5880307616068888895">Brave을 맞춤설정하고 제어하세요. 업데이트가 출시되었습니다.</translation>
<translation id="8890528681896757647">사용 설정되면 Brave은 부드러운 스크롤 및 동영상 프레임 속도 같은 시각적 효과와 백그라운드 활동을 제한하여 배터리 전원을 절약합니다.</translation>
<translation id="1683225514126450592">확장 프로그램이 FlyWeb 툴바에 액세스 요청을 표시하도록 허용</translation>
<translation id="5171527334826689262">Brave에서 내 FlyWeb 계정에 이 비밀번호를 저장하므로 기억하지 않아도 됩니다.</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/>은(는) 위험한 파일이므로 Brave에서 차단했습니다.</translation>
<translation id="1773252983747911987">Brave이 곧 종료되고 데이터가 삭제됩니다</translation>
<translation id="3063780243670578104">세이프 브라우징이 사용 중지되어 있습니다. 사용 설정하는 것이 좋습니다.</translation>
<translation id="1686760912855738719">여기에서 FlyWeb 프로필 간에 전환할 수 있습니다.</translation>
<translation id="4403968929742079769"><ph name="TARGET_DEVICE_NAME"/>에서 Brave에 로그인되어 있는지 확인한 다음 다시 전송해 보세요.</translation>
<translation id="1855179706668101462">컴퓨터에 이미 최신 버전의 Brave이 있습니다. 소프트웨어가 작동하지 않으면 Brave의 설치를 제거한 뒤 다시 시도하세요.</translation>
<translation id="651290634887454330">{0,plural, =0{곧 Brave이 다시 시작됩니다}=1{1초 후 Brave이 다시 시작됩니다}other{#초 후 Brave이 다시 시작됩니다}}</translation>
<translation id="2586408713760853791">파일을 다운로드하려면 Brave에 저장소 액세스 권한이 필요합니다.</translation>
<translation id="1603558835003845196">Brave에 저장된 안전하지 않은 사이트 목록을 사용하여 URL을 검사합니다.</translation>
<translation id="5751080530525677552">Brave을 기본 브라우저로 설정</translation>
<translation id="4804111781678641302">Brave에서 업데이트를 확인할 수 없습니다. 인터넷 연결 상태를 확인하세요.</translation>
<translation id="3542157007113577464">Brave에서 로그아웃</translation>
<translation id="6273793429163604305">준비하세요...</translation>
<translation id="3794967601634523398">FlyWeb 프로필 맞춤설정</translation>
<translation id="6475001900959697061">FlyWeb 프로필 이름 지정</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/>은(는) 위험할 수 있으므로 Brave에서 차단했습니다.</translation>
<translation id="5523868569707953059">Brave이 카메라를 사용 중입니다.</translation>
<translation id="5914697581312472089">위험한 파일이므로 Brave에서 차단했습니다.</translation>
<translation id="6327105987658262776">사용 가능한 업데이트가 없습니다.</translation>
<translation id="8226838065217375546">Brave에서 다른 작업이 진행 중입니다. 나중에 다시 시도해 주세요.</translation>
<translation id="6063700568539132984">이제 FlyWeb 계정으로 공유 컴퓨터에서 Brave을 손쉽게 사용할 수 있습니다.</translation>
<translation id="6890209090736444656">Brave을 제거하시겠습니까?</translation>
<translation id="6375219077595103062">비밀번호 관리자로 연결되는 바로가기를 추가하세요</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>Brave의 데이터 사용 방식:<ph name="END_BOLD"/> Brave은 내 관심분야를 예측할 수 있습니다. 나중에 사이트를 방문하면 사이트에서 광고 개인 최적화를 위해 내 관심분야를 알려달라고 Brave에 요청할 수 있습니다.</translation>
<translation id="6636986997730784876">Brave은 빠른 속도로 웹페이지와 애플리케이션을 실행하는 웹 브라우저입니다. 빠르고 안정적이며 사용하기에 편리합니다. Brave에 내장된 멀웨어 및 악성 코드 방지 기능을 사용하여 더욱 안전하게 웹을 검색하세요.</translation>
<translation id="2139300032719313227">ChromeOS 다시 시작</translation>
<translation id="173462352822069427">FlyWeb 프로필에 오신 것을 환영합니다</translation>
<translation id="1474676525193357364">또한 Brave을 시작할 때 표시되는 페이지를 설정합니다.</translation>
<translation id="648319183876919572">향상된 세이프 브라우징은 위험한 웹사이트와 다운로드로부터 사용자를 보호합니다.</translation>
<translation id="5777905264835557372">FlyWeb 설치 제거</translation>
<translation id="8852057261917278552"><ph name="TIMEOUT_DURATION"/> 동안 사용하지 않으면 조직에서 Brave을 종료합니다. 인터넷 사용 기록이 삭제되었습니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.</translation>
<translation id="8592211619057897362">각 프로필에는 북마크, 방문 기록, 비밀번호 등과 같은 FlyWeb 정보가 보관됩니다.</translation>
<translation id="7489092380688543560">다른 FlyWeb 프로필의 비밀번호를 보도록 전환할 수 있습니다.</translation>
<translation id="8243012192239086369">맞춤법 오류를 수정하기 위해 Brave에서 사용자가 입력하는 텍스트를 Brave로 전송합니다.</translation>
<translation id="3927263773110604886">FlyWeb 알림 설정으로 이동</translation>
<translation id="6888846095017247017">변경사항은 다음에 Brave을 다시 시작할 때 적용됩니다.</translation>
<translation id="1886169834787876002">Brave에서 주변의 3D 지도를 만들려면 카메라 권한이 필요합니다.</translation>
<translation id="7640394575797555654">사이트가 제대로 작동하지만 FlyWeb 창을 모두 닫으면 데이터는 전부 삭제됩니다.</translation>
<translation id="6676384891291319759">인터넷 연결</translation>
<translation id="1363996462118479832">로그인 중 오류가 발생하여 ChromeOS에서 데이터를 동기화할 수 없습니다.</translation>
<translation id="4152880912192471857">Brave에서 사이트에 대한 마이크 권한이 필요합니다.</translation>
<translation id="2193001403607253406">Brave의 최신 버전을 사용하기 때문에 프로필을 사용할 수 없습니다.

일부 기능을 사용할 수 없습니다. 다른 프로필 디렉터리를 지정하거나 Brave의 새로운 버전을 사용하시기 바랍니다.</translation>
<translation id="3260179770078760650">메모리 절약 모드로 더 빨라진 FlyWeb</translation>
<translation id="7728046102681268859">모든 사용자가 사용할 수 있도록 컴퓨터에 Brave이 이미 설치되어 있습니다.</translation>
<translation id="7030752319019635064">모든 기기에서 FlyWeb 계정 정보에 액세스하려면 로그인한 후 동기화를 사용 설정하세요.</translation>
<translation id="1292831930742306370">위험할 수 있는 파일이므로 검사하는 것이 좋습니다.</translation>
<translation id="5612302437680103875">부모님이 Brave의 ‘사이트, 앱, 확장 프로그램에 대한 권한’을 사용 중지하셨습니다. 이 <ph name="EXTENSION_TYPE_PARAMETER"/> 사용은 허용되지 않습니다.</translation>
<translation id="1547295885616600893">ChromeOS는 추가 <ph name="BEGIN_LINK_CROS_OSS"/>오픈소스 소프트웨어<ph name="END_LINK_CROS_OSS"/>를 사용하여 개발되었습니다.</translation>
<translation id="6432682256389755533">비밀번호가 유출되면 Brave에서 알려줍니다.</translation>
<translation id="178055475944027272">파일에 멀웨어가 포함되어 있기 때문에 Brave에서 파일을 차단했습니다</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="5712993149989886097">Google Pay(Brave에 복사됨)</translation>
<translation id="4695676871328690599">Brave에서 "<ph name="EXTENSION_NAME"/>"에 멀웨어가 포함된 것을 발견했습니다.</translation>
<translation id="76559364095325834">Brave이 업데이트되었지만, 최소 30일 동안 사용하지 않았습니다.</translation>
<translation id="8524328905288851065">페어링을 계속하려면 Brave에서 블루투스 액세스 권한이
필요합니다. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="5929819793040985066">무료 체험을 사용 설정한 경우 방문하는 사이트에서는 Ad measurement를 활용해 광고의 실적을 측정하는 데 도움이 되는 정보를 Brave에 요청할 수 있습니다. Ad measurement는 사이트 간에 최소한의 정보만 전송함으로써 크로스 사이트 추적을 제한합니다.</translation>
<translation id="8806901087257994310">이후 방문한 사이트에서 광고 개인 최적화를 위해 내 관심분야를 알려달라고 Brave에 요청할 수 있습니다. Brave은 최대 3개의 관심분야를 공유할 수 있습니다.</translation>
<translation id="2553796189989827248">취약한 비밀번호는 추측하기 쉽습니다. Brave에서 <ph name="BEGIN_LINK"/>안전한 비밀번호를 생성하고 기억하도록 설정<ph name="END_LINK"/>하세요.</translation>
<translation id="1749753408579541220">메모리 절약 모드를 사용 설정하면 Brave이 비활성 탭에서 메모리를 확보합니다. 이에 따라 활성 탭과 기타 앱에 더 많은 컴퓨터 리소스가 제공되고 Brave의 빠른 속도가 유지됩니다. 비활성 탭으로 돌아가면 탭이 자동으로 다시 활성화됩니다.</translation>
<translation id="3453763134178591239">ChromeOS 약관</translation>
<translation id="8545123476334328275">이 사이트에서 마이크에 액세스하려면 Brave에 권한이 필요합니다</translation>
<translation id="7025789849649390912">설치가 중단되었습니다.</translation>
<translation id="3945284827084409390">FlyWeb 업데이트</translation>
<translation id="7886270027101123253">이미지에 유용한 설명이 없으면 Brave에서 자동으로 설명을 제공하려고 시도합니다. 설명을 생성하기 위해 이미지가 Brave로 전송됩니다.</translation>
<translation id="6017914745388312119"><ph name="TIMEOUT_DURATION"/> 동안 사용하지 않으면 조직에서 FlyWeb 데이터를 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.</translation>
<translation id="3283953248242339756">Brave에서 사이트에 대한 카메라 권한이 필요합니다.</translation>
<translation id="4729674580260824908">Brave을 실행할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="9165925035484501889">Brave에서 비밀번호를 확인할 수 없습니다. 24시간 후 다시 시도해 보세요.</translation>
<translation id="1678436729108859736">작업 관리자 - FlyWeb</translation>
<translation id="6135229048093148288">Brave에서 예측한 내 관심분야</translation>
<translation id="7641415053133771502">방문하는 사이트에서는 Ad measurement를 활용해 광고의 실적을 측정하는 데 도움이 되는 정보를 Brave에 요청할 수 있습니다. Ad measurement는 사이트 간에 최소한의 정보만 전송함으로써 크로스 사이트 추적을 제한합니다.</translation>
<translation id="2866611433272355726">FlyWeb 업데이트 중</translation>
<translation id="5013690772358862887">환경설정 파일이 손상되었거나 잘못되었습니다.

Brave에서 설정을 복구할 수 없습니다.</translation>
<translation id="7339898014177206373">새 창</translation>
<translation id="1123144153876435088">웹, 북마크 및 기타 FlyWeb 콘텐츠가 여기에 저장됩니다.</translation>
<translation id="6760192061736180746">시스템 관리자가 <ph name="TARGET_URL_HOSTNAME"/> 액세스를 위해 <ph name="ALTERNATIVE_BROWSER_NAME"/>을(를) 열도록 Brave을 구성했습니다.</translation>
<translation id="3225813655660631613">FlyWeb 프로필을 사용하면 모든 FlyWeb 데이터를 분리할 수 있습니다. 업무용 데이터와 개인용 데이터를 더 쉽게 분리해 보세요.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - 개발자용 FlyWeb</translation>
<translation id="3787225360375979559">이 사이트에서 카메라에 액세스하려면 Brave에 권한이 필요합니다</translation>
<translation id="2431618580332826398">향후 FlyWeb 업데이트를 받으려면 Windows 10 이상이 필요합니다. 이 컴퓨터에서는 Windows 7을 사용 중입니다.</translation>
<translation id="2154651873647244914">Brave을 다시 시작하시겠습니까?</translation>
<translation id="3137757192868162370">이미 실행 중인 Brave과 동일한 버전을 설치할 수 없습니다. Brave을 종료한 뒤 다시 시도하세요.</translation>
<translation id="4731230085409037950">{0,plural, =1{1분 후 Brave이 다시 시작됩니다}other{#분 후 Brave이 다시 시작됩니다}}</translation>
<translation id="2706045239797506060">FlyWeb(<ph name="URL"/>)에서도 데이터 삭제</translation>
<translation id="5426732664223965459">Brave에서 내 관심분야를 예측할 수 있습니다. 나중에 사이트를 방문하면 사이트에서 광고 개인 최적화를 위해 내 관심분야를 알려달라고 Brave에 요청할 수 있습니다.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> 설치 프로그램</translation>
<translation id="3067364763515000789">Brave이 카메라와 마이크를 사용 중입니다.</translation>
<translation id="1381291360713116383">더욱 업그레이드된 FlyWeb</translation>
<translation id="7649070708921625228">도움말</translation>
<translation id="481435825250648341">FlyWeb 설정에서 이러한 기능에 관해 자세히 알아볼 수 있습니다.</translation>
<translation id="3079800650903360762">Brave은 사용자의 데이터를 더 적게 사용하면서도 사이트에서 동일한 탐색 환경을 제공할 수 있는 새로운 기능을 알아보고 있습니다.</translation>
<translation id="2230101319599356673">Brave이 기본 브라우저로 설정되어 있지 않습니다</translation>
<translation id="3243257760331619874">모든 기기에서 Brave을 동기화하고 맞춤설정하세요.</translation>
<translation id="1549877678317463759">인터넷 사용 기록이 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Brave에 <ph name="USER_EMAIL"/>(으)로 로그인하세요.</translation>
<translation id="7747138024166251722">설치 프로그램이 임시 디렉터리를 만들지 못했습니다. 디스크 공간 및 설치 권한을 확인해 보세요.</translation>
<translation id="134973275687829726">Brave의 속도를 높여보세요</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8463540467315366872">이 계정을 사용하는 FlyWeb 프로필이 기기에 이미 존재합니다</translation>
<translation id="7845233973568007926">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME"/>을(를) 사용하려면 컴퓨터를 다시 시작해야 합니다.</translation>
<translation id="8611872055947278722">Brave을 최신 버전으로 업데이트하지 못했기 때문에 새로운 기능과 보안 수정 사항이 적용되지 않았습니다.</translation>
<translation id="7872446069773932638">다운로드 중... <ph name="SECONDS"/>초 남았습니다.</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>데이터 관리 방법:<ph name="END_BOLD"/> 개인 정보를 보호하기 위해 Brave에서는 4주가 지난 관심분야를 자동 삭제합니다. 인터넷 사용에 따라 특정 관심분야가 목록에 다시 표시될 수 있습니다. Brave에서 고려하지 않았으면 하는 관심분야가 있으면 직접 삭제하세요.</translation>
<translation id="3096730275883527801"><ph name="USER_EMAIL_ADDRESS"/>(으)로 Brave에 로그인되어 있습니다. 같은 계정으로 다시 로그인해 주세요.</translation>
<translation id="9017338699075596174">Brave의 보조 설치이며 기본 브라우저로 설정할 수 없습니다.</translation>
<translation id="5944585442866020176">Brave에 액세스 권한을 부여하면 웹사이트에서 액세스 권한을 요청할 수 있게 됩니다.</translation>
<translation id="80471789339884597">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME"/>을(를) 사용하려면 모든 브라우저를 다시 시작해야 합니다.</translation>
<translation id="3263664073045388929">Brave에서 사이트에 대한 위치 정보 액세스 권한이 필요합니다.</translation>
<translation id="5334309298019785904">내 도메인에서 동기화를 사용할 수 없으므로 ChromeOS에서 데이터를 동기화할 수 없습니다.</translation>
<translation id="813913629614996137">초기화 중...</translation>
<translation id="1597323875619800374">이 파일은 위험하므로 Brave에서 차단했습니다.</translation>
<translation id="8455485678130879158">위험한 유형의 파일이기 때문에 Brave에서 파일을 차단했습니다.</translation>
<translation id="6756872644564483342">이미지에 유용한 설명이 없으면 Brave에서 자동으로 설명을 제공하려고 시도합니다. 설명을 생성하기 위해 이미지가 Brave로 전송됩니다. 이 기능은 언제든지 설정에서 사용 중지할 수 있습니다.</translation>
<translation id="5792785787074426346">로그인되어 있지 않으므로 Brave에서 비밀번호를 확인할 수 없습니다.</translation>
<translation id="6627585369674499881">이 파일은 위험할 수 있으므로 Brave에서 차단했습니다.</translation>
<translation id="208266011144024011"><ph name="TIMEOUT_DURATION"/> 동안 사용하지 않으면 조직에서 Brave을 종료합니다.</translation>
<translation id="3542611917357881417">Brave으로 더 많은 작업하기</translation>
<translation id="5565286784156841599">로그인하여 모든 기기에서 Brave을 동기화하고 맞춤설정하세요.</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/>에서 이전에 Brave을 사용한 적이 있음</translation>
<translation id="5975370349701995302">모든 기기에서 FlyWeb 브라우저 데이터에 액세스하려면 로그인한 후 동기화를 사용 설정하세요</translation>
<translation id="7408894216012529448">향후 FlyWeb 업데이트를 받으려면 Windows 10 이상이 필요합니다. 이 컴퓨터에서는 Windows 8을 사용 중입니다.</translation>
<translation id="7256356679044945328">이 확장 프로그램은 개발자가 게시 취소했으며, 안전하지 않을 수 있습니다. 더 이상 개인 정보를 비롯한 방문 사이트의 데이터를 확인하고 변경할 수 없도록 Brave에서 이 확장 프로그램을 삭제하세요.</translation>
<translation id="5261590792975521002">{0,plural, =1{1일 이내로 Brave을 다시 시작해 주세요}other{#일 이내로 Brave을 다시 시작해 주세요}}</translation>
<translation id="3101564993057563365">설치 프로그램 아카이브가 손상되었거나 잘못되었습니다. Brave을 다시 다운로드하세요.</translation>
<translation id="5316851838033144902">Brave은 Windows 10 이상 버전에서 사용할 수 있습니다.</translation>
<translation id="6760691951531758781">선택사항: 진단 및 사용 데이터를 Brave에 자동으로 전송하여 ChromeOS의 기능 및 성능 개선에 참여합니다.</translation>
<translation id="6852836260419236265">Brave이 이전 버전임</translation>
<translation id="8550334526674375523">이 직장 프로필은 개인 프로필과 완전히 분리됩니다.</translation>
<translation id="538636623826336032">부모님이 Brave의 ‘사이트, 앱, 확장 프로그램에 대한 권한’을 사용 중지하셨습니다. 이 <ph name="EXTENSION_TYPE_PARAMETER"/> 추가가 허용되지 않습니다.</translation>
<translation id="8842078659829047498">FlyWeb 계정으로 로그인하면 Brave에서 비밀번호를 확인할 수 있습니다.</translation>
<translation id="8121009781989288430">Copyright © <ph name="YEAR"/> The Brave Authors. All rights reserved.</translation>
<translation id="6539417028609632917"><ph name="BEGIN_BOLD"/>Brave의 데이터 사용 방식:<ph name="END_BOLD"/> 사이트에서는 Brave에 내 관심분야에 관한 정보를 저장할 수 있습니다. 예를 들어 마라톤화를 구매하려고 사이트를 방문하면 사이트에서 내 관심분야를 마라톤으로 정의할 수 있습니다. 나중에 마라톤 대회에 등록하기 위해 다른 사이트에 방문하면 관심분야를 토대로 마라톤화 광고가 표시될 수 있습니다.</translation>
<translation id="7129578417724116642">FlyWeb 실행 중...</translation>
<translation id="781795332371306113">알 수 없는 오류로 인해 설치에 실패했습니다. Brave을 다시 다운로드하세요.</translation>
<translation id="5469043671012993003">FlyWeb for Testing을 기본 브라우저로 설정할 수 없습니다.</translation>
<translation id="1074759999845943804">{NUM_DEVICES,plural, =0{FlyWeb 확장 프로그램에서 HID 기기에 액세스함}=1{FlyWeb 확장 프로그램에서 1대의 HID 기기에 액세스하는 중}other{FlyWeb 확장 프로그램에서 #대의 HID 기기에 액세스하는 중}}</translation>
<translation id="1514450422236300417">또한 Brave을 시작하거나 검색주소창에서 검색할 때 표시되는 페이지를 설정합니다.</translation>
<translation id="573490495087487940">나만의 FlyWeb</translation>
<translation id="6779439179813982247">이 사이트에서 카메라와 마이크에 액세스하려면 Brave에 권한이 필요합니다</translation>
<translation id="8826492472752484139">'비밀번호 관리자'를 클릭합니다</translation>
<translation id="6933858244219479645">ChromeOS 시스템</translation>
<translation id="7354175404728814475"><ph name="BEGIN_BOLD"/>사용되는 데이터:<ph name="END_BOLD"/> 이 기기에서 Brave을 사용해 방문한 사이트의 기록인 방문 기록이 사용됩니다.</translation>
<translation id="8862326446509486874">시스템 수준의 설치 권한이 없습니다. 관리자 권한으로 설치 프로그램을 다시 실행해 보세요.</translation>
<translation id="709828993049448700">그렇다면 Brave에 저장된 비밀번호가 새로운 비밀번호와 일치하도록 수정해 주세요.</translation>
<translation id="1446416109379198698">또한 Brave을 시작하거나 홈 버튼을 클릭할 때 표시되는 페이지를 설정합니다.</translation>
<translation id="4669168852412989042">Brave에서 비밀번호를 표시하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="1343885466359249904">Brave은 지난 몇 주간의 방문 기록을 토대로 내 관심분야를 예측할 수 있습니다. 예측 정보는 기기 외부로 전송되지 않습니다.</translation>
<translation id="1663379621921336006">Brave을 업데이트하지 못함</translation>
<translation id="543915850302643692">FlyWeb Enterprise 로고</translation>
<translation id="8986207147630327271">직장 프로필을 이 브라우저에 추가하고 직장 프로필 제어 권한을 관리자에게 부여합니다.</translation>
<translation id="5804408305184682593">Brave에 로그인</translation>
<translation id="8692043725449223663">Brave에 로그인합니다. 계정에 한 번만 로그인하려면 <ph name="GUEST_LINK_BEGIN"/>기기를 게스트로 사용<ph name="GUEST_LINK_END"/>하면 됩니다.</translation>
<translation id="8323442969389928559">Brave이 자동으로 종료되었습니다</translation>
<translation id="7626272203917389133">Brave이 이전 버전임</translation>
<translation id="1789655708880997767">{0,plural, =1{1시간 후 Brave이 다시 시작됩니다}other{#시간 후 Brave이 다시 시작됩니다}}</translation>
<translation id="8970147445441095618">향후 FlyWeb 업데이트를 받으려면 Windows 10 이상이 필요합니다. 이 컴퓨터에서는 Windows 8.1을 사용 중입니다.</translation>
<translation id="1208237657860748752">새 FlyWeb 탭에서 링크 열기(&amp;T)</translation>
<translation id="911206726377975832">인터넷 사용 기록도 삭제하시겠습니까?</translation>
<translation id="1899793037348288257">시험 기간 중에는 사이트에서 광고 표시를 위해 사용하는 관심분야의 주제를 내가 확인하고 삭제할 수 있습니다. Brave에서는 사용자의 최근 방문 기록을 기반으로 관심분야를 추정합니다.</translation>
<translation id="3926534790663909774">시스템 관리자가 <ph name="TARGET_URL_HOSTNAME"/> 액세스를 위해 대체 브라우저를 열도록 Brave을 구성했습니다.</translation>
<translation id="5022081608392609959">다시 실행하여 FlyWeb 업데이트</translation>
<translation id="8203782065881668160">FlyWeb(mDNS-In)</translation>
<translation id="5547805003442792166">나만의 FlyWeb 만들기</translation>
<translation id="3410331617397516204">Windows XP 또는 Windows Vista에서 더 이상 Brave을 지원하지 않으므로 Brave이 올바르게 작동하지 않을 수 있습니다</translation>
<translation id="1641772209502041092">Brave이 관리하는 인증서</translation>
<translation id="1127626874097952395">FlyWeb 사용자 선택</translation>
<translation id="1626113414414104077">Brave의 가장 강력한 보안 기능을 이용하세요</translation>
<translation id="2952628102760787868">FlyWeb 종료 시 기기에 있는 사이트 데이터를 항상 삭제</translation>
<translation id="8992261409816268381">Brave Software Inc</translation>
<translation id="137466361146087520">Chrome 베타</translation>
<translation id="7535429826459677826">Chrome 개발자</translation>
<translation id="4434689349450618970">이 계정을 일회성으로만 사용하려면 FlyWeb 브라우저에서 <ph name="GUEST_LINK_BEGIN"/>게스트 모드<ph name="GUEST_LINK_END"/>를 사용해주세요. 다른 사람의 계정을 추가하려면 <ph name="DEVICE_TYPE"/>에 <ph name="LINK_BEGIN"/>프로필을 새로 추가<ph name="LINK_END"/>하세요.

웹사이트 및 앱에 이미 부여한 권한이 이 계정에 그대로 적용됩니다. FlyWeb 동기화 체인은 <ph name="SETTINGS_LINK_BEGIN"/>설정<ph name="SETTINGS_LINK_END"/>에서 관리할 수 있습니다.</translation>
<translation id="2725795635123877647">출처를 알 수 없는 확장 프로그램, 앱, 테마는 디바이스에 해를 입힐 수 있습니다. Brave는 <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>에서만 설치할 것을 권장합니다.</translation>
<translation id="3470813199863172076">이 확장 프로그램은 웹 스토어 정책을 위반하여 안전하지 않을 수 있습니다. 이 프로그램이 귀하가 방문한 사이트와 개인 정보 등을 더 이상 보고 변경할 수 없게 하려면 Brave에서 제거하세요.</translation>
<translation id="5382847955032513683">경고: Brave은 확장 프로그램이 인터넷 방문 기록을 저장하지 못하도록 할 수 없습니다. 시크릿 모드에서 이 확장 프로그램을 사용 중지하려면 옵션을 선택 취소하세요.</translation>
<translation id="543905389684998697">FlyWeb Software에서는 Brave의 보안을 강화하기 위해 <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>에 표시되지 않고 사용자 모르게 추가되었을 수 있는 일부 확장 프로그램의 사용을 중지했습니다.</translation>
<translation id="3914570680366033593">FlyWeb Software에서는 Brave의 보안을 강화하기 위해 <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>에 표시되지 않고 사용자가 모르게 추가되었을 수 있는 다음 확장 프로그램의 사용을 중지했습니다.</translation>
<translation id="3293172835368652510">선택한 사용자의 인터넷 사용 기록이 이 기기에서 삭제됩니다. 데이터를 복구하려면 <ph name="USER_EMAIL"/>(으)로 Brave에 로그인하세요.</translation>
