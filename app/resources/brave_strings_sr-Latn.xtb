<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="1026101648481255140">Nastavi instalaciju</translation>
<translation id="7099479769133613710">Ponovo pokreni da bi se &amp;Chrome OS ažurirao</translation>
<translation id="291426170030461697">FlyWeb preporučuje da pregledate ovaj dodatak</translation>
<translation id="1549005488226693697">Kada sajt zatraži da privatno predučitava linkove na stranici, FlyWeb koristi FlyWeb servere. Na taj način se vaš identitet krije od predučitanog sajta, ali FlyWeb saznaje koji sajtovi su unapred učitani.</translation>
<translation id="1065672644894730302">Podešavanja ne mogu da se pročitaju.

Neke funkcije su možda nedostupne i promene podešavanja neće biti sačuvane.</translation>
<translation id="8908267645832965492">Roditelj je isključio Dozvole za sajtove, aplikacije i dodatke za FlyWeb</translation>
<translation id="5557633153169217776">FlyWeb traži pristup vašoj lokalnoj mreži da bi mogao da pronađe i koristi uređaje u blizini</translation>
<translation id="6441390163669415879">Da biste pretražili određenu FlyWeb funkciju ili dodatak, unesite njihovu prečicu u traku za adresu, a zatim pritisnite izabrani taster na tastaturi</translation>
<translation id="9001750423919983557">Prikaži pretragu pomoću FlyWeb-a na sistemskoj paleti i uključi tastersku prečicu</translation>
<translation id="1368460307421081773">FlyWeb želi da izveze lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="112640046208448578">Identifikujte stvari ili mesta i kopirajte ili prevodite tekst. Kada koristite pretragu slika, snimak ekrana stranice se šalje na server. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb je podrazumevani pregledač</translation>
<translation id="4556715463645168547">Da biste proverili da li su lozinke bezbedne od upada u podatke i drugih bezbednosnih problema, <ph name="BEGIN_LINK"/>prijavite se u FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Kliknite na FlyWeb meni</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="1184145431117212167">Instalacija nije uspela jer vaša verzija Windows-a nije podržana.</translation>
<translation id="4380351562011537903">O FlyWeb-u</translation>
<translation id="853148447909557566">Dobijajte obaveštenja o praćenju cena uz FlyWeb na telefonu</translation>
<translation id="1203500561924088507">Hvala vam na instalaciji. Potrebno je da restartujete pregledač pre nego što počnete da koristite <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Kada otvorite pretragu slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski se šalju na server. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Dok ste prijavljeni, možete da koristite lozinke i drugo sa FlyWeb naloga u FlyWeb-u. Da biste to promenili, idite na Nalog u FlyWeb-u.</translation>
<translation id="7614508617663739435">Prikaži Gemini u FlyWeb-u na traci menija Mac-a</translation>
<translation id="832555967476614730">Da biste izabrali deo ekrana u Gemini-ju u FlyWeb-u, koristite tastersku prečicu.</translation>
<translation id="4750836834956739196">Dok je ova kartica bila neaktivna, memorija je oslobođena da bi FlyWeb bio brz. Možete da odaberete da uvek izuzmete ovaj sajt iz neaktivnosti.</translation>
<translation id="3190759351483708314">FlyWeb je blokirao ovo preuzimanje jer je ovaj fajl opasan</translation>
<translation id="5879469261638423015">Kada se prijavljujete u FlyWeb usluge kao što su Gmail ili YouTube pomoću naloga <ph name="USER_EMAIL"/>, možete automatski da se prijavite u FlyWeb pomoću istog naloga</translation>
<translation id="7142135954326264349">Preuzmite FlyWeb na telefon</translation>
<translation id="1290883685122687410">Greška pri podešavanju: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Podesite nov FlyWeb profil</translation>
<translation id="5252737639504553444">Isprobajte sa Gemini-jem u FlyWeb-u</translation>
<translation id="609743863669742325">FlyWeb zahteva pristup Bluetooth-u da bi istraživao 
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Prijavite se u FlyWeb na telefonu</translation>
<translation id="1330562121671411446">Otkriveni jezik</translation>
<translation id="2276527911011636666">Izbriši i podatke iz FlyWeb-a (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Zakačeno je. Možete ponovo da pristupite pretrazi slika pomoću novog dugmeta na traci s alatkama</translation>
<translation id="1383876407941801731">Pretraži</translation>
<translation id="1045149878186896649">Nastavite sa pregledanjem u pokretu uz aplikaciju FlyWeb</translation>
<translation id="141901961143729572">Delite razmišljanja</translation>
<translation id="2758515779140515865">Da biste delili prozor, dozvolite snimanje ekrana za FlyWeb u podešavanjima sistema.</translation>
<translation id="4713192356155907986">Potražite pomoć za verziju FlyWeb for Testing</translation>
<translation id="4984443629206419460">Prijavite se u FlyWeb da biste pristupali sačuvanim informacijama i drugom sa uređaja <ph name="DEVICE"/></translation>
<translation id="1497802159252041924">Greška pri instalaciji: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Ova stranica je zaštićena</translation>
<translation id="8962360511570172">Delite FlyWeb karticu</translation>
<translation id="2941487459666781243">Prijavi me u FlyWeb</translation>
<translation id="1547469039832541117">Završava istaknuti zadatak.</translation>
<translation id="3182893868355533457">Zakači FlyWeb</translation>
<translation id="852852907317361085">FlyWeb alatke za bezbednost</translation>
<translation id="481155564361715417">FlyWeb želi da izbriše podatke Menadžera lozinki. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="2846999307505917298">Koristite FlyWeb na najbolji način uz aplikaciju FlyWeb na telefonu</translation>
<translation id="3961251277542681013">Pregledajte ključne kontrole privatnosti i bezbednosti u FlyWeb-u</translation>
<translation id="1640672724030957280">Preuzimanje...</translation>
<translation id="1665602916345474427">Prijavljeni ste kao <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, sa pretplatom. Otvori meni naloga</translation>
<translation id="7625232007557474355">Možete da koristite FlyWeb svaki put kada kliknete na linkove u porukama, dokumentima i drugim aplikacijama. Biće zakačen i na traku zadataka.</translation>
<translation id="1709772298389099340">Pruža pune privilegije za <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">FlyWeb će uskoro izbrisati podatke pregledanja</translation>
<translation id="8939535770474283898">FlyWeb će probati da nadogradi navigacije na HTTPS</translation>
<translation id="2581127533455294937">FlyWeb podaci su obrisani</translation>
<translation id="7385422968404728039">FlyWeb će se restartovati za <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Kada HTTPS nije dostupan, FlyWeb će koristiti nebezbednu vezu bez upozorenja</translation>
<translation id="307170399141486420">Neka FlyWeb radi u pozadini</translation>
<translation id="5006568136491721884">Kliknite na <ph name="BEGIN_BOLD"/>Da<ph name="END_BOLD"/> u Windows obaveštenju da biste zakačili FlyWeb na traku zadataka radi brzog pristupa.</translation>
<translation id="2473319786107120819">Ponovo instaliraj FlyWeb</translation>
<translation id="2533324957407080119">FlyWeb pokušava da <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">Korisnik <ph name="EXISTING_USER"/> je već prijavljen. Da bi vam pregledanje bilo razdvojeno, prijavite se u FlyWeb preko svog profila kao <ph name="USER_EMAIL_ADDRESS"/>. Moći ćete da preuzmete i dodatke i drugo sa uređaja <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Sledeći put kada otvorite FlyWeb na uređaju <ph name="DEVICE_TYPE"/>, videćete upit da koristite FlyWeb menadžer lozinki.</translation>
<translation id="1838374766361614909">Obrišite pretragu</translation>
<translation id="3403116471618205223">Da biste izbrisali podatke pregledanja samo sa ovog uređaja, ali ne i sa FlyWeb naloga, <ph name="BEGIN_LINK"/>odjavite se iz FlyWeb-a<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Preuzmite FlyWeb na telefon da biste u pokretu otvarali ili pravili nove grupe kartica.</translation>
<translation id="3285741355512747610">Možete da upravljate FlyWeb nalozima na koje ste prijavljeni. FlyWeb nalozi se koriste za FlyWeb pregledač, Play prodavnicu, Gmail i drugo. Ako želite da dodate nalog za nekog drugog, npr. člana porodice, umesto toga dodajte novu osobu na svoj uređaj <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Saznajte više<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Pretražuj pomoću pretrage slika</translation>
<translation id="5054936737639982722">Korisnik <ph name="EXISTING_USER"/> je već prijavljen. Da bi vam pregledanje bilo razdvojeno, prijavite se u FlyWeb preko svog profila kao <ph name="USER_EMAIL_ADDRESS"/>. Dobićete i obeleživače i drugo sa <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Izaberite tekst</translation>
<translation id="4824940465467423308">Prijavljujete se pomoću naloga kojim se upravlja i dajete njegovom administratoru kontrolu nad FlyWeb profilom. FlyWeb podaci, kao što su aplikacije, obeleživači, istorija, lozinke i druga podešavanja, biće trajno povezani sa nalogom <ph name="USER_NAME"/>. Moći ćete da izbrišete te podatke preko Kontrolne table FlyWeb naloga, ali nećete moći da ih povežete sa nekim drugim nalogom. Možete opcionalno da napravite novi profil da bi postojeći FlyWeb podaci ostali odvojeni. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb štedi bateriju tako što ograničava aktivnosti u pozadini i vizuelne efekte, kao što je glatko skrolovanje i brzine kadrova videa. <ph name="BEGIN_LINK"/>Saznajte više o Uštedi energije<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Usluga ažuriranja FlyWeb-a</translation>
<translation id="7390382558747224642">Kada to uključite, možete da se prijavljujete na FlyWeb sajtove, kao što je Gmail, ali se ne prijavljujete u FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb ne reaguje. Želite li da ga odmah ponovo pokrenete?</translation>
<translation id="5866699689358760578">Vaša organizacija, <ph name="MANAGER"/>, zahteva da se prijavite u FlyWeb</translation>
<translation id="4035053306113201399">Treba da restartujete Chrome OS da biste primenili ažuriranje.</translation>
<translation id="3750729306035486751">FlyWeb je blokirao ovo preuzimanje jer se ovaj tip fajl ne preuzima često i može da bude opasan</translation>
<translation id="1953553007165777902">Preuzima se... Još <ph name="MINUTE"/> min</translation>
<translation id="6956650624767954726">FlyWeb ne može da odredi ni da podesi podrazumevani pregledač</translation>
<translation id="197326043290947695">Pregledajte pametnije uz pretragu slika</translation>
<translation id="130679046523922050">Saznajte zašto FlyWeb blokira neke fajlove, otvara se na novoj kartici</translation>
<translation id="8243822903505210769">Ažurira FlyWeb softver. Ako je ova usluga onemogućena ili zaustavljena, FlyWeb softver neće biti ažuriran, što znači da neće biti moguće otkloniti bezbednosne propuste koji mogu da nastanu i da funkcije možda neće raditi. Ova usluga se deinstalira kada je ne koristi nijedan FlyWeb softver.</translation>
<translation id="6495079989036864983">Ovim ćete izbrisati 1 stavku sa ovog uređaja. Da biste kasnije vratili podatke, prijavite se u FlyWeb kao <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalacija nije uspela. Probajte ponovo.</translation>
<translation id="2039417478970545937">Podešavanja.</translation>
<translation id="8544477465831682343">Odaberite da li ćete uvrstiti istoriju FlyWeb-a radi personalizovanijih doživljaja u FlyWeb uslugama</translation>
<translation id="328650761750741315">Ugrađen je u FlyWeb da bi vam pomogao da pravite, čuvate i automatski popunjavate jake lozinke. Dodajte prečicu radi lakšeg pristupa.</translation>
<translation id="2407746489237278840">Kliknite na dugme Prilagodi FlyWeb na stranici nove kartice da biste FlyWeb-u dali nov izgled</translation>
<translation id="8924891216494775926">FlyWeb je blokirao ovo preuzimanje jer je ovaj fajl obmanjujući i može da izvrši neočekivane promene na uređaj</translation>
<translation id="5728214838078602184">Sledeći put kada otvorite FlyWeb iOS, videćete upit da isprobate <ph name="FEATURE_NAME"/>.</translation>
<translation id="2058207584484841616">Lozinke i drugi FlyWeb podaci koje ste sačuvali na FlyWeb nalogu biće uklonjeni sa ovog uređaja. Da biste ih ponovo koristili u FlyWeb-u, ponovo se prijavite.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Organizacija automatski briše podatke pregledanja kada se FlyWeb ne koristi 1 minut. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Organizacija automatski briše podatke pregledanja kada se FlyWeb ne koristi # minut. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Organizacija automatski briše podatke pregledanja kada se FlyWeb ne koristi # minuta. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Organizacija automatski briše podatke pregledanja kada se FlyWeb ne koristi # minuta. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2125838419757773031">Izaberite deo ekrana za pretragu</translation>
<translation id="2126108037660393668">Verifikacija preuzetog fajla nije uspela.</translation>
<translation id="2135919691573380097">Prijavite ovaj sajt</translation>
<translation id="2137162749895930932">Zatvorite ekran za prevođenje</translation>
<translation id="2147218225094845757">Sakrij bočnu tablu</translation>
<translation id="4474394796469499134">FlyWeb je blokirao ovo preuzimanje jer ovaj sajt ne koristi bezbednu vezu, pa je fajl možda neovlašćeno menjan</translation>
<translation id="2170098639895543546">Izaberite bilo šta na stranici</translation>
<translation id="6765231735885996239">Prilagodite FlyWeb</translation>
<translation id="2174917724755363426">Instalacija nije dovršena. Želite stvarno da je otkažete?</translation>
<translation id="2937508664417729967">FlyWeb – prijavljivanje na mrežu – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Greška sa proverom ažuriranja: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Ukloni nalog iz FlyWeb-a</translation>
<translation id="744837314710861405">Koristite aplikaciju FlyWeb i ponesite sa sobom najbolje alatke za kupovinu</translation>
<translation id="2745381939758295588">Budite bezbedniji u pokretu uz poboljšano bezbedno pregledanje u FlyWeb-u za iOS</translation>
<translation id="6707114110652917144">Opasan sajt. FlyWeb je uklonio obaveštenja.</translation>
<translation id="2236949375853147973">Moje aktivnosti</translation>
<translation id="4646732243247482236">Da bi vam adrese i drugi sadržaj bili dostupni na svim uređajima, prijavite se u FlyWeb. Ova adresa će biti sačuvana na FlyWeb nalogu kada se prijavite.</translation>
<translation id="2726680594710751908">Ako delite računar, prijatelji i porodica mogu zasebno da pregledaju i da podese FlyWeb baš onako kako žele.</translation>
<translation id="4086571337340463916">Veštine u FlyWeb-u</translation>
<translation id="2283803047247799269">Pretraži ovu karticu pomoću pretrage slika</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb preporučuje da pauzirate karticu koja usporava pregledač}one{FlyWeb preporučuje da pauzirate kartice koje usporavaju pregledač}few{FlyWeb preporučuje da pauzirate kartice koje usporavaju pregledač}other{FlyWeb preporučuje da pauzirate kartice koje usporavaju pregledač}}</translation>
<translation id="2307973900865360088">Zadrži na traci</translation>
<translation id="5067150284614317159">Proverava URL-ove sa listom nebezbednih sajtova koji se čuvaju u FlyWeb-u. Ako neki sajt pokuša da ukrade vašu lozinku ili probate da preuzmete štetnu datoteku, FlyWeb može da pošalje URL-ove, uključujući delove sadržaja stranice, u Bezbedno pregledanje.</translation>
<translation id="2356070529366658676">Pitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="7339360994527471629">Dodatak <ph name="EXTENSION_NAME"/> želi da se prijavite u FlyWeb</translation>
<translation id="8788732221355188962">Onemogući FlyWeb koji radi u pozadini za aplikacije</translation>
<translation id="4126251160852694747">Da biste koristili ovaj dodatak kao <ph name="USER_EMAIL_ADDRESS"/>, prijavite se u FlyWeb.</translation>
<translation id="8418845734693287262">Chrome OS ne može da sinhronizuje podatke zato što su podaci za prijavljivanje na nalog zastareli.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Jedan ili više dodataka za FlyWeb su pristupali 1 HID uređaju}=1{Jedan ili više dodataka za FlyWeb pristupaju 1 HID uređaju}one{Jedan ili više dodataka za FlyWeb pristupaju # HID uređaju}few{Jedan ili više dodataka za FlyWeb pristupaju HID uređajima (#)}other{Jedan ili više dodataka za FlyWeb pristupaju HID uređajima (#)}}</translation>
<translation id="1364879203203742966">FlyWeb-u su potrebne dozvole za kameru i mikrofon za ovaj sajt</translation>
<translation id="2403703063067034158">Greška pri pokretanju: Trenutno je pokrenuta druga instanca podešavanja. Probajte ponovo kasnije.</translation>
<translation id="656987653252575654">Otvarajte linkove u FlyWeb-u iz bilo koje aplikacije i omogućite pristup pregledaču na traci zadataka</translation>
<translation id="157662717324308283">Kliknite na dugme Rezimiraj da biste podelili ovaj dokument sa Gemini-jem u FlyWeb-u radi brzog pregleda i postavljanja dodatnih pitanja</translation>
<translation id="1968013196034892522">Pomoću <ph name="BEGIN_LINK"/>FlyWeb alatki<ph name="END_LINK"/> možete bezbedno da pregledate i zadržite kontrolu</translation>
<translation id="1716762085628757512">Korisnik <ph name="EXISTING_USER"/> je već prijavljen. Da bi vam pregledanje bilo razdvojeno, prijavite se u FlyWeb preko svog profila kao <ph name="USER_EMAIL_ADDRESS"/>. Moći ćete da pristupate i svojim lozinkama i drugom sadržaju na svim uređajima.</translation>
<translation id="2451727308784734061">Koristite prečicu da biste brzo pristupali Menadžeru lozinki. Prečicu možete da premestite na početni ekran računara ili u pokretač aplikacija.</translation>
<translation id="3224379053610845181">FlyWeb će se uskoro zatvoriti</translation>
<translation id="3840682988105604367">U FlyWeb-u</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je restartovanje: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Izaberite tekst pomoću pretrage slika</translation>
<translation id="6823116595279840454">FlyWeb pokušava da zameni postojeće lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="2691552788029831386">FlyWeb traži pristup memorijskom prostoru da bi preuzimao datoteke</translation>
<translation id="2275866327478859777">FlyWeb pomagač</translation>
<translation id="2575822587468774919">Izaberite bilo šta za pretragu pomoću pretrage slika</translation>
<translation id="683641781063074351">Da bi vam lozinke i drugi sadržaj bili dostupni na svim uređajima, prijavite se u FlyWeb</translation>
<translation id="1659167470250249643">Skenirajte QR kôd telefonom da biste preuzeli FlyWeb i prijavili se na FlyWeb nalog.</translation>
<translation id="5353172248151202719">za pretraživanje pomoću FlyWeb-a.</translation>
<translation id="3231856291920394348">Nastavi sa korišćenjem FlyWeb-a</translation>
<translation id="259935314519650377">Keširanje preuzetog instalacionog programa nije uspelo. Greška: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="7683745685556117660">Organizacija može da vidi podatke pregledanja, poput obeleživača, istorije i lozinki, i da upravlja njima. Ne može da vidi podatke pregledanja na drugim FlyWeb profilima</translation>
<translation id="5862783156828836752">Potvrdite identitet da biste koristili i sačuvali FlyWeb podatke na nalogu, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="4450675160413947126">Pokreni FlyWeb</translation>
<translation id="3827993926722004004">Tokom instalacije je došlo do greške u operativnom sistemu. Preuzmite FlyWeb ponovo.</translation>
<translation id="333184635927514678">Ako delite uređaj, prijatelji i porodica mogu zasebno da pregledaju i da podese FlyWeb baš onako kako žele</translation>
<translation id="3917488635054382918">Jednostavan pristup za korišćenje Gemini-ja u FlyWeb-u na uređaju, čak i ako je FlyWeb minimizovan.</translation>
<translation id="1257705702166647105">Kartica FlyWeb</translation>
<translation id="2796283369875688710">FlyWeb će šifrovati podatke radi dodatne sigurnosti.</translation>
