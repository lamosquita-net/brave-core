<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hu">
<translation id="130631256467250065">A módosítások az eszköz következő újraindításakor lépnek életbe.</translation>
<translation id="1555506416658437797">fizetési módok szerkesztése.</translation>
<translation id="8359495463485001719">A hibajelentések nem állnak rendelkezésre a Braveban.</translation>
<translation id="6338530717474923868">Jelenleg biztonságos FlyWeb-oldalt tekint meg</translation>
<translation id="5147169001159408844">A FlyWeb módosítani próbálja a fizetési módok kitöltési beállításait.</translation>
<translation id="5702992568540613683">FlyWeb embléma</translation>
<translation id="510342522494506803">A FlyWeb szerkeszteni próbálja a fizetési módokat.</translation>
<translation id="8375862260948854624">A FlyWeb a <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> nyílt forráskódú projektnek és további <ph name="BEGIN_LINK_OSS"/>nyílt forráskódú szoftvereknek<ph name="END_LINK_OSS"/> köszönhetően jött létre.</translation>
<translation id="4281953335231207224">Lépjen ide:
          FlyWeb menü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          A helyi hálózat (LAN) beállításai,
          majd törölje a jelet a „Proxykiszolgáló használata a helyi hálózaton” jelölőnégyzetből.</translation>
<translation id="5040124620086808431">Ezt az oldalt a FlyWeb blokkolja</translation>
<translation id="1953000035868532675">A hálózat elérésének engedélyezése a FlyWeb számára a tűzfal-
          vagy vírusirtó-beállításokban.</translation>
<translation id="3442058224540562441">Lépjen ide:
          FlyWeb menü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>,
          és gondoskodjon róla, hogy a konfiguráció beállítása „nincs proxy” vagy „közvetlen” legyen.</translation>
<translation id="585620188971323280">módosítani próbálja a fizetési módok kitöltési beállításait.</translation>
<translation id="2681118099728446983">A Braveot létrejöttéhez más <ph name="BEGIN_LINK_OSS"/>nyílt forráskódú szoftverek<ph name="END_LINK_OSS"/> is hozzájárultak.</translation>
<translation id="6888846095017247017">Módosításai a FlyWeb újraindítása után lépnek érvénybe.</translation>
<translation id="1017070759373671177">A FlyWeb a <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> nyílt forráskódú projektnek köszönhetően jött létre.</translation>
<translation id="7777112741998051633">Lépjen ide:
        FlyWeb menü &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>,
        és törölje a jelet a(z) „<ph name="NO_PREFETCH_DESCRIPTION"/>” jelölőnégyzetből.
        Ha ettől nem szűnik meg a probléma, javasoljuk, hogy jelölje be ismét ezt a lehetőséget a jobb teljesítmény érdekében.</translation>
<translation id="8187289872471304532">Az Applications &gt; System Preferences &gt; Network &gt; Advanced &gt; Proxies (Alkalmazások &gt; Rendszerbeállítások &gt; Hálózat &gt; Speciális &gt; Proxyk) menüpont alatt törölje a jelet minden kijelölt proxy mellől.</translation>
<translation id="4699594416850504200">Jelenleg biztonságos FlyWeb for Testing-oldalt tekint meg.</translation>
<translation id="6224789938625024797">A FlyWeb nem záródott be megfelelően.</translation>
</translationbundle>