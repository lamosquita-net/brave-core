+// FlyWeb: true if |host| is non-empty and has none of the code points that the
+// URL Standard forbids in an opaque host (controls, space, "#/:<>?@[\]^|",
+// non-ASCII), so that it is serialized as is. See DoResolveRelativeURL().
+bool IsPlainOpaqueHost(const char* spec, const Component& host) {
+  if (!host.is_nonempty())
+    return false;
+  for (int i = host.begin; i < host.end(); i++) {
+    const unsigned char c = static_cast<unsigned char>(spec[i]);
+    if (c <= 0x20 || c >= 0x7F || strchr("#/:<>?@[\\]^|", c))
+      return false;
+  }
+  return true;
+}
