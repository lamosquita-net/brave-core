<translation id="5321339461210685340">የሥርዓት ኦዲዮን ለማጋራት የሥርዓት ቅንብሮችን ይክፈቱ እና ለBrave «የሥርዓት የኦዲዮ ቀረጻ ብቻ» ይፍቀዱ። ከዚያ Braveን እንደገና ማስጀመር ይኖርብዎታል።</translation>
<translation id="7299899569525778554">ከዴስክቶፕ ይፈልጉ</translation>
<translation id="2866611433272355726">Braveን በማዘመን ላይ...</translation>
<translation id="5013690772358862887">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

FlyWeb ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="7324051657739063017">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን እንደገና መክፈት ይችላሉ</translation>
<translation id="1123144153876435088">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የBrave ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="8915041713909379783">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ FlyWeb አይላክም ወይም በBrave አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK"/>በመለያዎ ውስጥ ያለውን FlyWeb ውሂብ መሰረዝ<ph name="END_LINK"/> ይኖርብዎታል።</translation>
<translation id="6760192061736180746">የእርስዎ ስርዓት አስተዳዳሪ FlyWeb <ph name="TARGET_URL_HOSTNAME"/>ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME"/>ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="7601756527349047847">የወደፊት የBrave ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="3916387280110223245">በቅርብ ጊዜ አልጎበኙም። FlyWeb <ph name="PERMISSION_1"/>፣ <ph name="PERMISSION_2"/>ን አስወግዷል።</translation>
<translation id="3313237823190188892">Geminiን በሥርዓት ትሪ ውስጥ በBrave ውስጥ አሳይ</translation>
<translation id="7401687852903179959">ይህን ቪድዮ በምስል ፍለጋ ፈልግ</translation>
<translation id="6624551989332401777">FlyWeb አሁን የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="277733508197886564">ካቆሙበት ይቀጥሉ፦ FlyWeb እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="948152006162936800">የይለፍ ቃላትን ወደ FlyWeb ያምጡ</translation>
<translation id="4755314372270379254">1. ከታች <ph name="BUTTON_LABEL"/> ላይ ጠቅ ያድርጉ
2. በWindows ቅንብሮችዎ ውስጥ <ph name="BUTTON_2"/> ላይ ጠቅ ያድርጉ
3. ለፈጣን መዳረሻ Braveን በተግባር አሞሌዎ ላይ ለመሰካት በWindows ማሳወቂያ ውስጥ <ph name="BUTTON_3"/> ላይ ጠቅ ያድርጉ</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb ግንባታ</translation>
<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="7472280958921965834">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK"/>የሥርዓት ቅንብሮች<ph name="END_LINK"/> ውስጥ ለBrave መዳረሻ ይስጡ</translation>
<translation id="2431618580332826398">የወደፊት የBrave ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="2154651873647244914">FlyWeb ዳግም ይጀመር?</translation>
<translation id="3137757192868162370">እየሄደ ያለውን ተመሳሳዩን የBrave ስሪት መጫን አይቻልም። እባክዎ Braveን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="3065486555702061722">አስታዋሽ፦ የBrave ምርጡ በኪስዎ ውስጥ</translation>
<translation id="4027434552262956425">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከBrave መለያዎ በስተቀር በ FlyWeb ውስጥ ገብተው ከሆነ፣ ሁሉንም የBrave መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{FlyWeb በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{FlyWeb በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="301074550630080641">ውሂብዎን ለመጠበቅ FlyWeb እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="3930051800510118744">በቅጽበት ማሰስ ለመጀመር Braveን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ጫኝ</translation>
<translation id="3067364763515000789">FlyWeb ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="1381291360713116383">FlyWeb አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="3892366519980032442">አሁን FlyWeb ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7624307931717240213">ይህን አገልግሎት ለማሻሻል መረጃ እንጠቀማለን። የግላዊነት መመሪያን እና የአገልግሎት ውልን ይመልከቱ።</translation>
<translation id="7649070708921625228">እገዛ</translation>
<translation id="7733015548570443346">የBrave መተግበሪያን ያግኙ</translation>
<translation id="7658239707568436148">ይቅር</translation>
<translation id="2230101319599356673">FlyWeb ነባሪ አሳሽዎ አይደለም</translation>
<translation id="3243257760331619874">በመላ መሣሪያዎችዎ ላይ Braveን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="3836891631266228927">FlyWeb ዝማኔ</translation>
<translation id="7362833186911891234">ሥራዎ FlyWeb ላይ ደኅንነቱ ተጠብቋል</translation>
<translation id="7716950018788545737">ተግባር(ራት) አልቋል(አልቀዋል)።</translation>
<translation id="77283119132245232">ለ<ph name="BROWSER_NAME"/> የሥርዓት ክትትል አገልግሎቶች ያቀርባል። ይህ አገልግሎት ከተሰናከለ በአሳሹ የተፈጠሩ የአፈጻጸም መከታተያዎች እንደ የዓውድ መቀያየሪያ እና ዝግጁ ተከታታይ ክስተቶች ያሉ ሥርዓት አቀፍ ክስተቶችን አያካትቱም።</translation>
<translation id="1549877678317463759">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL"/> ሆነው ወደ FlyWeb ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="104221467268393661">ወደ ነባሪ FlyWeb ዳግም አስጀምር</translation>
<translation id="2414061498125565915">በBrave ላይ ሥራዎን ደኅንነት ለመጠበቅ፣ ወደ FlyWeb ሲገቡ ድርጅትዎ የተወሰነ መረጃን ማየት ወይም ማስተዳደር ይችላል።</translation>
<translation id="494195283222791090">Braveን እንደ ነባሪ ያቀናብሩ እና የተግባር አሞሌው ላይ ይሰኩት</translation>
<translation id="134973275687829726">Braveን የበለጠ ፈጣን ያድርጉት</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">የበይነመረብ ትራፊክዎ መዳረሻ ላላቸው ሰዎች እርስዎ የትኞቹን ጣቢያዎች እንደሚጎበኙ ማየት ያክብዱባቸው። FlyWeb የጣቢያውን አይ ፒ አድራሻ በዲኤንኤስ (የጎራ ስም ሥርዓት) ውስጥ ለመፈለግ የተመሰጠረ ግንኙነትን ይጠቀማል።</translation>
<translation id="7810005234485217901">በቀላሉ ለመድረስ የምስል ፍለጋን ፒን ማድረግ ይችላሉ</translation>
<translation id="6059158364953614237">ከBrave ጋር ምን እንደሚያጋሩ ይምረጡ</translation>
<translation id="8463540467315366872">ይህን መለያ ያለው አንድ የBrave መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7845233973568007926">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME"/>ን ከመጠቀምዎ በፊት ኮምፒውተርዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="3682929584258119691">የፍለጋ ፕሮግራምዎ ከBrave ውጭ ተለውጧል። እርስዎን ለመጠበቅ FlyWeb ወደ መጀመሪያው ነባሪ ዳግም አስጀምሮታል። <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">Braveን አዲስ መልክ ለመስጠት ያብጁት</translation>
<translation id="8611872055947278722">FlyWeb ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። Braveን ማዘመን አለብዎት።</translation>
<translation id="7872446069773932638">በማውረድ ላይ... <ph name="SECONDS"/> ሰከንድ(ዶች) ይቀራሉ</translation>
<translation id="3999247564452560622">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK"/>በመለያዎ ውስጥ ያለውን የBrave ውሂብ ይሰርዙ<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">Geminiን በሚያስፈልግዎ ማንኛውም ጊዜ በBrave ውስጥ በፍጥነት ይክፈቱት</translation>
<translation id="6798431672720500005">Braveን እንደ ነባሪ ያቀናብሩት</translation>
<translation id="332151924263389003">FlyWeb በሚቻልበት ጊዜ ደህንነታቸው ያልተጠበቀ ግንኙነቶችን በራስ-ሰር ወደ ኤችቲቲፒኤስ ያልቃል</translation>
<translation id="3096730275883527801">እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ገብተዋል። እባክዎ እንደገና ለመግባት ተመሳሳዩን መለያ ይጠቀሙ።</translation>
<translation id="7097534420680357688"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የእርስዎን እልባቶች እና ሌሎችንም ያገኛሉ።</translation>
<translation id="9017338699075596174">ይሄ ሁለተኛ የBrave ጭነት ነው፣ እና ነባሪ አሳሽዎ ማድረግ አይቻልም።</translation>
<translation id="2888168499066553233">በእርስዎ <ph name="DEVICE_TYPE"/> ላይ በBrave መተግበሪያ የBrave ምርጡን ያግኙ</translation>
<translation id="8004582292198964060">አሳሽ</translation>
<translation id="8010081455002666927">በራስ-አግኝ</translation>
<translation id="5944585442866020176">አንዴ FlyWeb መዳረሻ ከኖረው በኋላ ድር ጣቢያዎች እርስዎን መዳረሻ መጠየቅ ይችላሉ።</translation>
<translation id="4462215250900528778">በማንኛውም ጊዜ በፍጥነት ወደ FlyWeb ለመሄድ ፒን ያድርጉት</translation>
<translation id="80471789339884597">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME"/>ን ከመጠቀምዎ በፊት ሁሉንም አሳሾችዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="8054112667659782652">የምስል ፍለጋ አቋራጭን ሁልጊዜ አሳይ</translation>
<translation id="8069447462453318634">«ወደ የመሣሪያ አሞሌ ሰካ» የሚለውን ይምረጡ</translation>
<translation id="3685797926747054412">FlyWeb ለመተግበሪያዎች በዳራ ውስጥ እንዳያሄድ አሰናክል</translation>
<translation id="80790299200510644">ምስል ፈልግ</translation>
<translation id="8086881907087796310">ኮምፒውተርዎ አነስተኛውን የሃርድዌር መስፈርቶች ስላላሟላ መጫኑ አልተሳካም።</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb ለሙከራ</translation>
<translation id="3263664073045388929">FlyWeb ለዚህ ጣቢያ የአካባቢ ፈቃድ ያስፈልገዋል</translation>
<translation id="5289593085778678155">በሚቀጥለው ጊዜ Braveን በእርስዎ <ph name="DEVICE_TYPE"/> ላይ ሲከፍቱ፣ የዋጋ ክትትል ማንቂያዎችን ለማንቃት ጥያቄ ያያሉ።</translation>
<translation id="7635444121786764725">በስልክዎ ላይ ባለው የBrave መተግበሪያ ላይ ፍላጎት ባሎት ንጥሎች ላይ የዋጋ ቅናሽ ማንቂያዎችን ያግኙ</translation>
<translation id="8118331347066725040">በሌንስ ለፍለጋ ግብረ መልስ ይላኩ</translation>
<translation id="5770057404954060005">Braveን የእርስዎ ያድርጉ</translation>
<translation id="5334309298019785904">ማስመር ለጎራዎ ስለማይገኝ ChromeOS ውሂብዎን ማስመር አይችልም።</translation>
<translation id="813913629614996137">በማስጀመር ላይ…</translation>
<translation id="6992240065504496864">Gemini በBrave ውስጥ በቁልፍ ሰሌዳ አቋራጭ ይክፈቱ።</translation>
<translation id="6334554715655789744">የBrave ተጨማሪ የአገልግሎት ውል</translation>
<translation id="1597323875619800374">ይህ ፋይል አደገኛ ስለሆነ FlyWeb አግዶታል።</translation>
<translation id="8177472873527554730">በገፅ ውስጥ ያለ ይዘትን ማግኘት አይቻልም</translation>
<translation id="2214224574148863941">FlyWeb ውሂብን በእርስዎ መለያ <ph name="USER_EMAIL"/> ውስጥ ለመጠቀም እና ለማስቀመጥ የይለፍ ሐረግዎን ያስገቡ</translation>
<translation id="820759916613250543">ይህን ምስል በምስል ፍለጋ ፈልግ</translation>
<translation id="8221491193165283816">ማሳወቂያዎችን ብዙውን ጊዜ ያግዳሉ። ይህን ጣቢያ ለእርስዎ እንዲያሳውቅዎት ለመፍቀድ፣ እዚህ ላይ ጠቅ ያድርጉ።</translation>
<translation id="2459467374982542273">ካሜራዎን ለመጠቀም <ph name="BEGIN_LINK"/>የሥርዓት ቅንብሮች<ph name="END_LINK"/> ውስጥ ለBrave መዳረሻ ይስጡ</translation>
<translation id="4749458995158778066">FlyWeb ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም፣ እና ደህንነቱ ያልተጠበቀ ሊሆን ይችላል። የግል መረጃን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎትን ውሂብ ማየት እና መለወጥ እንዳይችል ከBrave ያስወግዱት።</translation>
<translation id="6756872644564483342">አንድ ምስል ጠቃሚ መግለጫ ከሌለው FlyWeb ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ FlyWeb ይላካሉ። ይህን በማንኛውም ጊዜ በቅንብሮች ውስጥ ሊያጠፉት ይችላሉ።</translation>
<translation id="9179486248398668702">በአዲስ መገለጫ ወደ FlyWeb ይግቡ?</translation>
<translation id="1470002120352085290"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ። እንዲሁም ከ<ph name="DEVICE"/> የእርስዎን የይለፍ ቃላት እና ሌሎችንም ያገኛሉ።</translation>
<translation id="8901123396574346662">Geminiን በሥርዓት ትሪ ውስጥ በBrave ውስጥ ያሳዩ እና የቁልፍ ሰሌዳ አቋራጭን ያብሩ</translation>
<translation id="9102959605052547519">ደህንነታቸው ስላልተጠበቁ ጣቢያዎች እና ውርዶች <ph name="BEGIN_LINK"/>FlyWeb ያስጠነቅቅዎታል<ph name="END_LINK"/></translation>
<translation id="669999719045196468">በቅርብ ጊዜ አልጎበኙም። FlyWeb <ph name="PERMISSION"/>ን አስወግዷል።</translation>
<translation id="7136168924180047124">በBrave iOS መተግበሪያ ላይ በካሜራዎ የሚያዩትን ይሸምቱ፣ ይተርጉሙ እና ይለዩ</translation>
<translation id="867002910715789721">ወደ FlyWeb እንደ <ph name="USER_NAME"/> ለመግባት የሚሆን QR ኮድ</translation>
<translation id="8313851650939857356">የማስነሻ ስህተት፦ <ph name="STARTUP_ERROR"/></translation>
<translation id="208266011144024011">ድርጅትዎ FlyWeb ለ<ph name="TIMEOUT_DURATION"/> ያህል ሥራ ላይ ሳይውል ይዘጋዋል።</translation>
<translation id="8321888067342493336">እንደ ምስል አስቀምጥ</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> ከዚህ ቀደም Braveን እየተጠቀመ ነበር</translation>
<translation id="7009033378151348624">FlyWeb ውስጥ ክህሎቶችን አንቃ</translation>
<translation id="338142060986183805">በእርስዎ FlyWeb መለያ <ph name="ACCOUNT_EMAIL"/> ውስጥ FlyWeb ውሂብን መጠቀም ለመቀጠል Braveን ያዘምኑ</translation>
<translation id="7408894216012529448">የወደፊት የBrave ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 8 እየተጠቀመ ነው።</translation>
<translation id="8362914115861174987">ወደዚህ መተርጎም</translation>
<translation id="8367705492654390392">ማንኛውም ነገር ይጠይቁ</translation>
<translation id="5020916672477085422">የይለፍ ቃላትዎን እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ FlyWeb ይግቡ። በመለያ ከገቡ በኋላ ይህ የይለፍ ቃል በBrave መለያዎ ውስጥ ይቀመጣል።</translation>
<translation id="5417365165109189454">ከዚያ Braveን እንደገና መጀመር ይኖርብዎታል።</translation>
<translation id="4212474799248200893">FlyWeb እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK"/>ስለሚደገፉ ቅጥያዎች የበለጠ ይወቁ<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">ይህ ቅጥያ በገንቢው ከህትመት ወጥቷል እና ደህንነቱ የተጠበቀ ላይሆን ይችላል። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከBrave ያስወግዱት።</translation>
<translation id="3669395395617655404">የተወሰነ ውሂብ በBrave መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት FlyWeb ማንነትዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="5261590792975521002">{0,plural, =1{በአንድ ቀን ውስጥ Braveን ዳግም አስጀምር}one{በ# ቀኖች ውስጥ Braveን ዳግም አስጀምር}other{በ# ቀኖች ውስጥ Braveን ዳግም አስጀምር}}</translation>
<translation id="8438543370129609977">የምስል ፍለጋ ሲያደርጉ PDFዎችን ጨምሮ የገፁ ርዕስ፣ ዩአርኤል እና ይዘት ወደ አገልጋዩ ይላካሉ። <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">FlyWeb ውስጥ በምስል ፍለጋ ስለመፈለግ የበለጠ ይወቁ</translation>
<translation id="3101564993057563365">የጫኚው መዝገብ ተበላሽቷል ወይም ትክክል አይደለም። እባክዎ Braveን እንደገና ያውርዱ።</translation>
<translation id="5316851838033144902">FlyWeb Windows 10 ወይም ከዚያ በላይ ያስፈልገዋል።</translation>
<translation id="6760691951531758781">ከተፈለገ፦ የምርመራ እና የአጠቃቀም ውሂብ ወደ FlyWeb በራስ-ሰር በመላክ የChromeOS ባህሪያትን እና አፈጻጸምን እንዲሻሻል ያግዙ።</translation>
<translation id="2523037024749170569">FlyWeb መለያዎ ውስጥ የBrave ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="5989540778099253163">ወደ FlyWeb ለመግባት ጥያቄዎችን ያሳያል</translation>
