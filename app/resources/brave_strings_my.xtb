<!DOCTYPE translationbundle>
<translationbundle lang="my">
<translation id="1026101648481255140">ထည့်သွင်းမှု ဆက်လုပ်ရန်</translation>
<translation id="7099479769133613710">&amp;ChromeOS အပ်ဒိတ်လုပ်ရန်အတွက် ပြန်ဖွင့်ရန်</translation>
<translation id="291426170030461697">ဤနောက်ဆက်တွဲကို စစ်ဆေးရန် FlyWeb က အကြံပြုပါသည်</translation>
<translation id="1549005488226693697">ဝဘ်ဆိုက်က ၎င်း၏စာမျက်နှာရှိ လင့်ခ်များ သီးသန့်ကြိုဖွင့်ရန် တောင်းဆိုသောအခါ FlyWeb က FlyWeb ဆာဗာကို သုံးသည်။ ၎င်းက သင့်အထောက်အထားကို ကြိုဖွင့်ထားသည့် ဝဘ်ဆိုက်ထံမှ ဖျောက်ပေးသော်လည်း မည်သည့်ဝဘ်ဆိုက်ကို ကြိုဖွင့်ထားကြောင်း FlyWeb က လေ့လာသည်။</translation>
<translation id="1065672644894730302">သင့်စိတ်ကြိုက်များ ဖတ်၍မရပါ။

အချို့အင်္ဂရပ်များ မရရှိနိုင်ပါ၊ စိတ်ကြိုက်များသို့ ပြောင်းလဲခြင်းများ သိမ်းမည်မဟုတ်ပါ။</translation>
<translation id="8908267645832965492">FlyWeb အတွက် “ဝဘ်ဆိုက်၊ အက်ပ်နှင့် နောက်ဆက်တွဲ ခွင့်ပြုချက်များ” ကို သင့်မိဘက ပိတ်လိုက်သည်</translation>
<translation id="6896681084876612310">ဒေတာပေါက်ကြားမှု၊ ဘေးကင်းမှုမရှိသော နောက်ဆက်တွဲနှင့် အခြားအန္တရာယ်များမှ သင့်ကိုလုံခြုံအောင် FlyWeb က ကူညီပေးနိုင်သည်</translation>
<translation id="1368460307421081773">FlyWeb သည် သင်၏ စကားဝှက်များကို တင်ပို့လိုသည်။ ၎င်းကို ခွင့်ပြုရန် သင်၏ Windows စကားဝှက်ကို ထည့်ပါ။</translation>
<translation id="7307912249127683931">FlyWeb သည် သင်၏ မူရင်းဘရောင်ဇာဖြစ်သည်</translation>
<translation id="4556715463645168547">သင်၏စကားဝှက်များတွင် ဒေတာပေါက်ကြားမှုနှင့် အခြားသော လုံခြုံရေးပြဿနာများ ရှိ၊ မရှိ စစ်ဆေးရန် <ph name="BEGIN_LINK"/>FlyWeb သို့ လက်မှတ်ထိုးဝင်ပါ<ph name="END_LINK"/>။</translation>
<translation id="2076135703183650206">FlyWeb မီနူးကို နှိပ်ပါ</translation>
<translation id="1184145431117212167">သင်၏ Windows ဗားရှင်းကို ပံ့ပိုးမထားသောကြောင့် ထည့်သွင်း၍ မရလိုက်ပါ။</translation>
<translation id="4380351562011537903">FlyWeb အကြောင်း</translation>
<translation id="2593084789070248821">သင့်ဝင်းဒိုးကို မျှဝေရန် ‘စနစ်သတ်မှတ်ချက်များ’ တွင် FlyWeb အတွက် ဖန်သားပြင်ရိုက်ကူးခြင်းကို ခွင့်ပြုပါ။</translation>
<translation id="1203500561924088507">ထည့်သွင်းသည့်အတွက် ကျေးဇူးတင်ပါသည်။ <ph name="BUNDLE_NAME"/> အသုံးမပြုမီ သင့်ဘရောင်ဇာကို ပြန်စရမည်။</translation>
<translation id="4750836834956739196">FlyWeb မြန်ဆန်စေရန်အတွက် ဤတဘ် အသုံးမပြုစဉ် မှတ်ဉာဏ်ကို နေရာလွတ်ပြုလုပ်ထားသည်။ ဤဝဘ်ဆိုက်ကို အသုံးမပြုသည့်စာရင်းမှ အမြဲဖယ်ထုတ်ထားရန် ရွေးနိုင်သည်။</translation>
<translation id="3190759351483708314">ဖိုင်သည် အန္တရာယ်ရှိသဖြင့် FlyWeb က ဤဒေါင်းလုဒ်ကို ပိတ်ထားသည်</translation>
<translation id="5879469261638423015">Gmail (သို့) YouTube ကဲ့သို့ FlyWeb ဝန်ဆောင်မှုများသို့ <ph name="USER_EMAIL"/> ဖြင့် လက်မှတ်ထိုးဝင်သောအခါ ယင်းအကောင့်ဖြင့် FlyWeb သို့ အလိုအလျောက် လက်မှတ်ထိုးဝင်နိုင်သည်</translation>
<translation id="1290883685122687410">စနစ်ထည့်သွင်းမှု အမှားအယွင်း- <ph name="METAINSTALLER_EXIT_CODE"/>။ <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">သင်၏ FlyWeb ပရိုဖိုင်အသစ်ကို စနစ်ထည့်သွင်းပါ</translation>
<translation id="609743863669742325">FlyWeb သည် ဘလူးတုသ်သုံးစက်များကို ရှာဖွေရန်
 ဘလူးတုသ်သုံးခွင့် လိုအပ်သည်။ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">FlyWeb (<ph name="URL"/>) မှဒေတာကိုလည်း ဖျက်ရန်</translation>
<translation id="4150708158890309866">သင်သည် FlyWeb သို့ဝင်ရောက်ပြီးဖြစ်သည်!</translation>
<translation id="4713192356155907986">FlyWeb for Testing အတွက် အကူအညီရယူရန်</translation>
<translation id="1497802159252041924">တပ်ဆင်မှုအမှား- <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">FlyWeb တဘ် မျှဝေခြင်း</translation>
<translation id="8196829963313696543">သင့်ပတ်ဝန်းကျင်၏ 3D မြေပုံ ပြုလုပ်ရန် FlyWeb က သင့်ကင်မရာကို အသုံးပြုခွင့် လိုအပ်သည်</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{ဤနောက်ဆက်တွဲကို မပံ့ပိုးတော့ပါ။ ၎င်းကို ဖယ်ရှားရန် FlyWeb က အကြံပြုပါသည်။}other{ဤနောက်ဆက်တွဲများကို မပံ့ပိုးတော့ပါ။ ၎င်းတို့ကို ဖယ်ရှားရန် FlyWeb က အကြံပြုပါသည်။}}</translation>
<translation id="852852907317361085">FlyWeb ၏ လုံခြုံရေးတူးလ်များ</translation>
<translation id="4096742538387076253">ဒေတာအချို့ကို သင့် FlyWeb sync chain တွင် မသိမ်းမီ၊ သင့်စက်အားလုံးတွင် မသုံးမီ FlyWeb သည် သင်ဖြစ်ကြောင်း အတည်ပြုရန်လိုသည်။ ထွက်ပါက ဤဒေတာသည် ဤစက်တွင် ဆက်ရှိပါမည်။</translation>
<translation id="481155564361715417">FlyWeb က သင်၏ Password Manager ဒေတာကို ဖျက်လိုသည်။ ၎င်းကိုခွင့်ပြုရန် သင်၏ Windows စကားဝှက်ကို ရိုက်ပါ။</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{အပ်ဒိတ်ကို အသုံးပြုနိုင်ရန်အတွက် FlyWeb ကို ပြန်လည်စတင်ရန် သင်၏စီမံခန့်ခွဲသူက တောင်းဆိုထားပါသည်}=1{အပ်ဒိတ်ကို အသုံးပြုနိုင်ရန်အတွက် FlyWeb ကို ပြန်လည်စတင်ရန် သင်၏စီမံခန့်ခွဲသူက တောင်းဆိုထားပါသည်။ သင်၏ရုပ်ဖျက် ဝင်ဒိုးကို ပြန်ဖွင့်မည် မဟုတ်ပါ။}other{အပ်ဒိတ်ကို အသုံးပြုနိုင်ရန်အတွက် FlyWeb ကို ပြန်လည်စတင်ရန် သင်၏စီမံခန့်ခွဲသူက တောင်းဆိုထားပါသည်။ သင်၏ရုပ်ဖျက် ဝင်ဒိုး # ခုကို ပြန်ဖွင့်မည် မဟုတ်ပါ။}}</translation>
<translation id="3961251277542681013">အဓိကကျသော ကိုယ်ရေးအချက်အလက်နှင့် လုံခြုံရေး ထိန်းချုပ်မှုများကို FlyWeb တွင် ကြည့်နိုင်သည်</translation>
<translation id="4434689349450618970">ဤအကောင့်ကို တစ်ကြိမ်သာအသုံးပြုလိုပါက FlyWeb ဘရောင်ဇာတွင် <ph name="GUEST_LINK_BEGIN"/>ဧည့်သည်မုဒ်<ph name="GUEST_LINK_END"/> သုံးနိုင်သည်။ အခြားတစ်ယောက်အတွက် အကောင့်ထည့်လိုပါက သင်၏ <ph name="DEVICE_TYPE"/> တွင် <ph name="LINK_BEGIN"/>ပုဂ္ဂိုလ်အသစ်ကို ထည့်နိုင်သည်<ph name="LINK_END"/>။

ဝဘ်ဆိုက်နှင့် အက်ပ်များကို ပေးထားသော ခွင့်ပြုချက်များက ဤအကောင့်တွင် အကျုံးဝင်နိုင်သည်။ <ph name="SETTINGS_LINK_BEGIN"/>ဆက်တင်များ<ph name="SETTINGS_LINK_END"/> တွင် သင်၏ FlyWeb sync chain များကို စီမံနိုင်သည်။</translation>
<translation id="1640672724030957280">ဒေါင်းလုဒ်လုပ်နေသည်…</translation>
<translation id="6153580651793156880">ဤဝန်ဆောင်မှုများ ပိုကောင်းမွန်စေရန် FlyWeb က သင်၏ ပြန်လှန်တုံ့ပြန်မှုများကို ၎င်းတို့နှင့်အတူ FlyWeb ထံသို့ပို့သည်။ ဤဒေတာကို သုံးသပ်ချက်ပေးသူ ပုဂ္ဂိုလ်များဖြင့် ဖတ်ပြီး စီမံဆောင်ရွက်ကာ မှတ်ချက်ရေးနိုင်သည်။</translation>
<translation id="1722488837206509557">၎င်းသည် ရနိုင်သောစက်များမှ ရွေးပြီး ၎င်းတို့တွင် အကြောင်းအရာပြရန် သင့်အားခွင့်ပြုမည်။</translation>
<translation id="2383861520542390014">ကြော်ငြာပြရန်သုံးသည့် သင်စိတ်ဝင်စားသော ဝဘ်ဆိုက်များ၏ အကြောင်းအရာများကို ကြည့်ကာ ဖယ်ရှားနိုင်သည်။ သင့်လတ်တလော ကြည့်ရှုခြင်းမှတ်တမ်းအပေါ်မူတည်၍ သင့်စိတ်ဝင်စားမှုများကို FlyWeb က ခန့်မှန်းသည်။</translation>
<translation id="5695205873161614119">FlyWeb သည် ဖွင့်ကြည့်ထားသည့်မှတ်တမ်းဒေတာကို မကြာမီဖျက်ပါမည်</translation>
<translation id="8939535770474283898">FlyWeb က လမ်းညွှန်မှုများကို HTTPS သို့ အဆင့်မြှင့်ရန် ကြိုးစားပါမည်</translation>
<translation id="7385422968404728039">FlyWeb ကို <ph name="REMAINING_TIME"/> အတွင်း ပြန်စမည်</translation>
<translation id="6903827847227122616">HTTPS မရနိုင်သောအခါ FlyWeb က လုံခြုံမှုမရှိသည့် ချိတ်ဆက်မှုကို သင့်အားသတိမပေးဘဲ အသုံးပြုပါမည်</translation>
<translation id="307170399141486420">FlyWeb ကို နောက်ခံမှာ အလုပ်လုပ်ပါစေ</translation>
<translation id="543905389684998697">FlyWeb ပိုပြီး လုံခြုံစေရန် အတွက်၊ ကျွန်ုပ်တို့သည် <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>ထဲမှာ ဖေါ်ပြမထားသည့်၊ သင် မသိဘဲနှင့် ထည့်ပေးထားတာ ဖြစ်နိုင်သည့်၊ တိုးချဲ့မှု အချို့ကို ပိတ်ထားပါသည်။</translation>
<translation id="2473319786107120819">FlyWeb ကို ပြန်လည်တပ်ဆင်ရန်</translation>
<translation id="2533324957407080119">FlyWeb လုပ်ဆောင်နေသည်မှာ <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="3403116471618205223">ဖွင့်ကြည့်ထားသည့်မှတ်တမ်းဒေတာကို ဤစက်မှသာ ဖျက်ပြီး သင့် FlyWeb sync chain တွင် သိမ်းထားရန် <ph name="BEGIN_LINK"/>FlyWeb မှ အကောင့်ထွက်ပါ<ph name="END_LINK"/>။</translation>
<translation id="4630629063306099328">သင်လက်မှတ်ထိုးဝင်ထားသော FlyWeb sync chain များကို စီမံနိုင်သည်။ FlyWeb ဘရောင်ဇာ၊ Play Store၊ Gmail စသည်တို့အတွက် သင်၏ FlyWeb sync chain များကို သုံးသည်။ မိသားစုဝင်ကဲ့သို့ တစ်စုံတစ်ယောက်အတွက် အကောင့်ထည့်လိုပါက ၎င်းအစား ထိုပုဂ္ဂိုလ်အသစ်ကို သင့် <ph name="DEVICE_TYPE"/> တွင် ထည့်ပါ။ <ph name="LINK_BEGIN"/>ပိုမိုလေ့လာရန်<ph name="LINK_END"/></translation>
<translation id="6434738578659849497">ဝဘ်ဆိုက်များသည် သင်၏စိတ်ဝင်စားမှုများကို FlyWeb တွင် သိမ်းနိုင်သည်။ ဥပမာ မာရသွန်အတွက် ရှူးဖိနပ်ဝယ်ရန် ဝဘ်ဆိုက်တွင်ဝင်ကြည့်ပါက ဝဘ်ဆိုက်သည် သင်၏စိတ်ဝင်စားမှုကို မာရသွန်ပြေးခြင်းအဖြစ် သတ်မှတ်နိုင်သည်။ နောင်တွင် ပြိုင်ပွဲအတွက်စာရင်းသွင်းရန် အခြားဝဘ်ဆိုက်သို့ ဝင်ကြည့်သောအခါ ထိုဝဘ်ဆိုက်က သင်၏စိတ်ဝင်စားမှုများပေါ် အခြေခံပြီး အပြေးဖိနပ်ကြော်ငြာကို ပြနိုင်သည်။</translation>
<translation id="4824940465467423308">သင်သည်  စီမံကွပ်ကဲထားသည့် အကောင့် ထဲသို့ လက်မှတ် ထိုးဝင်နေကာ စီမံအုပ်ချုပ်သူအား
 သင့် FlyWeb ပရိုဖိုင်ကို ထိန်းချုပ်ခွင့်ကို လွှဲပေးနေသည်။ သင်၏ အက်ပ်များ၊စာညှပ်များ၊ မှတ်တမ်း၊ စကားဝှက်များ၊ နှင့် အခြား ဆက်တင်များလို သင်၏ FlyWeb ဒေတာများမှာ <ph name="USER_NAME"/> သို့ ထာဝရ ချိတ်တွဲလျက် ရှိလာကြမည်။ သင်သည်  ဒီဒေတာကို FlyWeb အကောင့်များ ဒိုင်ခွက်မှ တစ်ဆင့် ဖျက်လို့ ရနိုင်သော်လည်း၊ သင်သည် ၎င်းဒေတာကို အခြား အကောင့်နှင့် ဆက်စပ်၍ မရနိုင်ပါ။ သင်သည် သင်၏ ရှိနေဆဲ FlyWeb ဒေတာကို ထားရှိရန် အတွက် ပရိုဖိုင် အသစ်ကို ပြုလုပ်ရန် ရွေးနိုင်ပါသည်။ ပိုမို လေ့လာရန်။ <ph name="LEARN_MORE"/></translation>
<translation id="3665070894458449212">လိပ်စာဘား (သို့) ရှာဖွေစာလုံးဖြည့်ကွက်လပ်တွင် စာရိုက်သောအခါ ဖိုင်အကြံပြုချက်များ ရယူရန်အတွက် FlyWeb သည် သင်ရိုက်ထည့်သောအရာကို Google Drive သို့ ပို့သည်။ ၎င်းသည် ‘ရုပ်ဖျက်’ တွင် ပိတ်နေမည်။</translation>
