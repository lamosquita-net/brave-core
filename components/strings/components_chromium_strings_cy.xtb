<!DOCTYPE translationbundle>
<translationbundle lang="cy">
<translation id="130631256467250065">Bydd eich newidiadau yn dod i rym y tro nesaf y byddwch yn ailgychwyn eich dyfais.</translation>
<translation id="125853961893919199">Awgrym FlyWeb: Cadw Cyfrineiriau</translation>
<translation id="1589233279653618219">Ewch i
          ddewislen FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          a gwnewch yn siŵr bod eich ffurfweddiad wedi'i osod i "dim dirprwy weinydd" neu i "uniongyrchol."</translation>
<translation id="8359495463485001719">Nid yw adrodd am doriadau ar gael yn FlyWeb.</translation>
<translation id="6338530717474923868">Rydych yn edrych ar dudalen FlyWeb ddiogel</translation>
<translation id="5147169001159408844">Mae FlyWeb yn ceisio addasu gosodiadau ar gyfer llenwi dulliau talu.</translation>
<translation id="5702992568540613683">Logo FlyWeb</translation>
<translation id="8966580353365544289">Awgrym FlyWeb: Gwell Pori'n Ddiogel</translation>
<translation id="510342522494506803">Mae FlyWeb yn ceisio golygu dulliau talu.</translation>
<translation id="8375862260948854624">Mae FlyWeb yn bosib oherwydd prosiect ffynhonnell agored <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> a <ph name="BEGIN_LINK_OSS"/>meddalwedd ffynhonnell agored<ph name="END_LINK_OSS"/> eraill.</translation>
<translation id="5040124620086808431">Mae'r dudalen hon wedi'i rhwystro gan FlyWeb</translation>
<translation id="1953000035868532675">Caniatewch i FlyWeb gael mynediad at y rhwydwaith yn eich gosodiadau wal dân neu 
         wrthfeirysau.</translation>
<translation id="4949828774841497663">Ewch i Apiau &gt; Gosodiadau System &gt; Rhwydwaith, dewiswch y
          rhwydwaith gweithredol, cliciwch ar y botwm Manylion... a dad-ddewiswch unrhyw ddirprwyon gweinydd
          a allai fod wedi cael eu dewis.</translation>
<translation id="7584668345330431749">Ewch i
          ddewislen FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Rhwydwaith a rhyngrwyd &gt; Dirprwy weinydd
          a dad-ddewis "Canfod gosodiadau yn awtomatig".</translation>
<translation id="3145451630329266064">Mae'r tudalennau hyn wedi'u bwriadu i'w defnyddio gan ddatblygwyr FlyWeb, ac mae'n bosib na fyddant yn cael eu cynnal na'u profi'n weithredol. Er mwyn eu galluogi, llywiwch i <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, cliciwch ar y botwm i alluogi tudalennau dadfygio, ac yna llywiwch i'r dudalen hon eto.</translation>
<translation id="2681118099728446983">Mae FlyWeb hefyd yn bosib oherwydd <ph name="BEGIN_LINK_OSS"/>meddalwedd ffynhonnell agored<ph name="END_LINK_OSS"/> eraill.</translation>
<translation id="6888846095017247017">Bydd eich newidiadau yn dod i rym y tro nesaf y byddwch yn ail-lansio FlyWeb.</translation>
<translation id="8524328905288851065">Mae angen mynediad Bluetooth ar FlyWeb i barhau i 
baru <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">Mae FlyWeb yn bosib oherwydd y prosiect ffynhonnell agored <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Ewch i
          ddewislen FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          a dad-ddewiswch "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Os na fydd hyn yn datrys y broblem, rydym yn argymell dewis yr opsiwn hwn
          eto ar gyfer perfformiad gwell.</translation>
<translation id="4699594416850504200">Rydych yn edrych ar dudalen FlyWeb for Testing ddiogel</translation>
<translation id="6224789938625024797">Ni wnaeth FlyWeb gau'n gywir.</translation>
<translation id="3593104813552438879">Awgrym FlyWeb: Chwilio â Google Lens</translation>
</translationbundle>