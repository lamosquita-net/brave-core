+RubyBlockPositionCalculator& RubyBlockPositionCalculator::GroupLines(
+    const HeapVector<Member<LogicalRubyColumn>>& column_list) {
+  HandleRubyLine(EnsureRubyLine(RubyLevel()), column_list);
+  return *this;
