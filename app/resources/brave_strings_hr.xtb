<translation id="7288567540154601580">Kartice i proširenja</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{FlyWeb preporučuje da ga uklonite}one{FlyWeb preporučuje da ih uklonite}few{FlyWeb preporučuje da ih uklonite}other{FlyWeb preporučuje da ih uklonite}}</translation>
<translation id="5321339461210685340">Da biste dijelili zvuk sustava, otvorite postavke sustava i dopustite samo snimanje zvuka sustava za FlyWeb. Zatim ćete trebati ponovno pokrenuti FlyWeb.</translation>
<translation id="7299899569525778554">Pretraživanje s računala</translation>
<translation id="2866611433272355726">Ažuriranje Bravea</translation>
<translation id="5013690772358862887">Datoteka vaših postavki oštećena je ili nevažeća.

FlyWeb ne može oporaviti vaše postavke.</translation>
<translation id="7324051657739063017">Možete ponovno otvoriti kontekstualne zadatke da biste postavljali pitanja dok pregledavate</translation>
<translation id="1123144153876435088">Ovdje se nalaze vaš web, oznake i ostali sadržaji u Braveu.</translation>
<translation id="8915041713909379783">Vaše šifrirane podatke može pročitati samo osoba koja ima vašu šifru. Šifra se ne šalje Braveu niti se pohranjuje na Braveu. Ako zaboravite šifru ili želite promijeniti tu postavku, trebat ćete <ph name="BEGIN_LINK"/>izbrisati Braveove podatke na računu<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">Vaš administrator sustava konfigurirao je FlyWeb da otvara <ph name="ALTERNATIVE_BROWSER_NAME"/> za pristup URL-u <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">Nešto nije u redu</translation>
<translation id="7601756527349047847">Da biste primali buduća Braveova ažuriranja, trebat će vam macOS 13 ili novija verzija. Na ovom se računalu upotrebljava macOS 12.</translation>
<translation id="3916387280110223245">U posljednje vrijeme niste posjećivali web-lokaciju. FlyWeb je uklonio dopuštenja <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>.</translation>
<translation id="3313237823190188892">Prikaži Gemini u Braveu na traci sustava</translation>
<translation id="7401687852903179959">Pretražite ovaj videozapis pomoću pretraživanja slika</translation>
<translation id="6624551989332401777">FlyWeb je sada vaš zadani preglednik</translation>
<translation id="277733508197886564">Nastavite tamo gdje ste stali: FlyWeb vraća vaše kartice svaki put kada ponovno pokrenete sesiju. Da biste to isključili, otvorite</translation>
<translation id="948152006162936800">Uvoz zaporki u FlyWeb</translation>
<translation id="4755314372270379254">1. Kliknite <ph name="BUTTON_LABEL"/> u nastavku
2. Kliknite <ph name="BUTTON_2"/> u postavkama Windowsa
3. Kliknite <ph name="BUTTON_3"/> u obavijesti Windowsa da biste prikvačili FlyWeb na traku sa zadacima radi brzog pristupa</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> – FlyWeb Dev</translation>
<translation id="7450541714075000668">Tekst kopiran</translation>
<translation id="7472280958921965834">Da biste upotrebljavali mikrofon, odobrite Braveu pristup u <ph name="BEGIN_LINK"/>sistemskim postavkama<ph name="END_LINK"/></translation>
<translation id="2431618580332826398">Da biste primali buduća Braveova ažuriranja, trebat će vam Windows 10 ili novija verzija. Na ovom se računalu upotrebljava Windows 7.</translation>
<translation id="2154651873647244914">Ponovo pokrenuti FlyWeb?</translation>
<translation id="3137757192868162370">Ne možete instalirati istu verziju Bravea koja se trenutačno izvršava. Zatvorite FlyWeb i pokušajte ponovo.</translation>
<translation id="3065486555702061722">Podsjetnik: najbolje od Bravea u vašem džepu</translation>
<translation id="4027434552262956425">Web-lokacije će vjerojatno funkcionirati prema očekivanjima. Kad zatvorite sve prozore Bravea, odjavit ćete se s većine web-lokacija osim FlyWeb računa ako ste prijavljeni na FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb će se ponovo pokrenuti za jednu minutu}one{FlyWeb će se ponovo pokrenuti za # min}few{FlyWeb će se ponovo pokrenuti za # min}other{FlyWeb će se ponovo pokrenuti za # min}}</translation>
<translation id="301074550630080641">Da biste zaštitili svoje podatke, dopustite Braveu da ukloni dopuštenja s web-lokacija koje niste posjetili u posljednje vrijeme.</translation>
<translation id="3930051800510118744">Automatski pokrenite FlyWeb da biste odmah počeli pregledavati.</translation>
<translation id="7583399374488819119">Program za instalaciju <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">FlyWeb upotrebljava vašu kameru i mikrofon.</translation>
<translation id="1381291360713116383">FlyWeb je upravo postao bolji</translation>
<translation id="3892366519980032442">Sada imate više dostupnih značajki u Braveu</translation>
<translation id="7624307931717240213">Podatke upotrebljavamo za poboljšanje ove usluge. Pročitajte pravila o privatnosti i uvjete pružanja usluge.</translation>
<translation id="7649070708921625228">Pomoć</translation>
<translation id="7733015548570443346">Preuzmite aplikaciju FlyWeb</translation>
<translation id="7658239707568436148">Odustani</translation>
<translation id="2230101319599356673">FlyWeb nije vaš zadani preglednik</translation>
<translation id="3243257760331619874">Sinkronizirajte FlyWeb kako bi bio prilagođen vama na svim vašim uređajima</translation>
<translation id="3836891631266228927">Ažuriranje Bravea</translation>
<translation id="7362833186911891234">Vaš je rad siguran u Braveu</translation>
<translation id="7716950018788545737">Zadaci su dovršeni.</translation>
