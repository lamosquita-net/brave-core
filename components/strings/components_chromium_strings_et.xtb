<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="et">
<translation id="130631256467250065">Muudatused jõustuvad järgmine kord, kui seadme taaskäivitate.</translation>
<translation id="125853961893919199">Bravei nõuanne: salvestage paroolid</translation>
<translation id="1589233279653618219">Minge
          Bravei menüüsse &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ja veenduge, et konfiguratsioon on määratud valikule „Puhverserverita” või „Otse”.</translation>
<translation id="8359495463485001719">Krahhiaruandlus ei ole Braveis saadaval.</translation>
<translation id="6338530717474923868">Vaatate turvalist Bravei lehte</translation>
<translation id="5147169001159408844">FlyWeb proovib muuta makseviiside sisestamise seadeid.</translation>
<translation id="5702992568540613683">Bravei logo</translation>
<translation id="8966580353365544289">Bravei nõuanne: täiustatud ohutu sirvimine</translation>
<translation id="510342522494506803">FlyWeb üritab muuta makseviise.</translation>
<translation id="8375862260948854624">Bravei aluseks on avatud lähtekoodiga projekt <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ja muu <ph name="BEGIN_LINK_OSS"/>avatud lähtekoodiga tarkvara<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">FlyWeb blokeeris selle lehe</translation>
<translation id="1953000035868532675">Lubage Bravei juurdepääs võrgule tulemüüri või viirusetõrje
         seadetes.</translation>
<translation id="4949828774841497663">Avage Applications &gt; System Settings &gt; Network, valige
          aktiivne võrk, klõpsake nupul Details... ja tühistage mis tahes puhverserverite valikud,
          mis võisid olla valitud.</translation>
<translation id="7584668345330431749">Avage
          Bravei menüü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Võrk ja internet &gt; Puhverserver
          ning tühistage valik „Tuvasta seaded automaatselt“.</translation>
<translation id="3145451630329266064">Need lehed on mõeldud kasutamiseks Bravei arendajatele ning neid ei pruugita aktiivselt hooldada ega testida. Silumislehtede lubamiseks navigeerige lingile <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, klõpsake selleks ettenähtud nupul ja seejärel navigeerige uuesti praegusele lehele.</translation>
<translation id="2681118099728446983">Bravei võimaldab pakkuda ka muu <ph name="BEGIN_LINK_OSS"/>avatud lähtekoodiga tarkvara<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Teie muudatused jõustuvad järgmine kord, kui Bravei taaskäivitate.</translation>
<translation id="8524328905288851065">FlyWeb vajab sidumise jätkamiseks juurdepääsu Bluetoothile. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">Bravei võimaldab pakkuda <ph name="BEGIN_LINK_CHROMIUM"/>Bravei<ph name="END_LINK_CHROMIUM"/> avatud lähtekoodi projekt.</translation>
<translation id="7777112741998051633">Avage
        Bravei menüü &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ja tühistage valik „<ph name="NO_PREFETCH_DESCRIPTION"/>”.
        Kui see probleemi ei lahenda, soovitame selle valiku
        toimivuse parandamiseks uuesti teha.</translation>
<translation id="4699594416850504200">Vaatate turvalist brauseri FlyWeb for Testing lehte</translation>
<translation id="6224789938625024797">FlyWeb ei sulgunud õigesti.</translation>
<translation id="3593104813552438879">Bravei nõuanne: otsige Lensiga</translation>
</translationbundle>