<!DOCTYPE translationbundle>
<translationbundle lang="ca">
<translation id="130631256467250065">Els canvis es faran efectius la propera vegada que reinicieu el dispositiu.</translation>
<translation id="125853961893919199">Consell de FlyWeb: desa les contrasenyes</translation>
<translation id="1589233279653618219">Ves al menú de FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> i assegura't que la configuració estigui definida sense servidor intermediari o com a directa.</translation>
<translation id="8359495463485001719">La creació d'informes de bloqueig no està disponible a FlyWeb.</translation>
<translation id="6338530717474923868">Estàs visualitzant una pàgina segura de FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb està provant de modificar la configuració per emplenar les formes de pagament.</translation>
<translation id="5702992568540613683">Logotip de FlyWeb</translation>
<translation id="8966580353365544289">Consell de FlyWeb: Navegació segura millorada</translation>
<translation id="510342522494506803">FlyWeb està provant d'editar les formes de pagament.</translation>
<translation id="8375862260948854624">FlyWeb és possible gràcies al projecte de codi obert de <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> i a altre <ph name="BEGIN_LINK_OSS"/>programari lliure<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">FlyWeb ha bloquejat aquesta pàgina</translation>
<translation id="1953000035868532675">Configureu el tallafoc o l'antivirus per permetre que FlyWeb accedeixi
          a la xarxa.</translation>
<translation id="4949828774841497663">Ves a Aplicacions &gt; Configuració del sistema &gt; Xarxa, selecciona la xarxa activa, fes clic al botó Detalls... i desselecciona els servidors intermediaris que s'hagin seleccionat.</translation>
<translation id="7584668345330431749">Ves al menú de FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Xarxa i Internet &gt; Servidor intermediari i, tot seguit, desselecciona Detecta la configuració automàticament.</translation>
<translation id="3145451630329266064">Aquestes pàgines estan pensades per a desenvolupadors de FlyWeb i és possible que no es mantinguin ni es provin activament. Per activar-les, navega fins a <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, fes clic al botó per activar les pàgines de depuració i, a continuació, torna a aquesta pàgina.</translation>
<translation id="2681118099728446983">FlyWeb també és possible gràcies a un altre <ph name="BEGIN_LINK_OSS"/>programari lliure<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Els canvis s'aplicaran la propera vegada que reinicieu FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb necessita accedir al Bluetooth per continuar 
 amb la vinculació. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb és possible gràcies al projecte de codi obert de <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Aneu al
        menú de FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        i desmarqueu <ph name="NO_PREFETCH_DESCRIPTION"/>.
        Si això no resol el problema, us recomanem que torneu a seleccionar
        aquesta opció per obtenir un rendiment millorat.</translation>
<translation id="4699594416850504200">Estàs consultant una pàgina segura de FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb no s'ha tancat correctament.</translation>
<translation id="3593104813552438879">Consell de FlyWeb: cerca amb Lens</translation>
</translationbundle>