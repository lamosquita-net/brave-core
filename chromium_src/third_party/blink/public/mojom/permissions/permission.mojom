module blink.mojom;

// Same order as blink::PermissionType in
// chromium_src/third_party/blink/public/common/permissions/permission_utils.h.
[BraveExtend]
enum PermissionName {
  BRAVE_ADS,
  BRAVE_COSMETIC_FILTERING,
  BRAVE_TRACKERS,
  BRAVE_HTTP_UPGRADABLE_RESOURCES,
  BRAVE_FINGERPRINTING_V2,
  BRAVE_SHIELDS,
  BRAVE_REFERRERS,
  BRAVE_COOKIES,
  BRAVE_GOOGLE_SIGN_IN,
};
