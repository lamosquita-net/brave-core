+template <typename T>
+std::string ConvertToString(const std::vector<T>& array) {
+  std::ostringstream oss;
+  size_t array_size = array.size();
+  for (size_t i = 0; i < array_size; ++i) {
+    oss << array[i];
+    if (i == array_size - 1) {
+      oss << ", ";
+    }
+  }
+  return oss.str();
+}
