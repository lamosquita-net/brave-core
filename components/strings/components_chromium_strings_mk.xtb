<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mk">
<translation id="130631256467250065">Вашите промени ќе стапат на сила следниот пат кога ќе го рестартирате уредот.</translation>
<translation id="1555506416658437797">измени начините на плаќање</translation>
<translation id="8359495463485001719">Не е достапно пријавување падови на FlyWeb.</translation>
<translation id="6338530717474923868">Гледате безбедна страница на FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb се обидува да ги измени поставките за пополнување на начините на плаќање.</translation>
<translation id="5702992568540613683">Лого на FlyWeb</translation>
<translation id="510342522494506803">FlyWeb се обидува да ги измени начините на плаќање.</translation>
<translation id="8375862260948854624">FlyWeb е овозможен од проектот со отворен код <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> и друг <ph name="BEGIN_LINK_OSS"/>софтвер со отворен код<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Одете во
          менито на FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Поставки за LAN
          и поништете го изборот на полето „Употребете прокси-сервер за LAN“.</translation>
<translation id="5040124620086808431">Страницава е блокирана од FlyWeb</translation>
<translation id="1953000035868532675">Дозволете FlyWeb да пристапи на мрежата во поставките за
        заштитен ѕид или антивирус.</translation>
<translation id="3442058224540562441">Одете на
          менито на FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          и погрижете се конфигурацијата да ви е поставена на „нема прокси“ или „директно“.</translation>
<translation id="585620188971323280">ги измени поставките за пополнување на начините на плаќање.</translation>
<translation id="2681118099728446983">FlyWeb го овозможува и друг <ph name="BEGIN_LINK_OSS"/>софтвер со отворен код<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Промените ќе стапат на сила следниот пат кога ќе го стартувате FlyWeb повторно.</translation>
<translation id="1017070759373671177">FlyWeb го овозможува проектот за софтвер со отворен код на <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Одете во
          менито на FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          и поништете го изборот на „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          Доколку со ова не се реши проблемот, препорачуваме повторно да ја изберете опцијата
          за подобра изведба.</translation>
<translation id="8187289872471304532">Отидете на
          Апликации &gt; Претпочитани вредности на системот &gt; Мрежа &gt; Напредно &gt; Проксија
           а потоа поништете го изборот на проксијата што сте ги избрале.</translation>
<translation id="4699594416850504200">Прегледувате безбедна страница на „FlyWeb за тестирање“</translation>
<translation id="6224789938625024797">FlyWeb не се исклучи правилно.</translation>
</translationbundle>