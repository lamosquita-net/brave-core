<translation id="7129578417724116642">FlyWeb ਲਾਂਚ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ...</translation>
<translation id="8624541899164515475">ਸੈਟਿੰਗਾਂ, ਨਵੀਂ ਟੈਬ ਵਿੱਚ ਖੁੱਲ੍ਹਦੀਆਂ ਹਨ।</translation>
<translation id="5469043671012993003">FlyWeb for Testing ਨੂੰ ਤੁਹਾਡਾ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਨਹੀਂ ਬਣਾਇਆ ਜਾ ਸਕਦਾ।</translation>
<translation id="3892251159131070138">ਕਿਤੇ ਵੀ FlyWeb ਨਾਲ ਖੋਜੋ</translation>
<translation id="1514450422236300417">ਇਹ ਇਸ ਨੂੰ ਵੀ ਕੰਟਰੋਲ ਕਰਦਾ ਹੈ ਕਿ ਜਦੋਂ ਤੁਸੀਂ FlyWeb ਨੂੰ ਸ਼ੁਰੂ ਕਰਦੇ ਜਾਂ ਓਮਨੀਬਾਕਸ ਤੋਂ ਖੋਜ ਕਰਦੇ ਹੋ।</translation>
<translation id="573490495087487940">ਇਹ ਤੁਹਾਡਾ FlyWeb ਹੈ</translation>
<translation id="8712637175834984815">ਸਮਝ ਲਿਆ</translation>
<translation id="2666961286257416158">ਕੀ FlyWeb ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨਾ ਹੈ?</translation>
<translation id="8747073452963259673">ਖੋਜ ਖੇਤਰ ਦਾ ਹੇਠਲਾ ਖੱਬਾ ਕੋਨਾ: ਖੱਬੇ ਤੋਂ <ph name="LEFT"/>%, ਹੇਠਾਂ ਤੋਂ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">ਸਥਾਪਤ ਕਰਨ ਵਿੱਚ ਗੜਬੜ: ਤੁਹਾਡੇ ਨੈੱਟਵਰਕ ਪ੍ਰਸ਼ਾਸਕ ਨੇ ਇੱਕ ਗਰੁੱਪ ਨੀਤੀ ਲਾਗੂ ਕੀਤੀ ਹੈ ਜੋ ਸਥਾਪਨਾ ਨੂੰ ਰੋਕਦੀ ਹੈ: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">ਮੈਨੂੰ ਬਾਅਦ ਵਿੱਚ ਯਾਦ ਕਰਵਾਓ</translation>
<translation id="4243214377720481697">ਤਤਕਾਲ ਰੂਪ-ਰੇਖਾ ਪ੍ਰਾਪਤ ਕਰਨ ਅਤੇ ਫ਼ਾਲੋ-ਅੱਪ ਸਵਾਲ ਪੁੱਛਣ ਲਈ ਇਸ ਦਸਤਾਵੇਜ਼ ਨੂੰ FlyWeb ਵਿੱਚ Gemini ਨਾਲ ਸਾਂਝਾ ਕਰੋ</translation>
<translation id="6808406663598665473">ਕੀ FlyWeb ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨਾ ਹੈ?</translation>
<translation id="7022252178852457880">FlyWeb ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਬਣਾਓ ਅਤੇ ਟਾਸਕਬਾਰ 'ਤੇ ਪਿੰਨ ਕਰੋ</translation>
<translation id="8826492472752484139">“Password Manager” 'ਤੇ ਕਲਿੱਕ ਕਰੋ</translation>
<translation id="6933858244219479645">ChromeOS ਸਿਸਟਮ</translation>
<translation id="1501202286854500367">ਇਸ ਭਾਸ਼ਾ ਦੀ ਵਰਤੋਂ FlyWeb ਵਿੱਚ ਮੀਨੂ, ਸੈਟਿੰਗਾਂ, ਅਲਰਟ ਅਤੇ ਹੋਰ ਲਿਖਤ ਦਿਖਾਉਣ ਲਈ ਕੀਤੀ ਜਾਂਦੀ ਹੈ</translation>
<translation id="8862326446509486874">ਤੁਹਾਡੇ ਕੋਲ ਸਿਸਟਮ-ਪੱਧਰ ਸਥਾਪਤ ਕਰਨ ਲਈ ਉਚਿਤ ਅਧਿਕਾਰ ਨਹੀਂ ਹਨ। ਪ੍ਰਬੰਧਕ ਦੇ ਤੌਰ 'ਤੇ ਦੁਬਾਰਾ ਸਥਾਪਨਾਕਾਰ ਚਲਾਉਣ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="2405293075272280413">FlyWeb ਪ੍ਰੋਫਾਈਲ ਸ਼ਾਮਲ ਕਰੋ</translation>
<translation id="2096285611267043007">ਸਾਈਨ-ਇਨ ਕਰਨ ਵੇਲੇ ਗੜਬੜ ਹੋਣ ਕਰਕੇ ChromeOS ਤੁਹਾਡੇ FlyWeb ਖਾਤੇ ਵਿੱਚ FlyWeb ਡਾਟਾ ਰੱਖਿਅਤ ਨਹੀਂ ਕਰ ਸਕਿਆ</translation>
<translation id="9046344742397901138">ਤੁਹਾਡੀ ਸੰਸਥਾ ਲਈ ਤੁਹਾਨੂੰ FlyWeb ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨ ਦੀ ਲੋੜ ਹੈ</translation>
<translation id="4669168852412989042">FlyWeb ਪਾਸਵਰਡ ਦਿਖਾਉਣ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਿਹਾ ਹੈ। ਇਸਦੀ ਆਗਿਆ ਦੇਣ ਲਈ ਆਪਣਾ Windows ਪਾਸਵਰਡ ਟਾਈਪ ਕਰੋ।</translation>
<translation id="2704405030486981087">FlyWeb ਹੁਣ ਤੁਹਾਡਾ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਨਹੀਂ ਹੈ। ਕੀ FlyWeb ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਬਣਾਉਣਾ ਹੈ?</translation>
<translation id="1663379621921336006">FlyWeb ਅੱਪਡੇਟ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ</translation>
<translation id="8944232836376404813">ਇਹ ਕਾਰਵਾਈ:
          <ph name="LINE_BREAKS"/>
            • ਤੁਹਾਡੇ ਸ਼ੁਰੂਆਤੀ ਪੰਨੇ, ਨਵੇਂ ਟੈਬ ਪੰਨੇ, ਖੋਜ ਇੰਜਣ ਅਤੇ ਪਿੰਨ ਕੀਤੀਆਂ ਟੈਬਾਂ ਨੂੰ ਰੀਸੈੱਟ ਕਰੇਗੀ
            <ph name="LINE_BREAK"/>
            • ਐਕਸਟੈਂਸ਼ਨਾਂ ਨੂੰ ਬੰਦ ਕਰੇਗੀ
            <ph name="LINE_BREAK"/>
            • ਕੁਕੀਜ਼ ਅਤੇ ਹੋਰ ਅਸਥਾਈ ਸਾਈਟ ਡਾਟੇ ਨੂੰ ਮਿਟਾਵੇਗੀ
            <ph name="LINE_BREAKS"/>
            ਬੁੱਕਮਾਰਕ, ਇਤਿਹਾਸ ਅਤੇ ਰੱਖਿਅਤ ਕੀਤੇ ਪਾਸਵਰਡ ਪ੍ਰਭਾਵਿਤ ਨਹੀਂ ਹੋਣਗੇ।</translation>
<translation id="188856534838382513">FlyWeb ਸਾਈਟ ਦੇ ਸ਼ਾਰਟਕੱਟ ਦਿਖਾਓ</translation>
<translation id="543915850302643692">FlyWeb Enterprise ਦਾ ਲੋਗੋ</translation>
<translation id="4417647437359346154">ਆਪਣੇ <ph name="DEVICE_TYPE"/> 'ਤੇ FlyWeb ਐਪ ਨਾਲ ਤੁਰਦੇ-ਫਿਰਦੇ FlyWeb ਦੀ ਸੁਰੱਖਿਆ ਦਾ ਲਾਹਾ ਲਓ</translation>
<translation id="6976267397714240800">FlyWeb ਨੂੰ ਚਾਲੂ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਕਿਉਂਕਿ ਤੁਹਾਡਾ ਪ੍ਰੋਫਾਈਲ ਖੋਲ੍ਹਣ ਦੌਰਾਨ ਕੋਈ ਗੜਬੜ ਹੋ ਗਈ। FlyWeb ਨੂੰ ਮੁੜ-ਸ਼ੁਰੂ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="8952346994182255880">FlyWeb ਨਾਲ ਖੋਜਣ ਲਈ ਜਾਂ <ph name="BEGIN_LINK"/>ਸੈਟਿੰਗਾਂ<ph name="END_LINK"/> ਵਿੱਚ ਵਿਉਂਤਬੱਧ ਕਰਨ ਲਈ</translation>
<translation id="8422308271795251425">FlyWeb ਪ੍ਰੋਫਾਈਲਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ</translation>
<translation id="519942585686549229">FlyWeb ਵਿੱਚ Gemini ਅਤੇ ਆਪਣੀ ਖੁੱਲ੍ਹੀ ਟੈਬ ਵਿਚਕਾਰ ਨੈਵੀਗੇਟ ਕਰਨ ਲਈ ਆਪਣੇ ਕੀ-ਬੋਰਡ ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="9018218886431812662">ਸਥਾਪਨਾ ਮੁਕੰਮਲ ਹੋਈ</translation>
<translation id="5804408305184682593">FlyWeb ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="7410599202980023102">Mac ਦੇ ਮੀਨੂ ਬਾਰ ਵਿੱਚ 'FlyWeb ਨਾਲ ਖੋਜੋ' ਨੂੰ ਦਿਖਾਓ ਅਤੇ ਕੀ-ਬੋਰਡ ਸ਼ਾਰਟਕੱਟ ਚਾਲੂ ਕਰੋ</translation>
<translation id="2138383893834402906">FlyWeb ਨੇ ਇਸ ਡਾਊਨਲੋਡ ਨੂੰ ਬਲਾਕ ਕਰ ਦਿੱਤਾ ਹੈ, ਕਿਉਂਕਿ ਪੁਰਾਲੇਖ ਫ਼ਾਈਲ ਵਿੱਚ ਹੋਰ ਫ਼ਾਈਲਾਂ ਸ਼ਾਮਲ ਹਨ, ਜਿਨ੍ਹਾਂ ਵਿੱਚ ਮਾਲਵੇਅਰ ਲੁਕਿਆ ਹੋ ਸਕਦਾ ਹੈ</translation>
<translation id="8884768769854521848">ਆਪਣੇ ਪਾਸਵਰਡ, ਬੁੱਕਮਾਰਕ ਅਤੇ ਇਤਿਹਾਸ ਨੂੰ ਡੀਵਾਈਸਾਂ ਵਿਚਕਾਰ ਪੂਰੀ ਤਰ੍ਹਾਂ ਸਿੰਕ ਰੱਖੋ। ਆਪਣੇ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਨੂੰ FlyWeb 'ਤੇ ਅੱਪਡੇਟ ਕਰ ਕੇ ਉਨ੍ਹਾਂ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਤੱਕ ਆਸਾਨੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ, ਜਿਨ੍ਹਾਂ ਬਾਰੇ ਤੁਸੀਂ ਜਾਣਦੇ ਹੋ ਅਤੇ ਪਸੰਦ ਕਰਦੇ ਹੋ। ਤਤਕਾਲ ਪਹੁੰਚ ਲਈ FlyWeb ਨੂੰ ਤੁਹਾਡੀ ਟਾਸਕਬਾਰ 'ਤੇ ਪਿੰਨ ਕੀਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="3668027737318668659">ਆਪਣੇ ਫ਼ੋਨ 'ਤੇ FlyWeb ਐਪ ਨਾਲ FlyWeb ਦੇ ਬਿਹਤਰੀਨ AI ਟੂਲਾਂ ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
<translation id="1257818515846885633"><ph name="DEVICE"/> ਤੋਂ ਆਪਣੇ ਪਾਸਵਰਡ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, FlyWeb ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="7813768067688376455">ਹੋਰ FlyWeb ਸੇਵਾਵਾਂ ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨ 'ਤੇ, FlyWeb ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="8323442969389928559">FlyWeb ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਬੰਦ ਹੋ ਗਿਆ ਸੀ</translation>
<translation id="7626272203917389133">FlyWeb ਪੁਰਾਣਾ ਹੈ</translation>
<translation id="1789655708880997767">{0,plural, =1{FlyWeb ਇੱਕ ਘੰਟੇ ਵਿੱਚ ਮੁੜ-ਲਾਂਚ ਹੋਵੇਗਾ}one{FlyWeb # ਘੰਟੇ ਵਿੱਚ ਮੁੜ-ਲਾਂਚ ਹੋਵੇਗਾ}other{FlyWeb # ਘੰਟਿਆਂ ਵਿੱਚ ਮੁੜ-ਲਾਂਚ ਹੋਵੇਗਾ}}</translation>
<translation id="9106236359747881194">ਖੋਜਣ ਲਈ ਲਿਖਤ ਚੁਣੋ</translation>
<translation id="8970147445441095618">FlyWeb ਸੰਬੰਧੀ ਭਵਿੱਖੀ ਅੱਪਡੇਟ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, ਤੁਹਾਨੂੰ Windows 10 ਜਾਂ ਇਸ ਤੋਂ ਬਾਅਦ ਵਾਲੇ ਵਰਜਨ ਦੀ ਲੋੜ ਪਵੇਗੀ। ਇਸ ਕੰਪਿਊਟਰ 'ਤੇ Windows 8.1 ਵਰਜਨ ਵਰਤਿਆ ਜਾ ਰਿਹਾ ਹੈ।</translation>
<translation id="1208237657860748752">ਨਵੀਂ FlyWeb &amp;ਟੈਬ ਵਿੱਚ ਲਿੰਕ ਖੋਲ੍ਹੋ</translation>
<translation id="911206726377975832">ਕੀ ਤੁਹਾਡਾ ਬ੍ਰਾਊਜ਼ਿੰਗ ਡਾਟਾ ਵੀ ਮਿਟਾਉਣਾ ਹੈ?</translation>
<translation id="9134482777260927479">ਹੋਮਵਰਕ ਮਦਦ</translation>
<translation id="9148058034647219655">ਬਾਹਰ ਜਾਓ</translation>
<translation id="1592415213971909403">ਜਿੱਥੇ ਤੁਸੀਂ ਛੱਡਿਆ ਸੀ ਉੱਥੋਂ ਜਾਰੀ ਰੱਖੋ: ਜਦੋਂ ਵੀ ਤੁਸੀਂ ਮੁੜ-ਸ਼ੁਰੂ ਕਰਦੇ ਹੋ, ਹਰੇਕ ਵਾਰ FlyWeb ਤੁਹਾਡੀਆਂ ਟੈਬਾਂ ਨੂੰ ਮੁੜ-ਬਹਾਲ ਕਰ ਸਕਦਾ ਹੈ। ਇਸਨੂੰ ਚਾਲੂ ਕਰਨ ਲਈ, ਇੱਥੇ ਜਾਓ</translation>
<translation id="3926534790663909774">ਤੁਹਾਡੇ ਸਿਸਟਮ ਪ੍ਰਸ਼ਾਸਕ ਨੇ <ph name="TARGET_URL_HOSTNAME"/> ਤੱਕ ਪਹੁੰਚ ਕਰਨ ਵਾਸਤੇ ਕੋਈ ਵਿਕਲਪਿਕ ਬ੍ਰਾਊਜ਼ਰ ਖੋਲ੍ਹਣ ਲਈ FlyWeb ਦਾ ਸੰਰੂਪਣ ਕੀਤਾ ਹੈ।</translation>
<translation id="5022081608392609959">&amp;FlyWeb ਨੂੰ ਅੱਪਡੇਟ ਕਰਨ ਲਈ ਮੁੜ-ਲਾਂਚ ਕਰੋ</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">ਸਾਈਨ-ਇਨ ਕਰ ਕੇ FlyWeb ਨੂੰ ਆਪਣੇ ਮੁਤਾਬਕ ਵਿਉਂਤਬੱਧ ਕਰੋ</translation>
<translation id="3410331617397516204">ਸ਼ਾਇਦ FlyWeb ਠੀਕ ਢੰਗ ਨਾਲ ਕੰਮ ਨਾ ਕਰੇ ਕਿਉਂਕਿ ਇਹ ਹੁਣ Windows XP ਜਾਂ Windows Vista 'ਤੇ ਕੰਮ ਨਹੀਂ ਕਰਦਾ ਹੈ</translation>
<translation id="3613308994653366133">FlyWeb ਨਾਲ ਤੁਰਦੇ-ਫਿਰਦੇ FlyWeb ਦੀਆਂ ਬਿਹਤਰੀਨ ਸੁਰੱਖਿਆ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਪ੍ਰਾਪਤ ਕਰੋ।</translation>
<translation id="945522503751344254">ਪ੍ਰਤੀਕਰਮ ਭੇਜੋ</translation>
<translation id="1127626874097952395">FlyWeb ਕੌਣ ਵਰਤ ਰਿਹਾ ਹੈ?</translation>
<translation id="1626113414414104077">FlyWeb ਦੀ ਸਭ ਤੋਂ ਮਜਬੂਤ ਸੁਰੱਖਿਆ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="983803489796659991">ਸਥਾਪਤ ਕਰਨਾ ਅਸਫਲ ਰਿਹਾ ਕਿਉਂਕਿ ਅੱਪਡੇਟ ਸਰਵਰ ਵਿੱਚ ਐਪਲੀਕੇਸ਼ਨ ਲਈ ਕੋਈ ਹੈਸ਼ ਡਾਟਾ ਨਹੀਂ ਹੈ।</translation>
<translation id="839475718250652248">ਖਾਤੇ ਤੋਂ ਬਿਨਾਂ FlyWeb ਵਰਤੋ</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">'ਚਿੱਤਰ ਖੋਜ' ਨਾਲ ਖੋਜਣ ਲਈ ਕੋਈ ਵੀ ਲਿਖਤ ਜਾਂ ਚਿੱਤਰ ਚੁਣੋ</translation>
<translation id="7783156808075587495">ਆਪਣੇ ਟਿਕਾਣੇ ਦੀ ਵਰਤੋਂ ਕਰਨ ਲਈ, <ph name="BEGIN_LINK"/>ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ<ph name="END_LINK"/> ਵਿੱਚ ਜਾ ਕੇ FlyWeb ਨੂੰ ਇਸ ਤੱਕ ਪਹੁੰਚ ਦਿਓ</translation>
<translation id="137466361146087520">Google Chrome ਬੀਟਾ</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">ਅਨਿਸ਼ਚਿਤ ਗੜਬੜ ਕਾਰਨ ਸਥਾਪਨਾ ਅਸਫਲ ਹੋ ਗਈ। ਕਿਰਪਾ ਕਰਕੇ FlyWeb ਨੂੰ ਦੁਬਾਰਾ ਡਾਊਨਲੋਡ ਕਰੋ।</translation>
<translation id="2725795635123877647">ਅਣਜਾਣ ਸਰੋਤਾਂ ਤੋਂ ਐਕਸਟੈਂਸ਼ਨ, ਐਪਸ ਅਤੇ ਥੀਮਾਂ ਤੁਹਾਡੇ ਜੰਤਰ ਨੂੰ ਨੁਕਸਾਨ ਪਹੁੰਚਾ ਸਕਦੇ ਹਨ। FlyWeb ਸਿਰਫ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ਤੋਂ ਇਨ੍ਹਾਂ ਨੂੰ ਇੰਸਟਾਲ ਕਰਨਾ ਸਿਫਾਰਸ਼ ਕਰਦਾ ਹੈ।</translation>
<translation id="5840822070878669614">ਵੈੱਬ ਸਟੋਰ ਖੋਲ੍ਹੋ</translation>
<translation id="3470813199863172076">ਇਹ ਐਕਸਟੈਂਸ਼ਨ Web Store ਨੀਤੀ ਦੀ ਉਲੰਘਣਾ ਕਰਦੀ ਹੈ ਅਤੇ ਅਸੁਰੱਖਿਅਤ ਹੋ ਸਕਦੀ ਹੈ। FlyWeb ਤੋਂ ਇਸਨੂੰ ਹਟਾਓ ਤਾਂ ਜੋ ਇਹ ਤੁਹਾਡੇ ਜਾਣਕਾਰੀ ਨੂੰ ਤੁਹਾਡੇ ਜਾ ਰਹੇ ਸਾਈਟਾਂ 'ਤੇ ਨਹੀਂ ਵੇਖ ਸਕੇ ਅਤੇ 'ਤੇ ਬਦਲ ਸਕੇ।</translation>
<translation id="5382847955032513683">ਚੇਤਾਵਨੀ: FlyWeb ਐਕਸਟੈਂਸ਼ਨਾਂ ਤੋਂ ਤੁਹਾਡੇ ਬਰਾਊਜ਼ਿੰਗ ਇਤਿਹਾਸ ਨੂੰ ਰਿਕਾਰਡ ਕਰਨਾ ਨਹੀਂ ਰੋਕ ਸਕਦਾ। ਇਸ ਐਕਸਟੈਂਸ਼ਨ ਨੂੰ ਨਿੱਜੀ ਮੋਡ ਵਿੱਚ ਅਯੋਗ ਕਰਨ ਲਈ, ਇਸ ਵਿਕਲਪ ਨੂੰ ਚੁਣਵੀਂ ਨਾ ਕਰੋ।</translation>
<translation id="543905389684998697">FlyWeb ਨੂੰ ਜ਼ਿਆਦਾ ਸੁਰੱਖਿਅਤ ਬਣਾਉਣ ਲਈ, ਅਸੀਂ ਕੁਝ ਐਕਸਟੈਂਸ਼ਨਾਂ ਨੂੰ ਅਯੋਗ ਕਰ ਦਿੱਤਾ ਹੈ ਜੋ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ਵਿੱਚ ਸ਼ਾਮਿਲ ਨਹੀਂ ਹਨ ਅਤੇ ਤੁਹਾਡੇ ਗਿਆਨ ਦੇ ਬਿਨਾਂ ਸ਼ਾਇਦ ਜੋੜੇ ਗਏ ਹੋ।</translation>
<translation id="3914570680366033593">FlyWeb ਨੂੰ ਜ਼ਿਆਦਾ ਸੁਰੱਖਿਅਤ ਬਣਾਉਣ ਲਈ, ਅਸੀਂ ਹੇਠ ਲਿਖੇ ਐਕਸਟੈਂਸ਼ਨ ਨੂੰ ਅਯੋਗ ਕਰ ਦਿੱਤਾ ਹੈ ਜੋ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ਵਿੱਚ ਸ਼ਾਮਿਲ ਨਹੀਂ ਹੈ ਅਤੇ ਤੁਹਾਡੇ ਗਿਆਨ ਦੇ ਬਿਨਾਂ ਸ਼ਾਇਦ ਜੋੜਿਆ ਗਿਆ ਹੈ।</translation>
<translation id="2742103213766991703">ਲਿੰਕ ਨੂੰ FlyWeb &amp;ਨਿੱਜੀ ਖਿੜਕੀ ਵਿੱਚ ਖੋਲੋ</translation>
<translation id="5606966092070089147">ਬ੍ਰੇਵ ਵਿੱਚ ਲਿੰਕ ਖੋਲ੍ਹੋ &amp;ਨਿੱਜੀ ਵਿੰਡੋ</translation>
<translation id="1616978953472841483">ਲਿੰਕ ਨੂੰ FlyWeb &amp;Private Window ਵਿੱਚ ਖੋਲੋ</translation>
<translation id="2050263926423290804">{COUNT, plural,
          =0 {A new update for FlyWeb is available and will be applied as soon as you relaunch.}
          =1 {A new update for FlyWeb is available and will be applied as soon as you relaunch. Your Private window won't reopen.}
          other {A new update for FlyWeb is available and will be applied as soon as you relaunch. Your # Private windows won't reopen.}}</translation>
<translation id="8494512118209691256">ਇਹ ਤੁਹਾਨੂੰ FlyWeb ਤੋਂ ਆਪਣੇ ਸਥਾਨਕ ਡਿਵਾਈਸ, ਜਿਵੇਂ ਕਿ ਟੀਵੀ ਜਾਂ ਸਪੀਕਰ ਵਿੱਚ ਸਮਗ੍ਰੀ ਸਾਂਝੀ ਕਰਨ ਦੀ ਆਗਿਆ ਦੇਵੇਗਾ।</translation>
<translation id="7488914907489544218">{COUNT, plural,
              =0 {Your administrator asks that you relaunch FlyWeb to apply this update}
              =1 {Your administrator asks that you relaunch FlyWeb to apply this update. Your Private window won't reopen.}
              other {Your administrator asks that you relaunch FlyWeb to apply this update. Your # Private windows won't reopen.}}</translation>
<translation id="7568541461974616693">{COUNT, plural,
              =0 {Your administrator requires that you relaunch FlyWeb to apply an update}
              =1 {Your administrator requires that you relaunch FlyWeb to apply an update. Your Private window won't reopen.}
              other {Your administrator requires that you relaunch FlyWeb to apply an update. Your # Private windows won't reopen.}}</translation>
<translation id="6998204082704836463">{COUNT, plural,
              =0 {Advanced Protection requires that you relaunch FlyWeb to apply an update}
              =1 {Advanced Protection requires that you relaunch FlyWeb to apply an update. Your Private window won't reopen.}
              other {Advanced Protection requires that you relaunch FlyWeb to apply an update. Your # Private windows won't reopen.}}</translation>
<translation id="5749154344207139683">ਪ੍ਰਾਈਵੇਟ ਨੂੰ ਸੁਧਾਰਣ ਵਿੱਚ ਸਾਡੀ ਮਦਦ ਕਰੋ ਅਤੇ ਇਹ 1 ਮਿੰਟ ਦੀ ਸਰਵੇਖਣ ਕਰਕੇ ਮਦਦ ਕਰੋ।</translation>
<translation id="4766381896251401675">ਜਦੋਂ ਤੁਸੀਂ ਪਤੇ ਦੀ ਪੱਟੀ ਜਾਂ ਖੋਜ ਬਾਕਸ ਵਿੱਚ ਟਾਈਪ ਕਰਦੇ ਹੋ, FlyWeb ਤੁਹਾਡੇ ਜੋ ਕੁਝ ਤੁਸੀਂ ਟਾਈਪ ਕਰਦੇ ਹੋ ਉਸ ਨੂੰ ਚੰਗੇ ਸੁਝਾਅ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ ਤੁਹਾਡੇ ਡਿਫਾਲਟ ਖੋਜ ਇੰਜਣ ਨੂੰ ਭੇਜਦਾ ਹੈ। ਇਹ ਨਿੱਜੀ ਵਿੱਚ ਬੰਦ ਹੈ।</translation>
<translation id="2832552148674305108">FlyWeb Private</translation>
<translation id="611606920944085547">ਨਿੱਜੀ ਮੋਡ ਵਿੱਚ ਬਰਾਊਜ਼ਿੰਗ ਕਰਦੇ ਸਮੇਂ, FlyWeb ਅਸੁਰੱਖਿਅਤ ਕਨੈਕਸ਼ਨ ਦੀ ਵਰਤੋਂ ਰਲਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਤੁਹਾਨੂੰ ਚੇਤਾਵਨੀ ਦੇਵੇਗਾ।</translation>
</translationbundle>