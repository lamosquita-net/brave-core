<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr">
<translation id="130631256467250065">Промене ће ступити на снагу када следећи пут поново покренете уређај.</translation>
<translation id="125853961893919199">Напомена за FlyWeb: Сачувајте лозинке</translation>
<translation id="1589233279653618219">Идите у
          FlyWeb мени &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          и проверите да ли је конфигурација подешена на „no proxy“ (без проксија) или „direct“ (директно).</translation>
<translation id="8359495463485001719">Извештавање о отказивањима није доступно у FlyWeb-у.</translation>
<translation id="6338530717474923868">Гледате безбедну FlyWeb страницу.</translation>
<translation id="5147169001159408844">FlyWeb покушава да измени подешавања за попуњавање начина плаћања.</translation>
<translation id="5702992568540613683">FlyWeb логотип</translation>
<translation id="8966580353365544289">Напомена за FlyWeb: Побољшано безбедно прегледање</translation>
<translation id="510342522494506803">FlyWeb покушава да измени начине плаћања.</translation>
<translation id="8375862260948854624">FlyWeb омогућавају <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> пројекат отвореног кода и други <ph name="BEGIN_LINK_OSS"/>софтвер отвореног кода<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">FlyWeb блокира ову страницу</translation>
<translation id="1953000035868532675">Дозволите FlyWeb-у да приступа мрежи у заштитном зиду или антивирусним
          подешавањима.</translation>
<translation id="4949828774841497663">Идите у Applications (Апликације) &gt; System Settings (Подешавања система) &gt; Network (Мрежа), па изаберите
          активну мрежу, кликните на дугме Details... (Детаљи), а затим поништите избор свих проксија
          који су изабрани.</translation>
<translation id="7584668345330431749">Идите у
          FlyWeb мени &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Мрежа и интернет &gt; Прокси
          и поништите избор опције Аутоматски откриј подешавања.</translation>
<translation id="3145451630329266064">Ове странице су намењене програмерима FlyWeb-а и можда се не одржавају нити тестирају активно. Да бисте их омогућили, идите на <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, кликните на дугме да бисте омогућили странице за отклањање грешака, па поново идите на ову страницу.</translation>
<translation id="2681118099728446983">FlyWeb омогућава и други <ph name="BEGIN_LINK_OSS"/>софтвер отвореног кода<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Промене ће ступити на снагу када следећи пут поново покренете FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb захтева приступ Bluetooth-у ради настављања са 
 упаривањем. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb омогућава <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> пројекат отвореног кода.</translation>
<translation id="7777112741998051633">Отворите
          FlyWeb мени &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          и опозовите избор опције „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          Ако вам то не реши проблем, препоручујемо да поново изаберете
          ову опцију ради бољих перформанси.</translation>
<translation id="4699594416850504200">Прегледате безбедну FlyWeb for Testing страницу</translation>
<translation id="6224789938625024797">FlyWeb се није исправно затворио.</translation>
<translation id="3593104813552438879">Савет за FlyWeb: Претражујте помоћу Објектива</translation>
</translationbundle>