<!DOCTYPE translationbundle>
<translationbundle lang="no">
<translation id="130631256467250065">Endringene trer i kraft neste gang du starter enheten på nytt.</translation>
<translation id="125853961893919199">FlyWeb-tips: Lagre passord</translation>
<translation id="1589233279653618219">Gå til
          FlyWeb-menyen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          og sørg for at konfigurasjonen din er angitt til «ingen mellomtjener» eller «direkte».</translation>
<translation id="8359495463485001719">Krasjrapportering er ikke tilgjengelig i FlyWeb.</translation>
<translation id="6338530717474923868">Du ser på en sikker FlyWeb-side</translation>
<translation id="5147169001159408844">FlyWeb prøver å endre innstillingene for utfylling av betalingsmåter.</translation>
<translation id="5702992568540613683">FlyWeb-logo</translation>
<translation id="8966580353365544289">FlyWeb-tips: Safe Browsing med økt beskyttelse</translation>
<translation id="510342522494506803">FlyWeb prøver å redigere betalingsmåter.</translation>
<translation id="8375862260948854624">FlyWeb er gjort mulig av åpen kilde-prosjektet <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> og annen <ph name="BEGIN_LINK_OSS"/>åpen kilde-programvare<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Denne siden er blokkert av FlyWeb</translation>
<translation id="1953000035868532675">Tillat at FlyWeb bruker nettverket, i brannmur- eller
          antivirusinnstillingene dine.</translation>
<translation id="4949828774841497663">Gå til Programmer &gt; Systeminnstillinger &gt; Nettverk, velg det aktive nettverket, klikk på «Detaljer…»-knappen, og fjern avmerkingen for eventuelle proxy-tjenere som muligens er valgt.</translation>
<translation id="7584668345330431749">Gå til
          FlyWeb-menyen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Nettverk og internett &gt; Proxy-tjener
          og velg bort «Oppdag innstillinger automatisk».</translation>
<translation id="3145451630329266064">Disse sidene er beregnet for bruk av FlyWeb-utviklere. Det kan hende at de ikke aktivt vedlikeholdes eller testes. For å slå dem på, gå til <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, klikk på knappen for å slå på feilsøkingssider, og gå til denne siden igjen.</translation>
<translation id="2681118099728446983">FlyWeb er også gjort mulig av annen <ph name="BEGIN_LINK_OSS"/>programvare med åpen kildekode<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Endringene dine trer i kraft neste gang du starter FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb trenger Bluetooth-tilgang for å fortsette tilkoblingen. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb er gjort mulig av åpen kilde-prosjektet <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Gå til
        FlyWeb-menyen &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og fjern avmerkingen for «<ph name="NO_PREFETCH_DESCRIPTION"/>».
        Hvis dette ikke løser problemet, bør du aktivere dette alternativet
        på nytt for bedre ytelse.</translation>
<translation id="4699594416850504200">Du ser på en sikker side for FlyWeb for testing</translation>
<translation id="6224789938625024797">FlyWeb ble ikke avsluttet på riktig måte.</translation>
<translation id="3593104813552438879">FlyWeb-tips: Søk med Lens</translation>
</translationbundle>