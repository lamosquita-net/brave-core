+namespace blink {
+
+class NGLineInfo;
+
+enum class JustificationTarget {
+  kNormal,
+  kRubyBase,
+  kRubyText,
+  kSvgText,
+};
+
+// Justify the line. This changes the size of items by adding spacing.
+// Returns absl::nullopt if justification failed and should fall back to
