<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="7099479769133613710">‏راه‌اندازی مجدد برای به‌روزرسانی ChromeOS</translation>
<translation id="291426170030461697">‏FlyWeb توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="1549005488226693697">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، FlyWeb از سرورهای FlyWeb استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما FlyWeb متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="8908267645832965492">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای FlyWeb خاموش کرده است</translation>
<translation id="5557633153169217776">‏‫FlyWeb برای کاوش و استفاده از دستگاه‌های اطراف به دست‌یابی به شبکه محلی نیاز دارد</translation>
<translation id="6441390163669415879">‏برای جستجو کردن افزونه یا ویژگی خاص FlyWeb، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
<translation id="9001750423919983557">‏نشان دادن جستجو با FlyWeb در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="1368460307421081773">‏FlyWeb می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">‏FlyWeb مرورگر پیش‌فرضتان است</translation>
<translation id="4556715463645168547">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK"/>به سیستم FlyWeb وارد شوید<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">‏روی منو FlyWeb کلیک کنید</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="4380351562011537903">‏درباره FlyWeb</translation>
<translation id="853148447909557566">‏با FlyWeb در تلفنتان، هشدارهای پیگیری قیمت را دریافت کنید</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1232234696885483911">‏وقتی‌که «جستجوی تصویر» را باز می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به‌طور خودکار به سرور ارسال می‌شوند. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب FlyWeb» خود در FlyWeb استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در FlyWeb» بروید.</translation>
<translation id="7614508617663739435">‏نمایش «Gemini در FlyWeb» در نوار منو Mac</translation>
<translation id="832555967476614730">‏برای انتخاب بخشی از صفحه در «Gemini در FlyWeb»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="4750836834956739196">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت FlyWeb حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="3190759351483708314">‏‫FlyWeb این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="5879469261638423015">‏وقتی با <ph name="USER_EMAIL"/> به سیستم سرویس‌های FlyWeb مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم FlyWeb وارد شوید</translation>
<translation id="7142135954326264349">‏دریافت کردن FlyWeb در تلفن</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">‏راه‌اندازی نمایه FlyWeb جدید</translation>
<translation id="5252737639504553444">‏با «Gemini در FlyWeb» امتحان کنید</translation>
<translation id="609743863669742325">‏‫FlyWeb برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">‏ورود به سیستم FlyWeb در تلفن</translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="2276527911011636666">‏داده‌ها از FlyWeb هم حذف شود (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">سنجاق شد! دفعه بعد می‌توانید «جستجوی تصویر» را ازطریق این دکمه جدید در نوارابزار باز کنید</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="1045149878186896649">‏برای ادامه مرور در حرکت، از برنامه FlyWeb استفاده کنید</translation>
<translation id="141901961143729572">افکارتان را هم‌رسانی</translation>
<translation id="2758515779140515865">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای FlyWeb مجاز کنید.</translation>
<translation id="4713192356155907986">‏دریافت راهنمایی درباره FlyWeb for Testing</translation>
<translation id="4984443629206419460">‏برای دریافت اطلاعات ذخیره‌شده و سایر موارد از <ph name="DEVICE"/>، به سیستم FlyWeb وارد شوید</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">این صفحه محافظت شده است</translation>
<translation id="8962360511570172">‏هم‌رسانی برگه FlyWeb</translation>
<translation id="2941487459666781243">‏ورود به سیستم FlyWeb</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="3182893868355533457">‏سنجاق کردن FlyWeb</translation>
<translation id="852852907317361085">‏ابزارهای ایمنی FlyWeb</translation>
<translation id="481155564361715417">‏‫FlyWeb می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2846999307505917298">‏با برنامه FlyWeb در تلفنتان، بیشترین بهره را از FlyWeb ببرید</translation>
<translation id="3961251277542681013">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در FlyWeb</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1665602916345474427">با <ph name="USER_NAME"/>، <ph name="USER_EMAIL"/>، عضویت به سیستم وارد شده‌اید. باز کردن منو حساب</translation>
<translation id="7625232007557474355">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از FlyWeb باز کنید. این برنامه به نوار وظیفه هم سنجاق خواهد شد.</translation>
<translation id="1709772298389099340">امتیازهای عالی برای <ph name="BROWSER_NAME"/> ارائه می‌دهد.</translation>
<translation id="5695205873161614119">‏FlyWeb به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="8939535770474283898">‏FlyWeb سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="2581127533455294937">‏داده‌های FlyWeb پاک شد</translation>
<translation id="7385422968404728039">‏FlyWeb تا <ph name="REMAINING_TIME"/> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="6903827847227122616">‏وقتی HTTPS دردسترس نباشد، FlyWeb بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="307170399141486420">‏اجازه به FlyWeb برای اجرا در پس‌زمینه</translation>
<translation id="5006568136491721884">‏روی <ph name="BEGIN_BOLD"/>بله<ph name="END_BOLD"/> در اعلان Windows کلیک کنید تا FlyWeb را برای دسترسی سریع به نوار وظیفه سنجاق کنید.</translation>
<translation id="2473319786107120819">‏نصب مجدد FlyWeb</translation>
<translation id="2533324957407080119">‏FlyWeb در تلاش است <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید. همچنین افزونه‌ها و سایر موارد را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="3547283483106013256">‏دفعه بعد که FlyWeb را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه FlyWeb» خواهید دید.</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="3403116471618205223">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب FlyWeb»، <ph name="BEGIN_LINK"/>از سیستم FlyWeb خارج شوید<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">‏با بارگیری FlyWeb در تلفنتان، درحال حرکت گروه‌های زبانه جدید باز کنید یا بسازید.</translation>
<translation id="3285741355512747610">‏می‌توانید «حساب‌های FlyWeb» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های FlyWeb» شما در مرورگر FlyWeb، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE"/> خود اضافه کنید. <ph name="LINK_BEGIN"/>بیشتر بدانید<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">جستجو کردن با «جستجوی تصویر»</translation>
<translation id="5054936737639982722">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید. همچنین نشانک‌ها و موارد دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="4824940465467423308">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه FlyWeb خود را می‌دهید. داده‌های FlyWeb شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های FlyWeb حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های FlyWeb موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">‏‫FlyWeb با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">‏سرویس به‌روزرسان FlyWeb</translation>
<translation id="7390382558747224642">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم FlyWeb به سیستم سایت‌های FlyWeb مانند Gmail وارد شوید</translation>
<translation id="5714085538350759767">‏FlyWeb پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="5866699689358760578">‏سازمانتان (<ph name="MANAGER"/>) شما را ملزم می‌کند به سیستم FlyWeb وارد شوید</translation>
<translation id="4035053306113201399">‏برای اعمال به‌روزرسانی، ChromeOS باید بازراه‌اندازی شود.</translation>
<translation id="3750729306035486751">‏‫FlyWeb این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE"/> دقیقه باقی مانده است</translation>
<translation id="6956650624767954726">‏FlyWeb نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="197326043290947695">با «جستجوی تصویر» هوشمندانه‌تر مرور کنید</translation>
<translation id="130679046523922050">‏ببینید چرا FlyWeb برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="8243822903505210769">‏نرم‌افزار FlyWeb را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار FlyWeb به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار FlyWeb از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="6495079989036864983">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2039417478970545937">تنظیمات.</translation>
<translation id="8544477465831682343">‏انتخاب کنید که آیا سابقه FlyWeb برای تجربه‌های شخصی‌شده‌تر در سرویس‌های FlyWeb لحاظ شود یا نه</translation>
<translation id="328650761750741315">‏این ویژگی در FlyWeb تعبیه شده است تا به شما در ساختن، ذخیره، و تکمیل خودکار گذرواژه‌های قوی کمک کند. برای دسترسی آسان، میان‌بر را اضافه کنید</translation>
<translation id="2407746489237278840">‏روی دکمه «سفارشی‌سازی FlyWeb» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به FlyWeb ببخشید</translation>
<translation id="8924891216494775926">‏‫FlyWeb این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="5728214838078602184">‏دفعه بعد که FlyWeb iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME"/>» خواهید دید.</translation>
<translation id="2058207584484841616">‏گذرواژه‌ها و دیگر داده‌های FlyWeb که در «حساب FlyWeb» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در FlyWeb، دوباره به سیستم وارد شوید.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از FlyWeb استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="2125838419757773031">بخشی از صفحه‌نمایش را برای جستجو انتخاب کنید</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2135919691573380097">گزارش کردن این سایت</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="2147218225094845757">پنهان کردن پانل کناری</translation>
<translation id="4474394796469499134">‏‫FlyWeb این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="2170098639895543546">هر چیزی در صفحه را انتخاب کنید</translation>
<translation id="6765231735885996239">‏سفارشی کردن FlyWeb</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
