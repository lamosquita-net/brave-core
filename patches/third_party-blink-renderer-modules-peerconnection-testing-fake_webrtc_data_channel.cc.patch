+namespace blink {
+
+// static
+webrtc::scoped_refptr<FakeWebRTCDataChannel> FakeWebRTCDataChannel::Create() {
+  return webrtc::make_ref_counted<FakeWebRTCDataChannel>();
+}
+
+void FakeWebRTCDataChannel::RegisterObserver(
