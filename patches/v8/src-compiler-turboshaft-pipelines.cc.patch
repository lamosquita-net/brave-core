diff --git a/src/compiler/turboshaft/pipelines.cc b/src/compiler/turboshaft/pipelines.cc
index 0131e7b7c6cff0455220373309e52324cd2d674a..806dea9a8650b27c88c1e148c010e48dce0ffdad 100644
--- a/src/compiler/turboshaft/pipelines.cc
+++ b/src/compiler/turboshaft/pipelines.cc
@@ -19,7 +19,7 @@ void SimplificationAndNormalizationPhase::Run(PipelineData* data,
                InstructionSelectionNormalizationReducer>::Run(data, temp_zone);
 }
 
-void Pipeline::AllocateRegisters(const RegisterConfiguration* config,
+bool Pipeline::AllocateRegisters(const RegisterConfiguration* config,
                                  CallDescriptor* call_descriptor,
                                  bool run_verifier) {
   // Don't track usage for this zone in compiler stats.
@@ -73,6 +73,20 @@ void Pipeline::AllocateRegisters(const RegisterConfiguration* config,
 
   Run<DecideSpillingModePhase>();
   Run<AssignSpillSlotsPhase>();
+
+  // The prologue grows the frame with a single stack pointer decrement, before
+  // the function entry stack check runs. A frame no larger than the smallest OS
+  // page cannot step over a guard page, so bail out rather than emit an
+  // unchecked stack pointer jump of arbitrary size (FlyWeb: port of v8
+  // ea2f03dfff, crbug 574660146).
+  constexpr int kMaxStackSlots = 4 * KB / kSystemPointerSize;
+  if (data_->info()->IsOptimizing() &&
+      data_->frame()->GetTotalFrameSlotCount() > kMaxStackSlots) {
+    data_->info()->AbortOptimization(BailoutReason::kFunctionTooBig);
+    data()->ClearRegisterComponent();
+    return false;
+  }
+
   Run<CommitAssignmentPhase>();
 
   // TODO(chromium:725559): remove this check once
@@ -106,6 +120,7 @@ void Pipeline::AllocateRegisters(const RegisterConfiguration* config,
   }
 
   data()->ClearRegisterComponent();
+  return true;
 }
 
