<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="130631256467250065">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ, երբ վերագործարկեք սարքը:</translation>
<translation id="1555506416658437797">փոփոխել վճարման եղանակները։</translation>
<translation id="8359495463485001719">Խափանումների մասին հաղորդումը մատչելի չէ FlyWeb-ում:</translation>
<translation id="6338530717474923868">Ցուցադրվող FlyWeb էջն անվտանգ է</translation>
<translation id="5147169001159408844">FlyWeb-ը փորձում է փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="5702992568540613683">FlyWeb-ի պատկերանշանը</translation>
<translation id="510342522494506803">FlyWeb-ը փորձում է փոփոխել վճարման եղանակները։</translation>
<translation id="8375862260948854624">FlyWeb-ը ստեղծվել է շնորհիվ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> բաց կոդով նախագծի և այլ <ph name="BEGIN_LINK_OSS"/>բաց կոդով ծրագրակազմերի<ph name="END_LINK_OSS"/>:</translation>
<translation id="4281953335231207224">Անցեք
          FlyWeb-ի ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN կարգավորումներ
          և ապանշեք «Օգտագործել պրոքսի սերվեր LAN-ի համար» նշավանդակը:</translation>
<translation id="5040124620086808431">Այս էջն արգելափակվել է FlyWeb-ի կողմից</translation>
<translation id="1953000035868532675">Հրապատի կամ հակավիրուսային ծրագրի կարգավորումներում
       թույլատրեք FlyWeb-ին միանալ ցանցին:</translation>
<translation id="3442058224540562441">Անցեք
          FlyWeb-ի ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          և համոզվեք, որ ընտրված է «առանց պրոքսի-սերվերի» կամ «անմիջական» կազմաձևումը:</translation>
<translation id="585620188971323280">փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="2681118099728446983">FlyWeb-ը նաև աշխատում է այլ <ph name="BEGIN_LINK_OSS"/>բաց կոդով ծրագրակազմի<ph name="END_LINK_OSS"/> շնորհիվ։</translation>
<translation id="6888846095017247017">Փոփոխություններն ուժի մեջ կմտնեն FlyWeb-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="1017070759373671177">FlyWeb-ը ստեղծվել է <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>-ի բաց կոդով նախագծի հիման վրա։</translation>
<translation id="7777112741998051633">Անցեք
          FlyWeb ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          և ապանշեք «<ph name="NO_PREFETCH_DESCRIPTION"/>»-ը:
          Եթե խնդիրը չվերանա, խորհուրդ ենք տալիս կրկին ընտրել այս տարբերակը՝
          արդյունավետությունը բարձրացնելու համար:</translation>
<translation id="8187289872471304532">Անցեք
          Applications &gt; System Preferences &gt; Network &gt; Advanced &gt; Proxies
          և ապընտեք բոլոր ընտրված պրոքսի-սերվերները:</translation>
<translation id="4699594416850504200">Դուք դիտում եք FlyWeb for Testing-ի անվտանգ էջ</translation>
<translation id="6224789938625024797">FlyWeb-ը ճիշտ չի փակվել:</translation>
</translationbundle>