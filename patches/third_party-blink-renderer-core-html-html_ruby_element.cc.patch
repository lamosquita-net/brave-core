@@ -4,8 +4,11 @@
 
 #include "third_party/blink/renderer/core/html/html_ruby_element.h"
 
+#include "third_party/blink/renderer/core/dom/element_traversal.h"
 #include "third_party/blink/renderer/core/frame/web_feature.h"
