<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1026101648481255140">Орнатуды жалғастыру</translation>
<translation id="7099479769133613710">&amp;ChromeOS жүйесін жаңарту үшін қайта іске қосу</translation>
<translation id="291426170030461697">FlyWeb осы кеңейтімді қарап шығуды ұсынады</translation>
<translation id="1549005488226693697">Сайт беттегі сілтемелерді құпия түрде алдын ала жүктеуді сұрағанда, FlyWeb браузері FlyWeb серверлерін пайдаланады. Осылайша жеке деректеріңіз алдын ала жүктелетін сайттан жасырылады, бірақ FlyWeb алдын ала жүктелетін сайттарды біледі.</translation>
<translation id="1065672644894730302">Реттеулерді оқу мүмкін емес.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін және параметрлерге жасалған өзгертулер сақталмайды.</translation>
<translation id="8908267645832965492">Ата-анаңыз FlyWeb браузері үшін "Сайттарға, қолданбаларға және кеңейтімдерге арналған рұқсаттар" параметрін өшірді</translation>
<translation id="5557633153169217776">Маңайдағы құрылғыларды табу және пайдалану үшін FlyWeb-ге жергілікті желіні пайдалану рұқсаты қажет</translation>
<translation id="6441390163669415879">Белгілі бір FlyWeb функциясын немесе кеңейтімін іздеу үшін мекенжай жолағына оның жылдам пәрменін енгізіп, содан кейін таңдалған пернені басыңыз.</translation>
<translation id="9001750423919983557">FlyWeb-мен іздеу функциясын жүйелік науада көрсету және пернелер тіркесімін қосу</translation>
<translation id="1368460307421081773">FlyWeb құпия сөздерді экспорттағысы келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="112640046208448578">Заттарды не орындарды анықтауға және мәтінді көшіруге не аударуға болады. "Сурет іздеу" функциясын пайдаланғанда, беттің скриншоты серверге жіберіледі. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb әдепкі браузеріңіз болып табылады</translation>
<translation id="4556715463645168547">Құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK"/>FlyWeb браузеріне кіріңіз<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb мәзірін басыңыз.</translation>
<translation id="1157985233335035034">Жақында таңдалған тілдер</translation>
<translation id="1184145431117212167">Орнатылмады, себебі сіздегі Windows нұсқасына қолдау көрсетілмейді.</translation>
<translation id="4380351562011537903">FlyWeb туралы ақпарат</translation>
<translation id="853148447909557566">Телефондағы FlyWeb арқылы бағаны бақылау туралы хабарландырулар алыңыз</translation>
<translation id="1203500561924088507">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME"/> пайдаланбас бұрын браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="1232234696885483911">"Сурет іздеу" функциясын ашқан кезде, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге автоматты түрде жіберіледі. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Аккаунтқа кірсеңіз, FlyWeb-нен FlyWeb аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. Мұны өзгерту үшін "FlyWeb-дегі аккаунтыңыз" бөліміне өтіңіз.</translation>
<translation id="7614508617663739435">FlyWeb-дегі Gemini-ды Mac мәзір жолағында көрсету</translation>
<translation id="832555967476614730">FlyWeb-дегі Gemini-да экранның бір бөлігін таңдау үшін пернелер тіркесімін пайдаланыңыз.</translation>
<translation id="4750836834956739196">Бұл қойынды әрекетсіз тұрған кезде, FlyWeb жылдам жұмыс істеуі үшін, жад босатылды. Сіз бұл сайтты әрекетсіз тұру тізімінен әрдайым шығарып отыру опциясын таңдай аласыз.</translation>
<translation id="3190759351483708314">FlyWeb жүктеп алуды блоктады, себебі бұл файл қауіпті.</translation>
<translation id="5879469261638423015">Gmail не YouTube сияқты FlyWeb қызметтеріне <ph name="USER_EMAIL"/> көмегімен кірген кезде, FlyWeb-ге сол аккаунтпен автоматты түрде кіруге болады.</translation>
<translation id="7142135954326264349">FlyWeb-ді телефоныңызға орнатыңыз</translation>
<translation id="1290883685122687410">Реттеу қатесі: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Жаңа FlyWeb профилінің параметрлерін реттеу</translation>
<translation id="5252737639504553444">FlyWeb-дегі Gemini-мен байқап көру</translation>
<translation id="609743863669742325">Bluetooth құрылғыларын табу үшін FlyWeb-ге Bluetooth пайдалану рұқсаты қажет. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Телефоныңыздағы FlyWeb-ге кіріңіз</translation>
<translation id="1330562121671411446">Тілді анықтау</translation>
<translation id="2276527911011636666">Деректерді FlyWeb-нен (<ph name="URL"/>) де жою</translation>
<translation id="1345251407431278948">Бекітілді! "Сурет іздеу" функциясына құралдар тақтасындағы жаңа түймені басу арқылы қайта кіруге болады.</translation>
<translation id="1383876407941801731">Іздеу</translation>
<translation id="1045149878186896649">Жол-жөнекей шолу үшін FlyWeb пайдаланыңыз.</translation>
<translation id="141901961143729572">Ойыңызды бөлісіңіз.</translation>
<translation id="2758515779140515865">Терезені бөлісу үшін жүйе параметрлерінде FlyWeb-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="4713192356155907986">FlyWeb for Testing бойынша анықтама алу</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> құрылғысынан сақталған ақпарат пен басқа деректерді алу үшін FlyWeb-ге кіріңіз.</translation>
<translation id="1497802159252041924">Орнату қатесі: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Бұл бет қорғалған</translation>
<translation id="8962360511570172">FlyWeb қойындысын бөлісу</translation>
<translation id="2941487459666781243">FlyWeb аккаунтына кіру</translation>
<translation id="1547469039832541117">Ерекшеленген тапсырманы аяқтайды.</translation>
<translation id="3182893868355533457">FlyWeb-ді бекіту</translation>
<translation id="852852907317361085">FlyWeb-нің қауіпсіздік құралдары</translation>
<translation id="481155564361715417">FlyWeb браузері Password Manager-дегі деректеріңізді жоюға рұқсат сұрайды. Рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="2846999307505917298">Телефондағы FlyWeb-мен FlyWeb-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="3961251277542681013">FlyWeb-дегі құпиялық пен қауіпсіздікті басқарудың маңызды құралдарын қарап шығыңыз.</translation>
<translation id="1640672724030957280">Жүктеп алынып жатыр…</translation>
<translation id="1665602916345474427"><ph name="USER_NAME"/>, <ph name="USER_EMAIL"/> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="7625232007557474355">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, FlyWeb браузерін кез келген уақытта пайдалана аласыз. Сондай-ақ ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> браузеріне кеңейтілген құқықтар береді.</translation>
<translation id="5695205873161614119">FlyWeb жақын арада браузерді пайдалану деректерін жояды</translation>
<translation id="8939535770474283898">FlyWeb браузері навигацияларды HTTPS кеңейтіміне жаңартып көреді.</translation>
<translation id="2581127533455294937">FlyWeb деректері жойылды</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/> кейін қайта қосылады</translation>
<translation id="6903827847227122616">HTTPS қолжетімді болмаған кезде, FlyWeb сізге ескертпестен, қауіпті байланысты пайдаланады.</translation>
<translation id="307170399141486420">FlyWeb жүйесін фонда іске қосуға рұқсат беру</translation>
<translation id="5006568136491721884">FlyWeb-ге жылдам кіру үшін оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BEGIN_BOLD"/>Иә<ph name="END_BOLD"/> түймесін басыңыз.</translation>
<translation id="2473319786107120819">FlyWeb қайта орнату</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> қолданып көрейін деп жатыр</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін FlyWeb-ге <ph name="USER_EMAIL_ADDRESS"/> ретінде жеке профиліңізбен кіріңіз. Кеңейтімдер мен басқа деректер <ph name="DEVICE"/> құрылғысында қолжетімді болады.</translation>
<translation id="3547283483106013256">Келесі жолы FlyWeb-ді <ph name="DEVICE_TYPE"/> құрылғысынан ашқан кезде, FlyWeb Password Manager-ді пайдалану туралы нұсқауды көресіз.</translation>
<translation id="1838374766361614909">Іздеуді тазарту</translation>
<translation id="3403116471618205223">Браузерді пайдалану деректерін FlyWeb аккаунтында сақтай отырып, тек осы құрылғыдан жою үшін <ph name="BEGIN_LINK"/>FlyWeb-де аккаунттан шығыңыз<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Жолда жаңа қойындылар тобын ашу немесе жасау үшін телефоныңызға FlyWeb-ді жүктеп алыңыз.</translation>
<translation id="3285741355512747610">Кірген FlyWeb аккаунттарыңызды басқара аласыз. FlyWeb аккаунттарыңыз FlyWeb браузері, Play Store, Gmail және тағы басқа қызметтерде пайдаланылады. Егер отбасы мүшесі сияқты әлдебіреудің аккаунтын қосқыңыз келсе, жаңа пайдаланушыны <ph name="DEVICE_TYPE"/> құрылғыңызға қосыңыз. <ph name="LINK_BEGIN"/>Толығырақ<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">"Сурет іздеу" функциясымен іздеу</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін FlyWeb-ге <ph name="USER_EMAIL_ADDRESS"/> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректерді <ph name="DEVICE"/> ала аласыз.</translation>
<translation id="1880677175115548835">Мәтінді таңдаңыз</translation>
<translation id="4824940465467423308">Бақыланатын аккаунт арқылы кіріп, оның әкімшісіне FlyWeb профиліңізді басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты FlyWeb деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME"/> пайдаланушысына байланыстырылады. Бұл деректерді FlyWeb аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. Бар FlyWeb деректерін бөлек ұстау үшін қосымша жаңа профиль жасай аласыз. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb браузері біркелкі айналдыру және бейнекадр жиілігі сияқты фондық әрекеттерді және визуалдық әсерлерді шектеу арқылы батарея қуатын үнемдейді. <ph name="BEGIN_LINK"/>Қуат үнемдеу туралы толық ақпарат<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">"FlyWeb-ді жаңарту құралы" қызметі</translation>
<translation id="7390382558747224642">Бұл функцияны өшіріп, FlyWeb браузеріне кірместен Gmail сияқты FlyWeb сайттарын пайдалана беруіңізге болады</translation>
<translation id="5714085538350759767">FlyWeb жауап бермейді. Қазір қайта іске қосасыз ба?</translation>
<translation id="5866699689358760578">Ұйымыңыз (<ph name="MANAGER"/>) FlyWeb-ге кіруді талап етеді</translation>
<translation id="4035053306113201399">Жаңарту күшіне енуі үшін ChromeOS жүйесін өшіріп қосу керек.</translation>
<translation id="3750729306035486751">FlyWeb жүктеп алуды блоктады, себебі бұл файл түрі әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="1953553007165777902">Жүктеп алынып жатыр… <ph name="MINUTE"/> минут қалды.</translation>
<translation id="6956650624767954726">FlyWeb әдепкі браузерді анықтай не орната алмайды</translation>
<translation id="197326043290947695">Сурет іздеу функциясымен тиімдірек шолыңыз</translation>
<translation id="130679046523922050">Неліктен FlyWeb кейбір файлдарды блоктайтыны туралы ақпарат жаңа қойындыдан ашылады.</translation>
<translation id="8243822903505210769">FlyWeb бағдарламалық құралын жаңартып отырады. Егер бұл қызмет өшірілген немесе тоқтатылған болса, FlyWeb бағдарламалық құралыңыз жаңартылмайды. Нәтижесінде қауіпсіздік ақауларын жою мүмкін болмай, функциялар жұмыс істемеуі мүмкін. Бұл қызмет пайдаланылатын FlyWeb бағдарламалық құралы болмаса, өздігінен жойылады.</translation>
<translation id="6495079989036864983">Құрылғыдан 1 элемент жойылады. Деректерді кейінірек алу үшін FlyWeb браузеріне <ph name="USER_EMAIL"/> болып кіріңіз.</translation>
<translation id="2018879682492276940">Орнатылмады. Қайталап көріңіз.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="8544477465831682343">FlyWeb қызметтерінде жекелендірілген мүмкіндіктерді пайдалану үшін FlyWeb тарихын қосу-қоспау нұсқасын таңдаңыз.</translation>
<translation id="328650761750741315">Күрделі құпия сөздерді жасауға, сақтауға және автоматты түрде толтыруға көмектесу үшін FlyWeb-ге ендірілген. Оңай кіру үшін пернелер тіркесімін қосыңыз.</translation>
<translation id="2407746489237278840">FlyWeb-ге жаңа көрініс беру үшін жаңа қойынды бетіндегі "FlyWeb-ді бейімдеу" түймесін басыңыз.</translation>
<translation id="8924891216494775926">FlyWeb жүктеп алуды блоктады, себебі бұл – алдамшы файл және ол құрылғыңызға күтпеген өзгерістер енгізуі мүмкін.</translation>
<translation id="5728214838078602184">FlyWeb iOS браузерін келесіде ашқанда, <ph name="FEATURE_NAME"/> функциясын пайдаланып көру туралы нұсқауды көресіз.</translation>
<translation id="2058207584484841616">FlyWeb аккаунтыңызда сақталған құпия сөздеріңіз бен FlyWeb-дегі басқа деректеріңіз осы құрылғыдан өшіріледі. Оларды FlyWeb-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{FlyWeb 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{FlyWeb # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="2125838419757773031">Іздеу үшін экран аймағын таңдаңыз.</translation>
<translation id="2126108037660393668">Жүктеп алынған файл растаудан өтпеді.</translation>
<translation id="2135919691573380097">Осы сайт туралы шағымдану</translation>
<translation id="2137162749895930932">Аударма экранын жабу</translation>
<translation id="2147218225094845757">Бүйірлік панельді жасыру</translation>
<translation id="4474394796469499134">FlyWeb жүктеп алуды блоктады, себебі сайтта қауіпсіз байланыс пайдаланылып жатқан жоқ және файл өзгертілген болуы мүмкін.</translation>
<translation id="2170098639895543546">Беттен кез келген нәрсені таңдау</translation>
<translation id="6765231735885996239">FlyWeb-ді реттеу</translation>
<translation id="2174917724755363426">Орнату аяқталмады. Шынымен бас тартқыңыз келе ме?</translation>
<translation id="2937508664417729967">FlyWeb – Желіге кіру - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Жаңа нұсқаны тексеру қатесі: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Аккаунтты FlyWeb-нен өшіру</translation>
<translation id="744837314710861405">Үздік сатып алу құралдарын жол-жөнекей алып жүру үшін FlyWeb пайдаланыңыз.</translation>
<translation id="2745381939758295588">iOS жүйесіне арналған FlyWeb-дегі Күшейтілген Safe Browsing деректеріңізді фондық режимде қорғауға көмектеседі.</translation>
<translation id="6707114110652917144">Сайт қауіпті. FlyWeb хабарландыруларды өшірді.</translation>
<translation id="2236949375853147973">Әрекеттерім</translation>
<translation id="4646732243247482236">Мекенжайлар мен басқа ақпаратты барлық құрылғыдан алу үшін FlyWeb аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл мекенжай FlyWeb аккаунтыңызға сақталады.</translation>
<translation id="2726680594710751908">Компьютерді бөлісетін болсаңыз, достарыңыз интернетке бөлек кіріп, FlyWeb жүйесін қалауынша орната алады.</translation>
<translation id="4086571337340463916">FlyWeb-дегі дағдылар</translation>
<translation id="2283803047247799269">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{FlyWeb браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="2307973900865360088">Бекітілген күйде қалдыру</translation>
<translation id="5067150284614317159">URL мекенжайларын FlyWeb браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді. Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, FlyWeb браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="2356070529366658676">Сұрау</translation>
<translation id="2359808026110333948">Жалғастыру</translation>
<translation id="7339360994527471629">"<ph name="EXTENSION_NAME"/>" кеңейтімін қолдану үшін FlyWeb-ге кіруіңіз керек</translation>
<translation id="8788732221355188962">FlyWeb-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="4126251160852694747">Бұл кеңейтімді <ph name="USER_EMAIL_ADDRESS"/> ретінде пайдалану үшін FlyWeb-ге кіріңіз.</translation>
<translation id="8418845734693287262">ChromeOS деректеріңізді синхрондай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{1 HID құрылғысын бір немесе бірнеше FlyWeb кеңейтімі пайдаланды}=1{1 HID құрылғысын бір немесе бірнеше FlyWeb кеңейтімі пайдаланып жатыр}other{# HID құрылғысын бір немесе бірнеше FlyWeb кеңейтімі пайдаланып жатыр}}</translation>
<translation id="1364879203203742966">FlyWeb бұл сайт үшін камера мен микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="2403703063067034158">Іске қосу қатесі: қазір басқа орнату процесі жүріп жатыр, әрекетті кейінірек қайталаңыз.</translation>
<translation id="656987653252575654">Кез келген қолданбадағы сілтемелерді FlyWeb-нен ашып, браузерді тапсырмалар жолағында қолжетімді етіп қойыңыз.</translation>
<translation id="157662717324308283">Қысқаша мазмұнын біліп, қосымша сұрақтар қою мақсатында бұл құжатты FlyWeb-дегі Gemini-мен бөлісу үшін "Қысқаша мазмұндау" түймесін басыңыз.</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>FlyWeb-дегі құралдар<ph name="END_LINK"/> көмегімен браузерді қауіпсіз қолданып, барлығын басқаруға болады.</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін FlyWeb-ге <ph name="USER_EMAIL_ADDRESS"/> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="2451727308784734061">Password Manager қызметіне жылдам өту үшін таңбашаны пайдаланыңыз. Таңбашаны компьютердің негізгі экранына немесе қолданбаларды іске қосу тақтасына жылжытуға болады.</translation>
<translation id="3224379053610845181">FlyWeb жақын арада жабылады</translation>
<translation id="3840682988105604367">FlyWeb аясында</translation>
<translation id="2485422356828889247">Жою</translation>
<translation id="2513154137948333830">Өшіріп қосу қажет: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">"Сурет іздеу" функциясымен мәтінді таңдаңыз.</translation>
<translation id="6823116595279840454">FlyWeb бұрыннан бар құпия сөздерді ауыстырғысы келеді. Бұған рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="2691552788029831386">Файлдарды жүктеп алу үшін FlyWeb браузеріне сақтау орнын пайдалану құқығы қажет</translation>
<translation id="2275866327478859777">FlyWeb Helper</translation>
<translation id="2575822587468774919">"Сурет іздеу" функциясымен іздеу керек кез келген нәрсені таңдаңыз.</translation>
<translation id="683641781063074351">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін FlyWeb аккаунтына кіріңіз.</translation>
<translation id="1659167470250249643">FlyWeb браузерін жүктеп алу және FlyWeb аккаунтына кіру үшін телефонмен QR кодын сканерлеңіз.</translation>
<translation id="5353172248151202719">FlyWeb-мен іздеу үшін.</translation>
<translation id="3231856291920394348">FlyWeb-ді пайдалана беру</translation>
<translation id="259935314519650377">Жүктеп алынған орнату құралы кэштелмеді. Қате: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Жүйе</translation>
<translation id="7683745685556117660">Ұйымыңыз сіздегі бетбелгілер, тарих және құпия сөздер сияқты браузерді пайдалану деректерін көріп, басқара алады. Ол басқа FlyWeb профильдеріндегі браузерді пайдалану деректерін көре алмайды.</translation>
<translation id="5862783156828836752">FlyWeb деректерін <ph name="ACCOUNT_EMAIL"/> аккаунтында қолдану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="4450675160413947126">FlyWeb-ді іске қосу</translation>
<translation id="3827993926722004004">Орнату барысында операциялық жүйе қатесі орын алды. FlyWeb қайта жүктеңіз.</translation>
<translation id="333184635927514678">Құрылғыңызды басқа адамдар да пайдаланатын болса, достарыңыз және отбасыңыздың мүшелері интернетке бөлек кіріп, FlyWeb параметрлерін өздері қалағандай орната алады.</translation>
<translation id="3917488635054382918">FlyWeb кішірейтілсе де, FlyWeb-дегі Gemini-ға құрылғыңызда оңай кіріп, пайдаланыңыз.</translation>
<translation id="1257705702166647105">FlyWeb қойындысы</translation>
<translation id="2796283369875688710">Қосымша қауіпсіздік үшін FlyWeb деректеріңізді шифрлайды.</translation>
<translation id="1118215875395945816">FlyWeb-нен FlyWeb аккаунтын өшіру үшін аккаунттан шығыңыз.</translation>
<translation id="3320675843036708646">Құпия сөздерді, бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін FlyWeb аккаунтына кіріңіз.</translation>
<translation id="2738871930057338499">Интернетке қосылу мүмкін емес. HTTP 403 бойынша тыйым салынған. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="2753623023919742414">Іздеу үшін басыңыз.</translation>
<translation id="8027563534376000179">FlyWeb-ді әдепкі PDF көру құралы ретінде орнату</translation>
<translation id="7907238427168022751">Бұл кеңейтімде зиянды бағдарлама бар болғандықтан, ол қауіпті. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны FlyWeb-нан жойыңыз.</translation>
<translation id="2799223571221894425">Қайта іске қосу</translation>
<translation id="1489590198317876070">Сіздің FlyWeb браузеріңіз</translation>
<translation id="2816462166102338036">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="6850011743146651977">Жол-жөнекей iOS-тегі FlyWeb арқылы камерамен тауарларды тауып, бағаның төмендеуін бақылап, басқа да әрекеттерді орындаңыз.</translation>
<translation id="2841525013647267359">Бастапқы тіл</translation>
<translation id="2846251086934905009">Орнату қатесі: орнату аяқталмады, оның орнына доғарылды.</translation>
<translation id="1339341044496643931">FlyWeb жүйесінен алып тастау…</translation>
<translation id="4922993584046885552">Аккаунтқа кірген кезде, FlyWeb браузерінде қауіпсіздігіңізді қамтамасыз етеді және басқа FlyWeb қолданбаларында қауіпсіздік деңгейін арттыру үшін пайдаланылуы мүмкін.</translation>
<translation id="2885378588091291677">Тапсырмалар реттегіші</translation>
<translation id="3806033752149316261">&amp;FlyWeb туралы</translation>
<translation id="2915996080311180594">Кейін қайта қосу</translation>
<translation id="3497031519171753772">Деректер құпия фразаңызбен шифрланды. FlyWeb аккаунтыңызда FlyWeb деректерін пайдалану және сақтау үшін оны енгізіңіз.</translation>
<translation id="2945997411976714835">Орнату қатесі: орнату процесі басталмады.</translation>
<translation id="1784605133570901105">iOS жүйесіне арналған FlyWeb-де сақталған құпия сөздер арқылы сайттарға жылдам кіріңіз.</translation>
<translation id="5383705372991100927">FlyWeb-ді ұйымыңыз басқарады</translation>
<translation id="1661079783259785361">FlyWeb жаңартылған</translation>
<translation id="5447533789927384736">Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, FlyWeb браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="3208925917545144893">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін FlyWeb-ге кіріңіз.</translation>
<translation id="3003694935412297923">Барлық тапсырма</translation>
<translation id="1216763100505470452">{count,plural, =1{FlyWeb браузері деректерді FlyWeb аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{FlyWeb браузері деректерді FlyWeb аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="8404327407921790238"><ph name="URL"/> сілтемесі FlyWeb-дегі жаңа қойындыдан ашылады.</translation>
<translation id="5184501306555415561">Дағдылар сияқты ЖИ инновациялары FlyWeb аккаунтыңызға сақталады және FlyWeb Sync-тен бөлек басқарылады.</translation>
<translation id="4409390320695765203">Барлық құрылғыдан кеңейтімдер мен басқа ақпаратты алу үшін FlyWeb-ге кіріңіз.</translation>
<translation id="8841609317523323027">FlyWeb жүйесіне қосылуда…</translation>
<translation id="3038232873781883849">Сәлден соң орнатыла бастайды…</translation>
<translation id="3045032126857188731">Аударма тілі: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">"Пікір" диалогтік терезесін жабу</translation>
<translation id="2666189940580882376"><ph name="EXISTING_USER"/> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін FlyWeb-ге <ph name="USER_EMAIL_ADDRESS"/> ретінде жеке профиліңізбен кіріңіз. Оқу тізімі мен басқа деректерді <ph name="DEVICE"/> құрылғысынан да аласыз.</translation>
<translation id="4451837224464070850">Басқа FlyWeb профильдері</translation>
<translation id="4351369660845291597">Кеңейтімдер – FlyWeb браузерін бейімдеуге мүмкіндік беретін қосымшалар. Олар FlyWeb-ді өзіңізге ыңғайлы етіп реттеуге, күнделікті тапсырмаларды жеңілдетуге көмектеседі.</translation>
<translation id="7859502023458300952">FlyWeb компаниясына жаңылыс туралы есептер және <ph name="UMA_LINK"/> жіберу арқылы FlyWeb жақсартуға көмектесіңіз</translation>
<translation id="1125501479713660011">Жол-жөнекей FlyWeb қауіпсіздігін қамтамасыз ету үшін FlyWeb пайдаланыңыз.</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше FlyWeb кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше FlyWeb кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше FlyWeb кеңейтімі пайдаланып жатыр}}</translation>
<translation id="6017373390117959211"><ph name="DEVICE"/> құрылғысынан оқу тізімі мен басқа ақпаратты алу үшін FlyWeb-ге кіріңіз.</translation>
<translation id="7898392424469957829">FlyWeb тарихы</translation>
<translation id="1407857531570256859">Орнату құралы мұрағаттан шығара алмады. FlyWeb қолданбасын қайта жүктеңіз.</translation>
<translation id="310459126943037700">Тапсырмалар аяқталмады.</translation>
<translation id="3104828284009500087">Беттегі кез келген нәрсені іздеңіз.</translation>
<translation id="4706932464498663870">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді FlyWeb-ге жаңартып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз.</translation>
<translation id="1309738977648134943">FlyWeb микрофоныңызды пайдалануда.</translation>
<translation id="3130333203120345554">Жаңадан іздеу</translation>
<translation id="3137969841538672700">Іздеу үшін курсорды жүргізіңіз.</translation>
<translation id="2251813826843049011">Бұл қойынды ресурстарды көп қолданып жатыр. Өнімділікті жақсарту үшін FlyWeb-ге оны әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="2664701271733223256">Экранды бөлісу үшін жүйе параметрлерінде FlyWeb-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="6274649779206195384">FlyWeb қолданбасын қайта іске қосу</translation>
<translation id="3161522574479303604">Барлық тіл</translation>
<translation id="6773570808762718524">Жаңа FlyWeb профилін реттеңіз.</translation>
<translation id="8965010907836433875">Қойындыларды ауыстырмай-ақ ЖИ режимінде сөйлесе беруге болады. Бастау үшін FlyWeb-ге кіріңіз. Құпия сөздер мен басқа деректеріңіз барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="5958835776851191812">FlyWeb-нен FlyWeb аккаунтын өшіру үшін FlyWeb-нен "Параметрлер" бетінде шығыңыз.</translation>
<translation id="4217346567895356023">Кейінірек FlyWeb сізден үлгілерді автоматты түрде толтыру үшін сақталған ақпаратты пайдалану-пайдаланбау қажеттігін сұрауы мүмкін.</translation>
<translation id="5449297306961970452">FlyWeb өзінің деректер каталогін оқи және оған жаза алмайды:

<ph name="USER_DATA_DIRECTORY"/></translation>
