source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "brave_tab_strip_model_browsertest.cc" ]

  deps = [
    "//brave/components/constants",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//components/prefs",
    "//content/test:test_support",
  ]

  if (!is_android) {
    sources += [
      "shared_pinned_tab_service_browsertest.cc",
      "shared_pinned_tab_service_browsertest.h",
    ]
    deps += [
      "//chrome/browser/ui:browser_commands",
      "//chrome/browser/ui:browser_window_header",
      "//chrome/browser/ui/browser_web_contents_delegate",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/views/frame:browser_view_header",
      "//chrome/test:test_support_ui",
    ]
  }

  if (is_mac) {
    sources += [ "shared_pinned_tab_service_browsertest_mac.mm" ]
    deps += [ "//chrome/browser/ui/views/frame:browser_native_widget_mac" ]
  }
}
