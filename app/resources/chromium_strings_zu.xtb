<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="7099479769133613710">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromeOS</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="6896681084876612310">I-FlyWeb ingasiza ukukugcina uphephile kusukela ekuphulweni kwedatha, kuzandiso ezimbi, nokuningi</translation>
<translation id="1368460307421081773">I-FlyWeb ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="7307912249127683931">I-FlyWeb iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="4556715463645168547">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK"/>ngena ngemvume ku-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Chofoza imenyu ye-FlyWeb</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{Izandiso ze-FlyWeb bezifinyelela kumadivayisi e-HID}=1{Izandiso ze-FlyWeb zifinyelela kumadivayisi e-HID}one{Izandiso ze-FlyWeb zifinyelela kumadivayisi angu-# e-HID}other{Izandiso ze-FlyWeb zifinyelela kumadivayisi angu-# e-HID}}</translation>
<translation id="4380351562011537903">Mayelana ne-FlyWeb</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="4876991604685198381">Isilondolozi Senkumbulo Senze i-FlyWeb Yashesha</translation>
<translation id="4750836834956739196">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-FlyWeb ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="4549187150186083146">Setha iphrofayela yakho entsha ye-FlyWeb</translation>
<translation id="4150708158890309866">Ungene ngemvume ku-FlyWeb!</translation>
<translation id="4713192356155907986">Thola usizo nge-FlyWeb Yokuhlola</translation>
<translation id="8962360511570172">Yabelana ngethebhu ye-FlyWeb</translation>
<translation id="8196829963313696543">I-FlyWeb idinga imvume yokufinyelela kwikhamera yakho ukudala imephu engu-3D yendawo yakho ekuzungezile</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3961251277542681013">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-FlyWeb</translation>
<translation id="4434689349450618970">Uma ufuna ukusebenzisa le akhawunti kanye kuphela, ungasebenzisa <ph name="GUEST_LINK_BEGIN"/>Imodi Yesivakashi<ph name="GUEST_LINK_END"/> kwibhrawuza ye-FlyWeb. Uma ufuna ukwengeza i-akhawunti yothile, <ph name="LINK_BEGIN"/>engeza umuntu omusha<ph name="LINK_END"/> ku-<ph name="DEVICE_TYPE"/> yakho.

Izimvume ozinikezile kakade amawebhusayithi nama-app zingase zisebenze kule akhawunti. Ungakwazi nokuphatha ama-FlyWeb sync chain wakho kokuthi <ph name="SETTINGS_LINK_BEGIN"/>Amasethingi<ph name="SETTINGS_LINK_END"/>.</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="5579294097895667826">Kukhona inguqulo entsha, ephephile ye-FlyWeb etholakalayo.</translation>
<translation id="2383861520542390014">Ungabona futhi ususe izihloko zesayithi ongaba nentshisekelo kuzo ezisetshenziswa ukukubonisa izikhangiso. I-FlyWeb izolinganisa ongaba nentshisekelo kukho ngokusekelwe kumlando wakho wakamuva wokubhrawuza.</translation>
<translation id="5695205873161614119">I-FlyWeb izosula idatha yokubhrawuza maduze</translation>
<translation id="7385422968404728039">I-FlyWeb izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME"/></translation>
<translation id="307170399141486420">Vumela i-FlyWeb ukuthi isebenze ngemuva</translation>
<translation id="543905389684998697">Ukuze senze i-FlyWeb ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="2473319786107120819">Phinda ufake i-FlyWeb</translation>
<translation id="2533324957407080119">I-FlyWeb izama uku-<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4630629063306099328">Ungaphatha ama-akhawunti we-FlyWeb wakho angene ngemvume. Ama-akhawunti wakho we-FlyWeb asetshenziselwe i-browser ye-FlyWeb, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE"/> yakho kunalokho. <ph name="LINK_BEGIN"/>Funda kabanzi<ph name="LINK_END"/></translation>
<translation id="6434738578659849497">Amasayithi angagcina ulwazi nge-FlyWeb mayelana nezintshisekelo zakho. Ngokwesibonelo, uma uvakashela isayithi ukuze uthenge izicathulo zomjaho webanga elide, isayithi lingachaza intshisekelo yakho njengokugijima umjaho. Kamuva, uma uvakashela isayithi elihlukile ukuze ubhalisele umjaho, lelo sayithi lingakubonisa isikhangiso sezicathulo zokugijima ezisekelwe kuzintshisekelo zakho.</translation>
<translation id="4824940465467423308">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-FlyWeb. Idatha yakho ye-FlyWeb, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME"/>. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-FlyWeb, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-FlyWeb ihlukile. <ph name="LEARN_MORE"/></translation>
<translation id="3665070894458449212">Uma uthayipha ibha yekheli noma ibhokisi losesho, i-FlyWeb ithumela lokho okuthayiphayo ku-Google Drive ukuze ithole iziphakamiso zezinto. Lokhu kuvaliwe ku-Incognito.</translation>
<translation id="7390382558747224642">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-FlyWeb njenge-Gmail ngaphandle kokungena ngemvume ku-FlyWeb</translation>
<translation id="5714085538350759767">I-FlyWeb ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="4035053306113201399">I-ChromeOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE"/></translation>
<translation id="6956650624767954726">I-FlyWeb ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="6495079989036864983">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-FlyWeb njengo-<ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="4252651275570549255">Ukuze uhlole uma ngabe amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zokuvikela, <ph name="BEGIN_LINK"/>ngena ngemvume ku-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">Khetha ukuthi ufake phakathi umlando we-FlyWeb ukuze uthole umuzwa womuntu siqu kumasevisi e-FlyWeb</translation>
<translation id="1868972292925460871">Ulwazi olumayelana nendlela i-FlyWeb ephatha ngayo izitifiketi zayo zempande</translation>
<translation id="6765231735885996239">Yenza i-FlyWeb ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="2937508664417729967">I-FlyWeb - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-FlyWeb ngendlela abafuna ngayo nje.</translation>
<translation id="5067150284614317159">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-FlyWeb. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-FlyWeb ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="3256927121768528350">Ukuze uthumele inombolo kusukela lapha kufoni yakho ye-Android, ngena ngemvume ku-FlyWeb kuwo womabili amadivayisi.</translation>
<translation id="8776241960316471093">Lesi sandiso siguqule ukuthi yiliphi ikhasi eliboniswayo uma uqala i-FlyWeb.</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="8418845734693287262">I-ChromeOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="2100412893059179161">Isandiso esingu-"<ph name="EXTENSION_NAME"/>" siguqule ukuthi yiliphi ikhasi eliboniswayo uma uqala i-FlyWeb.</translation>
<translation id="1364879203203742966">I-FlyWeb idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2451727308784734061">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha Kusiphathi Sephasiwedi. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="3224379053610845181">I-FlyWeb izovala maduzane</translation>
<translation id="3840682988105604367">Ku-FlyWeb</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="6823116595279840454">I-FlyWeb izama ukufaka amaphasiwedi akhona esikhundleni. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="2691552788029831386">I-FlyWeb idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="2275866327478859777">Isisizi se-FlyWeb</translation>
<translation id="7717615706977383025">Noma iyiphi idatha ye-FlyWeb ekhiqizwa ngesikhathi sokusetshenziswa kwale phrofayela (efana nokudalwa kwamabhukhimakhi, umlando, amaphasiwedi, namanye amasethingi) ingasuswa umlawuli wephrofayela yomsebenzi. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">Qhubeka usebenzisa i-FlyWeb</translation>
<translation id="3827993926722004004">Iphutha le sistimu yokusebenza livele ngesikhathi sokufaka. Sicela uphinde ulande i-FlyWeb.</translation>
<translation id="333184635927514678">Uma wabelana ngedivayisi, abangane nomndeni bangaphequlula ngokuhlukile baphinde basethe i-FlyWeb ngendlela abafuna ngayo</translation>
<translation id="8991987934418988501">I-FlyWeb ivimbele leli fayela elifakwe kungobo yomlando ngoba ingase ifihle uhlelo olungayilungele ikhompyutha</translation>
<translation id="1661841342483968180">Siyakwamukela ku-FlyWeb, <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">Ithebhu le-FlyWeb</translation>
<translation id="2796283369875688710">Ngokuvikela okungeziwe, i-FlyWeb izobethela idatha yakho.</translation>
<translation id="2770231113462710648">Guqula isiphequluli esizenzakalelayo sibe yi-:</translation>
<translation id="7907238427168022751">Lesi sandiso sinohlelo olungayilungele ikhompyutha futhi asiphephile. Sisuse ku-FlyWeb ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
<translation id="8990114339313395142">Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS"/> iphrofayela entsha ye-FlyWeb</translation>
<translation id="1339341044496643931">Susa kusuka  ku-FlyWeb...</translation>
<translation id="4922993584046885552">Kukugcina uphephile ku-FlyWeb futhi kungase kusetshenziswe ukuthuthukisa ukuvikeleka kwakho kwamanye ama-app we-FlyWeb lapho ungene ngemvume</translation>
<translation id="2885378588091291677">Isiphathi somsebenzi</translation>
<translation id="3806033752149316261">Mayelana ne-&amp;FlyWeb</translation>
<translation id="2915996080311180594">Qala Kabusha Ngemuva Kwesikhathi</translation>
<translation id="2928420929544864228">Ukufaka kuqedile.</translation>
<translation id="1661079783259785361">I-FlyWeb isesikhathini samanje</translation>
<translation id="5447533789927384736">Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-FlyWeb ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile</translation>
<translation id="1244955229468464260">I-FlyWeb ayikwazi ukuhlola iphasiwedi yakho. Zama futhi emuva kwesikhathi.</translation>
<translation id="8841609317523323027">Ingeza ku-FlyWeb...</translation>
<translation id="3038232873781883849">Ilinde ukufaka...</translation>
<translation id="7859502023458300952">Siza ukwenza i-FlyWeb ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK"/> ku-FlyWeb</translation>
<translation id="4133194854947529871">Umlando wakho wokubhrawuza uthinta izikhangiso ozibonayo kanye nezinto ozishisakalelayo njengoba kulinganiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-FlyWeb isula ngokuzenzakalelayo izintshisekelo zakho njalo ngenyanga. Izintshisekelo zingavuseleleka ngaphandle kwalapho uma uzisusa.</translation>
<translation id="1407857531570256859">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-FlyWeb futhi.</translation>
<translation id="1309738977648134943">I-FlyWeb isebenzisa imakrofoni yakho.</translation>
<translation id="6274649779206195384">Phinda uqalise i-FlyWeb</translation>
<translation id="1616978953472841483">Vula isixhumanisi kuwindi le-FlyWeb Inco&amp;gnito</translation>
<translation id="6773570808762718524">Yenza ngendlela oyifisayo iphrofayela yakho entsha ye-FlyWeb</translation>
<translation id="2700572810650522793">Eshu! I-FlyWeb iphahlazekile. Qalisa kabusha manje?</translation>
<translation id="5449297306961970452">I-FlyWeb ayikwazi ukufunda nokubhala umkhombandlela wayo wedatha:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="6755586344927335130">Inguqulo ye-FlyWeb engu-<ph name="PRODUCT_VERSION"/> ifakiwe</translation>
<translation id="3286538390144397061">Qala kabusha manje</translation>
<translation id="3900612994249740104">Okhiye be-FlyWeb API abekho. Okunye ukusebenza kwe-FlyWeb kuzokhutshazwa.</translation>
<translation id="6824575001009586492">Qhubeka usebenzise izinhlelo zokusebenza ezingemuva uma i-FlyWeb ivaliwe</translation>
<translation id="5399208721646088502">Iphrofayela ye-FlyWeb enale akhawunti isikhona kakade</translation>
<translation id="2645435784669275700">I-ChromeOS</translation>
<translation id="7978410129406361692">Shintshela kwiphrofayela le-FlyWeb elikhona kakade?</translation>
<translation id="3412460710772753638">Kokuthi Isiphathi Sephasiwedi kule divayisi</translation>
<translation id="847273641988291714">Ngamaphrofayela we-FlyWeb ungahlukanisa zonke izinto zakho ze-FlyWeb. Dala amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="1558345997029205345">I-FlyWeb izokwazisa uma ungena ngemvume ngephasiwedi eyonakalisiwe</translation>
<translation id="956833467923764542">Lokhu kuzobuyekeza izinto ezingu-<ph name="ITEMS_COUNT"/> kusuka kule divayisi. Ukuze ubuyise idatha yakho, ngena ngemvume ku-<ph name="USER_EMAIL"/> njengo.</translation>
<translation id="4772642827282964272">I-<ph name="SHORTCUT"/> ingashintsha phakathi kwamaphrofayela we-FlyWeb</translation>
<translation id="6724485219247982027">Sicela uvale wonke amawindi we-FlyWeb uphinde uzame futhi.</translation>
<translation id="763231524941489073">Ukuze sivikele ubumfihlo bakho, sisula ngokuzenzakalelayo izintshisekelo zakho ezindala kunamaviki ama-4. Njengoba uqhubeka nokubhrawuza, intshisekelo ingase ivele ohlwini futhi. Noma ungasusa izithakazelo ongafuni ukuthi i-FlyWeb izicabangele.</translation>
<translation id="4856314253538330936">Umlando wakho wokubhrawuza, irekhodi lamasayithi owavakashele usebenzisa i-FlyWeb kule divayisi.</translation>
<translation id="1054901839328542426">Kunesofthiwe eyingozi kwikhompyutha yakho. I-FlyWeb ingayisusa, ibuyise izilungiselelo zakho, futhi ikhubaze izandiso ukwenza isiphequluli sakho sisebenze kahle futhi.</translation>
<translation id="199853864262219284">Enye i-akhawunti isivele ingene ngemvume. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-FlyWeb ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="9154454584386840012">Ukuze uthole izibuyekezo zesikhathi esizayo ze-FlyWeb, uzodinga i-macOS 10.15 noma eyakamuva. Le khompyutha isebenzisa i-macOS 10.13.</translation>
<translation id="3293172835368652510">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-FlyWeb njengo-<ph name="USER_EMAIL"/>.</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{Isibuyekezo esisha se-FlyWeb siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-FlyWeb siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-FlyWeb siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-FlyWeb siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="7465608402296261674">Ukuze uthumele inombolo kusukela ku-<ph name="ORIGIN"/> kufoni yakho ye-Android, ngena ngemvume ku-FlyWeb kuwo womabili amadivayisi.</translation>
<translation id="1543563097158722437">I-FlyWeb ayikwazi ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="190360428475385352">Funda kabanzi mayelana nokwenza izikhangiso zibe ngezakho ku-FlyWeb</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{Umlawuli wakho ucela ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe lesi sibuyekezo}=1{Umlawuli wakho ucela ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe lesi sibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho ucela ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho ucela ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="6611602069520888180">Vula isixhumanisi ku&amp;thebhu elisha le-FlyWeb</translation>
<translation id="8701399577028839698">I-FlyWeb ikuvumela ukuthi uchofoze inombolo yefoni kuwebhu uphinde uyishayele nge-Skype!</translation>
<translation id="2401189691232800402">Isistimu ye-ChromeOS</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">Thola usizo nge-ChromeOS</translation>
<translation id="1864899808802540927">Thola ibhrawuza yakho ye-FlyWeb kusukela ku-<ph name="ACCOUNT_EMAIL"/></translation>
<translation id="2736927994658608637">Ukuze uthole izibuyekezo zesikhathi esizayo ze-FlyWeb, uzodinga i-macOS 10.15 noma eyakamuva. Le khompyutha isebenzisa i-macOS 10.14.</translation>
<translation id="5175060854726708547">Yenza ngokwezifiso uphinde ulawule i-FlyWeb. Okuthile kudinga ukuthi ukunake - chofoza ngemininingwane.</translation>
<translation id="606156353708638647">Chofoza igama lakho ukuze uvule i-FlyWeb uphinde uqale ukudlulisa amehlo.</translation>
<translation id="5145107420478372433">U-<ph name="EXISTING_USER"/> usengene ngemvume kakade kule phrofayela ye-FlyWeb. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-FlyWeb ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="3470813199863172076">Lesi sandiso sephula inqubomgomo Yesitolo sewebu se-FlyWeb, futhi kungenzeka singabi esiphephile. Sisuse ku-FlyWeb ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="3376157109651222096">I-akhawunti yakho iphethwe i-<ph name="MANAGER_NAME"/>. Umlawuli wakho angabona futhi ahlele le phrofayela yebhrawuza ye-FlyWeb nedatha yayo efana namabhukhimakhi, umlando, namaphasiwedi.</translation>
<translation id="8536259619256229278">I-FlyWeb izama ukukopisha amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="4041003017438130352">I-FlyWeb incoma ukuthi uskene leli fayela ngenxa yokuthi kungenzeka ukuthi liyingozi</translation>
<translation id="5667414856761616811">Mayelana ne-&amp;FlyWeb Yokuhlola</translation>
<translation id="1152920704813762236">Mayelana ne-ChromeOS</translation>
<translation id="3703994572283698466">I-ChromeOS yenziwe ukuthi isebenze ngesofthiwe yomthombo ovulekile owengeziwe<ph name="BEGIN_LINK_CROS_OSS"/>isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS"/>, njengoba kunjalo ngendawo yokuthuthukiswa kwe-<ph name="BEGIN_LINK_LINUX_OSS"/>Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="504994999924593940">Siza i-FlyWeb ibengcono ngokubika <ph name="BEGIN_LINK"/>izilungiselelo zamanje<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="4055805654398742145">Umphathi Wephasiwedi</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Inhlangano yakho ivala i-FlyWeb ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}one{Inhlangano yakho ivala i-FlyWeb ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}other{Inhlangano yakho ivala i-FlyWeb ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}}</translation>
<translation id="4148957013307229264">Iyafaka...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - Inethiwekhi Yokungena ngemvume - i-FlyWeb</translation>
<translation id="4007949387571083162">Thola izinhlelo zokusebenza ezinhle, amageyimu, izandiso, namatimu we-FlyWeb.</translation>
<translation id="1595210458721188387">Lolu limi lusetshenziselwa ukubonisa i-FlyWeb UI</translation>
<translation id="4222932583846282852">Iyakhansela...</translation>
<translation id="2564888740660198776">Xhumanisa idatha yakho ye-FlyWeb kule akhawunti?</translation>
<translation id="8514458758262040082">Thola usizo nge-FlyWeb</translation>
<translation id="3393587701694585022">Ukufaka kuhlulekile ngenxa yephutha elingacacisiwe. Uma ngabe i-FlyWeb iyasebenza manje, sicela uyivale uphinde uzame futhi.</translation>
<translation id="4304713468139749426">Isiphathi sephasiwedi</translation>
<translation id="4334294535648607276">Ukulanda kuqedile.</translation>
<translation id="1068681683510904753">I-<ph name="MANAGER"/> idinga ukuthi ufunde uphinde wamukele Imigomo Yesevisi elandelayo ngaphambi kokusebenzisa le divayisi. Le migomo ayinwebi, iguqule noma ikhawulele Imigomo ye-ChromeOS.</translation>
<translation id="1376968889000878095">Phuma ku-FlyWeb noma kunjalo?</translation>
<translation id="6360389033094512399">Vumela i-FlyWeb isebenze ngemuva</translation>
<translation id="4166347503469830337">Yenza ngokwezifiso uphinde ulawule i-FlyWeb</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
<translation id="8791209382165811772">Mayelana ne-FlyWeb Yokuhlola</translation>
<translation id="834808339160590901">Siyakwamukela ku-FlyWeb; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="1304885695888649052">I-FlyWeb ayibuyekezekanga, kunokuthile okungahambanga kahle. <ph name="BEGIN_LINK"/>Lungisa izinkinga zokubuyekaza kwe-FlyWeb nezibuyekezo ezihlulekile.<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">Qhubeka kuphrofayela entsha ye-FlyWeb?</translation>
<translation id="4567424176335768812">Ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS"/>. Manje ungakwazi ukufinyelela amabhukhimakhi, umlando, nezinye izilungiselelo kuwo wonke amadivayisi wakho ongene kuwo ngemvume.</translation>
<translation id="4594305310729380060">Kusiphathi Sephasiwedi kule divayisi</translation>
<translation id="6046424510733540251">Izinhlelo zokusebenza ze-FlyWeb</translation>
<translation id="4970880042055371251">Uhlobo lwe-ChromeOS</translation>
<translation id="1936188352112244665">Icishe isesikhathini! Qalisa kabusha i-FlyWeb ukuze uqedele ukubuyekeza.</translation>
<translation id="5382847955032513683">Isexwayiso: I-FlyWeb ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="2962574118577609024">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-FlyWeb, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="9219132550163437762">Iphrofayela ibukeka isetshenziswa enye inqubo ye-FlyWeb (<ph name="PROCESS_ID"/>) kwenye ikhompyutha (<ph name="HOST_NAME"/>). I-FlyWeb ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-FlyWeb.</translation>
<translation id="4680828127924988555">Khansela Ukufaka</translation>
<translation id="5227023869666757348">Umuntu othile ungene ngemvume ngaphambilini ku-FlyWeb kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST"/>. Sicela udale umsebenzisi omusha we-FlyWeb ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="1671154647029930623">Phuma ku-FlyWeb noma kunjalo?</translation>
<translation id="4143239505982500022">Isibuyekezo esibalulekile sokuvikela se-FlyWeb sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="1347247057384060764">Ungashintsha umqondo wakho noma kunini kumasethingi we-FlyWeb. Izivivinyo zisebenza eduze kwendlela yamanje yokulethwa kwezikhangiso, ngakho ngeke ubone izinguquko ngokushesha.</translation>
<translation id="4259200560913816786">I-FlyWeb ayikwazi ukuhlola iphasiwedi yakho. Zama futhi ngemva kwamahora angu-24 noma <ph name="BEGIN_LINK"/>hlola amaphasiwedi ku-akhawunti yakho ye-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-FlyWeb. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-FlyWeb. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="2991144524835127379">Umyalo obambeke ngaphakathi we-FlyWeb wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="6208903184719035736">Qalisa kabusha ukuze Ubuyekeze i-&amp;FlyWeb</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-FlyWeb ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda. Amathebhu akho akhona azohlala evuliwe.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzakekelayo uma i-FlyWeb ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda. Amathebhu akho akhona azohlala evuliwe.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzakekelayo uma i-FlyWeb ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda. Amathebhu akho akhona azohlala evuliwe.}}</translation>
<translation id="7174589544844983914">I-FlyWeb kumodi yasemuva.</translation>
<translation id="7792628702371319769">Izihambeli zingasebenzisa i-FlyWeb ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="2760069255902967585">Zingeze ngokwakho ku-FlyWeb</translation>
<translation id="4239638419916712076">I-FlyWeb ihlola izakhi ezintsha ezivumela amasayithi ukuthi alethe ukuzizwisa kokubhrawuza okufanayo kusetshenziswa ulwazi lwakho oluncane</translation>
<translation id="387444474697464273">Awekho amaphasiwedi alondoloziwe. I-FlyWeb ingahlola amaphasiwedi akho lapho uwalondoloza khona.</translation>
<translation id="520701392326482190">U-<ph name="EXISTING_USER"/> usengene ngemvume kakade kule phrofayela ye-FlyWeb. Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS"/> iphrofayela entsha ye-FlyWeb</translation>
<translation id="8295539942024823191">Ukuze ufake izinguquko zakho, qalisa kabusha i-FlyWeb</translation>
<translation id="5374328929709976901">Uma izivivinyo zivuliwe futhi i-FlyWeb ikubeke ngokungahleliwe ekuzameni okusebenzayo, umlando wakho wokubhrawuza uthinta izikhangiso ozibonayo kanye nezinto ozithakaselayo njengoba kusikiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-FlyWeb isula izintshisekelo zakho njalo ngenyanga.</translation>
<translation id="8449603408481238073">Ungena ngemvume nge-akhawunti ephethwe futhi unikeza umlawuli wayo ukulawula okungaphezulu kwephrofayela yakho ye-FlyWeb. Idatha yakho ye-FlyWeb, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshezelwa unaphakade ku-<ph name="USER_NAME"/>. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-FlyWeb, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">Ibuyekeza i-FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">Vumela ukungena ngemvume kwe-FlyWeb</translation>
<translation id="5965500511473700110">Kukhona inguqulo entsha ye-FlyWeb etholakalayo.</translation>
<translation id="1827750898515917134">Susa kusuka  ku-FlyWeb</translation>
<translation id="5020755920249060562">Setha i-FlyWeb njengesiphequluli sakho esizenzakalelayo</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb Beta</translation>
<translation id="5385202369020319636">I-FlyWeb kungenzeka ingasebenzi ngokufanelekile ngoba ayisasekelwa kule sistimu yokusatshalaliswa kwe-Linux</translation>
<translation id="5957333939864770801">I-FlyWeb idinga ukufinyelela kundawo yakho ukuze yabelane ngendawo yakho naleli sayithi</translation>
<translation id="780999790006298623">Ukuze sivikele ubumfihlo bakho, sisula ngokuzenzakalelayo izintshisekelo zakho ezindala kunamaviki ama-4. Njengoba uqhubeka nokubhrawuza, intshisekelo ingase ivele ohlwini futhi. Futhi uma i-FlyWeb ikuthola kungalungile noma ungafuni ukubona izikhangiso ezithile, ungayisusa intshisekelo.</translation>
<translation id="2183749398075655200">Sicela ulinde ngenkathi i-FlyWeb ifaka izibuyekezo zesistimu zakamuva.</translation>
<translation id="8996657165865563765">I-FlyWeb izama ukuhlela amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="5738298079259740925">Vula ama-PDF ku-FlyWeb</translation>
<translation id="9197514179291669592">Lapho ivuliwe, uzophinde futhi uphume ngemvume ku-FlyWeb</translation>
<translation id="6096945112863785306">{0,plural, =0{Isibuyekezo se-FlyWeb siyatholakala}=1{Isibuyekezo se-FlyWeb siyatholakala}one{Isibuyekezo se-FlyWeb sitholakala ngezinsuku ezingu-#}other{Isibuyekezo se-FlyWeb sitholakala ngezinsuku ezingu-#}}</translation>
<translation id="5666891644992637849">Sicela uqalise kabusha i-FlyWeb manje</translation>
<translation id="2081080188998199150">I-FlyWeb LLC</translation>
<translation id="4985093807982416118">Veza i-FlyWeb ngalolu limi</translation>
<translation id="8331941171144629807">Siyakwamukela ku-FlyWeb</translation>
<translation id="7581082856615467651">I-FlyWeb ithole ukuthi lezi zinto zinohlelo olungayilungele ikhompyutha</translation>
<translation id="5895138241574237353">Qalisa kabusha</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - Inethiwekhi Yokugena ngemvume</translation>
<translation id="5924017743176219022">Ixhuma Ku-inthanethi...</translation>
<translation id="5941711191222866238">Nciphisa</translation>
<translation id="483902194277448471">Uma i-FlyWeb ikubeke ngokungahleliwe esivivinyweni esisebenzayo, umlando wakho wokuphequlula uthinta izikhangiso ozibonayo kanye nezinto ozithakaselayo njengoba kusikiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-FlyWeb isula izintshisekelo zakho njalo ngenyanga. Izintshisekelo ziyavuseleleka ngaphandle kwalapho uma uzisusa.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Inhlangano yakho ivala i-FlyWeb ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1.}one{Inhlangano yakho ivala i-FlyWeb ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}other{Inhlangano yakho ivala i-FlyWeb ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}}</translation>
<translation id="4955869506208896934">Buyekeza i-FlyWeb ukuze uqale ukuvumelanisa</translation>
<translation id="63409513082302419">Kujwayelekile ukuthi amasayithi owavakashelayo akhumbule izinto onentshisekelo kuzo, enze ukuzizwela kube ngokwezifiso. Amasayithi angagcina nolwazi nge-FlyWeb mayelana nezintshisekelo zakho.</translation>
<translation id="6003112304606738118">Iyadawuniloda... Kusele amahora angu-<ph name="HOURS"/></translation>
<translation id="6040143037577758943">Vala</translation>
<translation id="2904199563401682369">Kukhona inguqulo entsha ye-FlyWeb etholakalayo, futhi ishesha kakhulu kunakuqala.</translation>
<translation id="8714139918792771260">&amp;Vula ku-FlyWeb</translation>
<translation id="499541338626558192">I-<ph name="EXTENSION_NAME"/> ingezwe ku-FlyWeb</translation>
<translation id="3890023823480067024">Yenza i-FlyWeb Isheshe</translation>
<translation id="608006075545470555">Engeza Iphrofayela Yomsebenzi kulesi siphequluli</translation>
<translation id="5880307616068888895">Enza ngendlela oyifisayo uphinde ulawule i-FlyWeb. Isibuyekezo siyatholakala.</translation>
<translation id="8890528681896757647">Uma ivuliwe, i-FlyWeb igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ozimele wevidiyo.</translation>
<translation id="1683225514126450592">Vumela isandiso ukuze ubonise izicelo zokufinyelela kubha yamathuluzi ye-FlyWeb</translation>
<translation id="5171527334826689262">I-FlyWeb izolondoloza le phasiwedi ku-akhawunti yakho ye-FlyWeb. Ngeke kudingeke ukuthi uyikhumbule.</translation>
<translation id="4809579265564854985">I-<ph name="FILE_NAME"/> iyingozi, ngakho-ke i-FlyWeb iyivimbile.</translation>
<translation id="1773252983747911987">I-FlyWeb izovala maduzane futhi isule idatha</translation>
<translation id="3063780243670578104">Ukuphequlula Okuphephile kuvaliwe. i-FlyWeb incoma ukuba kuvulwe.</translation>
<translation id="1686760912855738719">Ungashintsha phakathi kwamaphrofayela we-FlyWeb lapha</translation>
<translation id="4403968929742079769">Yenza isiqinisekiso sokuthi ungene ngemvume ku-FlyWeb ku-<ph name="TARGET_DEVICE_NAME"/> yakho bese uzama ukuthumela futhi.</translation>
<translation id="1855179706668101462">Le khompyutha isivele inenguqulo yakamuva kakhulu ye-FlyWeb. Uma isofthiwe ingasebenzi, sicela ukhiphe i-FlyWeb uphinde uzame futhi.</translation>
<translation id="651290634887454330">{0,plural, =0{I-FlyWeb izoqalisa kabusha manje}=1{I-FlyWeb izoqalisa kabusha kusekhondi elingu-1}one{I-FlyWeb izoqalisa kabusha kumasekhondi angu-#}other{I-FlyWeb izoqalisa kabusha kumasekhondi angu-#}}</translation>
<translation id="2586408713760853791">I-FlyWeb idinga imvume yokufinyelela kusitoreji ukuze idawunilode amafayela</translation>
<translation id="1603558835003845196">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-FlyWeb</translation>
<translation id="5751080530525677552">Yenza i-FlyWeb ibe yisiphequluli esizenzakalelayo</translation>
<translation id="4804111781678641302">I-FlyWeb ayikwazi ukuhlola izibuyekezo. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="3542157007113577464">Phuma ku-FlyWeb?</translation>
<translation id="6273793429163604305">Guqani...</translation>
<translation id="3794967601634523398">Yenza ngokwezifiso iphrofayela yakho ye-FlyWeb</translation>
<translation id="6475001900959697061">Qama iphrofayela lakho le-FlyWeb</translation>
<translation id="4465156155012748592">I-<ph name="FILE_NAME"/> kungenzeka ibe ingozi, ngakho-ke i-FlyWeb iyivimbile.</translation>
<translation id="5523868569707953059">I-FlyWeb isebenzisa ikhamela yakho.</translation>
<translation id="5914697581312472089">I-FlyWeb ivimbele leli fayela ngoba liyingozi</translation>
<translation id="6327105987658262776">Asikho isibuyekezo esitholakalayo.</translation>
<translation id="8226838065217375546">Okunye ukusebenza ku-FlyWeb kuyaqhubeka. Sicela uzame futhi emuva kwesikhathi.</translation>
<translation id="6063700568539132984">Manje kulula ukusebenzisa i-FlyWeb nge-Akhawunti yakho ye-FlyWeb nakumakhompyutha abiwe.</translation>
<translation id="6890209090736444656">Ingabe uqinisekile ukuthi ufuna ukukhipha i-FlyWeb?</translation>
<translation id="6375219077595103062">Engeza isinqamuleli Kusiphathi Sephasiwedi</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>Indlela esisebenzisa ngayo le datha:<ph name="END_BOLD"/> I-FlyWeb ingalinganisela izintshisekelo zakho. Kamuva, isayithi olivakashelayo lingacela i-FlyWeb ukuthi ibone izintshisekelo zakho ukuze yenze izikhangiso ozibonayo ngokwezifiso zakho.</translation>
<translation id="6636986997730784876">I-FlyWeb yisiphequluli sewebhu esiqalisa amakhasi wewebhu nezinhlelo zokusebenza ngesivinini sombani. Iyashesha, izinzile, futhi isebenziseka kalula. Dlulisa amehlo kuwebhu ngokuvikeleke kakhulu ngokuvikelwa kuhlelo olungayilungele ikhompyutha nobugebengu bokweba imininingwane ebucayi eyakhelwe ku-FlyWeb.</translation>
<translation id="2139300032719313227">Qalisa kabusha i-ChromeOS</translation>
<translation id="173462352822069427">Siyakwamukela kumaphrofayela we-FlyWeb</translation>
<translation id="1474676525193357364">Iphinde ilawule ukuthi iliphi ikhasi eliboniswa lapho uqala i-FlyWeb.</translation>
<translation id="648319183876919572">Ukubhrawuza Ngokuphepha Okugqamile kwenza okuningi ukukuvikela kumawebhusayithi ayingozi nakokudawunilodiwe</translation>
<translation id="5777905264835557372">Khipha i-FlyWeb</translation>
<translation id="8852057261917278552">Inhlangano yakho ivala i-FlyWeb uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION"/>. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="8592211619057897362">Iphrofayela ngalinye linolwazi lwalo lwe-FlyWeb njengamabhukhimakhi, umlando, amaphasiwedi, nokuningi</translation>
<translation id="7489092380688543560">Ungashintsha ukuze ubone amaphasiwedi kusuka kwenye iphrofayela ye-FlyWeb</translation>
<translation id="8243012192239086369">Ukuze kulungiswe amaphutha okupeletwa, i-FlyWeb ithumela umbhalo owuthayiphayo kuzinkambu zombhalo ku-FlyWeb</translation>
<translation id="3927263773110604886">Iya kuzilungiselelo zesaziso se-FlyWeb</translation>
<translation id="6888846095017247017">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-FlyWeb.</translation>
<translation id="1886169834787876002">I-FlyWeb idinga imvume yekhamera ukudala imephu ye-3D yendawo yakho ekuzungezile</translation>
