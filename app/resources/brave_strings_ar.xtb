<translation id="2542968102051442371">اختيار نص باستخدام ميزة "بحث بالصور"</translation>
<translation id="6823116595279840454">‏يحاول FlyWeb استبدال كلمات المرور الحالية. للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="2691552788029831386">‏يحتاج FlyWeb إلى الوصول إلى مساحة التخزين لتنزيل الملفات.</translation>
<translation id="2275866327478859777">‏أداة مساعدة FlyWeb</translation>
<translation id="2575822587468774919">انقر أي محتوى للبحث عنه باستخدام ميزة "البحث بالصور"</translation>
<translation id="683641781063074351">‏سجِّل الدخول إلى FlyWeb للوصول إلى كلمات المرور وغيرها على جميع أجهزتك</translation>
<translation id="1659167470250249643">‏يمكنك مسح رمز الاستجابة السريعة ضوئيًا باستخدام هاتفك لتنزيل تطبيق FlyWeb وتسجيل الدخول إلى حساب FlyWeb.</translation>
<translation id="5353172248151202719">‏للبحث باستخدام FlyWeb</translation>
<translation id="3231856291920394348">‏مواصلة استخدام FlyWeb</translation>
<translation id="259935314519650377">تعذَّر إجراء تخزين مؤقت للمثبّت الذي تم تنزيله. الخطأ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">النظام</translation>
<translation id="7683745685556117660">‏يمكن لمؤسستك الاطّلاع على بيانات التصفّح وإدارتها، مثل الإشارات المرجعية والسجلّ وكلمات المرور. ولا يمكنها الاطّلاع على بيانات التصفّح في الملفات الشخصية الأخرى على FlyWeb</translation>
<translation id="5862783156828836752">‏يُرجى إثبات هويتك لاستخدام بيانات FlyWeb وحفظها في حسابك (<ph name="ACCOUNT_EMAIL"/>)</translation>
<translation id="4450675160413947126">‏بدء FlyWeb</translation>
<translation id="3827993926722004004">‏حدث خطأ في نظام التشغيل أثناء عملية التثبيت. يُرجى إعادة تنزيل FlyWeb.</translation>
<translation id="333184635927514678">‏في حال مشاركة جهاز مع الأصدقاء والعائلة، يمكنهم الحصول على تجربة تصفّح منفصلة وإعداد FlyWeb على النحو المفضّل لديهم.</translation>
<translation id="3917488635054382918">‏يتيح لك هذا الزر الوصول بسهولة إلى "Gemini في FlyWeb" واستخدامه على جهازك، حتى إذا كان FlyWeb مصغّرًا.</translation>
<translation id="1257705702166647105">‏علامة تبويب FlyWeb</translation>
<translation id="2796283369875688710">‏لمزيد من الأمان، سيشفر FlyWeb بياناتك</translation>
