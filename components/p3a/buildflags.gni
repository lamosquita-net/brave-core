declare_args() {
  brave_p3a_enabled = true
  p3a_json_upload_url = ""
  p3a_creative_upload_url = ""
  p2a_json_upload_url = ""
  p3a_constellation_upload_url = ""
  star_randomness_host = ""
}

# FlyWeb: P3A is compiled out (brave_p3a_enabled=false in build.sh). Only require
# the upload URLs when it is enabled, so official (Release) builds work without it.
if (is_official_build && brave_p3a_enabled) {
  assert(p3a_json_upload_url != "" &&
             p3a_creative_upload_url != "" && p2a_json_upload_url != "" &&
             p3a_constellation_upload_url != "" && star_randomness_host != "",
         "P3A config must be defined")
}
