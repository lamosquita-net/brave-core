+  InsetAreaRegion start = area.FirstStart();
+  InsetAreaRegion end = area.FirstEnd();
+
+  span_value->Append(*CSSIdentifierValue::Create(start));
+  if (start != end) {
+    span_value->Append(*CSSIdentifierValue::Create(end));
+  }
+  area_value->Append(*span_value);
