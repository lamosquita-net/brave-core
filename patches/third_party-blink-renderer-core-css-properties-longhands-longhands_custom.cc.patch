+  CSSValueList* ident_list = CSSValueList::CreateSpaceSeparated();
+  for (const auto& class_name : style.ViewTransitionClass()) {
+    ident_list->Append(*MakeGarbageCollected<CSSCustomIdentValue>(class_name));
