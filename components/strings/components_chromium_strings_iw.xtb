<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="130631256467250065">השינויים ייכנסו לתוקף בפעם הבאה שהמכשיר יופעל מחדש.</translation>
<translation id="125853961893919199">‏טיפ ל-FlyWeb: שמירת סיסמאות</translation>
<translation id="1589233279653618219">‏צריך להיכנס אל
          תפריט FlyWeb‏ &gt;
          <ph name="SETTINGS_TITLE"/>
          ‏&gt;
          <ph name="SYSTEM_TITLE"/>
          ‏&gt;
          <ph name="PROXIES_TITLE"/>
          ולבדוק שהתצורה מוגדרת לאפשרות no proxy (ללא שרת proxy‏) או direct (ישיר).</translation>
<translation id="8359495463485001719">‏דיווח על התרסקויות אינו זמין ב-FlyWeb.</translation>
<translation id="6338530717474923868">‏זהו דף מאובטח של FlyWeb</translation>
<translation id="5147169001159408844">‏FlyWeb מנסה לשנות את ההגדרות למילוי אמצעי התשלום.</translation>
<translation id="5702992568540613683">‏לוגו של FlyWeb</translation>
<translation id="8966580353365544289">‏טיפ ל-FlyWeb: הגרסה המשופרת של הגלישה הבטוחה</translation>
<translation id="510342522494506803">‏FlyWeb מנסה לערוך את אמצעי התשלום.</translation>
<translation id="8375862260948854624">‏FlyWeb קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM"/> FlyWeb‏<ph name="END_LINK_CHROMIUM"/> ו<ph name="BEGIN_LINK_OSS"/>תוכנות קוד פתוח<ph name="END_LINK_OSS"/> אחרות.</translation>
<translation id="5040124620086808431">‏הדף הזה נחסם על ידי FlyWeb</translation>
<translation id="1953000035868532675">‏שינוי הגדרות חומת האש או האנטי-וירוס כדי לאפשר ל-FlyWeb
          לגשת לרשת.</translation>
<translation id="4949828774841497663">‏עוברים אל "אפליקציות" &gt; "הגדרות המערכת" &gt; "רשת", ובוחרים את
          הרשת הפעילה, לוחצים על הכפתור "פרטים…" ומבטלים את הבחירה בכל שרתי ה-proxy
          שנבחרו.</translation>
<translation id="7584668345330431749">‏צריך להיכנס אל
          תפריט FlyWeb‏ &gt;
          <ph name="SETTINGS_TITLE"/>
          ‏&gt;
          <ph name="SYSTEM_TITLE"/>
          ‏&gt;
          <ph name="PROXIES_TITLE"/>
          ‏&gt;
          Network &amp; internet (רשת ואינטרנט) &gt; Proxy (שרת proxy)
          ולבטל את הבחירה באפשרות Automatically detect settings (זיהוי אוטומטי של ההגדרות).</translation>
<translation id="3145451630329266064">‏הדפים האלה מיועדים למפתחי FlyWeb. יכול להיות שהם לא מתוחזקים או נבדקים באופן פעיל. כדי להפעיל אותם, עוברים לכתובת <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, לוחצים על הכפתור כדי להפעיל את מצב ניפוי הבאגים בדפים, ואז מנווטים בחזרה לדף הזה.</translation>
<translation id="2681118099728446983">‏FlyWeb קיים גם הודות ל<ph name="BEGIN_LINK_OSS"/>תוכנת קוד פתוח<ph name="END_LINK_OSS"/> אחרת.</translation>
<translation id="6888846095017247017">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את FlyWeb‏.</translation>
<translation id="8524328905288851065">‏ל-FlyWeb נדרשת גישה ל-Bluetooth כדי להמשיך 
 את ההתאמה. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">‏FlyWeb קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">‏יש להיכנס אל
        תפריט FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ולבטל את הבחירה באפשרות '<ph name="NO_PREFETCH_DESCRIPTION"/>'.
        אם פעולה זו אינה פותרת את הבעיה, מומלץ לבחור שוב באפשרות זו
        לקבלת ביצועים משופרים.</translation>
<translation id="4699594416850504200">‏זהו דף מאובטח של FlyWeb for Testing</translation>
<translation id="6224789938625024797">‏כיבוי FlyWeb לא בוצע כהלכה.</translation>
<translation id="3593104813552438879">‏טיפ ל-FlyWeb: חיפוש באמצעות Lens</translation>
</translationbundle>