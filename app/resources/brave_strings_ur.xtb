<translation id="1886169834787876002">‏FlyWeb کو آپ کے اطراف کا 3D نقشہ تخلیق کرنے کے لیے کیمرے کی اجازت درکار ہے</translation>
<translation id="7570986009744020649">‏اگر آپ اپنے بُک مارکس کو اپنے FlyWeb اکاؤنٹ میں بھی محفوظ کرتے ہیں تو آپ FlyWeb میں پروڈکٹ کی قیمتوں کو ٹریک کر سکتے ہیں اور قیمت میں گراوٹ ہونے پر اطلاع حاصل کر سکتے ہیں</translation>
<translation id="6676384891291319759">انٹرنیٹ تک رسائی حاصل کریں</translation>
<translation id="1363996462118479832">‏ChromeOS سائن ان میں ایک خرابی کی وجہ سے آپ کے ڈیٹا کی مطابقت پذیری نہیں کر سکا۔</translation>
<translation id="5743696427773796626">‏‫FlyWeb سے اس ایپس کا ڈیٹا ہٹائیں</translation>
<translation id="4152880912192471857">‏FlyWeb کو اس سائٹ کے لیے مائیکروفون کی اجازت درکار ہے</translation>
<translation id="6712881677154121168">ڈاؤن لوڈ سے متعلق خرابی: <ph name="DOWNLOAD_ERROR"/>۔</translation>
<translation id="2193001403607253406">‏آپ کا پروفائل استعمال نہیں کیا جا سکتا ہے کیونکہ یہ FlyWeb کے ایک جدید تر ورژن سے ہے۔

ممکن ہے کچھ خصوصیات غیر دستیاب ہوں۔ براہ کرم ایک مختلف پروفائل ڈائریکٹری متعین کریں یا FlyWeb کا ایک جدید تر ورژن استعمال کریں۔</translation>
<translation id="5528558621229392814">‏ذاتی نوعیت سازی اور دیگر خصوصیات حاصل کرنے کے لیے، ویب اور ایپ سرگرمی اور لنک کردہ FlyWeb سروسز میں FlyWeb شامل کریں</translation>
<translation id="7728046102681268859">‏FlyWeb پہلے سے آپ کے کمپیوٹر پر سبھی صارفین کیلئے انسٹال ہے۔</translation>
<translation id="2006421382007321898">‏اپنے تمام آلات پر اپنے بُک مارکس اور مزید حاصل کرنے کے لیے، FlyWeb میں سائن ان کریں۔ آپ کے سائن ان کرنے کے بعد یہ بُک مارک آپ کے FlyWeb اکاؤنٹ میں محفوظ ہو جائے گا۔</translation>
<translation id="4328426102261301637">‏‫FlyWeb کے V8 انجن کے ساتھ سائٹس کو تیز رفتار بناتا ہے لیکن FlyWeb کو حملوں کے خلاف قدرے کم مزاحم بناتا ہے۔ یہ ترتیب آن ہے۔</translation>
<translation id="207175655966839154">{count,plural, =1{‏آپ کا کچھ FlyWeb ڈیٹا ابھی تک آپ کے FlyWeb اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے چند منٹ انتظار کرنے کی کوشش کریں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا (1 آئٹم) حذف ہو جائے گا۔}other{‏آپ کا کچھ FlyWeb ڈیٹا ابھی تک آپ کے FlyWeb اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے چند منٹ انتظار کرنے کی کوشش کریں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا ({count} آئٹمز) حذف ہو جائے گا۔}}</translation>
