<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="130631256467250065">Izinguquko zakho zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha idivayisi yakho.</translation>
<translation id="1555506416658437797">Hlela izindlela zokukhokha.</translation>
<translation id="8359495463485001719">Ukubika kokuphahlazeka akutholakali ku-FlyWeb.</translation>
<translation id="6338530717474923868">Ubuka ikhasi le-FlyWeb eliphephile</translation>
<translation id="5147169001159408844">I-FlyWeb izama ukulungisa amasethingi okugcwalisa izindlela zokukhokha.</translation>
<translation id="5702992568540613683">Ilogo ye-FlyWeb</translation>
<translation id="510342522494506803">I-FlyWeb izama ukuhlela izindlela zokukhokha.</translation>
<translation id="8375862260948854624">I-FlyWeb yenziwa ukuthi ibe khona yi-<ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> iphrojekthi yomthombo ovulekile kanye nenye <ph name="BEGIN_LINK_OSS"/>isofthiwe yomthombo ovulekile<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Hamba kumenyu
          ye-FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Izilungiselelo ze-LAN
          uphinde uyekise ukukhetha ibhokisi lokuhlola le-"Sebenzisa iseva elibambayo nge-LAN yakho".</translation>
<translation id="5040124620086808431">Leli khasi livinjwe yi-FlyWeb</translation>
<translation id="1953000035868532675">Vumela i-FlyWeb ukufinyelela inethiwekhi kuzilungiselelo zakho zohlelo lokuvikela noma isilwi magciwane.</translation>
<translation id="3442058224540562441">Hamba
          kumenyu ye-FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          uphinde uqiniseke ukuthi ukulungiselelwa kwakho kusethelwe ku-"akukho ummeleli" noma "kuqondile."</translation>
<translation id="585620188971323280">lungisa amasethingi okugcwalisa izindlela zokukhokha.</translation>
<translation id="2681118099728446983">I-FlyWeb iphinda yenziwe enye <ph name="BEGIN_LINK_OSS"/>isofthiwe yomthombo ovulekile<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-FlyWeb.</translation>
<translation id="1017070759373671177">I-FlyWeb yenziwe yenzeke iphrojekthi yomthombo ovulekile we-<ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Hamba
        kumenyu ye-FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        uphinde uyekise ukukhetha i-"<ph name="NO_PREFETCH_DESCRIPTION"/>."
        Uma ngabe lokhu kungaxazululi inkinga, sincoma ukuphinda ukhethe le nketho  ukuze uthole ukusebenza okuthuthukisiwe.</translation>
<translation id="8187289872471304532">Hamba ku-
          Izinhlelo zokusebenza &gt; Okuncamelayo kwesistimu &gt; Inethiwekhi &gt; Okuthuthukisiwe &gt; Ommeleli
          uphinde uyekele ukukhetha noma yibaphi abammeleli abakhethiwe.</translation>
<translation id="4699594416850504200">Ubuka ikhasi elivikelekile le-FlyWeb Yokuhlola</translation>
<translation id="6224789938625024797">I-FlyWeb ayizange ivaleke ngokulungile.</translation>
</translationbundle>