<translation id="8144357648892716751">მოირგეთ FlyWeb</translation>
<translation id="7047386856539490735">გამოგადგათ ეს შედეგები?</translation>
<translation id="3945284827084409390">განაახლეთ FlyWeb</translation>
<translation id="7886270027101123253">თუ სურათს არ ექნება სასარგებლო აღწერილობა, FlyWeb შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება FlyWeb-ში.</translation>
<translation id="8434939140421950539">მიიღეთ ხელოვნური ინტელექტის შესაძლებლობები, როცა FlyWeb აპს იყენებთ თქვენს <ph name="DEVICE_TYPE"/>-ზე</translation>
<translation id="2647329478963461727">თქვენი პაროლები, ჩანართები და სხვა მონაცემები მუდამ თქვენთანაა FlyWeb აპით თქვენს ტელეფონში</translation>
<translation id="5695394421048248926">FlyWeb for Testing-ის მორგება</translation>
<translation id="6802544479988856975">შეგიძლიათ გამოიყენოთ FlyWeb, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ.</translation>
<translation id="8694083743003679818">ამოშალეთ <ph name="EXTENSION_NAME"/> FlyWeb-იდან</translation>
<translation id="6017914745388312119">თქვენი ორგანიზაცია შლის FlyWeb-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="3283953248242339756">FlyWeb საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="4729674580260824908">FlyWeb-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="805403942934515799">იკითხეთ ნებისმიერი რამ პირდაპირ იქ, სადაც ხართ, Gemini-ს მეშვეობით FlyWeb-ში</translation>
<translation id="7093403858436459499">დატოვეთ FlyWeb თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="935820624106805690">გამოიყენეთ FlyWeb შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="7216228761061470870">როცა სურათების ძიებას იყენებთ დესკტოპზე, გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, იგზავნება სერვერზე</translation>
<translation id="1678436729108859736">დავალებათა მენეჯერი - FlyWeb</translation>
<translation id="7587087358591725059">დასვით შეკითხვა FlyWeb-ის მიღმა არსებული კონტენტის, მაგალითად, სხვა აპების ან ფაილების შესახებ</translation>
<translation id="7013534648688018698"><ph name="EXISTING_USER"/> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით FlyWeb-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS"/>. თქვენს ყველა მოწყობილობაში მიიღებთ შენახულ ინფორმაციასა და სხვა მონაცემებს.</translation>
<translation id="4889865510625659193">მომენტალურად დაიწყეთ დათვალიერება: FlyWeb-ის გაშვება ახლა Windows-ის ჩართვისთანავე არის შესაძლებელი.</translation>
<translation id="7274695763216404502">ჩამაგრებულია! ისევ გამოიყენეთ სურათების ძიება ხელსაწყოთა ზოლიდან</translation>
<translation id="7288567540154601580">ჩანართები და გაფართოებები</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{FlyWeb გირჩევთ, ამოშალოთ ის}other{FlyWeb გირჩევთ, ამოშალოთ ისინი}}</translation>
<translation id="5321339461210685340">სისტემის აუდიოს გასაზიარებლად გახსენით სისტემის პარამეტრები და დაუშვით „მხოლოდ სისტემის აუდიოს ჩაწერა“ FlyWeb-ისთვის. დაგჭირდებათ FlyWeb-ის გადატვირთვა.</translation>
<translation id="7299899569525778554">დესკტოპიდან ძიება</translation>
<translation id="2866611433272355726">მიმდინარეობს FlyWeb-ის განახლება</translation>
<translation id="5013690772358862887">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

FlyWeb ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="7324051657739063017">შეგიძლიათ ხელახლა გახსნათ „კონტექსტური ამოცანები“, რათა დასვათ კითხვები ინტერნეტში ძიების პარალელურად</translation>
<translation id="1123144153876435088">თქვენი ვები, სანიშნეები და FlyWeb-ის სხვა მასალა არის აქ.</translation>
<translation id="8915041713909379783">თქვენი დაშიფრული მონაცემების წაკითხვა შეუძლია მხოლოდ მას, ვინც თქვენი საიდუმლო ფრაზა იცის. საიდუმლო ფრაზა არ იგზავნება FlyWeb-ში და არ ინახება მის მიერ. თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK"/>თქვენს ანგარიშში FlyWeb მონაცემების<ph name="END_LINK"/> წაშლა მოგიწევთ.</translation>
<translation id="6760192061736180746">თქვენი სისტემის ადმინისტრატორმა მოახდინა FlyWeb-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME"/>-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME"/>-ის გახსნა.</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="7601756527349047847">მომავალში FlyWeb-ის განახლებების მისაღებად დაგჭირდებათ macOS 13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 12-ს.</translation>
<translation id="3916387280110223245">ბოლო დროს არ ყოფილხართ. FlyWeb-მა ამოშალა <ph name="PERMISSION_1"/> და <ph name="PERMISSION_2"/>.</translation>
<translation id="3313237823190188892">Gemini-ს ჩვენება FlyWeb-ის სისტემურ არეში</translation>
<translation id="7401687852903179959">ამ ვიდეოში ძიება სურათების ძიებით</translation>
<translation id="6624551989332401777">FlyWeb ახლა თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="277733508197886564">გააგრძელეთ იქიდან, სადაც გაჩერდით: FlyWeb აღადგენს თქვენს ჩანართებს ყოველი გადატვირთვის შემდეგ. ამის გამოსართავად გადადით</translation>
<translation id="948152006162936800">FlyWeb-ში პაროლების იმპორტი</translation>
<translation id="4755314372270379254">1. დააწკაპუნეთ <ph name="BUTTON_LABEL"/>-ზე ქვემოთ
2. დააწკაპუნეთ <ph name="BUTTON_2"/>ზე Windows-ის პარამეტრებში
3. დააწკაპუნეთ <ph name="BUTTON_3"/>-ზე Windows-ის შეტყობინებაში, რომ ჩაამაგროთ FlyWeb ამოცანათა ზოლში სწრაფი წვდომისთვის</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> — FlyWeb Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7472280958921965834">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK"/>სისტემის პარამეტრები<ph name="END_LINK"/> და მიანიჭეთ FlyWeb-ს წვდომა</translation>
<translation id="2431618580332826398">FlyWeb-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="2154651873647244914">გსურთ FlyWeb-ის ხელახლა გაშვება?</translation>
<translation id="3137757192868162370">შეუძლებელია იმავე FlyWeb-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ FlyWeb და ხელახლა სცადეთ.</translation>
<translation id="3065486555702061722">შეხსენება: FlyWeb-ის საუკეთესო შესაძლებლობები თქვენს ხელთ</translation>
<translation id="4027434552262956425">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. FlyWeb-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი FlyWeb ანგარიში, თუ მასში შესული ხართ FlyWeb-იდან.</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb ხელახლა გაეშვება 1 წუთში}other{FlyWeb ხელახლა გაეშვება # წუთში}}</translation>
<translation id="301074550630080641">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება FlyWeb-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="3930051800510118744">გაუშვით FlyWeb ავტომატურად, რომ მომენტალურად დაიწყოთ დათვალიერება.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ინსტალატორი</translation>
<translation id="3067364763515000789">FlyWeb იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="1381291360713116383">FlyWeb გაუმჯობესდა</translation>
<translation id="3892366519980032442">ახლა თქვენთვის ხელმისაწვდომია მეტი ფუნქცია FlyWeb-ში</translation>
<translation id="7624307931717240213">ინფორმაციას ვიყენებთ ამ სერვისის გასაუმჯობესებლად. იხილეთ კონფიდენციალურობის დებულება და მომსახურების პირობები.</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="7733015548570443346">FlyWeb აპის ჩამოტვირთვა</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="2230101319599356673">FlyWeb არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="3243257760331619874">მოახდინეთ FlyWeb-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="3836891631266228927">FlyWeb-ის განახლება</translation>
<translation id="7362833186911891234">თქვენი ნამუშევარი დაცულია FlyWeb-ში</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME"/>-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="1549877678317463759">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით FlyWeb-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="104221467268393661">ნაგულისხმევ FlyWeb-ზე გადაყენება</translation>
<translation id="2414061498125565915">FlyWeb-ში თქვენი ნამუშევრის დაცვის უზრუნველსაყოფად თქვენი ორგანიზაცია შეძლებს გარკვეული ინფორმაციის ნახვას ან მართვას, როდესაც FlyWeb-ში ხართ შესული.</translation>
<translation id="494195283222791090">დააყენეთ FlyWeb ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="134973275687829726">ააჩქარეთ FlyWeb-ის მუშაობა</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> — FlyWeb Canary</translation>
<translation id="2415098152024287665">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. FlyWeb იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="6059158364953614237">აირჩიეთ, რა გაუზიაროთ FlyWeb-ს</translation>
<translation id="8463540467315366872">FlyWeb პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="3682929584258119691">თქვენი საძიებო სისტემა შეიცვალა FlyWeb-ს მიღმა. თქვენი დაცვის მიზნით, FlyWeb-მა დააბრუნა ის თავდაპირველ ნაგულისხმევ პარამეტრებზე. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">მოირგეთ FlyWeb, რათა მას ახალი იერი შესძინოთ</translation>
<translation id="8611872055947278722">FlyWeb ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS"/> წამი</translation>
<translation id="3999247564452560622">თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK"/>წაშალეთ თქვენს ანგარიშში FlyWeb მონაცემები<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">სწრაფად გახსენით Gemini FlyWeb-ში, როდესაც ის დაგჭირდებათ</translation>
<translation id="6798431672720500005">FlyWeb-ის დაყენება ნაგულისხმევად</translation>
<translation id="332151924263389003">FlyWeb ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="3096730275883527801">თქვენ შესული ხართ FlyWeb-ში როგორც <ph name="USER_EMAIL_ADDRESS"/>. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="7097534420680357688"><ph name="EXISTING_USER"/> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით FlyWeb-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS"/>. თქვენს ყველა მოწყობილობაში მიიღებთ სანიშნეებსა და სხვა მონაცემებს.</translation>
<translation id="9017338699075596174">ეს FlyWeb-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="2888168499066553233">მაქსიმალურად გამოიყენეთ FlyWeb თქვენს <ph name="DEVICE_TYPE"/>-ზე FlyWeb აპის მეშვეობით</translation>
<translation id="8004582292198964060">ბრაუზერი</translation>
<translation id="8010081455002666927">ავტომატური ამოცნობა</translation>
<translation id="5944585442866020176">FlyWeb-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="4462215250900528778">ჩაამაგრეთ FlyWeb ამოცანათა ზოლში, რომ ნებისმიერ დროს გამოიყენოთ ის</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8054112667659782652">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="8069447462453318634">აირჩიეთ „ხელსაწყოთა ზოლში ჩამაგრება“</translation>
<translation id="3685797926747054412">FlyWeb-ის აპების ფონურ რეჟიმში მუშაობის გათიშვა</translation>
<translation id="80790299200510644">სურათების ძიება</translation>
<translation id="8086881907087796310">ინსტალაცია ვერ მოხერხდა, რადგან თქვენი კომპიუტერი არ აკმაყოფილებს მინიმალურ მოთხოვნებს აპარატურის კუთხით.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> — FlyWeb for Testing</translation>
<translation id="3263664073045388929">FlyWeb საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="5289593085778678155">შემდეგ ჯერზე, როცა გახსნით FlyWeb-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას ფასისთვის თვალყურის დევნების გაფრთხილებების ჩართვის შესახებ.</translation>
<translation id="7635444121786764725">მიიღეთ გაფრთხილებები ფასის დაწევის შესახებ იმ ერთეულებზე, რომლებიც გაინტერესებთ, FlyWeb აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="8118331347066725040">გამოხმაურება Lens-ით ძიების შესახებ</translation>
<translation id="5770057404954060005">მოირგეთ FlyWeb</translation>
