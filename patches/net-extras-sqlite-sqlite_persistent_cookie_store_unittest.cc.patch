+constexpr std::string_view kTemporarilyUnavailablePrefix = "tmp-no-key";
+
+bool CookieCryptor::DecryptStringWithTemporaryFailure(
+    const std::string& ciphertext,
+    std::string* plaintext,
+    bool* temporarily_unavailable) {
+  *temporarily_unavailable = false;
+  if (ciphertext.starts_with(kTemporarilyUnavailablePrefix)) {
+    *temporarily_unavailable = true;
+    return false;
+  }
+  return DecryptString(ciphertext, plaintext);
+}
