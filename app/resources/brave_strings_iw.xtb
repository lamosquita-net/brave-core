<translation id="6998204082704836463">{COUNT, plural,
              =0 {הגנה מתקדמת דורשת שתפעיל מחדש את FlyWeb כדי להחיל עדכון}
              =1 {הגנה מתקדמת דורשת שתפעיל מחדש את FlyWeb כדי להחיל עדכון. חלון הפרטיות שלך לא ייפתח מחדש.}
              other {הגנה מתקדמת דורשת שתפעיל מחדש את FlyWeb כדי להחיל עדכון. חלונות הפרטיות שלך לא ייפתחו מחדש.}}</translation>
<translation id="5749154344207139683">רוצה לעזור לנו לשפר את מצב פרטי על ידי מענה על סקר של דקה 1?</translation>
<translation id="4766381896251401675">כשאתה מקליד בשורת הכתובת או בתיבת החיפוש, FlyWeb שולח את מה שאתה מקליד למנוע החיפוש המוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. זה לא פעיל בפרטי.</translation>
<translation id="2832552148674305108">פרטי אמיץ</translation>
<translation id="611606920944085547">בעת גלישה במצב פרטי, FlyWeb תזהיר אותך לפני טעינת אתר המשתמש בחיבור לא מאובטח</translation>
</translationbundle>