<translation id="499541338626558192">‏تمت إضافة <ph name="EXTENSION_NAME"/> إلى FlyWeb</translation>
<translation id="5880307616068888895">‏تخصيص FlyWeb والتحكُّم فيه. هناك تحديث متوفر.</translation>
