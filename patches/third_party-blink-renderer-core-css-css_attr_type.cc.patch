+  if (stream.Peek().FunctionId() == CSSValueID::kType) {
+    CSSParserTokenStream::RestoringBlockGuard guard(stream);
+    stream.ConsumeWhitespace();
+    std::optional<CSSSyntaxDefinition> syntax =
+        CSSSyntaxDefinition::Consume(stream);
