<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="130631256467250065">Өзгөртүүлөрүңүз түзмөгүңүз өчүп күйгөндөн кийин күчүнө кирет.</translation>
<translation id="125853961893919199">FlyWeb кеңеши: Сырсөздөрдү сактаңыз</translation>
<translation id="1589233279653618219">Төмөнкүгө өтүңүз:
          FlyWeb менюсу &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>.
          Конфигурация "прокси жок" же "түздөн-түз" деп коюлганын текшериңиз.</translation>
<translation id="8359495463485001719">FlyWeb'да каталар жөнүндө кабар берүү мүмкүн эмес.</translation>
<translation id="6338530717474923868">Коопсуз FlyWeb баракчасын карап жатасыз</translation>
<translation id="5147169001159408844">FlyWeb төлөм ыкмаларын толтуруу параметрлерин өзгөртүүгө аракет кылууда.</translation>
<translation id="5702992568540613683">FlyWeb логотиби</translation>
<translation id="8966580353365544289">FlyWeb кеңеши: Өркүндөтүлгөн коопсуз серептөө</translation>
<translation id="510342522494506803">FlyWeb төлөм ыкмаларын түзөтүүгө аракет кылууда.</translation>
<translation id="8375862260948854624">FlyWeb <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ачык булак долбоору жана башка <ph name="BEGIN_LINK_OSS"/>ачык программа<ph name="END_LINK_OSS"/> аркылуу мүмкүн болду.</translation>
<translation id="5040124620086808431">Бул баракты FlyWeb бөгөттөп койду</translation>
<translation id="1953000035868532675">FlyWeb'га коргоо системасында тармакка же антивирус параметрлерине кирүүгө уруксат
          бериңиз.</translation>
<translation id="4949828774841497663">Төмөнкүгө өтүңүз Колдонмолор &gt; Тутумдун параметрлери &gt; Тармак, 
          жигердүү тармакты тандап, Чоо-жайы... баскычын чыкылдатып, колдонулган проксилерди
          тандоодон чыгарыңыз.</translation>
<translation id="7584668345330431749">Төмөнкүгө өтүңүз:
          FlyWeb менюсу &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Тармак жана Интернет &gt; Прокси.
          "Параметрлерди автоматтык түрдө аныктоо" дегенди тандоодон чыгарыңыз.</translation>
<translation id="3145451630329266064">Бул беттер FlyWeb иштеп чыгуучуларына арналган жана жигердүү түрдө иштетилип же сыналбашы мүмкүн. Аларды иштетүү үчүн <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/> бөлүмүнө өтүп, мүчүлүштүктөрдү оңдоо беттерин иштетүү үчүн баскычты басып, бул бетке кайтып келиңиз.</translation>
<translation id="2681118099728446983">FlyWeb башка <ph name="BEGIN_LINK_OSS"/>ачык ресурс программасы<ph name="END_LINK_OSS"/> аркылуу да жеткиликтүү.</translation>
<translation id="6888846095017247017">Өзгөртүүлөрүңүз FlyWeb кийинки жолу кайра ишке киргизилгенде күчүнө кирет.</translation>
<translation id="8524328905288851065">Жупташтырууну улантуу үчүн FlyWeb Bluetooth'ду 
 пайдаланууга уруксат алышы керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ачык ресурс долбоору аркылуу түзүлдү.</translation>
<translation id="7777112741998051633">FlyWeb меню &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        өтүп, "<ph name="NO_PREFETCH_DESCRIPTION"/>" дегенди тандоодон чыгарыңыз.
        Эгер ушуну менен маселе чечилбесе, иштин майнаптуулугун жогорулатуу үчүн бул параметрди  
        кайра тандаңыз.</translation>
<translation id="4699594416850504200">Коопсуз FlyWeb for Testing баракчасын карап жатасыз</translation>
<translation id="6224789938625024797">FlyWeb туура эмес жабылып калды.</translation>
<translation id="3593104813552438879">FlyWeb кеңеши: Lens менен издеңиз</translation>
</translationbundle>