<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="7099479769133613710">เปิดอีกครั้งเพื่ออัปเดต &amp;Chrome OS</translation>
<translation id="291426170030461697">FlyWeb ขอแนะนำให้คุณตรวจสอบส่วนขยายนี้</translation>
<translation id="1549005488226693697">เมื่อเว็บไซต์ขอโหลดลิงก์ในหน้าเว็บของตนล่วงหน้าแบบส่วนตัว FlyWeb จะใช้เซิร์ฟเวอร์ของ FlyWeb การดำเนินการนี้จะซ่อนตัวตนของคุณจากเว็บไซต์ที่โหลดล่วงหน้า แต่ FlyWeb จะทราบถึงเว็บไซต์ที่ได้รับการโหลดล่วงหน้า</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="8908267645832965492">ผู้ปกครองได้ปิด "สิทธิ์สำหรับเว็บไซต์ แอป และส่วนขยาย" ใน FlyWeb</translation>
<translation id="5557633153169217776">FlyWeb ต้องการสิทธิ์เข้าถึงเครือข่ายภายในเพื่อค้นหาและใช้อุปกรณ์ที่อยู่ใกล้เคียง</translation>
<translation id="6441390163669415879">หากต้องการค้นหาฟีเจอร์หรือส่วนขยาย FlyWeb ที่เฉพาะเจาะจง ให้พิมพ์ทางลัดของฟีเจอร์หรือส่วนขยายนั้นในแถบที่อยู่ แล้วตามด้วยปุ่มบนแป้นพิมพ์ที่เลือกไว้</translation>
<translation id="9001750423919983557">แสดงการค้นหาด้วย FlyWeb ในถาดระบบและเปิดแป้นพิมพ์ลัด</translation>
<translation id="1368460307421081773">FlyWeb ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="112640046208448578">ระบุสิ่งหรือสถานที่ต่างๆ แล้วคัดลอกหรือแปลข้อความ เมื่อใช้การค้นหารูปภาพ ระบบจะส่งภาพหน้าจอของหน้าเว็บไปยังเซิร์ฟเวอร์ <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="4556715463645168547"><ph name="BEGIN_LINK"/>ลงชื่อเข้าใช้ FlyWeb<ph name="END_LINK"/> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="2076135703183650206">คลิกเมนู FlyWeb</translation>
<translation id="1157985233335035034">ภาษาล่าสุด</translation>
<translation id="1184145431117212167">ติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับ Windows เวอร์ชันที่คุณใช้</translation>
<translation id="4380351562011537903">เกี่ยวกับ FlyWeb</translation>
<translation id="853148447909557566">รับการแจ้งเตือนการติดตามราคาด้วย FlyWeb ในโทรศัพท์</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME"/></translation>
<translation id="1232234696885483911">เมื่อคุณเปิดการค้นหารูปภาพ ระบบจะส่งชื่อหน้า, URL และเนื้อหา รวมถึง PDF ไปยังเซิร์ฟเวอร์โดยอัตโนมัติ <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี FlyWeb ใน FlyWeb ได้ หากต้องการเปลี่ยน ให้ไปที่ "บัญชีของคุณใน FlyWeb"</translation>
<translation id="7614508617663739435">แสดง Gemini ใน FlyWeb ในแถบเมนูของ Mac</translation>
<translation id="832555967476614730">ใช้แป้นพิมพ์ลัดเพื่อเลือกส่วนหนึ่งของหน้าจอใน Gemini ใน FlyWeb</translation>
<translation id="4750836834956739196">ขณะที่แท็บนี้ไม่มีการใช้งาน ระบบจะเพิ่มพื้นที่ว่างในหน่วยความจำเพื่อให้ใช้ FlyWeb ได้อย่างรวดเร็วอยู่เสมอ ทั้งนี้คุณจะเลือกยกเว้นให้เว็บไซต์นี้ทำงานตลอดเวลาได้</translation>
<translation id="3190759351483708314">FlyWeb บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์เป็นอันตราย</translation>
<translation id="5879469261638423015">เมื่อลงชื่อเข้าใช้บริการของ FlyWeb อย่าง Gmail หรือ YouTube ด้วย <ph name="USER_EMAIL"/> คุณจะลงชื่อเข้าใช้ FlyWeb ด้วยบัญชีเดียวกันได้โดยอัตโนมัติ</translation>
<translation id="7142135954326264349">ดาวน์โหลด FlyWeb ในโทรศัพท์</translation>
<translation id="1290883685122687410">ข้อผิดพลาดในการตั้งค่า: <ph name="METAINSTALLER_EXIT_CODE"/> <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">ตั้งค่าโปรไฟล์ FlyWeb ใหม่</translation>
<translation id="5252737639504553444">ลองใช้ Gemini ใน FlyWeb</translation>
<translation id="609743863669742325">FlyWeb ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อสำรวจอุปกรณ์บลูทูธ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">ลงชื่อเข้าใช้ FlyWeb ในโทรศัพท์</translation>
<translation id="1330562121671411446">ตรวจหาภาษา</translation>
<translation id="2276527911011636666">ลบข้อมูลออกจาก FlyWeb (<ph name="URL"/>) ด้วย</translation>
<translation id="1345251407431278948">ปักหมุดแล้ว คุณเข้าถึงการค้นหารูปภาพได้อีกครั้งจากปุ่มใหม่ในแถบเครื่องมือ</translation>
<translation id="1383876407941801731">ค้นหา</translation>
<translation id="1045149878186896649">ใช้แอป FlyWeb เพื่อท่องเว็บได้ทุกที่ทุกเวลา</translation>
<translation id="141901961143729572">แชร์ความคิดเห็นของคุณ</translation>
<translation id="2758515779140515865">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ FlyWeb ใน "การตั้งค่าระบบ"</translation>
<translation id="4713192356155907986">รับความช่วยเหลือเกี่ยวกับ FlyWeb สำหรับการทดสอบ</translation>
<translation id="4984443629206419460">ลงชื่อเข้าใช้ FlyWeb เพื่อเข้าถึงข้อมูลที่บันทึกไว้และข้อมูลอื่นๆ จาก <ph name="DEVICE"/></translation>
<translation id="1497802159252041924">ข้อผิดพลาดในการติดตั้ง: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">หน้านี้ได้รับการป้องกัน</translation>
<translation id="8962360511570172">แชร์แท็บ FlyWeb</translation>
<translation id="2941487459666781243">ลงชื่อเข้าใช้ FlyWeb</translation>
<translation id="1547469039832541117">สิ้นสุดงานที่ไฮไลต์ไว้</translation>
<translation id="3182893868355533457">ปักหมุด FlyWeb</translation>
<translation id="852852907317361085">เครื่องมือด้านความปลอดภัยของ FlyWeb</translation>
<translation id="481155564361715417">FlyWeb ต้องการลบข้อมูลในเครื่องมือจัดการรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="2846999307505917298">ใช้ประโยชน์สูงสุดจาก FlyWeb ด้วยแอป FlyWeb ในโทรศัพท์</translation>
<translation id="3961251277542681013">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน FlyWeb</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="1665602916345474427">ลงชื่อเข้าใช้ด้วย <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, สมาชิก เปิดเมนูบัญชี</translation>
<translation id="7625232007557474355">คุณจะใช้ FlyWeb ได้ทุกครั้งที่คลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ จะมีการปักหมุดไว้ที่แถบงานด้วย</translation>
<translation id="1709772298389099340">ให้สิทธิ์ในระดับสูงขึ้นกับ <ph name="BROWSER_NAME"/></translation>
<translation id="5695205873161614119">FlyWeb จะลบข้อมูลการท่องเว็บเร็วๆ นี้</translation>
<translation id="8939535770474283898">FlyWeb จะพยายามอัปเกรดการนำทางให้เป็นแบบ HTTPS</translation>
<translation id="2581127533455294937">ล้างข้อมูล FlyWeb แล้ว</translation>
<translation id="7385422968404728039">FlyWeb จะรีสตาร์ทใน <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">เมื่อ HTTPS ไม่พร้อมใช้งาน FlyWeb จะใช้การเชื่อมต่อที่ไม่ปลอดภัยโดยไม่แจ้งเตือนคุณ</translation>
<translation id="307170399141486420">ให้ FlyWeb ทำงานในพื้นหลัง</translation>
<translation id="5006568136491721884">คลิก<ph name="BEGIN_BOLD"/>ใช่<ph name="END_BOLD"/>ในการแจ้งเตือนของ Windows เพื่อปักหมุด FlyWeb ไว้ที่แถบงานเพื่อให้เข้าถึงได้รวดเร็ว</translation>
<translation id="2473319786107120819">ติดตั้ง FlyWeb ใหม่</translation>
<translation id="2533324957407080119">FlyWeb กำลังพยายาม<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ FlyWeb ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS"/> นอกจากนี้ คุณยังรับส่วนขยายและข้อมูลอื่นๆ จาก <ph name="DEVICE"/> ได้ด้วย</translation>
<translation id="3547283483106013256">ครั้งถัดไปที่เปิด FlyWeb ใน <ph name="DEVICE_TYPE"/> คุณจะเห็นข้อความแจ้งให้ใช้เครื่องมือจัดการรหัสผ่านบน FlyWeb</translation>
<translation id="1838374766361614909">ล้างการค้นหา</translation>
<translation id="3403116471618205223">หากต้องการลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้เท่านั้น แต่ยังเก็บข้อมูลดังกล่าวไว้ในบัญชี FlyWeb ให้<ph name="BEGIN_LINK"/>ออกจากระบบ FlyWeb<ph name="END_LINK"/></translation>
<translation id="1909454687815628855">ดาวน์โหลด FlyWeb บนโทรศัพท์เพื่อเปิดหรือสร้างกลุ่มแท็บใหม่ได้ทุกที่ทุกเวลา</translation>
<translation id="3285741355512747610">คุณจัดการบัญชี FlyWeb ที่ลงชื่อเข้าใช้ได้ บัญชี FlyWeb ใช้สำหรับเบราว์เซอร์ FlyWeb, Play Store, Gmail และอื่นๆ หากต้องการเพิ่มบัญชีให้คนอื่น เช่น สมาชิกในครอบครัว ให้เพิ่มบุคคลใหม่ลงใน <ph name="DEVICE_TYPE"/> แทน <ph name="LINK_BEGIN"/>ดูข้อมูลเพิ่มเติม<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ค้นหาด้วยการค้นหารูปภาพ</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ FlyWeb ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS"/> นอกจากนี้ คุณยังรับบุ๊กมาร์กและข้อมูลอื่นๆ จาก <ph name="DEVICE"/> ได้ด้วย</translation>
<translation id="1880677175115548835">เลือกข้อความ</translation>
<translation id="4824940465467423308">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ FlyWeb ของคุณ ข้อมูล FlyWeb เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME"/> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี FlyWeb แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น คุณสามารถเลือกที่จะสร้างโปรไฟล์ใหม่เพื่อแยกเก็บข้อมูล FlyWeb ที่มีอยู่ของคุณ <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb จะช่วยสงวนพลังงานแบตเตอรี่โดยการจำกัดกิจกรรมในเบื้องหลังและเอฟเฟกต์ภาพ เช่น การเลื่อนอย่างราบรื่นและอัตราเฟรมวิดีโอ <ph name="BEGIN_LINK"/>ดูข้อมูลเพิ่มเติมเกี่ยวกับโหมดประหยัดพลังงาน<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">บริการ FlyWeb Updater</translation>
<translation id="7390382558747224642">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ FlyWeb อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb ไม่ตอบสนอง เปิดใหม่เลยหรือไม่</translation>
<translation id="5866699689358760578">องค์กร <ph name="MANAGER"/> กำหนดให้คุณต้องลงชื่อเข้าใช้ FlyWeb</translation>
<translation id="4035053306113201399">ต้องรีสตาร์ท Chrome OS เพื่อใช้การอัปเดต</translation>
<translation id="3750729306035486751">FlyWeb บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์ประเภทนี้ไม่ได้มีการดาวน์โหลดกันโดยทั่วไปและอาจเป็นอันตราย</translation>
<translation id="1953553007165777902">กำลังดาวน์โหลด... เหลืออีก <ph name="MINUTE"/> นาที</translation>
<translation id="6956650624767954726">FlyWeb ไม่สามารถกำหนดหรือตั้งค่าเบราว์เซอร์เริ่มต้น</translation>
<translation id="197326043290947695">เรียกดูอย่างชาญฉลาดยิ่งขึ้นด้วยการค้นหารูปภาพ</translation>
<translation id="130679046523922050">ดูสาเหตุที่ FlyWeb บล็อกบางไฟล์ เปิดในแท็บใหม่</translation>
<translation id="8243822903505210769">โปรดอัปเดตซอฟต์แวร์ FlyWeb ให้เป็นเวอร์ชันล่าสุดอยู่เสมอ หากปิดใช้หรือหยุดบริการนี้ ซอฟต์แวร์ FlyWeb ของคุณจะไม่ได้รับการอัปเดต ซึ่งหมายความว่าช่องโหว่ด้านความปลอดภัยที่อาจเกิดขึ้นจะไม่สามารถแก้ไขได้และฟีเจอร์อาจไม่ทำงาน บริการนี้จะถอนการติดตั้งตัวเองเมื่อไม่มีซอฟต์แวร์ FlyWeb ใช้งานอยู่</translation>
<translation id="6495079989036864983">การดำเนินการนี้จะลบ 1 รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ FlyWeb ด้วย <ph name="USER_EMAIL"/></translation>
<translation id="2018879682492276940">การติดตั้งไม่สำเร็จ โปรดลองอีกครั้ง</translation>
<translation id="2039417478970545937">การตั้งค่า</translation>
