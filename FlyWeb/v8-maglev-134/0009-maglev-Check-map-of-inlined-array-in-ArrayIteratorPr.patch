From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 09:23:10 +0000
Subject: [PATCH 09/20] [maglev] Check map of inlined array in
 ArrayIteratorPrototypeNext

Port of v8 811ebc89d5 (M148 b9013994f3; crbug 523884658), with its mjsunit test. 13.3 has no MapInference here: the check goes on the inlined-allocation path. FlyWeb Maglev debt for level 134.

(cherry picked from commit fa3698638f95db33a5fdf7005cad962e857011aa)
(cherry picked from commit 640fa35a8751307774176d80efe17dbf0ca58e25)
---
 src/maglev/maglev-graph-builder.cc       |  8 +++
 test/mjsunit/maglev/regress-523884658.js | 82 ++++++++++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100644 test/mjsunit/maglev/regress-523884658.js

diff --git a/src/maglev/maglev-graph-builder.cc b/src/maglev/maglev-graph-builder.cc
index f0ec3134..5b0b8c31 100644
--- a/src/maglev/maglev-graph-builder.cc
+++ b/src/maglev/maglev-graph-builder.cc
@@ -8501,6 +8501,14 @@ MaybeReduceResult MaglevGraphBuilder::TryReduceArrayIteratorPrototypeNext(
     FAIL("no elements protector");
   }
 
+  // FlyWeb: port of v8 811ebc89d5 (crbug 523884658). The map of an inlined
+  // array can still change behind our back (e.g. through
+  // `function.arguments`), so check it like upstream does when there is no
+  // map inference.
+  if (iterated_object->Is<InlinedAllocation>()) {
+    RETURN_IF_ABORT(BuildCheckMaps(iterated_object, base::VectorOf(maps)));
+  }
+
   // Load the [[NextIndex]] from the {iterator}.
   // We can assume index and length fit in Uint32.
   ValueNode* index =
diff --git a/test/mjsunit/maglev/regress-523884658.js b/test/mjsunit/maglev/regress-523884658.js
new file mode 100644
index 00000000..41d7cd2d
--- /dev/null
+++ b/test/mjsunit/maglev/regress-523884658.js
@@ -0,0 +1,82 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax --maglev
+
+let transition = false;
+let tagged_value;
+let double_value;
+
+function tagged_reflect() {
+  const a = eval('tagged_inner.arguments');
+  if (transition) {
+    a[1][0] = tagged_value;
+    a[1][1] = tagged_value;
+  } else {
+    a[1][0] = 3.3;
+    a[1][1] = 3.3;
+  }
+}
+
+function tagged_next(iterator) {
+  return iterator.next().value;
+}
+
+function tagged_inner(iterator, array) {
+  tagged_reflect();
+  return tagged_next(iterator);
+}
+
+function tagged_outer() {
+  const array = [1.1, 2.2];
+  const iterator = array.values();
+  return tagged_inner(iterator, array);
+}
+
+function double_reflect() {
+  const a = eval('double_inner.arguments');
+  if (transition) {
+    a[1][0] = double_value;
+    a[1][1] = double_value;
+  } else {
+    a[1][0] = 3;
+    a[1][1] = 3;
+  }
+}
+
+function double_next(iterator) {
+  return iterator.next().value;
+}
+
+function double_inner(iterator, array) {
+  double_reflect();
+  return double_next(iterator);
+}
+
+function double_outer() {
+  const array = [1, 2];
+  const iterator = array.values();
+  return double_inner(iterator, array);
+}
+
+const marker = {};
+tagged_value = marker;
+double_value = 1.5;
+
+for (const f of [tagged_reflect, tagged_next, tagged_inner, tagged_outer,
+                 double_reflect, double_next, double_inner, double_outer]) {
+  %PrepareFunctionForOptimization(f);
+}
+
+tagged_outer();
+tagged_outer();
+double_outer();
+double_outer();
+
+%OptimizeMaglevOnNextCall(tagged_outer);
+%OptimizeMaglevOnNextCall(double_outer);
+
+transition = true;
+assertSame(marker, tagged_outer());
+assertEquals(1.5, double_outer());
