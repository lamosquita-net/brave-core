+  auto as_float = [](const absl::optional<double>& value) {
+    return value ? absl::optional<float>(*value) : absl::optional<float>();
+  };
+  switch (space) {
+    case Color::ColorSpace::kSRGBLegacy:
+      // Out-of-gamut values are kept; infinities clamp. Relative colors
+      // from the legacy functions serialize as color(srgb ...).
+      for (absl::optional<double>& value : values) {
+        if (value && !std::isfinite(*value)) {
+          value = *value > 0 ? 255.0 : 0.0;
+        }
+        if (value) {
+          value = *value / 255.0;
+        }
+      }
+      result = Color::FromColorSpace(Color::ColorSpace::kSRGB,
+                                     as_float(values[0]), as_float(values[1]),
+                                     as_float(values[2]), as_float(alpha));
