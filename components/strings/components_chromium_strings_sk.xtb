<translation id="130631256467250065">Zmeny sa prejavia po ďalšom reštartovaní zariadenia.</translation>
<translation id="1555506416658437797">upravte spôsoby platby.</translation>
<translation id="8359495463485001719">Správy o zlyhaní nie sú v prehliadači FlyWeb k dispozícii.</translation>
<translation id="6338530717474923868">Prezeráte si zabezpečenú stránku prehliadača FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb sa pokúša upraviť nastavenia vypĺňania spôsobov platby.</translation>
<translation id="5702992568540613683">Logo prehliadača FlyWeb</translation>
<translation id="510342522494506803">FlyWeb sa pokúša upraviť spôsoby platby.</translation>
<translation id="8375862260948854624">Prehliadač FlyWeb mohol vzniknúť vďaka projektu s otvoreným zdrojom <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> a ďalšiemu <ph name="BEGIN_LINK_OSS"/>softvéru s otvoreným zdrojom<ph name="END_LINK_OSS"/> .</translation>
<translation id="4281953335231207224">Prejdite na
          ponuku FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          nastavenia siete LAN
          a zrušte začiarknutie políčka „Používať server proxy pre sieť LAN".</translation>
<translation id="5040124620086808431">Táto stránka bola zablokovaná prehliadačom FlyWeb</translation>
<translation id="1953000035868532675">Prehliadaču FlyWeb povoľte prístup k sieti v nastaveniach brány firewall alebo antivírusového softvéru.</translation>
<translation id="3442058224540562441">Prejdite na
          ponuku FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          a uistite sa, že je vaša konfigurácia nastavená na hodnotu „žiadny server proxy" alebo „priame".</translation>
<translation id="585620188971323280">upraviť nastavenia vypĺňania spôsobov platby.</translation>
<translation id="2681118099728446983">Prehliadač FlyWeb je založený aj na inom <ph name="BEGIN_LINK_OSS"/>softvéri open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Zmeny sa prejavia pri nasledujúcom reštartovaní prehliadača FlyWeb.</translation>
<translation id="1017070759373671177">Prehliadač FlyWeb je založený na projekte open source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Prejdite do
        ponuky FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        a zrušte výber položky <ph name="NO_PREFETCH_DESCRIPTION"/>.
        Ak to problém nevyrieši, odporúčame túto možnosť vybrať,
        aby ste získali lepšiu výkonnosť.</translation>
<translation id="8187289872471304532">Prejdite na možnosť
          Aplikácie &gt; Systémové predvoľby &gt; Sieť &gt; Rozšírené nastavenia &gt; Servery proxy
          a zrušte výber všetkých vybratých serverov proxy.</translation>
<translation id="4699594416850504200">Prezeráte si zabezpečenú stránku FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb nebol správne vypnutý.</translation>
