<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="130631256467250065">તમારા ફેરફારો તમે આગલી વખતે તમારા ઉપકરણને ફરી પ્રારંભ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="1555506416658437797">ચુકવણી પદ્ધતિઓમાં ફેરફાર કરો.</translation>
<translation id="8359495463485001719">FlyWeb માં ક્રૅશ રિપોર્ટિંગ ઉપલબ્ધ નથી.</translation>
<translation id="6338530717474923868">તમે એક સુરક્ષિત FlyWeb પેજ જોઈ રહ્યાં છો</translation>
<translation id="5147169001159408844">ચુકવણી પદ્ધતિઓ ભરવા માટે, FlyWeb સેટિંગમાં ફેરફાર કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="5702992568540613683">FlyWeb લોગો</translation>
<translation id="510342522494506803">FlyWeb ચુકવણી પદ્ધતિઓમાં ફેરફાર કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="8375862260948854624">FlyWeb એ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ઓપન સ્રોત પ્રોજેક્ટ અને અન્ય <ph name="BEGIN_LINK_OSS"/>ઓપન સ્રોત સૉફ્ટવેર<ph name="END_LINK_OSS"/> દ્વારા શક્ય બનાવ્યું છે.</translation>
<translation id="4281953335231207224">FlyWeb મેનૂ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN સેટિંગ
          પર જાઓ અને "તમારા LAN માટે પ્રૉક્સી સર્વરનો ઉપયોગ કરો" ચેકબૉક્સથી પસંદ હટાવો.</translation>
<translation id="5040124620086808431">FlyWeb દ્વારા આ પેજને બ્લૉક કરવામાં આવ્યું છે</translation>
<translation id="1953000035868532675">Braveને તમારા ફાયરવૉલ અથવા ઍન્ટિવાયરસ સેટિંગમાં નેટવર્ક ઍક્સેસ કરવાની
        મંજૂરી આપો.</translation>
<translation id="3442058224540562441">FlyWeb મેનૂ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          પર જાઓ અને ખાતરી કરો કે ગોઠવણી "પ્રૉક્સી નહીંં" અથવા "પ્રત્યક્ષ" પર સેટ કરેલી છે.</translation>
<translation id="585620188971323280">ચુકવણી પદ્ધતિઓ ભરવા માટે, સેટિંગમાં ફેરફાર કરો.</translation>
<translation id="2681118099728446983">અન્ય <ph name="BEGIN_LINK_OSS"/>ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_OSS"/> દ્વારા પણ Braveને શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="6888846095017247017">તમારા ફેરફારો તમે આગલી વખતે FlyWeb ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="1017070759373671177"><ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ઓપન સૉર્સ પ્રોજેક્ટ દ્વારા પણ Braveને શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="7777112741998051633">FlyWeb મેનૂ &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        પર જાઓ અને "<ph name="NO_PREFETCH_DESCRIPTION"/>" પસંદગીને હટાવો.
        જો આનાથી સમસ્યા ઉકેલાતી નથી, તો અમે સુધારેલ પ્રદર્શન માટે ફરીથી આ વિકલ્પને પસંદ કરવાની 
        ભલામણ કરીએ છીએ.</translation>
<translation id="8187289872471304532">ઍપ્લિકેશનો &gt; સિસ્ટમ પસંદગીઓ &gt; નેટવર્ક &gt; વિગતવાર &gt; પ્રોક્સીઝ
          પર જાઓ અને પસંદ કરવામાં આવેલી કોઈપણ પ્રોક્સીની પસંદગી હટાવો.</translation>
<translation id="4699594416850504200">તમે સુરક્ષિત FlyWeb for Testing પેજ જોઈ રહ્યાં છો</translation>
<translation id="6224789938625024797">FlyWeb યોગ્ય રીતે શટ ડાઉન થયું નહોતું.</translation>
</translationbundle>