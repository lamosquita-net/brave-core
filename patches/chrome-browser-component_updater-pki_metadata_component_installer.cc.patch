+network::mojom::CTLogInfo::LogType ProtoLogTypeToLogType(
+    ::chrome_browser_certificate_transparency::CTLog_LogType log_type) {
+  switch (log_type) {
+    case ::chrome_browser_certificate_transparency::CTLog::LOG_TYPE_UNSPECIFIED:
