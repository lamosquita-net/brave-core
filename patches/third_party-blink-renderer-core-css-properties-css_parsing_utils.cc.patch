+// FlyWeb (Chromium 125): relative color syntax, e.g. lab(from magenta l a b).
+// Ported from the ColorFunctionParser of 125 (1eb4d8edefe, c1e7ad701a5,
+// 578de66de39, 1dfcc4b11a1, 63acf5c50eb and the shipped behavior of
+// 67ed709ced7) for relative colors only: absolute colors keep the 116 parser.
+// Channel values use the units of 125 and are converted to the storage of the
+// 116 Color (hue in [0, 6] for hsl()/hwb(), oklab()/oklch() lightness in
+// [0, 100], legacy sRGB in [0, 1]).
+namespace {
+
+// The channel keywords of each color function, and the number that equals
+// 100% for each channel (NaN: percentages not allowed).
+struct RelativeColorChannels {
+  std::array<CSSValueID, 3> name;
+  std::array<double, 3> percentage;
+};
+
+RelativeColorChannels RelativeColorChannelsFor(Color::ColorSpace space) {
+  constexpr double kNoPercent = std::numeric_limits<double>::quiet_NaN();
+  switch (space) {
+    case Color::ColorSpace::kSRGBLegacy:
+      return {{CSSValueID::kR, CSSValueID::kG, CSSValueID::kB},
+              {255, 255, 255}};
+    case Color::ColorSpace::kXYZD50:
+    case Color::ColorSpace::kXYZD65:
+      return {{CSSValueID::kX, CSSValueID::kY, CSSValueID::kZ}, {1, 1, 1}};
+    case Color::ColorSpace::kLab:
+      return {{CSSValueID::kL, CSSValueID::kA, CSSValueID::kB},
+              {100, 125, 125}};
+    case Color::ColorSpace::kOklab:
+      return {{CSSValueID::kL, CSSValueID::kA, CSSValueID::kB},
+              {1, 0.4, 0.4}};
+    case Color::ColorSpace::kLch:
+      return {{CSSValueID::kL, CSSValueID::kC, CSSValueID::kH},
+              {100, 150, kNoPercent}};
+    case Color::ColorSpace::kOklch:
+      return {{CSSValueID::kL, CSSValueID::kC, CSSValueID::kH},
+              {1, 0.4, kNoPercent}};
+    case Color::ColorSpace::kHSL:
+      return {{CSSValueID::kH, CSSValueID::kS, CSSValueID::kL},
+              {kNoPercent, 100, 100}};
+    case Color::ColorSpace::kHWB:
+      return {{CSSValueID::kH, CSSValueID::kW, CSSValueID::kB},
+              {kNoPercent, 100, 100}};
+    default:  // color() with a predefined RGB space
+      return {{CSSValueID::kR, CSSValueID::kG, CSSValueID::kB}, {1, 1, 1}};
+  }
+}
+
+bool RelativeColorChannelIsHue(Color::ColorSpace space, int channel) {
+  if (space == Color::ColorSpace::kHSL || space == Color::ColorSpace::kHWB) {
+    return channel == 0;
+  }
+  if (space == Color::ColorSpace::kLch || space == Color::ColorSpace::kOklch) {
+    return channel == 2;
+  }
+  return false;
+}
+
+// If the CSSValue is an absolute color, return the corresponding Color.
+absl::optional<Color> TryResolveColorAtParseTime(const CSSValue& value) {
+  if (auto* color_value = DynamicTo<cssvalue::CSSColor>(value)) {
+    return color_value->Value();
+  }
+  if (auto* identifier_value = DynamicTo<CSSIdentifierValue>(value)) {
+    // <named-color> and 'transparent' can be resolved at parse time.
+    CSSValueID value_id = identifier_value->GetValueID();
+    if ((value_id >= CSSValueID::kAqua && value_id <= CSSValueID::kYellow) ||
+        (value_id >= CSSValueID::kAliceblue &&
+         value_id <= CSSValueID::kYellowgreen) ||
+        value_id == CSSValueID::kTransparent || value_id == CSSValueID::kGrey) {
+      return StyleColor::ColorFromKeyword(value_id,
+                                          mojom::blink::ColorScheme::kLight);
+    }
+    return absl::nullopt;
+  }
+  if (auto* color_mix_value = DynamicTo<cssvalue::CSSColorMixValue>(value)) {
+    absl::optional<Color> color1 =
+        TryResolveColorAtParseTime(color_mix_value->Color1());
+    absl::optional<Color> color2 =
+        TryResolveColorAtParseTime(color_mix_value->Color2());
+    if (color1 && color2) {
+      return StyleColor::UnresolvedColorMix(color_mix_value,
+                                            StyleColor(*color1),
+                                            StyleColor(*color2))
+          .Resolve(Color());
+    }
+  }
+  // currentcolor and color-mix() with non-absolute colors are not supported
+  // as origin colors, as in 125.
+  return absl::nullopt;
+}
+
+// A channel keyword (the "l" in "lab(from cyan l 0.5 0.5)") or a math function
+// using channel keywords ("calc(r / 2)").
+absl::optional<double> ConsumeRelativeColorChannel(
+    CSSParserTokenRange& range,
+    const CSSParserContext& context,
+    const HashMap<CSSValueID, double>& channel_values,
+    bool allow_angle,
+    double percentage_base) {
+  const CSSParserToken& token = range.Peek();
+  if (token.GetType() == kFunctionToken) {
+    // Don't consume the range if the parsing fails.
+    CSSParserTokenRange calc_range = range;
+    CSSMathFunctionValue* calc_value = CSSMathFunctionValue::Create(
+        CSSMathExpressionNode::ParseMathFunction(
+            token.FunctionId(), ConsumeFunction(calc_range), context,
+            /*is_percentage_allowed=*/true, kCSSAnchorQueryTypesNone,
+            channel_values),
+        CSSPrimitiveValue::ValueRange::kAll);
+    if (!calc_value) {
+      return absl::nullopt;
+    }
+    double value;
+    switch (calc_value->Category()) {
+      case kCalcNumber:
+        value = calc_value->GetDoubleValueWithoutClamping();
+        break;
+      case kCalcPercent:
+        if (allow_angle || std::isnan(percentage_base)) {
+          return absl::nullopt;
+        }
+        value = calc_value->GetDoubleValue() / 100 * percentage_base;
+        break;
+      case kCalcAngle:
+        if (!allow_angle) {
+          return absl::nullopt;
+        }
+        value = calc_value->ComputeDegrees();
+        break;
+      default:
+        return absl::nullopt;
+    }
+    range = calc_range;
+    return value;
+  }
+  if (channel_values.Contains(token.Id())) {
+    range.ConsumeIncludingWhitespace();
+    return channel_values.at(token.Id());
+  }
+  return absl::nullopt;
+}
+
+}  // namespace
+
+// The arguments of a relative color function after the origin color, e.g.
+// "r g b / alpha" or, for color(), "srgb r g b", evaluated against `origin`.
+static bool ParseRelativeColorChannels(CSSParserTokenRange& args,
+                                       CSSValueID function_id,
+                                       const CSSParserContext& context,
+                                       const Color& origin,
+                                       Color& result) {
+  Color::ColorSpace space;
+  switch (function_id) {
+    case CSSValueID::kRgb:
+    case CSSValueID::kRgba:
+      space = Color::ColorSpace::kSRGBLegacy;
+      break;
+    case CSSValueID::kHsl:
+    case CSSValueID::kHsla:
+      space = Color::ColorSpace::kHSL;
+      break;
+    case CSSValueID::kHwb:
+      space = Color::ColorSpace::kHWB;
+      break;
+    case CSSValueID::kLab:
+      space = Color::ColorSpace::kLab;
+      break;
+    case CSSValueID::kOklab:
+      space = Color::ColorSpace::kOklab;
+      break;
+    case CSSValueID::kLch:
+      space = Color::ColorSpace::kLch;
+      break;
+    case CSSValueID::kOklch:
+      space = Color::ColorSpace::kOklch;
+      break;
+    case CSSValueID::kColor:
+      switch (args.ConsumeIncludingWhitespace().Id()) {
+        case CSSValueID::kSRGB:
+          space = Color::ColorSpace::kSRGB;
+          break;
+        case CSSValueID::kRec2020:
+          space = Color::ColorSpace::kRec2020;
+          break;
+        case CSSValueID::kSRGBLinear:
+          space = Color::ColorSpace::kSRGBLinear;
+          break;
+        case CSSValueID::kDisplayP3:
+          space = Color::ColorSpace::kDisplayP3;
+          break;
+        case CSSValueID::kA98Rgb:
+          space = Color::ColorSpace::kA98RGB;
+          break;
+        case CSSValueID::kProphotoRgb:
+          space = Color::ColorSpace::kProPhotoRGB;
+          break;
+        case CSSValueID::kXyzD50:
+          space = Color::ColorSpace::kXYZD50;
+          break;
+        case CSSValueID::kXyz:
+        case CSSValueID::kXyzD65:
+          space = Color::ColorSpace::kXYZD65;
+          break;
+        default:
+          return false;
+      }
+      break;
+    default:
+      return false;
+  }
+  const RelativeColorChannels channels = RelativeColorChannelsFor(space);
+
+  // The origin color's channels, in the units of the color function.
+  Color origin_color = origin;
+  origin_color.ConvertToColorSpace(space);
+  std::array<double, 3> origin_channels = {
+      origin_color.Param0(), origin_color.Param1(), origin_color.Param2()};
+  switch (space) {
+    case Color::ColorSpace::kSRGBLegacy:
+      for (double& channel : origin_channels) {
+        channel *= 255;
+      }
+      break;
+    case Color::ColorSpace::kHSL:
+    case Color::ColorSpace::kHWB:
+      origin_channels[0] *= 60;
+      origin_channels[1] *= 100;
+      origin_channels[2] *= 100;
+      break;
+    case Color::ColorSpace::kOklab:
+    case Color::ColorSpace::kOklch:
+      origin_channels[0] /= 100;
+      break;
+    default:
+      break;
+  }
+  const HashMap<CSSValueID, double> channel_values = {
+      {channels.name[0], origin_channels[0]},
+      {channels.name[1], origin_channels[1]},
+      {channels.name[2], origin_channels[2]},
+      {CSSValueID::kAlpha, origin_color.Alpha()},
+  };
+
+  std::array<absl::optional<double>, 3> values;
+  for (int i = 0; i < 3; i++) {
+    absl::optional<double>& value = values[i];
+    if (ConsumeIdent<CSSValueID::kNone>(args)) {
+      // none
+    } else if (RelativeColorChannelIsHue(space, i)) {
+      if (CSSPrimitiveValue* angle =
+              ConsumeAngle(args, context, absl::nullopt)) {
+        value = angle->ComputeDegrees();
+      } else if (CSSPrimitiveValue* number = ConsumeNumber(
+                     args, context, CSSPrimitiveValue::ValueRange::kAll)) {
+        value = number->GetDoubleValueWithoutClamping();
+      } else {
+        value = ConsumeRelativeColorChannel(args, context, channel_values,
+                                            /*allow_angle=*/true,
+                                            channels.percentage[i]);
+      }
+      if (!value) {
+        return false;
+      }
+      // Non-finite hues become 0; hues wrap to [0, 360].
+      if (!std::isfinite(*value)) {
+        value = 0.0;
+      }
+      value = fmod(fmod(*value, 360.0) + 360.0, 360.0);
+    } else if (CSSPrimitiveValue* number = ConsumeNumber(
+                   args, context, CSSPrimitiveValue::ValueRange::kAll)) {
+      value = number->GetDoubleValueWithoutClamping();
+    } else if (CSSPrimitiveValue* percent = ConsumePercent(
+                   args, context, CSSPrimitiveValue::ValueRange::kAll)) {
+      if (std::isnan(channels.percentage[i])) {
+        return false;
+      }
+      value = percent->GetDoubleValue() / 100 * channels.percentage[i];
+    } else {
+      value = ConsumeRelativeColorChannel(args, context, channel_values,
+                                          /*allow_angle=*/false,
+                                          channels.percentage[i]);
+      if (!value) {
+        return false;
+      }
+    }
+    // Relative colors have no legacy (comma) syntax.
+    if (i < 2 && ConsumeCommaIncludingWhitespace(args)) {
+      return false;
+    }
+  }
+
+  // Alpha: the origin's unless given.
+  absl::optional<double> alpha = origin_color.Alpha();
+  if (ConsumeSlashIncludingWhitespace(args)) {
+    if (ConsumeIdent<CSSValueID::kNone>(args)) {
+      alpha.reset();
+    } else if (CSSPrimitiveValue* number = ConsumeNumber(
+                   args, context, CSSPrimitiveValue::ValueRange::kAll)) {
+      alpha = ClampTo<double>(number->GetDoubleValue(), 0.0, 1.0);
+    } else if (CSSPrimitiveValue* percent = ConsumePercent(
+                   args, context, CSSPrimitiveValue::ValueRange::kAll)) {
+      alpha = ClampTo<double>(percent->GetDoubleValue() / 100.0, 0.0, 1.0);
+    } else {
+      alpha = ConsumeRelativeColorChannel(args, context, channel_values,
+                                          /*allow_angle=*/false, 1.0);
+      if (!alpha) {
+        return false;
+      }
+    }
+  }
+  if (!args.AtEnd()) {
+    return false;
+  }
