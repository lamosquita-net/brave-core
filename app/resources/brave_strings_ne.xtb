<translation id="7978410129406361692">विद्यमान FlyWeb प्रोफाइल प्रयोग गर्ने हो?</translation>
<translation id="3412460710772753638">यो डिभाइसको पासवर्ड म्यानेजरमा</translation>
<translation id="847273641988291714">तपाईं FlyWeb का प्रोफाइल प्रयोग गरी FlyWeb मा भएका आफ्ना सबै कुराहरू छुट्याएर राख्न सक्नुहुन्छ। साथीभाइ तथा परिवारका सदस्यहरूका लागि अलग्गै प्रोफाइल बनाइदिनुहोस् वा काम तथा मनोरञ्जनसँग सम्बन्धित कुराहरू छुट्याएर राख्नुहोस्।</translation>
<translation id="1558345997029205345">तपाईंले अरूले देखेको पासवर्ड प्रयोग गरी साइन इन गर्दा FlyWeb ले तपाईंलाई त्यसबारे सूचित गर्ने छ</translation>
<translation id="956833467923764542">यसले यो डिभाइसका <ph name="ITEMS_COUNT"/> वस्तुहरू मेट्नेछ। पछि आफ्नो डेटा प्राप्त गर्न FlyWeb मा <ph name="USER_EMAIL"/> को रूपमा साइन इन गर्नुहोस्।</translation>
<translation id="4772642827282964272">तपाईं <ph name="SHORTCUT"/> थिचेर FlyWeb मा एक प्रोफाइलबाट अर्को प्रोफाइलमा जान सक्नुहुन्छ</translation>
<translation id="6724485219247982027">कृपया सबै FlyWeb सन्झ्यालहरू बन्द गर्नुहोस् र पुन: प्रयास गर्नुहोस्।</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/> ले पहिलेदेखि नै साइन इन गर्नुभएको छ।  छुट्टै ब्राउजर प्रयोग गर्न <ph name="USER_EMAIL_ADDRESS"/> मार्फत आफ्नै प्रोफाइल प्रयोग गरी FlyWeb मा साइन इन गर्नुहोस्।</translation>
<translation id="763231524941489073">तपाईंको गोपनीयताको सुरक्षार्थ हामी ४ हप्ताभन्दा पुराना तपाईंका रुचिहरू स्वतः मेटाउँछौँ। तपाईंले विभिन्न साइटहरू ब्राउज गरिराख्ने क्रममा कुनै रुचि यो सूचीमा फेरि देखिन सक्छ। अथवा तपाईं FlyWeb ले कुनै रुचिसँग सम्बन्धित सामग्री नदेखाओस् भन्ने चाहनुहुन्छ भने तपाईं उक्त रुचि हटाउन सक्नुहुन्छ।</translation>
<translation id="4856314253538330936">तपाईंको ब्राउजिङ इतिहास अर्थात् तपाईंले यो डिभाइसमा FlyWeb प्रयोग गरी खोलेका साइटहरूको रेकर्ड।</translation>
<translation id="3597003331831379823">खास विशेषाधिकारहरू प्रयोग गरी सेटअप रन गर्न सकिएन। <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="3293172835368652510">यस डिभाइसबाट यो व्यक्तिको ब्राउजिङ डेटा मेटाइने छ। उक्त डेटा पुनः प्राप्त गर्न <ph name="USER_EMAIL"/> का रूपमा FlyWeb मा साइन इन गर्नुहोस्।</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{FlyWeb को नयाँ अद्यावधिक उपलब्ध छ र तपाईंले FlyWeb पुनः सुरु गर्ने बित्तिकै यो अद्यावधिक लागू हुने छ।}=1{FlyWeb को नयाँ अद्यावधिक उपलब्ध छ र तपाईंले FlyWeb पुनः सुरु गर्ने बित्तिकै यो अद्यावधिक लागू हुने छ। तपाईंको इन्कोग्निटो विन्डो पुनः खुल्ने छैन।}other{FlyWeb को नयाँ अद्यावधिक उपलब्ध छ र तपाईंले FlyWeb पुनः सुरु गर्ने बित्तिकै यो अद्यावधिक लागू हुने छ। तपाईंका # वटा इन्कोग्निटो विन्डो पुनः खुल्ने छैनन्।}}</translation>
