<translation id="608006075545470555">افزودن نمایه کاری به این مرورگر</translation>
<translation id="5880307616068888895">‏سفارشی کردن و کنترل FlyWeb. به‌روزرسانی‌ در دسترس است.</translation>
<translation id="8890528681896757647">‏وقتی روشن باشد، FlyWeb با محدود کردن فعالیت پس‌زمینه و جلوه‌های بصری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند.</translation>
<translation id="1683225514126450592">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار FlyWeb</translation>
<translation id="5171527334826689262">‏FlyWeb این گذرواژه را در حساب FlyWeb شما ذخیره می‌کند. لازم نیست آن را به خاطر بسپارید.</translation>
<translation id="4809579265564854985">‏<ph name="FILE_NAME"/> خطرناک است، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="1773252983747911987">‏FlyWeb به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="3063780243670578104">‏«مرور ایمن» خاموش است. FlyWeb توصیه می‌کند آن را روشن کنید.</translation>
<translation id="1686760912855738719">‏می‌توانید در اینجا بین نمایه‌های FlyWeb جابه‌جا شوید</translation>
<translation id="4403968929742079769">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME"/> به سیستم FlyWeb وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="1855179706668101462">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از FlyWeb است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً FlyWeb را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="651290634887454330">{0,plural, =0{‏FlyWeb هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏FlyWeb ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏FlyWeb ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏FlyWeb ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="2586408713760853791">‏FlyWeb برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="1603558835003845196">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در FlyWeb ذخیره شده است مقایسه می‌کند</translation>
<translation id="5751080530525677552">‏FlyWeb  مرورگر پیش‌فرض شود</translation>
<translation id="4804111781678641302">‏FlyWeb نمی‌تواند به‌روزرسانی‌ها را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="3542157007113577464">‏از FlyWeb خارج می‌شوید؟</translation>
<translation id="6273793429163604305">سر جای خود…</translation>
<translation id="3794967601634523398">‏سفارشی کردن نمایه FlyWeb</translation>
<translation id="6475001900959697061">‏نام‌گذاری نمایه FlyWeb</translation>
<translation id="4465156155012748592">‏<ph name="FILE_NAME"/> ممکن است خطرناک باشد، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="5523868569707953059">‏FlyWeb درحال استفاده از دوربین شما است.</translation>
<translation id="5914697581312472089">‏FlyWeb این فایل را مسدود کرد زیرا خطرناک است</translation>
<translation id="6327105987658262776">به‌روزرسانی دردسترس نیست.</translation>
<translation id="8226838065217375546">‏عملیات دیگری در FlyWeb درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="6063700568539132984">‏اکنون استفاده از FlyWeb با حساب FlyWeb شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="6890209090736444656">‏آیا مطمئن هستید که می‌خواهید FlyWeb را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="8218289771633351023">‏<ph name="BEGIN_BOLD"/>نحوه استفاده ما از این داده‌ها:<ph name="END_BOLD"/> FlyWeb می‌تواند علایق شما را برآورد کند. بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از FlyWeb بخواهد علایق شما را ببیند.</translation>
<translation id="6636986997730784876">‏FlyWeb یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع، پایدار و دارای کاربرد آسان است. با محافظت در مقابل بدافزار و رمزگیری طراحی شده در داخل FlyWeb، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="2139300032719313227">‏بازراه‌اندازی ChromeOS</translation>
<translation id="173462352822069427">‏به نمایه‌های FlyWeb خوش‌آمدید</translation>
<translation id="1474676525193357364">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی FlyWeb نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="5777905264835557372">‏حذف نصب FlyWeb </translation>
<translation id="8852057261917278552">‏اگر <ph name="TIMEOUT_DURATION"/> از FlyWeb استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="8592211619057897362">‏هرکدام از نمایه‌ها دارای اطلاعات FlyWeb مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="7489092380688543560">‏برای دیدن گذرواژه‌های نمایه FlyWeb دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="8243012192239086369">‏برای رفع خطاهای املائی، FlyWeb نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای FlyWeb ارسال می‌کند</translation>
<translation id="3927263773110604886">‏رفتن به تنظیمات اعلان FlyWeb</translation>
<translation id="6888846095017247017">‏دفعه بعدی که FlyWeb را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="1886169834787876002">‏FlyWeb برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="7640394575797555654">‏سایت‌ها احتمالاً عملکردی مطابق انتظار شما خواهند داشت اما بعداز بسته شدن همه پنجره‌های FlyWeb، شما را به‌یاد نخواهند داشت</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="1363996462118479832">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromeOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="4152880912192471857">‏FlyWeb برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="2193001403607253406">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از FlyWeb است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از FlyWeb استفاده کنید.</translation>
<translation id="3260179770078760650">‏«بهینه‌سازی حافظه» سرعت FlyWeb را بیشتر کرده است</translation>
<translation id="7728046102681268859">‏FlyWeb از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="7030752319019635064">‏برای دسترسی به چیزهای FlyWeb در همه دستگاه‌هایتان، به سیستم وارد شوید، سپس همگام‌سازی را روشن کنید.</translation>
<translation id="1292831930742306370">‏FlyWeb توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="5612302437680103875">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای FlyWeb خاموش کرده است. فعال کردن این <ph name="EXTENSION_TYPE_PARAMETER"/> مجاز نیست.</translation>
<translation id="1547295885616600893">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی ممکن شده است.</translation>
<translation id="6432682256389755533">‏FlyWeb می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="178055475944027272">‏FlyWeb این فایل را مسدود کرد زیرا حاوی بدافزار است</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="5712993149989886097">‏Google Pay (در FlyWeb کپی شد)</translation>
<translation id="4695676871328690599">‏FlyWeb متوجه شده است که «<ph name="EXTENSION_NAME"/>» حاوی بدافزار است</translation>
<translation id="76559364095325834">‏FlyWeb به‌روز شده است اما حداقل ۳۰ روز از آن استفاده نکرده‌اید.</translation>
<translation id="8524328905288851065">‏FlyWeb باید برای ادامه مرتبط‌سازی به بلوتوث
دسترسی داشته باشد. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="5929819793040985066">‏وقتی نسخه آزمایشی روشن باشد، «سنجش آگهی» به سایت‌هایی که بازدید می‌کنید اجازه می‌دهد اطلاعاتی را از FlyWeb درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="8806901087257994310">‏بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از FlyWeb بخواهد علایق شما را ببیند. FlyWeb می‌تواند حداکثر ۳ علاقه را هم‌رسانی کند.</translation>
<translation id="2553796189989827248">‏گذرواژه‌های ضعیف را می‌توان به‌راحتی حدس زد. به FlyWeb اجازه دهید <ph name="BEGIN_LINK"/>گذرواژه‌هایی قوی برایتان ایجاد کند و آن‌ها را به‌خاطر بسپارد<ph name="END_LINK"/>.</translation>
<translation id="1749753408579541220">‏وقتی روشن باشد، FlyWeb حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌ها و سایر برنامه‌ها اختصاص داده می‌شود و سرعت FlyWeb حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند.</translation>
<translation id="3453763134178591239">‏شرایط ChromeOS</translation>
<translation id="8545123476334328275">‏FlyWeb برای این سایت به مجوز دسترسی به میکروفون نیاز دارد</translation>
<translation id="7025789849649390912">نصب متوقف شد.</translation>
<translation id="3945284827084409390">‏به‌روزرسانی FlyWeb</translation>
<translation id="7886270027101123253">‏اگر تصویری توضیح مفیدی نداشته باشد، FlyWeb توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به FlyWeb ارسال می‌شود.</translation>
<translation id="6017914745388312119">‏اگر <ph name="TIMEOUT_DURATION"/> از FlyWeb استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="3283953248242339756">‏FlyWeb برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="4729674580260824908">‏FlyWeb راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="9165925035484501889">‏FlyWeb نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید.</translation>
<translation id="1678436729108859736">‏مدیر وظایف - FlyWeb</translation>
<translation id="6135229048093148288">‏علایق شما به‌طوری‌که FlyWeb برآورد کرده است</translation>
<translation id="7641415053133771502">‏سنجش آگهی به سایت‌هایی که بازدید می‌کنید امکان می‌دهد اطلاعاتی را از FlyWeb درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="2866611433272355726">‏در حال به‌روزرسانی FlyWeb</translation>
<translation id="5013690772358862887">‏فایل اولویت‌های شما خراب یا نامعتبر است. 
FlyWeb قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="7339898014177206373">پنجرهٔ جدید</translation>
<translation id="1123144153876435088">‏وب، نشانک‌ها و موارد دیگر FlyWeb شما در اینجا هستند.</translation>
<translation id="6760192061736180746">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME"/> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، FlyWeb را پیکربندی کرده است.</translation>
<translation id="3225813655660631613">‏با نمایه‌های FlyWeb می‌توانید همه‌چیزتان را در FlyWeb جدا کنید. با این کار، راحت‌تر می‌توان کار و سرگرمی را ازهم جدا کرد.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="3787225360375979559">‏FlyWeb برای این سایت به مجوز دسترسی به دوربین نیاز دارد</translation>
<translation id="2431618580332826398">‏برای دریافت به‌روزرسانی‌های آتی FlyWeb، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="2154651873647244914">‏FlyWeb راه‌اندازی مجدد شود؟</translation>
<translation id="3137757192868162370">‏نمی‌توانید FlyWeb دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً FlyWeb را ببندید و دوباره سعی کنید.</translation>
<translation id="4731230085409037950">{0,plural, =1{‏FlyWeb ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏FlyWeb ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏FlyWeb ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="2706045239797506060">‏همچنین داده‌ها از FlyWeb پاک شود (<ph name="URL"/>)</translation>
<translation id="5426732664223965459">‏FlyWeb می‌توانید علایقتان را برآورد کند. بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از FlyWeb بخواهد علایق شما را ببیند.</translation>
<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">‏FlyWeb درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="1381291360713116383">‏FlyWeb اکنون بهتر شده است</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="481435825250648341">‏در تنظیمات FlyWeb می‌توانید اطلاعات بیشتری درباره این ویژگی‌ها کسب کنید.</translation>
<translation id="3079800650903360762">‏FlyWeb ویژگی‌های جدیدی را کاوش می‌کند که به سایت‌ها اجازه می‌دهد با مصرف داده کمتر، همان تجربه مرور را ارائه دهند</translation>
<translation id="2230101319599356673">‏FlyWeb مرورگر پیش‌فرض شما نیست</translation>
<translation id="3243257760331619874">‏FlyWeb را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="1549877678317463759">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="134973275687829726">‏سرعت FlyWeb را افزایش دهید</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8463540467315366872">‏درحال‌حاضر یک نمایه FlyWeb با این حساب در این دستگاه وجود دارد</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="8611872055947278722">‏FlyWeb به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS"/> ثانیه باقی مانده است</translation>
<translation id="3217139311889964618">‏<ph name="BEGIN_BOLD"/>چگونه می‌توانید داده‌هایتان را مدیریت کنید:<ph name="END_BOLD"/> برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشد به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. یا می‌توانید علایقی را که نمی‌خواهید FlyWeb مدنظر قرار دهد حذف کنید.</translation>
<translation id="3096730275883527801">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS"/> وارد سیستم FlyWeb شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="9017338699075596174">‏این نصب ثانویه FlyWeb است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="5944585442866020176">‏وقتی FlyWeb دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="80471789339884597">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید همه مرورگرها را بازراه‌اندازی کنید.</translation>
<translation id="3263664073045388929">‏FlyWeb برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="5334309298019785904">‏ChromeOS نتوانست داده‌هایتان را همگام‌سازی کند زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="813913629614996137">درحال مقداردهی اولیه…</translation>
<translation id="1597323875619800374">‏این فایل خطرناک است، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="8455485678130879158">‏FlyWeb این فایل را مسدود کرد زیرا این نوع فایل خطرناک است</translation>
<translation id="6756872644564483342">‏اگر تصویری توضیح مفیدی نداشته باشد، FlyWeb توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به FlyWeb ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="5792785787074426346">‏چون به سیستم وارد نشده‌اید، FlyWeb نمی‌تواند گذرواژه‌هایتان را بررسی کند</translation>
<translation id="6627585369674499881">‏این فایل ممکن است خطرناک باشد، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="208266011144024011">‏اگر <ph name="TIMEOUT_DURATION"/> از FlyWeb استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="3542611917357881417">‏با FlyWeb می‌توانید کارهای بیشتری انجام دهید</translation>
<translation id="5565286784156841599">‏برای همگام‌سازی و شخصی‌سازی FlyWeb در همه دستگاه‌هایتان، به سیستم وارد شوید</translation>
<translation id="9174706677133564856">‏<ph name="USER_EMAIL_ADDRESS"/> قبلاً از FlyWeb استفاده می‌کرد</translation>
<translation id="5975370349701995302">‏برای دسترسی به چیزهایتان در مرورگر FlyWeb در همه دستگاه‌هایتان، به سیستم وارد شوید، سپس همگام‌سازی را روشن کنید</translation>
<translation id="7408894216012529448">‏برای دریافت به‌روزرسانی‌های آتی FlyWeb، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="7256356679044945328">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از FlyWeb حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="5261590792975521002">{0,plural, =1{‏FlyWeb را ظرف یک روز راه‌اندازی مجدد کنید}one{‏FlyWeb را ظرف # روز راه‌اندازی مجدد کنید}other{‏FlyWeb را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="3101564993057563365">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً FlyWeb را دوباره را بارگیری کنید.</translation>
<translation id="5316851838033144902">‏FlyWeb به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="6760691951531758781">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به FlyWeb، به بهبود ویژگی‌ها و عملکرد ChromeOS کمک کنید.</translation>
<translation id="6852836260419236265">‏نسخه FlyWeb قدیمی است</translation>
<translation id="8550334526674375523">این نمایه کاری کاملاً مجزا از نمایه شخصی‌تان است.</translation>
<translation id="538636623826336032">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای FlyWeb خاموش کرده است. افزودن این <ph name="EXTENSION_TYPE_PARAMETER"/> مجاز نیست.</translation>
<translation id="8842078659829047498">‏وقتی با «حساب FlyWeb» خود به سیستم وارد می‌شوید، FlyWeb می‌تواند گذرواژه‌هایتان را بررسی کند</translation>
<translation id="8121009781989288430">‏حق نشر <ph name="YEAR"/> نویسندگان FlyWeb. کلیه حقوق محفوظ است.</translation>
<translation id="6539417028609632917">‏<ph name="BEGIN_BOLD"/>نحوه استفاده ما از این داده‌ها:<ph name="END_BOLD"/> سایت‌ها می‌توانند بااستفاده از FlyWeb اطلاعاتی درباره علایقتان ذخیره کنند. برای مثال، اگر برای خرید کفش مخصوص ماراتون از سایتی بازدید کنید، ممکن است آن سایت علاقه شما را به‌صورت دونده ماراتون مشخص کند. بعداً، اگر برای ثبت‌نام در مسابقه‌ای به سایتی دیگر مراجعه کردید، آن سایت می‌تواند براساس علایقتان آگهی‌ای برای کفش مخصوص دویدن به شما نشان دهد.</translation>
<translation id="7129578417724116642">‏درحال راه‌اندازی FlyWeb…</translation>
<translation id="781795332371306113">‏به دلیل خطای نامشخص، نصب ناموفق بود. لطفاً دوباره FlyWeb را بارگیری کنید.</translation>
<translation id="5469043671012993003">‏نمی‌توان FlyWeb for Testing را به‌عنوان مرورگر پیش‌فرض تنظیم کرد.</translation>
<translation id="1074759999845943804">{NUM_DEVICES,plural, =0{‏یک افزونه FlyWeb به «دستگاه‌های میانای انسانی» دسترسی داشت}=1{‏یک افزونه FlyWeb به یک «دستگاه میانای انسانی» دسترسی دارد}one{‏یک افزونه FlyWeb به # «دستگاه میانای انسانی» دسترسی دارد}other{‏یک افزونه FlyWeb به # «دستگاه میانای انسانی» دسترسی دارد}}</translation>
<translation id="1514450422236300417">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی FlyWeb یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="573490495087487940">‏این FlyWeb شماست</translation>
<translation id="6779439179813982247">‏FlyWeb به مجوز دسترسی به دوربین و میکروفون برای این سایت نیاز دارد</translation>
<translation id="8826492472752484139">روی «مدیر گذرواژه» کلیک کنید</translation>
<translation id="6933858244219479645">‏سیستم ChromeOS</translation>
<translation id="7354175404728814475">‏<ph name="BEGIN_BOLD"/>انواع داده‌هایی که استفاده می‌شود:<ph name="END_BOLD"/> سابقه مرور شما، سابقه سایت‌هایی که بااستفاده از FlyWeb در این دستگاه از آن‌ها بازدید کرده‌اید.</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="709828993049448700">‏در این صورت، لطفاً گذرواژه ذخیره‌شده در FlyWeb را ویرایش کنید تا با گذرواژه جدیدتان مطابقت داشته باشد.</translation>
<translation id="1446416109379198698">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی FlyWeb یا کلیک روی دکمه صفحه اصلی نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="4669168852412989042">‏FlyWeb در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="1343885466359249904">‏FlyWeb می‌توانند علایقتان را براساس سابقه مرور چند هفته گذشته برآورد کند. این اطلاعات از دستگاهتان خارج نمی‌شود.</translation>
<translation id="1663379621921336006">‏به‌روزرسانی FlyWeb امکان‌پذیر نیست</translation>
<translation id="543915850302643692">‏نشان‌واره FlyWeb Enterprise</translation>
<translation id="8986207147630327271">با این کار، نمایه کاری را به این مرورگر اضافه می‌کنید و فقط کنترل نمایه کاری را دراختیار سرپرست قرار می‌دهید.</translation>
<translation id="5804408305184682593">‏ورود به سیستم FlyWeb</translation>
<translation id="8692043725449223663">‏ورود به سیستم FlyWeb اگر فقط یک‌بار می‌خواهید به سیستم حساب وارد شوید، می‌توانید <ph name="GUEST_LINK_BEGIN"/>به‌عنوان مهمان از دستگاه استفاده کنید<ph name="GUEST_LINK_END"/>.</translation>
<translation id="8323442969389928559">‏FlyWeb به‌طور خودکار بسته شد</translation>
<translation id="7626272203917389133">‏نسخه FlyWeb قدیمی است</translation>
<translation id="1789655708880997767">{0,plural, =1{‏FlyWeb یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏FlyWeb # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏FlyWeb # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="8970147445441095618">‏برای دریافت به‌روزرسانی‌های آتی FlyWeb، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8.1 استفاده می‌کند.</translation>
<translation id="1208237657860748752">‏باز کردن پیوند در &amp;برگه جدید FlyWeb</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="1899793037348288257">‏درطول دوره‌های آزمایشی، می‌توانید موضوعات موردعلاقه را که سایت‌ها برای ارائه آگهی به شما استفاده می‌کنند ببینید یا حذف کنید. FlyWeb علایق شما را براساس سابقه مرور اخیرتان تخمین می‌زند.</translation>
<translation id="3926534790663909774">‏سرپرست سیستم شما برای باز شدن مرورگر جایگزین برای دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، FlyWeb را پیکربندی کرده است.</translation>
<translation id="5022081608392609959">‏راه‌اندازی مجدد برای به‌روزرسانی FlyWeb</translation>
<translation id="8203782065881668160">‏FlyWeb‏ (mDNS ورودی)</translation>
<translation id="5547805003442792166">‏شخصی‌سازی کردن FlyWeb</translation>
<translation id="3410331617397516204">‏FlyWeb ممکن است درست کار نکند زیرا دیگر در Windows XP یا Windows Vista پشتیبانی نمی‌شود</translation>
<translation id="1641772209502041092">‏گواهینامه‌های تحت‌مدیریت FlyWeb</translation>
<translation id="1127626874097952395">‏چه‌کسی از FlyWeb استفاده می‌کند؟</translation>
<translation id="1626113414414104077">‏دریافت قوی‌ترین امنیت FlyWeb</translation>
<translation id="2952628102760787868">‏داده‌های سایت همواره بعداز بستن FlyWeb از دستگاه پاک شود</translation>
<translation id="8992261409816268381">Brave Authors</translation>
<translation id="137466361146087520">‏Google Chrome نسخه بتا</translation>
<translation id="7535429826459677826">‏Google Chrome نسخه Dev</translation>
<translation id="4434689349450618970">اگر می‌خواهید فقط یک‌بار از این حساب استفاده کنید، می‌توانید از <ph name="GUEST_LINK_BEGIN"/>حالت مهمان<ph name="GUEST_LINK_END"/> در مرورگر FlyWeb استفاده کنید. اگر می‌خواهید برای فردی دیگر حسابی اضافه کنید، <ph name="LINK_BEGIN"/>نمایه‌ای جدید<ph name="LINK_END"/> به <ph name="DEVICE_TYPE"/> خود اضافه کنید.
مجوزهایی که قبلاً به وب‌سایت‌ها و برنامه‌ها داده‌اید ممکن است در این حساب اعمال شوند. می‌توانید در <ph name="SETTINGS_LINK_BEGIN"/>تنظیمات<ph name="SETTINGS_LINK_END"/>، زنجیره‌های همگام‌سازی FlyWeb خود را مدیریت کنید.</translation>
<translation id="2725795635123877647">افزونه‌ها، برنامه‌ها و طرح‌های زمینه دریافتی از منابع ناشناخته می‌توانند به دستگاه شما آسیب بزنند. FlyWeb توصیه می‌کند که آنها را فقط از <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> نصب کنید</translation>
<translation id="3470813199863172076">این افزونه خط‌مشی فروشگاه وب را نقض می‌کند و ممکن است ناامن باشد. آن را از FlyWeb حذف کنید تا دیگر نتواند داده‌های شما را در سایت هایی که بازدید می‌کنید، از جمله اطلاعات شخصی شما، ببیند و تغییر دهد.</translation>
<translation id="5382847955032513683">‏هشدار: FlyWeb نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت خصوصی»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="543905389684998697">‏برای ایمن‌تر کردن FlyWeb، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="3914570680366033593">‏برای ایمن‌تر کردن FlyWeb، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="3293172835368652510">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="2742103213766991703">‏باز کردن پیوند در پنجره &amp;ناشناس FlyWeb</translation>
<translation id="1616978953472841483">‏باز کردن پیوند در پنجره &amp;ناشناس FlyWeb</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای FlyWeb در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای FlyWeb در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای FlyWeb در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای FlyWeb در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="4630629063306099328">می‌توانید زنجیره‌های همگام‌سازی FlyWeb واردشده به سیستم خود را مدیریت کنید. از زنجیره‌های همگام‌سازی FlyWeb شما برای مرورگر FlyWeb،‏ Play Store،‏ Gmail و موارد دیگر استفاده می‌شود. اگر می‌خواهید حسابی را برای شخص دیگری، مثل اعضای خانواده، اضافه کنید، به‌جای آن، نمایه جدیدی به <ph name="DEVICE_TYPE"/> خود اضافه کنید. <ph name="LINK_BEGIN"/>بیشتر بدانید<ph name="LINK_END"/></translation>
<translation id="4766381896251401675">وقتی در نوار آدرس یا کادر جستجو تایپ می‌کنید، FlyWeb آنچه را که تایپ می‌کنید به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادات بهتری دریافت کند. این قابلیت در حالت «خصوصی» خاموش است.</translation>
<translation id="3665070894458449212">وقتی در نوار آدرس یا کادر جستجو تایپ می‌کنید، FlyWeb آنچه را که تایپ می‌کنید به Google Drive می‌فرستد تا پیشنهادات مورد را دریافت کند. این قابلیت در حالت «خصوصی» خاموش است.</translation>
</translationbundle>
