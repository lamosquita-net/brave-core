<!DOCTYPE translationbundle>
<translationbundle lang="lt">
<translation id="130631256467250065">Pakeitimai įsigalios kitą kartą iš naujo paleidus įrenginį.</translation>
<translation id="1555506416658437797">redaguoti mokėjimo metodus</translation>
<translation id="8359495463485001719">„FlyWeb“ negalima teikti strigčių ataskaitų.</translation>
<translation id="6338530717474923868">Peržiūrite saugų „FlyWeb“ puslapį</translation>
<translation id="5147169001159408844">„FlyWeb“ bando keisti mokėjimo metodų pildymo nustatymus.</translation>
<translation id="5702992568540613683">„FlyWeb“ logotipas</translation>
<translation id="510342522494506803">„FlyWeb“ bando redaguoti mokėjimo metodus.</translation>
<translation id="8375862260948854624">„FlyWeb“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM"/>„FlyWeb“<ph name="END_LINK_CHROMIUM"/> atvirojo šaltinio projektą ir kitą <ph name="BEGIN_LINK_OSS"/>atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Eikite į 
          „FlyWeb“ meniu &gt;
          „<ph name="SETTINGS_TITLE"/>“
          &gt;
          „<ph name="ADVANCED_TITLE"/>“
          &gt;
          „<ph name="PROXIES_TITLE"/>“
          &gt;
          „LAN nustatymai“
          ir panaikinkite žymimojo laukelio „LAN naudoti tarpinį serverį“ pasirinkimą.</translation>
<translation id="5040124620086808431">Šį puslapį užblokavo „FlyWeb“</translation>
<translation id="1953000035868532675">Leiskite „FlyWeb“ pasiekti tinklą užkardos arba antivirusinės programos
          nustatymuose.</translation>
<translation id="3442058224540562441">Eikite į
          „FlyWeb“ meniu &gt;
          „<ph name="SETTINGS_TITLE"/>“
          &gt;
          „<ph name="ADVANCED_TITLE"/>“
          &gt;
          „<ph name="PROXIES_TITLE"/>“ 
          ir nustatykite konfigūraciją kaip „Nėra tarpinio serverio“ arba „Tiesioginis“.</translation>
<translation id="585620188971323280">keisti mokėjimo metodų pildymo nustatymus.</translation>
<translation id="2681118099728446983">„FlyWeb“ taip pat pasiekiama naudojant kitą <ph name="BEGIN_LINK_OSS"/>atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Pakeitimai įsigalios kitą kartą iš naujo paleidus „FlyWeb“.</translation>
<translation id="1017070759373671177">„FlyWeb“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM"/>„FlyWeb“<ph name="END_LINK_CHROMIUM"/> atvirojo šaltinio projektą.</translation>
<translation id="7777112741998051633">Eikite į
        „FlyWeb“ meniu &gt;
        „<ph name="SETTINGS_TITLE"/>“
        &gt;
        „<ph name="ADVANCED_TITLE"/>“
        ir panaikinkite „<ph name="NO_PREFETCH_DESCRIPTION"/>“ pasirinkimą.
        Jei tai atlikus problema išlieka, rekomenduojame vėl pasirinkti šią parinktį,
        kad pagerėtų našumas.</translation>
<translation id="8187289872471304532">Eikite į
          „Programos“ &gt; „Sistemos nuostatos“ &gt; „Tinklas“ &gt; „Išplėstinis“ &gt; „Tarpiniai serveriai“
          ir panaikinkite visų tarpinių serverių pasirinkimą.</translation>
<translation id="4699594416850504200">Peržiūrite saugų „FlyWeb for Testing“ puslapį</translation>
<translation id="6224789938625024797">„FlyWeb“ netinkamai išsijungė.</translation>
</translationbundle>