<!DOCTYPE translationbundle>
<translationbundle lang="cs">
<translation id="130631256467250065">Změny se projeví po příštím restartu zařízení.</translation>
<translation id="125853961893919199">Tip pro FlyWeb: Ukládání hesel</translation>
<translation id="1589233279653618219">Přejděte do nabídky FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> a zajistěte, aby konfigurace byla nastavená na možnost „bez proxy“ nebo „přímé“.</translation>
<translation id="8359495463485001719">Hlášení o selhání není v prohlížeči FlyWeb k dispozici.</translation>
<translation id="6338530717474923868">Prohlížíte si zabezpečenou stránku vygenerovanou prohlížečem FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb se pokouší upravit nastavení vyplňování platebních metod.</translation>
<translation id="5702992568540613683">Logo FlyWeb</translation>
<translation id="8966580353365544289">Tip pro FlyWeb: Vylepšené Bezpečné prohlížení</translation>
<translation id="510342522494506803">FlyWeb se pokouší upravit platební metody.</translation>
<translation id="8375862260948854624">FlyWeb staví na projektu s otevřeným zdrojovým kódem <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> a využívá i další <ph name="BEGIN_LINK_OSS"/>software s otevřeným zdrojovým kódem<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Tato stránka je blokována prohlížečem FlyWeb</translation>
<translation id="1953000035868532675">V nastavení firewallu a antivirového programu povolte prohlížeči FlyWeb přístup k síti.</translation>
<translation id="4949828774841497663">Přejděte do části Aplikace &gt; Nastavení systému &gt; Síť, vyberte aktivní síť, klikněte na tlačítko Podrobnosti… a zrušte výběr všech proxy serverů, které jsou vybrány.</translation>
<translation id="7584668345330431749">Přejděte do nabídky FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Síť a internet &gt; Proxy a zrušte výběr možnosti Automaticky zjišťovat nastavení.</translation>
<translation id="3145451630329266064">Tyto stránky jsou určeny pro vývojáře prohlížeče FlyWeb a nemusí být aktivně udržovány ani testovány. Pokud je chcete povolit, přejděte na adresu <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, kliknutím na příslušné tlačítko povolte ladicí stránky a pak znovu přejděte na tuto stránku.</translation>
<translation id="2681118099728446983">FlyWeb využívá také další <ph name="BEGIN_LINK_OSS"/>open source software<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Změny se projeví po příštím restartu prohlížeče FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb potřebuje přístup k Bluetooth, aby bylo možné
 pokračovat v párování. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb staví na open source projektu <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Přejděte do nabídky FlyWeb &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="ADVANCED_TITLE"/> a zrušte výběr možnosti <ph name="NO_PREFETCH_DESCRIPTION"/>. Pokud to však problém nevyřeší, doporučujeme vám tuto možnost znovu vybrat (za účelem zlepšení výkonu).</translation>
<translation id="4699594416850504200">Prohlížíte si zabezpečenou stránku FlyWeb for Testing</translation>
<translation id="6224789938625024797">Aplikace FlyWeb nebyla řádně ukončena.</translation>
<translation id="3593104813552438879">Tip pro FlyWeb: Vyhledávejte pomocí Lens</translation>
</translationbundle>