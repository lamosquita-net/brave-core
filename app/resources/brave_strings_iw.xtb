<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="7099479769133613710">‏הפעלה מחדש לצורך עדכון ‎&amp;ChromeOS</translation>
<translation id="291426170030461697">‏לפי המלצת FlyWeb, כדאי לבדוק את התוסף הזה</translation>
<translation id="1549005488226693697">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת FlyWeb משתמשת בשרתי FlyWeb. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל FlyWeb יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="8908267645832965492">‏ההורה שלך השבית ב-FlyWeb את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
<translation id="5557633153169217776">‏כדי ש-FlyWeb יוכל למצוא מכשירים קרובים ולהשתמש בהם, צריך לתת לו גישה לרשת המקומית</translation>
<translation id="6441390163669415879">‏כדי לחפש תכונה או תוסף ספציפיים של FlyWeb, אפשר להקליד את השם המקוצר שלהם בסרגל הכתובות ואז ללחוץ על מקש המקלדת שנבחר</translation>
<translation id="9001750423919983557">‏הצגת החיפוש באמצעות FlyWeb במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="1368460307421081773">‏FlyWeb רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">‏FlyWeb מוגדר כדפדפן ברירת המחדל</translation>
<translation id="4556715463645168547">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK"/>יש להיכנס ל-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">‏לוחצים על תפריט FlyWeb</translation>
<translation id="1157985233335035034">שפות אחרונות</translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="4380351562011537903">‏על FlyWeb</translation>
<translation id="853148447909557566">‏רוצה לקבל התראות על מעקב מחירים באמצעות FlyWeb בטלפון?</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">‏כשפותחים את חיפוש התמונות, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים באופן אוטומטי לשרת. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">‏אחרי הכניסה לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון FlyWeb ב-FlyWeb. כדי לשנות את האפשרות הזאת, כדאי לעבור אל "החשבון שלך ב-FlyWeb".</translation>
<translation id="7614508617663739435">‏הצגת Gemini ב-FlyWeb בסרגל התפריטים של Mac</translation>
<translation id="832555967476614730">‏כדי לבחור חלק מהמסך ב-Gemini ב-FlyWeb צריך להשתמש במקש קיצור.</translation>
<translation id="4750836834956739196">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-FlyWeb ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="3190759351483708314">‏FlyWeb חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="5879469261638423015">‏כשנכנסים לשירותי FlyWeb כמו Gmail או YouTube עם <ph name="USER_EMAIL"/>, אפשר להיכנס אוטומטית ל-FlyWeb עם אותו חשבון</translation>
<translation id="7142135954326264349">‏הורדת FlyWeb לטלפון</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">‏הגדרת הפרופיל החדש שלך ב-FlyWeb</translation>
<translation id="5252737639504553444">‏כדאי לנסות את Gemini ב-FlyWeb</translation>
<translation id="609743863669742325">‏ל-FlyWeb נדרשת גישה ל-Bluetooth כדי למצוא 
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">‏כניסה ל-FlyWeb בטלפון</translation>
<translation id="1330562121671411446">זיהוי שפה אוטומטי</translation>
<translation id="2276527911011636666">‏אני רוצה למחוק את הנתונים גם מ-FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">התכונה הוצמדה. מעכשיו אפשר לגשת לחיפוש התמונות דרך הכפתור החדש בסרגל הכלים</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="1045149878186896649">‏עם אפליקציית FlyWeb אפשר להמשיך לגלוש בכל מקום</translation>
<translation id="141901961143729572">כאן אפשר לשתף את המחשבות שלך</translation>
<translation id="2758515779140515865">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-FlyWeb בקטע "הגדרות המערכת".</translation>
<translation id="4713192356155907986">‏קבלת עזרה לגבי FlyWeb for Testing</translation>
<translation id="4984443629206419460">‏כדי לקבל גישה למידע השמור ולנתונים נוספים מתוך <ph name="DEVICE"/>, צריך להיכנס ל-FlyWeb</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">הדף הזה מוגן</translation>
<translation id="8962360511570172">‏שיתוף כרטיסיית FlyWeb</translation>
<translation id="2941487459666781243">‏כניסה ל-FlyWeb</translation>
<translation id="1547469039832541117">סיום המשימה המודגשת.</translation>
<translation id="3182893868355533457">‏הצמדת FlyWeb</translation>
<translation id="852852907317361085">‏הכלים לבטיחות של FlyWeb</translation>
<translation id="481155564361715417">‏‫FlyWeb רוצה למחוק את הנתונים שלך במנהל הסיסמאות. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="2846999307505917298">‏מיטב הטכנולוגיות של FlyWeb אצלך בידיים עם אפליקציית FlyWeb לטלפון</translation>
<translation id="3961251277542681013">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-FlyWeb</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1665602916345474427">נכנסת בתור <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="7625232007557474355">‏אפשר להשתמש ב-FlyWeb בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות. הדפדפן גם יוצמד לסרגל האפליקציות.</translation>
<translation id="1709772298389099340">השירות הזה מספק הרשאות מורחבות ל-<ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">‏נתוני הגלישה ב-FlyWeb יימחקו בקרוב</translation>
<translation id="8939535770474283898">‏FlyWeb ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="2581127533455294937">‏נתוני FlyWeb נמחקו</translation>
<translation id="7385422968404728039">‏FlyWeb יופעל מחדש בעוד <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">‏כש-HTTPS לא יהיה זמין, FlyWeb ישתמש בחיבור לא מאובטח בלי להציג אזהרה</translation>
<translation id="307170399141486420">‏התרה ל-FlyWeb לפעול ברקע</translation>
<translation id="5006568136491721884">‏כדי להצמיד את FlyWeb לסרגל האפליקציות לגישה מהירה, צריך ללחוץ על <ph name="BEGIN_BOLD"/>כן<ph name="END_BOLD"/> בהתראה של Windows.</translation>
<translation id="2473319786107120819">‏התקנת FlyWeb מחדש</translation>
<translation id="2533324957407080119">‏FlyWeb מנסה <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">‏החשבון של <ph name="EXISTING_USER"/> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-FlyWeb בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS"/>. אפשר לקבל גם את התוספים ופריטים נוספים ממכשיר <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">‏בפעם הבאה ש-FlyWeb ייפתח במכשיר <ph name="DEVICE_TYPE"/>, תופיע הנחיה להשתמש במנהל הסיסמאות של FlyWeb.</translation>
<translation id="1838374766361614909">ניקוי חיפוש</translation>
<translation id="3403116471618205223">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-FlyWeb, <ph name="BEGIN_LINK"/>עליך לצאת מהחשבון ב-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">‏כדי לפתוח או ליצור קבוצות חדשות של כרטיסיות תוך כדי תנועה, כדאי להוריד את FlyWeb לטלפון שלך.</translation>
<translation id="3285741355512747610">‏יש לך אפשרות לנהל את חשבונות FlyWeb שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן FlyWeb, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות FlyWeb שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>מידע נוסף<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">חיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="5054936737639982722">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER"/>. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-FlyWeb בתור <ph name="USER_EMAIL_ADDRESS"/>. הסימניות ופריטים נוספים יופיעו במכשיר <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">בחירת טקסט</translation>
<translation id="4824940465467423308">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-FlyWeb. הנתונים שלך ב-FlyWeb, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME"/>. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות FlyWeb, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-FlyWeb בנפרד.<ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">‏‫FlyWeb חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. <ph name="BEGIN_LINK"/>מידע נוסף על מצב חיסכון באנרגיה<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">‏שירות לעדכון של FlyWeb</translation>
<translation id="7390382558747224642">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי FlyWeb, כמו Gmail, בלי להיכנס אל FlyWeb</translation>
<translation id="5714085538350759767">‏FlyWeb אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="5866699689358760578">‏לפי דרישת הארגון שלך, <ph name="MANAGER"/>, עליך להיכנס לחשבון ב-FlyWeb</translation>
<translation id="4035053306113201399">‏צריך להפעיל מחדש את ChromeOS כדי להחיל את העדכון הזה.</translation>
<translation id="3750729306035486751">‏FlyWeb חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE"/> דק'</translation>
<translation id="6956650624767954726">‏ב-FlyWeb לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="197326043290947695">גלישה חכמה יותר עם "חיפוש תמונות"</translation>
<translation id="130679046523922050">‏מידע על חסימה של קבצים מסוימים ב-FlyWeb, נפתח בכרטיסייה חדשה</translation>
<translation id="8243822903505210769">‏השירות הזה שומר על תוכנת FlyWeb עדכנית. אם השירות הזה מושבת או מופסק, תוכנת FlyWeb לא תתעדכן באופן קבוע. כתוצאה מכך, לא ניתן יהיה לתקן פרצות אבטחה שעלולות להיווצר, וייתכן שחלק מהתכונות לא יפעלו. השירות הזה יוסר באופן אוטומטי אם אין תוכנת FlyWeb שמשתמשת בו.</translation>
<translation id="6495079989036864983">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל FlyWeb עם <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2039417478970545937">הגדרות.</translation>
<translation id="8544477465831682343">‏בוחרים אם לכלול את ההיסטוריה ב-FlyWeb להתאמה אישית מדויקת יותר בשירותי FlyWeb</translation>
<translation id="328650761750741315">‏מנהל הסיסמאות מובנה ב-FlyWeb ומאפשר לך ליצור סיסמאות חזקות, לשמור אותן ולמלא אותן אוטומטית. כדי להגיע אליו בקלות, אפשר להוסיף את קיצור הדרך.</translation>
<translation id="2407746489237278840">‏אפשר ללחוץ על הכפתור "התאמה אישית של FlyWeb" בדף הכרטיסייה החדשה כדי לשנות את המראה שלו</translation>
<translation id="8924891216494775926">‏FlyWeb חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="5728214838078602184">‏בפעם הבאה ש-FlyWeb ייפתח ב-iOS, תופיע הנחיה לנסות את <ph name="FEATURE_NAME"/>.</translation>
<translation id="2058207584484841616">‏הסיסמאות ונתונים אחרים מ-FlyWeb ששמרת בחשבון שלך ב-FlyWeb יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-FlyWeb, צריך להיכנס בחזרה לחשבון.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}}</translation>
<translation id="2125838419757773031">בחירת אזור במסך לחיפוש</translation>
<translation id="2126108037660393668">נכשל האימות של הקובץ שהורד.</translation>
<translation id="2135919691573380097">דיווח על האתר הזה</translation>
<translation id="2137162749895930932">סגירת המסך לתרגום</translation>
<translation id="2147218225094845757">הסתרת החלונית הצדדית</translation>
<translation id="4474394796469499134">‏FlyWeb חסם את ההורדה הזאת כי האתר לא משתמש בחיבור מאובטח ויכול להיות שבוצעו שינויים לא מורשים בקובץ</translation>
<translation id="2170098639895543546">צריך לבחור משהו מהדף</translation>
<translation id="6765231735885996239">‏התאמה אישית של FlyWeb</translation>
