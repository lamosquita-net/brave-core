<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="130631256467250065">Mabadiliko yako yatatekelezwa utakapowasha upya tena kifaa chako.</translation>
<translation id="125853961893919199">Kidokezo cha FlyWeb: Hifadhi Manenosiri</translation>
<translation id="1589233279653618219">Nenda kwenye
          menyu ya FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          na uhakikishe kuwa mipangilio yako imewekwa kuwa "hakuna seva mbadala" au "ya moja kwa moja."</translation>
<translation id="8359495463485001719">Kuripoti uharibifu hakupatikana katika FlyWeb.</translation>
<translation id="6338530717474923868">Unaangalia ukurasa salama wa FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb inajaribu kurekebisha mipangilio kwa ajili ya kujaza njia za kulipa.</translation>
<translation id="5702992568540613683">Nembo ya FlyWeb</translation>
<translation id="8966580353365544289">Kidokezo cha FlyWeb: Kipengele cha Kuvinjari Salama Kilichoboreshwa</translation>
<translation id="510342522494506803">FlyWeb inajaribu kubadilisha njia za kulipa.</translation>
<translation id="8375862260948854624">FlyWeb imerahisishwa na mradi wa programu huria ya <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> na programu nyingine <ph name="BEGIN_LINK_OSS"/>huria<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Ukurasa huu umezuiwa na FlyWeb</translation>
<translation id="1953000035868532675">Ruhusu FlyWeb ifikie mtandao kwenye mipangilio yako ya kinga mtandao au kingavirusi.</translation>
<translation id="4949828774841497663">Nenda kwenye Programu &gt; Mipangilio ya Mfumo &gt; Mtandao, chagua
          mtandao unaotumika, bofya kitufe cha Maelezo... kisha uache kuchagua seva zozote mbadala
          ambazo huenda umechagua.</translation>
<translation id="7584668345330431749">Nenda kwenye
          menyu ya FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mtandao na intaneti &gt; Seva mbadala
          kisha uache kuchagua "Tambua mipangilio kiotomatiki."</translation>
<translation id="3145451630329266064">Kurasa hizi zinanuiwa kutumiwa na wasanidi programu wa FlyWeb na huenda zisiweze kufanyiwa majaribio wala kudumishwa kila wakati. Ili uzifungue, nenda kwenye <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, bofya kitufe ili ufungue kurasa za utatuzi kisha urudi kwenye ukurasa huu tena.</translation>
<translation id="2681118099728446983">FlyWeb inawezeshwa pia na <ph name="BEGIN_LINK_OSS"/>programu nyingine huria<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Mabadiliko yako yataanza kufanya kazi wakati ujao utakapozindua upya FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb inahitaji ruhusa ya kufikia Bluetooth ili iendelee 
 kuoanisha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb inawezeshwa na mradi wa programu huria wa <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Nenda kwenye
        menyu ya FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        <ph name="ADVANCED_TITLE"/>na uondoe tiki kwenye "<ph name="NO_PREFETCH_DESCRIPTION"/>."
        Ikiwa hili halitatatua tatizo, tunapendekeza uchague tena chaguo hili kwa utendaji ulioboreshwa.</translation>
<translation id="4699594416850504200">Unaangalia ukurasa salama wa FlyWeb ya Majaribio</translation>
<translation id="6224789938625024797">FlyWeb haikuzimika kwa njia sahihi.</translation>
<translation id="3593104813552438879">Kidokezo cha FlyWeb: Tafuta Ukitumia Lenzi</translation>
</translationbundle>