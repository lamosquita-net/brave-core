<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="130631256467250065">Thay đổi của bạn sẽ có hiệu lực vào lần tiếp theo bạn khởi động lại thiết bị của mình.</translation>
<translation id="1555506416658437797">chỉnh sửa phương thức thanh toán.</translation>
<translation id="8359495463485001719">Báo cáo sự cố hiện không khả dụng trong FlyWeb.</translation>
<translation id="6338530717474923868">Bạn đang xem trang FlyWeb an toàn</translation>
<translation id="5147169001159408844">FlyWeb đang cố gắng sửa đổi chế độ cài đặt cho việc điền phương thức thanh toán.</translation>
<translation id="5702992568540613683">Biểu trưng FlyWeb</translation>
<translation id="510342522494506803">FlyWeb đang cố gắng chỉnh sửa phương thức thanh toán.</translation>
<translation id="8375862260948854624">FlyWeb trở nên khả thi là nhờ dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> và các <ph name="BEGIN_LINK_OSS"/>phần mềm nguồn mở<ph name="END_LINK_OSS"/> khác.</translation>
<translation id="4281953335231207224">Đi tới
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Cài đặt mạng LAN
          và bỏ chọn hộp kiểm "Sử dụng máy chủ proxy cho mạng LAN của bạn".</translation>
<translation id="5040124620086808431">Trang này bị FlyWeb chặn</translation>
<translation id="1953000035868532675">Cho phép FlyWeb truy cập mạng trong cài đặt tường lửa hoặc diệt vi-rút 
        của bạn.</translation>
<translation id="3442058224540562441">Đi tới
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          và đảm bảo cấu hình của bạn được đặt thành "không có proxy" hoặc "trực tiếp".</translation>
<translation id="585620188971323280">sửa đổi chế độ cài đặt cho việc điền phương thức thanh toán.</translation>
<translation id="2681118099728446983">FlyWeb cũng được cung cấp thông qua <ph name="BEGIN_LINK_OSS"/>phần mềm nguồn mở<ph name="END_LINK_OSS"/> khác.</translation>
<translation id="6888846095017247017">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại FlyWeb.</translation>
<translation id="1017070759373671177">FlyWeb được cung cấp thông qua dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Chuyển đến
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          và bỏ chọn "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Nếu cách này không giải quyết được sự cố thì chúng tôi khuyên bạn nên chọn lại tùy chọn này
          để cải thiện hiệu suất.</translation>
<translation id="8187289872471304532">Đi tới
          Ứng dụng&gt; Tùy chọn hệ thống &gt; Mạng &gt; Nâng cao &gt; Proxy
          và bỏ chọn bất kỳ proxy nào đã được chọn.</translation>
<translation id="4699594416850504200">Bạn đang xem một trang FlyWeb for Testing an toàn</translation>
<translation id="6224789938625024797">FlyWeb không tắt đúng cách.</translation>
</translationbundle>