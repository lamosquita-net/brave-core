<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="130631256467250065">Promene će stupiti na snagu kada sledeći put ponovo pokrenete uređaj.</translation>
<translation id="125853961893919199">Napomena za FlyWeb: Sačuvajte lozinke</translation>
<translation id="1589233279653618219">Idite u
          FlyWeb meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          i proverite da li je konfiguracija podešena na „no proxy“ (bez proksija) ili „direct“ (direktno).</translation>
<translation id="8359495463485001719">Izveštavanje o otkazivanjima nije dostupno u FlyWeb-u.</translation>
<translation id="6338530717474923868">Gledate bezbednu FlyWeb stranicu.</translation>
<translation id="5147169001159408844">FlyWeb pokušava da izmeni podešavanja za popunjavanje načina plaćanja.</translation>
<translation id="5702992568540613683">FlyWeb logotip</translation>
<translation id="8966580353365544289">Napomena za FlyWeb: Poboljšano bezbedno pregledanje</translation>
<translation id="510342522494506803">FlyWeb pokušava da izmeni načine plaćanja.</translation>
<translation id="8375862260948854624">FlyWeb omogućavaju <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> projekat otvorenog koda i drugi <ph name="BEGIN_LINK_OSS"/>softver otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">FlyWeb blokira ovu stranicu</translation>
<translation id="1953000035868532675">Dozvolite FlyWeb-u da pristupa mreži u zaštitnom zidu ili antivirusnim
          podešavanjima.</translation>
<translation id="4949828774841497663">Idite u Applications (Aplikacije) &gt; System Settings (Podešavanja sistema) &gt; Network (Mreža), pa izaberite
          aktivnu mrežu, kliknite na dugme Details... (Detalji), a zatim poništite izbor svih proksija
          koji su izabrani.</translation>
<translation id="7584668345330431749">Idite u
          FlyWeb meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mreža i internet &gt; Proksi
          i poništite izbor opcije Automatski otkrij podešavanja.</translation>
<translation id="3145451630329266064">Ove stranice su namenjene programerima FlyWeb-a i možda se ne održavaju niti testiraju aktivno. Da biste ih omogućili, idite na <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, kliknite na dugme da biste omogućili stranice za otklanjanje grešaka, pa ponovo idite na ovu stranicu.</translation>
<translation id="2681118099728446983">FlyWeb omogućava i drugi <ph name="BEGIN_LINK_OSS"/>softver otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Promene će stupiti na snagu kada sledeći put ponovo pokrenete FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb zahteva pristup Bluetooth-u radi nastavljanja sa 
 uparivanjem. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb omogućava <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> projekat otvorenog koda.</translation>
<translation id="7777112741998051633">Otvorite
          FlyWeb meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          i opozovite izbor opcije „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          Ako vam to ne reši problem, preporučujemo da ponovo izaberete
          ovu opciju radi boljih performansi.</translation>
<translation id="4699594416850504200">Pregledate bezbednu FlyWeb for Testing stranicu</translation>
<translation id="6224789938625024797">FlyWeb se nije ispravno zatvorio.</translation>
<translation id="3593104813552438879">Savet za FlyWeb: Pretražujte pomoću Objektiva</translation>
</translationbundle>