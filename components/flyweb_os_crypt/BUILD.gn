# FlyWeb `fw1` key provider for os_crypt_async (FS.25, FM.51).
assert(is_mac)

source_set("fw1_key_provider") {
  sources = [
    "fw1_key_provider_mac.h",
    "fw1_key_provider_mac.mm",
  ]

  public_deps = [ "//components/os_crypt/async/browser:key_provider_interface" ]

  deps = [
    "//base",
    "//components/os_crypt/async/common",
    "//components/os_crypt/sync",
    "//crypto",
    "//third_party/boringssl",
  ]

  frameworks = [ "Security.framework" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "fw1_key_provider_mac_unittest.mm" ]
  deps = [
    ":fw1_key_provider",
    "//base",
    "//base/test:test_support",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/os_crypt/sync",
    "//components/os_crypt/sync:test_support",
    "//crypto",
    "//testing/gtest",
  ]
}
