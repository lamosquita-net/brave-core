+        *RepeatInterval() < kMinimumInterval) {
+      AugmentRepeatInterval(kMinimumInterval - *RepeatInterval());
     }
     if (nesting_level_ == kMaxTimerNestingLevel) {
       // Move to the TaskType that corresponds to nesting level >=
