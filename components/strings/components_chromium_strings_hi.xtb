<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
<translation id="130631256467250065">अगली बार अपना डिवाइस फिर से शुरू करने पर आपके बदलाव लागू हो जाएंगे.</translation>
<translation id="1555506416658437797">पेमेंट के तरीकों में बदलाव करें.</translation>
<translation id="8359495463485001719">FlyWeb में खराबी रिपोर्ट नहीं कर सकते.</translation>
<translation id="6338530717474923868">आप एक सुरक्षित FlyWeb पेज देख रहे हैं</translation>
<translation id="5147169001159408844">FlyWeb, पेमेंट के तरीके की जानकारी भरने के लिए, सेटिंग में बदलाव करने की कोशिश कर रहा है.</translation>
<translation id="5702992568540613683">FlyWeb लोगो</translation>
<translation id="510342522494506803">FlyWeb पेमेंट के तरीकों में बदलाव करने की कोशिश कर रहा है.</translation>
<translation id="8375862260948854624">FlyWeb <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> खुला स्रोत प्रोजेक्ट और अन्‍य <ph name="BEGIN_LINK_OSS"/>खुले स्रोत प्रोजेक्ट<ph name="END_LINK_OSS"/> द्वारा संभव बनाया गया है.</translation>
<translation id="4281953335231207224">यहां
          FlyWeb मेन्यू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN सेटिंग पर जाएं
          और "अपने LAN के लिए किसी प्रॉक्सी सर्वर का इस्तेमाल करें" चेकबॉक्स को चुने हुए से हटाएं.</translation>
<translation id="5040124620086808431">इस पेज को FlyWeb ने ब्लॉक कर दिया है</translation>
<translation id="1953000035868532675">FlyWeb को अपनी फ़ायरवॉल या एंटीवायरस सेटिंग में
          नेटवर्क को एक्सेस करने दें.</translation>
<translation id="3442058224540562441">यहां जाएं
          FlyWeb मेन्यू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
           और पक्का करें कि आपका कॉन्फ़िगरेशन "कोई प्रॉक्सी नहीं" या "डायरेक्ट" पर सेट है.</translation>
<translation id="585620188971323280">पेमेंट के तरीके की जानकारी भरने के लिए, सेटिंग में बदलाव करें.</translation>
<translation id="2681118099728446983">FlyWeb को अन्य <ph name="BEGIN_LINK_OSS"/>ओपन सोर्स सॉफ़्टवेयर<ph name="END_LINK_OSS"/> की मदद से भी बनाया गया है.</translation>
<translation id="6888846095017247017">अगली बार जब आप FlyWeb फिर से लॉन्‍च करेंगे तो आपके बदलाव लागू होंगे .</translation>
<translation id="1017070759373671177">FlyWeb को <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ओपन सोर्स प्रोजेक्ट की मदद से बनाया गया है.</translation>
<translation id="7777112741998051633">यहां जाएं
          FlyWeb मेन्यू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          और "<ph name="NO_PREFETCH_DESCRIPTION"/>" चुना हुआ हटाएं.
          अगर इससे समस्‍या हल नहीं होती, तो बेहतर प्रदर्शन के लिए हम इस विकल्‍प को फिर से चुनने का सुझाव देते हैं.</translation>
<translation id="8187289872471304532">यहां
          ऐप्लिकेशन  &gt; सिस्टम प्राथमिकताएं &gt; नेटवर्क &gt; बेहतर &gt; प्रॉक्सी
          पर जाएं और चुनी गई प्रॉक्सी को न चुनें.</translation>
<translation id="4699594416850504200">आप एक सुरक्षित FlyWeb for Testing पेज पर हैं</translation>
<translation id="6224789938625024797">FlyWeb सही तरीके से बंद नहीं हुआ.</translation>
</translationbundle>