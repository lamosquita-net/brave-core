<translation id="2251813826843049011">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید FlyWeb آن را غیرفعال کند.</translation>
<translation id="2664701271733223256">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای FlyWeb مجاز کنید</translation>
<translation id="6274649779206195384">‏اجرای مجدد FlyWeb</translation>
<translation id="3161522574479303604">همه زبان‌ها</translation>
<translation id="6773570808762718524">‏سفارشی کردن نمایه جدید FlyWeb</translation>
<translation id="8965010907836433875">‏می‌توانید بدون عوض کردن زبانه، به گپ زدن با «حالت هوشواره‌ای» ادامه دهید. برای شروع، به سیستم FlyWeb وارد شوید. گذرواژه‌هایتان و اطلاعات دیگر را نیز در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="5958835776851191812">‏برای برداشتن «حساب FlyWeb» خود از FlyWeb، در صفحه «تنظیمات» از سیستم FlyWeb خارج شوید</translation>
<translation id="4217346567895356023">‏بعداً FlyWeb می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="5449297306961970452">‏FlyWeb نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">‏با FlyWeb در iOS، ابزارهای هوشواره FlyWeb دلخواهتان را درحرکت همراه داشته باشید.</translation>
<translation id="8090118570458552025">‏برای دریافت افزونه‌ها و سایر موارد از <ph name="DEVICE"/>، به سیستم FlyWeb وارد شوید</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="3900612994249740104">‏کلیدهای FlyWeb API وجود ندارند. برخی از عملکردهای FlyWeb از کار خواهند افتاد.</translation>
<translation id="6824575001009586492">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه FlyWeb بسته می‌شود</translation>
<translation id="2595215790271940091">‏FlyWeb قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="3701353923785984059">‏وقتی همه پنجره‌های FlyWeb را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم FlyWeb وارد شده باشید از «حساب FlyWeb» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">‏گوشه بالا سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT"/> سمت چپ، ‎٪<ph name="TOP"/> بالا</translation>
<translation id="8629055140319079166">‏داده‌های FlyWeb در حساب شما</translation>
<translation id="1943161457314845496">‏از گذرواژه‌هایتان با FlyWeb در تلفنتان استفاده کنید</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">‏به نمایه FlyWeb موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="1568435374218487057">‏برای دریافت نشانک‌ها و سایر موارد از <ph name="DEVICE"/>، به سیستم FlyWeb وارد شوید</translation>
<translation id="3438772217992559640">جستجوی این زبانه با «جستجوی تصویر»</translation>
<translation id="6301354573631022693">‏«مرور ایمن پیشرفته» را با FlyWeb در تلفنتان گسترش دهید</translation>
<translation id="7625477329092296018">‏درحال شخصی‌سازی FlyWeb…</translation>
<translation id="956833467923764542">‏این کار <ph name="ITEMS_COUNT"/> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="4772642827282964272">‏با <ph name="SHORTCUT"/> می‌توانید بین نمایه‌های FlyWeb جابه‌جا شوید</translation>
<translation id="6724485219247982027">‏لطفاً همه پنجره‌های FlyWeb را ببندید و دوباره سعی کنید.</translation>
<translation id="5048962017649434283">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای FlyWeb مجاز کنید</translation>
<translation id="1582211253241551883">‏‫<ph name="EXISTING_USER"/> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="408747932595284596">‏رمزینه پاسخ‌سریع برای بارگیری مرورگر FlyWeb در دستگاه‌های همراه</translation>
<translation id="1413410454753055427">‏یادآور: بهترین ویژگی‌های ایمنی FlyWeb در جیب شما</translation>
<translation id="7831730508158736496">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای FlyWeb مجاز کنید.</translation>
<translation id="9006158231572141726">‏محافظت بهبودیافته، بهینه‌سازی جاوا اسکریپت را برای سایت‌هایی که FlyWeb آن‌ها را نمی‌شناسد، خاموش می‌کند</translation>
<translation id="3597003331831379823">راه‌اندازی با امتیازهای عالی اجرا نشد. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">‏ورود به سیستم FlyWeb</translation>
<translation id="6970052268542136081">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="2438845157914027912">‏استفاده از <ph name="BEGIN_LINK"/>گذرعبارت خودتان<ph name="END_LINK"/> برای رمزگذاری همه داده‌های FlyWeb موجود در «حساب FlyWeb» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور FlyWeb همگام‌سازی نخواهد شد.</translation>
<translation id="6611602069520888180">‏باز کردن پیوند در &amp;برگه جدید FlyWeb</translation>
<translation id="2591356225047803326">‏برای شخصی‌سازی و اهداف بیشتر، FlyWeb و دیگر سرویس‌های FlyWeb را به‌هم پیوند دهید</translation>
<translation id="3729187154190517324">بااستفاده از دکمه «افزودن زبانه و موارد دیگر»، چند زبانه، فایل، و ابزار اضافه کنید و جستجویتان را عمیق‌تر کنید.</translation>
<translation id="1771882170639856394">‏مدیریت نمایه‌های FlyWeb</translation>
<translation id="3782148374606932577">‏ببینید چرا FlyWeb برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="4640643918757362950">‏اگر موردی نیاز به بررسی داشته باشد، FlyWeb به شما اطلاع می‌دهد</translation>
<translation id="2179738813053854729">‏‫FlyWeb صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3810973564298564668">مدیریت</translation>
<translation id="5026502787439628947">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، FlyWeb ویژه iOS را بارگیری کنید، و به سیستم «حساب FlyWeb» وارد شوید</translation>
<translation id="3846683726093018685">**خلاصه کردن:** در یک جمله کمتر از ۳۰ کلمه، موضوع اصلی و هدف محتوای نماگرفت را شرح بده.

          **پیشنهاد سؤال:** فهرستی گلوله‌ای با ۳ تا ۵ سؤال تأمل‌برانگیز تولید کن که کاربر بتواند برای درک بهتر نماگرفت بپرسد. حداقل یک مورد از این سؤالات باید به‌طور خاص درباره یک شیء بصری، طراحی، یا جای آن باشد.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">‏برای دریافت نشانک‌ها و سایر موارد در همه دستگاه‌هایتان، به سیستم FlyWeb وارد شوید</translation>
<translation id="3885770153807205175">انتخاب‌گر زبان</translation>
<translation id="5175060854726708547">‏FlyWeb را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="606156353708638647">‏برای باز کردن FlyWeb و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="5145107420478372433">‏<ph name="EXISTING_USER"/> قبلاً به سیستم این نمایه FlyWeb وارد شده است. برای جدا نگه داشتن مرور، FlyWeb می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="8536259619256229278">‏FlyWeb می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="7965008434896274911">‏برای دریافت اطلاعات ذخیره‌شده و سایر موارد در همه دستگاه‌هایتان، به سیستم FlyWeb وارد شوید</translation>
<translation id="4540773594514226705">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب FlyWeb» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در FlyWeb، دوباره به سیستم وارد شوید.</translation>
<translation id="395904275706073188">صفحه‌های محافظت‌شده خوانده نمی‌شوند. صفحه دیگری را امتحان کنید.</translation>
<translation id="3849784651193576458">‏ببینید FlyWeb چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="3967822245660637423">بارگیری کامل شد</translation>
<translation id="562495843857641474">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، FlyWeb چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="5667414856761616811">‏درباره FlyWeb for Testing</translation>
<translation id="1152920704813762236">‏درباره ChromeOS</translation>
<translation id="4920206821838432969">‏وقتی‌که از سایتی بازدید می‌کنید، FlyWeb بخش مبهم‌سازی‌شده‌ای از نشانی وب را ازطریق سرور حافظ حریم خصوصی‌ای که نشانی IP شما را پنهان می‌کند به <ph name="BEGIN_LINK"/>مرور ایمن FlyWeb<ph name="END_LINK"/> ارسال می‌کند. اگر سایتی کار مشکوکی انجام دهد، نشانی‌های وب کامل و بخش‌هایی از محتوای صفحه نیز ارسال می‌شوند.</translation>
<translation id="4016217212818346953">با «مدیر گذرواژه» ایمن بمانید</translation>
<translation id="3703994572283698466">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS"/>محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS"/> ممکن شده است.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">‏پیوندها را از هر برنامه‌ای در FlyWeb باز کنید. همچنین برای دسترسی آسان، FlyWeb به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="504994999924593940">‏با گزارش <ph name="BEGIN_LINK"/>تنظیمات کنونی<ph name="END_LINK"/>، به بهتر شدن FlyWeb کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="4105099155797156500">‏رفتن به صفحه «درباره FlyWeb»</translation>
<translation id="7753744564324413106">‏با سفارشی‌سازی FlyWeb، ظاهر جدیدی به مرورگرتان بدهید</translation>
<translation id="3202882878525816493">‏سفارشی‌سازی FlyWeb</translation>
<translation id="4148957013307229264">درحال نصب…</translation>
<translation id="4890947375650921286">‏<ph name="PAGE_TITLE"/> - ورود به سیستم شبکه - FlyWeb</translation>
<translation id="6368928751841546993">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید. همچنین فهرست خواندن و سایر اطلاعات در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="4007949387571083162">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه FlyWeb را کشف کنید.</translation>
<translation id="4753212377237684548">‏برای دریافت این افزونه و موارد دیگر در همه رایانه‌هایتان، به سیستم FlyWeb وارد شوید</translation>
<translation id="4391959806766569994">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به همان نمایه FlyWeb بروید که قبلاً با <ph name="USER_EMAIL_ADDRESS"/> به سیستم وارد شده‌اید</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="2564888740660198776">‏داده‌های FlyWeb به این حساب مرتبط شود؟</translation>
<translation id="7337819873931851298">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که FlyWeb قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای FlyWeb را رد کنید.</translation>
<translation id="8391959103619318249">‏خروج از سیستم FlyWeb</translation>
<translation id="8514458758262040082">‏دریافت کمک برای FlyWeb</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="3393587701694585022">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر FlyWeb در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="271336227467646058">‏صادر کردن گذرواژه‌ها از FlyWeb</translation>
