<translation id="2745381939758295588">‏با «مرور ایمن پیشرفته» در FlyWeb برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="6707114110652917144">‏سایت خطرناک. ‫FlyWeb اعلان‌ها را برداشت.</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="4646732243247482236">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم FlyWeb وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب FlyWeb» شما ذخیره خواهد شد.</translation>
<translation id="2726680594710751908">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و FlyWeb را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="4086571337340463916">‏مهارت‌ها در FlyWeb</translation>
<translation id="2283803047247799269">این زبانه با «جستجوی تصویر» جستجو شود</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{‏‫FlyWeb توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫FlyWeb توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫FlyWeb توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2307973900865360088">‏نگه داشتن در Dock</translation>
<translation id="5067150284614317159">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در FlyWeb ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، FlyWeb ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
