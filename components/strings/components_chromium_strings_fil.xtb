<!DOCTYPE translationbundle>
<translationbundle lang="fil">
<translation id="130631256467250065">Magkakabisa ang iyong mga pagbabago sa susunod na i-restart ang iyong device.</translation>
<translation id="1555506416658437797">i-edit ang mga paraan ng pagbabayad.</translation>
<translation id="8359495463485001719">Hindi available ang pag-uulat ng crash sa FlyWeb.</translation>
<translation id="6338530717474923868">Isang ligtas na page ng FlyWeb ang tinitingnan mo</translation>
<translation id="5147169001159408844">Sinusubukan ng FlyWeb na baguhin ang mga setting para sa paglalagay ng mga paraan ng pagbabayad.</translation>
<translation id="5702992568540613683">Logo ng FlyWeb</translation>
<translation id="510342522494506803">Sinusubukan ng FlyWeb na i-edit ang mga paraan ng pagbabayad.</translation>
<translation id="8375862260948854624">Nagiging posible ang FlyWeb sa pamamagitan ng proyekto sa open source ng <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> at iba pang <ph name="BEGIN_LINK_OSS"/>open source na software<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Pumunta sa
          menu ng FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mga Setting ng LAN
          at alisin sa pagkakapili ang checkbox ng "Gumamit ng proxy server para sa iyong LAN."</translation>
<translation id="5040124620086808431">Na-block ng FlyWeb ang page na ito</translation>
<translation id="1953000035868532675">Pahintulutan ang FlyWeb na i-access ang network sa
          mga setting ng iyong firewall o antivirus.</translation>
<translation id="3442058224540562441">Pumunta sa
          menu ng FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          at tiyaking nakatakda sa "walang proxy" o "direkta" ang iyong configuration.</translation>
<translation id="585620188971323280">baguhin ang mga setting para sa paglalagay ng mga paraan ng pagbabayad.</translation>
<translation id="2681118099728446983">Nagiging posible rin ang FlyWeb sa pamamagitan ng iba pang <ph name="BEGIN_LINK_OSS"/>open source na software<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Magkakabisa ang iyong mga pagbabago sa susunod na ilunsad mong muli ang FlyWeb.</translation>
<translation id="1017070759373671177">Nagiging posible ang FlyWeb sa pamamagitan ng <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> open source project.</translation>
<translation id="7777112741998051633">Pumunta
          sa menu ng FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          at alisin sa pagkakapili ang "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Kung hindi nito malulutas ang isyu, inirerekomenda naming piliing muli ang opsyong ito
          para sa pinahusay na pagganap.</translation>
<translation id="8187289872471304532">Pumunta sa
          Applications &gt; System Preferences &gt; Network &gt; Advanced &gt; Proxies
          at alisin sa pagkakapili ang anumang mga napiling proxy.</translation>
<translation id="4699594416850504200">Isang secure na page ng FlyWeb na Pang-test ang tinitingnan mo</translation>
<translation id="6224789938625024797">Hindi nag-shut down nang tama ang FlyWeb.</translation>
