<translation id="4804111781678641302">FlyWeb ვერ ახერხებს განახლებების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="3542157007113577464">გსურთ FlyWeb-იდან გამოსვლა?</translation>
<translation id="6273793429163604305">მოემზადეთ...</translation>
<translation id="3794967601634523398">თქვენი FlyWeb პროფილის მორგება</translation>
<translation id="6475001900959697061">დაასათაურეთ თქვენი FlyWeb პროფილი</translation>
<translation id="4465156155012748592">FlyWeb-მა დაბლოკა <ph name="FILE_NAME"/>, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="5523868569707953059">FlyWeb იყენებს თქვენს კამერას.</translation>
<translation id="5914697581312472089">FlyWeb-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა</translation>
<translation id="6327105987658262776">განახლებები ხელმისაწვდომი არ არის.</translation>
<translation id="8226838065217375546">FlyWeb-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="6063700568539132984">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა FlyWeb ანგარიშით FlyWeb-ის გამოყენება.</translation>
<translation id="6890209090736444656">ნამდვილად გსურთ მოახდინოთ FlyWeb-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>ამ მონაცემთა გამოყენების წესი:<ph name="END_BOLD"/> FlyWeb-ს შეუძლია თქვენი ინტერესების პროგნოზირება. მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, FlyWeb-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით.</translation>
<translation id="6636986997730784876">FlyWeb არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ FlyWeb-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="2139300032719313227">გადატვირთეთ ChromeOS</translation>
<translation id="173462352822069427">მოგესალმებათ FlyWeb პროფილები</translation>
<translation id="1474676525193357364">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება FlyWeb-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="5777905264835557372">FlyWeb-ის დეინსტალაცია</translation>
<translation id="8852057261917278552">თქვენი ორგანიზაცია ხურავს FlyWeb-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="8592211619057897362">თითოეულ პროფილში ინახება საკუთარი FlyWeb ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="7489092380688543560">ახლა შეგიძლიათ გადართვა, პაროლები სხვა FlyWeb პროფილიდან რომ ნახოთ</translation>
<translation id="8243012192239086369">მართლწერის შეცდომების გასასწორებლად, FlyWeb თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს FlyWeb-ს უგზავნის</translation>
<translation id="3927263773110604886">FlyWeb-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6888846095017247017">თქვენი ცვლილებები გააქტიურდება FlyWeb-ის შემდეგი გაშვებისას.</translation>
<translation id="1886169834787876002">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად FlyWeb საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="7640394575797555654">საიტები, სავარაუდოდ, მოლოდინისამებრ იმუშავებს, თუმცა ისინი არ დაგიმახსოვრებთ, როცა FlyWeb-ის ყველა ფანჯარას დახურავთ</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="1363996462118479832">ChromeOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="4152880912192471857">FlyWeb საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2193001403607253406">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის FlyWeb-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ FlyWeb-ის ახალი ვერსია.</translation>
<translation id="3260179770078760650">მეხსიერების დამზოგმა ააჩქარა FlyWeb</translation>
<translation id="7728046102681268859">FlyWeb უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="7030752319019635064">თქვენს FlyWeb კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, შემდეგ კი ჩართეთ სინქრონიზაცია.</translation>
<translation id="1292831930742306370">FlyWeb გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="5612302437680103875">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ FlyWeb-ისთვის. ეს <ph name="EXTENSION_TYPE_PARAMETER"/> ვერ ჩაირთვება.</translation>
<translation id="1547295885616600893">ChromeOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS"/>ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6432682256389755533">FlyWeb გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="178055475944027272">FlyWeb-მა დაბლოკა ეს ფაილი, რადგან ის შეიცავს მავნე პროგრამას</translation>
<translation id="8852956515664182428">FlyWeb — <ph name="PAGE_TITLE"/></translation>
<translation id="5712993149989886097">Google Pay (FlyWeb-ში კოპირებული)</translation>
<translation id="4695676871328690599">FlyWeb-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME"/>“ შეიცავს მავნე პროგრამას</translation>
<translation id="76559364095325834">FlyWeb განახლდა, მაგრამ თქვენ მას არ იყენებდით მინიმუმ 30 დღის განმავლობაში.</translation>
<translation id="8524328905288851065">დაწყვილების გასაგრძელებლად FlyWeb საჭიროებს Bluetooth-ზე წვდომას. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="5929819793040985066">როცა ცდები ჩართულია, რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, FlyWeb-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="8806901087257994310">მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, FlyWeb-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით. FlyWeb-ს შეუძლია 3-მდე ინტერესის გაზიარება.</translation>
<translation id="2553796189989827248">სუსტი პაროლები ადვილი გამოსაცნობია, ამიტომ მიეცით საშუალება FlyWeb-ს, <ph name="BEGIN_LINK"/>თქვენთვის შექმნას და დაიმახსოვროს ძლიერი პაროლები<ph name="END_LINK"/>.</translation>
<translation id="1749753408579541220">ჩართვის შემთხვევაში, FlyWeb გამოათავისუფლებს მეხსიერებას არააქტიური ჩანართებიდან. აქტიურ ჩანართებსა და სხვა აპებს კომპიუტერის მეტი რესურსის გამოყენების საშუალება მიეცემა, რაც დააჩქარებს FlyWeb-საც. თქვენი არააქტიური ჩანართები ავტომატურად გააქტიურდება, როცა მათ დაუბრუნდებით.</translation>
<translation id="3453763134178591239">ChromeOS პირობები</translation>
<translation id="8545123476334328275">FlyWeb საჭიროებს თქვენს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7025789849649390912">ინსტალაცია შეწყდა.</translation>
<translation id="3945284827084409390">განაახლეთ FlyWeb</translation>
<translation id="7886270027101123253">თუ სურათს არ ექნება სასარგებლო აღწერილობა, FlyWeb შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება FlyWeb-ში.</translation>
<translation id="6017914745388312119">თქვენი ორგანიზაცია შლის FlyWeb-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="3283953248242339756">FlyWeb საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="4729674580260824908">FlyWeb-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="9165925035484501889">FlyWeb ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში.</translation>
<translation id="1678436729108859736">დავალებათა მენეჯერი - FlyWeb</translation>
<translation id="6135229048093148288">FlyWeb-ის მიერ პროგნოზირებული თქვენი ინტერესები</translation>
<translation id="7641415053133771502">რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, FlyWeb-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="2866611433272355726">მიმდინარეობს FlyWeb-ის განახლება</translation>
<translation id="5013690772358862887">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

FlyWeb ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="7339898014177206373">ახალი ფანჯარა</translation>
<translation id="1123144153876435088">თქვენი ვები, სანიშნეები და FlyWeb-ის სხვა მასალა არის აქ.</translation>
<translation id="6760192061736180746">თქვენი სისტემის ადმინისტრატორმა მოახდინა FlyWeb-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME"/>-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME"/>-ის გახსნა.</translation>
<translation id="3225813655660631613">FlyWeb პროფილები FlyWeb-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. მაგალითად, სამსახურებრივი და პირადი მონაცემების.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> — FlyWeb Dev</translation>
<translation id="3787225360375979559">FlyWeb საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2431618580332826398">FlyWeb-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="2154651873647244914">გსურთ FlyWeb-ის ხელახლა გაშვება?</translation>
<translation id="3137757192868162370">შეუძლებელია იმავე FlyWeb-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ FlyWeb და ხელახლა სცადეთ.</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb ხელახლა გაეშვება 1 წუთში}other{FlyWeb ხელახლა გაეშვება # წუთში}}</translation>
<translation id="2706045239797506060">მონაცემების FlyWeb-იდანაც გასუფთავება (<ph name="URL"/>)</translation>
<translation id="5426732664223965459">FlyWeb-ს შეუძლია თქვენი ინტერესების პროგნოზირება. მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, FlyWeb-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ინსტალატორი</translation>
<translation id="3067364763515000789">FlyWeb იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="1381291360713116383">FlyWeb გაუმჯობესდა</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="481435825250648341">ამ ფუნქციების შესახებ დამატებითი ინფორმაციის მიღება შეგიძლიათ FlyWeb-ის პარამეტრებიდან.</translation>
<translation id="3079800650903360762">FlyWeb მუშაობს ახალ ფუნქციებზე, რომელთა მეშვეობითაც საიტებს იგივე ფუნქციონალი ექნება თქვენი ნაკლები მონაცემის გამოყენებით.</translation>
<translation id="2230101319599356673">FlyWeb არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="3243257760331619874">მოახდინეთ FlyWeb-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="1549877678317463759">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით FlyWeb-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="134973275687829726">ააჩქარეთ FlyWeb-ის მუშაობა</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> — FlyWeb Canary</translation>
<translation id="8463540467315366872">FlyWeb პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="4766381896251401675">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად FlyWeb თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="8611872055947278722">FlyWeb ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS"/> წამი</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>თქვენი მონაცემების მართვის ხერხები:<ph name="END_BOLD"/> თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. სურვილისამებრ, შეგიძლიათ წაშალოთ ინტერესები, რომლებიც არ გსურთ, FlyWeb-მა რომ გაითვალისწინოს.</translation>
<translation id="3096730275883527801">თქვენ შესული ხართ FlyWeb-ში როგორც <ph name="USER_EMAIL_ADDRESS"/>. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="9017338699075596174">ეს FlyWeb-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="5944585442866020176">FlyWeb-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="3263664073045388929">FlyWeb საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="5334309298019785904">ChromeOS-ის საშუალებით ვერ მოხერხდა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენს დომენზე სინქრონიზაცია მიუწვდომელია.</translation>
<translation id="813913629614996137">მიმდინარეობს ინიცირება…</translation>
<translation id="1597323875619800374">FlyWeb-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8455485678130879158">FlyWeb-მა დაბლოკა ეს ფაილი, რადგან ამ ტიპის ფაილი სახიფათოა</translation>
<translation id="6756872644564483342">თუ სურათს არ ექნება სასარგებლო აღწერილობა, FlyWeb შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება FlyWeb-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="5792785787074426346">FlyWeb ვერ ახერხებს თქვენი პაროლების შემოწმებას, რადგან შესული არ ხართ</translation>
<translation id="6627585369674499881">FlyWeb-მა დაბლოკა ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="208266011144024011">თქვენი ორგანიზაცია ხურავს FlyWeb-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება.</translation>
