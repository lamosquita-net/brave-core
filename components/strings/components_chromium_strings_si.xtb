<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="130631256467250065">ඔබේ උපාංගය නැවත අරඹන විට ඔබේ වෙනස්කම් බල පැවැත්වෙනු ඇත.</translation>
<translation id="1555506416658437797">ගෙවීමේ ක්‍රම සංස්කරණය කරන්න.</translation>
<translation id="8359495463485001719">අනතුරු වාර්තාකරණය  Braveහි නැත.</translation>
<translation id="6338530717474923868">ඔබ ආරක්ෂිත FlyWeb පිටුවක් බලමින් සිටී</translation>
<translation id="5147169001159408844">FlyWeb ගෙවීම් ක්‍රම පිරවීම සඳහා සැකසීම් වෙනස් කිරීමට උත්සාහ දරයි.</translation>
<translation id="5702992568540613683">FlyWeb ලාංඡනය</translation>
<translation id="510342522494506803">FlyWeb ගෙවීම් ක්‍රම සංස්කරණය කිරීමට උත්සාහ කරයි.</translation>
<translation id="8375862260948854624">FlyWeb <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> විවෘත මූලාශ්‍ර ව්‍යාපෘතිය සහ වෙනත් <ph name="BEGIN_LINK_OSS"/>විවෘත මූලාශ්‍ර මෘදුකාංග<ph name="END_LINK_OSS"/> මගින් නිපදවීමට හැකි විය.</translation>
<translation id="4281953335231207224">ඒ සඳහා 
          FlyWeb මෙනුව &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN සැකසුම්
          "ඔබගේ LAN සඳහා ප්‍රොක්සි සේවාදායකයක් භාවිත කරන්න" සලකුණු කොටුව ඉවත් කරන්න.</translation>
<translation id="5040124620086808431">මෙම පිටුව FlyWeb මගින් අවහිර කර ඇත</translation>
<translation id="1953000035868532675">ඔබගේ ෆයර් වෝල හා ප්‍රතිවයිරස සැකසීම් තුළ FlyWeb හට ජාලයට පිවිසීමට
          අවසර දෙන්න.</translation>
<translation id="3442058224540562441">FlyWeb මෙනුව වෙත ගොස්
          &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ඔබේ වින්‍යාසකරණය "no proxy" හෝ "direct" ලෙස ඇති බව තහවුරු කරගන්න.</translation>
<translation id="585620188971323280">ගෙවීම් ක්‍රම පිරවීම සඳහා සැකසීම් වෙනස් කරන්න.</translation>
<translation id="2681118099728446983">FlyWeb හට වෙනත් <ph name="BEGIN_LINK_OSS"/>විවෘත මූලාශ්‍ර මෘදුකාංග<ph name="END_LINK_OSS"/> මගින් ද හැකියාව සලසා ඇත</translation>
<translation id="6888846095017247017">නැවත FlyWeb ආරම්බ කරන විට වෙනස්කම් ක්‍රියාත්මක වනු ඇත.</translation>
<translation id="1017070759373671177">FlyWeb හට <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> විවෘත මූලාශ්‍ර මෘදුකාංගය මගින් හැකියාව සලසා ඇත</translation>
<translation id="7777112741998051633">මුලින්ම
        FlyWeb මෙනුව වෙත ගොස්&gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        තෝරා "<ph name="NO_PREFETCH_DESCRIPTION"/>." තේරීම ඉවත් කරන්න
        මෙයින් නිරාකරණය නොවුන හොත්, වඩා දියුණු ක්‍රියාකාරීත්වයක් සඳහා මෙම අභිප්‍රේතය නැවත තෝරන්න.</translation>
<translation id="8187289872471304532">යෙදුම් &gt; පද්ධති මනාප &gt; ජාලය &gt; උසස් කළ &gt; ප්‍රොක්සි වෙත ගොස්
          තෝරා ඇති ඕනෑම ප්‍රොක්සියක් නොතෝරන්න.</translation>
<translation id="4699594416850504200">ඔබ පරීක්ෂා කිරීම සඳහා සුරක්ෂිත FlyWeb පිටුවක් බලයි</translation>
<translation id="6224789938625024797">FlyWeb නිවැරදිව වැසීමට නොහැකි විය.</translation>
</translationbundle>