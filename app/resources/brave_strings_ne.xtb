<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1026101648481255140">इन्स्टल गर्ने प्रक्रिया सुचारु गर्नुहोस्</translation>
<translation id="7099479769133613710">&amp;ChromeOS अपडेट गर्न यसलाई रिलन्च गर्नुहोस्</translation>
<translation id="291426170030461697">FlyWeb तपाईंलाई यो एक्स्टेन्सनको समीक्षा गर्न सिफारिस गर्छ</translation>
<translation id="1549005488226693697">कुनै साइटले आफ्नो पेजमा भएका लिंकहरू गोप्य तरिकाले प्रिलोड गर्न लगाएका खण्डमा FlyWeb ले FlyWeb का सर्भरहरू प्रयोग गर्छ। यसो गर्दा प्रिलोड गरिएको साइटमा भएको तपाईंको पहिचान खुलाउने जानकारी लुकाइन्छ तर FlyWeb ले कुन कुन साइट प्रिलोड गरिन्छन् भन्ने कुरा सिक्छ।</translation>
<translation id="1065672644894730302">तपाइँका प्राथमिकातहरू पढ्न सकिदैन।

केही सुविधाहरू अनुपलब्ध हुन सक्छन् र प्राथमिकताहरूमा परिवर्तनहरू बचत हुने छैनन्।</translation>
<translation id="8908267645832965492">तपाईंका अभिभावकले FlyWeb का हकमा "साइट, एप तथा एक्सटेन्सनसम्बन्धी अनुमति" अफ गर्नुभएको छ</translation>
<translation id="5557633153169217776">नजिकैका डिभाइसहरू पत्ता लगाउन र प्रयोग गर्न FlyWeb लाई तपाईंको लोकल नेटवर्कको एक्सेस दिनु पर्ने हुन्छ</translation>
<translation id="6441390163669415879">FlyWeb को कुनै निश्चित सुविधा वा एक्स्टेन्सन खोज्न एड्रेस बारमा त्यसको सर्टकट टाइप गर्नुहोस् अनि आफूले चयन गरेको किबोर्ड की थिच्नुहोस्</translation>
<translation id="9001750423919983557">सिस्टम ट्रेमा FlyWeb प्रयोग गरी खोज्ने सुविधा देखाउनुहोस् र किबोर्ड सर्टकट अन गर्नुहोस्</translation>
<translation id="1368460307421081773">FlyWeb तपाईंका पासवर्डहरू निर्यात गर्न चाहन्छ। यसो गर्ने अनुमति दिन Windows को आफ्नो पासवर्ड टाइप गर्नुहोस्‌।</translation>
<translation id="112640046208448578">वस्तु वा ठाउँहरू पहिचान गर्नुहोस् र टेक्स्ट कपी वा अनुवाद गर्नुहोस्। तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा प्रयोग गर्दा यो पेजको एउटा स्क्रिनसट सर्भरमा पठाइन्छ। <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb तपाईंको डिफल्ट ब्राउजर हो</translation>
<translation id="4556715463645168547">तपाईंका पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK"/>FlyWeb मा साइन इन गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="2076135703183650206">FlyWeb मेनुमा क्लिक गर्नुहोस्</translation>
<translation id="1157985233335035034">हालसालै चयन गरिएका भाषाहरू</translation>
<translation id="1184145431117212167">तपाईंको डिभाइसमा भएको Windows को संस्करणमा नचल्ने भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="4380351562011537903">FlyWeb का बारेमा</translation>
<translation id="853148447909557566">आफ्नो फोनमा FlyWeb प्रयोग गरी मूल्य ट्र्याकिङसम्बन्धी अलर्टहरू प्राप्त गर्नुहोस्</translation>
<translation id="1203500561924088507">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="1232234696885483911">तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा खोल्दा PDF सहित पेजको शीर्षक, URL र कन्टेन्ट स्वतः सर्भरमा पठाइने छन्। <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">तपाईं साइन इन अवस्थामा भएका बेला आफ्नो FlyWeb खातामा सेभ गरिएका पासवर्ड तथा अन्य कुराहरू FlyWeb मा प्रयोग गर्न सक्नुहुन्छ। यो कुरा परिवर्तन गर्न “FlyWeb मा भएको तपाईंको खाता” मा जानुहोस्।</translation>
<translation id="7614508617663739435">Mac को मेनु बारमा FlyWeb मा उपलब्ध Gemini देखाउनुहोस्</translation>
<translation id="832555967476614730">FlyWeb मा उपलब्ध Gemini मा स्क्रिनको कुनै भाग चयन गर्न किबोर्ड सर्टकट प्रयोग गर्नुहोस्।</translation>
<translation id="4750836834956739196">यो ट्याब निष्क्रिय हुँदा FlyWeb छिटो चल्ने बनाइराख्न मेमोरी खाली गरिएको थियो। तपाईं यो साइटलाई जुनसुकै बेला सक्रिय राखिराख्ने विकल्प छनौट गर्न सक्नुहुन्छ।</translation>
<translation id="3190759351483708314">यो फाइल खतरनाक भएकाले FlyWeb ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/> मार्फत FlyWeb का Gmail वा YouTube लगायतका सेवाहरूमा साइन इन गर्दा तपाईं उही खातामार्फत FlyWeb मा स्वतः साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="7142135954326264349">आफ्नो फोनमा FlyWeb इन्स्टल गर्नुहोस्</translation>
<translation id="1290883685122687410">सेटअप गर्ने क्रममा निम्न त्रुटि भयो: <ph name="METAINSTALLER_EXIT_CODE"/>। <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">FlyWeb मा आफ्नो नयाँ प्रोफाइल सेटअप गर्नुहोस्</translation>
<translation id="5252737639504553444">FlyWeb मा उपलब्ध Gemini प्रयोग गरी हेर्नुहोस्</translation>
<translation id="609743863669742325">FlyWeb सँग ब्लुटुथ डिभाइसहरू खोज्नका निम्ति 
 ब्लुटुथको एक्सेस हुनु पर्छ। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">आफ्नो फोनमा FlyWeb मा साइन इन गर्नुहोस्</translation>
<translation id="1330562121671411446">भाषा पहिचान गर्नुहोस्</translation>
<translation id="2276527911011636666">यो जानकारी FlyWeb बाट पनि मेटाउनुहोस् (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">पिन गरियो! तपाईं टुलबारमा भएको नयाँ बटन थिचेर फोटो प्रयोग गरी खोज्ने सुविधा फेरि एक्सेस गर्न सक्नुहुन्छ</translation>
<translation id="1383876407941801731">खोज्नुहोस्</translation>
<translation id="1045149878186896649">जुनसुकै बेला जहाँसुकैबाट ब्राउज गर्न FlyWeb एप प्रयोग गर्नुहोस्</translation>
<translation id="141901961143729572">आफ्ना विचार व्यक्त गर्नुहोस्</translation>
<translation id="2758515779140515865">आफ्नो विन्डो सेयर गर्न सिस्टम सेटिङमा गई FlyWeb लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्।</translation>
<translation id="4713192356155907986">FlyWeb for Testing का सम्बन्धमा मद्दत प्राप्त गर्नुहोस्</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> मा सेभ गरिएका आफ्ना जानकारीलगायतका कुराहरू प्राप्त गर्न FlyWeb मा साइन इन गर्नुहोस्</translation>
<translation id="1497802159252041924">इन्स्टल गर्ने क्रममा त्रुटि भयो: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">यो पेज सुरक्षित गरिएको छ</translation>
<translation id="8962360511570172">FlyWeb को ट्याब सेयर गर्नुहोस्</translation>
<translation id="2941487459666781243">FlyWeb मा साइन इन गर्नुहोस्</translation>
<translation id="1547469039832541117">हाइलाइट गरिएको कार्य अन्त्य गर्छ।</translation>
<translation id="3182893868355533457">FlyWeb पिन गर्नुहोस्</translation>
<translation id="852852907317361085">FlyWeb का सुरक्षासम्बन्धी टुलहरू</translation>
<translation id="481155564361715417">FlyWeb तपाईंको पासवर्ड म्यानेजरमा भएको जानकारी मेटाउन चाहन्छ। यसो गर्ने अनुमति दिन Windows को पासवर्ड टाइप गर्नुहोस्।</translation>
<translation id="2846999307505917298">आफ्नो फोनमा FlyWeb एप इन्स्टल गरी FlyWeb का उत्कृष्ट सुविधाहरू प्राप्त गर्नुहोस्</translation>
<translation id="3961251277542681013">FlyWeb मा भएका गोपनीयता र सुरक्षासम्बन्धी मुख्य नियन्त्रण सुविधाहरूको समीक्षा गर्नुहोस्</translation>
<translation id="1640672724030957280">डाउनलोड गरिँदै छ...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME"/>, <ph name="USER_EMAIL"/> का रूपमा साइन इन गरिएको छ, सदस्यता। खाताको मेनु खोल्नुहोस्</translation>
<translation id="7625232007557474355">तपाईं म्यासेज, डकुमेन्ट तथा अन्य एपहरूमा भएका लिंकमा क्लिक गरी जुनसुकै बेला FlyWeb प्रयोग गर्न सक्नुहुन्छ। यसलाई तपाईंको टास्कबारमा पनि पिन गरिने छ।</translation>
<translation id="1709772298389099340">यो सेवाले <ph name="BROWSER_NAME"/> का खास विशेषाधिकारहरू उपलब्ध गराउँछ।</translation>
<translation id="5695205873161614119">FlyWeb ले चाँडै नै ब्राउजिङ डेटा मेटाउने छ</translation>
<translation id="8939535770474283898">FlyWeb ले वेबपेजहरू लोड गर्न HTTPS प्रयोग गर्ने प्रयास गर्ने छ</translation>
<translation id="2581127533455294937">FlyWeb सम्बन्धी डेटा हटाइयो</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/> पछि रिस्टार्ट हुने छ</translation>
<translation id="6903827847227122616">HTTPS उपलब्ध नहुँदा FlyWeb ले तपाईंलाई चेतावनी नदिइकनै असुरक्षित कनेक्सन प्रयोग गर्ने छ</translation>
<translation id="307170399141486420">FlyWeb पृष्ठभूमिमा चलाउछन्</translation>
<translation id="5006568136491721884">FlyWeb तुरुन्तै एक्सेस गर्न सकियोस् भन्नाका लागि यसलाई आफ्नो टास्कबारमा पिन गर्न Windows को नोटिफिकेसनमा देखिएको <ph name="BEGIN_BOLD"/>अँ<ph name="END_BOLD"/> मा क्लिक गर्नुहोस्।</translation>
<translation id="2473319786107120819">FlyWeb पुनर्स्थापित गर्नुहोस्</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> प्रयास गर्दै छ</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ले पहिलेदेखि नै साइन इन गर्नुभएको छ। छुट्टै ब्राउजर प्रयोग गर्न <ph name="USER_EMAIL_ADDRESS"/> मार्फत आफ्नै प्रोफाइल प्रयोग गरी FlyWeb मा साइन इन गर्नुहोस्। तपाईं <ph name="DEVICE"/> बाट आफ्ना एक्स्टेन्सन र अन्य कुराहरू पनि प्राप्त गर्नु हुने छ।</translation>
<translation id="3547283483106013256">तपाईंले अर्को पटक आफ्नो <ph name="DEVICE_TYPE"/> मा FlyWeb खोल्दा तपाईंलाई FlyWeb पासवर्ड म्यानेजर प्रयोग गर्ने प्रम्प्ट देखाइने छ।</translation>
<translation id="1838374766361614909">खोजी खाली गर्नुहोस्</translation>
<translation id="3403116471618205223">तपाईंको FlyWeb खातामा ब्राउजिङ डेटा यथावत् राखी यो डिभाइसबाट मात्र ब्राउजिङ डेटा मेटाउन <ph name="BEGIN_LINK"/>FlyWeb बाट साइन आउट गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="1909454687815628855">जुनसुकै बेला जहाँसुकैबाट नयाँ ट्याब समूहहरू खोल्न वा बनाउन आफ्नो फोनमा FlyWeb डाउनलोड गर्नुहोस्।</translation>
<translation id="3285741355512747610">तपाईं साइन इन गरिएका आफ्ना FlyWeb खाताहरू व्यवस्थापन गर्न सक्नुहुन्छ। तपाईंका FlyWeb खाताहरू FlyWeb ब्राउजर, Play स्टोर, Gmail र अन्य एपहरूमा प्रयोग गरिन्छन्। तपाईं परिवारका सदस्य जस्ता अरू कसैको खाता थप्न चाहनुहुन्छ भने उहाँको खाता थप्नुको साटो उहाँलाई नयाँ व्यक्तिका रूपमा आफ्नो <ph name="DEVICE_TYPE"/> मा सामेल गराउनुहोस्। <ph name="LINK_BEGIN"/>थप जान्नुहोस्<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">फोटो प्रयोग गरी खोज्ने सुविधामार्फत खोज्नुहोस्</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> ले पहिलेदेखि नै साइन इन गर्नुभएको छ। छुट्टै ब्राउजर प्रयोग गर्न <ph name="USER_EMAIL_ADDRESS"/> मार्फत आफ्नै प्रोफाइल प्रयोग गरी FlyWeb मा साइन इन गर्नुहोस्। तपाईं <ph name="DEVICE"/> बाट आफ्ना बुकमार्क र अन्य विवरणहरू पनि प्राप्त गर्नु हुने छ।</translation>
<translation id="1880677175115548835">टेक्स्ट म्यासेज चयन गर्नुहोस्</translation>
<translation id="4824940465467423308">तपाईंले व्यवस्थित खातासँगै साइन इन गरि यसको व्यवस्थापकलाई तपाईंको FlyWeb प्रोफाइल माथि नियन्त्रण दिइरहनुभएको छ। तपाईंको FlyWeb डाटा, जस्तै तपाईंका एप्स, बुकमार्कहरू, इतिहास, पासवर्डहरू, र अन्य सेटिङहरू <ph name="USER_NAME"/> मा स्थायी रूपमा बाँधिनेछन्। तपाईं यस डाटालाई गूगल खाता ड्यासबोर्ड मार्फत मेटाउन सक्षम हुनुहुनेछ, तर तपाईं यस खातालाई अर्को खातामा संलग्न गर्न सक्षम हुनुहुनेछैन। तपाईंले आफ्नो विद्यमान FlyWeb डाटालाई अलग राख्न वैकल्पिक रूपमा नयाँ प्रोफाइल सिर्जना गर्न सक्नुहुन्छ। <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb ले ब्याकग्राउन्डमा हुने गतिविधि र निर्वाध स्क्रोलिङ तथा भिडियोको फ्रेम रेटलगायतका भिजुअल इफेक्टहरू सीमित पारेर ब्याट्रीको पावर जोगाउँछ। <ph name="BEGIN_LINK"/>इनर्जी सेभरका बारेमा थप जान्नुहोस्<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb अपडेटर सर्भिस</translation>
<translation id="7390382558747224642">यसलाई निष्क्रिय पारेर, तपाईं FlyWeb मा साइन इन नगरिकनै Gmail जस्ता FlyWeb का साइटहरूमा साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="5714085538350759767">FlyWeb ले कुनै प्रतिक्रिया जनाइरहेको छैन। अहिले नै पुन: लन्च गर्ने?</translation>
<translation id="5866699689358760578">तपाईंको सङ्गठन <ph name="MANAGER"/> को नीतिअनुसार तपाईंले FlyWeb मा साइन इन गर्नु पर्ने हुन्छ</translation>
<translation id="4035053306113201399">यो अपडेट लागू गर्न ChromeOS रिस्टार्ट गर्नु पर्ने हुन्छ।</translation>
