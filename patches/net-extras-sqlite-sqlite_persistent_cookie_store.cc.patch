diff --git a/net/extras/sqlite/sqlite_persistent_cookie_store.cc b/net/extras/sqlite/sqlite_persistent_cookie_store.cc
index 8bdfeca14640ef6820df6f22451ff0f77fcc8393..29b71fe8460b53b12967ac9fe19144b41cf90fa1 100644
--- a/net/extras/sqlite/sqlite_persistent_cookie_store.cc
+++ b/net/extras/sqlite/sqlite_persistent_cookie_store.cc
@@ -1046,6 +1046,23 @@ bool SQLitePersistentCookieStore::Backend::MakeCookiesFromSQLStatement(
       bool decrypt_ok = crypto_->DecryptString(encrypted_value, &value);
       if (!decrypt_ok) {
         RecordCookieLoadProblem(CookieLoadProblem::kDecryptFailed);
+        // FlyWeb: an unreadable `fw1` value (key item deleted, keychain
+        // denied) loses only that cookie: its row is deleted like a
+        // non-canonical one, so CookieMonster and the database stay in sync.
+        // An unreadable value of any other format still drops the whole
+        // eTLD+1, as upstream.
+        if (base::StartsWith(encrypted_value, "fw1")) {
+          non_canonical_cookies_to_delete.push_back({
+              .name = statement.ColumnString(3),
+              .host_key = domain,
+              .top_frame_site_key = statement.ColumnString(2),
+              .path = statement.ColumnString(5),
+              .source_scheme = statement.ColumnInt(15),
+              .source_port = statement.ColumnInt(16),
+              .has_cross_site_ancestor = statement.ColumnBool(19),
+          });
+          continue;
+        }
         ok = false;
         continue;
       }
