<translation id="348384176991400026">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს FlyWeb-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს FlyWeb-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება.}}</translation>
<translation id="4955869506208896934">სინქრონიზაციის დასაწყებად, განაახლეთ FlyWeb</translation>
<translation id="5990360079535151574">ხელსაწყოთა ზოლზე არსებული ღილაკით „კონტექსტური ამოცანები“ შეგიძლიათ, ნებისმიერ დროს დაუბრუნდეთ ამ ფუნქციას და დასვათ კითხვები ინტერნეტში ძიების პარალელურად</translation>
<translation id="6003112304606738118">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="HOURS"/> საათი</translation>
<translation id="6009821354356307391">გაგზავნეთ შემდგომი მოთხოვნა</translation>
<translation id="6040143037577758943">დახურვა</translation>
<translation id="4530644097272078700">მეტად გამოიყენეთ ონლაინ შოპინგის შესაძლებლობები, როდესაც სარგებლობთ FlyWeb აპით თქვენს <ph name="DEVICE_TYPE"/>-ზე</translation>
<translation id="619330138913595431">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება FlyWeb-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="8714139918792771260">FlyWeb-ში &amp;გახსნა</translation>
<translation id="6069027071882229820">სურათად კოპირება</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/> დაემატა FlyWeb-ს</translation>
<translation id="5880307616068888895">მოირგეთ და გააკონტროლეთ FlyWeb. ხელმისაწვდომია განახლება.</translation>
<translation id="1429530657225981960">ჩართული • FlyWeb ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="8056369489402655495">თქვენი ანგარიში FlyWeb-ში</translation>
<translation id="1683225514126450592">გაფართოებისთვის FlyWeb-ის ხელსაწყოთა ზოლში წვდომის მოთხოვნების ჩვენების დაშვება</translation>
<translation id="4809579265564854985">FlyWeb-მა დაბლოკა <ph name="FILE_NAME"/>, რადგან ის სახიფათოა.</translation>
<translation id="1773252983747911987">FlyWeb მალე დაიხურება, ხოლო მონაცემები წაიშლება</translation>
<translation id="1686760912855738719">აქ შეგიძლიათ FlyWeb პროფილებს შორის გადართვა</translation>
<translation id="5461795497268691356">ქუქი-ჩანაწერების დაშვების შემთხვევაში, FlyWeb-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="6165508094623778733">შეიტყვეთ მეტი</translation>
<translation id="1292852397592425449">გაასუფთავეთ FlyWeb-ის მონაცემები თქვენს ანგარიშში</translation>
<translation id="7031783851441272920">ეს ფაილი, შესაძლოა, სახიფათო იყოს<ph name="LINE_BREAK"/>FlyWeb-ს შეუძლია, თქვენ ნაცვლად შეამოწმოს ეს ჩამოტვირთვა, თუ პაროლს მიუთითებთ. ფაილის შესახებ ინფორმაცია ეგზავნება Google Safe Browsing-ს, თუმცა ფაილების შიგთავსი და პაროლი რჩება თქვენს მოწყობილობაზე.</translation>
<translation id="6182736845697986886">ინსტალაცია ვერ მოხერხდა განახლების სერვერის შიდა შეცდომის გამო.</translation>
<translation id="4403968929742079769">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME"/>-ზე შესული ხართ FlyWeb-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="8345188246355148375">მოიძიეთ ინფორმაცია და დასვით კითხვები ნებისმიერი ადგილიდან, მაშინაც კი, როცა FlyWeb ჩაკეცილია. საშუალებას აძლევს FlyWeb-ს, იმუშაოს ფონურ რეჟიმში.</translation>
<translation id="1855179706668101462">ამ კომპიუტერს უკვე აქვს FlyWeb.-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ FlyWeb-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb ახლა ხელახლა გაეშვება}=1{FlyWeb ხელახლა გაეშვება 1 წამში}other{FlyWeb ხელახლა გაეშვება # წამში}}</translation>
<translation id="2586408713760853791">ფაილების ჩამოსატვირთად FlyWeb საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="1603558835003845196">შეამოწმებს URL-ების თანხვედრას FlyWeb-ში შენახულ არაუსაფრთხო საიტების სიასთან</translation>
<translation id="5751080530525677552">FlyWeb გახდეს ნაგულისხმევი ბრაუზერი</translation>
<translation id="6248988683584659830">ძიების პარამეტრები</translation>
<translation id="6342238100521499844">მიიღეთ FlyWeb-ის უსაფრთხოების საუკეთესო ფუნქციები ნებისმიერი ადგილიდან, FlyWeb აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="3542157007113577464">გსურთ FlyWeb-იდან გამოსვლა?</translation>
<translation id="2166321493116256664">ეს ჩანართები დამატებით რესურსებს მოიხმარს. ეფექტურობის გაზრდის მიზნით, ნება დართეთ FlyWeb-ს, ჩანართები უმოქმედო რეჟიმში გადაიტანოს.</translation>
<translation id="3794967601634523398">თქვენი FlyWeb პროფილის მორგება</translation>
<translation id="6475001900959697061">დაასათაურეთ თქვენი FlyWeb პროფილი</translation>
<translation id="6356094940346377065">გაფართოების გამოსაყენებლად შედით FlyWeb-ში</translation>
<translation id="4465156155012748592">FlyWeb-მა დაბლოკა <ph name="FILE_NAME"/>, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="5523868569707953059">FlyWeb იყენებს თქვენს კამერას.</translation>
<translation id="8226838065217375546">FlyWeb-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="6063700568539132984">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა FlyWeb ანგარიშით FlyWeb-ის გამოყენება.</translation>
<translation id="5622088198573179705">დააყენეთ FlyWeb ნაგულისხმევ ბრაუზერად და მიიღეთ მარტივი წვდომა იმ ფუნქციებზე, რომლებსაც იცნობთ, გიყვართ და ენდობით.</translation>
<translation id="4709797814274745581">FlyWeb-ის მალსახმობი</translation>
<translation id="6595693843242836271">FlyWeb-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="6890209090736444656">ნამდვილად გსურთ მოახდინოთ FlyWeb-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6388799252195623474">დახმარება მჭირდება</translation>
<translation id="8407518452288816185">გასაგრძელებლად შედით FlyWeb-ში ანგარიშით <ph name="EMAIL"/>. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="2104550252781001709">FlyWeb-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="6636986997730784876">FlyWeb არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ FlyWeb-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="4359872290500912570">დაადასტურეთ ვინაობა, რომ თქვენს FlyWeb ანგარიშში გამოიყენოთ და შეინახოთ FlyWeb-ის მონაცემები</translation>
<translation id="3141715584864891679">FlyWeb უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="2139300032719313227">გადატვირთეთ ChromeOS</translation>
<translation id="7560906925528428585">FlyWeb წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="5806916401157869650">ჩამოტვირთეთ FlyWeb თქვენს ტელეფონში, რომ თვალი ადევნოთ ფასებს და მიიღოთ გაფრთხილებები, როცა რომელიმე საიტზე ფასი დაიკლებს</translation>
<translation id="2970877059928503461">გამორთული • FlyWeb ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="173462352822069427">მოგესალმებათ FlyWeb პროფილები</translation>
<translation id="8914008746092110409">შემდეგ ჯერზე, როცა გახსნით FlyWeb-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას ჩანართების ჯგუფების გამოყენების შესახებ.</translation>
<translation id="3484308111967198595">ანგარიშის ამოშლა FlyWeb-იდან</translation>
<translation id="1474676525193357364">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება FlyWeb-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="5777905264835557372">FlyWeb-ის დეინსტალაცია</translation>
<translation id="764623543427374554">მალსახმობები იხსნება FlyWeb-ში</translation>
<translation id="8852057261917278552">თქვენი ორგანიზაცია ხურავს FlyWeb-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="8592211619057897362">თითოეულ პროფილში ინახება საკუთარი FlyWeb ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6556755379298048869">მოიძიეთ კლავიატურის მალსახმობით.</translation>
<translation id="4273595998837775033">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK"/>როგორ ინარჩუნებს FlyWeb თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK"/></translation>
<translation id="654107331777480705">ამ პარამეტრის ცვლილება ამოქმედდება FlyWeb-ის გადატვირთვისთანავე.</translation>
<translation id="3594828538355548672">მართეთ თქვენი გაფართოებები FlyWeb-ის მთავარ მენიუში „გაფართოებებზე“ დაწკაპუნებით.</translation>
<translation id="7489092380688543560">ახლა შეგიძლიათ გადართვა, პაროლები სხვა FlyWeb პროფილიდან რომ ნახოთ</translation>
<translation id="472958395762114471">გამოიყენეთ FlyWeb აპი, რომ საუკეთესო AI ხელსაწყოები თან იქონიოთ</translation>
<translation id="8243012192239086369">მართლწერის შეცდომების გასასწორებლად, FlyWeb თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს FlyWeb-ს უგზავნის</translation>
<translation id="3927263773110604886">FlyWeb-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="6888846095017247017">თქვენი ცვლილებები გააქტიურდება FlyWeb-ის შემდეგი გაშვებისას.</translation>
<translation id="4481788155537463533">FlyWeb ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="1116311888485102603">გააგრძელეთ იქიდან, სადაც გაჩერდით: FlyWeb-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="1886169834787876002">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად FlyWeb საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="7570986009744020649">თუ თქვენს სანიშნეებს FlyWeb ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს FlyWeb-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="1363996462118479832">ChromeOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="5743696427773796626">ამ აპის მონაცემების FlyWeb-იდან ამოშლა</translation>
<translation id="4152880912192471857">FlyWeb საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="2193001403607253406">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის FlyWeb-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ FlyWeb-ის ახალი ვერსია.</translation>
<translation id="5528558621229392814">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ FlyWeb როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ FlyWeb სერვისებს</translation>
<translation id="7728046102681268859">FlyWeb უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="2006421382007321898">შედით FlyWeb-ში, რომ მიიღოთ სანიშნეები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს FlyWeb ანგარიშში.</translation>
<translation id="4328426102261301637">აჩქარებს FlyWeb-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ FlyWeb ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="207175655966839154">{count,plural, =1{თქვენი FlyWeb-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს FlyWeb ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები (1 ერთეული) წაიშლება.}other{თქვენი FlyWeb-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს FlyWeb ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები ({count} ერთეული) წაიშლება.}}</translation>
<translation id="1292831930742306370">FlyWeb გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="1547295885616600893">ChromeOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS"/>ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">თარგმნა</translation>
<translation id="6432682256389755533">FlyWeb გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME"/> დაშვებულთა სიაშია.</translation>
<translation id="8852956515664182428">FlyWeb — <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">შეეხეთ გასაგრძელებლად</translation>
<translation id="6862030660799253820">სურათების ძიების მეშვეობით ამ სურათის ძიება</translation>
<translation id="6869568587896659271">ვებსაიტებზე წვდომა პირდაპირ მისამართთა ზოლის ქვემოდან</translation>
<translation id="4695676871328690599">FlyWeb-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME"/>“ შეიცავს მავნე პროგრამას</translation>
<translation id="6877155553248388166">ძიების არეალის ქვედა მარჯვენა კუთხე: მარჯვნივ <ph name="RIGHT"/>%, ქვემოთ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">კოპირება</translation>
<translation id="6898028264630240901">შეგიძლიათ ჩაამაგროთ კონტექსტური ამოცანები, რათა დასვათ კითხვები დათვალიერებისას</translation>
<translation id="8416061171168102237">დააყენეთ FlyWeb ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის თქვენს ამოცანათა ზოლში</translation>
<translation id="3503126745419877918">FlyWeb პროფილების &amp;მართვა</translation>
<translation id="4397299252625349918">ეს მოქმედება:
          <ph name="LINE_BREAKS"/>
            • გადააყენებს თქვენს გაშვების გვერდს, ახალი ჩანართის გვერდს, საძიებო სისტემას და ჩამაგრებულ ჩანართებს
            <ph name="LINE_BREAK"/>
            • გათიშავს გაფართოებებს
            <ph name="LINE_BREAK"/>
            • წაშლის ქუქი-ჩანაწერებს და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAK"/>
            • გადააყენებს FlyWeb-ის მალსახმობებს
            <ph name="LINE_BREAKS"/>
            სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="2640214066670118583">თქვენ მიაღწიეთ FlyWeb-ის <ph name="BOOKMARK_LIMIT"/> სანიშნის ლიმიტს, ამიტომ თქვენი ზოგიერთი სანიშნე ჯერ არ შენახულა თქვენს FlyWeb ანგარიშში.

ახალი სანიშნეების შენახვა თქვენს ანგარიშში ვერ მოხერხდება, სანამ რამდენიმეს არ წაშლით. ახლა გასვლის შემთხვევაში შეუნახავი სანიშნები წაიშლება.</translation>
<translation id="6965382102122355670">კარგი</translation>
<translation id="3453763134178591239">ChromeOS პირობები</translation>
<translation id="1163386134146281359">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ FlyWeb-ის მონაცემები თქვენს ანგარიშში, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">ინსტალაცია ვერ მოხერხდა, რადგან ოპერაციული სისტემის ეს ვერსია მხარდაჭერილი არ არის.</translation>
