<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">
<translation id="130631256467250065">அடுத்த முறை உங்கள் சாதனத்தை மறுதொடக்கம் செய்யும்போது, மாற்றங்கள் செயல்பாட்டிற்கு வரும்.</translation>
<translation id="125853961893919199">FlyWeb உதவிக்குறிப்பு: கடவுச்சொற்களைச் சேமியுங்கள்</translation>
<translation id="1589233279653618219">FlyWeb மெனு &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          என்பதற்குச் சென்று, உங்கள் உள்ளமைவு "பிராக்சி இல்லை" அல்லது "நேரடி" என்று அமைக்கப்பட்டிருப்பதை உறுதிசெய்துகொள்ளவும்.</translation>
<translation id="8359495463485001719">சிதைவு அறிக்கை FlyWeb இல் கிடைக்கவில்லை.</translation>
<translation id="6338530717474923868">பாதுகாப்பான FlyWeb பக்கத்தைப் பார்க்கிறீர்கள்</translation>
<translation id="5147169001159408844">பேமெண்ட் விவரங்களை நிரப்பும் முறைகளுக்கான அமைப்புகளை FlyWeb மாற்ற முயல்கிறது.</translation>
<translation id="5702992568540613683">FlyWeb லோகோ</translation>
<translation id="8966580353365544289">FlyWeb உதவிக்குறிப்பு: மேம்பட்ட பாதுகாப்பான பிரவுசிங்</translation>
<translation id="510342522494506803">பேமெண்ட் முறைகளை FlyWeb மாற்ற முயல்கிறது.</translation>
<translation id="8375862260948854624"><ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ஓப்பன் சோர்ஸ் திட்டபணி மற்றும் பிற <ph name="BEGIN_LINK_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருட்களால்<ph name="END_LINK_OSS"/> FlyWeb ஐ உருவாக்குவது சாத்தியமானது.</translation>
<translation id="5040124620086808431">இந்தப் பக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="1953000035868532675">ஃபயர்வாலிலோ வைரஸ் தடுப்பு
          அமைப்புகளிலோ நெட்வொர்க்கை அணுக Braveமை அனுமதிக்கவும்.</translation>
<translation id="4949828774841497663">ஆப்ஸ் &gt; சிஸ்டம் அமைப்புகள் &gt; நெட்வொர்க் என்பதற்குச் சென்று,
          செயலிலுள்ள நெட்வொர்க்கைத் தேர்ந்தெடுத்து, விவரங்கள்... பட்டனைக் கிளிக் செய்துவிட்டு தேர்ந்தெடுக்கப்பட்டுள்ள
          பிராக்ஸிகளைத் தேர்வுநீக்கவும்.</translation>
<translation id="7584668345330431749">FlyWeb மெனு &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          நெட்வொர்க் &amp; இணையம் &gt; ப்ராக்ஸி
          என்பதற்குச் சென்று "தானாகவே அமைப்புகளைக் கண்டறி" என்பதைத் தேர்வு நீக்கவும்.</translation>
<translation id="3145451630329266064">இந்தப் பக்கங்கள் FlyWeb டெவெலப்பர்களுக்கானவை. இவை தொடர்ச்சியாகப் பராமரிக்கப்படாமலோ பரிசோதிக்கப்படாமலோ இருக்கலாம். இவற்றை இயக்க, <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/> பக்கத்திற்குச் சென்று, பிழைதிருத்துதல் பக்கங்களை இயக்குவதற்கான பட்டனைக் கிளிக் செய்யவும். பிறகு, இந்தப் பக்கத்திற்குத் திரும்ப வரவும்.</translation>
<translation id="2681118099728446983">பிற <ph name="BEGIN_LINK_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_OSS"/> மூலமாகவும் FlyWeb உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="6888846095017247017">அடுத்த முறை நீங்கள் FlyWeb ஐ மீண்டும் தொடங்கும்போது உங்கள் மாற்றங்கள் செயல்படும்.</translation>
<translation id="8524328905288851065">இணைப்பதைத் தொடர Braveமிற்கு புளூடூத் அணுகல் 
 தேவை. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177"><ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ஓப்பன் சோர்ஸ் திட்டப்பணி மூலம் FlyWeb உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="7777112741998051633">FlyWeb மெனு &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          என்பதற்குச் சென்று, "<ph name="NO_PREFETCH_DESCRIPTION"/>" என்பதைத் தேர்வுநீக்கம் செய்யவும்.
          இது சிக்கலைத் தீர்க்கவில்லை எனில், மேம்பட்ட செயல்திறனுக்கு இந்த விருப்பத்தை மீண்டும் தேர்ந்தெடுக்கும்படி பரிந்துரைக்கிறோம்.</translation>
<translation id="4699594416850504200">பாதுகாப்பான FlyWeb for Testing பக்கத்தைப் பார்க்கிறீர்கள்</translation>
<translation id="6224789938625024797">FlyWeb சரியாக நிறுத்தப்படவில்லை.</translation>
<translation id="3593104813552438879">FlyWeb உதவிக்குறிப்பு: Lens மூலம் தேடுங்கள்</translation>
</translationbundle>