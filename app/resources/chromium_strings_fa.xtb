<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="7099479769133613710">‏راه‌اندازی مجدد برای به‌روزرسانی ChromeOS</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="6896681084876612310">‏FlyWeb می‌تواند به ایمن ماندن شما در برابر نقض داده، افزونه‌های مخرب، و خطرهای دیگر کمک کند</translation>
<translation id="1368460307421081773">‏FlyWeb می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="7307912249127683931">‏FlyWeb مرورگر پیش‌فرضتان است</translation>
<translation id="4556715463645168547">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK"/>به سیستم FlyWeb وارد شوید<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">‏روی منوی FlyWeb کلیک کنید</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{‏افزونه‌های FlyWeb به «دستگاه‌های میانای انسانی» دسترسی داشتند}=1{‏افزونه‌های FlyWeb به «دستگاه‌های میانای انسانی» دسترسی دارند}one{‏افزونه‌های FlyWeb به # «دستگاه میانای انسانی» دسترسی دارند}other{‏افزونه‌های FlyWeb به # «دستگاه میانای انسانی» دسترسی دارند}}</translation>
<translation id="4380351562011537903">‏درباره FlyWeb</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="4876991604685198381">‏«بهینه‌سازی حافظه» سرعت FlyWeb را بیشتر کرده است</translation>
<translation id="4750836834956739196">‏وقتی این برگه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت FlyWeb حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="4549187150186083146">‏راه‌اندازی نمایه FlyWeb جدید</translation>
<translation id="4150708158890309866">‏شما وارد سیستم FlyWeb شدید!</translation>
<translation id="4713192356155907986">‏دریافت راهنمایی درباره FlyWeb for Testing</translation>
<translation id="8962360511570172">‏هم‌رسانی برگه FlyWeb</translation>
<translation id="8196829963313696543">‏FlyWeb برای ایجاد نقشه سه‌بعدی محیط شما باید اجازه دسترسی به دوربین داشته باشد</translation>
<translation id="3961251277542681013">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در FlyWeb</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="5579294097895667826">‏نسخه جدید و امن‌تری از FlyWeb موجود است.</translation>
<translation id="2383861520542390014">‏می‌توانید موضوعات موردعلاقه را که سایت‌ها برای ارائه آگهی به شما استفاده می‌کنند ببینید یا حذف کنید. FlyWeb علایق شما را براساس سابقه مرور اخیرتان تخمین می‌زند.</translation>
<translation id="5695205873161614119">‏FlyWeb به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="7385422968404728039">‏FlyWeb تا <ph name="REMAINING_TIME"/> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="307170399141486420">‏اجازه به FlyWeb برای اجرا در پس‌زمینه</translation>
<translation id="2473319786107120819">‏نصب مجدد FlyWeb</translation>
<translation id="2533324957407080119">‏FlyWeb در تلاش است <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6434738578659849497">‏سایت‌ها می‌توانند بااستفاده از FlyWeb اطلاعاتی درباره علایقتان ذخیره کنند. برای مثال، اگر برای خرید کفش مخصوص ماراتون از سایتی بازدید کنید، ممکن است آن سایت علاقه شما را به‌صورت دونده ماراتون مشخص کند. بعداً، اگر برای ثبت‌نام در مسابقه‌ای به سایتی دیگر مراجعه کردید، آن سایت می‌تواند براساس علایقتان آگهی‌ای برای کفش مخصوص دویدن به شما نشان دهد.</translation>
<translation id="4824940465467423308">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه FlyWeb خود را می‌دهید. داده‌های FlyWeb شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های FlyWeb حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های FlyWeb موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم FlyWeb به سیستم سایت‌های FlyWeb مانند Gmail وارد شوید</translation>
<translation id="5714085538350759767">‏FlyWeb پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="4035053306113201399">‏برای اعمال به‌روزرسانی، ChromeOS باید بازراه‌اندازی شود.</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE"/> دقیقه باقی مانده است</translation>
<translation id="6956650624767954726">‏FlyWeb نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="6495079989036864983">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="4252651275570549255">‏برای بررسی اینکه از دیگر گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK"/>به سیستم FlyWeb وارد شوید<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">‏انتخاب کنید که آیا سابقه FlyWeb برای تجربه‌های شخصی‌شده‌تر در سرویس‌های FlyWeb لحاظ شود یا نه</translation>
<translation id="1868972292925460871">‏اطلاعات مربوط به اینکه FlyWeb چگونه گواهینامه‌های ریشه‌اش را مدیریت می‌کند</translation>
<translation id="6765231735885996239">‏سفارشی کردن FlyWeb</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="2937508664417729967">‏FlyWeb - ورود به سیستم شبکه - <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و FlyWeb را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="5067150284614317159">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در FlyWeb ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، FlyWeb ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="3256927121768528350">‏برای ارسال شماره از اینجا به تلفن Android خود، در هر دو دستگاه به سیستم FlyWeb وارد شوید.</translation>
<translation id="8776241960316471093">‏این افزونه، صفحه‌ای را تغییر داده است که هنگام راه‌اندازی FlyWeb نشان داده می‌شود.</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="8418845734693287262">‏ChromeOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="2100412893059179161">‏افزونه «<ph name="EXTENSION_NAME"/>»، صفحه‌ای را تغییر داده است که هنگام راه‌اندازی FlyWeb نشان داده می‌شود.</translation>
<translation id="1364879203203742966">‏FlyWeb برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2451727308784734061">از میان‌بر برای دسترسی سریع به «مدیر گذرواژه» استفاده کنید. می‌توانید میان‌برتان را به صفحه اصلی رایانه یا راه‌انداز برنامه منتقل کنید.</translation>
<translation id="3224379053610845181">‏FlyWeb به‌زودی بسته می‌شود</translation>
<translation id="3840682988105604367">‏در FlyWeb</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="6823116595279840454">‏FlyWeb می‌خواهد گذواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2691552788029831386">‏FlyWeb برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="2275866327478859777">FlyWeb Helper</translation>
<translation id="7717615706977383025">‏سرپرست نمایه کاری می‌تواند داده‌های FlyWeb را که درطول استفاده از این نمایه ایجاد شده‌اند (مثل ایجاد سابقه نشانک‌ها، گذرواژه‌ها، و دیگر تنظیمات) بردارد. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">‏ادامه استفاده از FlyWeb</translation>
<translation id="3827993926722004004">‏یک خطای سیستم‌عامل در طول نصب روی داد. لطفاً FlyWeb را دوباره نصب کنید.</translation>
<translation id="333184635927514678">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و FlyWeb را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="8991987934418988501">‏FlyWeb این فایل بایگانی را مسدود کرده است چون ممکن است بدافزار پنهان کرده باشد</translation>
<translation id="1661841342483968180">‏<ph name="ACCOUNT_FIRST_NAME"/> به FlyWeb خوش آمدید</translation>
<translation id="1257705702166647105">‏برگه FlyWeb</translation>
<translation id="2796283369875688710">‏برای امنیت بیشتر، FlyWeb داده‌های شما را رمزگذاری می‌کند.</translation>
<translation id="2770231113462710648">تغییر مرورگر پیش‌فرض به:</translation>
<translation id="7907238427168022751">‏این افزونه حاوی بدافزار است و ناامن است. آن را از FlyWeb حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2799223571221894425">راه‌اندازی مجدد</translation>
<translation id="8990114339313395142">‏با این کار، نمایه FlyWeb جدیدی برای <ph name="USER_EMAIL_ADDRESS"/> ایجاد خواهد شد</translation>
<translation id="1339341044496643931">‏حذف از FlyWeb...</translation>
<translation id="4922993584046885552">‏وقتی به سیستم وارد شده باشید، امنیت شما را در FlyWeb حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر FlyWeb استفاده شود</translation>
<translation id="2885378588091291677">مدیر وظایف</translation>
<translation id="3806033752149316261">‏درباره &amp;FlyWeb</translation>
<translation id="2915996080311180594">بازراه‌اندازی در فرصتی دیگر</translation>
<translation id="2928420929544864228">نصب کامل شد.</translation>
<translation id="1661079783259785361">‏FlyWeb به‌روز است</translation>
<translation id="5447533789927384736">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، FlyWeb ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند</translation>
<translation id="1244955229468464260">‏FlyWeb نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعداً دوباره امتحان کنید.</translation>
<translation id="8841609317523323027">‏افزودن به FlyWeb…</translation>
<translation id="3038232873781883849">درانتظار نصب…</translation>
<translation id="7859502023458300952">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK"/> به FlyWeb، به بهبود FlyWeb کمک کنید</translation>
<translation id="4133194854947529871">‏سابقه مرور شما بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، FlyWeb علایقتان را هر ماه به‌طور خودکار و چرخشی حذف می‌کند. ممکن است علایق بازآوری شود، مگر اینکه آن‌ها را بردارید.</translation>
<translation id="1407857531570256859">‏نصب‌کننده در خارج کردن بایگانی از حالت فشرده ناموفق بود. لطفاً دوباره FlyWeb را بارگیری کنید.</translation>
<translation id="1309738977648134943">‏FlyWeb درحال استفاده از میکروفون شما است.</translation>
<translation id="6274649779206195384">‏اجرای مجدد FlyWeb</translation>
<translation id="6773570808762718524">‏سفارشی کردن نمایه جدید FlyWeb</translation>
<translation id="2700572810650522793">‏اوه! FlyWeb خراب شده است. دوباره راه‌اندازی شود؟</translation>
<translation id="5449297306961970452">‏FlyWeb نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="6755586344927335130">‏FlyWeb نسخه <ph name="PRODUCT_VERSION"/> نصب شده است</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="3900612994249740104">‏کلیدهای FlyWeb API وجود ندارند. برخی از عملکردهای FlyWeb از کار خواهند افتاد.</translation>
<translation id="6824575001009586492">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه FlyWeb بسته می‌شود</translation>
<translation id="5399208721646088502">‏درحال‌حاضر یک نمایه FlyWeb با این حساب وجود دارد</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">‏به نمایه FlyWeb موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="847273641988291714">‏با نمایه‌های FlyWeb می‌توانید همه چیزتان را در FlyWeb جدا کنید. برای دوستان و اعضای خانواده‌تان نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="1558345997029205345">‏وقتی با گذرواژه‌ای لورفته به سیستم وارد می‌شوید، FlyWeb شما را مطلع می‌کند</translation>
<translation id="956833467923764542">‏این کار <ph name="ITEMS_COUNT"/> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="4772642827282964272">‏با <ph name="SHORTCUT"/> می‌توانید بین نمایه‌های FlyWeb جابه‌جا شوید</translation>
<translation id="6724485219247982027">‏لطفاً همه پنجره‌های FlyWeb را ببندید و دوباره سعی کنید.</translation>
<translation id="763231524941489073">‏برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشند به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. یا می‌توانید علایقی را که نمی‌خواهید FlyWeb مدنظر قرار دهد حذف کنید.</translation>
<translation id="4856314253538330936">‏سابقه مرور شما، سابقه سایت‌هایی که بااستفاده از FlyWeb در این دستگاه از آن‌ها بازدید کرده‌اید.</translation>
<translation id="1054901839328542426">‏نرم‌افزار مضری در رایانه‌تان وجود دارد. FlyWeb می‌تواند آن را بردارد، تنظیمات را بازیابی کند و افزونه‌ها را غیرفعال کند تا عملکرد مرورگرتان دوباره عادی شود.</translation>
<translation id="199853864262219284">‏حساب دیگری قبلاً به سیستم وارد شده است. برای جدا نگه داشتن جلسه‌های مرور، FlyWeb می‌تواند نمایه‌ای برایتان ایجاد کند که مختص شما باشد.</translation>
<translation id="9154454584386840012">‏برای دریافت به‌روزرسانی‌های بعدی FlyWeb، باید macOS نسخه ۱۰.۱۵ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۰.۱۳ استفاده می‌کند.</translation>
<translation id="7465608402296261674">‏برای ارسال شماره از <ph name="ORIGIN"/> به تلفن Android خود، در هر دو دستگاه به سیستم FlyWeb وارد شوید.</translation>
<translation id="1543563097158722437">‏FlyWeb نمی‌تواند گذرواژه‌هایتان را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="190360428475385352">‏درباره شخصی‌سازی آگهی در FlyWeb بیشتر بدانید</translation>
<translation id="6611602069520888180">‏باز کردن پیوند در &amp;برگه جدید FlyWeb</translation>
<translation id="8701399577028839698">‏FlyWeb به شما اجازه می‌دهد بر روی شماره تلفن روی وب کلیک کرده و از طریق Skype تماس بگیرید!</translation>
<translation id="2401189691232800402">‏سیستم ChromeOS</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">‏دریافت راهنمایی برای ChromeOS</translation>
<translation id="1864899808802540927">‏اطلاعات مرورگر FlyWeb خود را که در <ph name="ACCOUNT_EMAIL"/> ذخیره شده است دریافت کنید</translation>
<translation id="2736927994658608637">‏برای دریافت به‌روزرسانی‌های بعدی FlyWeb، باید macOS نسخه ۱۰.۱۵ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۰.۱۴ استفاده می‌کند.</translation>
<translation id="5175060854726708547">‏FlyWeb را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="606156353708638647">‏برای باز کردن FlyWeb و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="5145107420478372433">‏<ph name="EXISTING_USER"/> قبلاً به سیستم این نمایه FlyWeb وارد شده است. برای جدا نگه داشتن مرور، FlyWeb می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="3376157109651222096">‏<ph name="MANAGER_NAME"/> حساب شما را مدیریت می‌کند. سرپرستتان می‌تواند این نمایه مرورگر FlyWeb و داده‌های آن را (مثل نشانک‌ها، سابقه، و گذرواژه‌ها) ببیند و ویرایش کند.</translation>
<translation id="8536259619256229278">‏FlyWeb می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="4041003017438130352">‏FlyWeb توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد</translation>
<translation id="5667414856761616811">‏درباره FlyWeb for Testing</translation>
<translation id="1152920704813762236">‏درباره ChromeOS</translation>
<translation id="3703994572283698466">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS"/>محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS"/> ممکن شده است.</translation>
<translation id="504994999924593940">‏با گزارش <ph name="BEGIN_LINK"/>تنظیمات کنونی<ph name="END_LINK"/>، به بهتر شدن FlyWeb کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="4148957013307229264">در حال نصب...</translation>
<translation id="4890947375650921286">‏<ph name="PAGE_TITLE"/> - ورود به سیستم شبکه - FlyWeb</translation>
<translation id="4007949387571083162">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه FlyWeb را کشف کنید.</translation>
<translation id="1595210458721188387">‏از این زبان برای نمایش واسط کاربر FlyWeb استفاده می‌شود</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="2564888740660198776">‏داده‌های FlyWeb به این حساب مرتبط شود؟</translation>
<translation id="8514458758262040082">‏دریافت کمک برای FlyWeb</translation>
<translation id="3393587701694585022">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر FlyWeb در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="4304713468139749426">مدیر گذرواژه</translation>
<translation id="4334294535648607276">بارگیری کامل شد.</translation>
<translation id="1068681683510904753">‏<ph name="MANAGER"/> لازم می‌داند که شما «شرایط خدمات» زیر را قبل‌از استفاده از این دستگاه بخوانید و بپذیرید. این شرایط بسط داده نمی‌شود، اصلاح نمی‌شود، و شرایط Chrome OS را محدود نمی‌کند.</translation>
<translation id="1376968889000878095">‏درهرصورت از FlyWeb خارج می‌شوید؟</translation>
<translation id="6360389033094512399">‏اجازه به FlyWeb برای اجرا در پس‌زمینه</translation>
<translation id="4166347503469830337">‏سفارشی کردن و کنترل FlyWeb</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="8791209382165811772">‏درباره FlyWeb for Testing</translation>
<translation id="834808339160590901">‏به FlyWeb خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="1304885695888649052">‏FlyWeb به‌روزرسانی نشد؛ مشکلی پیش آمد. <ph name="BEGIN_LINK"/>مشکلات به‌روزرسانی FlyWeb و به‌روزرسانی‌های ناموفق را برطرف کنید.<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">‏در نمایه جدید FlyWeb ادامه می‌دهید؟</translation>
<translation id="4567424176335768812">با حساب <ph name="USER_EMAIL_ADDRESS"/> وارد سیستم شده‌اید. اکنون در همه دستگاه‌هایی که با آنها به سیستم وارد شده‌اید می‌توانید به نشانک‌ها، سابقه و دیگر تنظیماتتان دسترسی داشته باشید.</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="6046424510733540251">‏برنامه‌های FlyWeb</translation>
<translation id="4970880042055371251">‏نسخه ChromeOS</translation>
<translation id="1936188352112244665">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، FlyWeb را راه‌اندازی مجدد کنید.</translation>
<translation id="2962574118577609024">‏اگر گزارش‌های استفاده از FlyWeb را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="9219132550163437762">‏ظاهراً نمایه توسط فرآیند FlyWeb دیگری (<ph name="PROCESS_ID"/>) در رایانه‌ای دیگر (<ph name="HOST_NAME"/>) در حال استفاده است. FlyWeb نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرآیندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و FlyWeb را مجدداً راه‌اندازی نمایید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="5227023869666757348">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST"/> به سیستم FlyWeb در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر FlyWeb جدیدی ایجاد کنید.</translation>
<translation id="1671154647029930623">‏درهرصورت از FlyWeb خارج می‌شوید؟</translation>
<translation id="4143239505982500022">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای FlyWeb اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="1347247057384060764">‏هروقت بخواهید می‌توانید در تنظیمات FlyWeb انتخابتان را تغییر دهید. دوره‌های آزمایشی به‌موازات روش کنونی ارائه آگهی اجرا می‌شود، بنابراین تغییرات بلافاصله ظاهر نمی‌شوند.</translation>
<translation id="4259200560913816786">‏FlyWeb نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید یا <ph name="BEGIN_LINK"/>گذرواژه‌ها را در «حساب FlyWeb» خود بررسی کنید<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی FlyWeb استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای FlyWeb ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="2991144524835127379">‏قانون ترافیک ورودی برای FlyWeb جهت اجازه به ترافیک mDNS.</translation>
<translation id="6208903184719035736">‏راه‌اندازی مجدد برای به‌روزرسانی FlyWeb</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از FlyWeb استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌های موجود باز می‌ماند.}one{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌های موجود باز می‌ماند.}other{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌های موجود باز می‌ماند.}}</translation>
<translation id="7174589544844983914">‏FlyWeb در حالت پس‌زمینه است.</translation>
<translation id="7792628702371319769">‏مهمان‌ها می توانند از FlyWeb استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="2760069255902967585">‏افرودن خودتان به FlyWeb</translation>
<translation id="4239638419916712076">‏FlyWeb ویژگی‌های جدیدی را کاوش می‌کند که به سایت‌ها اجازه می‌دهد بااستفاده از اطلاعات شخصی کمتر، همان تجربه مرور را ارائه دهند</translation>
<translation id="387444474697464273">‏گذرواژه ذخیره‌شده‌ای وجود ندارد. FlyWeb زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید.</translation>
<translation id="520701392326482190">‏<ph name="EXISTING_USER"/> قبلاً به سیستم این نمایه FlyWeb وارد شده است. با این کار، نمایه FlyWeb جدیدی برای <ph name="USER_EMAIL_ADDRESS"/> ایجاد خواهد شد</translation>
<translation id="8295539942024823191">‏برای اعمال تغییراتتان، FlyWeb را راه‌اندازی مجدد کنید</translation>
<translation id="5374328929709976901">‏اگر نسخه آزمایشی روشن باشد و FlyWeb به‌طور تصادفی نسخه آزمایشی را برایتان فعال کرده باشد، سابقه مرورتان بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، FlyWeb علایقتان را هر ماه به‌طور چرخشی حذف می‌کند.</translation>
<translation id="8449603408481238073">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه FlyWeb خود را می‌دهید. داده‌های FlyWeb شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های FlyWeb حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">‏درحال به‌روزرسانی FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">‏مجاز کردن ورود به سیستم FlyWeb</translation>
<translation id="5965500511473700110">‏نسخه جدیدی از FlyWeb موجود است.</translation>
<translation id="1827750898515917134">‏حذف از FlyWeb</translation>
<translation id="5020755920249060562">‏تنظیم FlyWeb به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb Beta</translation>
<translation id="5385202369020319636">‏FlyWeb ممکن است درست کار نکند زیرا این توزیع Linux دیگر از آن پشتیبانی نمی‌کند.</translation>
<translation id="5957333939864770801">‏FlyWeb برای هم‌رسانی مکانتان با این سایت باید به مکان شما دسترسی داشته باشد</translation>
<translation id="780999790006298623">‏برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشند به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. و اگر FlyWeb به‌اشتباه علاقه‌ای را اضافه کند یا شما نخواهید آگهی‌های مشخصی را ببینید، می‌توانید آن علاقه را بردارید.</translation>
<translation id="2183749398075655200">‏وقتی FlyWeb جدیدترین به‌روزرسانی‌های سیستم را نصب می‌کند، لطفاً صبر کنید.</translation>
<translation id="8996657165865563765">‏FlyWeb می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="5738298079259740925">‏باز کردن فایل‌های PDF در FlyWeb</translation>
<translation id="9197514179291669592">‏وقتی روشن باشد، از سیستم FlyWeb نیز خارج خواهید شد</translation>
<translation id="6096945112863785306">{0,plural, =0{‏به‌روزرسانی FlyWeb دردسترس است}=1{‏به‌روزرسانی FlyWeb دردسترس است}one{‏به‌روزرسانی FlyWeb از # روز پیش دردسترس است}other{‏به‌روزرسانی FlyWeb از # روز پیش دردسترس است}}</translation>
