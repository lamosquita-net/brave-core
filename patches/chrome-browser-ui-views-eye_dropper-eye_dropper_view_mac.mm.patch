+  // FlyWeb (LOCAL-8): NSColorSampler is macOS 10.15+; ShowEyeDropper() does not
+  // create this view on 10.14 (the 116 generic fallback is gone in 128).
+  if (@available(macOS 10.15, *)) {
+    color_sampler_ = [[NSColorSampler alloc] init];
