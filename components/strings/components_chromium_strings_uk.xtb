<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="uk">
<translation id="130631256467250065">Ваші зміни почнуть діяти під час наступного перезапуску пристрою.</translation>
<translation id="1555506416658437797">змінити способи оплати.</translation>
<translation id="8359495463485001719">Функція повідомлення про аварійне завершення роботи не доступна в FlyWeb.</translation>
<translation id="6338530717474923868">Ви переглядаєте безпечну сторінку FlyWeb</translation>
<translation id="5147169001159408844">FlyWeb намагається змінити параметри заповнення способів оплати.</translation>
<translation id="5702992568540613683">Логотип FlyWeb</translation>
<translation id="510342522494506803">FlyWeb намагається змінити способи оплати.</translation>
<translation id="8375862260948854624">FlyWeb став можливим завдяки проекту з відкритим кодом <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> та іншому <ph name="BEGIN_LINK_OSS"/>програмному забезпеченню з відкритим кодом<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Перейдіть у
          меню FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Налаштування LAN
          і зніміть прапорець біля опції "Використовувати проксі-сервер для вашої локальної мережі".</translation>
<translation id="5040124620086808431">Веб-переглядач FlyWeb заблокував цю сторінку</translation>
<translation id="1953000035868532675">Надайте FlyWeb доступ до мережі в налаштуваннях брандмауера чи
        антивірусної програми.</translation>
<translation id="3442058224540562441">Перейдіть у
          меню FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          і переконайтеся, що встановлено значення конфігурації "без проксі" чи "безпосередньо".</translation>
<translation id="585620188971323280">змінити параметри заповнення способів оплати.</translation>
<translation id="2681118099728446983">FlyWeb також працює завдяки іншому <ph name="BEGIN_LINK_OSS"/>програмному забезпеченню з відкритим кодом<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Ваші зміни почнуть діяти після наступного перезапуску FlyWeb.</translation>
<translation id="1017070759373671177">FlyWeb було створено на основі проекту програмного забезпечення з відкритим кодом <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Перейдіть у
          меню FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          і зніміть прапорець біля опції "<ph name="NO_PREFETCH_DESCRIPTION"/>".
          Якщо проблема не зникне, радимо знову вибрати цю опцію,
          щоб покращити стабільність.</translation>
<translation id="8187289872471304532">Перейдіть у меню
          Applications &gt; System Preferences &gt; Network &gt; Advanced &gt; Proxies (Програми &gt; Системні налаштування &gt; Мережа &gt; Розширені &gt; Проксі-сервери)
          і зніміть прапорці біля всіх вибраних проксі-серверів.</translation>
<translation id="4699594416850504200">Ви переглядаєте безпечну сторінку FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb було неправильно закрито.</translation>
</translationbundle>