<translation id="2736927994658608637">‏للحصول على تحديثات FlyWeb في المستقبل، يجب استخدام جهاز يعمل بنظام التشغيل macOS 10.15 أو إصدار أحدث. يعمل هذا الكمبيوتر بنظام التشغيل macOS 10.14.</translation>
<translation id="5175060854726708547">‏تخصيص FlyWeb والتحكُّم فيه معلومات مهمة - انقر للحصول على التفاصيل.</translation>
<translation id="606156353708638647">‏انقر على اسمك لفتح FlyWeb وبدء التصفح.</translation>
<translation id="5145107420478372433">‏سبَق تسجيل دخول <ph name="EXISTING_USER"/> إلى هذا الملف الشخصي على FlyWeb. لتوفير تجربة تصفّح منفصلة دائمًا، يمكن لمتصفِّح FlyWeb إنشاء ملف شخصي خاص بك.</translation>
<translation id="3376157109651222096">‏تتم إدارة حسابك من قِبَل <ph name="MANAGER_NAME"/>. وبإمكان المشرف الاطّلاع على الملف الشخصي لمتصفِّح FlyWeb وتعديل بياناته، مثل الإشارات المرجعية والسجلّ وكلمات المرور.</translation>
<translation id="8536259619256229278">‏يحاول FlyWeb نسخ كلمات المرور. اكتب كلمة مرور Windows للسماح بذلك.</translation>
<translation id="4041003017438130352">‏ينصح متصفِّح FlyWeb بفحص هذا الملف لأنّه قد يكون ضارًا.</translation>
<translation id="5667414856761616811">‏لمحة عن الإصدار FlyWeb for Testing</translation>
<translation id="1152920704813762236">‏لمحة عن نظام التشغيل FlyWeb</translation>
<translation id="3703994572283698466">‏أصبح نظام التشغيل FlyWeb متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS"/>برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS"/>، كما هو الحال في <ph name="BEGIN_LINK_LINUX_OSS"/>بيئة تطوير Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="504994999924593940">‏ساعد في تحسين FlyWeb بالإبلاغ عن <ph name="BEGIN_LINK"/>الإعدادات الحالية<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">تحسينات الأمان المهمة والميزات الجديدة متاحة في أحدث إصدار.</translation>
<translation id="4055805654398742145">مدير كلمات المرور</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة دقيقة واحدة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}two{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة دقيقتَين. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}few{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقائق. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}many{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}other{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}}</translation>
<translation id="4148957013307229264">جارٍ التثبيت...</translation>
<translation id="4890947375650921286">‏<ph name="PAGE_TITLE"/> - تسجيل الدخول إلى الشبكة - FlyWeb</translation>
<translation id="4007949387571083162">‏اكتشف تطبيقات، وألعاب، وإضافات، ومظاهر رائعة لمتصفح FlyWeb.</translation>
<translation id="1595210458721188387">‏يتم استخدام هذه اللغة لعرض واجهة مستخدم FlyWeb</translation>
<translation id="4222932583846282852">جارٍ الإلغاء...</translation>
<translation id="2564888740660198776">‏هل ترغب في ربط بياناتك في FlyWeb بهذا الحساب؟</translation>
<translation id="8514458758262040082">‏الحصول على مساعدة في FlyWeb</translation>
<translation id="3393587701694585022">‏تعذّر إتمام عملية التثبيت بسبب خطأ غير محدد. إذا كان FlyWeb في حالة التشغيل حاليًا، يُرجى إغلاقه وإعادة المحاولة.</translation>
<translation id="4304713468139749426">مدير كلمات المرور</translation>
<translation id="4334294535648607276">اكتمل التنزيل.</translation>
<translation id="1068681683510904753">‏يشترط <ph name="MANAGER"/> قراءة بنود الخدمة التالية وقبولها قبل استخدام هذا الجهاز، مع العلم بأنّ هذه البنود لا توسِّع نطاق بنود نظام التشغيل FlyWeb ولا تعدِّلها ولا تفرض قيودًا عليها.</translation>
<translation id="1376968889000878095">‏هل تريد الخروج من FlyWeb على أي حال؟</translation>
<translation id="6360389033094512399">‏السماح بتشغيل FlyWeb في الخلفية</translation>
<translation id="4166347503469830337">‏تخصيص FlyWeb والتحكم فيه</translation>
<translation id="4427306783828095590">يؤدي تفعيل إعداد "الحماية المُحسَّنة" إلى حظر التصيّد الاحتيالي والبرامج الضارّة.</translation>
<translation id="8791209382165811772">‏لمحة عن الإصدار FlyWeb for Testing</translation>
<translation id="834808339160590901">‏مرحبًا بك في FlyWeb. تم فتح نافذة متصفّح جديدة.</translation>
<translation id="1304885695888649052">‏تعذّر تحديث FlyWeb بسبب حدوث خطأ. <ph name="BEGIN_LINK"/>حلّ مشاكل تحديث FlyWeb وتعذُّر التحديثات<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">‏هل تريد المتابعة باستخدام ملف شخصي جديد على FlyWeb؟</translation>
<translation id="4567424176335768812">لقد سجلت دخولك باعتبارك <ph name="USER_EMAIL_ADDRESS"/>. ويُمكنك الآن الاستمتاع بالدخول إلى الإشارات المرجعية، والسجلّ، والإعدادات الأخرى على جميع الأجهزة التي تسجّل الدخول إليها.</translation>
<translation id="4594305310729380060">في "مدير كلمات المرور" على هذا الجهاز</translation>
<translation id="6046424510733540251">‏تطبيقات FlyWeb</translation>
<translation id="4970880042055371251">‏إصدار نظام التشغيل FlyWeb</translation>
<translation id="1936188352112244665">‏أوشك التحديث على الانتهاء! إعادة تشغيل FlyWeb لإنهاء التحديث.</translation>
<translation id="2962574118577609024">‏في حال مشاركة تقارير استخدام FlyWeb أيضًا، ستتضمّن هذه التقارير عناوين URL التي تنتقل إليها.</translation>
<translation id="9219132550163437762">‏يبدو أن الملف الشخصي قيد الاستخدام بواسطة عملية أخرى في FlyWeb (<ph name="PROCESS_ID"/>) على جهاز كمبيوتر آخر (<ph name="HOST_NAME"/>). وقد تمّ قفل الملف الشخصي من جانب FlyWeb لضمان عدم تعرضه للتلف. فإذا كنت واثقًا من عدم وجود عمليات أخرى قيد التشغيل على جهاز الكمبيوتر، فيُمكنك فتح قفل الملف الشخصي وإعادة تشغيل FlyWeb مجددًا.</translation>
<translation id="4680828127924988555">إلغاء التثبيت</translation>
<translation id="5227023869666757348">‏سجّل شخص ما الدخول من قبل إلى FlyWeb على جهاز الكمبيوتر هذا باسم <ph name="ACCOUNT_EMAIL_LAST"/>. يُرجى إنشاء حساب مستخدم جديد في FlyWeb للإبقاء على معلوماتك بشكلٍ منفصل.</translation>
<translation id="1671154647029930623">‏هل تريد الخروج من FlyWeb على أي حال؟</translation>
<translation id="4143239505982500022">‏تم للتو تطبيق تحديث أمان خاص لمتصفِّح FlyWeb. يمكنك إعادة التشغيل الآن وستتم استعادة علامات التبويب.</translation>
<translation id="1347247057384060764">‏يمكنك تغيير رأيك متى شئت من خلال إعدادات FlyWeb. نجري هذه التجارب بدون إيقاف الإعدادات الحالية لعرض الإعلانات، لذا لن تظهر التغييرات على الفور.</translation>
<translation id="4259200560913816786">‏يتعذّر على FlyWeb التحقُّق من كلمات المرور. يُرجى إعادة المحاولة بعد 24 ساعة أو <ph name="BEGIN_LINK"/>التحقُّق من كلمات المرور في حسابك على FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">‏يستخدم ذلك المدقق الإملائي نفسه الذي يتم استخدامه في "بحث FlyWeb". ويتم إرسال النص الذي تكتبه في المتصفّح إلى FlyWeb. يمكنك دائمًا تغيير هذا السلوك في الإعدادات.</translation>
<translation id="2991144524835127379">‏قاعدة الوارد إلى FlyWeb للسماح بحركة مرور mDNS.</translation>
<translation id="6208903184719035736">‏إعادة تشغيل متصفِّح FlyWeb لتحديثه</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة دقيقة واحدة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب الحالية مفتوحة.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب الحالية مفتوحة.}two{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة دقيقتَين. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب الحالية مفتوحة.}few{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقائق. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب الحالية مفتوحة.}many{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب الحالية مفتوحة.}other{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب الحالية مفتوحة.}}</translation>
<translation id="7174589544844983914">‏FlyWeb في وضع الخلفية.</translation>
<translation id="7792628702371319769">‏يمكن للضيف استخدام FlyWeb بدون أن يترك أي أثر وراءه.</translation>
<translation id="2760069255902967585">‏إضافة نفسك إلى FlyWeb</translation>
<translation id="4239638419916712076">‏يعمل FlyWeb على استكشاف ميزات جديدة تتيح للمواقع الإلكترونية توفير تجربة التصفّح نفسها باستخدام قدر أقل من بياناتك.</translation>
<translation id="387444474697464273">‏ما مِن كلمات مرور محفوظة. لا يستطيع FlyWeb التحقُّق من كلمات المرور إلا عند حفظها.</translation>
<translation id="520701392326482190">‏سبَق تسجيل دخول <ph name="EXISTING_USER"/> إلى هذا الملف الشخصي على FlyWeb. سيؤدي هذا الإجراء إلى إنشاء ملف شخصي جديد على FlyWeb لحساب <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8295539942024823191">‏لتطبيق التغييرات، يُرجى إعادة تشغيل FlyWeb</translation>
<translation id="5374328929709976901">‏عندما تكون التجارب مفعَّلة، وفي حال أضافك FlyWeb عشوائيًا إلى تجربة نشطة، سيؤثر سجلّ تصفّحك في الإعلانات التي تظهر لك والاهتمامات التي يتم تقديرها على النحو الموضّح أدناه. ولحماية خصوصيتك، يحذف FlyWeb اهتماماتك بشكل متواصل مرة واحدة على الأقل شهريًا.</translation>
<translation id="8449603408481238073">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على FlyWeb. وستكون بياناتك في FlyWeb مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME"/>. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات FlyWeb، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">‏جارٍ تحديث FlyWeb (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">‏السماح بتسجيل الدخول إلى FlyWeb</translation>
<translation id="5965500511473700110">‏يتوفر إصدار جديد من FlyWeb.</translation>
<translation id="1827750898515917134">‏إزالة من FlyWeb</translation>
<translation id="5020755920249060562">‏تعيين FlyWeb المتصفح التلقائي</translation>
<translation id="3148325800171225029">‏<ph name="PAGE_TITLE"/> - الإصدار التجريبي من FlyWeb</translation>
<translation id="5385202369020319636">‏قد لا يعمل FlyWeb بشكل صحيح لأنّه لم يعد متاحًا على توزيع Linux هذا.</translation>
<translation id="5957333939864770801">‏يحتاج FlyWeb للوصول إلى موقعك الجغرافي لمشاركته مع هذا الموقع.</translation>
<translation id="780999790006298623">‏لحماية خصوصيتك، نحذف تلقائيًا اهتماماتك التي يمر عليها أكثر من أربعة أسابيع. وفي حال بحثت عن أحد الاهتمامات مرّة آخرى، سيظهر في القائمة من جديد. يمكنك إزالة أي اهتمام إذا كان تقدير FlyWeb غير صحيح بشأنه، أو إذا كنت لا تريد رؤية إعلانات معيّنة.</translation>
<translation id="2183749398075655200">‏يُرجى الانتظار أثناء تثبيت FlyWeb لآخر تحديثات النظام.</translation>
<translation id="8996657165865563765">‏يحاول FlyWeb تعديل كلمات المرور. للسماح بذلك، يُرجى كتابة كلمة مرور Windows الخاصة بك.</translation>
<translation id="5738298079259740925">‏فتح ملفات PDF في FlyWeb</translation>
<translation id="9197514179291669592">‏عند تفعيل هذا الخيار، سيتم تسجيل خروجك أيضًا من FlyWeb.</translation>
<translation id="6096945112863785306">{0,plural, =0{‏يتوفر تحديث لمتصفح FlyWeb}=1{‏يتوفر تحديث لمتصفح FlyWeb}two{‏يتوفر تحديث لمتصفح FlyWeb منذ يومين}few{‏يتوفر تحديث لمتصفح FlyWeb منذ # أيام}many{‏يتوفر تحديث لمتصفح FlyWeb منذ # يومًا}other{‏يتوفر تحديث لمتصفح FlyWeb منذ # يوم}}</translation>
<translation id="5666891644992637849">‏يُرجى إعادة تشغيل FlyWeb الآن</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">‏عرض FlyWeb بهذه اللغة</translation>
<translation id="8331941171144629807">‏مرحبًا بك في FlyWeb</translation>
<translation id="7581082856615467651">‏رصد FlyWeb أنّ هذه العناصر تحتوي على برامج ضارة:</translation>
<translation id="5895138241574237353">إعادة التشغيل</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - تسجيل الدخول إلى الشبكة</translation>
<translation id="5924017743176219022">جارٍ الاتصال بالإنترنت...</translation>
<translation id="5941711191222866238">تصغير</translation>
<translation id="483902194277448471">‏في حال أضافك FlyWeb عشوائيًا إلى تجربة نشطة، سيؤثر سجلّ تصفّحك في الإعلانات التي تظهر لك والاهتمامات التي يتم تقديرها على النحو الموضّح أدناه. ولحماية خصوصيتك، يحذف FlyWeb اهتماماتك بشكل متواصل مرة واحدة على الأقل شهريًا. يتم تحديث الاهتمامات ما لم تزِلها.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة دقيقة واحدة.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقيقة.}two{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة دقيقتَين.}few{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقائق.}many{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقيقة.}other{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح FlyWeb تلقائيًا عند عدم استخدامه لمدة # دقيقة.}}</translation>
<translation id="4955869506208896934">‏تحديث FlyWeb لبدء المزامنة</translation>
