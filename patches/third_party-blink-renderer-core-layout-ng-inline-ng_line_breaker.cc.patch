+unsigned NGLineBreaker::IgnorableBidiControlLength(
+    const NGInlineItem& item) const {
+  const NGInlineItem* items = Items().data();
+  for (wtf_size_t i =
+           base::checked_cast<wtf_size_t>(std::distance(items, &item)) + 1;
+       i < end_item_index_; ++i) {
+    if (items[i].Length() == 0u) {
+      continue;
+    }
+    if (items[i].Type() != NGInlineItem::kOpenRubyColumn &&
+        items[i].Type() != NGInlineItem::kCloseRubyColumn) {
+      return items[i].StartOffset() - item.EndOffset();
+    }
+  }
+  return (end_item_index_ >= Items().size()
+              ? Text().length()
+              : items[end_item_index_].StartOffset()) -
+         item.EndOffset();
+}
