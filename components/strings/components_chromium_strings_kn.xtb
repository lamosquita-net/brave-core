<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="130631256467250065">ನಿಮ್ಮ ಸಾಧನವನ್ನು ನೀವು ಮುಂದಿನ ಬಾರಿ ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="125853961893919199">FlyWeb ಸಲಹೆ: ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಿ</translation>
<translation id="1589233279653618219">FlyWeb ಮೆನುಗೆ ಹೋಗಿ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ಮತ್ತು ನಿಮ್ಮ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು "ಪ್ರಾಕ್ಸಿ ಇಲ್ಲ" ಅಥವಾ "ನೇರ" ಎಂಬುದಾಗಿ ಸೆಟ್ ಮಾಡಲಾಗಿದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="8359495463485001719">FlyWeb ನಲ್ಲಿ ಕ್ರ್ಯಾಶ್ ವರದಿ ಮಾಡುವಿಕೆ ಲಭ್ಯವಿಲ್ಲ.</translation>
<translation id="6338530717474923868">ನೀವು ಸುರಕ್ಷಿತ FlyWeb ಪುಟವನ್ನು ವೀಕ್ಷಿಸುತ್ತಿರುವಿರಿ</translation>
<translation id="5147169001159408844">ಪಾವತಿ ವಿಧಾನಗಳನ್ನು ಭರ್ತಿ ಮಾಡಲು FlyWeb ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮಾರ್ಪಡಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ.</translation>
<translation id="5702992568540613683">FlyWeb ಲೋಗೋ</translation>
<translation id="8966580353365544289">FlyWeb ಸಲಹೆ: ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌</translation>
<translation id="510342522494506803">ಪಾವತಿ ವಿಧಾನಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಲು FlyWeb ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ.</translation>
<translation id="8375862260948854624"><ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ಓಪನ್ ಸೋರ್ಸ್ ಯೋಜನೆ ಮತ್ತು ಇತರ <ph name="BEGIN_LINK_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_OSS"/> ನಿಂದ FlyWeb ಅನ್ನು ಮಾಡಲು ಸಾಧ್ಯ.</translation>
<translation id="5040124620086808431">FlyWeb ನಿಂದ ಈ ಪುಟವನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ</translation>
<translation id="1953000035868532675">ನಿಮ್ಮ ಫೈರ್‌ವಾಲ್ ಮತ್ತು ಆಂಟಿವೈರಸ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನೆಟ್‌ವರ್ಕ್ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು
        FlyWeb ಗೆ ಅನುಮತಿಸಿ.</translation>
<translation id="4949828774841497663">ಅಪ್ಲಿಕೇಶನ್‌ಗಳು &gt; ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ನೆಟ್‌ವರ್ಕ್ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ, ಸಕ್ರಿಯ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಆಯ್ಕೆ ಮಾಡಿ, ವಿವರಗಳು... ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ಆಯ್ಕೆ ಮಾಡಿರಬಹುದಾದ ಯಾವುದೇ ಪ್ರಾಕ್ಸಿಗಳ ಆಯ್ಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಿ.</translation>
<translation id="7584668345330431749">FlyWeb ಮೆನು &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ನೆಟ್‌ವರ್ಕ್ ಮತ್ತು ಇಂಟರ್ನೆಟ್ &gt; ಪ್ರಾಕ್ಸಿ
ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ ಮತ್ತು "ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪತ್ತೆ ಮಾಡಿ" ಎಂಬುದರ ಆಯ್ಕೆ ರದ್ದುಮಾಡಿ</translation>
<translation id="3145451630329266064">ಈ ಪುಟಗಳು FlyWeb ಡೆವಲಪರ್‌ಗಳ ಬಳಕೆಗಾಗಿ ಉದ್ದೇಶಿಸಲಾಗಿದೆ ಮತ್ತು ಅವುಗಳನ್ನು ಸಕ್ರಿಯವಾಗಿ ನಿರ್ವಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಪರೀಕ್ಷಿಸಲಾಗುವುದಿಲ್ಲ. ಅವುಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು, <ph name="BEGIN_LINK"/> flyweb://chrome-urls<ph name="LINK_END"/> ಗೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ, ಡೀಬಗ್ ಪುಟಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಬಟನ್ ಕ್ಲಿಕ್ ಮಾಡಿ, ತದನಂತರ ಈ ಪುಟಕ್ಕೆ ಪುನಃ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ.</translation>
<translation id="2681118099728446983">ಇತರ <ph name="BEGIN_LINK_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_OSS"/> ನಿಂದ FlyWeb ಅನ್ನು ಸಾಕಾರಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="6888846095017247017">ನೀವು ಮುಂದಿನ ಬಾರಿ FlyWeb ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="8524328905288851065">ಜೋಡಣೆಯನ್ನು ಮುಂದುವರಿಸಲು FlyWeb ಗೆ ಬ್ಲೂಟೂತ್ ಪ್ರವೇಶದ ಅಗತ್ಯವಿದೆ. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177"><ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ಓಪನ್ ಸೋರ್ಸ್ ಪ್ರಾಜೆಕ್ಟ್‌ನಿಂದ FlyWeb ಅನ್ನು ಸಾಕಾರಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="7777112741998051633">ಇದಕ್ಕೆ ಹೋಗಿ
        FlyWeb ಮೆನು &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ಮತ್ತು "<ph name="NO_PREFETCH_DESCRIPTION"/>" ಆಯ್ಕೆ ರದ್ದುಮಾಡಿ.
        ಒಂದು ವೇಳೆ ಇದು ಈ ಸಮಸ್ಯೆಯನ್ನು ಪರಿಹರಿಸದಿದ್ದರೆ, ಸುಧಾರಿತ ಕಾರ್ಯಾಚರಣೆಗಾಗಿ ಮತ್ತೊಮ್ಮೆ
        ಈ ಆಯ್ಕೆಯನ್ನು ಆಯ್ಕೆ ಮಾಡುವಂತೆ ನಾವು ಶಿಫಾರಸು ಮಾಡುತ್ತೇವೆ.</translation>
<translation id="4699594416850504200">ನೀವು ಸುರಕ್ಷಿತ FlyWeb for Testing ಪುಟವನ್ನು ವೀಕ್ಷಿಸುತ್ತಿದ್ದೀರಿ</translation>
<translation id="6224789938625024797">FlyWeb ಅನ್ನು ಸರಿಯಾಗಿ ಸ್ಥಗಿತಗೊಳಿಸಲಾಗಿಲ್ಲ.</translation>
<translation id="3593104813552438879">FlyWeb ಸಲಹೆ: Lens ಮೂಲಕ ಹುಡುಕಿ</translation>
</translationbundle>