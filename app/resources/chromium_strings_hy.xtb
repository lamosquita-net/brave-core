<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1026101648481255140">Վերսկսել տեղադրումը</translation>
<translation id="7099479769133613710">Վերագործարկել՝ &amp;ChromeOS-ը թարմացնելու համար</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="6896681084876612310">FlyWeb-ը կարող է պաշտպանել տվյալների արտահոսքից, վնասաբեր ընդլայնումներից և այլ խնդիրներից</translation>
<translation id="1368460307421081773">FlyWeb-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="7307912249127683931">FlyWeb-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="4556715463645168547">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK"/>մտեք հաշիվ FlyWeb դիտարկիչում<ph name="END_LINK"/>։</translation>
<translation id="2076135703183650206">Սեղմեք FlyWeb-ի ընտրացանկը</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{FlyWeb-ի ընդլայնումներին հասանելի էին HID սարքեր}=1{FlyWeb-ի ընդլայնումներին հասանելի են HID սարքեր}one{FlyWeb-ի ընդլայնումներին հասանելի է # HID սարք}other{FlyWeb-ի ընդլայնումներին հասանելի է # HID սարք}}</translation>
<translation id="4380351562011537903">FlyWeb-ի մասին</translation>
<translation id="1203500561924088507">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME"/>-ն օգտագործելը դուք պետք է վերագործարկեք ձեր դիտարկիչը։</translation>
<translation id="4876991604685198381">Հիշողության տնտեսման շնորհիվ FlyWeb-ն ավելի արագ է դարձել</translation>
<translation id="4750836834956739196">Մինչ այս ներդիրն ակտիվ չէր, FlyWeb-ի աշխատանքի արագությունը պահպանելու համար տարածք է ազատվել։ Դուք կարող եք ընտրել, որ այս կայքը միշտ ակտիվ մնա։</translation>
<translation id="4549187150186083146">Կարգավորեք FlyWeb-ի ձեր նոր պրոֆիլը</translation>
<translation id="4150708158890309866">Դուք մուտք եք գործել FlyWeb:</translation>
<translation id="4713192356155907986">Ստանալ օգնություն FlyWeb for Testing-ի միջոցով</translation>
<translation id="8962360511570172">Կիսվեք FlyWeb-ի ներդիրով</translation>
<translation id="8196829963313696543">FlyWeb-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն՝ ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար։</translation>
<translation id="3961251277542681013">Դիտեք գաղտնիության և անվտանգության հիմնական կառավարման տարրերը FlyWeb-ում։</translation>
<translation id="1640672724030957280">Ներբեռնում…</translation>
<translation id="5579294097895667826">Մատչելի է FlyWeb-ի նոր, ավելի ապահով տարբերակ:</translation>
<translation id="2383861520542390014">Դուք կարող եք տեսնել և հեռացնել հետաքրքրությունները, որոնք կայքերն օգտագործում են՝ ձեզ գովազդ ցուցադրելու համար։ FlyWeb-ը որոշում է ձեր հետաքրքրությունները ձեր վերջին այցելությունների պատմության հիման վրա։</translation>
<translation id="5695205873161614119">FlyWeb-ը շուտով կջնջի դիտարկման տվյալները</translation>
<translation id="7385422968404728039">FlyWeb-ը կվերագործարկվի <ph name="REMAINING_TIME"/>ից</translation>
<translation id="307170399141486420">Թույլ տալ FlyWeb-ին աշխատել հետնաշերտում</translation>
<translation id="2473319786107120819">Նորից տեղադրել FlyWeb-ը</translation>
<translation id="2533324957407080119">FlyWeb-ը փորձում է <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6434738578659849497">Կայքերը կարող են ձեր հետաքրքրությունների մասին տեղեկություններ պահել FlyWeb-ում։ Օրինակ, եթե դուք այցելել եք ինչ-որ կայք՝ մարաթոնի համար վազքի կոշիկներ գնելու, այդ կայքը կորոշի, որ ձեզ հետաքրքրում է մարաթոնյան վազքը։ Ավելի ուշ, երբ դուք այցելեք մեկ այլ կայք՝ մրցավազքի համար գրանցվելու, այնտեղ կարող է վազքի կոշիկների գովազդ ցուցադրվել։</translation>
<translation id="4824940465467423308">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր FlyWeb պրոֆիլը: Ձեր FlyWeb տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները մշտապես կկցվեն <ph name="USER_NAME"/>-ին: Դուք կարող եք ջնջել այս տվյալները FlyWeb Dashboard-ի միջոցով, սակայն չեք կարող համակցել այս տվյալները այլ հաշվի հետ: Կարող եք ստեղծել նոր պրոֆիլ՝ ձեր առկա FlyWeb տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE"/></translation>
<translation id="3665070894458449212">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, FlyWeb-ը ձեր հարցումն ուղարկում է Google Drive-ին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="7390382558747224642">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ FlyWeb-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու FlyWeb:</translation>
<translation id="5714085538350759767">FlyWeb-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="4035053306113201399">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել ChromeOS-ը։</translation>
<translation id="1953553007165777902">Ներբեռնում… Մնաց <ph name="MINUTE"/> րոպե</translation>
<translation id="6956650624767954726">FlyWeb-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="6495079989036864983">1 տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք FlyWeb <ph name="USER_EMAIL"/> հաշվով:</translation>
<translation id="2018879682492276940">Չհաջողվեց տեղադրել։ Նորից փորձեք։</translation>
<translation id="4252651275570549255">Որպեսզի պաշտպանեք ձեր մյուս գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK"/>մտեք հաշիվ FlyWeb դիտարկիչում<ph name="END_LINK"/>։</translation>
<translation id="8544477465831682343">Ընտրեք, թե արդյոք ներառել FlyWeb-ի պատմությունը՝ FlyWeb-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="1868972292925460871">Տեղեկություններ այն մասին, թե ինչպես է FlyWeb-ը կառավարում իր արմատային հավաստագրերը</translation>
<translation id="6765231735885996239">Անհատականացնել FlyWeb-ը</translation>
<translation id="2174917724755363426">Տեղադրումը չի ավարտվել։ Իսկապե՞ս ուզում եք չեղարկել։</translation>
<translation id="2937508664417729967">FlyWeb – Ցանցի մուտք – <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">Եթե ձեզնից բացի որևէ այլ մեկն օգտվում է այս համակարգչից, օրինակ ձեր ընկերները կամ հարազատները, ապա նրանք կարող են առանձին աշխատել և կարգավորել FlyWeb-ն իրենց ուզած ձևով:</translation>
<translation id="5067150284614317159">Ստուգում է URL-ները FlyWeb-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, FlyWeb-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="3256927121768528350">Հեռախոսահամարն այստեղից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի FlyWeb դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="8776241960316471093">Այս ընդլայնումը փոխել է FlyWeb-ի մեկնարկի ժամանակ ցուցադրվող էջը:</translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="8418845734693287262">ChromeOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են։</translation>
<translation id="2100412893059179161">«<ph name="EXTENSION_NAME"/>» ընդլայնումը փոխել է FlyWeb-ի մեկնարկի ժամանակ ցուցադրվող էջը:</translation>
<translation id="1364879203203742966">Այս կայքի համար FlyWeb-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2451727308784734061">Արագ բացեք Գաղտնաբառերի կառավարիչը դյուրանցման միջոցով։ Դյուրանցումը կարող եք տեղափոխել համակարգչի հիմնական էկրան կամ հավելվածների գործարկիչ։</translation>
<translation id="3224379053610845181">FlyWeb-ը շուտով կփակվի</translation>
<translation id="3840682988105604367">FlyWeb-ի մեջ</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="6823116595279840454">FlyWeb-ը փորձում է փոխարինել գոյություն ունեցող գաղտնաբառերը։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="2691552788029831386">Ֆայլեր ներբեռնելու համար FlyWeb-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="2275866327478859777">FlyWeb օգնական</translation>
<translation id="7717615706977383025">Աշխատանքային պրոֆիլի ադմինիստրատորը կարող է ջնջել FlyWeb-ի բոլոր տվյալները, որոնք ստեղծվում են այս պրոֆիլի օգտագործման ընթացքում (օրինակ՝ էջանիշներ, պատմություն, գաղտնաբառեր և այլ կարգավորումներ)։ <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">Շարունակել FlyWeb-ի օգտագործումը</translation>
<translation id="3827993926722004004">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից տեղադրեք FlyWeb-ը:</translation>
<translation id="333184635927514678">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել FlyWeb-ը</translation>
<translation id="8991987934418988501">FlyWeb-ն արգելափակել է այս արխիվային ֆայլը, քանի որ այն կարող է վնասագրեր պարունակել</translation>
<translation id="1661841342483968180">Բարի գալուստ FlyWeb, <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">FlyWeb-ի ներդիր</translation>
<translation id="2796283369875688710">Լրացուցիչ անվտանգության համար FlyWeb-ը կգաղտնագրի ձեր տվյալները:</translation>
<translation id="2770231113462710648">Կանխադրված դիտարկիչը դարձնել՝</translation>
<translation id="7907238427168022751">Այս ընդլայնումը պարունակում է վնասագիր և վտանգավոր է։ Հեռացրեք ընդլայնումը FlyWeb-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="8990114339313395142"><ph name="USER_EMAIL_ADDRESS"/> օգտատիրոջ համար կստեղծվի FlyWeb-ի նոր պրոֆիլ։</translation>
<translation id="1339341044496643931">Հեռացնել FlyWeb-ից...</translation>
<translation id="4922993584046885552">Ապահովում է ձեր անվտանգությունը FlyWeb-ում և FlyWeb հավելվածներում, երբ մտել եք ձեր հաշիվ։</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="3806033752149316261">&amp;FlyWeb-ի մասին</translation>
<translation id="2915996080311180594">Վերագործարկել ավելի ուշ</translation>
<translation id="2928420929544864228">Տեղադրումն ավարտված է։</translation>
<translation id="1661079783259785361">FlyWeb-ը թարմացված է</translation>
<translation id="5447533789927384736">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, FlyWeb-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="1244955229468464260">FlyWeb-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Փորձեք ավելի ուշ։</translation>
<translation id="8841609317523323027">Ավելացվում է FlyWeb-ին…</translation>
<translation id="3038232873781883849">Սպասում ենք տեղադրմանը…</translation>
<translation id="7859502023458300952">Օգնեք բարելավել FlyWeb-ը՝ FlyWeb-ին ուղարկելով խափանման մասին հաշվետվությունները և <ph name="UMA_LINK"/>ը</translation>
<translation id="4133194854947529871">Ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով FlyWeb-ն ամեն ամիս ավտոմատ ջնջում է ձեր հետաքրքրությունները։ Հետաքրքրությունները կարող են թարմացվել, եթե դրանք չհեռացնեք։</translation>
<translation id="1407857531570256859">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք FlyWeb-ը:</translation>
<translation id="1309738977648134943">FlyWeb-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="6274649779206195384">FlyWeb-ի վերագործարկում</translation>
<translation id="6773570808762718524">Կարգավորեք FlyWeb-ի նոր պրոֆիլը</translation>
<translation id="2700572810650522793">FlyWeb-ը խափանվեց: Վերագործարկե՞լ:</translation>
<translation id="5449297306961970452">FlyWeb-ը չի կարող կարդալ և գրել իր տվյալների գրացուցակում՝

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="6755586344927335130">Տեղադրված է FlyWeb-ի <ph name="PRODUCT_VERSION"/> տարբերակը</translation>
<translation id="3286538390144397061">Վերագործարկել հիմա</translation>
<translation id="3900612994249740104">FlyWeb API-ի բանալիները չկան: FlyWeb-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="6824575001009586492">Շարունակել հետնաշերտի հավելվածների աշխատանքը, երբ FlyWeb-ը փակված է</translation>
<translation id="5399208721646088502">Այս հաշվի հետ կապված FlyWeb-ի պրոֆիլ արդեն գոյություն ունի</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">Անցնե՞լ FlyWeb-ի ընթացիկ պրոֆիլ</translation>
<translation id="3412460710772753638">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="847273641988291714">FlyWeb պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների, կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="1558345997029205345">FlyWeb-ը կտեղեկացնի ձեզ, երբ կոտրված գաղտնաբառ օգտագործեք։</translation>
<translation id="956833467923764542"><ph name="ITEMS_COUNT"/> տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք FlyWeb <ph name="USER_EMAIL"/> հաշվով:</translation>
<translation id="4772642827282964272">FlyWeb-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT"/> ստեղների համադրության միջոցով</translation>
<translation id="6724485219247982027">Փակեք FlyWeb-ի բոլոր պատուհանները և կրկին փորձեք:</translation>
<translation id="763231524941489073">Ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Որպեսզի FlyWeb-ը հաշվի չառնի որոշակի հետաքրքրությունները, կարող եք դրանք հեռացնել։</translation>
<translation id="4856314253538330936">Ձեր այցելությունների պատմությունը այն կայքերի ցանկն է, որոնք դուք այցելել եք FlyWeb-ի միջոցով այս սարքում։</translation>
<translation id="1054901839328542426">Ձեր համակարգչում վնասաբեր ծրագիր է հայտնաբերվել։ Ձեր դիտարկիչի կայուն աշխատանքը վերականգնելու համար FlyWeb-ը կարող է ջնջել ծրագիրը և վերականգնել ձեր կարգավորումները։</translation>
<translation id="199853864262219284">Դուք արդեն մեկ այլ հաշիվ եք մտել։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք FlyWeb-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="9154454584386840012">FlyWeb-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 10.15 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 10.13 տարբերակը։</translation>
<translation id="7465608402296261674">Հեռախոսահամարը <ph name="ORIGIN"/> կայքից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի FlyWeb դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="1543563097158722437">FlyWeb-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="190360428475385352">Իմանալ ավելին FlyWeb-ում գովազդի անհատականացման մասին</translation>
<translation id="6611602069520888180">Բացել հղումը FlyWeb-ի նոր &amp;ներդիրում</translation>
<translation id="8701399577028839698">FlyWeb-ը թույլ է տալիս սեղմել համացանցում գտնվող հեռախոսահամարի վրա և զանգահարել Skype-ով:</translation>
<translation id="2401189691232800402">ChromeOS համակարգ</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">ChromeOS-ի օգնության էջ</translation>
<translation id="1864899808802540927">Բացեք FlyWeb դիտարկիչի ձեր տվյալները <ph name="ACCOUNT_EMAIL"/> հաշվից</translation>
<translation id="2736927994658608637">FlyWeb-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 10.15 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 10.14 տարբերակը։</translation>
<translation id="5175060854726708547">FlyWeb-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="606156353708638647">Սեղմեք ձեր անվան վրա՝ FlyWeb-ը բացելու համար:</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/>-ն արդեն մուտք է գործել FlyWeb-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք FlyWeb-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="3470813199863172076">Այս ընդլայնումը խախտում է FlyWeb Web Store-ի քաղաքականությունը և կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը FlyWeb-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="3376157109651222096">Ձեր հաշիվը պատկանում է <ph name="MANAGER_NAME"/> տիրույթին: Ձեր ադմինիստրատորը կարող է տեսնել և խմբագրել FlyWeb դիտարկիչի այս պրոֆիլը և դրա տվյալները, օրինակ՝ էջանիշները, պատմությունը և գաղտնաբառերը։</translation>
<translation id="8536259619256229278">FlyWeb-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="4041003017438130352">FlyWeb-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել</translation>
<translation id="5667414856761616811">&amp;FlyWeb for Testing-ի մասին</translation>
<translation id="1152920704813762236">ChromeOS-ի մասին</translation>
<translation id="3703994572283698466">ChromeOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS"/>բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS"/> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS"/>Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS"/>։</translation>
<translation id="504994999924593940">Օգնեք կատարելագործել FlyWeb-ը՝ հաղորդելով <ph name="BEGIN_LINK"/>ընթացիկ կարգավորումների<ph name="END_LINK"/> մասին</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4055805654398742145">Գ&amp;աղտնաբառերի կառավարիչ</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է FlyWeb-ը, երբ այն 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է FlyWeb-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է FlyWeb-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}}</translation>
<translation id="4148957013307229264">Տեղադրում…</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> – Ցանցի մուտքի էջ – FlyWeb</translation>
<translation id="4007949387571083162">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի FlyWeb-ի համար:</translation>
<translation id="1595210458721188387">Այս լեզուն օգտագործվում է որպես FlyWeb-ի միջերեսի լեզու</translation>
<translation id="4222932583846282852">Չեղարկվում է…</translation>
<translation id="2564888740660198776">Կապել FlyWeb-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="8514458758262040082">FlyWeb-ի օգնության էջ</translation>
<translation id="3393587701694585022">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Եթե FlyWeb-ը բաց է, փակեք այն և կրկին փորձեք:</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4334294535648607276">Ներբեռնումն ավարտվեց:</translation>
<translation id="1068681683510904753">Ադմինիստրատորը (<ph name="MANAGER"/>) պահանջում է, որ դուք նախքան սարքն օգտագործելը կարդաք և ընդունեք հետևյալ Օգտագործման պայմանները։ Այս պայմանները չեն ընդլայնում, փոփոխում կամ սահմանափակում FlyWeb ChromeOS-ի պայմանները։</translation>
<translation id="1376968889000878095">Փակե՞լ FlyWeb-ը։</translation>
<translation id="6360389033094512399">Թույլատրել FlyWeb-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="4166347503469830337">Հարմարեցնել և վերահսկել FlyWeb-ը</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="8791209382165811772">FlyWeb for Testing-ի մասին</translation>
<translation id="834808339160590901">Բարի գալուստ FlyWeb․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="1304885695888649052">Անհայտ սխալի պատճառով չհաջողվեց թարմացնել FlyWeb-ը։ <ph name="BEGIN_LINK"/>Շտկել FlyWeb-ի թարմացման հետ կապված խնդիրները<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">Շարունակե՞լ FlyWeb-ի նոր պրոֆիլով</translation>
<translation id="4567424176335768812">Դուք մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS"/>: Այժմ կարող եք օգտագործել ձեր էջանիշները, պատմությունը և այլ կարգավորումները ձեր բոլոր մուտք գործած սարքերում:</translation>
<translation id="4594305310729380060">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="6046424510733540251">FlyWeb հավելվածներ</translation>
<translation id="4970880042055371251">ChromeOS-ի տարբերակը</translation>
<translation id="1936188352112244665">Գրեթե պատրաստ է: Վերագործարկեք FlyWeb-ը՝ թարմացումն ավարտելու համար:</translation>
<translation id="2962574118577609024">Եթե դուք նաև ուղարկում եք FlyWeb-ի օգտագործման մասին հաշվետվություններ, դրանցում կներառվեն ձեր այցելած URL-ները։</translation>
<translation id="9219132550163437762">Կարծես թե պրոֆիլն օգտագործվում է FlyWeb-ի այլ գործընթացի կողմից (<ph name="PROCESS_ID"/>) այլ համակարգչում (<ph name="HOST_NAME"/>): FlyWeb-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացների կողմից, կարող եք ապակողպել պրոֆիլը և նորից գործարկել FlyWeb-ը:</translation>
<translation id="4680828127924988555">Չեղարկել տեղադրումը</translation>
<translation id="5227023869666757348">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST"/> հասցեով մուտք է գործել FlyWeb: Ստեղծեք FlyWeb-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="1671154647029930623">Փակե՞լ FlyWeb-ը։</translation>
<translation id="4143239505982500022">FlyWeb-ի անվտանգության կարգավորումները հենց նոր թարմացվել են: Վերագործարկեք FlyWeb-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="1347247057384060764">Դուք ցանկացած ժամանակ FlyWeb-ի կարգավորումներում կարող եք փոխել ձեր ընտրությունը։ Փորձարկումներն ընթանում են գովազդի ցուցադրման ընթացիկ ռեժիմին զուգահեռ, ինչի արդյունքում փոփոխություններն անմիջապես տեսանելի չեն լինի ձեզ։</translation>
<translation id="4259200560913816786">FlyWeb-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք կամ <ph name="BEGIN_LINK"/>ստուգեք ձեր FlyWeb հաշվի գաղտնաբառերը<ph name="END_LINK"/>։</translation>
<translation id="3469649164996417993">Օգտագործվում է միևնույն ուղղագրիչը, ինչ FlyWeb Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են FlyWeb-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="2991144524835127379">Թույլատրել FlyWeb-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="6208903184719035736">Վերագործարկել՝ &amp;FlyWeb-ը թարմացնելու համար</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ FlyWeb-ը 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Առկա ներդիրները կմնան բաց։}one{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ FlyWeb-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Առկա ներդիրները կմնան բաց։}other{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ FlyWeb-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Առկա ներդիրները կմնան բաց։}}</translation>
<translation id="7174589544844983914">FlyWeb-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="7792628702371319769">Օգտագործելով FlyWeb-ը հյուրի ռեժիմում՝ դուք ոչ մի հետք չեք թողնում:</translation>
<translation id="2760069255902967585">Ավելացրեք ձեր հաշիվը FlyWeb-ին</translation>
<translation id="4239638419916712076">FlyWeb-ն ուսումնասիրում է նոր գործառույթները, որոնք կայքերին թույլ են տալիս տրամադրել դիտարկման նույն հնարավորությունները՝ ձեր մասին ավելի քիչ տեղեկություններ օգտագործելով։</translation>
<translation id="387444474697464273">Պահված գաղտնաբառեր չկան։ FlyWeb-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք։</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/>-ն արդեն մուտք է գործել FlyWeb-ի այս պրոֆիլը։ <ph name="USER_EMAIL_ADDRESS"/> օգտատիրոջ համար կստեղծվի FlyWeb-ի նոր պրոֆիլ։</translation>
<translation id="8295539942024823191">Փոփոխությունները կիրառելու համար վերագործարկեք FlyWeb-ը</translation>
<translation id="5374328929709976901">Եթե փորձնական գործառույթները միացված են, և FlyWeb-ը պատահականության սկզբունքով ձեզ ընտրում է ակտիվ փորձարկմանը մասնակցության համար, ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով FlyWeb-ը ամեն ամիս ջնջում է ձեր հետաքրքրությունները։</translation>
<translation id="8449603408481238073">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր FlyWeb պրոֆիլը: Ձեր FlyWeb-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկապվեն <ph name="USER_NAME"/>-ի հետ: Դուք կկարողանաք ջնջել այս տվյալները FlyWeb Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">FlyWeb-ի թարմացում (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">Թույլատրել մուտքը FlyWeb-ում</translation>
<translation id="5965500511473700110">Մատչելի է FlyWeb-ի նոր տարբերակը:</translation>
<translation id="1827750898515917134">Հեռացնել FlyWeb-ից</translation>
<translation id="5020755920249060562">Դարձնել FlyWeb-ը կանխադրված դիտարկիչը</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> – FlyWeb բետա</translation>
<translation id="5385202369020319636">FlyWeb-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Լինուքսի այս բաշխման մեջ։</translation>
<translation id="5957333939864770801">FlyWeb-ին այս կայքի համար անհրաժեշտ է ձեզ տեղորոշելու թույլտվություն</translation>
<translation id="780999790006298623">Ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Եթե FlyWeb-ը սխալ է որոշել ձեր հետաքրքրությունը, կամ դուք չեք ուզում տեսնել որոշակի գովազդներ, կարող եք հեռացնել հետաքրքրությունը։</translation>
<translation id="2183749398075655200">Սպասեք` մինչ FlyWeb-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="8996657165865563765">FlyWeb-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="5738298079259740925">Բացել PDF ֆայլեր FlyWeb-ում</translation>
<translation id="9197514179291669592">Երբ այս կարգավորումը միացված է, դուք նաև դուրս կգրվեք FlyWeb-ից</translation>
<translation id="6096945112863785306">{0,plural, =0{Հասանելի է FlyWeb-ի նոր տարբերակը}=1{Հասանելի է FlyWeb-ի նոր տարբերակը}one{FlyWeb-ի նոր տարբերակը # օր է հասանելի է}other{FlyWeb-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="5666891644992637849">Վերագործարկեք FlyWeb-ը</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">FlyWeb-ը ցուցադրել այս լեզվով</translation>
<translation id="8331941171144629807">Բարի գալուստ FlyWeb</translation>
<translation id="7581082856615467651">FlyWeb-ը այս տարրերում վնասագիր է հայտնաբերել՝</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> – Ցանցի մուտք</translation>
<translation id="5924017743176219022">Միացում համացանցին…</translation>
<translation id="5941711191222866238">Նվազեցնել</translation>
<translation id="483902194277448471">Եթե FlyWeb-ը պատահականության սկզբունքով ձեզ ընտրում է ակտիվ փորձարկմանը մասնակցության համար, ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով FlyWeb-ը ամեն ամիս ջնջում է ձեր հետաքրքրությունները։ Հետաքրքրությունները թարմացվում են, եթե դրանք չեք հեռացնում։</translation>
<translation id="348384176991400026">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է FlyWeb-ը, երբ այն 1 րոպե չի օգտագործվում։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է FlyWeb-ը, երբ այն # րոպե չի օգտագործվում։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է FlyWeb-ը, երբ այն # րոպե չի օգտագործվում։}}</translation>
<translation id="4955869506208896934">Թարմացրեք FlyWeb-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="63409513082302419">Սովորաբար կայքերը, որոնք դուք այցելում եք, հիշում են, թե ձեզ ինչն է հետաքրքրում, որպեսզի անհատականացնեն գովազդը ձեզ համար։ Կայքերը կարող են նաև ձեր հետաքրքրությունների մասին տեղեկություններ պահել FlyWeb-ում։</translation>
<translation id="6003112304606738118">Ներբեռնում… Մնաց <ph name="HOURS"/> ժամ</translation>
<translation id="6040143037577758943">Փակել</translation>
<translation id="2904199563401682369">Մատչելի է FlyWeb-ի նոր տարբերակ, որը շատ ավելի արագ է:</translation>
<translation id="8714139918792771260">&amp;Բացել FlyWeb-ում</translation>
<translation id="499541338626558192">«<ph name="EXTENSION_NAME"/>» ընդլայնումն ավելացվել է FlyWeb-ին</translation>
<translation id="3890023823480067024">Արագացրեք FlyWeb-ի աշխատանքը</translation>
<translation id="608006075545470555">Աշխատանքային պրոֆիլի ավելացում այս դիտարկիչում</translation>
<translation id="5880307616068888895">Հասանելի է FlyWeb-ի նոր տարբերակը։</translation>
<translation id="8890528681896757647">Երբ այս ռեժիմը միացված է, FlyWeb-ը տնտեսում է մարտկոցի լիցքը՝ սահմանափակելով աշխատանքը ֆոնային ռեժիմում և վիզուալ էֆեկտները, օրինակ՝ սահուն ոլորումը և տեսանյութերի կադրերի հաճախականությունը։</translation>
<translation id="1683225514126450592">Թույլատրել ընդլայնմանը մուտքի հարցումներ ցուցադրել FlyWeb-ի գործիքագոտում</translation>
<translation id="5171527334826689262">FlyWeb-ը կպահի այս գաղտնաբառը ձեր FlyWeb հաշվում: Գաղտնաբառը հիշելու կարիք չի լինի:</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> ֆայլը վտանգավոր է, և FlyWeb-ն արգելափակել է այն։</translation>
<translation id="1773252983747911987">FlyWeb-ը շուտով կփակվի և կջնջի տվյալները</translation>
<translation id="3063780243670578104">Անվտանգ դիտարկումն անջատված է։ FlyWeb-ը խորհուրդ է տալիս միացնել այն։</translation>
<translation id="1686760912855738719">Այստեղ կարող եք անցնել FlyWeb-ի այլ պրոֆիլի</translation>
<translation id="4403968929742079769">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME"/> սարքի FlyWeb դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="1855179706668101462">Այս համակարգչում արդեն տեղադրված է FlyWeb-ի ավելի նոր տարբերակը: Եթե ծրագրակազմը չի աշխատում, ապատեղադրեք FlyWeb-ը և նորից փորձեք:</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb-ը հիմա կվերագործարկվի}=1{FlyWeb-ը կվերագործարկվի 1 վայրկյանից}one{FlyWeb-ը կվերագործարկվի # վայրկյանից}other{FlyWeb-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="2586408713760853791">Ֆայլեր ներբեռնելու համար FlyWeb-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="1603558835003845196">Ստուգում է URL-ները FlyWeb-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="5751080530525677552">Դարձնել FlyWeb-ը կանխադրված դիտարկիչ</translation>
<translation id="4804111781678641302">FlyWeb-ը չի կարող ստուգել թարմացումների առկայությունը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="3542157007113577464">Դուրս գա՞լ FlyWeb-ից:</translation>
<translation id="6273793429163604305">Նախապատրաստում…</translation>
<translation id="3794967601634523398">Անհատականացնել FlyWeb-ի պրոֆիլը</translation>
<translation id="6475001900959697061">Անվանեք ձեր FlyWeb պրոֆիլը</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> ֆայլը կարող է վտանգավոր լինել, և FlyWeb-ն արգելափակել է այն։</translation>
<translation id="5523868569707953059">FlyWeb-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="5914697581312472089">FlyWeb-ն արգելափակել է այս ֆայլը, քանի որ այն վտանգավոր է</translation>
<translation id="6327105987658262776">Հասանելի թարմացումներ չկան։</translation>
<translation id="8226838065217375546">FlyWeb-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="6063700568539132984">Այժմ ավելի հեշտ է օգտագործել FlyWeb-ը ձեր FlyWeb հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="6890209090736444656">Հեռացնե՞լ FlyWeb-ը:</translation>
<translation id="6375219077595103062">Ավելացրեք Գաղտնաբառերի կառավարչի դյուրանցումը</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>Ինչպես ենք մենք օգտագործում այս տվյալները.<ph name="END_BOLD"/> FlyWeb-ը կարող է որոշել ձեր հետաքրքրությունները։ Ավելի ուշ կայքը, որն այցելում եք, կարող է FlyWeb-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։</translation>
<translation id="6636986997730784876">FlyWeb-ը վեբ դիտարկիչ է, որը կայծակի արագությամբ է բացում վեբէջերն ու հավելվածները: Այն արագ է, կայուն և պարզ՝ օգտագործման մեջ: Ավելի ապահով աշխատեք համացանցում՝ վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության շնորհիվ:</translation>
<translation id="2139300032719313227">Վերագործարկեք ChromeOS-ը</translation>
<translation id="173462352822069427">Բարի գալուստ FlyWeb պրոֆիլներ</translation>
<translation id="1474676525193357364">Այն նաև վերահսկում է, թե որ էջը ցուցադրվի FlyWeb-ը մեկնարկելիս:</translation>
<translation id="648319183876919572">Բարելավված Ապահով դիտարկումն օգնում է պաշտպանվել վտանգավոր կայքերից և ներբեռնումներից</translation>
<translation id="5777905264835557372">Ապատեղադրել FlyWeb-ը</translation>
<translation id="8852057261917278552">Ձեր կազմակերպությունը փակում է FlyWeb-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION"/>։ Այցելությունների պատմությունը ջնջվել է։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="8592211619057897362">Յուրաքանչյուր պրոֆիլում առանձին պահվում են FlyWeb-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="7489092380688543560">Դուք կարող եք դիտել գաղտնաբառերը՝ անցնելով մյուս FlyWeb պրոֆիլ</translation>
<translation id="8243012192239086369">Ուղղագրական սխալները շտկելու համար FlyWeb-ը FlyWeb-ին է ուղարկում տեքստային դաշտերում ձեր մուտքագրած տեքստը</translation>
<translation id="3927263773110604886">Անցնել FlyWeb-ի ծանուցումների կարգավորումներ</translation>
<translation id="6888846095017247017">Փոփոխություններն ուժի մեջ կմտնեն FlyWeb-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="1886169834787876002">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար FlyWeb-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="7640394575797555654">Կայքերը հավանաբար կաշխատեն պատշաճ կերպով, սակայն չեն պահպանի ձեր գործողությունները, երբ դուք փակեք FlyWeb-ի բոլոր պատուհանները</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="1363996462118479832">Մուտքի սխալի պատճառով ChromeOS-ը չկարողացավ համաժամացնել ձեր տվյալները։</translation>
<translation id="4152880912192471857">Այս կայքի համար FlyWeb-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="2193001403607253406">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն FlyWeb-ի նոր տարբերակից է:

Որոշ գործառույթներ մատչելի չեն լինի: Հատկորոշեք այլ պրոֆիլի գրացուցակ կամ օգտվեք FlyWeb-ի ավելի նոր տարբերակից:</translation>
<translation id="3260179770078760650">Հիշողության տնտեսման շնորհիվ FlyWeb-ն ավելի արագ է դարձել</translation>
<translation id="7728046102681268859">FlyWeb-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="7030752319019635064">FlyWeb-ի ձեր տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք և միացրեք համաժամացումը։</translation>
<translation id="1292831930742306370">FlyWeb-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել։</translation>
<translation id="5612302437680103875">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը FlyWeb-ում։ Այս <ph name="EXTENSION_TYPE_PARAMETER"/>ն արգելափակված է և չի կարող միացվել։</translation>
<translation id="1547295885616600893">ChromeOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS"/>բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS"/> հիման վրա։</translation>
<translation id="6432682256389755533">FlyWeb-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="178055475944027272">FlyWeb-ն արգելափակել է այս ֆայլը, քանի որ այն վնասագիր է պարունակում</translation>
<translation id="8852956515664182428">FlyWeb – <ph name="PAGE_TITLE"/></translation>
<translation id="5712993149989886097">Google Pay (պատճենվել է FlyWeb-ում)</translation>
<translation id="4695676871328690599">FlyWeb-ը «<ph name="EXTENSION_NAME"/>» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="76559364095325834">FlyWeb-ը թարմացվել է, սակայն դուք չեք օգտագործել այն առնվազն 30 օր:</translation>
<translation id="8524328905288851065">Զուգակցումը շարունակելու համար FlyWeb-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="5929819793040985066">Երբ փորձաշրջանները միացված են, գովազդի արդյունավետության գնահատումը թույլ է տալիս ձեր այցելած կայքերին ստանալ FlyWeb-ից տեղեկություններ, որոնք օգնում են չափել այդ կայքերում ցուցադրվող գովազդի արդյունավետությունը։ Գովազդի արդյունավետության գնահատումը սահմանափակում է օգտատերերի գործողությունների միջկայքային հետագծումը՝ նվազագույնի հասցնելով կայքերի միջև տեղեկությունների փոխանցումը։</translation>
<translation id="8806901087257994310">Ավելի ուշ կայքը, որն այցելում եք, կարող է FlyWeb-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։ FlyWeb-ը կարող է հասանելի դարձնել ձեր մինչև 3 հետաքրքրությունների մասին տեղեկությունները։</translation>
<translation id="2553796189989827248">Թույլ գաղտնաբառերը հեշտ է գուշակել։ Թույլատրեք FlyWeb-ին <ph name="BEGIN_LINK"/>գաղտնաբառեր ստեղծել և պահել ձեզ համար<ph name="END_LINK"/>։</translation>
<translation id="1749753408579541220">Երբ այս կարգավորումը միացված է, FlyWeb-ն ազատում է ոչ ակտիվ ներդիրների հիշողությունը։ Դրա շնորհիվ ակտիվ ներդիրներն ու մյուս հավելվածները համակարգչի ավելի շատ ռեսուրսներից են կարողանում օգտվել, իսկ FlyWeb-ը կարողանում է արագ աշխատել։ Ոչ ակտիվ ներդիրներն ավտոմատ կակտիվանան, երբ նորից սկսեք օգտագործել դրանք։</translation>
<translation id="3453763134178591239">ChromeOS-ի պայմաններ</translation>
<translation id="8545123476334328275">FlyWeb-ին այս կայքի համար անհրաժեշտ է ձեր խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="7025789849649390912">Տեղադրումը կանգնեցվել է։</translation>
<translation id="3945284827084409390">Թարմացնել FlyWeb-ը</translation>
<translation id="7886270027101123253">Եթե պատկերն օգտակար նկարագրություն չունի, FlyWeb-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են FlyWeb-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="6017914745388312119">Ձեր կազմակերպությունը ջնջում է FlyWeb-ի տվյալները, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION"/>։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="3283953248242339756">Այս կայքի համար FlyWeb-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="4729674580260824908">Չհաջողվեց գործարկել FlyWeb-ը։ Նորից փորձեք։</translation>
<translation id="9165925035484501889">FlyWeb-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք։</translation>
<translation id="1678436729108859736">Խնդիրների կառավարիչ - FlyWeb</translation>
<translation id="6135229048093148288">Ձեր հետաքրքրությունները (ըստ FlyWeb-ի)</translation>
<translation id="7641415053133771502">Գովազդի արդյունավետության գնահատումը թույլ է տալիս ձեր այցելած կայքերին ստանալ FlyWeb-ից տեղեկություններ, որոնք օգնում են չափել այդ կայքերում ցուցադրվող գովազդի արդյունավետությունը։ Գովազդի արդյունավետության գնահատումը սահմանափակում է օգտատերերի գործողությունների միջկայքային հետագծումը՝ նվազագույնի հասցնելով կայքերի միջև տեղեկությունների փոխանցումը։</translation>
<translation id="2866611433272355726">FlyWeb-ը թարմացվում է</translation>
<translation id="5013690772358862887">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

FlyWeb-ին չհաջողվեց վերականգնել ձեր կարգավորումները:</translation>
<translation id="7339898014177206373">Նոր պատուհան</translation>
<translation id="1123144153876435088">Բոլոր վեբէջերը, էջանիշները և FlyWeb-ի այլ տվյալները պահվում են այստեղ:</translation>
<translation id="6760192061736180746">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել FlyWeb-ը, որ <ph name="TARGET_URL_HOSTNAME"/> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME"/> դիտարկիչով։</translation>
<translation id="3225813655660631613">FlyWeb պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։Այդպես ավելի հեշտ է տարանջատել գործնական և անձնական նպատակներով օգտագործումը։</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> – FlyWeb Dev</translation>
<translation id="3787225360375979559">FlyWeb-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2431618580332826398">FlyWeb-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 7 տարբերակը։</translation>
<translation id="2154651873647244914">Վերագործարկե՞լ FlyWeb-ը</translation>
<translation id="3137757192868162370">Հնարավոր չէ տեղադրել FlyWeb-ի նույն տարբերակը, որն այժմ գործարկվում է: Փակեք FlyWeb-ը և նորից փորձեք:</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb-ը կվերագործարկվի 1 րոպեից}one{FlyWeb-ը կվերագործարկվի # րոպեից}other{FlyWeb-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="2706045239797506060">Ջնջել նաև FlyWeb-ի տվյալները (<ph name="URL"/>)</translation>
<translation id="5426732664223965459">FlyWeb-ը կարող է որոշել ձեր հետաքրքրությունները։ Ավելի ուշ կայքը, որն այցելում եք, կարող է FlyWeb-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/>-ի տեղադրիչ</translation>
<translation id="3067364763515000789">FlyWeb-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="1381291360713116383">FlyWeb-ը կատարելագործվել է</translation>
<translation id="7649070708921625228">Օգնություն</translation>
<translation id="481435825250648341">Ավելին այս գործառույթների մասին կարող եք իմանալ FlyWeb-ի կարգավորումներում։</translation>
<translation id="3079800650903360762">FlyWeb-ը ներկայացնում է նոր գործառույթներ, որոնք կայքերին թույլ են տալիս տրամադրել դիտարկման միևնույն հնարավորությունները՝ ձեր մասին ավելի քիչ տվյալներ օգտագործելով։</translation>
<translation id="2230101319599356673">FlyWeb-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="3243257760331619874">Համաժամացրեք և անհատականացրեք FlyWeb-ը ձեր բոլոր սարքերում</translation>
<translation id="1549877678317463759">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք FlyWeb <ph name="USER_EMAIL"/> հաշվով:</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="134973275687829726">Արագացրեք FlyWeb-ի աշխատանքը</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> – FlyWeb Canary</translation>
<translation id="8463540467315366872">Այս հաշվի հետ կապված FlyWeb-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="7845233973568007926">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME"/>-ն օգտագործելը դուք պետք է վերագործարկեք ձեր համակարգիչը։</translation>
<translation id="4766381896251401675">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, FlyWeb-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="8611872055947278722">Չհաջողվեց տեղադրել FlyWeb-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="7872446069773932638">Ներբեռնում… Մնաց <ph name="SECONDS"/> վայրկյան</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>Ինչպես կարող եք կառավարել ձեր տվյալները.<ph name="END_BOLD"/> ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Որպեսզի FlyWeb-ը հաշվի չառնի որոշակի հետաքրքրությունները, կարող եք դրանք հեռացնել։</translation>
<translation id="3096730275883527801">Դուք մուտք եք գործել FlyWeb որպես <ph name="USER_EMAIL_ADDRESS"/>: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="9017338699075596174">Սա FlyWeb-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="5944585442866020176">Երբ FlyWeb-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="80471789339884597">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME"/>-ն օգտագործելը դուք պետք է վերագործարկեք ձեր բոլոր դիտարկիչները։</translation>
<translation id="3263664073045388929">Այս կայքի համար FlyWeb-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="5334309298019785904">ChromeOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ այդ գործառույթը հասանելի չէ ձեր տիրույթի համար։</translation>
<translation id="813913629614996137">Նախապատրաստվում է...</translation>
<translation id="1597323875619800374">Այս ֆայլը վտանգավոր է, և FlyWeb-ն արգելափակել է այն։</translation>
<translation id="8455485678130879158">FlyWeb-ն արգելափակել է այս ֆայլը, քանի որ ֆայլի այս տեսակը վտանգավոր է։</translation>
<translation id="6756872644564483342">Եթե պատկերն օգտակար նկարագրություն չունի, FlyWeb-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են FlyWeb-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="5792785787074426346">FlyWeb-ը չի կարող ստուգել ձեր գաղտնաբառերը, քանի որ դուք հաշիվ չեք մտել։</translation>
<translation id="6627585369674499881">Այս ֆայլը կարող է վտանգավոր լինել, և FlyWeb-ն արգելափակել է այն։</translation>
<translation id="208266011144024011">Ձեր կազմակերպությունը փակում է FlyWeb-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION"/>։</translation>
<translation id="3542611917357881417">Արեք ավելին FlyWeb-ի միջոցով</translation>
<translation id="5565286784156841599">Մտեք հաշիվ՝ FlyWeb-ը ձեր բոլոր սարքերում անհատականացնելու համար</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/>-ը նախկինում FlyWeb է օգտագործել</translation>
<translation id="5975370349701995302">FlyWeb դիտարկիչի ձեր տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք և միացրեք համաժամացումը</translation>
<translation id="7408894216012529448">FlyWeb-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8 տարբերակը։</translation>
<translation id="7256356679044945328">Այս ընդլայնման հրապարակումը չեղարկվել է մշակողի կողմից, և այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը FlyWeb-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="5261590792975521002">{0,plural, =1{Վերագործարկեք FlyWeb-ը մեկ օրվա ընթացքում}one{Վերագործարկեք FlyWeb-ը # օրվա ընթացքում}other{Վերագործարկեք FlyWeb-ը # օրվա ընթացքում}}</translation>
<translation id="3101564993057563365">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք FlyWeb-ը:</translation>
<translation id="5316851838033144902">FlyWeb-ի համար պահանջվում է Windows 10 կամ ավելի նոր տարբերակ։</translation>
<translation id="6760691951531758781">Ըստ ցանկության. օգնեք բարելավել ChromeOS-ի գործառույթներն ու աշխատանքը՝ FlyWeb-ին ավտոմատ կերպով ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="6852836260419236265">FlyWeb-ը հնացած է</translation>
<translation id="8550334526674375523">Այս աշխատանքային պրոֆիլն ամբողջովին առանձնացված է ձեր անձնական պրոֆիլից։</translation>
<translation id="538636623826336032">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը FlyWeb-ում։ Այս <ph name="EXTENSION_TYPE_PARAMETER"/>ն արգելափակված է և չի կարող ավելացվել։</translation>
<translation id="8842078659829047498">FlyWeb-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ մտնեք ձեր FlyWeb հաշիվ։</translation>
<translation id="8121009781989288430">© <ph name="YEAR"/> Brave Software Inc: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="6539417028609632917"><ph name="BEGIN_BOLD"/>Ինչպես ենք մենք օգտագործում այս տվյալները.<ph name="END_BOLD"/> կայքերը կարող են ձեր հետաքրքրությունների մասին տեղեկություններ պահել FlyWeb-ում։ Օրինակ, եթե դուք այցելել եք ինչ-որ կայք՝ մարաթոնի համար վազքի կոշիկներ գնելու, այդ կայքը կորոշի, որ ձեզ հետաքրքրում է մարաթոնյան վազքը։ Ավելի ուշ, երբ դուք այցելեք մեկ այլ կայք՝ մրցավազքի համար գրանցվելու, այնտեղ կարող է վազքի կոշիկների գովազդ ցուցադրվել։</translation>
<translation id="7129578417724116642">FlyWeb-ի գործարկում...</translation>
<translation id="781795332371306113">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Նորից ներբեռնեք FlyWeb-ը:</translation>
<translation id="5469043671012993003">FlyWeb for Testing-ը չի կարող դառնալ ձեր կանխադրված դիտարկիչը։</translation>
<translation id="1074759999845943804">{NUM_DEVICES,plural, =0{FlyWeb-ի ընդլայնմանը հասանելի էին HID սարքեր}=1{FlyWeb-ի ընդլայնմանը հասանելի է 1 HID սարք}one{FlyWeb-ի ընդլայնմանը հասանելի է # HID սարք}other{FlyWeb-ի ընդլայնմանը հասանելի է # HID սարք}}</translation>
<translation id="1514450422236300417">Այն նաև վերահսկում է FlyWeb-ի մեկնարկի կամ Omnibox-ից որոնում կատարելու ժամանակ ցուցադրվող էջը:</translation>
<translation id="573490495087487940">Սա ձեր FlyWeb-ն է</translation>
<translation id="6779439179813982247">FlyWeb-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն ու խոսափողը օգտագործելու թույլտվություն</translation>
<translation id="8826492472752484139">Սեղմեք «Գաղտնաբառերի կառավարիչ»</translation>
<translation id="6933858244219479645">ChromeOS համակարգ</translation>
<translation id="7354175404728814475"><ph name="BEGIN_BOLD"/>Ինչ տվյալներ են օգտագործվում.<ph name="END_BOLD"/> ձեր այցելությունների պատմությունը այն կայքերի ցանկն է, որոնք դուք այցելել եք FlyWeb-ի միջոցով այս սարքում։</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="709828993049448700">Եթե այո, ապա փոխեք ձեր պահված գաղտնաբառը FlyWeb-ում, որպեսզի այն համապատասխանի ձեր նոր գաղտնաբառին։</translation>
<translation id="1446416109379198698">Այն նաև վերահսկում է FlyWeb-ը մեկնարկելիս և Սկիզբ կոճակը սեղմելիս ցուցադրվող էջերը:</translation>
<translation id="4669168852412989042">FlyWeb-ը փորձում է ցուցադրել գաղտնաբառերը: Մուտքագրեք ձեր Windows-ի գաղտնաբառը՝ այս գործողությունը թույլ տալու համար:</translation>
<translation id="1343885466359249904">FlyWeb-ը որոշում է ձեր հետաքրքրությունները վերջին մի քանի շաբաթվա ընթացքում ձեր այցելությունների պատմության հիման վրա։ Այս տեղեկությունները չեն փոխանցվում ձեր սարքից։</translation>
<translation id="1663379621921336006">Չհաջողվեց թարմացնել FlyWeb-ը</translation>
<translation id="543915850302643692">FlyWeb Enterprise-ի լոգո</translation>
<translation id="8986207147630327271">Դուք ավելացնում եք աշխատանքային պրոֆիլ այս դիտարկիչում և միայն դրա վերահսկողությունը տրամադրում ադմինիստրատորին։</translation>
<translation id="5804408305184682593">Մուտք գործել FlyWeb</translation>
<translation id="8692043725449223663">Մուտք գործեք FlyWeb։ Եթե ուզում եք միայն մեկ անգամ մուտք գործել հաշիվ, կարող եք <ph name="GUEST_LINK_BEGIN"/>օգտագործել սարքը որպես հյուր<ph name="GUEST_LINK_END"/>։</translation>
<translation id="8323442969389928559">FlyWeb-ն ավտոմատ փակվել է</translation>
<translation id="7626272203917389133">FlyWeb-ը հնացել է</translation>
<translation id="1789655708880997767">{0,plural, =1{FlyWeb-ը կվերագործարկվի մեկ ժամից}one{FlyWeb-ը կվերագործարկվի # ժամից}other{FlyWeb-ը կվերագործարկվի # ժամից}}</translation>
<translation id="8970147445441095618">FlyWeb-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8.1 տարբերակը։</translation>
<translation id="1208237657860748752">Բացել հղումը FlyWeb-ի նոր &amp;ներդիրում</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="1899793037348288257">Փորձարկումների ընթացքում դուք կարող եք տեսնել և հեռացնել հետաքրքրությունները, որոնք կայքերն օգտագործում են ձեզ գովազդ ցուցադրելու համար։ FlyWeb-ը որոշում է ձեր հետաքրքրությունները ձեր վերջին այցելությունների պատմության հիման վրա։</translation>
<translation id="3926534790663909774">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել FlyWeb-ը, որ <ph name="TARGET_URL_HOSTNAME"/> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="5022081608392609959">Վերագործարկել՝ &amp;FlyWeb-ը թարմացնելու համար</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Անհատականացրեք FlyWeb-ը</translation>
<translation id="3410331617397516204">FlyWeb-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Windows XP և Windows Vista համակարգերում</translation>
<translation id="1641772209502041092">FlyWeb-ի կողմից կառավարվող հավաստագրեր</translation>
<translation id="1127626874097952395">Ո՞վ է օգտագործում FlyWeb-ը</translation>
<translation id="1626113414414104077">Ուժեղացրեք FlyWeb-ի անվտանգությունը</translation>
<translation id="2952628102760787868">Միշտ մաքրել կայքերի տվյալները սարքից՝ FlyWeb-ը փակելու դեպքում</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="137466361146087520">Google Chrome Բետա</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="4434689349450618970">Եթե ուզում եք այս հաշիվն օգտագործել միայն մեկ անգամ, միացրեք <ph name="GUEST_LINK_BEGIN"/>հյուրի ռեժիմը<ph name="GUEST_LINK_END"/> FlyWeb դիտարկիչում։ Եթե ուզում եք հաշիվ ավելացնել մեկ ուրիշի համար, <ph name="LINK_BEGIN"/>ավելացրեք նոր օգտատեր<ph name="LINK_END"/> ձեր <ph name="DEVICE_TYPE"/> սարքում։

Թույլտվությունները, որոնք տրամադրել եք կայքերին և հավելվածներին, կարող են կիրառվել այս հաշվի նկատմամբ։ Ձեր FlyWeb հաշիվները կարող եք կառավարել <ph name="SETTINGS_LINK_BEGIN"/>Կարգավորումներում<ph name="SETTINGS_LINK_END"/>։</translation>
<translation id="2725795635123877647">Անհայտ աղբյուրներից ընդլայնումները, հավելվածներն ու թեմաները կարող են վնասել ձեր սարքը։ FlyWeb-ը խորհուրդ է տալիս դրանք տեղադրել միայն <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>-ից։</translation>
<translation id="5382847955032513683">Ուշադրություն․ FlyWeb-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="543905389684998697">FlyWeb-ն ավելի ապահով դարձնելու համար որոշ ընդլայնումներ, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>-ում և կարող են ավելացվել առանց ձեր իմացության, անջատվել են:</translation>
<translation id="3914570680366033593">FlyWeb-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>-ում և կարող են ավելացված լինել առանց ձեր իմացության:</translation>
<translation id="3293172835368652510">Այս օգտատիրոջ այցելությունների պատմությունը կհեռացվի այս սարքից։ Տվյալները վերականգնելու համար <ph name="USER_EMAIL"/> հաշվով մուտք գործեք FlyWeb-ում։</translation>
<translation id="2742103213766991703">Բացել հղումը FlyWeb-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="1616978953472841483">Բացել հղումը FlyWeb-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{FlyWeb-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{FlyWeb-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{FlyWeb-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{FlyWeb-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել FlyWeb-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել FlyWeb-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել FlyWeb-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել FlyWeb-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել FlyWeb-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել FlyWeb-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել FlyWeb-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել FlyWeb-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="4630629063306099328">Դուք կարող եք կառավարել ձեր FlyWeb հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են FlyWeb դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE"/> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN"/>Իմանալ ավելին<ph name="LINK_END"/></translation>
</translationbundle>
