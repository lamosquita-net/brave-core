+const CSSValue* ViewTransitionClass::ParseSingleValue(
+    CSSParserTokenRange& range,
+    const CSSParserContext& context,
+    const CSSParserLocalContext&) const {
+  // FlyWeb (Chromium 125). The valid syntax is `none | <custom-ident>+` where
+  // the list of custom idents can't include `none`.
+  if (range.Peek().Id() == CSSValueID::kNone) {
+    return css_parsing_utils::ConsumeIdent(range);
+  }
+  CSSValueList* list = CSSValueList::CreateSpaceSeparated();
+  while (!range.AtEnd() && range.Peek().Id() != CSSValueID::kNone) {
+    CSSCustomIdentValue* class_name =
+        css_parsing_utils::ConsumeCustomIdent(range, context);
+    if (!class_name) {
+      break;
+    }
+    list->Append(*class_name);
+  }
+  if (!list->length()) {
+    return nullptr;
+  }
+  return list;
+}
