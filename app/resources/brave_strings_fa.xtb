<translation id="6360389033094512399">‏اجازه به FlyWeb برای اجرا در پس‌زمینه</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{‏‫FlyWeb توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}one{‏‫FlyWeb توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}other{‏‫FlyWeb توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">‏سفارشی کردن و کنترل FlyWeb</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR"/></translation>
<translation id="1198322798411238228">‏‫<ph name="MANAGER"/> ‏FlyWeb را مدیریت می‌کند</translation>
<translation id="6643422079097100220">‏افزودن نمایه FlyWeb</translation>
<translation id="8791209382165811772">‏درباره FlyWeb for Testing</translation>
<translation id="5651107152880556886">‏برای ذخیره کردن داده‌های FlyWeb در «حساب FlyWeb» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="3546782282376530369">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫FlyWeb توصیه می‌کند آن را حذف کنید.</translation>
<translation id="834808339160590901">‏به FlyWeb خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="5094033276783634414">‏‫FlyWeb برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="3363095592946520579">‏قبلاً با <ph name="USER_EMAIL_ADDRESS"/> در نمایه FlyWeb دیگری به سیستم وارد شده‌اید</translation>
<translation id="8767255662414713095">‏‫FlyWeb صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK"/>درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">وقتی سایتی را که فکر می‌کنید مضر است گزارش می‌کنید، به بهبود ایمنی آنلاین برای همه کمک می‌کنید.</translation>
