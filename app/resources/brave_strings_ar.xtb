<translation id="2866611433272355726">‏تحديث FlyWeb</translation>
<translation id="5013690772358862887">‏ملف الإعدادات المفضّلة تالف أو غير صالح.

يتعذر على FlyWeb استعادة إعداداتك.</translation>
<translation id="7324051657739063017">يمكنك إعادة فتح "المهام السياقية" لطرح الأسئلة أثناء التصفّح</translation>
<translation id="1123144153876435088">‏الويب والإشارات المرجعية وغيرها من عناصر FlyWeb توجد هنا.</translation>
<translation id="8915041713909379783">‏لا يمكن لأحد الوصول إلى بياناتك المشفّرة بدون استخدام عبارة المرور. ولا تحصل FlyWeb على عبارة المرور هذه أو تخزّنها. وفي حال نسيتها أو أردت تغيير هذه الإعدادات، يجب <ph name="BEGIN_LINK"/>حذف بيانات FlyWeb في حسابك<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">‏ضَبَط مشرف النظام FlyWeb لفتح <ph name="ALTERNATIVE_BROWSER_NAME"/> للوصول إلى <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">حدث خطأ</translation>
<translation id="7601756527349047847">‏للحصول على تحديثات FlyWeb في المستقبل، يجب استخدام كمبيوتر يعمل بنظام التشغيل macOS 13 أو إصدار أحدث. ويعمل هذا الكمبيوتر بنظام التشغيل macOS 12.</translation>
<translation id="3916387280110223245">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال FlyWeb إذنَي <ph name="PERMISSION_1"/> و<ph name="PERMISSION_2"/>.</translation>
<translation id="3313237823190188892">‏عرض "Gemini في FlyWeb" في لوحة النظام</translation>
<translation id="7401687852903179959">البحث عن هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="6624551989332401777">‏تم ضبط FlyWeb كمتصفّحك التلقائي</translation>
<translation id="277733508197886564">‏المتابعة من حيث توقفت: يمكن لمتصفّح FlyWeb استعادة علامات التبويب كلما أعدت تشغيله. لإيقاف هذه الميزة، يُرجى الانتقال إلى</translation>
<translation id="948152006162936800">‏استيراد كلمات المرور إلى FlyWeb</translation>
<translation id="4755314372270379254">‏‫1. انقر على <ph name="BUTTON_LABEL"/> أدناه
‫2. انقر على <ph name="BUTTON_2"/> في إعدادات Windows
‫3. انقر على <ph name="BUTTON_3"/> في إشعار Windows لتثبيت FlyWeb في شريط التطبيقات والوصول إليه بسرعة</translation>
<translation id="2971917489215408838">‏<ph name="PAGE_TITLE"/> - إصدار قناة مطوري البرامج من FlyWeb</translation>
<translation id="7450541714075000668">تم نسخ النص.</translation>
<translation id="7472280958921965834">‏لاستخدام الميكروفون، يجب منح FlyWeb إذن الوصول في <ph name="BEGIN_LINK"/>إعدادات النظام<ph name="END_LINK"/></translation>
<translation id="2431618580332826398">‏للحصول على تحديثات FlyWeb في المستقبل، يجب استخدام جهاز يعمل بنظام التشغيل Windows 10 أو إصدار أحدث. يعمل هذا الكمبيوتر بنظام التشغيل Windows 7.</translation>
<translation id="2154651873647244914">‏هل تريد إعادة تشغيل FlyWeb؟</translation>
<translation id="3137757192868162370">‏لا يمكن تثبيت إصدار FlyWeb ذاته الذي يتم تشغيله حاليًا. يُرجى إغلاق FlyWeb وإعادة المحاولة.</translation>
<translation id="3065486555702061722">‏تذكير: أفضل ما تقدّمه FlyWeb في متناول يدك</translation>
<translation id="4027434552262956425">‏من المحتمل أن تعمل المواقع الإلكترونية على النحو المتوقَّع. وسيتم تسجيل خروجك من معظم المواقع الإلكترونية عند إغلاق جميع نوافذ FlyWeb، باستثناء حسابك على FlyWeb إذا كنت مسجلاً الدخول إلى FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{‏ستتم إعادة تشغيل FlyWeb في غضون دقيقة واحدة}zero{‏ستتم إعادة تشغيل FlyWeb في غضون # دقيقة}two{‏ستتم إعادة تشغيل FlyWeb في غضون دقيقتين}few{‏ستتم إعادة تشغيل FlyWeb في غضون # دقائق}many{‏ستتم إعادة تشغيل FlyWeb في غضون # دقيقةً}other{‏ستتم إعادة تشغيل FlyWeb في غضون # دقيقة}}</translation>
<translation id="301074550630080641">‏لحماية بياناتك، يمكنك السماح لمتصفِّح FlyWeb بإزالة الأذونات من المواقع الإلكترونية التي لم تتم زيارتها مؤخرًا.</translation>
