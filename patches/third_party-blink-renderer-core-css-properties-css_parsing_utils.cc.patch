+    const CSSParserToken* start = channels.begin();
+    channels.ConsumeComponentValue();
+    if (!text.empty() && text[text.length() - 1] != ' ') {
+      text.Append(' ');
+    }
+    text.Append(channels.MakeSubRange(start, channels.begin()).Serialize());
+    channels.ConsumeWhitespace();
+  }
+  return MakeGarbageCollected<cssvalue::CSSRelativeColorValue>(
+      *origin_value, function_id, text.ReleaseString());
