<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="130631256467250065">تغییرات بار بعد که دستگاه راه‌اندازی می‌شود اعمال می‌شوند.</translation>
<translation id="1555506416658437797">ویرایش روش‌های پرداخت.</translation>
<translation id="8359495463485001719">‏گزارش خرابی در FlyWeb موجود نیست.</translation>
<translation id="6338530717474923868">‏درحال مشاهده یک صفحه FlyWeb امن هستید</translation>
<translation id="5147169001159408844">‏Chromebook می‌خواهد تنظیمات تکمیل روش‌های پرداخت را اصلاح کند.</translation>
<translation id="5702992568540613683">‏نشان‌واره FlyWeb</translation>
<translation id="510342522494506803">‏FlyWeb می‌خواهد روش‌های پرداخت را ویرایش کند.</translation>
<translation id="8375862260948854624">‏FlyWeb با پروژه منبع باز <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb <ph name="END_LINK_CHROMIUM"/> و سایر <ph name="BEGIN_LINK_OSS"/>نرم‌افزار منبع باز<ph name="END_LINK_OSS"/> امکان‌پذیر است.</translation>
<translation id="4281953335231207224">‏به
         منوی FlyWeb  &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          تنظیمات LAN
          بروید و علامت کادر انتخاب «استفاده از سرور پراکسی برای LAN خود» را بردارید.</translation>
<translation id="5040124620086808431">‏این صفحه را FlyWeb مسدود کرده است</translation>
<translation id="1953000035868532675">‏در تنظیمات دیوار آتش و ضدویروستان، به FlyWeb اجازه دسترسی به شبکه را
          بدهید.</translation>
<translation id="3442058224540562441">‏به
          منوی FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          بروید و مطمئن شوید که تنظیمات بر روی «بدون پراکسی» یا «مستقیم» است.</translation>
<translation id="585620188971323280">تنظیمات تکمیل روش‌های پرداخت را اصلاح کند.</translation>
<translation id="2681118099728446983">‏ارائه FlyWeb ازطریق <ph name="BEGIN_LINK_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_OSS"/> دیگر نیز ممکن شده است.</translation>
<translation id="6888846095017247017">‏دفعه بعدی که FlyWeb را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="1017070759373671177">‏ارائه FlyWeb ازطریق پروژه متن‌باز <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ممکن شده است.</translation>
<translation id="7777112741998051633">‏به
          منوی FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          بروید و علامت «<ph name="NO_PREFETCH_DESCRIPTION"/>» را بردارید.
          درصورتی‌که با این کار مشکل حل نشد، توصیه می‌کنیم برای عملکرد بهبودیافته،
          این گزینه را دوباره انتخاب کنید.</translation>
<translation id="8187289872471304532">به
          برنامه‌ها &gt; 
موارد برگزیده سیستم &gt; شبکه &gt; پیشرفته &gt; پراکسی‌ها
بروید و علامت تمام پراکسی‌های انتخاب شده را بردارید.</translation>
<translation id="4699594416850504200">‏درحال مشاهده یکی از صفحه‌های امن FlyWeb for Testing هستید</translation>
<translation id="6224789938625024797">‏FlyWeb به درستی خاموش نشده است.</translation>
