+// FlyWeb (engine level 127, Chromium 24decde21a6): the viewport for
+// userSpaceOnUse SVG filters on HTML content is the border box (the lines box
+// of an inline), as in Gecko.
+static absl::optional<gfx::SizeF> ComputeFilterViewport(
+    const PaintLayer& layer) {
+  if (const auto* layout_inline =
+          DynamicTo<LayoutInline>(layer.GetLayoutObject())) {
+    return gfx::SizeF(layout_inline->PhysicalLinesBoundingBox().size);
+  }
+  const auto* box = layer.GetLayoutBox();
+  if (box->IsSVGForeignObject()) {
+    return absl::nullopt;
+  }
+  return gfx::SizeF(box->Size());
+}
