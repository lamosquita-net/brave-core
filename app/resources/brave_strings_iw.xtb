<translation id="8117102597407263352">‏FlyWeb בודק בקביעות כדי לוודא שלדפדפן יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
<translation id="5895138241574237353">הפעלה מחדש</translation>
<translation id="7740963625398321937">‏‫Gemini Enterprise ב-FlyWeb</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> – כניסה לרשת</translation>
<translation id="5924017743176219022">מתבצעת התחברות לאינטרנט…</translation>
<translation id="5941711191222866238">מזעור</translation>
<translation id="6669708050135513710">‏כדי לקבל גישה לסימניה הזו ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-FlyWeb</translation>
<translation id="3358004031263458708">‏התאמה אישית של FlyWeb</translation>
<translation id="5960071705175224773">ההגדרות שלך שונו על ידי אפליקציה לא ידועה</translation>
<translation id="5977420883993828287">התכונה הוצמדה. מעכשיו אפשר להשתמש ב"משימות לפי הקשר" דרך סרגל הכלים</translation>
<translation id="348384176991400026">{COUNT,plural, =1{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך דקה.}one{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}two{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}other{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}}</translation>
<translation id="4955869506208896934">‏יש לעדכן את FlyWeb כדי להתחיל את הסנכרון</translation>
<translation id="5990360079535151574">כדי לשאול שאלות תוך כדי גלישה, אפשר ללחוץ על הכפתור משימות לפי הקשר שבסרגל הכלים ולפתוח את החלונית מחדש</translation>
<translation id="6003112304606738118">מתבצעת הורדה… יש עוד <ph name="HOURS"/> שע'</translation>
<translation id="6009821354356307391">הוספה של שאילתת המשך</translation>
<translation id="6040143037577758943">סגירה</translation>
<translation id="4530644097272078700">‏עם אפליקציית FlyWeb במכשיר <ph name="DEVICE_TYPE"/> אפשר ליהנות עוד יותר מהקניות באינטרנט</translation>
<translation id="619330138913595431">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-FlyWeb להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="8714139918792771260">‏&amp;פתיחה ב-FlyWeb</translation>
<translation id="6069027071882229820">העתקה כתמונה</translation>
<translation id="499541338626558192">‏<ph name="EXTENSION_NAME"/> נוסף ל-‏FlyWeb‏</translation>
<translation id="5880307616068888895">‏כדי להתאים אישית את FlyWeb ולשלוט בו טוב יותר, כדאי להוריד את העדכון החדש.</translation>
<translation id="1429530657225981960">‏מופעל • FlyWeb לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="8056369489402655495">‏החשבון שלך ב-FlyWeb</translation>
<translation id="1683225514126450592">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של FlyWeb</translation>
<translation id="4809579265564854985">‏<ph name="FILE_NAME"/> מסוכן, ולכן FlyWeb חסם אותו.</translation>
<translation id="1773252983747911987">‏FlyWeb ייסגר בקרוב והנתונים שבו יימחקו</translation>
<translation id="1686760912855738719">‏כאן ניתן לעבור בין פרופילים של FlyWeb</translation>
<translation id="5461795497268691356">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת FlyWeb תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="6165508094623778733">למידע נוסף</translation>
<translation id="1292852397592425449">‏צריך למחוק את נתוני FlyWeb בחשבון</translation>
<translation id="7031783851441272920">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK"/>דפדפן FlyWeb יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של FlyWeb', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="4403968929742079769">‏יש לוודא שנכנסת ל-FlyWeb ב-<ph name="TARGET_DEVICE_NAME"/> שלך ולשלוח שוב.</translation>
<translation id="8345188246355148375">‏הקלדת חיפושים ושאלות מכל מקום במכשיר, גם אם FlyWeb ממוזער ההגדרה מאפשרת ל-FlyWeb לפעול ברקע.</translation>
<translation id="1855179706668101462">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של FlyWeb. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של FlyWeb ולנסות שוב.</translation>
<translation id="651290634887454330">{0,plural, =0{‏FlyWeb יופעל מחדש עכשיו}=1{‏FlyWeb יופעל מחדש בעוד שנייה אחת}one{‏FlyWeb יופעל מחדש בעוד # שניות}two{‏FlyWeb יופעל מחדש בעוד # שניות}other{‏FlyWeb יופעל מחדש בעוד # שניות}}</translation>
<translation id="2586408713760853791">‏נדרשת הרשאת גישה לאחסון ב-FlyWeb כדי להוריד קבצים</translation>
<translation id="1603558835003845196">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-FlyWeb</translation>
<translation id="5751080530525677552">‏יש להפוך את FlyWeb לדפדפן ברירת המחדל</translation>
<translation id="6248988683584659830">חיפוש בהגדרות</translation>
<translation id="6342238100521499844">‏כשאפליקציית FlyWeb מותקנת בטלפון שלך, תכונות הבטיחות הטובות ביותר של FlyWeb מלוות אותך לכל מקום</translation>
<translation id="3542157007113577464">‏האם לצאת מ-FlyWeb?</translation>
<translation id="2166321493116256664">‏הכרטיסיות האלה משתמשות במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-FlyWeb להשבית אותן.</translation>
<translation id="3794967601634523398">‏התאמה אישית של פרופיל FlyWeb</translation>
<translation id="6475001900959697061">‏בחירת שם לפרופיל FlyWeb שלך</translation>
<translation id="6356094940346377065">‏תוסף מבקש ממך להיכנס ל-FlyWeb</translation>
<translation id="4465156155012748592">‏<ph name="FILE_NAME"/> עלול להיות מסוכן, ולכן FlyWeb חסם אותו.</translation>
<translation id="5523868569707953059">‏FlyWeb משתמש במצלמה שלך.</translation>
<translation id="8226838065217375546">‏מתבצעת כרגע פעולה אחרת ב-FlyWeb. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="6063700568539132984">‏קל יותר כעת להשתמש ב-FlyWeb באמצעות חשבון FlyWeb שלך ובמחשבים משותפים.</translation>
<translation id="5622088198573179705">‏כדי להשתמש בקלות בתכונות המוכרות והאהובות, כדאי להגדיר את FlyWeb בתור דפדפן ברירת המחדל.</translation>
<translation id="4709797814274745581">‏קיצור דרך ב-FlyWeb</translation>
<translation id="6595693843242836271">‏FlyWeb חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="6890209090736444656">‏ברצונך באמת להסיר את התקנת FlyWeb?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6388799252195623474">אני רוצה עזרה בנושא הזה</translation>
<translation id="8407518452288816185">‏כדי להמשיך, עליך להיכנס ל-FlyWeb באמצעות החשבון <ph name="EMAIL"/>. כך המדיניות של הארגון תחול על המכשיר שלך.</translation>
<translation id="2104550252781001709">‏הלוגו של FlyWeb בתוך מסך מחשב.</translation>
<translation id="6636986997730784876">‏FlyWeb הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-FlyWeb.</translation>
<translation id="4359872290500912570">‏כדי שתמיד תהיה לך אפשרות להשתמש בנתונים ב-FlyWeb ולשמור אותם בחשבון שלך ב-FlyWeb, עליך לאמת את הזהות שלך</translation>
<translation id="3141715584864891679">‏דפדפן FlyWeb פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך</translation>
<translation id="6436260184216827876">התכונה 'חיפוש תמונות' לא זמינה. יש לנסות שוב מאוחר יותר.</translation>
<translation id="2139300032719313227">‏הפעלה מחדש של ChromeOS</translation>
<translation id="7560906925528428585">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת FlyWeb טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="5806916401157869650">‏כדי לעקוב אחרי מחירים ולקבל התראות על ירידות במחיר באתר מסוים, כדאי להוריד את FlyWeb לטלפון שלך</translation>
<translation id="2970877059928503461">‏מושבת • FlyWeb לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="173462352822069427">‏ברוך בואך לפרופילים של FlyWeb</translation>
<translation id="8914008746092110409">‏בפתיחה הבאה של FlyWeb במכשיר <ph name="DEVICE_TYPE"/>, תופיע הנחיה להשתמש בקבוצות של כרטיסיות.</translation>
<translation id="3484308111967198595">‏הסרת החשבון מ-FlyWeb</translation>
<translation id="1474676525193357364">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את FlyWeb.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="5777905264835557372">‏הסרה של התקנת FlyWeb</translation>
<translation id="764623543427374554">‏קיצורי הדרך נפתחים ב-FlyWeb</translation>
<translation id="8852057261917278552">‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION"/>. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="8592211619057897362">‏בכל פרופיל מאוחסנים נתוני FlyWeb משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6556755379298048869">חיפוש באמצעות מקשי הקיצור.</translation>
<translation id="4273595998837775033">‏<ph name="BEGIN_LINK"/>מידע נוסף לגבי השמירה על פרטיות הנתונים ב-FlyWeb<ph name="END_LINK"/></translation>
<translation id="654107331777480705">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של FlyWeb.</translation>
<translation id="3594828538355548672">‏אפשר לנהל את התוספים בלחיצה על "תוספים" בתפריט הראשי של FlyWeb.</translation>
<translation id="7489092380688543560">‏אפשר לעבור לפרופיל FlyWeb אחר כדי לראות סיסמאות</translation>
<translation id="472958395762114471">‏עם אפליקציית FlyWeb אפשר ליהנות מכלי ה-AI הכי טובים בכל מקום</translation>
<translation id="8243012192239086369">‏FlyWeb שולח את הטקסט שמוקלד בשדות טקסט ל-FlyWeb כדי לתקן שגיאות כתיב</translation>
<translation id="3927263773110604886">‏מעבר אל הגדרות ההודעות של FlyWeb</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="6888846095017247017">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את FlyWeb‏.</translation>
<translation id="4481788155537463533">‏‫FlyWeb מופעל עכשיו יחד עם Windows, כך שאפשר להתחיל לגלוש מיד. ניתן להשבית זאת בהגדרות.</translation>
<translation id="1116311888485102603">‏אפשר להמשיך מהמקום שבו הפסקת: FlyWeb שחזר את הכרטיסיות מהסשן האחרון שלך. כדי להשבית את האפשרות הזאת, צריך לעבור אל</translation>
<translation id="1886169834787876002">‏נדרשת הרשאת גישה למצלמה ב-FlyWeb כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="7570986009744020649">‏אם הסימניות שלך נשמרות גם בחשבון FlyWeb, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-FlyWeb ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="1363996462118479832">‏לא בוצע סנכרון של הנתונים ב-ChromeOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="5743696427773796626">‏להסיר את הנתונים של האפליקציה הזאת מ-FlyWeb?</translation>
<translation id="4152880912192471857">‏נדרשת הרשאת גישה למיקרופון ב-FlyWeb עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של FlyWeb.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של FlyWeb.</translation>
<translation id="5528558621229392814">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את FlyWeb ב'פעילות באינטרנט ובאפליקציות' ובשירותי FlyWeb המקושרים</translation>
<translation id="7728046102681268859">‏FlyWeb כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="2006421382007321898">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-FlyWeb. לאחר הכניסה, הסימנייה הזו תישמר בחשבון FlyWeb.</translation>
<translation id="4328426102261301637">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של FlyWeb, אבל FlyWeb יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו פועלת.</translation>
<translation id="207175655966839154">{count,plural, =1{‏חלק מהנתונים ב-FlyWeb עדיין לא נשמרו בחשבון FlyWeb. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏חלק מהנתונים ב-FlyWeb עדיין לא נשמרו בחשבון FlyWeb. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏חלק מהנתונים ב-FlyWeb עדיין לא נשמרו בחשבון FlyWeb. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏חלק מהנתונים ב-FlyWeb עדיין לא נשמרו בחשבון FlyWeb. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
<translation id="1292831930742306370">‏ההמלצה של FlyWeb היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="1547295885616600893">‏<ph name="BEGIN_LINK_CROS_OSS"/>תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS"/> נוספת מאפשרת את השימוש ב-ChromeOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="6432682256389755533">‏FlyWeb מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME"/> ברשימת ההיתרים.</translation>
<translation id="8852956515664182428">‏FlyWeb‏ - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">צריך ללחוץ כדי להמשיך</translation>
<translation id="6862030660799253820">חיפוש התמונה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="6869568587896659271">גישה קלה לאתרים מתחת לסרגל הכתובות</translation>
<translation id="4695676871328690599">‏הפריט "<ph name="EXTENSION_NAME"/>" שנמצא ב-FlyWeb מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT"/>%‎ מימין, ‎<ph name="BOTTOM"/>%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="6898028264630240901">כדי לשאול שאלות במהלך הגלישה, אפשר להצמיד "משימות לפי הקשר"</translation>
<translation id="8416061171168102237">‏הגדרת FlyWeb כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="3503126745419877918">‏&amp;ניהול הפרופילים ב-FlyWeb</translation>
<translation id="4397299252625349918">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS"/>
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK"/>
            • התוספים יושבתו
            <ph name="LINE_BREAK"/>
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAK"/>
            • יתאפסו קיצורי הדרך של FlyWeb
            <ph name="LINE_BREAKS"/>
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="2640214066670118583">‏הגעת למגבלת הסימניות ב-FlyWeb (<ph name="BOOKMARK_LIMIT"/>), לכן חלק מהסימניות עדיין לא נשמרו בחשבון FlyWeb.

כדי לשמור סימניות חדשות בחשבון, צריך למחוק חלק מהסימניות הקיימות. יציאה מהחשבון תמחק את הסימניות שלא נשמרו.</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="3453763134178591239">‏התנאים לשימוש ב-ChromeOS</translation>
<translation id="1163386134146281359">‏כדי להשתמש בנתונים של FlyWeb ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL"/>, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">‏אפשר להתאים אישית את FlyWeb בדרך שנוחה לך</translation>
<translation id="7047386856539490735">התוצאות האלה מועילות?</translation>
<translation id="3945284827084409390">‏יש לעדכן את FlyWeb‏</translation>
<translation id="7886270027101123253">‏אם אין לתמונה תיאור מועיל, FlyWeb ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל FlyWeb.</translation>
<translation id="8434939140421950539">‏אפליקציית FlyWeb מביאה את העוצמה של ה-AI למכשיר <ph name="DEVICE_TYPE"/> שלך</translation>
<translation id="2647329478963461727">‏כשאפליקציית FlyWeb מותקנת אצלך בטלפון, הסיסמאות, הכרטיסיות ופריטים נוספים מלווים אותך לכל מקום</translation>
<translation id="5695394421048248926">‏התאמה אישית של FlyWeb for Testing</translation>
<translation id="6802544479988856975">‏אפשר להשתמש ב-FlyWeb בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות</translation>
<translation id="8694083743003679818">‏הסרה של <ph name="EXTENSION_NAME"/> מ-FlyWeb</translation>
<translation id="6017914745388312119">‏לפי הגדרת הארגון, נתוני FlyWeb נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION"/>. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="3283953248242339756">‏נדרשת הרשאת גישה למצלמה ב-FlyWeb עבור האתר הזה</translation>
<translation id="4729674580260824908">‏לא ניתן היה להפעיל את FlyWeb. יש לנסות שוב.</translation>
<translation id="805403942934515799">‏עם Gemini ב-FlyWeb אפשר לשאול כל דבר, מכל מקום</translation>
<translation id="7093403858436459499">‏כדאי להשאיר את FlyWeb ב-Dock כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="935820624106805690">‏שימוש ב-FlyWeb בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7216228761061470870">‏כשמשתמשים ב"חיפוש תמונות" במחשב, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת</translation>
<translation id="1678436729108859736">‏מנהל המשימות - FlyWeb</translation>
<translation id="7587087358591725059">‏אפשר לשאול על תוכן מחוץ ל-FlyWeb, כמו אפליקציות או קבצים אחרים</translation>
<translation id="7013534648688018698">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER"/>. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-FlyWeb בתור <ph name="USER_EMAIL_ADDRESS"/>. המידע השמור ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="4889865510625659193">‏רוצה לגלוש מיד? עכשיו אפשר להגדיר את FlyWeb להתחיל לפעול יחד עם Windows.</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
<translation id="7288567540154601580">כרטיסיות ותוספים</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של FlyWeb היא להסיר אותו}one{‏ההמלצה של FlyWeb היא להסיר אותם}two{‏ההמלצה של FlyWeb היא להסיר אותם}other{‏ההמלצה של FlyWeb היא להסיר אותם}}</translation>
<translation id="5321339461210685340">‏כדי לשתף אודיו מהמערכת, צריך לפתוח את הגדרות המערכת ולבחור באפשרות "הקלטת אודיו של המערכת בלבד" ל-FlyWeb. לאחר מכן צריך להפעיל מחדש את FlyWeb.</translation>
<translation id="7299899569525778554">חיפוש מהמחשב</translation>
<translation id="2866611433272355726">‏העדכון של FlyWeb‏ מתבצע</translation>
<translation id="5013690772358862887">‏קובץ ההעדפות שלך פגום או לא חוקי. 

FlyWeb לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7324051657739063017">כדי לשאול שאלות תוך כדי גלישה, אפשר לפתוח מחדש את החלונית "משימות לפי הקשר"</translation>
<translation id="1123144153876435088">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-FlyWeb נמצאים כאן.</translation>
<translation id="8915041713909379783">‏רק מי שיודע את ביטוי הסיסמה יכול לקרוא את הנתונים המוצפנים. ביטוי הסיסמה לא נשלח אל FlyWeb ולא מאוחסן אצלה. אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="BEGIN_LINK"/>למחוק את נתוני FlyWeb בחשבון<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">‏לפי הגדרת מנהל המערכת, FlyWeb יפתח את<ph name="ALTERNATIVE_BROWSER_NAME"/> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="7601756527349047847">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך macOS מגרסה 13 ואילך. במחשב הזה פועלת גרסה 12 של macOS.</translation>
<translation id="3916387280110223245">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1"/>" ו"<ph name="PERMISSION_2"/>" הוסרו על ידי FlyWeb.</translation>
<translation id="3313237823190188892">‏הצגת Gemini ב-FlyWeb במגש המערכת</translation>
<translation id="7401687852903179959">חיפוש בסרטון בעזרת "חיפוש תמונות"</translation>
<translation id="6624551989332401777">‏‫FlyWeb מוגדר עכשיו כדפדפן ברירת המחדל</translation>
<translation id="277733508197886564">‏אפשר להמשיך מהמקום שבו הפסקת: FlyWeb משחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להשבית את האפשרות הזו, צריך לעבור אל</translation>
<translation id="948152006162936800">‏ייבוא סיסמאות אל FlyWeb</translation>
<translation id="4755314372270379254">‏1. לוחצים על <ph name="BUTTON_LABEL"/> למטה
2. לוחצים על <ph name="BUTTON_2"/> בהגדרות של Windows
3. לוחצים על <ph name="BUTTON_3"/> בהתראה של Windows כדי להצמיד את FlyWeb לסרגל האפליקציות לגישה מהירה</translation>
<translation id="2971917489215408838">‏<ph name="PAGE_TITLE"/> - FlyWeb בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="7472280958921965834">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK"/>הגדרות המערכת<ph name="END_LINK"/> ולתת ל-FlyWeb גישה</translation>
<translation id="2431618580332826398">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="2154651873647244914">‏להפעיל את FlyWeb מחדש?</translation>
<translation id="3137757192868162370">‏לא ניתן להתקין את אותה גרסת FlyWeb שפועלת כרגע. יש לסגור את FlyWeb ולנסות שוב.</translation>
<translation id="3065486555702061722">‏תזכורת: כל היתרונות של FlyWeb – אצלך בכיס</translation>
<translation id="4027434552262956425">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של FlyWeb, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון FlyWeb אם הוא מחובר ל-FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{‏FlyWeb יופעל מחדש בעוד דקה}one{‏FlyWeb יופעל מחדש בעוד # דקות}two{‏FlyWeb יופעל מחדש בעוד # דקות}other{‏FlyWeb יופעל מחדש בעוד # דקות}}</translation>
<translation id="301074550630080641">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-FlyWeb להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה.</translation>
<translation id="3930051800510118744">‏כדי להתחיל לגלוש מיד, אפשר להפעיל את FlyWeb באופן אוטומטי.</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">‏FlyWeb משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="1381291360713116383">‏FlyWeb השתפר</translation>
<translation id="3892366519980032442">‏עכשיו יש לך יותר תכונות זמינות ב-FlyWeb</translation>
<translation id="7624307931717240213">אנחנו משתמשים במידע כדי לשפר את השירות הזה. אפשר לקרוא את מדיניות הפרטיות והתנאים וההגבלות.</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="7733015548570443346">‏הורדת אפליקציית FlyWeb</translation>
<translation id="7658239707568436148">ביטול</translation>
<translation id="2230101319599356673">‏FlyWeb אינו דפדפן ברירת המחדל שלך</translation>
<translation id="3243257760331619874">‏סנכרון והתאמה אישית של FlyWeb בכל המכשירים שברשותך</translation>
<translation id="3836891631266228927">‏עדכון ל-FlyWeb</translation>
<translation id="7362833186911891234">‏עבודה מאובטחת ב-FlyWeb</translation>
<translation id="7716950018788545737">המשימות הסתיימו.</translation>
<translation id="77283119132245232">השירות הזה מספק תיעוד של עקבות המערכת ל-<ph name="BROWSER_NAME"/>. אם השירות הזה מושבת, נתוני המעקב אחר הביצועים שנוצרים על ידי הדפדפן לא יכללו אירועים כלל-מערכתיים, כמו אירועי החלפת הקשר ואירועי שרשור מוכנים.</translation>
<translation id="1549877678317463759">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל FlyWeb עם <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="104221467268393661">‏איפוס לברירת המחדל של FlyWeb</translation>
<translation id="2414061498125565915">‏כדי להגן על העבודה שלך ב-FlyWeb, הארגון יוכל לראות מידע מסוים או לנהל אותו אם התחברת לחשבון בדפדפן.</translation>
<translation id="494195283222791090">‏הגדרת FlyWeb כדפדפן ברירת המחדל והצמדה שלו לסרגל האפליקציות</translation>
<translation id="134973275687829726">‏שיפור המהירות ב-FlyWeb</translation>
<translation id="1102535934248882091">‏<ph name="PAGE_TITLE"/> – FlyWeb בגרסת Canary</translation>
<translation id="2415098152024287665">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫FlyWeb משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7810005234485217901">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה</translation>
<translation id="6059158364953614237">‏בחירת המידע שישותף עם FlyWeb</translation>
<translation id="8463540467315366872">‏כבר קיים במכשיר פרופיל FlyWeb עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="3682929584258119691">‏בוצע שינוי מחוץ ל-FlyWeb במנוע החיפוש שמוגדר כברירת המחדל. כדי להגן עליך, FlyWeb איפס את ההגדרה לערך ברירת המחדל המקורי. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">‏אפשר להתאים אישית את FlyWeb כדי לשנות את המראה שלו.</translation>
<translation id="8611872055947278722">‏עדכון FlyWeb לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS"/> שנ'</translation>
<translation id="3999247564452560622">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, <ph name="BEGIN_LINK"/>עליך למחוק את נתוני FlyWeb בחשבון<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">‏אפשר לפתוח את Gemini ב-FlyWeb במהירות מתי שרוצים</translation>
<translation id="6798431672720500005">‏הגדרת FlyWeb כדפדפן ברירת המחדל</translation>
<translation id="332151924263389003">‏‫FlyWeb משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="3096730275883527801">‏נכנסת ל-FlyWeb כ-<ph name="USER_EMAIL_ADDRESS"/>. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="7097534420680357688">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER"/>. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-FlyWeb בתור <ph name="USER_EMAIL_ADDRESS"/>. הסימניות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="9017338699075596174">‏זוהי התקנה משנית של FlyWeb, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="2888168499066553233">‏עם אפליקציית FlyWeb במכשיר <ph name="DEVICE_TYPE"/>, אפשר לקבל כל מה שיש ל-FlyWeb להציע</translation>
<translation id="8004582292198964060">דפדפן</translation>
<translation id="8010081455002666927">זיהוי אוטומטי</translation>
<translation id="5944585442866020176">‏אחרי מתן גישה ל-FlyWeb, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="4462215250900528778">‏אפשר להצמיד את FlyWeb לסרגל האפליקציות כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="8054112667659782652">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="8069447462453318634">צריך לבחור באפשרות "הצמדה לסרגל הכלים"</translation>
<translation id="3685797926747054412">‏השבתת הפעילות של FlyWeb ברקע לאפליקציות</translation>
<translation id="80790299200510644">חיפוש באמצעות תמונות</translation>
<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>
<translation id="1252435607084353041">‏<ph name="PAGE_TITLE"/> –‏ FlyWeb for Testing</translation>
<translation id="3263664073045388929">‏נדרשת הרשאת מיקום ב-FlyWeb עבור האתר הזה</translation>
<translation id="5289593085778678155">‏בפתיחה הבאה של FlyWeb במכשיר <ph name="DEVICE_TYPE"/>, תופיע הנחיה להפעיל התראות על מעקב מחירים.</translation>
<translation id="7635444121786764725">‏התראות על ירידות מחירים של פריטים שמעניינים אותך מחכות לך באפליקציית FlyWeb בטלפון</translation>
<translation id="8118331347066725040">‏שליחת משוב על חיפוש באמצעות Lens</translation>
<translation id="5770057404954060005">‏רוצה ש-FlyWeb יתאים לך בול?</translation>
<translation id="5334309298019785904">‏לא בוצע סנכרון של הנתונים ב-ChromeOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="6992240065504496864">‏אפשר לפתוח את Gemini ב-FlyWeb באמצעות מקש קיצור.</translation>
<translation id="6334554715655789744">‏תנאים והגבלות נוספים של FlyWeb</translation>
<translation id="1597323875619800374">‏FlyWeb‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8177472873527554730">לא נמצא תוכן בדף</translation>
<translation id="2214224574148863941">‏כדי להשתמש בנתונים של FlyWeb ולשמור אותם בחשבון <ph name="USER_EMAIL"/>, צריך להזין את ביטוי הסיסמה</translation>
<translation id="820759916613250543">חיפוש בתמונה בעזרת "חיפוש תמונות"</translation>
<translation id="8221491193165283816">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות יש ללחוץ כאן.</translation>
<translation id="2459467374982542273">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK"/>הגדרות המערכת<ph name="END_LINK"/> ולתת ל-FlyWeb גישה</translation>
<translation id="4749458995158778066">‏‫FlyWeb לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-FlyWeb כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="6756872644564483342">‏אם אין לתמונה תיאור מועיל, FlyWeb ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל FlyWeb. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="9179486248398668702">‏להיכנס ל-FlyWeb עם פרופיל חדש?</translation>
<translation id="1470002120352085290">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER"/>. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-FlyWeb בתור <ph name="USER_EMAIL_ADDRESS"/>. הסיסמאות שלך ופרטים נוספים יופיעו במכשיר <ph name="DEVICE"/>.</translation>
<translation id="8901123396574346662">‏הצגת Gemini ב-FlyWeb במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="9102959605052547519">‏<ph name="BEGIN_LINK"/>ב-FlyWeb מוצגות אזהרות<ph name="END_LINK"/> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="669999719045196468">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה "<ph name="PERMISSION"/>" הוסרה על ידי FlyWeb.</translation>
<translation id="7136168924180047124">‏אפשר לקנות, לתרגם ולזהות את מה שרואים במצלמה באפליקציית FlyWeb ל-iOS</translation>
<translation id="867002910715789721">‏קוד QR לכניסה אל FlyWeb בתור <ph name="USER_NAME"/></translation>
<translation id="8313851650939857356">שגיאת הפעלה: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">שמירה כתמונה</translation>
<translation id="9174706677133564856">‏בכתובת <ph name="USER_EMAIL_ADDRESS"/> השתמשו בעבר ב-FlyWeb</translation>
<translation id="7009033378151348624">‏הפעלה של מיומנויות ב-FlyWeb</translation>
<translation id="338142060986183805">‏כדי להמשיך להשתמש בנתונים של FlyWeb בחשבון שלך ב-FlyWeb (<ph name="ACCOUNT_EMAIL"/>), צריך לעדכן את FlyWeb</translation>
<translation id="7408894216012529448">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="8362914115861174987">תרגום ל</translation>
<translation id="8367705492654390392">אפשר לשאול הכל</translation>
<translation id="5020916672477085422">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-FlyWeb. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-FlyWeb.</translation>
<translation id="5417365165109189454">‏לאחר מכן יהיה עליך להפעיל מחדש את FlyWeb.</translation>
<translation id="4212474799248200893">‏ההמלצה של FlyWeb היא להסיר אותו. <ph name="BEGIN_LINK"/>מידע נוסף על תוספים נתמכים<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-FlyWeb כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="3669395395617655404">‏‫FlyWeb צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון FlyWeb ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="5261590792975521002">{0,plural, =1{‏צריך להפעיל מחדש את FlyWeb בתוך יום אחד}one{‏צריך להפעיל מחדש את FlyWeb בתוך # ימים}two{‏צריך להפעיל מחדש את FlyWeb בתוך # ימים}other{‏צריך להפעיל מחדש את FlyWeb בתוך # ימים}}</translation>
<translation id="8438543370129609977">‏כשמשתמשים בתכונה 'חיפוש תמונות', כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת. <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">‏מידע נוסף על חיפוש באמצעות התכונה "חיפוש תמונות" ב-FlyWeb</translation>
<translation id="3101564993057563365">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את FlyWeb.</translation>
<translation id="5316851838033144902">‏כדי להשתמש ב-FlyWeb נדרש Windows מגרסה 10 ואילך.</translation>
<translation id="6760691951531758781">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל FlyWeb תעזור לשפר את התכונות ואת הביצועים של ChromeOS.</translation>
<translation id="2523037024749170569">‏כדי להשתמש בנתוני FlyWeb ולשמור אותם בחשבון FlyWeb, עליך לאמת את הזהות שלך</translation>
<translation id="5989540778099253163">‏הצגת פרומפטים לצורך כניסה אל FlyWeb</translation>
<translation id="6852836260419236265">‏FlyWeb אינו מעודכן</translation>
<translation id="360892078644515524">‏תודה שבחרת ב-FlyWeb כדפדפן ברירת המחדל שלך!</translation>
<translation id="797182360653885317">‏ל-FlyWeb יש אפשרות לבדוק את הסיסמאות שלך רק אם שמרת אותן</translation>
<translation id="8525579356836940628">ההתקנה נעצרה</translation>
<translation id="8340284327429540526">‏כשאפליקציית FlyWeb מותקנת במכשיר <ph name="DEVICE_TYPE"/> שלך, הסיסמאות, הכרטיסיות ופריטים נוספים הולכים איתך לכל מקום</translation>
<translation id="7498776423722712116">‏אפשר לקבל אזהרה אם FlyWeb ימצא שאחת מהסיסמאות שלך דלפה בגלל פרצה באבטחת מידע</translation>
<translation id="8555465886620020932">שגיאה בשירות: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">‏חלק מהתכונות והתוספים של FlyWeb מגיעים עם מקשי קיצור. אפשר להפעיל אותם מחדש.</translation>
<translation id="8556420416730706394">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה: פשוט לוחצים על הכפתור 'הצמדה' בחלק העליון של החלונית הצדדית</translation>
