<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="7099479769133613710">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromeOS</translation>
<translation id="291426170030461697">I-FlyWeb incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="1549005488226693697">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-FlyWeb isebenzisa amaseva e-FlyWeb. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-FlyWeb ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="5749154344207139683">Sisize sithuthukise i-Incognito ngokuthatha le nhlolovo yomzuzu o-1.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="8908267645832965492">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-FlyWeb</translation>
<translation id="5557633153169217776">IBrave idinga ukufinyelela kunethiwekhi yakho yendawo ukuze ithole futhi isebenzise amadivayisi aseduze</translation>
<translation id="6441390163669415879">Ukuze useshe isakhi noma isandiso esithile seBrave, thayipha isinqamuleli sayo kubha yekheli, kulandelwe ukhiye wakho wekhibhodi okhethiwe</translation>
<translation id="9001750423919983557">Bonisa ukusesha ngeBrave kugqoko lwesistimu bese uvula isinqamuleli sekhibhodi</translation>
<translation id="1368460307421081773">I-FlyWeb ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="112640046208448578">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Lapho usebenzisa Usesho Lomfanekiso, isithombe-sikrini sekhasi sithunyelwa eseveni. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">I-FlyWeb iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="4556715463645168547">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK"/>ngena ngemvume ku-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Chofoza imenyu ye-FlyWeb</translation>
<translation id="1157985233335035034">Izilimi zakamuva</translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="4380351562011537903">Mayelana ne-FlyWeb</translation>
<translation id="853148447909557566">Thola izexwayiso zokulandelela intengo nge-FlyWeb efonini yakho</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Uma uvula Usesho Lomfanekiso, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuzothunyelwa ngokuzenzekelayo kuseva. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ngeBrave sync chain yakho kuBrave. Ukuze ushintshe lokhu, iya kokuthi “I-akhawunti yakho kuBrave”.</translation>
<translation id="7614508617663739435">Bonisa iGemini kuBrave kubha yemenyu yeMac</translation>
<translation id="832555967476614730">Ukuze ukhethe ingxenye yesikrini kuGemini kuBrave, sebenzisa isinqamuleli sekhibhodi.</translation>
<translation id="4750836834956739196">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-FlyWeb ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="3190759351483708314">I-FlyWeb ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="5879469261638423015">Uma ungena ngemvume kumasevisi eBrave efana neGmail noma iYouTube nge-<ph name="USER_EMAIL"/>, ungangena ngemvume ngokuzenzakalela kuBrave nge-akhawunti efanayo</translation>
<translation id="7142135954326264349">Thola iBrave efonini yakho</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Setha iphrofayela yakho entsha ye-FlyWeb</translation>
<translation id="5252737639504553444">Zama ngeGemini kuBrave</translation>
<translation id="609743863669742325">I-FlyWeb idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Ngena ngemvume kuBrave efonini yakho</translation>
<translation id="1330562121671411446">Thola ulimi</translation>
<translation id="2276527911011636666">Futhi sula idatha ku-FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Kuphiniwe! Ungafinyelela futhi Usesho Lomfanekiso ngenkinobho entsha kubha yamathuluzi</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="1045149878186896649">Sebenzisa i-app yeBrave ukuze uqhubeke nokubhrawuza usendleleni</translation>
<translation id="141901961143729572">Yabelana ngemicabango yakho</translation>
<translation id="2758515779140515865">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweBrave Kumasethingi Ohlelo.</translation>
<translation id="4713192356155907986">Thola usizo nge-FlyWeb Yokuhlola</translation>
<translation id="4984443629206419460">Ukuze uthole imininingwane yakho egciniwe nokukuma<ph name="DEVICE"/>, ngena ngemvume kuBrave</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Leli khasi livikelwe</translation>
<translation id="8962360511570172">Yabelana ngethebhu ye-FlyWeb</translation>
<translation id="2941487459666781243">Ngena ngemvume kuBrave</translation>
<translation id="1547469039832541117">Ivala umsebenzi ogqanyisiwe.</translation>
<translation id="3182893868355533457">Phina iBrave</translation>
<translation id="852852907317361085">Amathuluzi okuphepha e-FlyWeb</translation>
<translation id="481155564361715417">IBrave ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-FlyWeb ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="2846999307505917298">Thola okuhamba phambili kweBrave nge-app yeBrave efonini yakho</translation>
<translation id="3961251277542681013">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-FlyWeb</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1665602916345474427">Ungene ngemvume njengo-<ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, ubulungu. Vula imenyu ye-akhawunti</translation>
<translation id="7625232007557474355">Ungasebenzisa iBrave noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app Izobuye iphinwe ku-taskbar yakho.</translation>
<translation id="1709772298389099340">Inikeza amalungelo aphakeme e-<ph name="BROWSER_NAME"/>.</translation>
<translation id="8494512118209691256">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="5695205873161614119">I-FlyWeb izosula idatha yokubhrawuza maduze</translation>
<translation id="8939535770474283898">I-FlyWeb izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="2581127533455294937">Idatha ye-FlyWeb esuliwe</translation>
<translation id="7385422968404728039">I-FlyWeb izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Uma i-HTTPS ingatholakali, i-FlyWeb izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="307170399141486420">Vumela i-FlyWeb ukuthi isebenze ngemuva</translation>
<translation id="543905389684998697">Ukuze senze i-FlyWeb ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="5006568136491721884">Chofoza okuthi <ph name="BEGIN_BOLD"/>Yebo<ph name="END_BOLD"/> esazisweni seWindows ukuze uphine iBrave ku-taskbar yakho ukuze uyifinyelele ngokushesha.</translation>
<translation id="2473319786107120819">Phinda ufake i-FlyWeb</translation>
<translation id="2533324957407080119">I-FlyWeb izama uku-<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">U-<ph name="EXISTING_USER"/> usengenile ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuBrave kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS"/> Uzophinde uthole izandiso zakho nokuningi ku-<ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Ngokuzayo uma uvula iBrave ku-<ph name="DEVICE_TYPE"/> yakho, uzobona umyalelo wokusebenzisa Umphathi Wephasiwedi YeBrave.</translation>
<translation id="1838374766361614909">Sula usesho</translation>
<translation id="3403116471618205223">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-FlyWeb sync chain yakho, <ph name="BEGIN_LINK"/>phuma ngemvume ku-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Dawuniloda iBrave efonini yakho ukuze uvule noma usungule amaqembu ethebhu amasha usendleleni.</translation>
<translation id="3285741355512747610">Ungaphatha ama-akhawunti we-FlyWeb wakho angene ngemvume. Ama-akhawunti wakho we-FlyWeb asetshenziselwe i-browser ye-FlyWeb, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE"/> yakho kunalokho. <ph name="LINK_BEGIN"/>Funda kabanzi<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Sesha Ngosesho Lomfanekiso</translation>
<translation id="5054936737639982722">U-<ph name="EXISTING_USER"/> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuBrave kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS"/> Uzophinde uthole amabhukhimakhi akho nokuningi ku-<ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="4824940465467423308">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-FlyWeb. Idatha yakho ye-FlyWeb, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME"/>. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-FlyWeb, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-FlyWeb ihlukile. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">IBrave igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ohlaka lwevidiyo. <ph name="BEGIN_LINK"/>Funda kabanzi mayelana Nesongi Samandla<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Isevisi Yesibuyekezi SeBrave</translation>
<translation id="7390382558747224642">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-FlyWeb njenge-Gmail ngaphandle kokungena ngemvume ku-FlyWeb</translation>
<translation id="5714085538350759767">I-FlyWeb ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="5866699689358760578">Inhlangano yakho, ebizwa <ph name="MANAGER"/>, ifuna ungene ngemvume kuBrave</translation>
<translation id="4035053306113201399">I-ChromeOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="3750729306035486751">I-FlyWeb ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE"/></translation>
<translation id="6956650624767954726">I-FlyWeb ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="197326043290947695">Bhrawuza ngobuhlakani Ngosesho Lomfanekiso</translation>
<translation id="130679046523922050">Funda ukuthi kungani i-FlyWeb ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="8243822903505210769">Kugcina isofthiwe yakho yeBrave ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeBrave ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeBrave eyisebenzisayo.</translation>
<translation id="6495079989036864983">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-FlyWeb njengo-<ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2039417478970545937">Amasethingi.</translation>
<translation id="8544477465831682343">Khetha ukuthi ufake phakathi umlando we-FlyWeb ukuze uthole umuzwa womuntu siqu kumasevisi e-FlyWeb</translation>
<translation id="328650761750741315">Yakhelwe kuBrave ukuze ikusize usungule, ulondoloze, futhi ugcwalise ngokuzenzekelayo amaphasiwedi aqinile. Faka isinqamuleli ukuze ufinyelele kalula.</translation>
<translation id="2407746489237278840">Chofoza inkinobho ethi Vumelanisa IBrave Nomuntu Ngamunye Ekhasini Lethebhu Entsha ukuze unikeze iBrave ukubukeka okusha</translation>
<translation id="8924891216494775926">I-FlyWeb ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="5728214838078602184">Uzobona umyalelo wokuzama okuthi <ph name="FEATURE_NAME"/> ngesikhathi esilandelayo lapho uvula iBrave iOS.</translation>
<translation id="2058207584484841616">Amaphasiwedi akho kanye nenye idatha yeBrave oyilondoloze kuBrave sync chain yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuBrave, ngena ngemvume futhi.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-FlyWeb ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-FlyWeb ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-FlyWeb ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2125838419757773031">Khetha isifunda sesikrini ukuze useshe</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2135919691573380097">Bika le sayithi</translation>
<translation id="2137162749895930932">Vala isikrini sokuhumusha</translation>
<translation id="2147218225094845757">Fihla iphaneli eseceleni</translation>
<translation id="4474394796469499134">I-FlyWeb ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2170098639895543546">Khetha noma yini esekhasini</translation>
<translation id="6765231735885996239">Yenza i-FlyWeb ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="2937508664417729967">I-FlyWeb - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Susa i-akhawunti kuBrave</translation>
<translation id="744837314710861405">Sebenzisa i-app yeBrave ukuze usebenzise amathuluzi okuthenga angcono kakhulu usendleleni</translation>
<translation id="2745381939758295588">Hlala uphephile lapho usendleleni Ngokubhrawuza Okuphephe Ngokuthuthukisiwe kuBrave ye-iOS</translation>
<translation id="6707114110652917144">Isayithi eyingozi. I-FlyWeb isuse izaziso.</translation>
<translation id="2236949375853147973">Umsebenzi Wami</translation>
<translation id="4646732243247482236">Ukuze uthole amakheli akho nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuBrave. Leli kheli lizolondolozwa kuBrave sync chain yakho ngemva kokungena ngemvume.</translation>
<translation id="2726680594710751908">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-FlyWeb ngendlela abafuna ngayo nje.</translation>
<translation id="4086571337340463916">Amakhono kuBrave</translation>
<translation id="2283803047247799269">Sesha le thebhu Ngosesho Lomfanekiso</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{IBrave incoma ukumisa ithebhu enciphisa ijubane lebhrawuza yakho}one{IBrave incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}other{IBrave incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}}</translation>
<translation id="2307973900865360088">Kugcine Edokhini</translation>
<translation id="5067150284614317159">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-FlyWeb. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-FlyWeb ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2356070529366658676">Buza</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="7339360994527471629">Isandiso esithi "<ph name="EXTENSION_NAME"/>" sifuna ukuthi ungene ngemvume kuBrave</translation>
<translation id="8788732221355188962">Vala iBrave Esebenza Ngemuva kuma-App</translation>
<translation id="4126251160852694747">Ukuze usebenzise lesi sandiso njenge-<ph name="USER_EMAIL_ADDRESS"/>, ngena ngemvume kuBrave.</translation>
<translation id="8418845734693287262">I-ChromeOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-FlyWeb esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-FlyWeb esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-FlyWeb esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-FlyWeb esisodwa noma eziningi}}</translation>
<translation id="1364879203203742966">I-FlyWeb idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2403703063067034158">Iphutha lokuqala: esinye isenzakalo sokusetha siyaqalisa okwamanje, sicela uzame futhi ngokuhamba kwesikhathi.</translation>
<translation id="656987653252575654">Vula amalinki kuBrave kunoma iyiphi i-app futhi ugcine ibhrawuza ifinyeleleka ku-taskbar yakho</translation>
<translation id="157662717324308283">Chofoza inkinobho ethi Finyeza ukuze wabelane ngale dokhumenti neGemini kuBrave ukuze uthole iqoqa elisheshayo futhi ubuze imibuzo yokulandelela</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>Ngamathuluzi avela ku-FlyWeb<ph name="END_LINK"/>, ungabhrawuza ngokuphepha bese uhlala ulawula</translation>
<translation id="1716762085628757512">U-<ph name="EXISTING_USER"/> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuBrave kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS"/> Uzophinde uthole namaphasiwedi akho nokuningi kuwo wonke amadivayisi akho.</translation>
