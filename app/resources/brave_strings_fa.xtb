<translation id="5941711191222866238">کوچک کردن</translation>
<translation id="6669708050135513710">‏برای دریافت این نشانک و موارد بیشتر در همه دستگاه‌هایتان، به سیستم FlyWeb وارد شوید</translation>
<translation id="3358004031263458708">‏‫FlyWeb را مخصوص خودتان کنید</translation>
<translation id="5960071705175224773">برنامه‌ای ناشناس تنظیمات شما را تغییر داد</translation>
<translation id="5977420883993828287">سنجاق شد! برای استفاده دوباره از «تکالیف بافتاری»، از نوار‌ابزار استفاده کنید</translation>
<translation id="348384176991400026">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}one{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}other{‏اگر به‌مدت # دقیقه از FlyWeb استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}}</translation>
<translation id="4955869506208896934">‏به‌روزرسانی FlyWeb برای شروع همگام‌سازی</translation>
<translation id="5990360079535151574">ازطریق دکمه «تکالیف بافتاری» در نوارابزار، می‌توانید «تکالیف بافتاری» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="6003112304606738118">درحال بارگیری… <ph name="HOURS"/> ساعت باقی مانده است</translation>
<translation id="6009821354356307391">پرسیدن سؤال تعقیبی</translation>
<translation id="6040143037577758943">بستن</translation>
<translation id="4530644097272078700">‏بااستفاده از برنامه FlyWeb در <ph name="DEVICE_TYPE"/>، از خرید آنلاین بهره بیشتری ببرید</translation>
<translation id="619330138913595431">‏برای محافظت از داده‌هایتان، به FlyWeb اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="8714139918792771260">‏&amp;باز کردن در FlyWeb</translation>
<translation id="6069027071882229820">کپی کردن به‌عنوان تصویر</translation>
<translation id="499541338626558192">‏<ph name="EXTENSION_NAME"/> به FlyWeb اضافه شد</translation>
<translation id="5880307616068888895">‏سفارشی کردن و کنترل FlyWeb. به‌روزرسانی‌ دردسترس است.</translation>
<translation id="1429530657225981960">‏روشن • FlyWeb نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="8056369489402655495">‏حساب شما در FlyWeb</translation>
<translation id="1683225514126450592">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار FlyWeb</translation>
<translation id="4809579265564854985">‏<ph name="FILE_NAME"/> خطرناک است، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="1773252983747911987">‏FlyWeb به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="1686760912855738719">‏می‌توانید در اینجا بین نمایه‌های FlyWeb جابه‌جا شوید</translation>
<translation id="5461795497268691356">‏اگر کوکی‌ها را مجاز کنید، ممکن است FlyWeb از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="6165508094623778733">بیشتر بدانید</translation>
<translation id="1292852397592425449">‏داده‌های FlyWeb ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="7031783851441272920">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK"/>اگر گذرواژه را ارائه دهید، FlyWeb می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن FlyWeb» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="4403968929742079769">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME"/> به سیستم FlyWeb وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="8345188246355148375">‏از هرجا که هستید جستجو کنید و سؤال بپرسید، حتی اگر FlyWeb کوچک شده باشد. به FlyWeb اجازه می‌دهد در پس‌زمینه اجرا شود.</translation>
<translation id="1855179706668101462">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از FlyWeb است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً FlyWeb را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="651290634887454330">{0,plural, =0{‏FlyWeb هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏FlyWeb ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏FlyWeb ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏FlyWeb ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="2586408713760853791">‏FlyWeb برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="1603558835003845196">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در FlyWeb ذخیره شده است مقایسه می‌کند</translation>
<translation id="5751080530525677552">‏FlyWeb  مرورگر پیش‌فرض شود</translation>
<translation id="6248988683584659830">تنظیمات جستجو</translation>
<translation id="6342238100521499844">‏با برنامه FlyWeb در تلفنتان، بهترین ویژگی‌های ایمنی FlyWeb را درحال حرکت دریافت کنید</translation>
<translation id="3542157007113577464">‏از FlyWeb خارج می‌شوید؟</translation>
<translation id="2166321493116256664">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید FlyWeb آن‌ها را غیرفعال کند.</translation>
<translation id="3794967601634523398">‏سفارشی کردن نمایه FlyWeb</translation>
<translation id="6475001900959697061">‏نام‌گذاری نمایه FlyWeb</translation>
<translation id="6356094940346377065">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم FlyWeb وارد شوید</translation>
<translation id="4465156155012748592">‏<ph name="FILE_NAME"/> ممکن است خطرناک باشد، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="5523868569707953059">‏FlyWeb درحال استفاده از دوربین شما است.</translation>
<translation id="8226838065217375546">‏عملیات دیگری در FlyWeb درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="6063700568539132984">‏اکنون استفاده از FlyWeb با حساب FlyWeb شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="5622088198573179705">‏با تنظیم کردن FlyWeb به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید.</translation>
<translation id="4709797814274745581">‏میان‌بر FlyWeb</translation>
<translation id="6595693843242836271">‏‫FlyWeb این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="6890209090736444656">‏آیا مطمئن هستید که می‌خواهید FlyWeb را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="6388799252195623474">در این مورد به من کمک کنید</translation>
<translation id="8407518452288816185">‏برای ادامه دادن، با حساب <ph name="EMAIL"/> به سیستم FlyWeb وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="2104550252781001709">‏نشان‌واره FlyWeb درون صفحه‌نمایش رایانه.</translation>
<translation id="6636986997730784876">‏‫FlyWeb یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در FlyWeb، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="4359872290500912570">‏برای اینکه مطمئن شوید همیشه می‌توانید از داده‌های FlyWeb در «حساب FlyWeb» خود استفاده کنید و آن‌ها را ذخیره کنید، هویتتان را درستی‌سنجی کنید</translation>
<translation id="3141715584864891679">‏‫FlyWeb سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="6436260184216827876">«جستجوی تصویر» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="2139300032719313227">‏بازراه‌اندازی ChromeOS</translation>
<translation id="7560906925528428585">‏‫FlyWeb صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="5806916401157869650">‏با بارگیری FlyWeb در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="2970877059928503461">‏خاموش • FlyWeb نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="173462352822069427">‏به نمایه‌های FlyWeb خوش‌آمدید</translation>
<translation id="8914008746092110409">‏دفعه بعد که FlyWeb را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="3484308111967198595">‏برداشتن حساب از FlyWeb</translation>
<translation id="1474676525193357364">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی FlyWeb نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="5777905264835557372">‏حذف نصب FlyWeb </translation>
<translation id="764623543427374554">‏میان‌برها در FlyWeb باز می‌شود</translation>
<translation id="8852057261917278552">‏اگر <ph name="TIMEOUT_DURATION"/> از FlyWeb استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="8592211619057897362">‏هرکدام از نمایه‌ها دارای اطلاعات FlyWeb مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="6556755379298048869">با میان‌بر صفحه‌کلید جستجو کنید.</translation>
<translation id="4273595998837775033">‏درباره اینکه <ph name="BEGIN_LINK"/>FlyWeb چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK"/> بیشتر بدانید</translation>
<translation id="654107331777480705">‏پس‌از بازراه‌اندازی FlyWeb، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="3594828538355548672">‏افزونه‌هایتان را با کلیک کردن روی «افزونه‌ها» در منوِ اصلی FlyWeb مدیریت کنید.</translation>
<translation id="7489092380688543560">‏برای دیدن گذرواژه‌های نمایه FlyWeb دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="472958395762114471">‏برای داشتن بهترین ابزارهای هوشواره‌ای درحرکت، از برنامه FlyWeb استفاده کنید</translation>
<translation id="8243012192239086369">‏برای رفع خطاهای املائی، FlyWeb نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای FlyWeb ارسال می‌کند</translation>
<translation id="3927263773110604886">‏رفتن به تنظیمات اعلان FlyWeb</translation>
<translation id="6600016381025017075">هرچیزی در این صفحه را جستجو کنید</translation>
<translation id="6888846095017247017">‏دفعه بعدی که FlyWeb را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="4481788155537463533">‏اکنون FlyWeb با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="1116311888485102603">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: FlyWeb زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="1886169834787876002">‏FlyWeb برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="7570986009744020649">‏اگر نشانک‌ها را در «حساب FlyWeb» هم ذخیره کنید، می‌توانید قیمت محصولات را در FlyWeb پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="1363996462118479832">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromeOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="5743696427773796626">‏برداشتن داده‌های این برنامه از FlyWeb</translation>
<translation id="4152880912192471857">‏FlyWeb برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6712881677154121168">خطای بارگیری: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از FlyWeb است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از FlyWeb استفاده کنید.</translation>
<translation id="5528558621229392814">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، FlyWeb را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده FlyWeb اضافه کنید</translation>
<translation id="7728046102681268859">‏FlyWeb از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="2006421382007321898">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم FlyWeb وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب FlyWeb» شما ذخیره خواهد شد.</translation>
<translation id="4328426102261301637">‏با این کار سرعت سایت‌ها با موتور FlyWeb نسخه ۸ بالاتر می‌رود اما مقاومت FlyWeb دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="207175655966839154">{count,plural, =1{‏برخی‌از داده‌های FlyWeb هنوز در «حساب FlyWeb» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های FlyWeb هنوز در «حساب FlyWeb» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های FlyWeb هنوز در «حساب FlyWeb» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="1292831930742306370">‏FlyWeb توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="1547295885616600893">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی ممکن شده است.</translation>
<translation id="6831043979455480757">ترجمه</translation>
<translation id="6432682256389755533">‏FlyWeb می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="684888714667046800">نمی‌توان به اینترنت متصل شد. اگر از دیوار آتش استفاده می‌کنید، لطفاً مطمئن شوید <ph name="PRODUCT_EXE_NAME"/> در فهرست مجازها باشد.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">برای ادامه دادن، کلید «جهش» را فشار دهید</translation>
<translation id="6862030660799253820">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="6869568587896659271">دسترسی آسان به وب‌سایت‌های زیر نوار نشانی</translation>
<translation id="4695676871328690599">‏FlyWeb متوجه شده است که «<ph name="EXTENSION_NAME"/>» حاوی بدافزار است</translation>
<translation id="6877155553248388166">‏گوشه پایین سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT"/> سمت چپ، ‎٪<ph name="BOTTOM"/> پایین</translation>
<translation id="6896758677409633944">کپی کردن</translation>
<translation id="6898028264630240901">می‌توانید «تکالیف بافتاری» را سنجاق کنید تا هنگام مرور کردن به‌راحتی سؤالات خود را بپرسید</translation>
<translation id="8416061171168102237">‏‫FlyWeb را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="3503126745419877918">‏مدیریت نمایه‌های FlyWeb</translation>
<translation id="4397299252625349918">‏این کنش:
          <ph name="LINE_BREAKS"/>
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK"/>
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK"/>
            • کوکی‌ها و دیگر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAK"/>
            • میان‌برهای FlyWeb را بازنشانی می‌کند
            <ph name="LINE_BREAKS"/>
            نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نخواهند گرفت.</translation>
<translation id="2640214066670118583">‏به حداکثر تعداد نشانک‌های FlyWeb (<ph name="BOOKMARK_LIMIT"/>) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب FlyWeb» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="6965382102122355670">تأیید</translation>
<translation id="3453763134178591239">‏شرایط ChromeOS</translation>
<translation id="1163386134146281359">‏برای استفاده از داده‌های FlyWeb و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="7011190694940573312">نصب انجام نشد زیرا این نسخه از سیستم‌عامل پشتیبانی نمی‌شود.</translation>
<translation id="7024536598735240744">خطای لغو فشرده‌سازی: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">‏FlyWeb را برای خود اختصاصی کنید</translation>
<translation id="7047386856539490735">این نتایج مفیدند؟</translation>
<translation id="3945284827084409390">‏به‌روزرسانی FlyWeb</translation>
<translation id="7886270027101123253">‏اگر تصویری توضیح مفیدی نداشته باشد، FlyWeb توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به FlyWeb ارسال می‌شود.</translation>
<translation id="8434939140421950539">‏هنگام استفاده از برنامه FlyWeb در <ph name="DEVICE_TYPE"/>، قدرت هوشواره را تجربه کنید</translation>
<translation id="2647329478963461727">‏با برنامه FlyWeb در تلفنتان، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحال حرکت همراه خود داشته باشید</translation>
<translation id="5695394421048248926">‏سفارشی‌سازی FlyWeb for Testing</translation>
<translation id="6802544479988856975">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از FlyWeb باز کنید</translation>
<translation id="8694083743003679818">‏حذف <ph name="EXTENSION_NAME"/> از FlyWeb</translation>
<translation id="6017914745388312119">‏اگر <ph name="TIMEOUT_DURATION"/> از FlyWeb استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="3283953248242339756">‏FlyWeb برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="4729674580260824908">‏FlyWeb راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="805403942934515799">‏در همان جایی که هستید، درباره هر چیزی از «Gemini در FlyWeb» بپرسید</translation>
<translation id="7093403858436459499">‏‫FlyWeb را در Dock نگه دارید تا هرزمان خواستید سریع به آن دسترسی داشته باشید</translation>
<translation id="935820624106805690">‏از FlyWeb برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="7216228761061470870">‏وقتی در رایانه از «جستجوی تصویر» استفاده می‌کنید، عنوان صفحه، نشانی وب، و محتوا ازجمله فایل‌های PDF به سرور ارسال می‌شود.</translation>
<translation id="1678436729108859736">‏مدیر وظایف - FlyWeb</translation>
<translation id="7587087358591725059">‏درباره محتواهای خارج از FlyWeb، مثل برنامه‌ها یا سایر فایل‌ها سؤال کنید</translation>
<translation id="7013534648688018698">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید. همچنین به اطلاعات ذخیره‌شده و اطلاعات دیگر در همه دستگاه‌هایتان دسترسی خواهید داشت.</translation>
<translation id="4889865510625659193">‏مرور را فوراً شروع کنید: اکنون FlyWeb می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="7274695763216404502">سنجاق شد! دفعه بعد «جستجوی تصویر» را از نوارابزار باز کنید</translation>
<translation id="7288567540154601580">زبانه‌ها و افزونه‌ها</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{‏FlyWeb توصیه می‌کند آن را بردارید}one{‏FlyWeb توصیه می‌کند آن را بردارید}other{‏FlyWeb توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="5321339461210685340">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای FlyWeb مجاز کنید. سپس باید FlyWeb را بازراه‌اندازی کنید.</translation>
<translation id="7299899569525778554">جستجو کردن از رایانه</translation>
<translation id="2866611433272355726">‏در حال به‌روزرسانی FlyWeb</translation>
<translation id="5013690772358862887">‏فایل اولویت‌های شما خراب یا نامعتبر است. 
FlyWeb قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="7324051657739063017">می‌توانید «تکالیف بافتاری» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="1123144153876435088">‏وب، نشانک‌ها و موارد دیگر FlyWeb شما در اینجا هستند.</translation>
<translation id="8915041713909379783">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به FlyWeb ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK"/>داده‌های FlyWeb ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME"/> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، FlyWeb را پیکربندی کرده است.</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="7601756527349047847">‏برای دریافت به‌روزرسانی‌های بعدی FlyWeb، باید macOS نسخه ۱۳ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۲ استفاده می‌کند.</translation>
<translation id="3916387280110223245">‏اخیراً بازدیدی نداشته‌اید. ‫FlyWeb ‏<ph name="PERMISSION_1"/> و <ph name="PERMISSION_2"/> را برداشت.</translation>
<translation id="3313237823190188892">‏نمایش «Gemini در FlyWeb» در سینی سیستم</translation>
<translation id="7401687852903179959">جستجوی این ویدیو با «جستجوی تصویر»</translation>
<translation id="6624551989332401777">‏‫FlyWeb اکنون مرورگر پیش‌فرض شما است</translation>
<translation id="277733508197886564">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: FlyWeb هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="948152006162936800">‏وارد کردن گذرواژه‌ها به FlyWeb</translation>
<translation id="4755314372270379254">‏۱. روی <ph name="BUTTON_LABEL"/> در زیر کلیک کنید
۲. روی <ph name="BUTTON_2"/> در تنظیمات Windows کلیک کنید
۳. روی <ph name="BUTTON_3"/> در اعلان Windows کلیک کنید تا FlyWeb را برای دسترسی سریع به نوار وظیفه سنجاق کنید</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="7450541714075000668">نوشتار کپی شد</translation>
<translation id="7472280958921965834">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به FlyWeb دسترسی دهید</translation>
<translation id="2431618580332826398">‏برای دریافت به‌روزرسانی‌های آتی FlyWeb، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="2154651873647244914">‏FlyWeb راه‌اندازی مجدد شود؟</translation>
<translation id="3137757192868162370">‏نمی‌توانید FlyWeb دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً FlyWeb را ببندید و دوباره سعی کنید.</translation>
<translation id="3065486555702061722">‏یادآور: بهترین‌های FlyWeb در جیب شما</translation>
<translation id="4027434552262956425">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های FlyWeb را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم FlyWeb وارد شده باشید از «حساب FlyWeb» خارج نخواهید شد.</translation>
<translation id="4731230085409037950">{0,plural, =1{‏FlyWeb ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏FlyWeb ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏FlyWeb ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="301074550630080641">‏برای محافظت از داده‌هایتان، به FlyWeb اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند.</translation>
<translation id="3930051800510118744">‏برای شروع فوری مرور، FlyWeb را به‌طور خودکار راه‌اندازی کنید.</translation>
<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">‏FlyWeb درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="1381291360713116383">‏FlyWeb اکنون بهتر شده است</translation>
<translation id="3892366519980032442">‏اکنون ویژگی‌های بیشتری در FlyWeb دردسترس شما قرار دارد</translation>
<translation id="7624307931717240213">ما از اطلاعات برای بهبود این سرویس استفاده می‌کنیم. به «خط‌مشی رازداری» و «شرایط خدمات» مراجعه کنید.</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="7733015548570443346">‏دریافت برنامه FlyWeb</translation>
<translation id="7658239707568436148">لغو</translation>
<translation id="2230101319599356673">‏FlyWeb مرورگر پیش‌فرض شما نیست</translation>
<translation id="3243257760331619874">‏FlyWeb را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="3836891631266228927">‏به‌روزرسانی FlyWeb</translation>
<translation id="7362833186911891234">‏کارهای شما در FlyWeb ایمن است</translation>
<translation id="7716950018788545737">تکلیف(ها) پایان یافت.</translation>
<translation id="77283119132245232">سرویس‌های ردیابی سیستم را برای <ph name="BROWSER_NAME"/> ارائه می‌دهد. اگر این سرویس غیرفعال باشد، ردیابی‌های عملکردی که مرورگر ایجاد می‌کند شامل رویدادهای در سطح سیستم مانند رویدادهای تغییر زمینه و آماده‌سازی رشته نخواهد بود.</translation>
<translation id="1549877678317463759">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم FlyWeb وارد شوید.</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="104221467268393661">‏بازنشانی به FlyWeb پیش‌فرض</translation>
<translation id="2414061498125565915">‏برای حفظ امنیت کارهای شما در FlyWeb، سازمان‌تان می‌تواند اطلاعات خاصی را هنگام ورود به سیستم FlyWeb مشاهده یا مدیریت کند.</translation>
<translation id="494195283222791090">‏‫FlyWeb را به‌عنوان پیش‌فرض تنظیم کنید و آن را به نوار وظیفه سنجاق کنید</translation>
<translation id="134973275687829726">‏سرعت FlyWeb را افزایش دهید</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫FlyWeb برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="7810005234485217901">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید</translation>
<translation id="6059158364953614237">‏انتخاب کردن چیزهایی که می‌خواهید با FlyWeb هم‌رسانی شود</translation>
<translation id="8463540467315366872">‏درحال‌حاضر یک نمایه FlyWeb با این حساب در این دستگاه وجود دارد</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="3682929584258119691">‏موتور جستجوی شما از خارج‌از FlyWeb تغییر کرد. برای محافظت از شما، FlyWeb آن را به پیش‌فرض اصلی‌اش بازنشانی کرد. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">‏با سفارشی‌سازی FlyWeb، ظاهری جدید به آن ببخشید</translation>
<translation id="8611872055947278722">‏FlyWeb به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS"/> ثانیه باقی مانده است</translation>
<translation id="3999247564452560622">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، <ph name="BEGIN_LINK"/>داده‌های FlyWeb ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">‏هر زمان که نیاز داشتید، «Gemini در FlyWeb» به‌سرعت باز می‌شود</translation>
<translation id="6798431672720500005">‏تنظیم FlyWeb به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="332151924263389003">‏‫FlyWeb اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="3096730275883527801">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS"/> وارد سیستم FlyWeb شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="7097534420680357688">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید. همچنین نشانک‌ها و اطلاعات دیگر در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="9017338699075596174">‏این نصب ثانویه FlyWeb است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="2888168499066553233">‏با برنامه FlyWeb در <ph name="DEVICE_TYPE"/>، بیشترین بهره را از FlyWeb ببرید</translation>
<translation id="8004582292198964060">مرورگر</translation>
<translation id="8010081455002666927">شناسایی خودکار</translation>
<translation id="5944585442866020176">‏وقتی FlyWeb دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="4462215250900528778">‏‫FlyWeb را به نوار وظیفه سنجاق کنید تا هرزمان خواستید سریع‌تر به آن دسترسی داشته باشید</translation>
<translation id="80471789339884597">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید همه مرورگرها را بازراه‌اندازی کنید.</translation>
<translation id="8054112667659782652">همیشه نشان دادن میان‌بر «جستجوی تصویر»</translation>
<translation id="8069447462453318634">«سنجاق کردن به نوارابزار» را انتخاب کنید</translation>
<translation id="3685797926747054412">‏غیرفعال کردن اجرای FlyWeb در پس‌زمینه برای برنامه‌ها</translation>
<translation id="80790299200510644">جستجوی تصویر</translation>
<translation id="8086881907087796310">نصب انجام نشد زیرا رایانه شما با حداقل شرایط سخت‌افزاری مطابقت ندارد.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">‏FlyWeb برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="5289593085778678155">‏دفعه بعد که FlyWeb را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای فعال کردن هشدارهای ردگیری قیمت خواهید دید.</translation>
<translation id="7635444121786764725">‏با برنامه FlyWeb در تلفنتان، برای کالاهایی که به آن‌ها علاقه‌مندید هشدار کاهش قیمت دریافت کنید</translation>
<translation id="8118331347066725040">درباره جستجو با «لنز»، بازخورد ارسال کنید</translation>
<translation id="5770057404954060005">‏‫FlyWeb را مخصوص خودتان کنید</translation>
<translation id="5334309298019785904">‏ChromeOS نتوانست داده‌هایتان را همگام‌سازی کند زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="813913629614996137">درحال مقداردهی اولیه…</translation>
<translation id="6992240065504496864">‏‫«Gemini در FlyWeb» را با میان‌بر صفحه‌کلید باز کنید.</translation>
<translation id="6334554715655789744">‏شرایط خدمات تکمیلی FlyWeb</translation>
<translation id="1597323875619800374">‏این فایل خطرناک است، بنابراین FlyWeb آن را مسدود کرده است.</translation>
<translation id="8177472873527554730">محتوای موردنظر در صفحه پیدا نشد</translation>
<translation id="2214224574148863941">‏برای استفاده از داده‌های FlyWeb و ذخیره کردن آن‌ها در حسابتان (<ph name="USER_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="820759916613250543">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="8221491193165283816">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان بفرستد، اینجا را کلیک کنید.</translation>
<translation id="2459467374982542273">‏برای استفاده از دوربین، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به FlyWeb دسترسی دهید</translation>
<translation id="4749458995158778066">‏‫FlyWeb نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از FlyWeb حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="6756872644564483342">‏اگر تصویری توضیح مفیدی نداشته باشد، FlyWeb توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به FlyWeb ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="9179486248398668702">‏در نمایه جدید به سیستم FlyWeb وارد می‌شوید؟</translation>
<translation id="1470002120352085290">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم FlyWeb وارد شوید. همچنین گذرواژه‌ها و اطلاعات دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="8901123396574346662">‏نشان دادن «Gemini در FlyWeb» در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="9102959605052547519">‏‫FlyWeb درباره سایت‌ها و بارگیری‌های ناامن <ph name="BEGIN_LINK"/>به شما هشدار می‌دهد<ph name="END_LINK"/></translation>
<translation id="669999719045196468">‏اخیراً بازدیدی نداشته‌اید. ‫FlyWeb ‏<ph name="PERMISSION"/> را برداشت.</translation>
<translation id="7136168924180047124">‏در برنامه FlyWeb ویژه iOS، با دوربینتان آنچه را می‌بینید بخرید، ترجمه کنید، و شناسایی کنید</translation>
<translation id="867002910715789721">‏رمزینه پاسخ‌سریع برای ورود به سیستم FlyWeb با <ph name="USER_NAME"/></translation>
<translation id="8313851650939857356">خطای راه‌اندازی: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">‏اگر <ph name="TIMEOUT_DURATION"/> از FlyWeb استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="8321888067342493336">ذخیره کردن به‌عنوان تصویر</translation>
<translation id="9174706677133564856">‏<ph name="USER_EMAIL_ADDRESS"/> قبلاً از FlyWeb استفاده می‌کرد</translation>
<translation id="7009033378151348624">‏فعال کردن «مهارت‌ها» در FlyWeb</translation>
<translation id="338142060986183805">‏برای ادامه استفاده از داده‌های FlyWeb ذخیره‌شده در «حساب FlyWeb» خود (<ph name="ACCOUNT_EMAIL"/>)،‏ FlyWeb را به‌روز کنید</translation>
<translation id="7408894216012529448">‏برای دریافت به‌روزرسانی‌های آتی FlyWeb، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="8362914115861174987">ترجمه به</translation>
<translation id="8367705492654390392">هرچه می‌خواهید بپرسید</translation>
<translation id="5020916672477085422">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم FlyWeb وارد شوید. بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب FlyWeb» شما ذخیره خواهد شد.</translation>
<translation id="5417365165109189454">‏سپس باید FlyWeb را بازراه‌اندازی کنید.</translation>
<translation id="4212474799248200893">‏‫FlyWeb توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از FlyWeb حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="3669395395617655404">‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب FlyWeb» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، FlyWeb باید هویت شما را تأیید کند. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="5261590792975521002">{0,plural, =1{‏FlyWeb را ظرف یک روز راه‌اندازی مجدد کنید}one{‏FlyWeb را ظرف # روز راه‌اندازی مجدد کنید}other{‏FlyWeb را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="8438543370129609977">‏وقتی از «جستجوی تصویر» استفاده می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به سرور ارسال می‌شود. <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">‏درباره جستجو کردن با «جستجوی تصویر» در FlyWeb بیشتر بدانید</translation>
<translation id="3101564993057563365">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً FlyWeb را دوباره را بارگیری کنید.</translation>
<translation id="5316851838033144902">‏FlyWeb به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="6760691951531758781">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به FlyWeb، به بهبود ویژگی‌ها و عملکرد ChromeOS کمک کنید.</translation>
<translation id="2523037024749170569">‏برای ذخیره کردن داده‌های FlyWeb در «حساب FlyWeb» خود و استفاده کردن از آن‌ها، هویتتان را درستی‌سنجی کنید</translation>
<translation id="5989540778099253163">‏پیام‌واره‌های ورود به سیستم FlyWeb را نشان می‌دهد</translation>
<translation id="6852836260419236265">‏نسخه FlyWeb قدیمی است</translation>
<translation id="360892078644515524">‏از اینکه FlyWeb را به‌عنوان مرورگر پیش‌فرض خود انتخاب کردید سپاس‌گزاریم!</translation>
<translation id="797182360653885317">‏‫FlyWeb زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="8525579356836940628">نصب متوقف شد</translation>
<translation id="8340284327429540526">‏با برنامه FlyWeb در<ph name="DEVICE_TYPE"/>، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحرکت همراه خود داشته باشید</translation>
<translation id="7498776423722712116">‏اگر FlyWeb یکی از گذرواژه‌هایتان را در سرقت اطلاعات شبکه عمومی پیدا کند، هشدار دریافت می‌کنید</translation>
<translation id="8555465886620020932">خطای سرویس: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">‏برخی‌از ویژگی‌ها و افزونه‌های FlyWeb دارای میان‌بر هستند. می‌توانید انتخاب کنید که آن‌ها را دوباره روشن کنید.</translation>
<translation id="8556420416730706394">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید؛ روی دکمه «سنجاق کردن» در بالای پانل کناری کلیک کنید</translation>
