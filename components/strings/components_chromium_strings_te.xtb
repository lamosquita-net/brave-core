<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="130631256467250065">మీ మార్పులు మీరు మీ డివైజ్‌ను పునఃప్రారంభించే తర్వాతిసారి అమలులోకి వస్తాయి.</translation>
<translation id="125853961893919199">FlyWeb చిట్కా: పాస్‌వర్డ్‌లను సేవ్ చేయండి</translation>
<translation id="1589233279653618219">FlyWeb
          మెనూ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>‌కు వెళ్లి,
          మీ కాన్ఫిగరేషన్ "ప్రాక్సీ వద్దు" లేదా "డైరెక్ట్" అనే ఆప్షన్‌కు సెట్ చేసి ఉందని నిర్ధారించుకోండి.</translation>
<translation id="8359495463485001719">Braveలో క్రాష్ రిపోర్ట్‌ అందుబాటులో లేదు.</translation>
<translation id="6338530717474923868">మీరు సురక్షితమైన FlyWeb పేజీని వీక్షిస్తున్నారు</translation>
<translation id="5147169001159408844">పేమెంట్ ఆప్షన్‌లను పూరించడానికి సంబంధించిన సెట్టింగ్‌లను ఎడిట్ చేయడానికి FlyWeb ట్రై చేస్తోంది.</translation>
<translation id="5702992568540613683">FlyWeb లోగో</translation>
<translation id="8966580353365544289">FlyWeb చిట్కా: మెరుగైన సురక్షిత బ్రౌజింగ్</translation>
<translation id="510342522494506803">పేమెంట్ ఆప్షన్‌లను ఎడిట్ చేయడానికి FlyWeb ట్రై చేస్తోంది.</translation>
<translation id="8375862260948854624">FlyWeb అనేది <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ఓపెన్ సోర్స్ ప్రాజెక్ట్ మరియు ఇతర <ph name="BEGIN_LINK_OSS"/>ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_OSS"/>లపై ఎంతగానో ఆధారపడుతుంది.</translation>
<translation id="5040124620086808431">FlyWeb ద్వారా ఈ పేజీ బ్లాక్ చేయబడింది</translation>
<translation id="1953000035868532675">మీ ఫైర్‌వాల్ లేదా యాంటీవైరస్ సెట్టింగ్‌ల్లో నెట్‌వర్క్‌ను యాక్సెస్ చేయడానికి
        Braveను అనుమతించండి.</translation>
<translation id="4949828774841497663">అప్లికేషన్‌లు &gt; సిస్టమ్ సెట్టింగ్‌లు &gt; నెట్‌వర్క్ ఆప్షన్‌కు వెళ్లి,
          యాక్టివ్‌గా ఉన్న నెట్‌వర్క్‌ను ఎంచుకొని, వివరాలు... బటన్‌ను క్లిక్ చేసి, ఏవైనా ప్రాక్సీలు ఎంపిక చేసి ఉంటే,
          ఎంపికను తొలగించండి.</translation>
<translation id="7584668345330431749">FlyWeb
          మెనూ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          నెట్‌వర్క్ &amp; ఇంటర్నెట్ &gt; ప్రాక్సీకి వెళ్లి,
          "సెట్టింగ్‌లను ఆటోమేటిక్‌గా గుర్తించడం" అనే ఎంపికను తొలగించండి.</translation>
<translation id="3145451630329266064">ఈ పేజీలు FlyWeb డెవలపర్‌ల ఉపయోగం కోసం ఉద్దేశించినవి, అలాగే యాక్టివ్‌గా నిర్వహించబడకపోవచ్చు లేదా పరీక్షించబడకపోవచ్చు. వాటిని ఎనేబుల్ చేయడానికి, <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>కు నావిగేట్ చేయండి, డీబగ్ పేజీలను ఎనేబుల్ చేయడానికి బటన్‌ను క్లిక్ చేసి, ఆపై మళ్లీ ఈ పేజీకి నావిగేట్ చేయండి.</translation>
<translation id="2681118099728446983">ఇతర <ph name="BEGIN_LINK_OSS"/>ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_OSS"/> ద్వారా కూడా Braveను రూపొందించడం సాధ్యమయ్యింది.</translation>
<translation id="6888846095017247017">మీ మార్పులు మీరు Braveని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="8524328905288851065">పెయిరింగ్‌ను కొనసాగించడానికి Braveకు 
 బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177"><ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ఓపెన్ సోర్స్ ప్రాజెక్ట్ ద్వారా Braveను రూపొందించడం సాధ్యమయ్యింది.</translation>
<translation id="7777112741998051633">FlyWeb మెనూ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>కు వెళ్లండి,
          ఆపై "<ph name="NO_PREFETCH_DESCRIPTION"/>" ఎంపికను తీసివేయండి.
          దీని వల్ల సమస్య పరిష్కారం కాకపోతే, మెరుగైన పనితీరు కోసం మీరు
          ఈ ఎంపికను మళ్లీ ఎంచుకోవాలని మేము సిఫార్సు చేస్తున్నాము.</translation>
<translation id="4699594416850504200">మీరు సురక్షితమైన FlyWeb for Testing పేజీని చూస్తున్నారు</translation>
<translation id="6224789938625024797">FlyWeb సరిగ్గా షట్ డౌన్ కాలేదు.</translation>
<translation id="3593104813552438879">FlyWeb చిట్కా: Lensతో సెర్చ్ చేయండి</translation>
</translationbundle>