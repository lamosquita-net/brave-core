<!DOCTYPE translationbundle>
<translationbundle lang="sk">
<translation id="1026101648481255140">Pokračovať v inštalácii</translation>
<translation id="7099479769133613710">Znova spustiť a aktualizovať &amp;FlyWeb OS</translation>
<translation id="291426170030461697">FlyWeb odporúča, aby ste toto rozšírenie skontrolovali</translation>
<translation id="1549005488226693697">Keď nejaký web požiada o súkromné prednačítanie odkazov na svojej stránke, FlyWeb použije servery Googlu. Týmto sa pred predinštalovaným webom skryje vaša identita, ale FlyWeb sa naučí, ktoré weby sa prednačítavajú.</translation>
<translation id="1065672644894730302">Vaše predvoľby sa nedajú načítať.

Niektoré funkcie nemusia byť k dispozícii a zmeny vykonané v predvoľbách sa neuložia.</translation>
<translation id="8908267645832965492">Váš nadradený účet vypol Povolenia pre weby, aplikácie a rozšírenia v prehliadači FlyWeb</translation>
<translation id="5557633153169217776">FlyWeb potrebuje prístup k vašej miestnej sieti, aby mohol vyhľadávať a používať zariadenia v okolí</translation>
<translation id="6441390163669415879">Ak chcete vyhľadať konkrétnu funkciu alebo rozšírenie prehliadača FlyWeb, zadajte jeho skratku do panela s adresou a potom stlačte vybraný kláves klávesnice</translation>
<translation id="9001750423919983557">Zobrazovať vyhľadávanie pomocou prehliadača FlyWeb v oblasti oznámení a zapnúť klávesovú skratku</translation>
<translation id="1368460307421081773">Prehliadač FlyWeb sa pokúša exportovať vaše heslá. Ak to chcete povoliť, zadajte heslo systému Windows.</translation>
<translation id="112640046208448578">Identifikujte veci alebo miesta a skopírujte či preložte text. Pri používaní vyhľadávania podľa obrázkov sa snímka obrazovky stránky sa odošle na server. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb je vaším predvoleným prehliadačom</translation>
<translation id="4556715463645168547">Ak chcete skontrolovať, či sú vaše heslá chránené pred porušením ochrany údajov a inými bezpečnostnými hrozbami, <ph name="BEGIN_LINK"/>prihláste sa do prehliadača FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Kliknite na ponuku prehliadača FlyWeb</translation>
<translation id="1157985233335035034">Nedávne jazyky</translation>
<translation id="1184145431117212167">Nepodarilo sa nainštalovať, pretože vaša verzia systému Windows nie je podporovaná.</translation>
<translation id="4380351562011537903">Informácie o prehliadači FlyWeb</translation>
<translation id="853148447909557566">Dostávajte upozornenia sledovania cien v prehliadači FlyWeb v telefóne</translation>
<translation id="1203500561924088507">Ďakujeme za inštaláciu. Než začnete aplikáciu <ph name="BUNDLE_NAME"/> používať, musíte reštartovať prehliadač.</translation>
<translation id="1232234696885483911">Keď otvoríte vyhľadávanie podľa obrázkov, názov stránky, webová adresa a obsah vrátane súborov PDF sa automaticky odošlú na server. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Kým máte aktívne prihlásenie, môžete v prehliadači FlyWeb používať svoje heslá a ďalší obsah zo svojho účtu FlyWeb. Ak to chcete zmeniť, prejdite do sekcie Váš účet v prehliadači FlyWeb.</translation>
<translation id="7614508617663739435">Zobrazovať Gemini v prehliadači FlyWeb na paneli s ponukami Macu</translation>
<translation id="832555967476614730">Na výber časti obrazovky na paneli Gemini v prehliadači FlyWeb môžete používať klávesovú skratku.</translation>
<translation id="4750836834956739196">Keď bola táto karta neaktívna, bola uvoľnená pamäť, aby FlyWeb zostal rýchly. Môžete nastaviť, aby bol tento web vždy vylúčený z nečinnosti.</translation>
<translation id="3190759351483708314">Prehliadač FlyWeb toto sťahovanie zablokoval, pretože daný súbor je nebezpečný</translation>
<translation id="5879469261638423015">Keď sa budete účtom <ph name="USER_EMAIL"/> prihlasovať do služieb Googlu, ako je Gmail alebo YouTube, môžete sa ním automaticky prihlásiť aj do prehliadača FlyWeb</translation>
<translation id="7142135954326264349">Stiahnite si FlyWeb do telefónu</translation>
<translation id="1290883685122687410">Chyba nastavenia: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Nastavte si nový profil prehliadača FlyWeb</translation>
<translation id="5252737639504553444">Vyskúšať s Gemini v prehliadači FlyWeb</translation>
<translation id="609743863669742325">FlyWeb potrebuje na preskúmanie zariadení s rozhraním Bluetooth prístup k rozhraniu Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Prihláste sa do prehliadača FlyWeb v telefóne</translation>
<translation id="1330562121671411446">Rozpoznať jazyk</translation>
<translation id="2276527911011636666">Odstrániť aj údaje z prehliadača FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Pripnuté! K vyhľadávaniu podľa obrázkov máte opäť prístup pomocou nového tlačidla na paneli s nástrojmi.</translation>
<translation id="1383876407941801731">Vyhľadávanie</translation>
<translation id="1045149878186896649">Používajte aplikáciu FlyWeb a prehliadajte si internet kdekoľvek</translation>
<translation id="141901961143729572">Zdieľajte svoje názory</translation>
<translation id="2758515779140515865">Ak chcete zdieľať okno, povoľte prehliadaču FlyWeb nahrávať obrazovku v nastaveniach systému.</translation>
<translation id="4713192356155907986">Získať pomoc s verziou FlyWeb for Testing</translation>
<translation id="4984443629206419460">Ak chcete mať k dispozícii svoje uložené informácie a ďalší obsah zo zariadenia <ph name="DEVICE"/>, prihláste sa do prehliadača FlyWeb</translation>
<translation id="1497802159252041924">Chyba inštalácie: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Táto stránka je chránená</translation>
<translation id="8962360511570172">Zdieľajte kartu prehliadača FlyWeb</translation>
<translation id="2941487459666781243">Prihlásiť sa do prehliadača FlyWeb</translation>
<translation id="1547469039832541117">Ukončí zvýraznenú úlohu.</translation>
<translation id="3182893868355533457">Pripnúť FlyWeb</translation>
<translation id="852852907317361085">Bezpečnostné nástroje prehliadača FlyWeb</translation>
<translation id="481155564361715417">FlyWeb chce odstrániť vaše údaje Správcu hesiel. Ak to chcete povoliť, zadajte heslo systému Windows.</translation>
<translation id="2846999307505917298">Využívajte to najlepšie od Googlu s aplikáciou FlyWeb v telefóne</translation>
<translation id="3961251277542681013">Pozrite si hlavné ovládacie prvky ochrany súkromia a zabezpečenia v prehliadači FlyWeb</translation>
<translation id="1640672724030957280">Sťahuje sa…</translation>
<translation id="1665602916345474427">Prihlásili ste sa ako <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, členstvo. Otvoriť ponuku účtu</translation>
<translation id="7625232007557474355">FlyWeb môžete kedykoľvek použiť kliknutím na odkazy v správach, dokumentoch a ďalších aplikáciách. Bude pripnutý aj na paneli aplikácií.</translation>
<translation id="1709772298389099340">Poskytuje vyššie oprávnenia pre <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">FlyWeb čoskoro odstráni dáta prehliadania</translation>
<translation id="8939535770474283898">FlyWeb sa pokúsi inovovať navigácie na HTTPS</translation>
<translation id="2581127533455294937">Vymazanie údajov prehliadača FlyWeb</translation>
<translation id="7385422968404728039">FlyWeb sa reštartuje o <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Keď HTTPS nie je k dispozícii, FlyWeb bude bez upozornenia používať nezabezpečené pripojenie</translation>
<translation id="307170399141486420">Povoliť prehliadaču FlyWeb spustenie na pozadí</translation>
<translation id="5006568136491721884">Kliknutím na <ph name="BEGIN_BOLD"/>Áno<ph name="END_BOLD"/> v upozornení systému Windows pripnite FlyWeb na panel aplikácií, aby ste k nemu mali rýchly prístup.</translation>
<translation id="2473319786107120819">Preinštalovať prehliadač FlyWeb</translation>
<translation id="2533324957407080119">FlyWeb sa pokúša <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">Používateľ <ph name="EXISTING_USER"/> je už prihlásený. Ak chcete, aby bolo vaše prehliadanie naďalej samostatné, prihláste sa vo svojom profile do prehliadača FlyWeb účtom <ph name="USER_EMAIL_ADDRESS"/>. Získate aj rozšírenia a ďalšie položky zo zariadenia <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Pri ďalšom otvorení prehliadača FlyWeb v zariadení <ph name="DEVICE_TYPE"/> sa zobrazí výzva na používanie Správcu hesiel FlyWeb.</translation>
<translation id="1838374766361614909">Vymazať vyhľadávanie</translation>
<translation id="3403116471618205223">Ak chcete odstrániť dáta prehliadania iba z tohto zariadenia a vo svojom účte FlyWeb ich ponechať, <ph name="BEGIN_LINK"/>odhláste sa z prehliadača FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Stiahnite si FlyWeb do telefónu a otvárajte alebo vytvárajte nové skupiny kariet, nech ste kdekoľvek.</translation>
<translation id="3285741355512747610">Svoje prihlásené účty FlyWeb môžete spravovať. Účty FlyWeb sa používajú pre prehliadač FlyWeb, Obchod Play, Gmail a ďalšie služby. Ak chcete pridať účet inej osoby, napríklad člena rodiny, pridajte radšej novú osobu do svojho zariadenia <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Ďalšie informácie<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Vyhľadávanie podľa obrázkov</translation>
<translation id="5054936737639982722">Používateľ <ph name="EXISTING_USER"/> je už prihlásený. Ak chcete, aby bolo vaše prehliadanie naďalej samostatné, prihláste sa vo svojom profile do prehliadača FlyWeb účtom <ph name="USER_EMAIL_ADDRESS"/>. Získate aj záložky a ďalšie položky zo zariadenia <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Vybrať text</translation>
<translation id="4824940465467423308">Prihlasujete sa pomocou spravovaného účtu a jeho správcovi dávate kontrolu nad vaším profilom FlyWeb. Vaše údaje prehliadača FlyWeb, ako sú aplikácie, záložky, história, heslá a iné nastavenia, sa natrvalo priradia k účtu <ph name="USER_NAME"/>. Tieto údaje budete môcť odstrániť len pomocou panela Dashboard v Účtoch FlyWeb, ale nebudete ich môcť priradiť k inému účtu. Ak chcete, aby boli existujúce údaje prehliadača FlyWeb oddelené, môžete vytvoriť nový profil. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb šetrí batériu tým, že obmedzí aktivitu na pozadí a vizuálne efekty, napríklad plynulé posúvanie a snímkové frekvencie videa. <ph name="BEGIN_LINK"/>Ďalšie informácie o šetriči energie<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Služba FlyWeb Updater</translation>
<translation id="7390382558747224642">Po vypnutí tejto možnosti sa budete môcť prihlásiť do webov Googlu (napríklad do Gmailu) bez prihlásenia do prehliadača FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb nereaguje. Chcete ho spustiť znova?</translation>
<translation id="5866699689358760578">Vaša organizácia (<ph name="MANAGER"/>) vyžaduje, aby ste sa prihlásili do prehliadača FlyWeb</translation>
<translation id="4035053306113201399">Aktualizácia sa použije po reštartovaní systému FlyWeb OS.</translation>
<translation id="3750729306035486751">Prehliadač FlyWeb toto sťahovanie zablokoval, pretože používatelia tento typ súboru bežne nesťahujú a môže byť nebezpečný</translation>
<translation id="1953553007165777902">Sťahuje sa… Zostávajúci čas: <ph name="MINUTE"/> min</translation>
<translation id="6956650624767954726">FlyWeb nedokáže určiť alebo nastaviť predvolený prehliadač</translation>
<translation id="197326043290947695">Prehliadajte s vyhľad. podľa obrázkov</translation>
<translation id="130679046523922050">Prečo FlyWeb blokuje niektoré súbory, otvorí sa na novej karte</translation>
<translation id="8243822903505210769">Udržiava softvér prehliadača FlyWeb aktuálny. Ak je táto služba deaktivovaná alebo zastavená, softvér prehliadača FlyWeb sa nebude aktualizovať, čo znamená, že nedostatky zabezpečenia, ktoré sa vyskytnú, sa nebudú dať opraviť a funkcie nemusia fungovať. Táto služba sa sama odinštaluje, keď ju nebude používať žiadny softvér prehliadača FlyWeb.</translation>
<translation id="6495079989036864983">Táto akcia odstráni zo zariadenia jednu položku. Ak budete chcieť svoje údaje neskôr opäť načítať, prihláste sa do prehliadača FlyWeb ako <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Inštalácia bola neúspešná. Skúste to znova.</translation>
<translation id="2039417478970545937">Nastavenia</translation>
<translation id="8544477465831682343">Vyberte, či sa má zahrnúť história prehliadača FlyWeb na zaistenie prispôsobenejšieho prostredia v službách Googlu</translation>
<translation id="328650761750741315">Je integrovaný v prehliadači FlyWeb, aby vám pomáhal vytvárať, ukladať a automaticky dopĺňať silné heslá. Pridajte si odkaz na jednoduchý prístup.</translation>
<translation id="2407746489237278840">Kliknite na tlačidlo Prispôsobiť FlyWeb na stránke na novej karte a dajte prehliadaču FlyWeb nový vzhľad</translation>
<translation id="8924891216494775926">Prehliadač FlyWeb toto sťahovanie zablokoval, pretože daný súbor je klamlivý a môže vo vašom zariadení vykonať neočakávané zmeny</translation>
<translation id="5728214838078602184">Pri ďalšom otvorení prehliadača FlyWeb pre iOS sa zobrazí výzva na vyskúšanie funkcie <ph name="FEATURE_NAME"/>.</translation>
<translation id="2058207584484841616">Heslá a ďalšie údaje prehliadača FlyWeb, ktoré ste si uložili do účtu FlyWeb, budú z tohto zariadenia odstránené. Ak ich chcete opäť používať v prehliadači FlyWeb, znova sa prihláste.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa FlyWeb nebude používať jednu minútu. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}few{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa FlyWeb nebude používať # minúty. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}many{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa FlyWeb nebude používať # minúty. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}other{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa FlyWeb nebude používať # minút. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}}</translation>
<translation id="2125838419757773031">Vyberte oblasť obrazovky na vyhľadávanie</translation>
<translation id="2126108037660393668">Stiahnutý súbor sa nepodarilo overiť.</translation>
<translation id="2135919691573380097">Nahlásenie tohto webu</translation>
<translation id="2137162749895930932">Zavrieť obrazovku prekladu</translation>
<translation id="2147218225094845757">Skryť bočný panel</translation>
<translation id="4474394796469499134">Prehliadač FlyWeb toto sťahovanie zablokoval, pretože daný web nepoužíva zabezpečené pripojenie a v súbore mohol niekto vykonať zmeny</translation>
<translation id="2170098639895543546">Vyberte čokoľvek na stránke</translation>
<translation id="6765231735885996239">Prispôsobiť FlyWeb</translation>
<translation id="2174917724755363426">Inštalácia nie je dokončená. Naozaj ju chcete zrušiť?</translation>
<translation id="2937508664417729967">FlyWeb – prihlásenie do siete – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Chyba kontroly aktualizácií: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Odstrániť účet z prehliadača FlyWeb</translation>
<translation id="744837314710861405">Získajte aplikáciu FlyWeb a majte najlepšie nákupné nástroje vždy so sebou</translation>
<translation id="2745381939758295588">Zlepšené bezpečné prehliadanie v prehliadači FlyWeb pre systém iOS vám zaistí väčšiu bezpečnosť na cestách</translation>
<translation id="6707114110652917144">Nebezpečný web. Prehliadač FlyWeb odstránil upozornenia.</translation>
<translation id="2236949375853147973">Moja aktivita</translation>
<translation id="4646732243247482236">Ak chcete mať adresy a ďalší obsah k dispozícii vo všetkých svojich zariadeniach, prihláste sa do prehliadača FlyWeb. Táto adresa bude uložená do vášho účtu FlyWeb, keď sa prihlásite.</translation>
<translation id="2726680594710751908">Ak počítač zdieľate s rodinou a priateľmi, môžu v prehliadači FlyWeb prehliadať oddelene a tiež si ho nastaviť podľa vlastných požiadaviek.</translation>
<translation id="4086571337340463916">Zručnosti v prehliadači FlyWeb</translation>
<translation id="2283803047247799269">Prehľadať túto kartu pomocou vyhľadávania podľa obrázkov</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb odporúča pozastaviť kartu, ktorá spomaľuje váš prehliadač}few{FlyWeb odporúča pozastaviť karty, ktoré spomaľujú váš prehliadač}many{FlyWeb recommends pausing the tabs slowing your browser}other{FlyWeb odporúča pozastaviť karty, ktoré spomaľujú váš prehliadač}}</translation>
<translation id="2307973900865360088">Ponechať v doku</translation>
<translation id="5067150284614317159">Kontroluje webové adresy podľa zoznamu nebezpečných webov uloženého v prehliadači FlyWeb. Ak sa vám určitý web pokúsi ukradnúť heslo alebo stiahnete škodlivý súbor, FlyWeb môže tiež odoslať webové adresy vrátane častí obsahu stránky Bezpečnému prehliadaniu.</translation>
<translation id="2356070529366658676">Opýtať sa</translation>
<translation id="2359808026110333948">Pokračovať</translation>
<translation id="7339360994527471629">Rozšírenie <ph name="EXTENSION_NAME"/> žiada, aby ste sa prihlásili do prehliadača FlyWeb</translation>
<translation id="8788732221355188962">Deaktivovať spustenie prehliadača FlyWeb na pozadí pre aplikácie</translation>
<translation id="4126251160852694747">Ak chcete používať toto rozšírenie ako <ph name="USER_EMAIL_ADDRESS"/>, prihláste sa do prehliadača FlyWeb.</translation>
<translation id="8418845734693287262">Systému FlyWeb OS sa nepodarilo synchronizovať vaše údaje, pretože vaše prihlasovacie údaje účtu sú zastarané.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{K 1 zariadeniu s ľudským rozhraním malo prístup jedno alebo viac rozšírení pre prehliadač FlyWeb}=1{K 1 zariadeniu s ľudským rozhraním má prístup jedno alebo viac rozšírení pre prehliadač FlyWeb}few{K # zariadeniam s ľudským rozhraním má prístup jedno alebo viac rozšírení pre prehliadač FlyWeb}many{# HID devices are being accessed by one or more FlyWeb extensions}other{K # zariadeniam s ľudským rozhraním má prístup jedno alebo viac rozšírení pre prehliadač FlyWeb}}</translation>
<translation id="1364879203203742966">FlyWeb vyžaduje pre tento web povolený prístup ku kamere aj mikrofónu</translation>
<translation id="2403703063067034158">Chyba pri spustení: momentálne je spustená iná inštancia nastavenia. Skúste to neskôr.</translation>
<translation id="656987653252575654">Otvárajte odkazy v prehliadači FlyWeb z ľubovoľnej aplikácie a majte prehliadač k dispozícii na paneli aplikácií</translation>
<translation id="157662717324308283">Kliknutím na tlačidlo Zhrnúť zdieľajte tento dokument s Gemini v prehliadači FlyWeb, získajte rýchly prehľad a položte ďalšie otázky</translation>
<translation id="1968013196034892522">Pomocou <ph name="BEGIN_LINK"/>nástrojov prehliadača FlyWeb<ph name="END_LINK"/> môžete bezpečne prehliadať a mať všetko pod kontrolou</translation>
