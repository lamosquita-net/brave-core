<translation id="7022252178852457880">‏تنظیم کردن FlyWeb به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن به نوار وظیفه</translation>
<translation id="8826492472752484139">روی «مدیر گذرواژه» کلیک کنید</translation>
<translation id="6933858244219479645">‏سیستم ChromeOS</translation>
<translation id="1501202286854500367">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در FlyWeb استفاده می‌شود</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="2405293075272280413">‏افزودن نمایه FlyWeb</translation>
<translation id="2096285611267043007">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromeOS نتوانست داده‌های FlyWeb را در «حساب FlyWeb» شما ذخیره کند</translation>
<translation id="9046344742397901138">‏سازمانتان شما را ملزم می‌کند به سیستم FlyWeb وارد شوید</translation>
<translation id="4669168852412989042">‏FlyWeb در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2704405030486981087">‏‫FlyWeb دیگر مرورگر پیش‌فرض شما نیست. FlyWeb  مرورگر پیش‌فرض شود</translation>
<translation id="1663379621921336006">‏به‌روزرسانی FlyWeb امکان‌پذیر نیست</translation>
<translation id="8944232836376404813">این کنش:
          <ph name="LINE_BREAKS"/>
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK"/>
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK"/>
            • کوکی‌ها و سایر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAKS"/>
            نشانک‌ها، سابقه و گذرواژه‌های ذخیره‌شده شما تحت تأثیر قرار نخواهند گرفت.</translation>
