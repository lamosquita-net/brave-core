<translation id="8375862260948854624">FlyWeb fonctionne grâce au projet Open Source <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> et à <ph name="BEGIN_LINK_OSS"/>d'autres logiciels libres<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Accédez au
          menu FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
