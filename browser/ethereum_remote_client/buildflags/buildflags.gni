import("//extensions/buildflags/buildflags.gni")

declare_args() {
  # FlyWeb: kept at Brave's default. With false, 1.57 does not build
  # (browser/brave_wallet/external_wallets_importer.cc and others use it
  # unguarded). The extension is never loaded instead: see
  # BraveComponentLoader::AddEthereumRemoteClientExtension().
  ethereum_remote_client_enabled = enable_extensions
}
