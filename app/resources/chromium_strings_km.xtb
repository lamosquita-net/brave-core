<translation id="6724485219247982027">សូមបិទផ្ទាំង FlyWeb ទាំងអស់ ហើយព្យាយាមម្តងទៀត។</translation>
<translation id="763231524941489073">ដើម្បីការពារ​ឯកជនភាព​របស់អ្នក យើងលុប​ចំណាប់អារម្មណ៍​របស់អ្នក​ដែលចាស់ជាង 4 សប្ដាហ៍​ដោយស្វ័យប្រវត្តិ។ នៅពេលដែលអ្នក​បន្តរុករក ចំណាប់អារម្មណ៍​ប្រហែលជាបង្ហាញ​នៅលើ​បញ្ជីម្ដងទៀត។ ឬអ្នកអាច​ដកចំណាប់អារម្មណ៍ដែលអ្នក​មិនចង់ឱ្យ FlyWeb ពិចារណាចេញបាន។</translation>
<translation id="4856314253538330936">ប្រវត្តិរុករក​តាមអ៊ីនធឺណិត​របស់អ្នក កំណត់ត្រាអំពី​គេហទំព័រ​ដែលអ្នកបានចូលមើល​ដោយប្រើ FlyWeb នៅលើ​ឧបករណ៍នេះ។</translation>
<translation id="1054901839328542426">មាន​កម្មវិធី​បង្ក​គ្រោះថ្នាក់​នៅលើ​កុំព្យូទ័រ​របស់អ្នក។ FlyWeb អាច​លុប​វា ហើយ​ស្តារ​ការកំណត់​របស់អ្នក ដើម្បី​ធ្វើ​ឱ្យ​កម្មវិធី​រុករកតាម​អ៊ីនធឺណិត​របស់អ្នក​ដំណើរការ​ធម្មតា​ឡើងវិញ។ FlyWeb អាច​លុបកម្មវិធី​នេះ ស្ដារ​ការកំណត់​របស់អ្នក និងបិទ​កម្មវិធីបន្ថែម ដើម្បី​ធ្វើ​ឱ្យ​កម្មវិធី​រុករកតាម​អ៊ីនធឺណិត​របស់អ្នក​ដំណើរការ​ជាធម្មតា​ឡើងវិញ។</translation>
<translation id="199853864262219284">បានចូល​គណនី​ផ្សេងរួចហើយ។ ដើម្បី​រក្សាការរុករក​របស់អ្នក​ដាច់ដោយឡែក​ FlyWeb អាច​បង្កើត​កម្រងព័ត៌មាន​ផ្ទាល់ខ្លួន​របស់អ្នក​សម្រាប់អ្នក។</translation>
