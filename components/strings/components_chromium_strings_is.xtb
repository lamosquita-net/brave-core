<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="is">
<translation id="130631256467250065">Breytingarnar taka gildi næst þegar þú endurræsir tækið.</translation>
<translation id="125853961893919199">FlyWeb-ráð: Vistaðu aðgangsorð</translation>
<translation id="1589233279653618219">Farðu í
          valmynd FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          og gakktu úr skugga um að stillt sé á „ekki proxy“ eða „beint“.</translation>
<translation id="8359495463485001719">Hrunskýrslur eru ekki í boði í FlyWeb.</translation>
<translation id="6338530717474923868">Þú ert að skoða örugga FlyWeb síðu</translation>
<translation id="5147169001159408844">FlyWeb er að reyna að breyta stillingum fyrir útfyllingu greiðslumáta.</translation>
<translation id="5702992568540613683">FlyWeb lógóið</translation>
<translation id="8966580353365544289">FlyWeb-ráð: Enn öruggari vefskoðun</translation>
<translation id="510342522494506803">FlyWeb er að reyna að breyta greiðslumátum.</translation>
<translation id="8375862260948854624">Opna kóðaverkefnið <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> og annar <ph name="BEGIN_LINK_OSS"/>opinn hugbúnaður<ph name="END_LINK_OSS"/> gerir FlyWeb mögulegt.</translation>
<translation id="5040124620086808431">FlyWeb setti þessa síðu á bannlista</translation>
<translation id="1953000035868532675">Veittu FlyWeb aðgang að netkerfinu þínu í eldveggsstillingunum þínum eða
          vírusvarnarstillingunum.</translation>
<translation id="4949828774841497663">Farðu í Forrit &gt; Kerfisstillingar &gt; Netkerfi og veldu
          virkt netkerfi, smelltu á hnappinn Upplýsingar... og afveldu alla staðgengla
          sem kunna að hafa verið valdir.</translation>
<translation id="7584668345330431749">Farðu í
          valmynd FlyWeb&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netkerfi og internet &gt; Proxy
          og afveldu „Greina stillingar sjálfkrafa“.</translation>
<translation id="3145451630329266064">Þessar síður eru ætlaðar til notkunar hjá þróunaraðilum FlyWeb og er e.t.v. ekki haldið við eða prófaðar reglulega. Til að kveikja á þeim skaltu fara á <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, smella á hnappinn til að kveikja á villuleitarsíðum og fara síðan aftur á þessa síðu.</translation>
<translation id="2681118099728446983">FlyWeb virkar einnig í krafti annars <ph name="BEGIN_LINK_OSS"/>hugbúnaðar með opinn kóða<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Breytingar þínar munu taka gildi næst þegar þú endurræsir FlyWeb.</translation>
<translation id="8524328905288851065">FlyWeb þarf Bluetooth-aðgang til að halda pörun 
 áfram. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb virkar í krafti verkefnis <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> um opinn kóða.</translation>
<translation id="7777112741998051633">Farðu í
        valmynd FlyWeb &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og taktu valið af „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
        Ef þetta leysir ekki málið mælum við með að gera þennan valkost
        virkan á ný til að auka afköst.</translation>
<translation id="4699594416850504200">Þú ert að skoða örugga FlyWeb for Testing-síðu</translation>
<translation id="6224789938625024797">FlyWeb lokaðist ekki á réttan hátt.</translation>
<translation id="3593104813552438879">Ábending frá FlyWeb: Leitaðu með linsu</translation>
</translationbundle>