+      data.borders.BlockSum() == LayoutUnit() &&
+      data.margin_line_over == LayoutUnit() &&
+      data.margin_line_under == LayoutUnit()) {
+    return absl::nullopt;
+  }
+  return std::make_pair(data.margin_line_over, data.margin_line_under);
