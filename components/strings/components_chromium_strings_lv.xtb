<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="130631256467250065">Izmaiņas stāsies spēkā nākamajā reizē, kad restartēsiet ierīci.</translation>
<translation id="125853961893919199">FlyWeb padoms: paroļu saglabāšana</translation>
<translation id="1589233279653618219">Pārejiet uz FlyWeb izvēlni &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> un konfigurācijai iestatiet opciju “Bez starpniekservera” vai “Tiešs savienojums”.</translation>
<translation id="8359495463485001719">Avāriju pārskatu sūtīšana nav pieejama pārlūkā FlyWeb.</translation>
<translation id="6338530717474923868">Jūs skatāt drošu FlyWeb lapu.</translation>
<translation id="5147169001159408844">Pārlūkā FlyWeb tiek mēģināts mainīt maksājuma veidu aizpildes iestatījumus.</translation>
<translation id="5702992568540613683">FlyWeb logotips</translation>
<translation id="8966580353365544289">FlyWeb padoms: funkcija “Droša pārlūkošana ar papildu aizsardzību”</translation>
<translation id="510342522494506803">Pārlūkā FlyWeb tiek mēģināts automātiski rediģēt maksājuma veidus.</translation>
<translation id="8375862260948854624">FlyWeb ir kļuvis iespējams, pateicoties <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> atklātā pirmkoda projektam un citai <ph name="BEGIN_LINK_OSS"/>atklātā pirmkoda programmatūrai<ph name="END_LINK_OSS"/>.</translation>
<translation id="5040124620086808431">Šī lapa ir bloķēta pārlūkā FlyWeb.</translation>
<translation id="1953000035868532675">Ugunsmūra vai antivīrusu programmas iestatījumu maiņa, lai atļautu pārlūkam FlyWeb piekļūt tīklam.</translation>
<translation id="4949828774841497663">Pārejiet uz sadaļu Applications (Lietojumprogrammas) &gt; System Settings (Sistēmas iestatījumi) &gt; Network (Tīkls), atlasiet aktīvo tīklu, noklikšķiniet uz pogas “Details...” (Detalizēta informācija) un noņemiet atlasi visiem starpniekserveriem, kas, iespējams, ir atlasīti.</translation>
<translation id="7584668345330431749">Pārejiet uz FlyWeb izvēlni &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Tīkls un internets &gt; Starpniekserveris un noņemiet atzīmi no izvēles rūtiņas “Automātiski noteikt iestatījumus”.</translation>
<translation id="3145451630329266064">Šīs lapas ir paredzētas FlyWeb izstrādātājiem, un tās var nebūt aktīvi uzturētas vai testētas. Lai tās iespējotu, pārejiet uz lapu <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, noklikšķiniet uz pogas, lai iespējotu atkļūdošanas lapas, un pēc tam atkal pārejiet uz šo lapu.</translation>
<translation id="2681118099728446983">Pārlūku FlyWeb nodrošina arī cita <ph name="BEGIN_LINK_OSS"/>atklātā pirmkoda programmatūra<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Izmaiņas stāsies spēkā, kad restartēsiet FlyWeb.</translation>
<translation id="8524328905288851065">Pārlūkam FlyWeb ir nepieciešama Bluetooth piekļuve, lai turpinātu savienošanu pārī. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">Pārlūku FlyWeb nodrošina <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> atklātā pirmkoda projekts.</translation>
<translation id="7777112741998051633">Atveriet
        FlyWeb izvēlni &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        un noņemiet atzīmi no izvēles rūtiņas “<ph name="NO_PREFETCH_DESCRIPTION"/>”.
        Ja problēmu neizdodas novērst, ieteicams atkal atlasīt šo opciju,
        lai uzlabotu veiktspēju.</translation>
<translation id="4699594416850504200">Jūs skatāt drošu pārlūka FlyWeb for Testing lapu</translation>
<translation id="6224789938625024797">FlyWeb netika pareizi izslēgts.</translation>
<translation id="3593104813552438879">FlyWeb padoms: meklējiet, izmantojot Lens</translation>
</translationbundle>