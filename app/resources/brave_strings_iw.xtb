<translation id="6773570808762718524">‏התאמה אישית של פרופיל FlyWeb החדש</translation>
<translation id="8965010907836433875">‏אפשר להמשיך להתכתב בצ'אט עם מצב AI בלי לעבור בין כרטיסיות. כדי להתחיל, עליך להיכנס לחשבון שלך ב-FlyWeb. אחרי הכניסה, הסיסמאות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="5958835776851191812">‏כדי להסיר את החשבון שלך ב-FlyWeb מ-FlyWeb, צריך לצאת מ-FlyWeb בדף ההגדרות</translation>
<translation id="4217346567895356023">‏בהמשך, תוצג לך שאלה ב-FlyWeb אם להשתמש במידע השמור כדי למלא בשבילך טפסים באופן אוטומטי</translation>
<translation id="5449297306961970452">‏FlyWeb אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">‏עם FlyWeb ב-iOS, אפשר לקחת את הכלים שמבוססים על FlyWeb AI איתך לכל מקום.</translation>
<translation id="8090118570458552025">‏כדי לקבל גישה לתוספים ולנתונים נוספים מתוך <ph name="DEVICE"/>, צריך להיכנס ל-FlyWeb</translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="3900612994249740104">‏המפתחות של FlyWeb API חסרים. פונקציונליות מסוימת של FlyWeb תהיה מושבתת.</translation>
<translation id="6824575001009586492">‏המשך הפעלת יישומים ברקע כאשר FlyWeb סגור</translation>
<translation id="2595215790271940091">‏FlyWeb יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="3701353923785984059">‏אם סוגרים את כל החלונות של FlyWeb, מתבצעת יציאה מהחשבון ברוב האתרים, אבל לא מחשבון FlyWeb, אם נכנסת אליו ב-FlyWeb. כדי לאפשר לאתרים לזכור אותך, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">‏הפינה הימנית העליונה של אזור החיפוש: ‎<ph name="RIGHT"/>%‎ מימין, ‎<ph name="TOP"/>%‎ מלמעלה</translation>
<translation id="8629055140319079166">‏נתוני FlyWeb בחשבון שלך</translation>
<translation id="1943161457314845496">‏רוצה להשתמש בסיסמאות שלך ב-FlyWeb בטלפון?</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">‏לעבור לפרופיל קיים של FlyWeb?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="1568435374218487057">‏כדי לקבל גישה לסימניות ולנתונים נוספים מתוך <ph name="DEVICE"/>, צריך להיכנס ל-FlyWeb</translation>
<translation id="3438772217992559640">חיפוש בכרטיסייה בעזרת "חיפוש תמונות"</translation>
<translation id="6301354573631022693">‏רוצה להרחיב את הגרסה המשופרת של גלישה בטוחה ב-FlyWeb בטלפון?</translation>
<translation id="7625477329092296018">‏‫FlyWeb מבצע התאמה אישית…</translation>
<translation id="956833467923764542">‏פעולה זו תמחק <ph name="ITEMS_COUNT"/> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל FlyWeb עם <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">‏ניתן לעבור בין פרופילים של FlyWeb באמצעות <ph name="SHORTCUT"/></translation>
<translation id="6724485219247982027">‏יש לסגור את כל חלונות FlyWeb ולנסות שוב.</translation>
<translation id="5048962017649434283">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-FlyWeb בקטע "הגדרות המערכת"</translation>
<translation id="1582211253241551883">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER"/>.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-FlyWeb בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="408747932595284596">‏קוד QR להורדת הדפדפן FlyWeb למכשירים ניידים</translation>
<translation id="1413410454753055427">‏תזכורת: תכונות הבטיחות הכי טובות של FlyWeb – אצלך בכיס</translation>
<translation id="7831730508158736496">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-FlyWeb בקטע "הגדרות המערכת".</translation>
<translation id="9006158231572141726">‏הפעלת ההגנה המשופרת משביתה את האופטימיזציה של JavaScript באתרים ש-FlyWeb לא מזהה</translation>
<translation id="3597003331831379823">הפעלת ההגדרה נכשלה עם הרשאות מורחבות. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">‏כניסה ל-FlyWeb</translation>
<translation id="6970052268542136081">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-FlyWeb בתור <ph name="USER_EMAIL"/>.</translation>
<translation id="3667616615096815454">אין אפשרות להתקין, האפליקציה לא מוכרת לשרת.</translation>
<translation id="2438845157914027912">‏שימוש ב<ph name="BEGIN_LINK"/>ביטוי סיסמה משלך<ph name="END_LINK"/> כדי להצפין את כל נתוני FlyWeb בחשבון FlyWeb. אמצעי תשלום וכתובות שנשמרו ב-Google Pay לא יוצפנו. היסטוריית הגלישה ב-FlyWeb לא תסונכרן.</translation>
<translation id="6611602069520888180">‏פתיחת הקישור ב&amp;כרטיסיית FlyWeb חדשה</translation>
<translation id="2591356225047803326">‏אפשר לקשר את FlyWeb לשירותי FlyWeb אחרים לצורך התאמה אישית ולמטרות אחרות</translation>
<translation id="3729187154190517324">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים באמצעות הכפתור "הוספת כרטיסייה ועוד".</translation>
<translation id="1771882170639856394">‏ניהול הפרופילים ב-FlyWeb</translation>
<translation id="3782148374606932577">‏למה הורדות מסוימות נחסמות ב-FlyWeb</translation>
<translation id="4640643918757362950">‏FlyWeb יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="2179738813053854729">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת FlyWeb טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3810973564298564668">ניהול</translation>
<translation id="5026502787439628947">‏כדי להשתמש בסיסמאות השמורות, צריך לסרוק את קוד ה-QR, להוריד את FlyWeb ל-iOS ולהיכנס לחשבון FlyWeb</translation>
<translation id="3846683726093018685">**סיכום:** במשפט אחד של פחות מ-30 מילים, צריך לתאר את הנושא והמטרה העיקריים של התוכן בצילום המסך.

          **הצעת שאלות:** יצירת רשימה של 3-5 שאלות מעוררות מחשבה שהמשתמש יכול לשאול כדי להבין טוב יותר את צילום המסך. לפחות שאלה אחת צריכה להתייחס באופן ספציפי לאובייקט חזותי, לעיצוב שלו או למיקום שלו.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-FlyWeb</translation>
<translation id="3885770153807205175">הכלי לבחירת שפה</translation>
<translation id="5175060854726708547">‏התאמה אישית וניהול של FlyWeb נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="606156353708638647">‏יש ללחוץ על השם שלך כדי לפתוח את FlyWeb ולהתחיל לגלוש.</translation>
<translation id="3892148308691398805">העתקת הטקסט</translation>
<translation id="5145107420478372433">‏המשתמש <ph name="EXISTING_USER"/> כבר מחובר לפרופיל FlyWeb הזה. כדי להפריד בין פעילויות גלישה, FlyWeb יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="8536259619256229278">‏FlyWeb מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="7965008434896274911">‏כדי לקבל גישה למידע השמור ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-FlyWeb</translation>
<translation id="4540773594514226705">‏הסיסמאות, אמצעי התשלום והכתובות ששמרת בחשבון שלך ב-FlyWeb יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-FlyWeb, צריך להיכנס שוב לחשבון.</translation>
<translation id="395904275706073188">לא ניתן לקרוא דפים מוגנים. כדאי לנסות דף אחר.</translation>
<translation id="3849784651193576458">‏איך מערכת FlyWeb שומרת על האבטחה שלך</translation>
<translation id="3967822245660637423">ההורדה הושלמה</translation>
<translation id="562495843857641474">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, FlyWeb שולח את הטקסט הזה לכלי החיפוש, הבינה המלאכותית והסוכנים של הארגון כדי לקבל הצעות.</translation>
<translation id="5667414856761616811">‏מידע על &amp;FlyWeb for Testing</translation>
<translation id="1152920704813762236">‏מידע על ChromeOS</translation>
<translation id="4920206821838432969">‏כשמבקרים באתר מסוים, FlyWeb שולח ל<ph name="BEGIN_LINK"/>גלישה בטוחה של FlyWeb<ph name="END_LINK"/> קטע קוד מעורפל מכתובת ה-URL דרך שרת פרטיות שמסתיר את כתובת ה-IP. אם האתר פועל באופן שמעורר חשד, יישלחו גם כתובות URL מלאות וקטעי תוכן מדפים.</translation>
<translation id="4016217212818346953">מנהל הסיסמאות עוזר לשמור על הבטיחות שלך</translation>
<translation id="3703994572283698466">‏השימוש ב-ChromeOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS"/>תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS"/> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS"/>סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
