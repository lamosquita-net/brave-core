<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">
<translation id="1026101648481255140">நிறுவலை மீண்டும் தொடங்கு</translation>
<translation id="7099479769133613710">&amp;ChromeOSஸைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="291426170030461697">இந்த நீட்டிப்பைச் சரிபார்க்குமாறு FlyWeb பரிந்துரைக்கிறது</translation>
<translation id="1549005488226693697">ஒரு தளம் அதன் பக்கத்தில் இருக்கும் இணைப்புகளைத் தனிப்பட்ட முறையில் முன்கூட்டியே ஏற்றுமாறு கேட்கும்போது FlyWeb சேவையகங்களை FlyWeb பயன்படுத்துகிறது. இதனால் முன்கூட்டியே ஏற்றப்பட்ட தளத்துடன் உங்கள் அடையாளம் பகிரப்படாது. ஆனால் எந்தத் தளம் முன்கூட்டியே ஏற்றப்பட வேண்டும் என்பதை FlyWeb அறிந்துகொள்ளும்.</translation>
<translation id="1065672644894730302">உங்கள் விருப்பதேர்வுகள் படிக்கும்படி இல்லை. சில அம்சங்கள் கிடைக்காமல் இருக்கலாம் மேலும் விருப்பதேர்வுகளின் மாற்றங்களைச் சேமிக்க முடியாது.</translation>
<translation id="8908267645832965492">Braveமில் "தளங்கள், ஆப்ஸ், நீட்டிப்புகள் ஆகியவற்றுக்கான அனுமதிகள்" என்பதை உங்கள் பெற்றோர் முடக்கிவிட்டார்</translation>
<translation id="5557633153169217776">அருகிலுள்ள சாதனங்களைக் கண்டறிந்து பயன்படுத்த Braveமிற்கு உங்கள் லோக்கல் நெட்வொர்க் அணுகல் தேவை</translation>
<translation id="6441390163669415879">குறிப்பிட்ட FlyWeb அம்சம் அல்லது நீட்டிப்பைத் தேட, முகவரிப் பட்டியில் அதன் ஷார்ட்கட்டை டைப் செய்தபிறகு நீங்கள் தேர்ந்தெடுத்த கீபோர்டு பட்டனை டைப் செய்யவும்</translation>
<translation id="9001750423919983557">சிஸ்டம் டிரேயில் Braveமில் Search காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="1368460307421081773">FlyWeb உங்கள் கடவுச்சொற்களை ஏற்ற விரும்புகிறது. இதை அனுமதிக்க, உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="112640046208448578">பொருட்களையும் இடங்களையும் கண்டறியலாம், வார்த்தைகளை நகலெடுக்கலாம் மொழிபெயர்க்கலாம். படத் தேடலைப் பயன்படுத்தும்போது அந்தப் பக்கத்தின் ஸ்கிரீன்ஷாட் சேவையகத்துக்கு அனுப்பப்படும். <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">உங்கள் இயல்புநிலை உலாவி FlyWeb ஆகும்</translation>
<translation id="4556715463645168547">தரவு மீறல்கள் மற்றும் பிற பாதுகாப்புச் சிக்கல்களிலிருந்து உங்கள் கடவுச்சொற்கள் பாதுகாப்பாக இருக்கின்றனவா என்பதைச் சரிபார்க்க <ph name="BEGIN_LINK"/>Braveமில் உள்நுழையுங்கள்<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb மெனுவைக் கிளிக் செய்யவும்</translation>
<translation id="1157985233335035034">சமீபத்திய மொழிகள்</translation>
<translation id="1184145431117212167">ஆதரிக்கப்படாத Windows பதிப்பை நீங்கள் பயன்படுத்துவதால் நிறுவ முடியவில்லை.</translation>
<translation id="4380351562011537903">FlyWeb அறிமுகம்</translation>
<translation id="853148447909557566">உங்கள் மொபைலில் FlyWeb மூலம் விலைக் கண்காணிப்பு விழிப்பூட்டல்களைப் பெறுங்கள்</translation>
<translation id="1203500561924088507">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME"/> ஐப் பயன்படுத்துவதற்கு முன் உலாவியை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="1232234696885483911">படத் தேடலைத் திறக்கும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை தானாகவே சேவையகத்திற்கு அனுப்பப்படும். <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">உள்நுழைந்திருக்கும்போது உங்கள் FlyWeb கணக்கில் உள்ள கடவுச்சொற்களையும், மேலும் பலவற்றையும் நீங்கள் Braveமில் பயன்படுத்தலாம். இதை மாற்ற, “Braveமில் உங்கள் கணக்கு” என்பதற்குச் செல்லவும்.</translation>
<translation id="7614508617663739435">Mac மெனு பட்டியில் Braveமில் Geminiயைக் காட்டு</translation>
<translation id="832555967476614730">Braveமில் Geminiயில் திரையின் ஒரு பகுதியைத் தேர்ந்தெடுக்க கீபோர்டு ஷார்ட்கட்டைப் பயன்படுத்தலாம்.</translation>
<translation id="4750836834956739196">FlyWeb தொடர்ந்து வேகமாக இயங்குவதற்கு, இந்தப் பக்கம் செயலில் இல்லாதபோது நினைவகம் காலியாக்கப்பட்டது. இந்தத் தளத்தை எப்போதும் செயலற்ற நிலையில் இருந்து விலக்க நீங்கள் தேர்வுசெய்யலாம்.</translation>
<translation id="3190759351483708314">இந்த ஃபைல் ஆபத்தானது என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/> கணக்கின் மூலம் Gmail, YouTube போன்ற FlyWeb சேவைகளில் உள்நுழையும்போது Braveமிலும் அதே கணக்கின் மூலம் தானாக நீங்கள் உள்நுழையலாம்.</translation>
<translation id="7142135954326264349">உங்கள் மொபைலில் Braveமைப் பெறுங்கள்</translation>
<translation id="1290883685122687410">அமைவுப் பிழை: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">உங்கள் புதிய FlyWeb சுயவிவரத்தை அமைத்திடுங்கள்</translation>
<translation id="5252737639504553444">Braveமில் Gemini மூலம் பயன்படுத்துக</translation>
<translation id="609743863669742325">புளூடூத் சாதனங்களைக் கண்டறிய 
 Braveமிற்கு புளூடூத் அணுகல் தேவை. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">மொபைலில் Braveமில் உள்நுழையுங்கள்</translation>
<translation id="1330562121671411446">மொழியைக் கண்டறி</translation>
<translation id="2276527911011636666">FlyWeb தரவையும் நீக்கு (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">பின் செய்யப்பட்டது! கருவிப்பட்டியில் உள்ள புதிய பட்டன் மூலம் படத் தேடலை மீண்டும் அணுகலாம்</translation>
<translation id="1383876407941801731">தேடுக</translation>
<translation id="1045149878186896649">எங்கிருந்தும் தொடர்ந்து பிரவுஸ் செய்ய FlyWeb ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="141901961143729572">உங்கள் கருத்துகளைப் பகிருங்கள்</translation>
<translation id="2758515779140515865">சாளரத்தைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்.</translation>
<translation id="4713192356155907986">FlyWeb for Testing தொடர்பான உதவியைப் பெறுங்கள்</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> சாதனத்தில் உள்ள சேமிக்கப்பட்ட தகவல்களையும் மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="1497802159252041924">நிறுவல் பிழை: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">இந்தப் பக்கம் பாதுகாக்கப்படுகிறது</translation>
<translation id="8962360511570172">FlyWeb தாவலைப் பகிர்தல்</translation>
<translation id="2941487459666781243">Braveமில் உள்நுழை</translation>
<translation id="1547469039832541117">தனிப்படுத்திய பணியை முடிக்கும்.</translation>
<translation id="3182893868355533457">Braveமைப் பின் செய்</translation>
<translation id="852852907317361085">Braveமின் பாதுகாப்புக் கருவிகள்</translation>
<translation id="481155564361715417">உங்கள் Password Managerரில் உள்ள தரவை FlyWeb நீக்க விரும்புகிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை டைப் செய்யவும்.</translation>
<translation id="2846999307505917298">உங்கள் மொபைலில் FlyWeb ஆப்ஸ் மூலம் Braveளின் சிறந்த அம்சங்களைப் பெறுங்கள்</translation>
<translation id="3961251277542681013">Braveமில் உள்ள முக்கியமான தனியுரிமை மற்றும் பாதுகாப்புக் கட்டுப்பாடுகளைச் சரிபாருங்கள்</translation>
<translation id="1640672724030957280">பதிவிறக்குகிறது...</translation>
<translation id="1665602916345474427">மெம்பர்ஷிப் உள்ள <ph name="USER_NAME"/> (<ph name="USER_EMAIL"/>) என்ற கணக்கில் உள்நுழைந்துள்ளீர்கள். கணக்கு மெனுவைத் திறக்கும்.</translation>
<translation id="7625232007557474355">மெசேஜ்கள், ஆவணங்கள் மற்றும் பிற ஆப்ஸில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Braveமைப் பயன்படுத்தலாம். அது உங்கள் செயல் பட்டியிலும் பின் செய்யப்படும்.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> பிரவுசருக்குக் கூடுதல் அணுகலை வழங்கும்.</translation>
<translation id="5695205873161614119">உலாவிய தரவை FlyWeb விரைவில் நீக்கும்</translation>
<translation id="8939535770474283898">வழிசெலுத்தல்களை HTTPSக்கு மேம்படுத்த FlyWeb முயலும்</translation>
<translation id="2581127533455294937">FlyWeb தரவு அழிக்கப்பட்டது</translation>
<translation id="7385422968404728039"><ph name="REMAINING_TIME"/> இல் FlyWeb மீண்டும் தொடங்கும்</translation>
<translation id="6903827847227122616">HTTPS கிடைக்காதபோது, FlyWeb உங்களை எச்சரிக்காமலேயே பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தும்</translation>
<translation id="307170399141486420">பின்புலத்தில் FlyWeb ஐ இயக்கு</translation>
<translation id="5006568136491721884">விரைவாக அணுகுவதற்கு Braveமை உங்கள் செயல் பட்டியில் பின் செய்ய, Windows அறிவிப்பில் <ph name="BEGIN_BOLD"/>ஆம்<ph name="END_BOLD"/> என்பதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="2473319786107120819">FlyWeb ஐ மீண்டும்நிறுவு</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> முயல்கிறது</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE"/> கணக்கில் இருந்து உங்கள் நீட்டிப்புகளையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="3547283483106013256">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் Braveமைத் திறக்கும்போது, FlyWeb Password Managerரைப் பயன்படுத்தும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="1838374766361614909">தேடலை அழி</translation>
<translation id="3403116471618205223">உலாவிய தரவை உங்கள் FlyWeb கணக்கில் இருந்து நீக்காமல் இந்தச் சாதனத்தில் இருந்து மட்டும் நீக்க, <ph name="BEGIN_LINK"/>Braveமில் இருந்து வெளியேறுங்கள்<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">எங்கிருந்தும் புதிய பக்கக் குழுக்களைத் திறக்கவோ உருவாக்கவோ உங்கள் மொபைலில் Braveமைப் பதிவிறக்குங்கள்.</translation>
<translation id="3285741355512747610">நீங்கள் உள்நுழைந்துள்ள FlyWeb கணக்குகளை நிர்வகிக்கலாம். FlyWeb உலாவி, Play Store, Gmail மற்றும் பலவற்றில் உங்கள் FlyWeb கணக்குகள் பயன்படுத்தப்படும். வேறு ஒருவரின் (எ.கா. குடும்ப உறுப்பினர்) கணக்கைச் சேர்க்க விரும்பினால் உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் ஒரு புதிய பயனரைச் சேர்க்கவும். <ph name="LINK_BEGIN"/>மேலும் அறிக<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">படத் தேடல் மூலம் தேடு</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE"/> இருந்து புக்மார்க்குகளையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="1880677175115548835">உரையைத் தேர்வுசெய்க</translation>
<translation id="4824940465467423308">நீங்கள் நிர்வகிக்கப்படும் கணக்கு மூலம் உள்நுழைகிறீர்கள், மேலும் அதன் நிர்வாகிக்கு உங்கள் FlyWeb சுயவிவரத்தின் கட்டுப்பாட்டை வழங்குகிறீர்கள். உங்கள் ஆப்ஸ், புக்மார்க்குகள், வரலாறு, கடவுச்சொற்கள் போன்ற உங்கள் FlyWeb தரவு மற்றும் பிற அமைப்புகள் நிரந்தரமாக <ph name="USER_NAME"/> உடன் இணைக்கப்படும். இந்தத் தரவை FlyWeb கணக்குகளின் டாஷ்போர்டு வழியாக நீக்க முடியும், ஆனால் இந்தத் தரவை வேறொரு கணக்குடன் தொடர்புபடுத்த முடியாது. விரும்பினால், உங்களுடைய நடப்பு FlyWeb தரவைத் தனிப்பட்ட முறையில் வைத்திருக்க நீங்கள் புதிய சுயவிவரத்தை உருவாக்கலாம். <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">பின்னணிச் செயல்பாடுகளையும் ஸ்மூத் ஸ்க்ரோலிங், வீடியோ ஃப்ரேம் வீதங்கள் போன்ற விஷுவல் எஃபெக்ட்டுகளையும் கட்டுப்படுத்தி FlyWeb பேட்டரி பவரைச் சேமிக்கிறது. <ph name="BEGIN_LINK"/>எனர்ஜி சேமிப்பு குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb Updater Service</translation>
<translation id="7390382558747224642">இதை முடக்கினால், நீங்கள் Braveமில் உள்நுழையாமலேயே Gmail போன்ற FlyWeb தளங்களில் உள்நுழையலாம்</translation>
<translation id="5714085538350759767">FlyWeb பதிலளிக்கவில்லை. இப்போது மீண்டும் தொடங்கவா?</translation>
<translation id="5866699689358760578">Braveமில் உள்நுழையும்படி உங்கள் நிறுவனம் (<ph name="MANAGER"/>) வலியுறுத்துகிறது</translation>
<translation id="4035053306113201399">புதுப்பிப்பைப் பயன்படுத்த, ChromeOSஸை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="3750729306035486751">இந்த ஃபைல் வகை பொதுவாகப் பதிவிறக்கப்படுவதில்லை என்பதுடன் ஆபத்தானதாகவும் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="1953553007165777902">பதிவிறக்குகிறது... <ph name="MINUTE"/> நிமிடங்கள் மீதமுள்ளன</translation>
<translation id="6956650624767954726">இயல்புநிலை உலாவியைக் கண்டறியவோ அமைக்கவோ FlyWeb ஆல் முடியவில்லை</translation>
<translation id="197326043290947695">படத்தேடல் மூலம் ஸ்மார்ட் பிரவுசிங் செய்க</translation>
<translation id="130679046523922050">சில ஃபைல்களைத் தடுத்து, புதிய பக்கத்தில் FlyWeb ஏன் திறக்கிறது என்று தெரிந்துகொள்ளுங்கள்.</translation>
<translation id="8243822903505210769">FlyWeb மென்பொருளைச் சமீபத்தியதாக வைத்திருக்கும். இந்தச் சேவை முடக்கப்பட்டாலோ நிறுத்தப்பட்டாலோ, உங்கள் FlyWeb மென்பொருள் சமீபத்தியதாக வைத்திருக்கப்படாது. அதாவது, பாதுகாப்புக் குறைபாடுகள் ஏற்படக்கூடும். அவற்றைச் சரிசெய்ய முடியாது என்பதுடன் அம்சங்களும் செயல்படாமல் போகலாம். இந்தச் சேவையை FlyWeb மென்பொருள் எதுவும் பயன்படுத்தவில்லை என்றால், சேவை தானாகவே நிறுவல் நீக்கப்படும்.</translation>
<translation id="6495079989036864983">வெளியேறினால், இந்தச் சாதனத்திலிருந்து ஓர் உருப்படி நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, FlyWeb இல் <ph name="USER_EMAIL"/> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="2018879682492276940">நிறுவ முடியவில்லை. மீண்டும் முயலவும்.</translation>
<translation id="2039417478970545937">அமைப்புகள்.</translation>
<translation id="8544477465831682343">FlyWeb சேவைகளில் மேலும் பிரத்தியேகமான அனுபவங்களைப் பெறுவதற்கு FlyWeb செயல்பாடுகளைச் சேர்க்க வேண்டுமா என்பதைத் தேர்வுசெய்யலாம்</translation>
<translation id="328650761750741315">வலிமையான கடவுச்சொற்களை உருவாக்கவும், சேமிக்கவும், தானாக நிரப்பவும் உங்களுக்கு உதவ இது Braveமில் உள்ளமைக்கப்பட்டுள்ளது. எளிதாக அணுக ஷார்ட்கட்டைச் சேருங்கள்.</translation>
<translation id="2407746489237278840">Braveமிற்குப் புதிய தோற்றத்தைக் கொடுக்க, புதிய பக்கத்தில் உள்ள Braveமைப் பிரத்தியேகமாக்குவதற்கான பட்டனைக் கிளிக் செய்யுங்கள்</translation>
<translation id="8924891216494775926">இந்த ஃபைல் ஏமாற்றக்கூடியது என்பதுடன் உங்கள் சாதனத்தில் எதிர்பாராத மாற்றங்களையும் செய்யலாம் என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="5728214838078602184">அடுத்த முறை FlyWeb iOSஸைத் திறக்கும்போது <ph name="FEATURE_NAME"/> அம்சத்தைப் பயன்படுத்திப் பார்க்கும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="2058207584484841616">உங்கள் FlyWeb கணக்கில் நீங்கள் சேமித்த உங்கள் கடவுச்சொற்களும் பிற FlyWeb தரவும் இந்தச் சாதனத்தில் இருந்து அகற்றப்படும். அவற்றைத் திரும்பவும் Braveமில் பயன்படுத்த, மீண்டும் உள்நுழையவும்.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{FlyWeb 1 நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உலாவிய தரவை உங்கள் நிறுவனம் தானாகவே நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம். உலாவிப் பக்கங்கள் திறந்தே இருக்கும்.}other{FlyWeb # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உலாவிய தரவை உங்கள் நிறுவனம் தானாகவே நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம். உலாவிப் பக்கங்கள் திறந்தே இருக்கும்.}}</translation>
<translation id="2125838419757773031">தேட திரையின் பகுதியைத் தேர்ந்தெடுக்கலாம்</translation>
<translation id="2126108037660393668">பதிவிறக்கப்பட்ட ஃபைலைச் சரிபார்க்க முடியவில்லை.</translation>
<translation id="2135919691573380097">இந்தத் தளத்தைப் புகாரளிக்கவும்</translation>
<translation id="2137162749895930932">மொழிபெயர்ப்புத் திரையை மூடும்</translation>
<translation id="2147218225094845757">பக்கவாட்டுப் பேனலை மறைக்கும்</translation>
<translation id="4474394796469499134">இந்தத் தளம் பாதுகாப்பான இணைப்பைப் பயன்படுத்தவில்லை என்பதுடன் ஃபைலும் சிதைந்து இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="2170098639895543546">இந்தப் பக்கத்தில் எதையும் தேர்ந்தெடுங்கள்</translation>
<translation id="6765231735885996239">Braveமைப் பிரத்தியேகப்படுத்து</translation>
<translation id="2174917724755363426">நிறுவல் நிறைவடையவில்லை. நிச்சயமாக ரத்துசெய்ய வேண்டுமா?</translation>
<translation id="2937508664417729967">FlyWeb - நெட்வொர்க் உள்நுழைவு - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">புதுப்பிப்புச் சரிபார்ப்புப் பிழை: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Braveமில் இருந்து கணக்கை அகற்று</translation>
<translation id="744837314710861405">சிறந்த ஷாப்பிங் கருவிகளை எங்கிருந்தும் அணுக FlyWeb ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="2745381939758295588">iOSஸிற்கான Braveமில் மேம்பட்ட பாதுகாப்பான பிரவுசிங் மூலம் எங்கும் பாதுகாப்பாக இருக்கலாம்</translation>
<translation id="6707114110652917144">ஆபத்தான தளம். அறிவிப்புகள் அனுமதியை FlyWeb அகற்றிவிட்டது.</translation>
<translation id="2236949375853147973">எனது செயல்பாடுகள்</translation>
<translation id="4646732243247482236">முகவரிகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் FlyWeb கணக்கில் இந்த முகவரி சேமிக்கப்படும்.</translation>
<translation id="2726680594710751908">நீங்கள் கம்ப்யூட்டரைப் பகிர்ந்தால், நண்பர்களும் குடும்பத்தினரும் தனிப்பட்ட முறையில் உலாவலாம், மேலும் Braveமை அவர்கள் விருப்பத்திற்கு ஏற்ப அமைத்துக்கொள்ளலாம்.</translation>
<translation id="4086571337340463916">Braveமில் திறன்கள்</translation>
<translation id="2283803047247799269">படத் தேடல் மூலம் இந்தப் பக்கத்தைத் தேடுங்கள்</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கத்தை இடைநிறுத்தும்படி FlyWeb பரிந்துரைக்கிறது}other{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கங்களை இடைநிறுத்தும்படி FlyWeb பரிந்துரைக்கிறது}}</translation>
<translation id="2307973900865360088">Dockகில் வைத்திரு</translation>
<translation id="5067150284614317159">Braveமில் சேமிக்கப்பட்டுள்ள பாதுகாப்பில்லாத தளங்களின் பட்டியலைப் பயன்படுத்தி URLகளைச் சரிபார்க்கும். ஏதாவதொரு தளம் உங்கள் கடவுச்சொல்லைத் திருட முயன்றாலோ தீங்குவிளைவிக்கும் ஃபைலை நீங்கள் பதிவிறக்கினாலோ FlyWeb, பாதுகாப்பு உலாவல் விழிப்பூட்டல்களில் பக்க உள்ளடக்கத்தின் சிறிய பகுதிகள் உட்பட URLகளையும் அனுப்பக்கூடும்.</translation>
<translation id="2356070529366658676">கேள்</translation>
<translation id="2359808026110333948">தொடர்க</translation>
<translation id="7339360994527471629">"<ph name="EXTENSION_NAME"/>" நீட்டிப்பைப் பயன்படுத்த Braveமில் நீங்கள் உள்நுழைய வேண்டும்</translation>
<translation id="8788732221355188962">ஆப்ஸிற்காக FlyWeb பின்புலத்தில் இயங்குவதை முடக்கு</translation>
<translation id="4126251160852694747"><ph name="USER_EMAIL_ADDRESS"/> என்ற கணக்கில் இந்த நீட்டிப்பைப் பயன்படுத்த Braveமில் உள்நுழையுங்கள்.</translation>
<translation id="8418845734693287262">உங்கள் கணக்கின் உள்நுழைவு விவரங்கள் காலாவதியாகிவிட்டதால் உங்கள் தரவை ChromeOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{1 HID சாதனம் ஒன்று அல்லது அதற்கு மேற்பட்ட FlyWeb நீட்டிப்புகளால் அணுகப்பட்டது}=1{1 HID சாதனத்தை ஒன்று அல்லது அதற்கு மேற்பட்ட FlyWeb நீட்டிப்புகள் அணுகுகின்றன}other{# HID சாதனங்களை ஒன்று அல்லது அதற்கு மேற்பட்ட FlyWeb நீட்டிப்புகள் அணுகுகின்றன}}</translation>
<translation id="1364879203203742966">இந்தத் தளத்தை அணுக, Braveமிற்கு கேமரா மற்றும் மைக்ரோஃபோன் அணுகல் தேவை</translation>
<translation id="2403703063067034158">துவக்கப் பிழை: அமைவுச் செயல்முறை ஏற்கெனவே நடைபெறுகிறது, பிறகு முயலவும்.</translation>
<translation id="656987653252575654">எந்த ஆப்ஸில் இருந்தும் Braveமில் இணைப்புகளைத் திறக்கலாம், உங்கள் செயல் பட்டியில் பிரவுசரை அணுகும் வகையில் வைத்திருக்கலாம்</translation>
<translation id="157662717324308283">விரைவான தகவல் சுருக்கத்தைப் பெறவும் ஃபாலோ-அப் கேள்விகளைக் கேட்கவும் இந்த ஆவணத்தை Braveமில் Gemini உடன் பகிர, சுருக்க விவரம் பட்டனைக் கிளிக் செய்யவும்</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>Braveமின் கருவிகள்<ph name="END_LINK"/> மூலம் பாதுகாப்பாக உலாவலாம், உங்கள் வசமே கட்டுப்பாட்டை வைத்திருக்கலாம்</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். கடவுச்சொற்களையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="2451727308784734061">ஷார்ட்கட்டைப் பயன்படுத்தி Password Managerரை விரைவாகத் திறக்கலாம். கம்ப்யூட்டரின் முகப்புத் திரைக்கோ ஆப்ஸ் துவக்கிக்கோ ஷார்ட்கட்டை நகர்த்தலாம்.</translation>
<translation id="3224379053610845181">FlyWeb விரைவில் மூடப்படும்</translation>
<translation id="3840682988105604367">FlyWeb இல்</translation>
<translation id="2485422356828889247">நிறுவல் நீக்கு</translation>
<translation id="2513154137948333830">மறுதொடக்கம் செய்ய வேண்டும்: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">படத் தேடல் மூலம் வார்த்தையைத் தேர்ந்தெடுக்கலாம்</translation>
<translation id="6823116595279840454">ஏற்கெனவே இருக்கும் கடவுச்சொற்களை FlyWeb மாற்ற விரும்புகிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை டைப்செய்யவும்.</translation>
<translation id="2691552788029831386">ஃபைல்களைப் பதிவிறக்க, Braveக்குச் சேமிப்பிட அணுகல் தேவை</translation>
<translation id="2275866327478859777">FlyWeb உதவி</translation>
<translation id="2575822587468774919">படத் தேடல் மூலம் தேட வேண்டியதைத் தேர்ந்தெடுங்கள்</translation>
<translation id="683641781063074351">கடவுச்சொற்கள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் அனைத்திலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="1659167470250249643">Braveமைப் பதிவிறக்கி உங்கள் FlyWeb கணக்கில் உள்நுழைய, மொபைல் மூலம் QR குறியீட்டை ஸ்கேன் செய்யவும்.</translation>
<translation id="5353172248151202719">Braveமில் தேட.</translation>
<translation id="3231856291920394348">தொடர்ந்து FlyWeb பயன்படுத்துக</translation>
<translation id="259935314519650377">பதிவிறக்கப்பட்ட நிறுவியைத் தற்காலிக நினைவகத்தில் சேமிக்க முடியவில்லை. பிழை: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">அமைப்பு</translation>
<translation id="7683745685556117660">உங்கள் புக்மார்க்குகள், பதிவுகள், கடவுச்சொற்கள் போன்ற பிரவுசிங் தரவை உங்கள் நிறுவனத்தால் பார்க்கவும் நிர்வகிக்கவும் முடியும். பிற FlyWeb கணக்குகளில் உள்ள பிரவுசிங் தரவை நிறுவனத்தால் பார்க்க முடியாது.</translation>
<translation id="5862783156828836752">உங்கள் கணக்கில் (<ph name="ACCOUNT_EMAIL"/>) உள்ள FlyWeb தரவைப் பயன்படுத்தவும் சேமிக்கவும் இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்</translation>
<translation id="4450675160413947126">FlyWeb ஐத் தொடங்கு</translation>
<translation id="3827993926722004004">நிறுவலின்போது இயக்க முறைமை பிழை ஏற்பட்டது. Braveமை மீண்டும் பதிவிறக்கம் செய்க.</translation>
<translation id="333184635927514678">நீங்கள் சாதனத்தைப் பகிர்ந்தால், நண்பர்களும் குடும்பத்தினரும் தனிப்பட்ட முறையில் உலாவலாம், மேலும் Braveமை அவர்கள் விருப்பத்திற்கேற்ப அமைத்துக்கொள்ளலாம்</translation>
<translation id="3917488635054382918">FlyWeb சிறிதாக்கப்பட்டிருந்தாலும் கூட உங்கள் சாதனம் முழுவதும் Braveமில் Geminiயைச் எளிதாகப் பயன்படுத்தலாம்.</translation>
<translation id="1257705702166647105">FlyWeb தாவல்</translation>
<translation id="2796283369875688710">கூடுதல் பாதுகாப்பிற்கு, FlyWeb உங்கள் தரவை என்க்ரிப்ட் செய்யும்.</translation>
<translation id="1118215875395945816">உங்கள் FlyWeb கணக்கை Braveமில் இருந்து அகற்ற, வெளியேறவும்</translation>
<translation id="3320675843036708646">கடவுச்சொற்கள், புக்மார்க்குகள் மற்றும் பலவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="2738871930057338499">இணையத்துடன் இணைக்க முடியவில்லை. HTTP 403 தடுக்கப்பட்டது. உங்கள் ப்ராக்ஸி உள்ளமைவைச் சரிபார்க்கவும்.</translation>
<translation id="2753623023919742414">தேட கிளிக் செய்யவும்</translation>
<translation id="8027563534376000179">Braveமை இயல்பு PDF வியூவராக அமையுங்கள்</translation>
<translation id="7907238427168022751">இந்த நீட்டிப்பில் மால்வேர் உள்ளது, மேலும் இது பாதுகாப்பற்றது. நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="2799223571221894425">மீண்டும் தொடங்கு</translation>
<translation id="1489590198317876070">உங்கள் FlyWeb</translation>
<translation id="2816462166102338036">படத் தேடல் அம்சம் மூலம் இந்த வீடியோவைத் தேடுங்கள்</translation>
<translation id="6850011743146651977">iOSஸிற்கான Braveமில் கேமரா மூலம் தயாரிப்புகளைக் கண்டறியலாம், விலைச் சரிவுகளைக் கண்காணிக்கலாம் மற்றும் பலவற்றை எங்கிருந்தும் செய்யலாம்.</translation>
<translation id="2841525013647267359">இதிலிருந்து மொழிபெயர்</translation>
<translation id="2846251086934905009">நிறுவல் பிழை: நிறுவியின் செயல்பாடு நிறைவடையவில்லை. நிறுவல் ரத்துசெய்யப்பட்டது.</translation>
<translation id="1339341044496643931">FlyWeb இலிருந்து அகற்று...</translation>
<translation id="4922993584046885552">Braveமைப் பயன்படுத்தும்போது பாதுகாப்பளிப்பதோடு நீங்கள் பிற FlyWeb ஆப்ஸில் உள்நுழைந்திருக்கும்போதும் பாதுகாப்பை அதிகரிக்கும்</translation>
<translation id="2885378588091291677">செயல் நிர்வாகி</translation>
<translation id="3806033752149316261">&amp;FlyWeb அறிமுகம்</translation>
<translation id="2915996080311180594">பின்னர் மீண்டும் தொடங்கு</translation>
<translation id="3497031519171753772">உங்கள் தரவு உங்கள் கடவுச்சொற்றொடர் மூலம் என்க்ரிப்ட் செய்யப்பட்டுள்ளது. உங்கள் FlyWeb கணக்கில் உள்ள FlyWeb தரவைப் பயன்படுத்தவும் சேமிக்கவும் அதை டைப் செய்யவும்.</translation>
<translation id="2945997411976714835">நிறுவல் பிழை: நிறுவியின் செயல்பாடு தொடங்கவில்லை.</translation>
<translation id="1784605133570901105">iOSஸிற்கான Braveமில் சேமித்துள்ள கடவுச்சொற்களைப் பயன்படுத்தி தளங்களில் விரைவாக உள்நுழையலாம்</translation>
<translation id="5383705372991100927">Braveமை உங்கள் நிறுவனம் நிர்வகிக்கிறது</translation>
<translation id="1661079783259785361">FlyWeb புதுப்பித்த நிலையில் உள்ளது</translation>
<translation id="5447533789927384736">எந்தத் தளமாவது உங்கள் கடவுச்சொல்லைத் திருட முயன்றாலோ தீங்கிழைக்கும் ஃபைலை நீங்கள் பதிவிறக்கினாலோ பக்க உள்ளடக்கத்தின் சிறிய பகுதிகள் உட்பட URLகளையும் பாதுகாப்பு உலாவலுக்கு FlyWeb அனுப்பக்கூடும்</translation>
<translation id="3208925917545144893">உங்கள் பெற்றோர் தேர்வுசெய்துள்ள அமைப்புகளுடன் ஆன்லைனில் பாதுகாப்பாக இருக்க, Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3003694935412297923">எல்லாப் பணிகளும்</translation>
<translation id="1216763100505470452">{count,plural, =1{இது நீங்கள்தான் என்பதை FlyWeb உறுதிசெய்ய வேண்டும். அதன் பிறகே, சில தரவுகளை உங்கள் FlyWeb கணக்கில் சேமித்து அவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பயன்படுத்த முடியும். நீங்கள் இப்போதே வெளியேறினால் இந்தத் தரவு (1 தரவு) நீக்கப்படும்.}other{இது நீங்கள்தான் என்பதை FlyWeb உறுதிசெய்ய வேண்டும். அதன் பிறகே, சில தரவுகளை உங்கள் FlyWeb கணக்கில் சேமித்து அவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பயன்படுத்த முடியும். இப்போதே வெளியேறினால் இந்தத் தரவு ({count} தரவுகள்) நீக்கப்படும்.}}</translation>
<translation id="8404327407921790238">Braveமில் புதிய பக்கத்தில் <ph name="URL"/> ஐத் திறக்கும்.</translation>
<translation id="5184501306555415561">திறன்கள் போன்ற AI கண்டுபிடிப்புகள் உங்கள் FlyWeb கணக்கில் சேமிக்கப்பட்டு FlyWeb ஒத்திசைவில் இருந்து தனியாக நிர்வகிக்கப்படும்</translation>
<translation id="4409390320695765203">உங்கள் நீட்டிப்புகளையும் மேலும் பலவற்றையும் உங்கள் எல்லாச் சாதனங்களிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="8841609317523323027">FlyWeb இல் சேர்க்கிறது...</translation>
<translation id="3038232873781883849">நிறுவக் காத்திருக்கிறது...</translation>
<translation id="3045032126857188731">மொழிபெயர்க்கப்படும் மொழி: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">கருத்திற்கான பெட்டியை மூடும்</translation>
<translation id="2666189940580882376"><ph name="EXISTING_USER"/> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE"/> கணக்கில் இருந்து உங்கள் வாசிப்புப் பட்டியலையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="4451837224464070850">பிற FlyWeb சுயவிவரங்கள்</translation>
<translation id="4351369660845291597">நீட்டிப்புகள் என்பவை Braveமைப் பிரத்தியேகமாக்க உதவும் செருகு நிரல்கள் ஆகும். ஒழுங்கமைப்பதில் இருந்து அன்றாடப் பணிகளை எளிதாக்குவது வரை, நீட்டிப்புகள் Braveமை உங்களுக்கேற்றதாக மாற்ற உதவுகின்றன.</translation>
<translation id="7859502023458300952">சிதைவு அறிக்கைகளையும் <ph name="UMA_LINK"/> உம் FlyWeb க்கு அனுப்புவதன் மூலம் FlyWeb ஐ மேலும் சிறப்பானதாக்க உதவவும்</translation>
<translation id="1125501479713660011">எங்கிருந்தும் Braveளின் பாதுகாப்பைப் பெற FlyWeb ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{1 USB சாதனம் ஒன்று அல்லது அதற்கு மேற்பட்ட FlyWeb நீட்டிப்புகளால் அணுகப்பட்டது}=1{1 USB சாதனத்தை ஒன்று அல்லது அதற்கு மேற்பட்ட FlyWeb நீட்டிப்புகள் அணுகுகின்றன}other{# USB சாதனங்களை ஒன்று அல்லது அதற்கு மேற்பட்ட FlyWeb நீட்டிப்புகள் அணுகுகின்றன}}</translation>
<translation id="6017373390117959211"><ph name="DEVICE"/> சாதனத்தில் இருந்து வாசிப்புப் பட்டியலையும் மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="7898392424469957829">FlyWeb பதிவுகள்</translation>
<translation id="1407857531570256859">காப்பகத்தைச் சுருக்குவதில் நிறுவி தோல்வியடைந்தது. Braveமை மீண்டும் பதிவிறக்குக.</translation>
<translation id="310459126943037700">பணிகளை நிறுத்த முடியவில்லை.</translation>
<translation id="3104828284009500087">இந்தப் பக்கத்தில் எதையும் தேடுங்கள்</translation>
<translation id="4706932464498663870">கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம். Braveமை இயல்பு பிரவுசராக மாற்றுவதன் மூலம் உங்களுக்குத் தெரிந்த மற்றும் பிடித்த அம்சங்களை எளிதாக அணுகலாம்.</translation>
<translation id="1309738977648134943">FlyWeb உங்கள் மைக்ரோஃபோனைப் பயன்படுத்துகிறது.</translation>
<translation id="3130333203120345554">புதிய தேடல்</translation>
<translation id="3137969841538672700">தேட இழுக்கவும்</translation>
<translation id="2251813826843049011">இந்தப் பக்கம் கூடுதல் வளங்களைப் பயன்படுத்துகிறது. செயல்திறனை மேம்படுத்த, அதை முடக்குவதற்கு Braveமை அனுமதியுங்கள்.</translation>
<translation id="2664701271733223256">ஸ்கிரீனைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்</translation>
<translation id="6274649779206195384">FlyWeb ஐ மீண்டும் தொடங்கு</translation>
<translation id="3161522574479303604">எல்லா மொழிகளும்</translation>
<translation id="6773570808762718524">புதிய FlyWeb சுயவிவரத்தைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="8965010907836433875">பக்கங்களை மாற்றாமலே AI மோடில் தொடர்ந்து உரையாடலாம். தொடங்க, Braveமில் உள்நுழையுங்கள். அத்துடன், கடவுச்சொற்கள் மற்றும் பலவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="5958835776851191812">உங்கள் FlyWeb கணக்கை Braveமில் இருந்து அகற்ற, அமைப்புகள் பக்கத்தில் Braveமில் இருந்து வெளியேறவும்</translation>
<translation id="4217346567895356023">சேமித்துள்ள தகவல்களை வைத்து படிவங்களைத் தானாகவே நிரப்ப விரும்புகிறீர்களா என்று FlyWeb பின்னர் கேட்கலாம்</translation>
<translation id="5449297306961970452">தன்னுடைய தரவுக் கோப்பகத்தில் FlyWeb படிக்கவும் எழுதவும் செய்யாது:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">iOSஸிற்கான Braveமில் உங்களுக்குப் பிடித்த FlyWeb AI கருவிகளை எங்கிருந்தும் பயன்படுத்தலாம்.</translation>
<translation id="8090118570458552025"><ph name="DEVICE"/> சாதனத்தில் உள்ள உங்கள் நீட்டிப்புகளையும் மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3286538390144397061">இப்போது மறுதொடக்கம் செய்க</translation>
<translation id="3900612994249740104">FlyWeb API விசைகள் காணப்படவில்லை. FlyWeb இன் சில செயல்பாடுகள் முடக்கப்படும்.</translation>
<translation id="6824575001009586492">FlyWeb ஐ மூடியபிறகு, பின்புலப் பயன்பாடுகளைத் தொடர்ந்து இயக்கு</translation>
<translation id="2595215790271940091">பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தி ஒரு தளத்தை ஏற்றும் முன்னர் FlyWeb உங்களை எச்சரிக்கும்</translation>
<translation id="3701353923785984059">ஆனால், FlyWeb சாளரங்கள் அனைத்தையும் மூடும்போது Braveமில் உள்நுழைந்திருக்கும் உங்களின் FlyWeb கணக்கைத் தவிர பெரும்பாலான தளங்களில் இருந்து வெளியேற்றப்படுவீர்கள். தளங்கள் உங்களை நினைவில் வைத்துக்கொள்ள அனுமதிக்க, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">தேடல் பகுதியின் மேல் வலது மூலை: வலது <ph name="RIGHT"/>%, மேல் <ph name="TOP"/>%</translation>
<translation id="8629055140319079166">உங்கள் கணக்கில் உள்ள FlyWeb தரவு</translation>
<translation id="1943161457314845496">மொபைலில் FlyWeb மூலம் உங்கள் கடவுச்சொற்களைப் பயன்படுத்துங்கள்</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">ஏற்கெனவே உள்ள FlyWeb சுயவிவரத்திற்கு மாறவா?</translation>
<translation id="3412460710772753638">இந்தச் சாதனத்தில் உள்ள Password Managerரில்</translation>
<translation id="1568435374218487057"><ph name="DEVICE"/> சாதனத்தில் உள்ள புக்மார்க்குகளையும் மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3438772217992559640">படத் தேடல் மூலம் இந்தப் பக்கத்தைத் தேடுங்கள்</translation>
<translation id="6301354573631022693">உங்கள் மொபைலில் FlyWeb மூலம் மேம்பட்ட பாதுகாப்பான பிரவுசிங்கைப் பெறுங்கள்</translation>
<translation id="7625477329092296018">உங்களுக்கான FlyWeb தயாராகிறது...</translation>
<translation id="956833467923764542">வெளியேறினால், இந்தச் சாதனத்திலிருந்து <ph name="ITEMS_COUNT"/> உருப்படிகள் நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, FlyWeb இல் <ph name="USER_EMAIL"/> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> விசைகளை அழுத்தி FlyWeb சுயவிவரங்களுக்கு இடையே மாறலாம்</translation>
<translation id="6724485219247982027">அனைத்து FlyWeb சாளரங்களையும் மூடி, பின்னர் முயலவும்.</translation>
<translation id="5048962017649434283">சாளரத்தைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள்.  உங்கள் உலாவலைத் தனிப்பட்டதாக வைத்திருக்க, உங்கள் சுயவிவரத்தில் <ph name="USER_EMAIL_ADDRESS"/> என்ற மின்னஞ்சல் முகவரி மூலம் Braveமில் உள்நுழையவும்.</translation>
<translation id="408747932595284596">மொபைல் சாதனங்களில் FlyWeb பிரவுசரைப் பதிவிறக்குவதற்கான QR குறியீடு</translation>
<translation id="1413410454753055427">நினைவில்கொள்ளுங்கள்: Braveளின் சிறந்த பாதுகாப்பு அம்சங்கள் உங்கள் பாக்கெட்டில்</translation>
<translation id="7831730508158736496">ஸ்கிரீனைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்.</translation>
<translation id="9006158231572141726">FlyWeb அடையாளம் காணாத தளங்களுக்கு மேம்பட்ட பாதுகாப்பு அம்சம் JavaScript மேம்பாடுகளை முடக்கும்</translation>
<translation id="3597003331831379823">கூடுதல் அணுகல்களுடன் அமைவை இயக்க முடியவில்லை. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">Braveமில் உள்நுழையுங்கள்</translation>
<translation id="6970052268542136081">இவருடைய உலாவிய தரவு இந்தச் சாதனத்திலிருந்து நீக்கப்படும். தரவை மீட்டெடுக்க, Braveமில் <ph name="USER_EMAIL"/> ஆக உள்நுழையவும்.</translation>
<translation id="3667616615096815454">நிறுவ முடியவில்லை, சேவையகத்திற்கு ஆப்ஸ் பற்றி தெரியவில்லை.</translation>
<translation id="2438845157914027912">எனது FlyWeb கணக்கில் உள்ள FlyWeb தரவு எல்லாவற்றையும் என்க்ரிப்ஷன் செய்ய <ph name="BEGIN_LINK"/>எனது கடவுச்சொற்றொடரைப்<ph name="END_LINK"/> பயன்படுத்து. Google Payயில் உள்ள பேமெண்ட் முறைகளும் முகவரிகளும் என்க்ரிப்ட் செய்யப்படாது. Braveமில் உள்ள பிரவுசிங் பதிவுகள் ஒத்திசைக்கப்படாது.</translation>
<translation id="6611602069520888180">புதிய FlyWeb &amp;தாவலில் இணைப்பைத் திற</translation>
<translation id="2591356225047803326">பிரத்தியேகமாக்குதல் மற்றும் பிற நோக்கங்களுக்காக FlyWeb உடன் பிற FlyWeb சேவைகளை இணைக்கலாம்</translation>
<translation id="3729187154190517324">"பக்கம் மற்றும் பலவற்றைச் சேர்" பட்டனைப் பயன்படுத்தி ஒன்றுக்கும் மேற்பட்ட பக்கங்கள், ஃபைல்கள், கருவிகள் ஆகியவற்றைச் சேர்ப்பதன் மூலம் உங்கள் தேடலை மேம்படுத்தலாம்.</translation>
<translation id="1771882170639856394">FlyWeb சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="3782148374606932577">சில பதிவிறக்கங்களை FlyWeb ஏன் தடுக்கிறது என்பதைத் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="4640643918757362950">நீங்கள் ஏதேனும் நடவடிக்கை எடுக்க வேண்டியிருந்தால் அதுகுறித்து FlyWeb உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="2179738813053854729">நீங்கள் பார்வையிடக்கூடிய பக்கங்களை FlyWeb முன்கூட்டியே ஏற்றிவிடுவதால் அந்தப் பக்கங்கள் மிக விரைவாக ஏற்றப்படும்</translation>
<translation id="3810973564298564668">நிர்வகி</translation>
<translation id="5026502787439628947">சேமித்த கடவுச்சொற்களைப் பயன்படுத்த QR குறியீட்டை ஸ்கேன் செய்து, iOSஸிற்கான Braveமைப் பதிவிறக்கி உங்கள் FlyWeb கணக்கில் உள்நுழையவும்</translation>
<translation id="3846683726093018685">**சுருக்கு:** ஸ்கிரீன்ஷாட்டில் உள்ள உள்ளடக்கத்தின் முதன்மைப் பொருளையும் நோக்கத்தையும் 30 வார்த்தைகளுக்கு மிகாமல் ஒரே வாக்கியத்தில் விவரி.

          **கேள்விகளைப் பரிந்துரை:** ஸ்கிரீன்ஷாட்டை நன்றாகப் புரிந்துகொள்ள பயனர் கேட்கக்கூடிய, சிந்தனையைத் தூண்டும் 3 - 5 கேள்விகளைப் பொட்டுக்குறியிட்ட பட்டியலாக உருவாக்கு. இவற்றில் குறைந்தது ஒரு கேள்வி, காட்டப்படும் பொருள், அதன் வடிவமைப்பு அல்லது அது காட்டப்படும் இடத்தைப் பற்றி இருக்க வேண்டும்.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">புக்மார்க்குகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3885770153807205175">மொழி தேர்ந்தெடுப்பான்</translation>
<translation id="5175060854726708547">Braveமைத் தேவைக்கேற்ப மாற்றி கட்டுப்படுத்தும். சிலவற்றை நீங்கள் கவனிக்க வேண்டும் - விவரங்களுக்கு, கிளிக் செய்யவும்.</translation>
<translation id="606156353708638647">FlyWeb ஐத் திறந்து, உலாவலைத் தொடங்க உங்கள் பெயரைக் கிளிக் செய்யவும்.</translation>
<translation id="3892148308691398805">உரையை நகலெடு</translation>
<translation id="5145107420478372433">இந்த FlyWeb சுயவிவரத்தில் ஏற்கெனவே <ph name="EXISTING_USER"/> உள்நுழைந்துள்ளார். நீங்கள் உலாவுவதைத் தனிப்பட்டதாக வைத்திருக்க உங்களுக்கு ஒரு புதிய சுயவிவரத்தை FlyWeb உருவாக்க முடியும்.</translation>
<translation id="3941890832296813527">நிறுவல் பிழை: நிறுவியின் ஃபைல் பெயர் தவறானது அல்லது ஆதரிக்கப்படவில்லை.</translation>
<translation id="8536259619256229278">FlyWeb கடவுச்சொற்களை நகலெடுக்க முயல்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="7965008434896274911">சேமித்த தகவல்களையும் மேலும் பலவற்றையும் உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="4540773594514226705">உங்கள் FlyWeb கணக்கில் சேமித்துள்ள கடவுச்சொற்கள், பேமெண்ட் முறைகள், முகவரிகள் ஆகியவை இந்தச் சாதனத்தில் இருந்து அகற்றப்படும். அவற்றை மீண்டும் Braveமில் பயன்படுத்த, மீண்டும் உள்நுழையவும்.</translation>
<translation id="395904275706073188">பாதுகாக்கப்பட்ட பக்கங்களை ரீட் செய்ய முடியாது. வேறு பக்கத்தை முயலவும்.</translation>
<translation id="3849784651193576458">FlyWeb எப்படி உங்களைப் பாதுகாப்பாக வைக்கிறது என்பது பற்றித் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="3967822245660637423">பதிவிறக்கம் முடிந்தது</translation>
<translation id="562495843857641474">முகவரிப் பட்டி அல்லது தேடல் பெட்டியில் நீங்கள் டைப் செய்யும்போது, பரிந்துரைகளைப் பெறுவதற்காக அவற்றை FlyWeb உங்கள் நிறுவனத்தின் தேடல், AI அல்லது ஏஜெண்ட் கருவிகளுக்கு அனுப்பும்.</translation>
<translation id="5667414856761616811">&amp;FlyWeb for Testing - ஓர் அறிமுகம்</translation>
<translation id="1152920704813762236">ChromeOS - ஓர் அறிமுகம்</translation>
<translation id="4920206821838432969">நீங்கள் ஒரு தளத்தைப் பார்வையிடும்போது உங்கள் IP முகவரியை மறைக்கும் பிரைவசி சர்வர் வழியாக URLலின் கடினமான பகுதியை <ph name="BEGIN_LINK"/>FlyWeb பாதுகாப்பான பிரவுசிங்கிற்கு<ph name="END_LINK"/> FlyWeb அனுப்பும். தளத்தில் சந்தேகத்திற்குரிய வகையில் ஏதேனும் நிகழ்ந்தால் முழு URLகளும் பக்க உள்ளடக்கத்தின் சிறிய பகுதிகளும் அனுப்பப்படும்.</translation>
<translation id="4016217212818346953">Password Manager மூலம் பாதுகாப்பாக இருங்கள்</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_LINUX_OSS"/>Linux டெவெலப்மெண்ட் சூழல்<ph name="END_LINK_LINUX_OSS"/> போலவே, கூடுதல் <ph name="BEGIN_LINK_CROS_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_CROS_OSS"/> மூலம் ChromeOS உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="4022972681110646219">திரையை மொழிபெயர்</translation>
<translation id="4023601594785368013">அசல் மொழி: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">எந்த ஆப்ஸில் இருந்தும் Braveமில் இணைப்புகளைத் திறக்கலாம். அத்துடன், எளிதாக அணுகும் வகையில் செயல் பட்டியில் பிரவுசரைப் பின் செய்யலாம்.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>தற்போதைய அமைப்புகளைப்<ph name="END_LINK"/> பற்றிய அறிக்கையை அனுப்பி, Braveஐ இன்னும் சிறந்ததாக்க உதவவும்</translation>
<translation id="4050175100176540509">முக்கியப் பாதுகாப்பு மேம்பாடுகளும், புதிய அம்சங்களும் சமீபத்திய பதிப்பில் கிடைக்கின்றன.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{FlyWeb ஒரு நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும். உலாவிய தரவு நீக்கப்படும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.}other{FlyWeb # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும். உலாவிய தரவு நீக்கப்படும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.}}</translation>
<translation id="4105099155797156500">FlyWeb அறிமுகம் என்ற பக்கத்திற்குச் செல்லும்</translation>
<translation id="7753744564324413106">உங்கள் பிரவுசருக்குப் புதிய தோற்றத்தைக் கொடுக்க Braveமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="3202882878525816493">Braveமைப் பிரத்தியேகமாக்கு</translation>
<translation id="4148957013307229264">நிறுவுகிறது...</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - நெட்வொர்க் உள்நுழைவு - FlyWeb</translation>
<translation id="6368928751841546993"><ph name="EXISTING_USER"/> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். வாசிப்புப் பட்டியலையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="4007949387571083162">Braveக்கான சிறந்த ஆப்ஸ், கேம்கள், நீட்டிப்புகள் மற்றும் தீம்களைக் கண்டறியவும்.</translation>
<translation id="4753212377237684548">உங்களின் எல்லாக் கம்ப்யூட்டர்களிலும் இந்த நீட்டிப்பையும், மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="4391959806766569994">உங்கள் பெற்றோர் தேர்வுசெய்துள்ள அமைப்புகளுடன் ஆன்லைனில் பாதுகாப்பாக இருக்க, <ph name="USER_EMAIL_ADDRESS"/> என்ற கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ள FlyWeb சுயவிவரத்திற்கு மாறுங்கள்</translation>
<translation id="4222932583846282852">ரத்துசெய்கிறது...</translation>
<translation id="4224210481850767180">நிறுவுதல் ரத்துசெய்யப்பட்டது.</translation>
<translation id="2564888740660198776">உங்கள் FlyWeb தரவை இந்தக் கணக்குடன் இணைக்கவா?</translation>
<translation id="7337819873931851298">இயல்பான பாதுகாப்பு நிலையில் செய்வதைவிட அதிகமான தரவைத் தளங்களில் இருந்து பகுப்பாய்வு செய்வதன் மூலம் ஆபத்தான தளங்கள் (Braveளுக்கு முன்பே தெரிந்திருக்காத தளங்கள் உட்பட) பற்றி உங்களை எச்சரிக்கும். FlyWeb வழங்கும் எச்சரிக்கைகளை நீங்கள் தவிர்க்கலாம்.</translation>
<translation id="8391959103619318249">Braveமில் இருந்து வெளியேறு</translation>
<translation id="8514458758262040082">FlyWeb தொடர்பான உதவி பெறுக</translation>
<translation id="4281844954008187215">சேவை விதிமுறைகள்</translation>
<translation id="3393587701694585022">குறிப்பிடப்படாத பிழைக் காரணமாக நிறுவல் தோல்வியடைந்தது. FlyWeb தற்போது இயக்கத்தில் இருந்தால், அதை மூடி, பின்னர் முயலவும்.</translation>
<translation id="271336227467646058">Braveமில் இருந்து கடவுச்சொற்களைப் பதிவிறக்குதல்</translation>
<translation id="4304713468139749426">கடவுச்சொல் நிர்வாகி</translation>
<translation id="4334241893986177674">இந்த ஸ்கிரீன்ஷாட்டைத் தேடும்</translation>
<translation id="125418423241058931">Windows தொடங்கும்போதே Braveமைத் தொடங்கு</translation>
<translation id="4400772909124543403">புதுப்பிப்புகள் எதுவுமில்லை</translation>
<translation id="1376968889000878095">FlyWeb இலிருந்து வெளியேறவா?</translation>
<translation id="4413205837991854510">படத் தேடலுக்கான ஷார்ட்கட்டை எப்போதும் காட்டு</translation>
<translation id="6360389033094512399">பின்னணியில் Braveஐ இயங்க அனுமதி</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{இதை அகற்றும்படி FlyWeb பரிந்துரைக்கிறது. <ph name="BEGIN_LINK"/>ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK"/>}other{இவற்றை அகற்றும்படி FlyWeb பரிந்துரைக்கிறது. <ph name="BEGIN_LINK"/>ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">FlyWeb ஐ தனிப்பயனாக்கி கட்டுப்படுத்துக</translation>
<translation id="4427306783828095590">ஃபிஷிங்கையும் மால்வேரையும் தடுக்க மேம்பட்ட பாதுகாப்பு உதவுகிறது</translation>
<translation id="4434353761996769206">நிறுவியில் பிழை: <ph name="INSTALLER_ERROR"/></translation>
<translation id="1198322798411238228">Braveமை <ph name="MANAGER"/> நிர்வகிக்கிறது</translation>
<translation id="6643422079097100220">FlyWeb சுயவிவரத்தைச் சேர்</translation>
<translation id="8791209382165811772">FlyWeb for Testing - ஓர் அறிமுகம்</translation>
<translation id="5651107152880556886">உங்கள் FlyWeb கணக்கில் FlyWeb தரவைப் பயன்படுத்துவதற்கும் சேமிப்பதற்கும், உங்கள் கடவுச்சொற்றொடரை டைப் செய்யவும்.</translation>
<translation id="4493028449971051158">துவக்கப் பிழை: நிர்வாகியாக நிறுவியை இயக்குங்கள்.</translation>
<translation id="4501471624619070934">இந்த நாட்டில் அணுகல் தடைசெய்யப்பட்டுள்ளதால் நிறுவ முடியவில்லை.</translation>
<translation id="3546782282376530369">இந்த நீட்டிப்பு, தனியுரிமை நடைமுறைகளை (தரவை எப்படிச் சேகரித்துப் பயன்படுத்தும் போன்றவை) வெளியிடவில்லை. இதை அகற்றும்படி FlyWeb பரிந்துரைக்கிறது.</translation>
<translation id="834808339160590901">Braveமிற்கு வரவேற்கிறோம்; புதிய உலாவிச் சாளரம் திறக்கப்பட்டது</translation>
<translation id="5094033276783634414">உங்களைச் சுற்றி இருப்பவற்றை மேப் செய்வதற்கும் உங்கள் கைகளை டிராக் செய்வதற்கும் Braveமிற்கு அனுமதி தேவை</translation>
<translation id="3363095592946520579">நீங்கள் மற்றொரு FlyWeb சுயவிவரத்தில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள்</translation>
<translation id="8767255662414713095">விரைவாக பிரவுஸ் செய்வதற்கும் தேடுவதற்கும் உதவும் வகையில் பக்கங்களை முன்கூட்டியே FlyWeb ஏற்றுகிறது. <ph name="BEGIN_LINK"/>பக்கங்களை முன்கூட்டியே ஏற்றுதல் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">தீங்கு விளைவிக்கும் என்று நீங்கள் நினைக்கும் தளத்தைப் புகாரளிப்பதன் மூலம் அனைவருக்கும் ஆன்லைன் பாதுகாப்பை மேம்படுத்தலாம்.</translation>
<translation id="5891777644455025808">நீங்கள் பாதுகாப்பு உலாவல் அமைப்பை முடக்கியிருப்பதன் காரணமாக ஃபைலைச் சரிபார்க்க முடியவில்லை என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="8775108347138515815">உங்கள் மொபைலில் FlyWeb மூலம் Google Lens பயன்படுத்திப் பாருங்கள்</translation>
<translation id="4594305310729380060">இந்தச் சாதனத்தில் உள்ள Password Managerரில்</translation>
<translation id="3349475100979552835">FlyWeb ஆப்ஸ்</translation>
<translation id="4598116752460667024">பட்டியலில் உள்ள எந்தச் செயல்பாட்டையும் தேடும்.</translation>
<translation id="4970880042055371251">ChromeOS பதிப்பு</translation>
<translation id="1936188352112244665">கிட்டத்தட்ட புதுப்பிக்கப்பட்டது! புதுப்பிப்பதை முடிக்க, Braveஐ மீண்டும் தொடங்கவும்.</translation>
<translation id="7657326395720709145">Braveமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை FlyWeb தடுக்கும் திறனைச் சற்று குறைக்கும்</translation>
<translation id="7966026667528388481">FlyWeb மூலம் தேடலைத் திற</translation>
<translation id="7949810958067850297">FlyWeb சுயவிவரம்</translation>
<translation id="2962574118577609024">FlyWeb உபயோக அறிக்கைகளை நீங்கள் பகிர்ந்தாலும் நீங்கள் பார்வையிட்ட URLகள் அவற்றில் இருக்கும்</translation>
<translation id="4673710618874938871">மெம்பர்ஷிப் உள்ள <ph name="USER_NAME"/> என்ற கணக்கில் உள்நுழைந்துள்ளீர்கள். கணக்கு மெனுவைத் திறக்கும்.</translation>
<translation id="9219132550163437762">இந்தக் கணக்கு மற்றொரு கம்ப்யூட்டரில் (<ph name="HOST_NAME"/>) மற்றொரு FlyWeb FlyWeb செயல்முறையால் (<ph name="PROCESS_ID"/>) பயன்படுத்தப்படுவதாகத் தோன்றுகிறது. FlyWeb இதைப் பூட்டியுள்ளதால், இது சிதைவடையாது. இதை மற்ற செயல்முறைகள் பயன்படுத்தவில்லை என்பதில் நீங்கள் உறுதியாக இருந்தால், நீங்கள் இதை அன்லாக் செய்து Braveமை மீண்டும் துவங்கலாம்.</translation>
<translation id="4680828127924988555">நிறுவலை ரத்து செய்</translation>
<translation id="6156840135417578237">உங்களின் சில FlyWeb தரவுகள் உங்கள் FlyWeb கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறுவதற்கு முன் சில நிமிடங்கள் காத்திருக்கவும். இப்போதே வெளியேறினால் இந்தத் தரவு நீக்கப்படும்.</translation>
<translation id="1474749355173247622">உள்நுழைந்திருக்கும்போது உங்கள் FlyWeb கணக்கில் உள்ள கடவுச்சொற்களையும், மேலும் பலவற்றையும் நீங்கள் Braveமில் பயன்படுத்தலாம். FlyWeb சேவைகளுக்கான அமைப்புகளை <ph name="SHORTCUT"/> மூலம் மாற்றலாம்.</translation>
<translation id="5227023869666757348">இதற்கு முன்னர் ஒருவர் இந்தக் கம்ப்யூட்டரிலுள்ள Braveமில் <ph name="ACCOUNT_EMAIL_LAST"/> எனும் முகவரியைப் பயன்படுத்தி உள்நுழைந்திருந்தார். உங்கள் தகவலைத் தனிப்பட்டதாக வைத்திருக்க, புதிய FlyWeb பயனரை உருவாக்கவும்.</translation>
<translation id="4724676981607797757">ஆதரிக்கப்படாத நெறிமுறைப் பிழை காரணமாக நிறுவ முடியவில்லை.</translation>
<translation id="1671154647029930623">FlyWeb இலிருந்து வெளியேறவா?</translation>
<translation id="4143239505982500022">Braveமுக்கான சிறப்புப் பாதுகாப்புப் புதுப்பிப்பு சற்றுமுன் இயக்கப்பட்டது. இப்போது Braveமை மீண்டும் தொடங்கவும், உங்கள் தாவல்களை மீண்டும் காண்பிப்போம்.</translation>
<translation id="82292346243148940">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> மேலும் <ph name="COUNT"/> அனுமதிகளை FlyWeb அகற்றிவிட்டது.</translation>
<translation id="1802926274661855018">Braveமில் Gemini திறந்திருந்தால், புதிய பக்கங்களை உருவாக்கும்போது பக்கவாட்டு பேனல் திறந்தே இருக்கும்</translation>
<translation id="3469649164996417993">இது FlyWeb தேடலில் பயன்படுத்தப்படும் அதே பிழைதிருத்தியைப் பயன்படுத்துகிறது. உலாவியில் நீங்கள் உள்ளிடும் உரை Braveளுக்கு அனுப்பப்படும். இதை அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றலாம்.</translation>
<translation id="7460496601839821581">கணக்கு இல்லாமல் Braveமைப் பயன்படுத்து</translation>
<translation id="2991144524835127379">mDNS ட்ராஃபிக்கை அனுமதிப்பதற்கான, FlyWeb க்கான உள்வரும் விதி.</translation>
<translation id="6208903184719035736">&amp;Braveமைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="4918086044614829423">ஏற்கிறேன்</translation>
<translation id="4918844574251943176">படம் நகலெடுக்கப்பட்டது</translation>
<translation id="5477235053075501816">வாசிப்புப் பட்டியலையும் மேலும் பலவற்றையும் உங்கள் எல்லாச் சாதனங்களிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="7174589544844983914">FlyWeb பின்புல பயன்முறையில் இயங்குகிறது.</translation>
<translation id="9212977598552218412">FlyWeb உள்நுழைவு உரையாடலை மூட இதைக் கிளிக் செய்யவும்</translation>
<translation id="8366169706197332122">FlyWeb சுயவிவரங்களைப் பயன்படுத்தி உங்கள் FlyWeb தொடர்பான எல்லாவற்றையும் தனித்தனியாக வைத்துக்கொள்ளலாம். நண்பர்களுக்காகவும் குடும்பத்திற்காகவும் சுயவிவரங்களை உருவாக்கலாம் அல்லது பணி, பொழுதுபோக்கு போன்றவற்றுக்கு அவற்றைத் தனித்தனியாக வைத்துக்கொள்ளலாம்.</translation>
<translation id="7792628702371319769">எதையும் விட்டுசெல்லாமல் கெஸ்ட் பயனர்கள் FlyWeb ஐப் பயன்படுத்தலாம்.</translation>
<translation id="7370618680298767482">Braveமில் உங்கள் கணக்கு</translation>
<translation id="2760069255902967585">உங்களை FlyWeb இல் சேர்க்கவும்</translation>
<translation id="504699503110800016">விரிவாக்க மெனுவைத் திறக்கவும்</translation>
<translation id="6686344057006524628"><ph name="DEVICE_TYPE"/> இல் FlyWeb மூலம் உங்களுக்குப் பிடித்த FlyWeb சேவைகள் அனைத்தையும் அணுகலாம்</translation>
<translation id="2515109138500267971">உங்கள் கைகளை டிராக் செய்ய Braveமிற்கு அனுமதி தேவை</translation>
<translation id="3910606758302645363">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> ஆகிய அனுமதிகளை FlyWeb அகற்றிவிட்டது.</translation>
<translation id="5174969993834422967">பொதுவாக அறிவிப்புகளைத் தடுத்து விடுவீர்கள். இந்தத் தளம் உங்களுக்கு அறிவிப்புகளை வழங்க அனுமதிக்க, இடப் பட்டியின் வலது மூலையில் உள்ள அறிவிப்பு ஐகானைக் கிளிக் செய்யவும்.</translation>
<translation id="5174983315706567306">டிஸ்க்கில் போதுமான சேமிப்பிடம் இல்லை.</translation>
<translation id="4326845160190496236">FlyWeb கணக்கிற்கு மறு அடையாளச் சரிபார்ப்பு தேவைப்படுகிறது</translation>
<translation id="3540715470656277664">iOSஸிற்கான Braveமில் விட்ட இடத்திலிருந்து தொடரலாம்.</translation>
<translation id="291933003154435191">FlyWeb இலிருந்து வெளியேறு</translation>
<translation id="5234764350956374838">நிராகரி</translation>
<translation id="9098587825736815971">எங்கிருந்தும் கடவுச்சொற்களைச் சேமிக்க FlyWeb ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="8295539942024823191">உங்கள் மாற்றங்களைச் செயல்படுத்த, Braveமை மீண்டும் தொடங்கவும்</translation>
<translation id="5286907366254680517">கண்டறியப்பட்டது</translation>
<translation id="626007313130236514">FlyWeb ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="5361365805808004630">Braveமில் Search</translation>
<translation id="8888283148421206435">FlyWeb Updater Internal Service</translation>
<translation id="3025882852178035952">Braveமில் பிற Gemini அம்சங்களுடன் அவற்றைப் பயன்படுத்தலாம்</translation>
<translation id="5346389065299425353">பல பக்கங்கள், ஃபைல்கள், கருவிகள் ஆகியவற்றைச் சேர்ப்பதன் மூலம் உங்கள் தேடலை மேம்படுத்தலாம்</translation>
<translation id="8330248712705246714">Braveமில் Gemini மூலம் இந்த ஆவணத்தின் விரைவான தகவல் சுருக்கத்தைப் பெறலாம், கேள்விகளைக் கேட்கலாம்.</translation>
<translation id="6178233095056047786">நீங்கள் நடவடிக்கை எடுக்க சில பாதுகாப்பு தொடர்பான பரிந்துரைகளை FlyWeb கண்டறிந்துள்ளது</translation>
<translation id="8980390875915032396">பிற FlyWeb சுயவிவரங்கள்</translation>
<translation id="2441009746272048284">உங்கள் கணக்கின் உள்நுழைவு விவரங்கள் காலாவதியாகிவிட்டதால் உங்கள் FlyWeb கணக்கில் FlyWeb தரவை ChromeOS சேமிக்க முடியவில்லை</translation>
<translation id="8449603408481238073">நீங்கள் நிர்வகிக்கப்படும் கணக்கு மூலம் உள்நுழைகிறீர்கள், மேலும் அதன் நிர்வாகிக்கு உங்கள் FlyWeb சுயவிவரத்தின் கட்டுப்பாட்டை வழங்குகிறீர்கள். உங்கள் ஆப்ஸ், புக்மார்க்குகள், வரலாறு, கடவுச்சொற்கள் போன்ற உங்கள் FlyWeb தரவு மற்றும் பிற அமைப்புகள் நிரந்தரமாக <ph name="USER_NAME"/> உடன் இணைக்கப்படும். இந்தத் தரவை FlyWeb கணக்குகளின் டாஷ்போர்டு வழியாக நீக்க முடியும், ஆனால் இந்தத் தரவை வேறொரு கணக்குடன் தொடர்புபடுத்த முடியாது. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">கூடுதல் குறியீடு: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">பிரத்தியேகமாக்குதலைப் பெற, இணையம் மற்றும் ஆப்ஸ் செயல்பாட்டில் Braveமைச் சேர்க்கவும்</translation>
<translation id="1456957080321742545">FlyWeb மூலம் தேடலைத் திற</translation>
<translation id="1026219128963768190">சில ஃபைல்களை FlyWeb ஏன் தடுக்கிறது என்பதைத் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="1284798564810038820">Braveஐப் புதுப்பிக்கிறது (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="4384293746734222420"><ph name="EXISTING_USER"/> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். உங்கள் நீட்டிப்புகளையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="3872448231555118416">FlyWeb உள்நுழைவை அனுமதித்தல்</translation>
<translation id="1827750898515917134">FlyWeb இலிருந்து அகற்று</translation>
<translation id="7460715011003906078">செயல்திறனைக் குறைக்கும், ஆனால் தாக்குதல்களை FlyWeb தடுக்கும் திறனை அதிகரிக்கும்</translation>
<translation id="5020755920249060562">உங்கள் இயல்புநிலை உலாவியாக FlyWeb ஐ அமை</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb பீட்டா</translation>
<translation id="1842654828911709974">{NUM_TABS,plural, =1{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கத்தை இடைநிறுத்தும்படி FlyWeb பரிந்துரைக்கிறது}other{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கங்களை இடைநிறுத்தும்படி FlyWeb பரிந்துரைக்கிறது}}</translation>
<translation id="5385202369020319636">இந்த Linux விநியோகத்தில் FlyWeb தற்போது ஆதரிக்கப்படுவதில்லை என்பதால் அது சரியாகச் செயல்படாமல் போகலாம்</translation>
<translation id="362367838300880777">உங்களின் தனிப்பட்ட மற்றும் சமூக வலைத்தளக் கணக்குகளில் இந்த ஃபைல் பாதிப்பை ஏற்படுத்தலாம் என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="2183749398075655200">சமீபத்திய முறைமை புதுப்பிப்புகளை FlyWeb நிறுவும் வரை காத்திருக்கவும்.</translation>
<translation id="8996657165865563765">FlyWeb கடவுச்சொற்களைத் திருத்த முயல்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="832204641669191126">FlyWeb மூலம் Google Drive, YouTube போன்ற உங்களுக்குப் பிடித்த ஆப்ஸை எங்கிருந்தும் தடையின்றிப் பயன்படுத்தலாம்.</translation>
<translation id="5524890928877629608">தேடல் பகுதியின் மேல் இடது மூலை: இடது <ph name="LEFT"/>%, மேல் <ph name="TOP"/>%</translation>
<translation id="5738298079259740925">PDFகளை Braveமில் திற</translation>
<translation id="5536164441519929134">இந்தப்<ph name="LINE_BREAK"/>பக்கம் பற்றிக் கேட்கலாம்</translation>
<translation id="6197315294677032380">பாதுகாப்பிற்காக, நீங்கள் ஒரு தளத்தை முதன்முறையாகப் பார்வையிடும்போது JavaScript மேம்பாட்டை FlyWeb ஆஃப் செய்யும்.

எதிர்பார்த்தபடி இந்தப் பக்கம் செயல்படவில்லை என்றால், மேம்பாட்டை ஆன் செய்துப் பார்க்கவும்.</translation>
<translation id="2009834183541338014">Mac மெனு பட்டியில் Braveமில் Geminiயைக் காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="1307223624786767430"><ph name="EXISTING_USER"/> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE"/> இருந்து நீங்கள் சேமித்த தகவல்களையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="5579324208890605088">துவக்கப் பிழை: நிர்வாகியாக இல்லாமல் வழக்கமான பயனராக நிறுவியை இயக்குங்கள்.</translation>
<translation id="4770353132265458564">Braveமை இயல்பு பிரவுசராகப் பயன்படுத்துங்கள், அதைப் பின் செய்யுங்கள்</translation>
<translation id="5596627076506792578">கூடுதல் விருப்பங்கள்</translation>
<translation id="5605834417512968703">படத் தேடல் மூலம் தேட எதையேனும் தேர்ந்தெடுக்கலாம் அல்லது படத் தேடலில் இருந்து வெளியேற escape பட்டனை அழுத்தலாம்</translation>
<translation id="5618818588972826921">படத் தேடல் அம்சத்தின் மூலம் தேட வார்த்தைகளையோ படத்தையோ தேர்ந்தெடுக்கவும் அல்லது படத் தேடல் அம்சத்தில் இருந்து வெளியேற Escape அழுத்தவும்</translation>
<translation id="6096945112863785306">{0,plural, =0{Braveமிற்கான புதுப்பிப்பு உள்ளது}=1{Braveமிற்கான புதுப்பிப்பு உள்ளது}other{Braveமிற்கான புதுப்பிப்பு வந்து # நாட்களாகிறது}}</translation>
<translation id="7698117871740446964">FlyWeb உலாவியை மூடும்போது எனது சாதனத்தில் உள்ள தளத் தரவை எப்போதும் நீக்கு</translation>
<translation id="5666891644992637849">Braveமை இப்போது மீண்டும் தொடங்கவும்</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">Braveமை இந்த மொழியில் காட்டு</translation>
<translation id="569897634095159764">இணையத்துடன் இணைக்க முடியவில்லை. ப்ராக்ஸி சர்வருக்கு அங்கீகரிப்பு தேவை.</translation>
<translation id="5406894461513282158">செயலில் இல்லாத பக்கங்களில் உள்ள நினைவகத்தை FlyWeb காலியாக்குகிறது. இதன்மூலம் செயலில் உள்ள பக்கங்களுக்கும் பிற ஆப்ஸுக்கும் கம்ப்யூட்டரின் செயல்திறன் அதிகமாகக் கிடைப்பதுடன் Braveமும் வேகமாக இயங்கும். செயலில் இல்லாத பக்கங்களுக்கு நீங்கள் செல்லும்போது அவை தானாக மீண்டும் செயல்படத் தொடங்கும். <ph name="BEGIN_LINK"/>நினைவகச் சேமிப்பான் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK"/></translation>
<translation id="4909672456103357452">கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ, உங்கள் கணக்கில் உள்ள FlyWeb தரவை <ph name="SETTINGS_LINK"/></translation>
<translation id="4985665094509307744">Braveமைப் பிரத்தியேகமாக்கலாம் கட்டுப்படுத்தலாம். Braveமை இயல்பு உலாவியாக அமைக்கலாம்.</translation>
<translation id="6646499372922411025">Braveமை இயல்பு பிரவுசராக அமைப்பதன் மூலம் கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம்.</translation>
<translation id="5809516625706423866">இணையத்துடன் இணைக்க முடியவில்லை. HTTP 401 அங்கீகரிக்கப்படவில்லை. உங்கள் ப்ராக்ஸி உள்ளமைவைச் சரிபார்க்கவும்.</translation>
<translation id="5890196138054330443">Braveமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை FlyWeb எதிர்க்கும் திறன் சற்று குறைந்து காணப்படும். இந்த அமைப்பு ஆஃப் செய்யப்பட்டுள்ளது.</translation>
<translation id="8651664269417935890">உங்கள் FlyWeb கணக்கில் உள்ள FlyWeb தரவைப் பயன்படுத்தவும் சேமிக்கவும் FlyWeb பிரவுசரைப் புதுப்பிக்கவும்</translation>
<translation id="5824893331272123205">இந்தப் பேனலை ஏற்ற முடியவில்லை, மீண்டும் முயலவும்</translation>
<translation id="8331941171144629807">FlyWeb க்கு வரவேற்கிறோம்</translation>
<translation id="5831968418530309689">Braveமின் மிக உறுதியான பாதுகாப்புகளை வழங்க கூடுதல் அம்சங்களை ஆன் செய்யும்</translation>
<translation id="5871205389137001634">படத் தேடலில் இருந்து வெளியேற கிளிக் செய்யுங்கள்</translation>
<translation id="7581082856615467651">இவற்றில் மால்வேர் இருப்பதை FlyWeb கண்டறிந்துள்ளது:</translation>
<translation id="8117102597407263352">உங்கள் உலாவியில் பாதுகாப்பான அமைப்புகள் அமைக்கப்பட்டுள்ளனவா என்று அவ்வப்போது FlyWeb சரிபார்க்கும். நீங்கள் எதையேனும் சரிபார்க்க வேண்டியிருந்தால் உங்களுக்குத் தெரியப்படுத்துவோம்.</translation>
<translation id="5895138241574237353">மறுதொடக்கம்</translation>
<translation id="7740963625398321937">Braveமில் Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - நெட்வொர்க் உள்நுழைவு</translation>
<translation id="5924017743176219022">இணையத்துடன் இணைக்கிறது...</translation>
<translation id="5941711191222866238">சிறிதாக்கு</translation>
<translation id="6669708050135513710">இந்தப் புக்மார்க்கையும் மேலும் பலவற்றையும் உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3358004031263458708">Braveமை உங்களுக்கானதாக மாற்றுங்கள்</translation>
<translation id="5960071705175224773">அறியப்படாத ஆப்ஸ் உங்கள் அமைப்புகளை மாற்றியுள்ளது</translation>
<translation id="5977420883993828287">பின் செய்யப்பட்டது! கருவிப்பட்டியில் இருந்து சூழல் சார்ந்த பணிகளை மீண்டும் பயன்படுத்தலாம்</translation>
<translation id="348384176991400026">{COUNT,plural, =1{FlyWeb ஒரு நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும்.}other{FlyWeb # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும்.}}</translation>
<translation id="4955869506208896934">ஒத்திசைவைத் தொடங்க, Braveஐப் புதுப்பிக்கவும்</translation>
<translation id="5990360079535151574">கருவிப்பட்டியில் உள்ள "சூழல் சார்ந்த பணிகள்" பட்டனில் இருந்து, பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க சூழல் சார்ந்த பணிகளை மீண்டும் திறக்கலாம்</translation>
<translation id="6003112304606738118">பதிவிறக்குகிறது... <ph name="HOURS"/> மணிநேரம் மீதமுள்ளது</translation>
<translation id="6009821354356307391">ஃபாலோ-அப் கேளுங்கள்</translation>
<translation id="6040143037577758943">மூடு</translation>
<translation id="4530644097272078700">உங்கள் <ph name="DEVICE_TYPE"/> இல் FlyWeb ஆப்ஸைப் பயன்படுத்தும்போது ஆன்லைன் ஷாப்பிங்கில் இருந்து அதிகப் பலன்களைப் பெறுங்கள்</translation>
<translation id="619330138913595431">உங்கள் தரவைப் பாதுகாக்க, நீங்கள் சமீபத்தில் பார்வையிடாத தளங்களில் உள்ள அனுமதிகளை அகற்ற Braveமை அனுமதியுங்கள். இது அறிவிப்புகளை நிறுத்தாது.</translation>
<translation id="8714139918792771260">FlyWeb இல் &amp;திற</translation>
<translation id="6069027071882229820">படமாக நகலெடு</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/> என்ற நீட்டிப்பு FlyWeb இல் சேர்க்கப்பட்டது</translation>
<translation id="5880307616068888895">Braveஐத் தனிப்பயனாக்கி, கட்டுப்படுத்தலாம். புதுப்பிப்பு உள்ளது.</translation>
<translation id="1429530657225981960">இயக்கு • இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Braveமால் சரிபார்க்க முடியவில்லை</translation>
<translation id="8056369489402655495">Braveமில் உங்கள் கணக்கு</translation>
<translation id="1683225514126450592">FlyWeb கருவிப்பட்டியில் அணுகல் கோரிக்கைகளைக் காட்ட நீட்டிப்புகளை அனுமதி</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> ஆபத்தானது என்பதால் FlyWeb அதைத் தடுத்துள்ளது.</translation>
<translation id="1773252983747911987">FlyWeb விரைவில் மூடப்படுவதுடன் தரவும் நீக்கப்படும்</translation>
<translation id="1686760912855738719">இங்கே FlyWeb சுயவிவரங்களுக்கு இடையே மாறலாம்</translation>
<translation id="5461795497268691356">குக்கீகளை அனுமதித்தால் பக்கங்களை முன்கூட்டியே ஏற்றுவதற்கு FlyWeb அவற்றைப் பயன்படுத்தக்கூடும்</translation>
<translation id="6165508094623778733">மேலும் அறிக</translation>
<translation id="1292852397592425449">உங்கள் கணக்கில் உள்ள FlyWeb தரவை அழிக்கலாம்</translation>
<translation id="7031783851441272920">இந்த ஃபைல் ஆபத்தானதாக இருக்கக்கூடும்<ph name="LINE_BREAK"/>நீங்கள் கடவுச்சொல்லை வழங்கினால் FlyWeb உங்களுக்காக இந்தப் பதிவிறக்கத்தைச் சரிபார்க்கும். FlyWeb பாதுகாப்பு உலாவலுக்கு ஃபைல் குறித்த தகவல்கள் அனுப்பப்படும், ஆனால் ஃபைலின் உள்ளடக்கமும் கடவுச்சொல்லும் பகிரப்படாமல் சாதனத்திலேயே இருக்கும்.</translation>
<translation id="6182736845697986886">புதுப்பிப்புச் சேவையகத்தின் அகப் பிழை காரணமாக நிறுவ முடியவில்லை.</translation>
<translation id="4403968929742079769">உங்கள் <ph name="TARGET_DEVICE_NAME"/> சாதனத்தின் மூலம் Braveமில் உள்நுழைந்திருப்பதை உறுதிசெய்துகொண்டு மீண்டும் அனுப்ப முயலவும்.</translation>
<translation id="8345188246355148375">FlyWeb சிறிதாக்கப்பட்டிருந்தாலும் கூட எங்கிருந்தும் தேடலாம், கேள்விகளைக் கேட்கலாம். பின்னணியில் FlyWeb இயங்க அனுமதிக்கும்.</translation>
<translation id="1855179706668101462">இந்தக் கம்ப்யூட்டரில் ஏற்கனவே Braveமின் மிகச் சமீபத்திய பதிப்பு உள்ளது. மென்பொருள் இயங்கவில்லை எனில் Braveமை நிறுவல் நீக்கி, பின்னர் முயலவும்.</translation>
<translation id="651290634887454330">{0,plural, =0{இப்போது FlyWeb மீண்டும் தொடங்கும்}=1{ஒரு வினாடியில் FlyWeb மீண்டும் தொடங்கும்}other{# வினாடிகளில் FlyWeb மீண்டும் தொடங்கும்}}</translation>
<translation id="2586408713760853791">ஃபைல்களைப் பதிவிறக்க, Braveமிற்குச் சேமிப்பக அணுகல் தேவை</translation>
<translation id="1603558835003845196">Braveமில் சேமிக்கப்பட்டுள்ள பாதுகாப்பில்லாத தளங்களின் பட்டியலைப் பயன்படுத்தி URLகளைச் சரிபார்க்கும்</translation>
<translation id="5751080530525677552">FlyWeb ஐ இயல்புநிலை உலாவியாக மாற்று</translation>
<translation id="6248988683584659830">தேடல் அமைப்புகள்</translation>
<translation id="6342238100521499844">உங்கள் மொபைலில் FlyWeb ஆப்ஸ் மூலம் Braveளின் சிறந்த பாதுகாப்பு அம்சங்களை எங்கிருந்தும் பெறுங்கள்</translation>
<translation id="3542157007113577464">FlyWeb இலிருந்து வெளியேறவா?</translation>
<translation id="2166321493116256664">இந்தப் பக்கங்கள் கூடுதல் ரிசோர்ஸ்களைப் பயன்படுத்துகின்றன. செயல்திறனை மேம்படுத்த, அவற்றை முடக்குவதற்கு Braveமை அனுமதியுங்கள்.</translation>
<translation id="3794967601634523398">உங்கள் FlyWeb சுயவிவரத்தைப் பிரத்தியேகமாக்குக</translation>
<translation id="6475001900959697061">உங்கள் FlyWeb சுயவிவரத்திற்குப் பெயரிடுங்கள்</translation>
<translation id="6356094940346377065">நீட்டிப்பைப் பயன்படுத்த Braveமில் நீங்கள் உள்நுழைய வேண்டும் என்று அது விரும்புகிறது</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> ஆபத்தானதாக இருக்கலாம் என்பதால் FlyWeb அதைத் தடுத்துள்ளது.</translation>
<translation id="5523868569707953059">FlyWeb உங்கள் கேமராவைப் பயன்படுத்துகிறது.</translation>
<translation id="8226838065217375546">FlyWeb இல் ஏற்கனவே ஒரு நிறுவி செயல்பாட்டில் உள்ளது. பிறகு முயலவும்.</translation>
<translation id="6063700568539132984">இப்போது உங்கள் FlyWeb கணக்குடனும், பகிரப்பட்ட கம்ப்யூட்டர்களிலும் Braveமைப் பயன்படுத்துவது எளிதானது.</translation>
<translation id="5622088198573179705">Braveமை இயல்பு பிரவுசராக அமைப்பதன் மூலம் உங்களுக்குத் தெரிந்த, பிடித்த மற்றும் நம்பகமான அம்சங்களை எளிதாக அணுகலாம்.</translation>
<translation id="4709797814274745581">FlyWeb ஷார்ட்கட்</translation>
<translation id="6595693843242836271">இந்த ஃபைல் பொதுவாகப் பதிவிறக்கப்படுவதில்லை என்பதுடன் ஆபத்தானதாகவும் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="6890209090736444656">FlyWeb ஐ நிச்சயமாக நிறுவல் நீக்கவா?</translation>
<translation id="6375219077595103062">Password Managerருக்கு ஷார்ட்கட்டைச் சேர்க்கலாம்</translation>
<translation id="6388799252195623474">இதில் எனக்கு உதவு</translation>
<translation id="8407518452288816185">தொடர, <ph name="EMAIL"/> என்ற கணக்கில் Braveமில் உள்நுழையவும். உங்கள் நிறுவனத்தின் கொள்கைகள் இந்த பிரவுசருக்கு அமைக்கப்பட்டிருப்பதை இது உறுதிசெய்யும்.</translation>
<translation id="2104550252781001709">கம்ப்யூட்டர் ஸ்கிரீன் உள்ளே FlyWeb உலாவி லோகோ.</translation>
<translation id="6636986997730784876">FlyWeb ஆனது வலைப்பக்கங்கள் மற்றும் ஆப்ஸில் குறைவான வேகத்துடன் இயங்கும் வலை உலாவியாகும். இது விரைவானது, நிலையானது மற்றும் பயன்படுத்துவதற்கு எளிமையானது. Braveமில் உருவாக்கப்பட்ட மால்வேர் மற்றும் ஃபிஷிங் பாதுகாப்பு மூலம் வலையை மிகவும் பாதுகாப்பாக உலாவலாம்.</translation>
<translation id="4359872290500912570">உங்கள் FlyWeb கணக்கில் உள்ள FlyWeb தரவை எப்போதும் பயன்படுத்தவும் சேமிக்கவும் முடிவதை உறுதிசெய்ய, இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்.</translation>
<translation id="3141715584864891679">FlyWeb வேகமாக இயங்கும், அத்துடன் JavaScriptடைப் பயன்படுத்தும் அம்சங்கள் வடிவமைக்கப்பட்டுள்ளபடி செயல்படும்</translation>
<translation id="6436260184216827876">படத் தேடல் கிடைக்கவில்லை. பிறகு முயலவும்.</translation>
<translation id="2139300032719313227">ChromeOSஸை மீண்டும் தொடங்குங்கள்</translation>
<translation id="7560906925528428585">நீங்கள் பார்வையிடக்கூடிய கூடுதல் பக்கங்களை FlyWeb முன்கூட்டியே ஏற்றிவிடுவதால் அந்தப் பக்கங்கள் மிக விரைவாக ஏற்றப்படும்</translation>
<translation id="5806916401157869650">விலைகளைக் கண்காணிக்கவும் ஏதேனும் தளத்தில் விலை குறைந்தால் அதுகுறித்த விழிப்பூட்டல்களைப் பெறவும் உங்கள் மொபைலில் Braveமைப் பதிவிறக்குங்கள்</translation>
<translation id="2970877059928503461">முடக்கு • இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Braveமால் சரிபார்க்க முடியவில்லை</translation>
<translation id="173462352822069427">FlyWeb சுயவிவரங்களுக்கு வரவேற்கிறோம்</translation>
<translation id="8914008746092110409">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் Braveமைத் திறக்கும்போது, பக்கக் குழுக்களைப் பயன்படுத்தும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="3484308111967198595">Braveமில் இருந்து கணக்கை அகற்று</translation>
<translation id="1474676525193357364">FlyWeb ஐத் தொடங்கும்போது காண்பிக்கப்படும் பக்கத்தையும் இது கட்டுப்படுத்துகிறது.</translation>
<translation id="648319183876919572">ஆபத்தான இணையதளங்கள், பதிவிறக்கங்களில் இருந்து உங்களைப் பாதுகாக்க மேம்பட்ட பாதுகாப்பு உலாவல் அம்சம் பலவற்றைச் செய்கிறது</translation>
<translation id="5777905264835557372">FlyWeb ஐ நிறுவல் நீக்கு</translation>
<translation id="764623543427374554">ஷார்ட்கட்கள் Braveமில் திறக்கும்</translation>
<translation id="8852057261917278552">FlyWeb <ph name="TIMEOUT_DURATION"/> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை மூடிவிடும். உலாவிய தரவு நீக்கப்பட்டது. இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.</translation>
<translation id="8592211619057897362">புக்மார்க்குகள், இதுவரையான செயல்பாடுகள், கடவுச்சொற்கள் போன்ற FlyWeb தகவல்கள் ஒவ்வொரு சுயவிவரத்திற்கும் தனித்தனியாக இருக்கும்</translation>
<translation id="6556755379298048869">கீபோர்டு ஷார்ட்கட் மூலம் தேடலாம்.</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb உங்கள் தரவை எப்படித் தனிப்பட்டதாக வைத்திருக்கிறது<ph name="END_LINK"/> என்பது குறித்து மேலும் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="654107331777480705">இந்த அமைப்பில் செய்யப்படும் மாற்றங்கள் FlyWeb மீண்டும் தொடங்கியதும் செயல்படுத்தப்படும்.</translation>
<translation id="3594828538355548672">FlyWeb முதன்மை மெனுவில் உள்ள நீட்டிப்புகள் என்பதைக் கிளிக் செய்து நீட்டிப்புகளை நிர்வகிக்கலாம்.</translation>
<translation id="7489092380688543560">வேறொரு FlyWeb சுயவிவரத்தில் உள்ள கடவுச்சொற்களைப் பார்க்க அதற்கு மாறலாம்</translation>
<translation id="472958395762114471">சிறந்த AI கருவிகளை எங்கிருந்தும் அணுக FlyWeb ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="8243012192239086369">எழுத்துப் பிழைகளைச் சரிசெய்ய, FlyWeb நீங்கள் உரைப் புலங்களில் உள்ளிடும் உரைகளை Braveளுக்கு அனுப்பும்</translation>
<translation id="3927263773110604886">FlyWeb அறிவிப்பு அமைப்புகளுக்குச் செல்</translation>
<translation id="6600016381025017075">இந்தப் பக்கத்தில் எதையும் தேடலாம்</translation>
<translation id="6888846095017247017">அடுத்த முறை நீங்கள் FlyWeb ஐ மீண்டும் தொடங்கும்போது உங்கள் மாற்றங்கள் செயல்படும்.</translation>
<translation id="4481788155537463533">Windows தொடங்கும்போதே FlyWeb இப்போது தொடங்கப்படுவதால் நீங்கள் உடனடியாக பிரவுசிங் செய்யத் தொடங்கலாம். இதை நீங்கள் அமைப்புகளில் ஆஃப் செய்யலாம்.</translation>
<translation id="1116311888485102603">விட்ட இடத்திலிருந்து தொடரலாம்: கடந்த அமர்வில் இருந்து FlyWeb உங்கள் பக்கங்களை மீட்டெடுத்துள்ளது. இதை இங்கு ஆஃப் செய்யலாம்:</translation>
<translation id="1886169834787876002">உங்களைச் சுற்றியுள்ள இடங்களின் 3D வரைபடத்தை உருவாக்க, Braveமிற்குக் கேமரா அணுகல் தேவை</translation>
<translation id="7570986009744020649">உங்கள் FlyWeb கணக்கில் புக்மார்க்குகளையும் நீங்கள் சேமித்தால், Braveமில் தயாரிப்பு விலைகளைக் கண்காணிக்கலாம், விலை குறையும்போது அதற்கான அறிவிப்புகளைப் பெறலாம்</translation>
<translation id="6676384891291319759">இணையத்தை அணுகுதல்</translation>
<translation id="1363996462118479832">உள்நுழைவில் பிழை ஏற்பட்டதால் உங்கள் தரவை ChromeOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="5743696427773796626">Braveமில் இருந்து இந்த ஆப்ஸின் தரவை அகற்று</translation>
<translation id="4152880912192471857">இந்தத் தளத்தை அணுக, Braveமிற்கு மைக்ரோஃபோன் அணுகல் தேவை</translation>
<translation id="6712881677154121168">பதிவிறக்கப் பிழை: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">உங்கள் சுயவிவரம் FlyWeb இன் புதிய பதிப்பில் உள்ளதால், அதைப் பயன்படுத்த முடியாது.

சில அம்சங்கள் கிடைக்காமல் போகலாம். வேறு சுயவிவர கோப்பகத்தைக் குறிப்பிடுக அல்லது FlyWeb இன் புதிய பதிப்பைப் பயன்படுத்துக.</translation>
<translation id="5528558621229392814">பிரத்தியேகமாக்குதலையும் பிற அம்சங்களையும் பெற, இணையம் மற்றும் ஆப்ஸ் செயல்பாடு மற்றும் இணைக்கப்பட்ட FlyWeb சேவைகளில் Braveமைச் சேர்க்கவும்</translation>
<translation id="7728046102681268859">உங்கள் கம்ப்யூட்டரில் ஏற்கனவே எல்லாப் பயனர்களுக்கும் FlyWeb நிறுவப்பட்டுள்ளது.</translation>
<translation id="2006421382007321898">புக்மார்க்குகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் FlyWeb கணக்கில் இந்த புக்மார்க் சேமிக்கப்படும்.</translation>
<translation id="4328426102261301637">Braveமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை FlyWeb எதிர்க்கும் திறன் சற்று குறைந்து காணப்படும். இந்த அமைப்பு ஆன் செய்யப்பட்டுள்ளது.</translation>
<translation id="207175655966839154">{count,plural, =1{உங்கள் FlyWeb தரவுகளில் சில உங்கள் FlyWeb கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறும் முன் சில நிமிடங்கள் காத்திருக்கவும். நீங்கள் இப்போதே வெளியேறினால் இந்தத் தரவு (1 தரவு) நீக்கப்படும்.}other{உங்கள் FlyWeb தரவுகளில் சில உங்கள் FlyWeb கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறும் முன் சில நிமிடங்கள் காத்திருக்கவும். இப்போதே வெளியேறினால் இந்தத் தரவு ({count} தரவுகள்) நீக்கப்படும்.}}</translation>
<translation id="1292831930742306370">இந்த ஃபைல் ஆபத்தானதாக இருக்கக்கூடும் என்பதால் இதை ஸ்கேன் செய்யுமாறு FlyWeb பரிந்துரைக்கிறது.</translation>
<translation id="1547295885616600893">கூடுதல் <ph name="BEGIN_LINK_CROS_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_CROS_OSS"/> மூலம் ChromeOS உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="6831043979455480757">Translate</translation>
<translation id="6432682256389755533">கடவுச்சொற்கள் பாதுகாப்பை இழக்கும்பட்சத்தில் அவற்றை FlyWeb உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="684888714667046800">இணையத்துடன் இணைக்க முடியவில்லை. ஃபயர்வாலைப் பயன்படுத்தினால் ஃபைல் ஏற்புப் பட்டியலில் <ph name="PRODUCT_EXE_NAME"/> இருப்பதை உறுதிசெய்துகொள்ளவும்.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">தொடர தட்டவும்</translation>
<translation id="6862030660799253820">படத் தேடல் அம்சம் மூலம் இந்தப் படத்தைத் தேடுங்கள்</translation>
<translation id="6869568587896659271">முகவரிப் பட்டிக்குக் கீழே உள்ள இணையதளங்களை எளிதாக அணுகலாம்</translation>
<translation id="4695676871328690599">"<ph name="EXTENSION_NAME"/>" நீட்டிப்பில் மால்வேர் இருப்பதை FlyWeb கண்டறிந்துள்ளது</translation>
<translation id="6877155553248388166">தேடல் பகுதியின் கீழ் வலது மூலை: வலது <ph name="RIGHT"/>%, கீழ் <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">நகலெடு</translation>
<translation id="6898028264630240901">பிரவுசிங் செய்யும்போது எளிதாகக் கேள்விகளைக் கேட்க சூழல் சார்ந்த பணிகளைப் பின் செய்யலாம்</translation>
<translation id="8416061171168102237">Braveமை இயல்பு பிரவுசராக அமைத்து செயல் பட்டியில் பின் செய்யுங்கள்</translation>
<translation id="3503126745419877918">&amp;FlyWeb சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="4397299252625349918">இதனால்:
          <ph name="LINE_BREAKS"/>
            • உங்கள் துவக்கப் பக்கம், புதிய பிரவுசர் பக்கம், தேடல் இன்ஜின், இடம் மாறாத பக்கங்கள் ஆகியவை மீட்டமைக்கப்படும்
            <ph name="LINE_BREAK"/>
            • நீட்டிப்புகள் முடக்கப்படும்
            <ph name="LINE_BREAK"/>
            • குக்கீகளும் பிற தற்காலிகத் தளத் தரவும் நீக்கப்படும்
            <ph name="LINE_BREAK"/>
            • FlyWeb ஷார்ட்கட்கள் மீட்டமைக்கப்படும்
            <ph name="LINE_BREAKS"/>
            புக்மார்க்குகள், பதிவுகள், சேமிக்கப்பட்ட கடவுச்சொற்கள் ஆகியவை பாதிக்கப்படாது.</translation>
<translation id="2640214066670118583">Braveமின் <ph name="BOOKMARK_LIMIT"/> புக்மார்க்குகள் என்ற வரம்பை அடைந்துவிட்டதால், உங்களின் சில புக்மார்க்குகள் இன்னும் உங்கள் FlyWeb கணக்கில் சேமிக்கப்படவில்லை.

சில புக்மார்க்குகளை நீக்கும் வரை உங்கள் கணக்கில் புதிய புக்மார்க்குகளைச் சேமிக்க முடியாது. இப்போது வெளியேறினால், சேமிக்கப்படாத புக்மார்க்குகள் நீக்கப்படும்.</translation>
<translation id="6965382102122355670">சரி</translation>
<translation id="3453763134178591239">ChromeOS விதிமுறைகள்</translation>
<translation id="1163386134146281359">உங்கள் கணக்கில் (<ph name="ACCOUNT_EMAIL"/>) உள்ள FlyWeb தரவைப் பயன்படுத்தவும் சேமிக்கவும் உங்கள் கடவுச்சொற்றொடரை வழங்கவும்</translation>
<translation id="7011190694940573312">ஆப்ரேட்டிங் சிஸ்டத்தின் இந்தப் பதிப்பு ஆதரிக்கப்படாததால் நிறுவ முடியவில்லை.</translation>
<translation id="7024536598735240744">தொகுக்கப்படாத பிழை: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">Braveமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="7047386856539490735">இந்த முடிவுகள் பயனுள்ளவையாக உள்ளனவா?</translation>
<translation id="3945284827084409390">Braveஐப் புதுப்பி</translation>
<translation id="7886270027101123253">ஒரு படத்திற்குப் பயனுள்ள விளக்கம் இல்லாதபட்சத்தில் FlyWeb உங்களுக்காக அதை வழங்க முயலும். விளக்கங்களை உருவாக்குவதற்காக படங்கள் Braveளுக்கு அனுப்பப்படும்.</translation>
<translation id="8434939140421950539">உங்கள் <ph name="DEVICE_TYPE"/> இல் FlyWeb ஆப்ஸைப் பயன்படுத்தும்போது AI ஆற்றலைப் பெறுங்கள்</translation>
<translation id="2647329478963461727">மொபைலில் FlyWeb ஆப்ஸ் மூலம் கடவுச்சொற்கள், பக்கங்கள் மற்றும் பலவற்றை எங்கிருந்தும் அணுகுங்கள்</translation>
<translation id="5695394421048248926">FlyWeb for Testing உலாவியைப் பிரத்தியேகமாக்கு</translation>
<translation id="6802544479988856975">மெசேஜ்கள், ஆவணங்கள் மற்றும் பிற ஆப்ஸில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Braveமைப் பயன்படுத்தலாம்</translation>
<translation id="8694083743003679818"><ph name="EXTENSION_NAME"/> நீட்டிப்பை Braveமில் இருந்து அகற்றும்</translation>
<translation id="6017914745388312119">FlyWeb தரவு <ph name="TIMEOUT_DURATION"/> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.</translation>
<translation id="3283953248242339756">இந்தத் தளத்தை அணுக, Braveமிற்கு கேமரா அணுகல் தேவை</translation>
<translation id="4729674580260824908">Braveஐத் தொடங்க முடியவில்லை. மீண்டும் முயலவும்.</translation>
<translation id="805403942934515799">Braveமில் Gemini மூலம் எங்கிருந்தும் எதை வேண்டுமானாலும் கேளுங்கள்</translation>
<translation id="7093403858436459499">எந்த நேரத்திலும் Braveமிற்கு விரைவாகச் செல்ல அதை Dockகில் வைத்திருக்கவும்</translation>
<translation id="935820624106805690">மெசேஜ்கள், ஆவணங்கள், பிற ஆப்ஸ் ஆகியவற்றில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் FlyWeb உலாவியைப் பயன்படுத்தலாம்</translation>
<translation id="7216228761061470870">டெஸ்க்டாப்பில் படத் தேடலைப் பயன்படுத்தும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை சேவையகத்திற்கு அனுப்பப்படும்</translation>
<translation id="1678436729108859736">செயல் நிர்வாகி - FlyWeb</translation>
<translation id="7587087358591725059">பிற ஆப்ஸ், ஃபைல்கள் போன்ற Braveமில் இல்லாத உள்ளடக்கத்தைப் பற்றிக் கேட்கலாம்</translation>
<translation id="7013534648688018698"><ph name="EXISTING_USER"/> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். நீங்கள் சேமித்த தகவல்களையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="4889865510625659193">உடனடியாக பிரவுசிங் செய்யத் தொடங்குங்கள்: Windows தொடங்கும்போதே Braveமை இப்போது தொடங்கலாம்.</translation>
<translation id="7274695763216404502">பின் செய்யப்பட்டது! கருவிப்பட்டியில் இருந்து படத் தேடலை மீண்டும் பயன்படுத்தலாம்</translation>
<translation id="7288567540154601580">பக்கங்களும் நீட்டிப்புகளும்</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{இதை அகற்றும்படி FlyWeb பரிந்துரைக்கிறது}other{இவற்றை அகற்றும்படி FlyWeb பரிந்துரைக்கிறது}}</translation>
<translation id="5321339461210685340">சிஸ்டம் ஆடியோவைப் பகிர, சிஸ்டம் அமைப்புகளைத் திறந்து Braveமிற்கு 'சிஸ்டம் ஆடியோ ரெக்கார்டிங் மட்டும்' என்பதை அனுமதியுங்கள். Braveமை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="7299899569525778554">டெஸ்க்டாப்பில் இருந்து தேடு</translation>
<translation id="2866611433272355726">Braveஐப் புதுப்பிக்கிறது</translation>
<translation id="5013690772358862887">உங்கள் விருப்பத்தேர்வுகளின் ஃபைல் சிதைவடைந்துள்ளது அல்லது தவறானது.

உங்கள் அமைப்புகளை FlyWeb ஆல் மீட்டெடுக்க முடியவில்லை.</translation>
<translation id="7324051657739063017">பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க சூழல் சார்ந்த பணிகளை மீண்டும் திறக்கலாம்</translation>
<translation id="1123144153876435088">உங்களின் இணையம், புக்மார்க்குகள் மற்றும் பிற FlyWeb உருப்படிகள் இங்கே உள்ளன.</translation>
<translation id="8915041713909379783">உங்கள் கடவுச்சொற்றொடரை வைத்திருப்பவர்கள் மட்டுமே என்க்ரிப்ட் செய்யப்பட்ட உங்கள் தரவைப் படிக்க முடியும். கடவுச்சொற்றொடர் Braveளுக்கு அனுப்பப்படாது, அதை FlyWeb சேமிக்காது. கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ <ph name="BEGIN_LINK"/>உங்கள் கணக்கில் உள்ள FlyWeb தரவை நீக்க<ph name="END_LINK"/> வேண்டும்.</translation>
<translation id="6760192061736180746"><ph name="ALTERNATIVE_BROWSER_NAME"/> மூலம் <ph name="TARGET_URL_HOSTNAME"/> இணைப்பைப் பார்ப்பதற்கு உங்கள் சிஸ்டம் நிர்வாகி Braveமை உள்ளமைத்துள்ளார்.</translation>
<translation id="7352651011704765696">ஏதோ தவறு ஏற்பட்டது</translation>
<translation id="7601756527349047847">இனிவரும் FlyWeb புதுப்பிப்புகளைப் பெற macOS 13 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்தக் கம்ப்யூட்டர் macOS 12 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="3916387280110223245">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> ஆகிய அனுமதிகளை FlyWeb அகற்றிவிட்டது.</translation>
<translation id="3313237823190188892">சிஸ்டம் டிரேயில் Braveமில் Geminiயைக் காட்டு</translation>
<translation id="7401687852903179959">படத் தேடல் மூலம் இந்த வீடியோவைத் தேடுங்கள்</translation>
<translation id="6624551989332401777">இப்போது உங்கள் இயல்பு பிரவுசர் FlyWeb</translation>
<translation id="277733508197886564">விட்ட இடத்திலிருந்து தொடரலாம்: நீங்கள் ஒவ்வொரு முறை மீண்டும் தொடங்கும்போதும் FlyWeb உங்கள் பக்கங்களை மீட்டெடுக்கிறது. இதை ஆஃப் செய்ய, இதற்குச் செல்லவும்:</translation>
<translation id="948152006162936800">Braveமிற்குக் கடவுச்சொற்களைப் பதிவேற்றுதல்</translation>
<translation id="4755314372270379254">1. கீழே <ph name="BUTTON_LABEL"/> பட்டனைக் கிளிக் செய்யுங்கள்
2. Windows அமைப்புகளில் <ph name="BUTTON_2"/> பட்டனைக் கிளிக் செய்யுங்கள்
3. விரைவாக அணுகுவதற்கு Braveமை உங்கள் செயல் பட்டியில் பின் செய்ய, Windows அறிவிப்பில் <ph name="BUTTON_3"/> பட்டனைக் கிளிக் செய்யுங்கள்</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - டெவெலப்பர்களுக்கான FlyWeb</translation>
<translation id="7450541714075000668">உரை நகலெடுக்கப்பட்டது</translation>
<translation id="7472280958921965834">மைக்ரோஃபோனைப் பயன்படுத்த, Braveமிற்கு <ph name="BEGIN_LINK"/>சிஸ்டம் அமைப்புகளில்<ph name="END_LINK"/> அணுகலை வழங்குங்கள்</translation>
<translation id="2431618580332826398">இனிவரும் FlyWeb புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புத் தேவை. இந்தக் கம்ப்யூட்டர் Windows 7 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="2154651873647244914">Braveமை மீண்டும் தொடங்கவா?</translation>
<translation id="3137757192868162370">தற்போது இயக்கத்தில் உள்ள அதே பதிப்புள்ள Braveமை நிறுவ முடியாது. Braveமை மூடி, பின்னர் முயலவும்.</translation>
<translation id="3065486555702061722">நினைவில்கொள்ளுங்கள்: Braveளின் சிறந்த அம்சங்கள் உங்கள் பாக்கெட்டில்</translation>
<translation id="4027434552262956425">தளங்கள் எதிர்பார்த்தபடி செயல்படும். ஆனால், FlyWeb சாளரங்கள் அனைத்தையும் மூடும்போது பெரும்பாலான தளங்களில் (Braveமில் உள்நுழைந்திருந்தால் உங்களின் FlyWeb கணக்கைத் தவிர) இருந்து வெளியேறிவிடுவீர்கள்.</translation>
<translation id="4731230085409037950">{0,plural, =1{ஒரு நிமிடத்தில் FlyWeb மீண்டும் தொடங்கும்}other{# நிமிடங்களில் FlyWeb மீண்டும் தொடங்கும்}}</translation>
<translation id="301074550630080641">உங்கள் தரவைப் பாதுகாக்க, நீங்கள் சமீபத்தில் பார்வையிடாத தளங்களில் உள்ள அனுமதிகளை அகற்ற Braveமை அனுமதிக்கலாம்.</translation>
<translation id="3930051800510118744">உடனடியாக உலாவத் தொடங்க Braveமைத் தானாகவே தொடங்கலாம்.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> நிறுவி</translation>
<translation id="3067364763515000789">FlyWeb உங்கள் கேமராவையும் மைக்ரோஃபோனையும் பயன்படுத்துகிறது.</translation>
<translation id="1381291360713116383">FlyWeb இன்னும் சிறப்படைந்துள்ளது</translation>
<translation id="3892366519980032442">Braveமில் இப்போது உங்களுக்குக் கூடுதல் அம்சங்கள் கிடைக்கும்</translation>
<translation id="7624307931717240213">இந்தச் சேவையை மேம்படுத்த தகவல்களைப் பயன்படுத்துகிறோம். தனியுரிமைக் கொள்கை மற்றும் சேவை விதிமுறைகளைப் பாருங்கள்.</translation>
<translation id="7649070708921625228">உதவி</translation>
<translation id="7733015548570443346">FlyWeb ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="7658239707568436148">ரத்து செய்</translation>
<translation id="2230101319599356673">FlyWeb, உங்கள் இயல்புநிலை உலாவியாக இல்லை</translation>
<translation id="3243257760331619874">உங்கள் எல்லாச் சாதனங்களிலும் Braveஐ ஒத்திசைக்கலாம், தனிப்பயனாக்கலாம்</translation>
<translation id="3836891631266228927">FlyWeb புதுப்பிப்பு</translation>
<translation id="7362833186911891234">Braveமில் உங்கள் பணி பாதுகாப்பாக உள்ளது</translation>
<translation id="7716950018788545737">பணிகள் முடிந்தன.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> பிரவுசருக்கு சிஸ்டம் டிரேஸிங் சேவைகளை வழங்கும். இந்தச் சேவை முடக்கப்பட்டால், பிரவுசர் உருவாக்கும் செயல்பாட்டு டிரேஸ்களில் கண்டக்ஸ்ட் சுவிட்ச், ரெடி த்ரட் நிகழ்வுகளைப் போன்ற, சிஸ்டம் முழுமைக்குமான நிகழ்வுகள் சேர்க்கப்படாது.</translation>
<translation id="1549877678317463759">வெளியேறினால், இந்தச் சாதனத்திலிருந்து நீங்கள் உலாவிய தரவு நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Braveல் <ph name="USER_EMAIL"/> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="7747138024166251722">தற்காலிக டைரக்டரியை நிறுவியால் உருவாக்க முடியவில்லை. வட்டு இடம் காலியாக உள்ளதா, மென்பொருளை நிறுவுவதற்கு தகுந்த அனுமதி உள்ளதா என்பதை சரிபார்க்கவும்.</translation>
<translation id="104221467268393661">இயல்பு Braveமிற்கு மீட்டமை</translation>
<translation id="2414061498125565915">Braveமில் உங்கள் பணியைப் பாதுகாக்க, Braveமில் நீங்கள் உள்நுழைந்திருக்கும்போது குறிப்பிட்ட சில தகவல்களை உங்கள் நிறுவனத்தால் பார்க்கவோ நிர்வகிக்கவோ முடியும்.</translation>
<translation id="494195283222791090">Braveமை இயல்பு பிரவுசராக அமைத்து செயல் பட்டியில் பின் செய்யும்</translation>
<translation id="134973275687829726">Braveமை விரைவாக்குகிறது</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">உங்கள் இன்டர்நெட் டிராஃபிக்கிற்கான அணுகல் உள்ளவர்களுக்கு நீங்கள் பார்க்கும் தளங்களைத் தெரிந்துகொள்வதைக் கடினமாக்குகிறது. DNSஸில் (Domain Name System - டொமைன் பெயர் சிஸ்டம்) ஒரு தளத்தின் IP முகவரியைத் தேட FlyWeb பாதுகாப்பான இணைப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7810005234485217901">எளிதாக அணுக படத் தேடலைப் பின் செய்யலாம்</translation>
<translation id="6059158364953614237">FlyWeb உடன் பகிர வேண்டியவற்றைத் தேர்வுசெய்யுங்கள்</translation>
<translation id="8463540467315366872">இந்தக் கணக்கின் மூலம் ஏற்கெனவே ஒரு FlyWeb சுயவிவரம் இந்தச் சாதனத்தில் உருவாக்கப்பட்டுள்ளது</translation>
<translation id="7845233973568007926">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME"/> ஐப் பயன்படுத்துவதற்கு முன் கம்ப்யூட்டரை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="3682929584258119691">FlyWeb அல்லாமல் வேறொன்றில் இருந்து உங்கள் தேடல் இன்ஜின் மாற்றப்பட்டுள்ளது. உங்களைப் பாதுகாக்க, FlyWeb அதன் அசல் இயல்புநிலைக்கு இதை மீட்டமைத்துள்ளது. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">Braveமைப் பிரத்தியேகமாக்கி அதற்குப் புதிய தோற்றத்தைக் கொடுக்கலாம்</translation>
<translation id="8611872055947278722">FlyWeb சமீபத்திய பதிப்பிற்குப் புதுப்பிக்கப்படவில்லை என்பதால், புதிய அம்சங்களையும் பாதுகாப்புத் திருத்தங்களையும் தவறவிடுகிறீர்கள்.</translation>
<translation id="7872446069773932638">பதிவிறக்குகிறது... <ph name="SECONDS"/> வினாடிகள் மீதமுள்ளன</translation>
<translation id="3999247564452560622">கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ <ph name="BEGIN_LINK"/>உங்கள் கணக்கில் உள்ள FlyWeb தரவை நீக்குங்கள்<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">தேவைப்படும்போதெல்லாம் Braveமில் Geminiயை விரைவாகத் திறக்கும்</translation>
<translation id="6798431672720500005">Braveமை இயல்பு உலாவியாக அமை</translation>
<translation id="332151924263389003">சாத்தியமான சூழல்களில் பாதுகாப்பற்ற இணைப்புகளை FlyWeb தானாகவே HTTPSஸாக மேம்படுத்தும்</translation>
<translation id="3096730275883527801">Braveமில் <ph name="USER_EMAIL_ADDRESS"/> ஆக உள்நுழைந்திருந்தீர்கள். மீண்டும் உள்நுழைய அதே கணக்கைப் பயன்படுத்தவும்.</translation>
<translation id="7097534420680357688"><ph name="EXISTING_USER"/> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். புக்மார்க்குகளையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="9017338699075596174">இது FlyWeb இன் இரண்டாம் நிலை நிறுவல் என்பதால், அதை இயல்புநிலை உலாவியாக அமைக்க முடியாது.</translation>
<translation id="2888168499066553233">உங்கள் <ph name="DEVICE_TYPE"/> இல் FlyWeb ஆப்ஸ் மூலம் Braveளின் சிறந்த அம்சங்களைப் பெறுங்கள்</translation>
<translation id="8004582292198964060">உலாவி</translation>
<translation id="8010081455002666927">தானியங்குக் கண்டறிதல்</translation>
<translation id="5944585442866020176">Braveமுக்கு அணுகல் கிடைத்தவுடன், இணையதளங்கள் உங்களிடம் அணுகலைக் கோர முடியும்.</translation>
<translation id="4462215250900528778">எந்த நேரத்திலும் Braveமிற்கு விரைவாகச் செல்ல செயல் பட்டியில் அதைப் பின் செய்யவும்</translation>
<translation id="80471789339884597">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME"/> ஐப் பயன்படுத்துவதற்கு முன் உங்கள் அனைத்து உலாவிகளையும் மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="8054112667659782652">படத் தேடலுக்கான ஷார்ட்கட்டை எப்போதும் காட்டு</translation>
<translation id="8069447462453318634">"கருவிப்பட்டியில் பின் செய்" என்பதைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="3685797926747054412">ஆப்ஸிற்காக FlyWeb பின்புலத்தில் இயங்குவதை முடக்கு</translation>
<translation id="80790299200510644">படத் தேடல்</translation>
<translation id="8086881907087796310">குறைந்தபட்ச வன்பொருள் தேவைகளை உங்கள் கம்ப்யூட்டர் பூர்த்திசெய்யவில்லை என்பதால் நிறுவ முடியவில்லை.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">இந்தத் தளத்தை அணுக, Braveமிற்கு இருப்பிட அணுகல் தேவை</translation>
<translation id="5289593085778678155">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் Braveமைத் திறக்கும்போது, விலைக் கண்காணிப்பு விழிப்பூட்டல்களை ஆன் செய்யும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="7635444121786764725">மொபைலில் உள்ள FlyWeb ஆப்ஸ் மூலம், நீங்கள் வாங்க விரும்பும் தயாரிப்புகளின் விலைச் சரிவு குறித்த விழிப்பூட்டல்களைப் பெறுங்கள்</translation>
<translation id="8118331347066725040">Lens மூலம் தேடுதல் குறித்த கருத்தை அனுப்புக</translation>
<translation id="5770057404954060005">உங்களுக்கான FlyWeb ஆக மாற்றுங்கள்</translation>
<translation id="5334309298019785904">உங்கள் டொமைனில் ஒத்திசைவு இல்லாததால் உங்கள் தரவை ChromeOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="813913629614996137">துவக்குகிறது...</translation>
<translation id="6992240065504496864">கீபோர்டு ஷார்ட்கட் மூலம் Braveமில் Geminiயைத் திறக்கலாம்.</translation>
<translation id="6334554715655789744">FlyWeb கூடுதல் சேவை விதிமுறைகள்</translation>
<translation id="1597323875619800374">இந்த ஃபைல் ஆபத்தானது என்பதால், அதை FlyWeb தடுத்துள்ளது.</translation>
<translation id="8177472873527554730">பக்கத்தில் உள்ளடக்கத்தைக் கண்டறிய முடியவில்லை</translation>
<translation id="2214224574148863941">உங்கள் கணக்கில் (<ph name="USER_EMAIL"/>) உள்ள FlyWeb தரவைப் பயன்படுத்தவும் சேமிக்கவும் உங்கள் கடவுச்சொற்றொடரை வழங்கவும்</translation>
<translation id="820759916613250543">படத் தேடல் மூலம் இந்தப் படத்தைத் தேடுங்கள்</translation>
<translation id="8221491193165283816">பொதுவாக அறிவிப்புகளைத் தடுத்துள்ளீர்கள். இந்தத் தளம் அறிவிப்புகளை வழங்கச் செய்ய, இங்கே கிளிக் செய்யவும்.</translation>
<translation id="2459467374982542273">கேமராவைப் பயன்படுத்த, Braveமிற்கு <ph name="BEGIN_LINK"/>சிஸ்டம் அமைப்புகளில்<ph name="END_LINK"/> அணுகலை வழங்குங்கள்</translation>
<translation id="4749458995158778066">இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Braveமால் சரிபார்க்க முடியவில்லை மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="6756872644564483342">ஒரு படத்திற்குப் பயனுள்ள விளக்கம் இல்லாதபட்சத்தில் FlyWeb உங்களுக்காக அதை வழங்க முயலும். விளக்கங்களை உருவாக்குவதற்காக படங்கள் Braveளுக்கு அனுப்பப்படும். அமைப்புகளுக்குச் சென்று எப்போது வேண்டுமானாலும் இதை முடக்கலாம்.</translation>
<translation id="9179486248398668702">Braveமில் புதிய சுயவிவரத்தில் உள்நுழைய வேண்டுமா?</translation>
<translation id="1470002120352085290"><ph name="EXISTING_USER"/> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Braveமில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE"/> இருந்து கடவுச்சொற்களையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="8901123396574346662">சிஸ்டம் டிரேயில் Braveமில் Geminiயைக் காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="9102959605052547519">பாதுகாப்பற்ற தளங்கள் மற்றும் பதிவிறக்கங்கள் குறித்து <ph name="BEGIN_LINK"/>FlyWeb உங்களை எச்சரிக்கும்<ph name="END_LINK"/></translation>
<translation id="669999719045196468">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION"/> அனுமதியை FlyWeb அகற்றிவிட்டது.</translation>
<translation id="7136168924180047124">நீங்கள் பார்ப்பவற்றை உங்கள் கேமரா மூலம் FlyWeb iOS ஆப்ஸில் ஷாப்பிங் செய்யலாம், மொழிபெயர்க்கலாம், அடையாளம் காணலாம்</translation>
<translation id="867002910715789721"><ph name="USER_NAME"/> என்ற கணக்கில் Braveமில் உள்நுழைவதற்கான QR குறியீடு</translation>
<translation id="8313851650939857356">துவக்கப் பிழை: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">FlyWeb <ph name="TIMEOUT_DURATION"/> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை மூடிவிடும்.</translation>
<translation id="8321888067342493336">படமாகச் சேமி</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> ஏற்கனவே Braveஐப் பயன்படுத்திக் கொண்டிருந்தது</translation>
<translation id="7009033378151348624">Braveமில் திறன்களை ஆன் செய்</translation>
<translation id="338142060986183805">உங்கள் FlyWeb கணக்கில் (<ph name="ACCOUNT_EMAIL"/>) உள்ள FlyWeb தரவைத் தொடர்ந்து பயன்படுத்த Braveமைப் புதுப்பிக்கவும்</translation>
<translation id="7408894216012529448">இனிவரும் FlyWeb புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்தக் கம்ப்யூட்டர் Windows 8 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="8362914115861174987">இதற்கு மொழிபெயர்க்கும்:</translation>
<translation id="8367705492654390392">எதை வேண்டுமானாலும் கேளுங்கள்</translation>
<translation id="5020916672477085422">கடவுச்சொற்கள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் அனைத்திலும் பெற Braveமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் FlyWeb கணக்கில் இந்தக் கடவுச்சொல் சேமிக்கப்படும்.</translation>
<translation id="5417365165109189454">Braveமை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="4212474799248200893">இதை அகற்றும்படி FlyWeb பரிந்துரைக்கிறது. <ph name="BEGIN_LINK"/>ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">இந்த நீட்டிப்பின் வெளியீடு அதன் டெவெலப்பரால் நிறுத்தப்பட்டது, மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="3669395395617655404">இது நீங்கள்தான் என்பதை FlyWeb உறுதிசெய்ய வேண்டும். அதன் பிறகே, உங்கள் FlyWeb கணக்கில் தரவைச் சேமித்து அதை எல்லாச் சாதனங்களிலும் உங்களால் பயன்படுத்த முடியும். இப்போது வெளியேறினால் இந்தத் தரவு நீக்கப்படும்.</translation>
<translation id="5261590792975521002">{0,plural, =1{ஒரு நாளுக்குள் Braveமை மீண்டும் தொடங்கவும்}other{# நாட்களுக்குள் Braveமை மீண்டும் தொடங்கவும்}}</translation>
<translation id="8438543370129609977">படத் தேடல் அம்சத்தைப் பயன்படுத்தும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை சேவையகத்திற்கு அனுப்பப்படும். <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">Braveமில் படத் தேடல் மூலம் தேடுவது குறித்து மேலும் தெரிந்துகொள்ளலாம்</translation>
<translation id="3101564993057563365">நிறுவி காப்பகம் சிதைந்துள்ளது அல்லது தவறானது. Braveமை மீண்டும் பதிவிறக்கவும்.</translation>
<translation id="5316851838033144902">Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புகளில் மட்டுமே FlyWeb இயங்கும்.</translation>
<translation id="6760691951531758781">விருப்பத்திற்குரியது: பிழை அறிக்கைத் தரவு, உபயோகத் தரவு ஆகியவற்றை Braveளுக்குத் தானாக அனுப்புவதன் மூலம் ChromeOS அம்சங்களையும் செயல்திறனையும் மேம்படுத்த உதவுங்கள்.</translation>
<translation id="2523037024749170569">உங்கள் FlyWeb கணக்கில் உள்ள FlyWeb தரவைப் பயன்படுத்துவதற்கும் சேமிப்பதற்கும் இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்</translation>
<translation id="5989540778099253163">Braveமில் உள்நுழைவதற்கான அறிவிப்புகளைக் காட்டும்</translation>
<translation id="6852836260419236265">FlyWeb காலாவதியானது</translation>
<translation id="360892078644515524">Braveமை இயல்பு பிரவுசராகத் தேர்வுசெய்ததற்கு நன்றி!</translation>
<translation id="797182360653885317">உங்கள் கடவுச்சொற்களை நீங்கள் சேமிக்கும்போது FlyWeb உலாவியால் அவற்றைச் சரிபார்க்க முடியும்</translation>
<translation id="8525579356836940628">நிறுவல் நிறுத்தப்பட்டது</translation>
<translation id="8340284327429540526">உங்கள் <ph name="DEVICE_TYPE"/> இல் FlyWeb ஆப்ஸ் மூலம் கடவுச்சொற்கள், பக்கங்கள் மற்றும் பலவற்றை எங்கிருந்தும் அணுகுங்கள்</translation>
<translation id="7498776423722712116">உங்கள் கடவுச்சொற்களில் ஒன்று பொதுவான தரவு மீறலுக்கு உட்பட்டிருப்பதாக FlyWeb கண்டறிந்தால் அதுகுறித்து எச்சரிக்கையைப் பெறுவீர்கள்</translation>
<translation id="8555465886620020932">சேவைப் பிழை: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">சில FlyWeb அம்சங்களுக்கும் நீட்டிப்புகளுக்கும் ஷார்ட்கட்கள் உள்ளன. அவற்றை மீண்டும் இயக்க நீங்கள் தேர்வுசெய்யலாம்.</translation>
<translation id="8556420416730706394">எளிதாக அணுக படத் தேடலைப் பின் செய்யலாம். இதற்கு, பக்கவாட்டு பேனலின் மேற்புறத்தில் உள்ள 'பின் செய்' பட்டனைக் கிளிக் செய்யவும்.</translation>
<translation id="856656450041460113">மொழிப் பட்டியலைத் தேடும்</translation>
<translation id="5128162742812353891">Braveமைப் பல நிறுவனங்கள் நிர்வகிக்கின்றன</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="7129578417724116642">Braveமைத் தொடங்குகிறது...</translation>
<translation id="8624541899164515475">அமைப்புகள், புதிய பக்கத்தில் திறக்கும்.</translation>
<translation id="5469043671012993003">FlyWeb for Testingகை உங்கள் இயல்பு உலாவியாக அமைக்க முடியாது.</translation>
<translation id="3892251159131070138">எங்கிருந்தும் FlyWeb மூலம் தேடுங்கள்</translation>
<translation id="1514450422236300417">Braveமைத் தொடங்கும்போது அல்லது ஆம்னிபாக்ஸிலிருந்து தேடலை மேற்கொள்ளும்போது காண்பிக்கப்படும் பக்கத்தையும் இது கட்டுப்படுத்துகிறது.</translation>
<translation id="573490495087487940">இது உங்கள் FlyWeb ஆகும்</translation>
<translation id="8712637175834984815">புரிந்தது</translation>
<translation id="2666961286257416158">Braveமில் உள்நுழைய வேண்டுமா?</translation>
<translation id="8747073452963259673">தேடல் பகுதியின் கீழ் இடது மூலை: இடது <ph name="LEFT"/>%, கீழ் <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">நிறுவல் பிழை: நிறுவலைத் தடுக்கும் குழுக் கொள்கையை உங்கள் நெட்வொர்க் நிர்வாகி பயன்படுத்தியுள்ளார்: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">பின்னர் நினைவூட்டு</translation>
<translation id="4243214377720481697">விரைவான தகவல் சுருக்கத்தைப் பெறவும் ஃபாலோ-அப் கேள்விகளைக் கேட்கவும் Braveமில் Geminiயுடன் இந்த ஆவணத்தைப் பகிருங்கள்</translation>
<translation id="6808406663598665473">Braveமில் உள்நுழையவா?</translation>
<translation id="7022252178852457880">Braveமை இயல்பு பிரவுசராக்கி செயல் பட்டியில் பின் செய்யும்</translation>
<translation id="8826492472752484139">“Password Manager” என்பதைக் கிளிக் செய்யவும்</translation>
<translation id="6933858244219479645">ChromeOS சிஸ்டம்</translation>
<translation id="1501202286854500367">Braveமில் மெனுக்கள், அமைப்புகள், விழிப்பூட்டல்கள் மற்றும் பிற வார்த்தைகளைக் காட்ட இந்த மொழி பயன்படுத்தப்படும்.</translation>
<translation id="8862326446509486874">கம்ப்யூட்டர்-சார்ந்த நிறுவலுக்கான முறையான உரிமைகள் உங்களிடம் இல்லை. அதனால் நிர்வாகியாக மீண்டும் நிறுவலை இயக்க முயற்சி செய்க.</translation>
<translation id="2405293075272280413">FlyWeb சுயவிவரத்தைச் சேர்</translation>
<translation id="2096285611267043007">உள்நுழைவில் பிழை ஏற்பட்டதால் உங்கள் FlyWeb கணக்கில் FlyWeb தரவை ChromeOS சேமிக்க முடியவில்லை</translation>
<translation id="9046344742397901138">Braveமில் உள்நுழையும்படி உங்கள் நிறுவனம் வலியுறுத்துகிறது</translation>
<translation id="4669168852412989042">FlyWeb கடவுச்சொற்களைக் காண்பிக்க முயற்சிக்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லைத் தட்டச்சு செய்யவும்.</translation>
<translation id="2704405030486981087">FlyWeb இப்போது உங்கள் இயல்பு பிரவுசராக இல்லை. Braveமை இயல்பு பிரவுசராக அமைக்கவா?</translation>
<translation id="1663379621921336006">Braveஐப் புதுப்பிக்க முடியவில்லை</translation>
<translation id="8944232836376404813">இதனால்:
          <ph name="LINE_BREAKS"/>
            • உங்கள் துவக்கப் பக்கம், புதிய பிரவுசர் பக்கம், தேடல் இன்ஜின், இடம் மாறாத பக்கங்கள் ஆகியவை மீட்டமைக்கப்படும்
            <ph name="LINE_BREAK"/>
            • நீட்டிப்புகள் முடக்கப்படும்
            <ph name="LINE_BREAK"/>
            • குக்கீகளும் பிற தற்காலிகத் தளத் தரவும் நீக்கப்படும்
            <ph name="LINE_BREAKS"/>
            புக்மார்க்குகள், பதிவுகள், சேமிக்கப்பட்ட கடவுச்சொற்கள் ஆகியவை பாதிக்கப்படாது.</translation>
<translation id="188856534838382513">FlyWeb தள ஷார்ட்கட்களைக் காட்டு</translation>
<translation id="543915850302643692">FlyWeb Enterprise லோகோ</translation>
<translation id="4417647437359346154">உங்கள் <ph name="DEVICE_TYPE"/> இல் FlyWeb ஆப்ஸ் மூலம் Braveளின் பாதுகாப்பை எங்கிருந்தும் பெறுங்கள்</translation>
<translation id="6976267397714240800">உங்கள் சுயவிவரத்தைத் திறக்கும்போது ஏதோ தவறாகிவிட்டதால் Braveமைத் தொடங்க முடியவில்லை. Braveமை மீண்டும் தொடங்கவும்.</translation>
<translation id="8952346994182255880">Braveமில் தேட அல்லது <ph name="BEGIN_LINK"/>அமைப்புகளில்<ph name="END_LINK"/> பிரத்தியேகப்படுத்த</translation>
<translation id="8422308271795251425">FlyWeb சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="519942585686549229">Braveமில் உள்ள Geminiக்கும் நீங்கள் திறந்திருக்கும் பக்கத்திற்கும் இடையே மாற உங்கள் கீபோர்டைப் பயன்படுத்தலாம்.</translation>
<translation id="9018218886431812662">நிறுவப்பட்டது</translation>
<translation id="5804408305184682593">FlyWeb இல் உள்நுழைக</translation>
<translation id="7410599202980023102">Mac மெனு பட்டியில் Braveமில் Search காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="2138383893834402906">மால்வேரை மறைக்கக்கூடிய பிற ஃபைல்கள் இந்தக் காப்பக ஃபைலில் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை FlyWeb தடுத்துள்ளது</translation>
<translation id="8884768769854521848">கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம். Braveமை இயல்பு பிரவுசராக மாற்றுவதன் மூலம் உங்களுக்குத் தெரிந்த மற்றும் பிடித்த அம்சங்களை எளிதாக அணுகலாம். விரைவாக அணுகும் வகையில் FlyWeb உங்கள் செயல் பட்டியில் பின் செய்யப்படும்.</translation>
<translation id="3668027737318668659">மொபைலில் உள்ள FlyWeb ஆப்ஸ் மூலம் Braveளின் சிறந்த AI கருவிகளைப் பயன்படுத்துங்கள்</translation>
<translation id="1257818515846885633"><ph name="DEVICE"/> சாதனத்தில் உள்ள உங்கள் கடவுச்சொற்களையும் மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="7813768067688376455">பிற FlyWeb சேவைகளில் உள்நுழையும்போது Braveமிலும் உள்நுழை</translation>
<translation id="8323442969389928559">FlyWeb தானாக மூடப்பட்டது</translation>
<translation id="7626272203917389133">FlyWeb காலாவதியானது</translation>
<translation id="1789655708880997767">{0,plural, =1{ஒரு மணிநேரத்திற்குள் FlyWeb மீண்டும் தொடங்கும்}other{# மணிநேரத்திற்குள் FlyWeb மீண்டும் தொடங்கும்}}</translation>
<translation id="9106236359747881194">தேட வார்த்தையைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="8970147445441095618">இனிவரும் FlyWeb புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புத் தேவை. இந்தக் கம்ப்யூட்டர் Windows 8.1 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="1208237657860748752">புதிய FlyWeb &amp;தாவலில் இணைப்பைத் திற</translation>
<translation id="911206726377975832">உங்கள் உலாவிய தரவையும் நீக்க வேண்டுமா?</translation>
<translation id="9134482777260927479">வீட்டுப்பாட உதவி</translation>
<translation id="9148058034647219655">வெளியேறு</translation>
<translation id="1592415213971909403">விட்ட இடத்திலிருந்து தொடரலாம்: நீங்கள் ஒவ்வொரு முறை மீண்டும் தொடங்கும்போதும் FlyWeb உங்கள் பக்கங்களை மீட்டெடுக்க முடியும். இதை ஆன் செய்ய, இதற்குச் செல்லவும்:</translation>
<translation id="3926534790663909774"><ph name="TARGET_URL_HOSTNAME"/>ஐ அணுக FlyWeb அதை மாற்று உலாவியில் திறக்கும்படி உங்கள் சிஸ்டம் நிர்வாகி உள்ளமைத்துள்ளார்.</translation>
<translation id="5022081608392609959">&amp;Braveமைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Braveமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="3410331617397516204">Windows XP அல்லது Windows Vista ஆகியவற்றில் FlyWeb இனி ஆதரிக்கப்படாது என்பதால், அது சரியாகச் செயல்படாது</translation>
<translation id="3613308994653366133">FlyWeb மூலம் Braveளின் சிறந்த பாதுகாப்பு அம்சங்களை எங்கிருந்தும் பெறலாம்.</translation>
<translation id="945522503751344254">கருத்தை அனுப்பு</translation>
<translation id="1127626874097952395">Braveமைப் பயன்படுத்துவது யார்?</translation>
<translation id="1626113414414104077">Braveமின் உச்சபட்சப் பாதுகாப்பைப் பெறுங்கள்</translation>
<translation id="983803489796659991">புதுப்பிப்புச் சேவையகத்தில் ஆப்ஸுக்கான ஹேஷ் தரவு எதுவும் இல்லாததால் நிறுவ முடியவில்லை.</translation>
<translation id="839475718250652248">கணக்கு இல்லாமல் Braveமைப் பயன்படுத்து</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">படத் தேடல் அம்சத்தின் மூலம் தேட வார்த்தைகளையோ படத்தையோ தேர்ந்தெடுக்கவும்</translation>
<translation id="7783156808075587495">இருப்பிடத்தைப் பயன்படுத்த, Braveமிற்கு <ph name="BEGIN_LINK"/>சிஸ்டம் அமைப்புகளில்<ph name="END_LINK"/> அணுகலை வழங்குங்கள்</translation>
<translation id="137466361146087520">Google Chrome பீட்டா</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">குறிப்பிடப்படாத பிழை காரணமாக நிறுவல் தோல்வியடைந்தது. Braveமை மீண்டும் பதிவிறக்கம் செய்க.</translation>
<translation id="2725795635123877647">அறியப்படாத மூலங்களில் இருந்து பெறும் நீட்டிப்புகள், ஆப்ஸ், தீம்கள் ஆகியவை உங்கள் சாதனத்திற்குத் தீங்கு விளைவிக்கக்கூடும். <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> இல் இருந்து மட்டும் இவற்றை நிறுவுமாறு FlyWeb பரிந்துரைக்கிறது</translation>
<translation id="5840822070878669614">FlyWeb இணைய அங்காடியைத் திற</translation>
<translation id="3470813199863172076">FlyWeb ஆன்லைன் ஸ்டோர் கொள்கையை இந்த நீட்டிப்பு மீறுகிறது, மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="5382847955032513683">எச்சரிக்கை: நீங்கள் உலாவியவை குறித்த தகவல்களை நீட்டிப்புகள் பதிவுசெய்வதை Braveமால் தடுக்க முடியாது. மறைநிலைப் பயன்முறையில் இந்த நீட்டிப்பை முடக்க, இந்த விருப்பத்தைத் தேர்வுநீக்கவும்.</translation>
<translation id="543905389684998697">FlyWeb ஐப் பாதுகாப்பானதாக்க <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> இல் பட்டியலிடப்படாத சில நீட்டிப்புகளை நாங்கள் முடக்கிவிட்டோம், மேலும் அவை உங்களுக்குத் தெரியாமல் சேர்க்கப்பட்டிருக்கலாம்.</translation>
<translation id="3914570680366033593">Braveஐப் பாதுகாப்பானதாக்க, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> இல் பட்டியலிடப்படாத பின்வரும் நீட்டிப்பை முடக்கியுள்ளோம், மேலும் அது உங்களுக்குத் தெரியாமல் சேர்க்கப்பட்டிருக்கலாம்.</translation>
<translation id="2742103213766991703">FlyWeb மறை&amp;நிலை சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="5606966092070089147">இணைப்பை பிரேவ் பிரைவேட் சாளரத்தில் திறக்கவும் &amp;</translation>
<translation id="1616978953472841483">FlyWeb மறை&amp;நிலை சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{Braveமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும்.}=1{Braveமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{Braveமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="8494512118209691256">இது FlyWeb இலிருந்து உங்கள் உள்ளூர் சாதனங்களான டிவி அல்லது ஸ்பীக்கர் போன்றவற்றுக்கு உள்ளடக்கத்தைப் பகிர அனுமதிக்கும்.</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார்}=1{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார்}=1{புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="6998204082704836463">{COUNT, plural, =0 {மேம்பட்ட பாதுகாப்பு, புதுப்பிப்பைச் செயல்படுத்த நீங்கள் FlyWeb ஐ மீள்துவக்க வேண்டும்} =1 {மேம்பட்ட பாதுகாப்பு, புதுப்பிப்பைச் செயல்படுத்த நீங்கள் FlyWeb ஐ மீள்துவக்க வேண்டும். உங்கள் தனிப்பட்ட சாளரம் மீண்டும் திறக்காது.} other {மேம்பட்ட பாதுகாப்பு, புதுப்பிப்பைச் செயல்படுத்த நீங்கள் FlyWeb ஐ மீள்துவக்க வேண்டும். உங்கள் # தனிப்பட்ட சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="5749154344207139683">இந்த 1 நிமிடக் கருத்தாய்வை எடுப்பதன் மூலம் தனிப்பட்டது என்பதை மேம்படுத்த உதவவும்.</translation>
<translation id="4766381896251401675">முகவரிப் பட்டியிலோ தேடல் பெட்டியிலோ நீங்கள் டைப்செய்யும்போது, சிறப்பான பரிந்துரைகளைப் பெறுவதற்காக அவற்றை உங்களின் வழக்கமான தேடல் இன்ஜினுக்கு FlyWeb அனுப்பும். இந்த அம்சம் மறைநிலைப் பயன்முறையில் முடக்கப்பட்டிருக்கும்.</translation>
<translation id="2832552148674305108">FlyWeb மறைநிலை</translation>
<translation id="611606920944085547">மறைநிலைப் பயன்முறையில் உலாவும்போது, பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தி ஒரு தளத்தை ஏற்றும் முன் FlyWeb உங்களை எச்சரிக்கும்</translation>
</translationbundle>