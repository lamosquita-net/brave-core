<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="130631256467250065">Spremembe bodo uveljavljene pri naslednjem vnovičnem zagonu naprave.</translation>
<translation id="1555506416658437797">urediti plačilna sredstva.</translation>
<translation id="8359495463485001719">Poročanje o zrušitvah ni na voljo v Braveu.</translation>
<translation id="6338530717474923868">Ogledujete si varno stran Bravea</translation>
<translation id="5147169001159408844">FlyWeb poskuša spremeniti nastavitve za izpolnjevanje podatkov o plačilnih sredstvih.</translation>
<translation id="5702992568540613683">Logotip Bravea</translation>
<translation id="510342522494506803">FlyWeb poskuša urediti plačilna sredstva.</translation>
<translation id="8375862260948854624">FlyWeb omogočata odprtokodni projekt <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> in druga <ph name="BEGIN_LINK_OSS"/>odprtokodna programska oprema<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Odprite
          meni Bravea &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Nastavitve lokalnega omrežja
          in počistite potrditveno polje »Uporabi namestniški strežnik za lokalno omrežje«.</translation>
<translation id="5040124620086808431">To stran je blokiral FlyWeb.</translation>
<translation id="1953000035868532675">V nastavitvah požarnega zidu ali protivirusnega programa omogočite Braveu dostop do
        omrežja.</translation>
<translation id="3442058224540562441">Odprite
          meni Bravea &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          in poskrbite, da je konfiguracija nastavljena na »brez namestniškega strežnika« ali »neposredno«.</translation>
<translation id="585620188971323280">spremeniti nastavitve za izpolnjevanje podatkov o plačilnih sredstvih.</translation>
<translation id="2681118099728446983">FlyWeb omogoča tudi druga <ph name="BEGIN_LINK_OSS"/>odprtokodna programska oprema<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Spremembe bodo začele veljati ob naslednjem zagonu Bravea.</translation>
<translation id="1017070759373671177">FlyWeb omogoča odprtokodni projekt <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">Odprite
        meni Bravea &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        in počistite polje »<ph name="NO_PREFETCH_DESCRIPTION"/>«.
        Če s tem težave ne odpravite, priporočamo, da to možnost
        zaradi izboljšanja delovanja znova izberete.</translation>
<translation id="8187289872471304532">Odprite
          Aplikacije &gt; Sistemske nastavitve &gt; Omrežje &gt; Dodatno &gt; Namestniški strežniki
          in počistite polja z označenimi namestniškimi strežniki.</translation>
<translation id="4699594416850504200">Ogledujete si varno stran brskalnika FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb se ni pravilno zaustavil.</translation>
</translationbundle>