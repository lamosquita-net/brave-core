<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="7099479769133613710">‏הפעלה מחדש לצורך עדכון ‎&amp;ChromeOS</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="6896681084876612310">‏FlyWeb עוזר להגן עליך מפני פרצות באבטחת המידע, תוספים לא תקינים ועוד</translation>
<translation id="1368460307421081773">‏FlyWeb רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="7307912249127683931">‏FlyWeb מוגדר כדפדפן ברירת המחדל</translation>
<translation id="4556715463645168547">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK"/>יש להיכנס ל-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">‏לוחצים על תפריט FlyWeb</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{‏תוספים ל-FlyWeb ניגשו למכשירי ממשק אנושי (HID)}=1{‏תוספים ל-FlyWeb ניגשים למכשירי ממשק אנושי (HID)}one{‏תוספים ל-FlyWeb ניגשים ל-# מכשירי ממשק אנושי (HID)}two{‏תוספים ל-FlyWeb ניגשים ל-# מכשירי ממשק אנושי (HID)}other{‏תוספים ל-FlyWeb ניגשים ל-# מכשירי ממשק אנושי (HID)}}</translation>
<translation id="4380351562011537903">‏על FlyWeb</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="4876991604685198381">‏FlyWeb פועל מהר יותר בזכות מצב החיסכון בזיכרון</translation>
<translation id="4750836834956739196">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-FlyWeb ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="4549187150186083146">‏הגדרת הפרופיל החדש שלך ב-FlyWeb</translation>
<translation id="4150708158890309866">‏נכנסת ל-FlyWeb!</translation>
<translation id="4713192356155907986">‏קבלת עזרה לגבי FlyWeb for Testing</translation>
<translation id="8962360511570172">‏שיתוף כרטיסיית FlyWeb</translation>
<translation id="8196829963313696543">‏FlyWeb זקוק להרשאת גישה למצלמה כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="3961251277542681013">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-FlyWeb</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="5579294097895667826">‏גרסה חדשה ובטוחה יותר של FlyWeb זמינה כעת.</translation>
<translation id="2383861520542390014">‏יש לך אפשרות לראות ולהסיר את תחומי העניין שלפיהם האתרים מציגים לך את המודעות. ההערכה של תחומי העניין ב-FlyWeb מתבססת על היסטוריית הגלישה שלך מהזמן האחרון.</translation>
<translation id="5695205873161614119">‏נתוני הגלישה ב-FlyWeb יימחקו בקרוב</translation>
<translation id="7385422968404728039">‏FlyWeb יופעל מחדש בעוד <ph name="REMAINING_TIME"/></translation>
<translation id="307170399141486420">‏התרה ל-FlyWeb לפעול ברקע</translation>
<translation id="2473319786107120819">‏התקנת FlyWeb מחדש</translation>
<translation id="2533324957407080119">‏FlyWeb מנסה <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6434738578659849497">‏אתרים יכולים לשמור מידע ב-FlyWeb לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="4824940465467423308">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-FlyWeb. הנתונים שלך ב-FlyWeb, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME"/>. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות FlyWeb, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-FlyWeb בנפרד.<ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי FlyWeb, כמו Gmail, בלי להיכנס אל FlyWeb</translation>
<translation id="5714085538350759767">‏FlyWeb אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="4035053306113201399">‏צריך להפעיל מחדש את ChromeOS כדי להחיל את העדכון הזה.</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE"/> דק'</translation>
<translation id="6956650624767954726">‏ב-FlyWeb לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="6495079989036864983">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל FlyWeb עם <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="4252651275570549255">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK"/>יש להיכנס ל-FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">‏בוחרים אם לכלול את ההיסטוריה ב-FlyWeb להתאמה אישית מדויקת יותר בשירותי FlyWeb</translation>
<translation id="1868972292925460871">‏מידע על האופן שבו FlyWeb מנהל את אישורי הבסיס שלו</translation>
<translation id="6765231735885996239">‏התאמה אישית של FlyWeb</translation>
<translation id="2174917724755363426">ההתקנה לא הושלמה. להמשיך בביטול?</translation>
<translation id="2937508664417729967">‏FlyWeb – כניסה לרשת – <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">‏אם משתפים מחשב, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את FlyWeb בדיוק כפי שהם רוצים.</translation>
<translation id="5067150284614317159">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-FlyWeb. אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, FlyWeb עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים.</translation>
<translation id="3256927121768528350">‏כדי לשלוח מספר מכאן לטלפון Android, יש להיכנס ל-FlyWeb בשני המכשירים.</translation>
<translation id="8776241960316471093">‏התוסף שינה את הדף שמוצג כשמפעילים את FlyWeb.</translation>
<translation id="2359808026110333948">המשך</translation>
<translation id="8418845734693287262">‏לא בוצע סנכרון של הנתונים שלך ב-ChromeOS כי פרטי הכניסה לחשבון לא מעודכנים.</translation>
<translation id="2100412893059179161">‏התוסף "<ph name="EXTENSION_NAME"/>" שינה את הדף שמוצג כשמפעילים את FlyWeb.</translation>
<translation id="1364879203203742966">‏נדרשות הרשאות גישה למצלמה ולמיקרופון ב-FlyWeb עבור האתר הזה</translation>
<translation id="2451727308784734061">באמצעות קיצורי הדרך אפשר להגיע מהר למנהל הסיסמאות. ניתן להעביר את קיצור הדרך למרכז האפליקציות או למסך הבית של המחשב.</translation>
<translation id="3224379053610845181">‏FlyWeb ייסגר בקרוב</translation>
<translation id="3840682988105604367">‏ב-FlyWeb</translation>
<translation id="2485422356828889247">הסרת התקנה</translation>
<translation id="6823116595279840454">‏FlyWeb מנסה להחליף את הסיסמאות הקיימות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="2691552788029831386">‏FlyWeb זקוק לגישה לאחסון כדי להוריד קבצים</translation>
<translation id="2275866327478859777">FlyWeb Helper</translation>
<translation id="7717615706977383025">‏המנהל של פרופיל העבודה יכול להסיר נתוני FlyWeb שמופקים בזמן השימוש בפרופיל (כמו יצירת סימניות, היסטוריה, סיסמאות והגדרות נוספות). <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">‏המשך השימוש ב-FlyWeb</translation>
<translation id="3827993926722004004">‏במהלך ההתקנה ארעה שגיאה של מערכת ההפעלה. יש להוריד שוב את FlyWeb.</translation>
<translation id="333184635927514678">‏אם משתפים מכשיר, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את FlyWeb בדיוק כפי שהם רוצים</translation>
<translation id="8991987934418988501">‏קובץ הארכיון הזה נחסם על ידי FlyWeb כי הוא עלול להסתיר תוכנה זדונית</translation>
<translation id="1661841342483968180">‏ברוך בואך אל FlyWeb, <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">‏כרטיסייה של FlyWeb</translation>
<translation id="2796283369875688710">‏לשיפור האבטחה, FlyWeb יצפין את הנתונים.</translation>
<translation id="2770231113462710648">שינוי דפדפן ברירת המחדל ל:</translation>
<translation id="7907238427168022751">‏התוסף הזה מכיל תוכנה זדונית והוא לא בטוח. צריך להסיר אותו מ-FlyWeb כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="2799223571221894425">הפעלה מחדש</translation>
<translation id="8990114339313395142">‏ייווצר פרופיל FlyWeb חדש בשביל <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="1339341044496643931">‏הסרה מ-FlyWeb...</translation>
<translation id="4922993584046885552">‏מגינה עליך ב-FlyWeb ועשויה לשפר את רמת האבטחה באפליקציות אחרות של FlyWeb. ההגנה הזו פעילה רק אם נכנסים לחשבון.</translation>
<translation id="2885378588091291677">מנהל המשימות</translation>
<translation id="3806033752149316261">‏מידע על &amp;FlyWeb‏</translation>
<translation id="2915996080311180594">הפעלה מחדש מאוחר יותר</translation>
<translation id="2928420929544864228">ההתקנה הושלמה.</translation>
<translation id="1661079783259785361">‏FlyWeb‏ מעודכן</translation>
<translation id="5447533789927384736">‏אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, FlyWeb עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים</translation>
<translation id="1244955229468464260">‏FlyWeb לא יכול לבדוק את הסיסמאות שלך. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="8841609317523323027">‏מתבצעת הוספה ל-FlyWeb...</translation>
<translation id="3038232873781883849">בהמתנה להתקנה…</translation>
<translation id="7859502023458300952">‏עזרה בשיפור FlyWeb על ידי שליחת <ph name="UMA_LINK"/> ודוחות קריסה אל FlyWeb</translation>
<translation id="4133194854947529871">‏היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-FlyWeb מחיקה אוטומטית של תחומי העניין שלך על בסיס מתחלף מדי חודש. תחומי עניין שלא הוסרו עוברים רענון.</translation>
<translation id="1407857531570256859">‏המתקין לא הצליח לבטל את דחיסת הארכיון. יש להוריד שוב את FlyWeb.</translation>
<translation id="1309738977648134943">‏FlyWeb משתמש במיקרופון שלך.</translation>
<translation id="6274649779206195384">‏הפעלה מחדש של FlyWeb</translation>
<translation id="6773570808762718524">‏התאמה אישית של פרופיל FlyWeb החדש</translation>
<translation id="2700572810650522793">‏וואו! FlyWeb קרס. להפעיל מחדש עכשיו?</translation>
<translation id="5449297306961970452">‏FlyWeb אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="6755586344927335130">‏מותקנת גרסה <ph name="PRODUCT_VERSION"/> של FlyWeb</translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="3900612994249740104">‏המפתחות של FlyWeb API חסרים. פונקציונליות מסוימת של FlyWeb תהיה מושבתת.</translation>
<translation id="6824575001009586492">‏המשך הפעלת יישומים ברקע כאשר FlyWeb סגור</translation>
<translation id="5399208721646088502">‏כבר קיים פרופיל FlyWeb עם החשבון הזה</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">‏לעבור לפרופיל קיים של FlyWeb?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="847273641988291714">‏באמצעות פרופילים ב-FlyWeb, מפרידים את כל הפריטים ב-FlyWeb. יוצרים פרופילים המיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="1558345997029205345">‏אם מערכת FlyWeb תזהה שנכנסת עם סיסמה שנחשפה, היא תתריע לך על כך</translation>
<translation id="956833467923764542">‏פעולה זו תמחק <ph name="ITEMS_COUNT"/> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל FlyWeb עם <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">‏ניתן לעבור בין פרופילים של FlyWeb באמצעות <ph name="SHORTCUT"/></translation>
<translation id="6724485219247982027">‏יש לסגור את כל חלונות FlyWeb ולנסות שוב.</translation>
<translation id="763231524941489073">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-FlyWeb כדי שלא יילקחו בחשבון.</translation>
<translation id="4856314253538330936">‏היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות FlyWeb במכשיר הזה.</translation>
<translation id="1054901839328542426">‏יש במחשב שלך תוכנה מזיקה. FlyWeb יכול להסיר אותה, לשחזר את ההגדרות שלך ולהשבית תוספים כדי שהדפדפן יחזור שוב לפעולה רגילה.</translation>
<translation id="199853864262219284">‏כבר מחובר חשבון אחר. כדי להפריד בין פעילויות גלישה, FlyWeb יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="9154454584386840012">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך להשתמש ב-macOS מגרסה 10.15 ואילך. במחשב הזה מותקנת מערכת ההפעלה macOS 10.13.</translation>
<translation id="7465608402296261674">‏כדי לשלוח מספר מ-<ph name="ORIGIN"/> לטלפון Android שלך, צריך להיכנס אל FlyWeb בשני המכשירים.</translation>
<translation id="1543563097158722437">‏FlyWeb לא יכול לבדוק את הסיסמאות שלך. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="190360428475385352">‏מידע נוסף על ההתאמה האישית של המודעות ב-FlyWeb</translation>
<translation id="6611602069520888180">‏פתיחת הקישור ב&amp;כרטיסיית FlyWeb חדשה</translation>
<translation id="8701399577028839698">‏FlyWeb מאפשר לך ללחוץ על מספר טלפון באינטרנט ולהתקשר אליו באמצעות Skype!</translation>
<translation id="2401189691232800402">‏מערכת ChromeOS</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">‏קבלת עזרה בנושא ChromeOS</translation>
<translation id="1864899808802540927">‏אפשר לקבל את הנתונים של <ph name="ACCOUNT_EMAIL"/> ולשמור אותם בדפדפן FlyWeb</translation>
<translation id="2736927994658608637">‏כדי לקבל עדכונים של FlyWeb בעתיד, צריך להשתמש ב-macOS מגרסה 10.15 ואילך. במחשב הזה מותקנת מערכת ההפעלה macOS 10.14.</translation>
<translation id="5175060854726708547">‏התאמה אישית וניהול של FlyWeb נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="606156353708638647">‏יש ללחוץ על השם שלך כדי לפתוח את FlyWeb ולהתחיל לגלוש.</translation>
<translation id="5145107420478372433">‏המשתמש <ph name="EXISTING_USER"/> כבר מחובר לפרופיל FlyWeb הזה. כדי להפריד בין פעילויות גלישה, FlyWeb יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="3376157109651222096">‏החשבון שלך מנוהל על ידי <ph name="MANAGER_NAME"/>. האדמין שלך יכול לראות ולערוך את הפרופיל הזה של דפדפן FlyWeb ואת הנתונים שלו, כמו סימניות, היסטוריה וסיסמאות.</translation>
<translation id="8536259619256229278">‏FlyWeb מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="4041003017438130352">‏ההמלצה של FlyWeb היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן</translation>
<translation id="5667414856761616811">‏מידע על &amp;FlyWeb for Testing</translation>
<translation id="1152920704813762236">‏מידע על ChromeOS</translation>
<translation id="3703994572283698466">‏השימוש ב-ChromeOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS"/>תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS"/> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS"/>סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="504994999924593940">‏דיווח על <ph name="BEGIN_LINK"/>ההגדרות הנוכחיות<ph name="END_LINK"/> יעזור לשפר את FlyWeb</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4055805654398742145">מנהל הס&amp;יסמאות</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך דקה. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}one{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}two{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}other{‏לפי הגדרת הארגון, FlyWeb נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}}</translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="4890947375650921286">‏<ph name="PAGE_TITLE"/> – כניסה לרשת – FlyWeb</translation>
<translation id="4007949387571083162">‏אפליקציות, משחקים, תוספים ועיצובים מעולים בשביל FlyWeb.</translation>
<translation id="1595210458721188387">‏זו השפה שבה מוצג ממשק המשתמש של FlyWeb</translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="2564888740660198776">‏האם לקשר את הנתונים שלך ב-FlyWeb לחשבון זה?</translation>
<translation id="8514458758262040082">‏עזרה בנושא FlyWeb</translation>
<translation id="3393587701694585022">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם FlyWeb פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="4304713468139749426">מנהל הסיסמאות</translation>
<translation id="4334294535648607276">ההורדה הושלמה.</translation>
<translation id="1068681683510904753">‏לפי דרישת <ph name="MANAGER"/>, יש לקרוא את התנאים וההגבלות הבאים ולהסכים להם לפני השימוש במכשיר הזה. תנאים אלה לא מרחיבים, משנים או מגבילים את התנאים של ChromeOS.</translation>
<translation id="1376968889000878095">‏לסגור את FlyWeb בכל זאת?</translation>
<translation id="6360389033094512399">‏FlyWeb יכול לפעול ברקע</translation>
<translation id="4166347503469830337">‏התאמה אישית ושליטה ב-FlyWeb</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="8791209382165811772">‏מידע על FlyWeb for Testing</translation>
<translation id="834808339160590901">‏ברוך בואך אל FlyWeb. נפתח חלון חדש בדפדפן</translation>
<translation id="1304885695888649052">‏FlyWeb לא התעדכן, משהו השתבש. <ph name="BEGIN_LINK"/>לטיפול בבעיות בעדכון של FlyWeb ובעדכונים שנכשלו<ph name="END_LINK"/></translation>
<translation id="7350427799239500204">‏להמשיך בפרופיל FlyWeb חדש?</translation>
<translation id="4567424176335768812">נכנסת למערכת בתור <ph name="USER_EMAIL_ADDRESS"/>. כעת יש לך אפשרות לגשת אל הסימניות, ההיסטוריה והגדרות אחרות שלך בכל המכשירים שבהם התחברת לחשבון.</translation>
<translation id="4594305310729380060">שמירה למנהל הסיסמאות במכשיר הזה</translation>
<translation id="6046424510733540251">‏יישומי FlyWeb</translation>
<translation id="4970880042055371251">‏גרסת ChromeOS</translation>
<translation id="1936188352112244665">‏העדכון כמעט הושלם! הפעל מחדש את FlyWeb‏ כדי לסיים את העדכון.</translation>
<translation id="2962574118577609024">‏אם בנוסף ישותפו דוחות שימוש ב-FlyWeb, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="9219132550163437762">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך FlyWeb אחר (<ph name="PROCESS_ID"/>) במחשב אחר (<ph name="HOST_NAME"/>)‏. FlyWeb נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את FlyWeb מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="5227023869666757348">‏מישהו נכנס בעבר ל-FlyWeb מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST"/>. יש ליצור משתמש חדש ל-FlyWeb כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="1671154647029930623">‏לסגור את FlyWeb בכל זאת?</translation>
<translation id="4143239505982500022">‏בוצע עדכון אבטחה מיוחד של FlyWeb. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="1347247057384060764">‏יש לך אפשרות לשנות את הבחירה בכל שלב בהגדרות של FlyWeb. גרסאות הניסיון יפעלו במקביל לשיטה הנוכחית של הצגת המודעות, אז השינויים לא יורגשו מיד.</translation>
<translation id="4259200560913816786">‏FlyWeb לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות או <ph name="BEGIN_LINK"/>לבדוק את הסיסמאות בחשבון FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">‏נעשה כאן שימוש בבדיקת האיות של חיפוש FlyWeb. הטקסט המוקלד בדפדפן נשלח אל FlyWeb. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="2991144524835127379">‏כלל נכנס עבור FlyWeb על מנת לאפשר תנועת mDNS.</translation>
<translation id="6208903184719035736">‏הפעלה מחדש לצורך עדכון &amp;FlyWeb</translation>
<translation id="2168729188561569339">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות הקיימות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות הקיימות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות הקיימות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-FlyWeb במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות הקיימות יישארו פתוחות.}}</translation>
<translation id="7174589544844983914">‏FlyWeb נמצא במצב רקע.</translation>
<translation id="7792628702371319769">‏אורחים יכולים להשתמש ב-FlyWeb בלי להשאיר דבר מאחור.</translation>
<translation id="2760069255902967585">‏הוספת החשבון שלך ל-FlyWeb</translation>
<translation id="4239638419916712076">‏אנחנו בודקים תכונות חדשות ב-FlyWeb שמאפשרות לאתרים לספק את אותה חוויית הגלישה תוך שימוש בפחות פרטים אישיים</translation>
<translation id="387444474697464273">‏אין סיסמאות שמורות. FlyWeb יכול לבדוק את הסיסמאות שלך רק אם שמרת אותן.</translation>
<translation id="520701392326482190">‏המשתמש <ph name="EXISTING_USER"/> כבר מחובר לפרופיל FlyWeb הזה. ייווצר פרופיל FlyWeb חדש בשביל <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8295539942024823191">‏כדי להחיל את השינויים שביצעת, יש להפעיל מחדש את FlyWeb</translation>
<translation id="5374328929709976901">‏כשגרסאות הניסיון פעילות, ובמקרים שבהם צורפת באופן אקראי לגרסת ניסיון פעילה ב-FlyWeb, היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-FlyWeb מחיקה של תחומי העניין שלך על בסיס מתחלף מדי חודש.</translation>
<translation id="8449603408481238073">‏הכניסה שלך מתבצעת באמצעות חשבון מנוהל שמעניק למנהל המערכת שלו שליטה על הפרופיל שלך ב-FlyWeb. הנתונים שלך ב-FlyWeb, כגון יישומים, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME"/>. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות FlyWeb, אבל לא ניתן לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE"/></translation>
<translation id="1284798564810038820">‏מתבצע עדכון של FlyWeb‏ (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">‏התרת כניסה אל FlyWeb</translation>
<translation id="5965500511473700110">‏גרסה חדשה של FlyWeb זמינה כעת.</translation>
<translation id="1827750898515917134">‏להסיר מ-‏FlyWeb‏</translation>
<translation id="5020755920249060562">‏הגדרת FlyWeb כדפדפן ברירת המחדל שלך</translation>
<translation id="3148325800171225029">‏<ph name="PAGE_TITLE"/> - FlyWeb בגרסת בטא</translation>
<translation id="5385202369020319636">‏יכול להיות ש-FlyWeb לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="5957333939864770801">‏FlyWeb זקוק לגישה למיקום שלך כדי לשתף אותו עם האתר הזה</translation>
<translation id="780999790006298623">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. אם ב-FlyWeb הוגדר תחום עניין שגוי או שאינך רוצה לראות מודעות מסוימות, יש לך אפשרות להסיר תחומי עניין.</translation>
<translation id="2183749398075655200">‏יש להמתין בזמן ש-FlyWeb מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="8996657165865563765">‏FlyWeb מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="5738298079259740925">‏פתיחה של קובצי PDF ב-FlyWeb</translation>
<translation id="9197514179291669592">‏כשההגדרה מופעלת, תתבצע יציאה גם מ-FlyWeb</translation>
<translation id="6096945112863785306">{0,plural, =0{‏יש עדכון ל-FlyWeb}=1{‏יש עדכון ל-FlyWeb}one{‏עדכון של FlyWeb זמין כבר # ימים}two{‏עדכון של FlyWeb זמין כבר # ימים}other{‏עדכון של FlyWeb זמין כבר # ימים}}</translation>
<translation id="5666891644992637849">‏יש להפעיל מחדש את FlyWeb</translation>
