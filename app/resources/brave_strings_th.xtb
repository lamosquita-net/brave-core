<translation id="1292852397592425449">ล้างข้อมูล FlyWeb ในบัญชี</translation>
<translation id="7031783851441272920">ไฟล์นี้อาจเป็นอันตราย<ph name="LINE_BREAK"/>FlyWeb ตรวจสอบการดาวน์โหลดนี้ให้คุณได้หากคุณให้รหัสผ่าน ข้อมูลเกี่ยวกับไฟล์จะส่งไปยัง Google Safe Browsing แต่เนื้อหาและรหัสผ่านของไฟล์จะยังอยู่ในอุปกรณ์ของคุณ</translation>
<translation id="6182736845697986886">การติดตั้งไม่สำเร็จเนื่องจากเกิดข้อผิดพลาดภายในเซิร์ฟเวอร์การอัปเดต</translation>
<translation id="4403968929742079769">ตรวจสอบว่าคุณลงชื่อเข้าใช้ FlyWeb ใน <ph name="TARGET_DEVICE_NAME"/> แล้วลองส่งอีกครั้ง</translation>
<translation id="8345188246355148375">ค้นหาและถามคำถามได้จากทุกที่ แม้ว่าจะย่อ FlyWeb อยู่ก็ตาม อนุญาตให้ FlyWeb ทำงานในเบื้องหลัง</translation>
<translation id="1855179706668101462">คอมพิวเตอร์เครื่องนี้ติดตั้ง FlyWeb รุ่นที่ใหม่กว่าอยู่แล้ว ถ้าซอฟต์แวร์ไม่ทำงาน โปรดถอนการติดตั้ง FlyWeb และลองอีกครั้ง</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb จะเปิดขึ้นมาใหม่ตอนนี้}=1{FlyWeb จะเปิดขึ้นมาใหม่ใน 1 วินาที}other{FlyWeb จะเปิดขึ้นมาใหม่ใน # วินาที}}</translation>
<translation id="2586408713760853791">FlyWeb ต้องการสิทธิ์เข้าถึงพื้นที่เก็บข้อมูลเพื่อดาวน์โหลดไฟล์</translation>
<translation id="1603558835003845196">ตรวจสอบ URL กับรายการเว็บไซต์ที่ไม่ปลอดภัยซึ่งจัดเก็บไว้ใน FlyWeb</translation>
<translation id="5751080530525677552">ทำให้ FlyWeb เป็นเบราว์เซอร์เริ่มต้น</translation>
<translation id="6248988683584659830">ค้นหาการตั้งค่า</translation>
<translation id="6342238100521499844">รับฟีเจอร์ความปลอดภัยที่ดีที่สุดของ FlyWeb ทุกที่ทุกเวลาด้วยแอป FlyWeb ในโทรศัพท์</translation>
<translation id="3542157007113577464">ต้องการออกจาก FlyWeb ใช่ไหม</translation>
<translation id="2166321493116256664">แท็บเหล่านี้ใช้ทรัพยากรมากเป็นพิเศษ ให้ FlyWeb ช่วยปิดใช้งานแท็บเหล่านี้เพื่อปรับปรุงประสิทธิภาพ</translation>
<translation id="3794967601634523398">ปรับแต่งโปรไฟล์ FlyWeb ของคุณ</translation>
<translation id="6475001900959697061">ตั้งชื่อโปรไฟล์ FlyWeb ของคุณ</translation>
<translation id="6356094940346377065">ส่วนขยายต้องการให้คุณลงชื่อเข้าใช้ FlyWeb</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> อาจเป็นอันตราย FlyWeb จึงบล็อกไว้</translation>
<translation id="5523868569707953059">FlyWeb ใช้กล้องของคุณอยู่</translation>
<translation id="8226838065217375546">FlyWeb กำลังดำเนินการอย่างอื่นอยู่ โปรดลองอีกครั้งในภายหลัง</translation>
<translation id="6063700568539132984">ตอนนี้การใช้ FlyWeb กับบัญชี FlyWeb ของคุณและบนคอมพิวเตอร์ที่ใช้ร่วมกันทำได้ง่ายกว่าเดิม</translation>
<translation id="5622088198573179705">เข้าถึงฟีเจอร์ที่คุณรู้จัก ชื่นชอบ และไว้วางใจได้อย่างง่ายดายด้วยการตั้ง FlyWeb เป็นเบราว์เซอร์เริ่มต้น</translation>
<translation id="4709797814274745581">ทางลัดของ FlyWeb</translation>
<translation id="6595693843242836271">FlyWeb บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์ไม่ได้มีการดาวน์โหลดกันโดยทั่วไปและอาจเป็นอันตราย</translation>
<translation id="6890209090736444656">คุณแน่ใจหรือไม่ว่าต้องการถอนการติดตั้ง FlyWeb</translation>
<translation id="6375219077595103062">เพิ่มทางลัดไปยังเครื่องมือจัดการรหัสผ่าน</translation>
<translation id="6388799252195623474">ช่วยฉันเรื่องนี้</translation>
<translation id="8407518452288816185">หากต้องการดำเนินการต่อ โปรดลงชื่อเข้าใช้ FlyWeb ด้วย <ph name="EMAIL"/> การดำเนินการดังกล่าวจะตรวจสอบว่าคุณมีนโยบายขององค์กรแล้ว</translation>
<translation id="2104550252781001709">โลโก้ FlyWeb ในหน้าจอคอมพิวเตอร์</translation>
<translation id="6636986997730784876">FlyWeb เป็นเว็บเบราว์เซอร์ที่เรียกใช้หน้าเว็บและแอปพลิเคชันด้วยความเร็วสูง มีความรวดเร็ว เสถียร และง่ายในการใช้งาน เรียกดูเว็บได้อย่างปลอดภัยมากขึ้นด้วยการป้องกันมัลแวร์และฟิชชิงที่สร้างอยู่ภายใน FlyWeb</translation>
<translation id="4359872290500912570">โปรดยืนยันว่าเป็นคุณเพื่อให้ใช้และบันทึกข้อมูล FlyWeb ในบัญชี FlyWeb ได้เสมอ</translation>
<translation id="3141715584864891679">FlyWeb ทำงานได้เร็วขึ้นและฟีเจอร์ที่ใช้ JavaScript ควรทำงานตามที่ออกแบบไว้</translation>
<translation id="6436260184216827876">การค้นหารูปภาพไม่พร้อมใช้งาน โปรดลองอีกครั้งในภายหลัง</translation>
<translation id="2139300032719313227">รีสตาร์ท Chrome OS</translation>
<translation id="7560906925528428585">FlyWeb จะโหลดหน้าเว็บที่คุณน่าจะเข้าชมเอาไว้ล่วงหน้าเพิ่มมากขึ้น เพื่อให้หน้าเหล่านั้นโหลดเร็วขึ้นเมื่อคุณเข้าชม</translation>
<translation id="5806916401157869650">ดาวน์โหลด FlyWeb บนโทรศัพท์เพื่อติดตามราคาและรับการแจ้งเตือนเมื่อราคาต่ำลงในเว็บไซต์ใดก็ตาม</translation>
<translation id="2970877059928503461">ปิด • FlyWeb ยืนยันไม่ได้ว่าส่วนขยายนี้มาจากไหน</translation>
