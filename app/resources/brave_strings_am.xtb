<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="1026101648481255140">መጫኑን ከቆመበት ቀጥል</translation>
<translation id="7099479769133613710">&amp;ChromeOSን ለማዘመን ዳግም ያስነሱት</translation>
<translation id="291426170030461697">FlyWeb ይህን ቅጥያ እንዲገመግሙ ይመክርዎታል</translation>
<translation id="1549005488226693697">አንድ ጣቢያ በገጻቸው ላይ በግል አገናኞችን ቅድሚያ ለመጫን ሲጠይቅ FlyWeb የBrave አገልጋዮችን ይጠቀማል። ይህ ማንነትዎን ቅድሚያ ከተጫነው ጣቢያ ይደብቃል ነገር ግን FlyWeb ምን ጣቢያዎች ቅድሚያ እንደሚጫኑ ያውቃል።</translation>
<translation id="1065672644894730302">አማራጮችዎ ሊነበቡ አልቻሉም።

አንዳንድ ባህሪያት ላይገኙ ይችላሉ፣ እና በአማራጮች ላይ የተደረጉ ለውጦች አይቀመጡም።</translation>
<translation id="8908267645832965492">የእርስዎ ወላጅ ለBrave «የጣቢያዎች፣ መተግበሪያዎች እና ቅጥያዎች ፈቃዶች» የሚለውን አጥፍተዋል።</translation>
<translation id="5557633153169217776">FlyWeb በአቅራቢያ ያሉ መሣሪያዎችን ለማግኘት እና ለመጠቀም የአካባቢያዊ አውታረ መረብዎ መዳረሻ ያስፈልገዋል</translation>
<translation id="6441390163669415879">አንድን የተወሰነ የBrave ባህሪ ወይም ቅጥያ ለመፈለግ የእርስዎን የተመረጠ የቁልፍ ሰሌዳ ቁልፍ በማስከተል በአድራሻ አሞሌው ውስጥ አቋራጩን ይተይቡ</translation>
<translation id="9001750423919983557">ፍለጋን በሥርዓት ትሪ ውስጥ በBrave አሳይ እና የቁልፍ ሰሌዳ አቋራጭን አብራ</translation>
<translation id="1368460307421081773">FlyWeb የእርስዎን የይለፍ ቃላት ወደ ውጭ መላክ ይፈልጋል። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="112640046208448578">ነገሮችን ወይም ቦታዎች ይለዩ እና ጽሁፍን ይቅዱ ወይም ይተርጉሙ። የምስል ፍለጋ ሲጠቀሙ የገፁ ቅጽበታዊ ገፅ ዕይታ ወደ አገልጋዩ ይላካል። <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="4556715463645168547">የእርስዎ የይለፍ ቃላት ከውሂብ ጥሰቶች እና ሌሎች የደህንነት ችግሮች ነፃ መሆናቸውን ለማረጋገጥ <ph name="BEGIN_LINK"/>በመለያ ወደ FlyWeb ይግቡ<ph name="END_LINK"/>።</translation>
<translation id="2076135703183650206">FlyWeb ምናሌው ላይ ጠቅ ያድርጉ</translation>
<translation id="1157985233335035034">የቅርብ ጊዜ ቋንቋዎች</translation>
<translation id="1184145431117212167">የእርስዎ የመስኮቶች ሥሪት ስለማይደገፍ ጭነቱ ተሰናክሏል።</translation>
<translation id="4380351562011537903">ስለBrave</translation>
<translation id="853148447909557566">በስልክዎ ላይ በBrave የዋጋ ክትትል ማንቂያዎችን ያግኙ</translation>
<translation id="1203500561924088507">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME"/>ን ከመጠቀምዎ በፊት አሳሽዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="1232234696885483911">የምስል ፍለጋን ሲከፍቱ PDFዎችን ጨምሮ የገጹ ርዕስ፣ ዩአርኤል እና ይዘት በራስ-ሰር ወደ አገልጋዩ ይላካሉ። <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">በመለያ ገብተው ሳለ በBrave ውስጥ ከBrave መለያዎ የይለፍ ቃላትዎን እና ሌሎችንም መጠቀም ይችላሉ። ይህን ለመለወጥ ወደ «FlyWeb ውስጥ የእርስዎ መለያ» ይሂዱ።</translation>
<translation id="7614508617663739435">Gemini በBrave ውስጥ በMac የምናሌ አሞሌ ውስጥ አሳይ</translation>
<translation id="832555967476614730">Gemini ውስጥ FlyWeb ውስጥ የማያ ገጹን ክፍል ለመምረጥ የቁልፍ ሰሌዳ አቋራጭ ይጠቀሙ።</translation>
<translation id="4750836834956739196">ይህ ትር ቦዝኖ ሳለ Braveን ፈጣን እንደሆነ ለማቆየት ማህደረ ትውስታ ነፃ ተደርጓል። ይህን ጣቢያ ሁልጊዜ ከመቦዘን ማግለል መምረጥ ይችላሉ።</translation>
<translation id="3190759351483708314">ፋይሉ አደገኛ ስለሆነ FlyWeb ይህን ውርድ አግዷል</translation>
<translation id="5879469261638423015">በ<ph name="USER_EMAIL"/> እንደ Gmail ወይም YouTube ወዳሉ የBrave አገልግሎቶች ሲገቡ በተመሳሳይ መለያ ወደ FlyWeb መግባት ይችላሉ</translation>
<translation id="7142135954326264349">Braveን በስልክዎ ላይ ያግኙ</translation>
<translation id="1290883685122687410">የውቅረት ስህተት፦ <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">አዲሱን የBrave መገለጫዎ ያቀናብሩት</translation>
<translation id="5252737639504553444">በGemini በBrave ውስጥ ይሞክሩ</translation>
<translation id="609743863669742325">FlyWeb የብሉቱዝ መሣሪያዎችን ለማሰስ የብሉቱዝ መዳረሻ 
ያስፈልገዋል። <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">በስልክዎ ላይ ወደ FlyWeb ይግቡ</translation>
<translation id="1330562121671411446">ቋንቋ አግኝ</translation>
<translation id="2276527911011636666">እንዲሁም ከBrave (<ph name="URL"/>) ውሂብን ይሰርዙ</translation>
<translation id="1345251407431278948">ፒን ተደርጓል! የምስል ፍለጋን እንደገና የመሣሪያ አሞሌው ላይ ካለው ከአዲሱ አዝራር መድረስ ይችላሉ</translation>
<translation id="1383876407941801731">ፍለጋ </translation>
<translation id="1045149878186896649">በመሄድ ላይ እያሉ ማሰስን ለመቀጠል የBrave መተግበሪያን ይጠቀሙ</translation>
<translation id="141901961143729572">ሀሳቦችዎን ያጋሩ</translation>
<translation id="2758515779140515865">መስኮትዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለBrave የማያ ገፅ መቅረጽን ይፍቀዱ።</translation>
<translation id="4713192356155907986">በBrave ለሙከራ ላይ እገዛ ያግኙ</translation>
<translation id="4984443629206419460">የእርስዎን የተቀመጠ መረጃ እና ሌሎችንም ከ<ph name="DEVICE"/> ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="1497802159252041924">የጭነት ስህተት፦ <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ይህ ገፅ የተጠበቀ ነው</translation>
<translation id="8962360511570172">የBrave ትር ያጋሩ</translation>
<translation id="2941487459666781243">FlyWeb ውስጥ ይግቡ</translation>
<translation id="1547469039832541117">የደመቀውን ተግባር ይጨርሳል።</translation>
<translation id="3182893868355533457">Braveን ፒን አድርግ</translation>
<translation id="852852907317361085">የBrave የደህንነት መሣሪያዎች</translation>
<translation id="481155564361715417">FlyWeb የእርስዎን የይለፍ ቃል አስተዳዳሪ ውሂብ መሰረዝ ይፈልጋል። ይህን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="2846999307505917298">በስልክዎ ላይ በBrave መተግበሪያ የBrave ምርጡን ያግኙ</translation>
<translation id="3961251277542681013">በBrave ውስጥ ቁልፍ የግላዊነት እና የደህንነት ቁጥጥሮችን ይገምግሙ</translation>
<translation id="1640672724030957280">በማውረድ ላይ...</translation>
<translation id="1665602916345474427">እንደ <ph name="USER_NAME"/>፣ <ph name="USER_EMAIL"/>፣ አባልነት በመለያ ገብተዋል። የመለያ ምናሌውን ይክፈቱ</translation>
<translation id="7625232007557474355">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በምታደርግበት ማንኛውም ጊዜ FlyWeb መጠቀም ይችላሉ። እንዲሁም በተግባር አሞሌዎ ላይ ይሰካል።</translation>
<translation id="1709772298389099340">ለ<ph name="BROWSER_NAME"/> የላቁ ልዩ መብቶች ያቀርባል።</translation>
<translation id="5695205873161614119">FlyWeb በቅርቡ የአሰሳ ውሂብን ይሰርዛል</translation>
<translation id="8939535770474283898">FlyWeb አሰሳዎችን ወደ ኤችቲቲፒኤስ ለማሻሻል ይሞክራል</translation>
<translation id="2581127533455294937">የBrave ውሂብ ጸድቷል</translation>
<translation id="7385422968404728039">FlyWeb በ<ph name="REMAINING_TIME"/> ውስጥ እንደገና ይጀምራል</translation>
<translation id="6903827847227122616">ኤችቲቲፒኤስ በማይኖርበት ጊዜ FlyWeb እርስዎን ሳያስጠነቅቅ ደህንነቱ ያልተጠበቀ ግንኙነት ይጠቀማል</translation>
<translation id="307170399141486420">FlyWeb ጀርባ ላይ ይሂድ</translation>
<translation id="5006568136491721884">ለፈጣን መዳረሻ Braveን በተግባር አሞሌዎ ላይ ለመሰካት በWindows ማሳወቂያ ውስጥ <ph name="BEGIN_BOLD"/>አዎ<ph name="END_BOLD"/> ላይ ጠቅ ያድርጉ</translation>
<translation id="2473319786107120819">Braveን ዳግም ጫን</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> በመሞከር ላይ ነው</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ። እንዲሁም ከ<ph name="DEVICE"/> ቅጥያዎችዎን እና ሌሎችንም ያገኛሉ።</translation>
<translation id="3547283483106013256">በሚቀጥለው ጊዜ Braveን በእርስዎ <ph name="DEVICE_TYPE"/> ላይ ሲከፍቱ FlyWeb የይለፍ ቃል አስተዳዳሪን ለመጠቀም ጥያቄ ያያሉ።</translation>
<translation id="1838374766361614909">ፍለጋን ያፅዱ</translation>
<translation id="3403116471618205223">በBrave መለያዎ ውስጥ እያስቀመጡት የአሰሳ ውሂብን ከዚህ መሣሪያ ብቻ ለመሰረዝ፣ <ph name="BEGIN_LINK"/>ከBrave ዘግተው ይውጡ<ph name="END_LINK"/>።</translation>
<translation id="1909454687815628855">በመሄድ ላይ አዲስ የትር ቡድኖችን ለመክፈት ወይም ለመፍጠር Braveን በስልክዎ ላይ ያውርዱ።</translation>
<translation id="3285741355512747610">በመለያ የገቡትን የBrave መለያዎችዎን ማቀናበር ይችላሉ። የእርስዎ የBrave መለያዎች ለBrave አሳሽ፣ ለPlay መደብር፣ ለGmail እና ለሌሎችም ያገለግላሉ። እንደ የቤተሰብ አባል ለሆነ ለሌላ ሰው መለያ ማከል ከፈለጉ በምትኩ በ<ph name="DEVICE_TYPE"/> ላይ አዲስ ሰው ያክሉ። <ph name="LINK_BEGIN"/>የበለጠ ለመረዳት<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">በምስል ፍለጋ ፈልግ</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ። እንዲሁም ከ<ph name="DEVICE"/> የእርስዎን እልባቶች እና ሌሎችንም ያገኛሉ።</translation>
<translation id="1880677175115548835">ጽሁፍ ይምረጡ</translation>
<translation id="4824940465467423308">በሚተዳደር መለያ እየገቡ ነው፣ እና አስተዳዳሪው በእርስዎ FlyWeb መገለጫ ላይ ቁጥጥር እየሰጡት ነው። እንደ እርስዎ መተግበሪያዎች፣ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎች ቅንብሮች ያሉ የእርስዎ FlyWeb ውሂብ እስከ መጨረሻው ከ<ph name="USER_NAME"/> ጋር የተያያዙ ይሆናሉ። ይህን ውሂብ በBrave የመለያዎች Dashboard አማካኝነት ሊሰርዙት ይችላሉ፣ ነገር ግን ይህን ውሂብ ከሌላ መለያ ጋር ሊያጎዳኙት አይችሉም። ነባሩ የእርስዎ FlyWeb ውሂብ ለይተው ለማስቀመጥም አዲስ መገለጫ እንደ አማራጭ መፍጠር ይችላሉ። <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb የዳራ እንቅስቃሴን እና እንደ ለስላሳ ሽብለላ እና የቪድዮ ፍሬም ፍጥነቶች ያሉ ምስላዊ ተጽዕኖዎችን በመገደብ የባትሪ ኃይልን ይቆጥባል። <ph name="BEGIN_LINK"/>ስለ ኃይል ቆጣቢ የበለጠ ለመረዳት<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">የBrave ማዘመኛ አገልግሎት</translation>
<translation id="7390382558747224642">ይህንን በማጥፋት፣ እንደ Gmail ወደ መሰሉ የBrave ጣቢያዎች ወደ FlyWeb በመለያ ሳይገቡ መግባት ይችላሉ</translation>
<translation id="5714085538350759767">FlyWeb መልስ አይሰጥም። አሁን ዳግም ይጀምር?</translation>
<translation id="5866699689358760578">ድርጅትዎ፣ <ph name="MANAGER"/> ወደ FlyWeb እንዲገቡ ይጠይቃል</translation>
<translation id="4035053306113201399">ChromeOS ዝማኔውን ለመተግበር ዳግም መጀመር አለበት።</translation>
<translation id="3750729306035486751">የፋይል ዓይነቱ በተለምዶ ስላማይወርድ እና አደገኛ ሊሆን ስለሚችል FlyWeb ይህን ውርድ አግዷል</translation>
<translation id="1953553007165777902">በማውረድ ላይ... <ph name="MINUTE"/> ደቂቃ(ዎች) ይቀራል(ሉ)</translation>
<translation id="6956650624767954726">FlyWeb ነባሪ አሳሹን ማወቅ ወይም ማቀናበር አልቻለም</translation>
<translation id="197326043290947695">በምስል ፍለጋ ይበልጥ በብልህነት ያስሱ</translation>
<translation id="130679046523922050">FlyWeb ለምን አንዳንድ ፋይሎችን እንደሚያግድ ይወቁ፣ በአዲስ ትር ውስጥ ይከፍታል</translation>
<translation id="8243822903505210769">የእርስዎን FlyWeb ሶፍትዌር ወቅታዊ አድርጎ ያቆያል። ይህ አገልግሎት ከተሰናከለ ወይም ከቆመ የBrave ሶፍትዌርዎ እንደተዘመነ አይቆይም፣ ይህ ማለት ሊከሰቱ የሚችሉ የደህንነት ተጋላጭነቶች ሊስተካከሉ አይችሉም እና ባህሪያት ላይሠሩ ይችላሉ። ይህ አገልግሎት እሱን የሚጠቀም የBrave ሶፍትዌር በማይኖርበት ጊዜ ራሱን ያራግፋል።</translation>
<translation id="6495079989036864983">ይሄ 1 ንጥል ከዚህ መሣሪያ ይሰርዛል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL"/> ሆነው ወደ FlyWeb ይግቡ።</translation>
<translation id="2018879682492276940">መጫን አልተሳካም። እባክዎ እንደገና ይሞክሩ።</translation>
<translation id="2039417478970545937">ቅንብሮች።</translation>
<translation id="8544477465831682343">በBrave አገልግሎቶች ውስጥ ተጨማሪ ግላዊነት የተላበሱ ተሞክሮዎችን ለማግኘት የBrave ታሪክን ለማካተት እና ላለማካተት ይምረጡ</translation>
<translation id="328650761750741315">እርስዎ ጠንካራ የይለፍ ቃላትን እንዲፈጥሩ፣ እንዲያስቀምጡ እና በራስ-ሰር እንዲሞሉ ለማገዝ FlyWeb ውስጥ የተገነባ። ለቀላል መዳረሻ አቋራጩን ያክሉ።</translation>
<translation id="2407746489237278840">ለBrave አዲስ መልክ ለመስጠት በአዲስ ትር ገጽ ላይ ያለውን FlyWeb አብጅ የሚለውን አዝራር ጠቅ ያድርጉ</translation>
<translation id="8924891216494775926">ፋይሉ አታላይ ስለሆነ እና በመሣሪያዎ ላይ ያልተጠበቁ ለውጦችን ሊያደርግ ስለሚችል FlyWeb ይህን ውርድ አግዷል</translation>
<translation id="5728214838078602184">FlyWeb iOS በሚከፍቱበት ቀጣዩ ጊዜ <ph name="FEATURE_NAME"/>ን ለመሞከር ጥያቄ ያያሉ።</translation>
<translation id="2058207584484841616">FlyWeb መለያ ውስጥ ያስቀመጧቸው የይለፍ ቃላትዎ እና ሌላ FlyWeb ውሂብ ከዚህ መሣሪያ ይወገዳሉ። እንደገና FlyWeb ውስጥ እነሱን ለመጠቀም መልሰው በመለያ ይግቡ።</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{ድርጅትዎ FlyWeb ለ1 ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ-ሰር የአሰሳ ውሂብን ይሰርዛል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል። የእርስዎ ትሮች ክፍት ሆነው ይቆያሉ።}one{ድርጅትዎ FlyWeb ለ# ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ-ሰር የአሰሳ ውሂብን ይሰርዛል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል። የእርስዎ ትሮች ክፍት ሆነው ይቆያሉ።}other{ድርጅትዎ FlyWeb ለ# ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር በራስ-ሰር የአሰሳ ውሂብን ይሰርዛል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል። የእርስዎ ትሮች ክፍት ሆነው ይቆያሉ።}}</translation>
<translation id="2125838419757773031">ለመፈለግ የማያ ገጽ ክልል ይምረጡ</translation>
<translation id="2126108037660393668">የወረደው ፋይል ማረጋገጫን አላለፈም።</translation>
<translation id="2135919691573380097">ይህን ጣቢያ ሪፖርት ያድርጉ</translation>
<translation id="2137162749895930932">የመተርጎሚያ ማያ ገፅን ዝጋ</translation>
<translation id="2147218225094845757">የጎን ፓነልን ደብቅ</translation>
<translation id="4474394796469499134">ጣቢያው ደህንነቱ የተጠበቀ ግንኙነት እየተጠቀመ ስላልሆነ እና ፋይሉ ተነካክቶ ሊሆን ስለሚችል FlyWeb ይህን ውርድ አግዷል</translation>
<translation id="2170098639895543546">በገጽ ላይ ማንኛውንም ነገር ይምረጡ</translation>
<translation id="6765231735885996239">Braveን አብጅ</translation>
<translation id="2174917724755363426">መጫኑ አልተጠናቀቀም። እርግጠኛ ነዎት መሰረዝ ይፈልጋሉ?</translation>
<translation id="2937508664417729967">FlyWeb - በአውታረ መረብ ወደ መለያ መግባት - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">የዝማኔ ፍተሻ ስህተት፦ <ph name="UPDATE_CHECK_ERROR"/>።</translation>
<translation id="1475706760978948356">መለያን ከBrave አስወግድ</translation>
<translation id="744837314710861405">በመሄድ ላይ ሳሉ ምርጥ የሸመታ መሣሪያዎችን ለመውሰድ የBrave መተግበሪያን ይጠቀሙ</translation>
<translation id="2745381939758295588">FlyWeb ለiOS ላይ በተሻሻለ የደህንነት አሰሳ በመሄድ ላይ ደህንነትዎ እንደተጠበቀ ይቆዩ</translation>
<translation id="6707114110652917144">አደገኛ ጣቢያ FlyWeb ማሳወቂያዎችን አስወግዷል።</translation>
<translation id="2236949375853147973">የእኔ እንቅስቃሴ</translation>
<translation id="4646732243247482236">የእርስዎን አድራሻዎች እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ FlyWeb በመለያ ይግቡ። በመለያ ከገቡ በኋላ ይህ አድራሻ FlyWeb መለያዎ ውስጥ ይቀመጣል።</translation>
<translation id="2726680594710751908">ኮምፒውተር የሚጋሩ ከሆኑ ጓደኛዎች እና ቤተሰብ ተለይተው ሊያስሱ እና Braveን በሚፈልጉበት መንገድ ማዋቀር ይችላሉ።</translation>
<translation id="4086571337340463916">FlyWeb ውስጥ ያሉ ክህሎቶች</translation>
<translation id="2283803047247799269">ይህን ትር በምስል ፍለጋ ይፈልጉ</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb አሳሽዎን እያዘገየ ያለውን ትር ባለበት እንዲያቆሙ ይመክራል}one{FlyWeb አሳሽዎን እያዘገየ ያለውን ትር ባለበት እንዲያቆሙ ይመክራል}other{FlyWeb አሳሽዎን እያዘገዩ ያሉትን ትሮች ባሉበት እንዲያቆሙ ይመክራል}}</translation>
<translation id="2307973900865360088">መትከያ ውስጥ አቆይ</translation>
<translation id="5067150284614317159">በBrave ላይ በተከማቹ ደህንነታቸው ያልተጠበቁ ጣቢያዎች ዝርዝር ጋር ዩአርኤሎችን ይፈትሻል። አንድ ጣቢያ የእርስዎን የይለፍ ቃል ለመስረቅ ከሞከረ ወይም ጎጂ ፋይል ሲያወርዱ FlyWeb እንዲሁም የገጽ ይዘት ቢትስንም ጨምሮ ዩአርኤሎችን ወደ የጥንቃቄ አሰሳ ሊልክ ይችላል።</translation>
<translation id="2356070529366658676">ጠይቅ</translation>
<translation id="2359808026110333948">ቀጥል</translation>
<translation id="7339360994527471629">ቅጥያው «<ph name="EXTENSION_NAME"/>» ወደ በመለያ FlyWeb እንዲገቡ ይፈልጋል</translation>
<translation id="8788732221355188962">FlyWeb ለመተግበሪያዎች በዳራ ውስጥ እንዳያሄድ አሰናክል</translation>
<translation id="4126251160852694747">እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ይህን ቅጥያ ለመጠቀም በመለያ ወደ FlyWeb ይግቡ።</translation>
<translation id="8418845734693287262">የመለያ መግቢያ ዝርዝሮችዎ ጊዜ ያለፈባቸው ስለሆኑ ChromeOS ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{1 የኤችአይዲ መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰበት ነበር}=1{1 የኤችአይዲ መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰበት ነው}one{# የኤችአይዲ መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰበት ነው}other{# የኤችአይዲ መሣሪያዎች በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}}</translation>
<translation id="1364879203203742966">FlyWeb ለዚህ ጣቢያ የካሜራ እና የማይክሮፎን ፈቃዶች ያስፈልጉታል</translation>
<translation id="2403703063067034158">የማስነሻ ስህተት፦ ሌላ የማዋቀር አብነት አሁን እያሄደ ነው፣ እባክዎ በኋላ እንደገና ይሞክሩ።</translation>
<translation id="656987653252575654">ከማንኛውም መተግበሪያ ላይ አገናኞችን በBrave ውስጥ ይክፈቱ እና አሳሹን በተግባር አሞሌዎ ላይ ተደራሽ አድርገው ያቆዩት</translation>
<translation id="157662717324308283">ፈጣን አጠቃላይ ዕይታ ለማግኘት እና የክትትል ጥያቄዎችን ለመጠየቅ ይህን ሰነድ ለGemini በBrave ውስጥ ለማጋራት አጠቃላይ አድርግ የሚለውን አዝራር ጠቅ ያድርጉ</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>ከBrave በመጡ መሣሪያዎች <ph name="END_LINK"/> ደህንነቱ በተጠበቀ መንገድ ማሰስ እና በቁጥጥር ውስጥ ሆነው መቆየት ይችላሉ</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የእርስዎን የይለፍ ቃላት እና ሌሎችንም ያገኛሉ።</translation>
<translation id="2451727308784734061">ወደ የይለፍ ቃል አስተዳዳሪ በፍጥነት ለመድረስ የእርስዎን አቋራጭ ይጠቀሙ። አቋራጭዎን ወደ ኮምፒውተርዎ መነሻ ማያ ገጽ ወይም የመተግበሪያ አስጀማሪ መውሰድ ይችላሉ።</translation>
<translation id="3224379053610845181">FlyWeb በቅርቡ ይዘጋል</translation>
<translation id="3840682988105604367">በBrave ውስጥ</translation>
<translation id="2485422356828889247">አራግፍ</translation>
<translation id="2513154137948333830">ዳግም ማስነሳት ያስፈልጋል፦ <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">በምስል ፍለጋ ጽሁፍ ይምረጡ</translation>
<translation id="6823116595279840454">FlyWeb ነባር የይለፍ ቃላትን ለመተካት እየሞከረ ነው። ይህን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="2691552788029831386">FlyWeb ፋይሎችን ለማውረድ የማከማቻ መዳረሻ ያስፈልገዋል</translation>
<translation id="2275866327478859777">FlyWeb አጋዥ</translation>
<translation id="2575822587468774919">በምስል ፍለጋ ለመፈለግ ማንኛውንም ነገር ይምረጡ</translation>
<translation id="683641781063074351">የይለፍ ቃላትዎን እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="1659167470250249643">Braveን ለማውረድ እና ወደ FlyWeb መለያዎ ለመግባት QR ኮዱን በስልክዎ ይቃኙ።</translation>
<translation id="5353172248151202719">በBrave ለመፈለግ።</translation>
<translation id="3231856291920394348">Braveን መጠቀምዎን ይቀጥሉ</translation>
<translation id="259935314519650377">የወረደውን ጫኝ መሸጎጥ አልተሳካም። ስህተት፦ <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">ስርዓት</translation>
<translation id="7683745685556117660">ድርጅትዎ እንደ የእርስዎ እልባቶች፣ ታሪክ እና የይለፍ ቃሎች ያለ የአሰሳ ውሂብን ማየት እና ማስተዳደር ይችላል። በሌሎች FlyWeb መገለጫዎች ውስጥ የአሰሳ ውሂብን ማየት አይችልም</translation>
<translation id="5862783156828836752">በእርስዎ መለያ <ph name="ACCOUNT_EMAIL"/> ውስጥ FlyWeb ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="4450675160413947126">Braveን ጀምር</translation>
<translation id="3827993926722004004">በጭነት ጊዜ የስርዓተ ክወና ስህተት ተፈጥሯል። እባክዎ Braveን እንደገና ያውርዱት።</translation>
<translation id="333184635927514678">መሣሪያ የሚያጋሩ ከሆኑ ጓደኛዎች እና ቤተሰብ ተለይተው ሊያስሱ እና Braveን በሚፈልጉበት መንገድ ማዋቀር ይችላሉ</translation>
<translation id="3917488635054382918">FlyWeb አንሶ ሳለ እንኳን በመላው መሣሪያዎ ላይ Gemini በBrave ውስጥ ለመጠቀም ቀላል መዳረሻ።</translation>
<translation id="1257705702166647105">የBrave ትር</translation>
<translation id="2796283369875688710">ለተጨማሪ ደህንነት ሲባል FlyWeb ውሂብዎን ያመሰጥረዋል።</translation>
<translation id="1118215875395945816">የBrave መለያዎን ከBrave ለማስወገድ ዘግተው ይውጡ</translation>
<translation id="3320675843036708646">የእርስዎን የይለፍ ቃላት፣ ዕልባቶች እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="2738871930057338499">ከበይነመረብ ጋር መገናኘት አልተቻለም። ኤችቲቲፒኤስ 403 ተከልክሏል። እባክዎ ተኪ ውቅረትዎን ይፈትሹ።</translation>
<translation id="2753623023919742414">ለመፈለግ ጠቅ ያድርጉ</translation>
<translation id="8027563534376000179">Braveን እንደ ነባሪ ፒዲኤፍ መመልከቻዎ ያቀናብሩ</translation>
<translation id="7907238427168022751">ይህ ቅጥያ ተንኮል አዘል ዌርን ይዟል እና ደህንነቱ የተጠበቀ አይደለም። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከBrave ያስወግዱት።</translation>
<translation id="2799223571221894425">ዳግም አስጀምር</translation>
<translation id="1489590198317876070">የእርስዎ FlyWeb</translation>
<translation id="2816462166102338036">ይህን ቪድዮ በምስል ፍለጋ ይፈልጉ</translation>
<translation id="6850011743146651977">በካሜራዎ ምርቶችን ያግኙ፣ የዋጋ ቅነሳዎችን ይከታተሉ እና በiOS ላይ በBrave በመሄድ ላይ ሳሉ ሌሎችንም ያድርጉ።</translation>
<translation id="2841525013647267359">ተርጉም ከ</translation>
<translation id="2846251086934905009">የጭነት ስህተት፦ ጫኚው አልተጠናቀቀም። ጭነቱ ተቋርጧል።</translation>
<translation id="1339341044496643931">ከBrave አስወግድ...</translation>
<translation id="4922993584046885552">በBrave ላይ ደህንነትዎን ይጠብቃል እና በመለያ በገቡባቸው ሌሎች የBrave መተግበሪያዎች ላይ ደህንነትዎን ለማሻሻል ሥራ ላይ ሊውል ይችላል።</translation>
<translation id="2885378588091291677">ተግባር መሪ</translation>
<translation id="3806033752149316261">ስለ &amp;FlyWeb</translation>
<translation id="2915996080311180594">በኋላ ዳግም አስነሳ</translation>
<translation id="3497031519171753772">የእርስዎ ውሂብ በእርስዎ የይለፍ ሐረግ የተመሰጠረ ነው። የBrave ውሂብን በBrave መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="2945997411976714835">የጭነት ስህተት፦ የጫኙ ሂደት መጀመር አልተሳካም።</translation>
<translation id="1784605133570901105">የተቀመጡ የይለፍ ቃላት ለBrave በiOS ላይ በመጠቀም ወደ ጣቢያዎች ይበልጥ በፍጥነት ይግቡ</translation>
<translation id="5383705372991100927">የእርስዎ ድርጅቶች Braveን ያስተዳድራሉ</translation>
<translation id="1661079783259785361">FlyWeb የተዘመነ ነው</translation>
<translation id="5447533789927384736">አንድ ጣቢያ የእርስዎን የይለፍ ቃል ለመስረቅ ከሞከረ ወይም ጎጂ ፋይል ሲያወርዱ FlyWeb እንዲሁም የገጽ ይዘት ቢትስንም ጨምሮ ዩአርኤሎችን ወደ የጥንቃቄ አሰሳ ሊልክ ይችላል</translation>
<translation id="3208925917545144893">በወላጆችዎ ምርጫዎች ደህንነትዎ የበለጠ ተጠብቆ ለመቆየት ወደ FlyWeb በመለያ ይግቡ</translation>
<translation id="3003694935412297923">ሁሉም ተግባሮች</translation>
<translation id="1216763100505470452">{count,plural, =1{የተወሰነ ውሂብ በBrave መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት FlyWeb እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ (1 ንጥል) ይሰረዛል።}one{የተወሰነ ውሂብ በBrave መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት FlyWeb እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥል) ይሰረዛል።}other{የተወሰነ ውሂብ በBrave መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት FlyWeb እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥሎች) ይሰረዛል።}}</translation>
<translation id="8404327407921790238"><ph name="URL"/>ን በBrave ውስጥ በአዲስ ትር ይክፈቱ።</translation>
<translation id="5184501306555415561">እንደ ክህሎቶች ያሉ የሰው ሠራሽ አስተውሎት ፈጠራዎች ወደ FlyWeb መለያዎ ይቀመጣሉ እና ከBrave ሥምረት በተለየ መልኩ ይተዳደራሉ</translation>
<translation id="4409390320695765203">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን ቅጥያዎች እና ሌሎችንም ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="8841609317523323027">ወደ FlyWeb በማከል ላይ...</translation>
<translation id="3038232873781883849">ለመጫን በመጠበቅ ላይ...</translation>
<translation id="3045032126857188731">የተተረጎመው ቋንቋ፦ <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">የግብረመልስ መገናኛን ይዝጉ</translation>
<translation id="2666189940580882376"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ። እንዲሁም ከ<ph name="DEVICE"/> የንባብ ዝርዝርዎን እና ሌሎችንም ያገኛሉ።</translation>
<translation id="4451837224464070850">ሌሎች የBrave መገለጫዎች</translation>
<translation id="4351369660845291597">ቅጥያዎች Braveን እንዲያበጁ የሚያስችሉዎት ተጨማሪዎች ናቸው። ተደራጅቶ ከመቆየት ጀምሮ የዕለት ተዕለት ተግባሮችን እስከማቃለል ድረስ ቅጥያዎች Braveን የራስዎ እንዲያደርጉ ያግዙዎታል።</translation>
<translation id="7859502023458300952">የብልሽት ሪፖርቶችን እና <ph name="UMA_LINK"/> ወደ FlyWeb በመላክ Braveን የተሻለ ለማድረግ እገዛ ያድርጉ</translation>
<translation id="1125501479713660011">የBrave ደኅንነትን በመሄድ ላይ ለማድረግ የBrave መተግበሪያን ይጠቀሙ</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{1 የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነበር}=1{1 የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}one{# የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}other{# የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}}</translation>
<translation id="6017373390117959211">የእርስዎን የንባብ ዝርዝር እና ሌሎችንም ከ<ph name="DEVICE"/> ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="7898392424469957829">FlyWeb ታሪክ</translation>
<translation id="1407857531570256859">ጫኚው መዝገቡን መበተን አልቻለም። እባክዎ Braveን እንደገና ያውርዱት።</translation>
<translation id="310459126943037700">ተግባር(ራት)ን ማብቃት አልተሳካም።</translation>
<translation id="3104828284009500087">በገጽ ላይ ማንኛውንም ነገር ይፈልጉ</translation>
<translation id="4706932464498663870">የይለፍ ቃልዎን፣ ዕልባቶችዎን እና ታሪክዎን በመላው መሣሪያዎችዎ ላይ በትክክል ሠምረው እንዲቆዩ ያድርጉ። ነባሪ አሳሽዎን ወደ FlyWeb በማዘመን በቀላሉ የሚያውቋቸውን እና የሚወዷቸውን ባህሪያት ይድረሱ።</translation>
<translation id="1309738977648134943">FlyWeb ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="3130333203120345554">አዲስ ፍለጋ</translation>
<translation id="3137969841538672700">ለመፈለግ ይጎትቱ</translation>
<translation id="2251813826843049011">ይህ ትር ተጨማሪ ንብረቶችን እየተጠቀመ ነው። አፈጻጸምዎን ለማሻሻል FlyWeb እንዲያቦዝነው ይፍቀዱ።</translation>
<translation id="2664701271733223256">ማያ ገፅዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለBrave የማያ ገፅ መቅረጽን ይፍቀዱ</translation>
<translation id="6274649779206195384">Braveን ዳግም አስጀምር</translation>
<translation id="3161522574479303604">ሁሉም ቋንቋዎች</translation>
<translation id="6773570808762718524">አዲሱን የBrave መገለጫዎን ያብጁ</translation>
<translation id="8965010907836433875">ትሮችን ሳይቀይሩ ከሰው ሠራሽ አስተውሎት ሁነታ ጋር መወያየት መቀጠል ይችላሉ። ለመጀመር ወደ FlyWeb ይግቡ። እንዲሁም የይለፍ ቃላትዎን እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ያገኛሉ።</translation>
<translation id="5958835776851191812">የBrave መለያዎን ከBrave ለማስወገድ በቅንብሮች ገጽ ውስጥ ከBrave ዘግተው ይውጡ</translation>
<translation id="4217346567895356023">በኋላ ላይ FlyWeb ለእርስዎ ቅጾችን በራስ-ለመሙላት የተቀመጠ መረጃ መጠቅም እንደሚፈልጉ ይጠይቃል</translation>
<translation id="5449297306961970452">FlyWeb የውሂብ አቃፊው ላይ ማንበብ እና መጻፍ አይችልም፦

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">በiOS ላይ ከBrave ጋር ተወዳጅ የBrave ሰው ሠራሽ አስተውሎት መሣሪያዎችዎን ይዘው ይሂዱ።</translation>
<translation id="8090118570458552025">የእርስዎን ቅጥያዎች እና ሌሎችንም ከ<ph name="DEVICE"/> ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="3286538390144397061">አሁን ዳግም አስጀምር</translation>
<translation id="3900612994249740104">የBrave ኤ ፒ አይ ቁልፎች ይጎድላሉ። አንዳንድ የBrave ተግባራት ይሰናከላሉ።</translation>
<translation id="6824575001009586492">FlyWeb ሲዘጋ የጀርባ መተግበሪያዎች ማሂዱን ይቀጥሉ</translation>
<translation id="2595215790271940091">FlyWeb ደህንነቱ ያልተጠበቀ ግንኙነት በመጠቀም ማንኛውንም ጣቢያ ከመጫንዎ በፊት ያስጠነቅቀዎታል</translation>
<translation id="3701353923785984059">ከBrave መለያዎ በስተቀር በBrave ውስጥ ገብተው ከሆነ፣ ሁሉንም የBrave መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ። ጣቢያዎች እንዲያስታውሱዎ ለማድረግ <ph name="SETTINGS_LINK"/>።</translation>
<translation id="3352986031709923790">የፍለጋው አካባቢ ከላይ በስተቀኝ ጥግ፦ ቀኝ <ph name="RIGHT"/>%፣ ከላይ <ph name="TOP"/>%</translation>
<translation id="8629055140319079166">በመለያዎ ውስጥ ያለው የBrave ውሂብ</translation>
<translation id="1943161457314845496">በስልክዎ ላይ የይለፍ ቃላትዎን በBrave ይጠቀሙ</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">ወደ ነባር የBrave መገለጫ ይቀየር?</translation>
<translation id="3412460710772753638">በዚህ መሣሪያ ላይ በይለፍ ቃል አስተዳዳሪ ውስጥ</translation>
<translation id="1568435374218487057">የእርስዎን ዕልባቶች እና ሌሎችንም ከ<ph name="DEVICE"/> ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="3438772217992559640">ይህን ትር በምስል ፍለጋ ፈልግ</translation>
<translation id="6301354573631022693">በስልክዎ ላይ በተሻሻለ የደህንነት አሰሳን በBrave ያራዝሙ</translation>
<translation id="7625477329092296018">Braveን የእርስዎ በማድረግ ላይ...</translation>
<translation id="956833467923764542">ይሄ <ph name="ITEMS_COUNT"/> ንጥሎችን ከዚህ መሣሪያ ይሰርዛል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL"/> ሆነው ወደ FlyWeb ይግቡ።</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> በBrave መገለጫዎች መካከል መቀያየር ይችላል</translation>
<translation id="6724485219247982027">እባክዎ ሁሉንም የBrave መስኮቶችን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="5048962017649434283">መስኮትዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለBrave የማያ ገፅ መቅረጽን ይፍቀዱ</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/> አስቀድመው ገብተዋል።  አሰሳዎን ለያይተው ለመጠቀም በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS"/> ሆነው ወደ FlyWeb ይግቡ።</translation>
<translation id="408747932595284596">FlyWeb አሳሽን በተንቀሳቃሽ መሣሪያዎች ላይ ለማውረድ QR ኮድ</translation>
<translation id="1413410454753055427">አስታዋሽ፦ የBrave ምርጥ የደኅንነት ባህሪያት በኪስዎ ውስጥ</translation>
<translation id="7831730508158736496">ማያ ገፅዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለBrave የማያ ገፅ መቅረጽን ይፍቀዱ።</translation>
<translation id="9006158231572141726">የላቀ ጥበቃ FlyWeb ለማያውቃቸው ጣቢያዎች የጃቫስክሪፕት ማትባትን ያጠፋል</translation>
<translation id="3597003331831379823">በላቁ ልዩ መብቶች ማዋቀርን ማስሄድ አልተሳካም። <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">FlyWeb ውስጥ ይግቡ</translation>
<translation id="6970052268542136081">ይህ ሰው የአሰሳ ውሂብ ከዚህ መሣሪያ ይሰረዛል። ውሂቡን መልሶ ለማግኘት እንደ <ph name="USER_EMAIL"/> ሆነው ወደ FlyWeb ይግቡ።</translation>
<translation id="3667616615096815454">መጫን አልተቻለም፣ አገልጋዩ መተግበሪያውን አያውቀውም።</translation>
<translation id="2438845157914027912">በBrave መለያዎ ውስጥ ያሉትን ሁሉንም የBrave ውሂብ ለማመስጠር <ph name="BEGIN_LINK"/>የራስዎን የይለፍ ሐረግ<ph name="END_LINK"/> ይጠቀሙ። የGoogle Pay የመክፈያ ዘዴዎች እና አድራሻዎች አይመሰጠሩም። የBrave የአሰሳ ታሪክ አይሰምርም።</translation>
<translation id="6611602069520888180">አገናኙን በBrave አዲስ &amp;ትር ውስጥ ክፈት</translation>
<translation id="2591356225047803326">Braveን እና ሌሎች የBrave አገልግሎቶችን ግላዊነት ለማላበስ እና ለሌሎች ዓላማዎች ያገናኟቸው</translation>
<translation id="3729187154190517324">«ትር እና ሌሎችም አክል» የሚለውን አዝራር በመጠቀም ብዙ ትሮችን፣ ፋይሎችን እና መሣሪያዎችን በማከል ፍለጋዎን ያጥልቁ።</translation>
<translation id="1771882170639856394">የBrave መገለጫዎችን ያስተዳድሩ</translation>
<translation id="3782148374606932577">ለምን FlyWeb የተወሰኑ ውርዶችን እንዳገደ ይወቁ</translation>
<translation id="4640643918757362950">ማንኛውም ነገር ግምገማ ካስፈለገው FlyWeb ያሳውቅዎታል</translation>
<translation id="2179738813053854729">እርስዎ የመጎብኘት ዕድልዎ ከፍተኛ የሆኑባቸው ገፆች ሲጎበኟቸው ይበልጥ በፍጥነት እንዲጫኑ FlyWeb በቅድሚያ ይጭናቸዋል</translation>
<translation id="3810973564298564668">አደራጅ</translation>
<translation id="5026502787439628947">የተቀመጡ የይለፍ ቃላትዎን ለመጠቀም፣ QR ኮዱን ይከተሉ፣ FlyWeb ለiOS ያውርዱ እና ወደ FlyWeb መለያዎ ይግቡ</translation>
<translation id="3846683726093018685">**አጠቃልል፦** በአንድ ዓረፍተ ነገር ውስጥ ከ30 ባነሱ ቃላት የይዘቱን ዋና ርዕሰ ጉዳይ እና ዓላማ በቅጽበታዊ ገጽ እይታ ውስጥ ግለጽ።

          **ጥያቄዎችን ጠቁም፦** ቅጽበታዊ ገጽ እይታውን በተሻለ ለመረዳት ተጠቃሚው ሊጠይቃቸው የሚችላቸው 3-5 ሀሳብ አመንጪ ጥያቄዎች ነጥበ ምልክት ዝርዝርን አመንጭ። እነዚህ ጥያቄዎች በተለይ ስለ ምስላዊ ነገር፣ ስለ ንድፉ ወይም ስለ አቀማመጡ የሚመለከት ቢያንስ አንዱን ማካተት አለባቸው።</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="2980328991301740921">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን ዕልባቶች እና ሌሎችንም ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="3885770153807205175">ቋንቋ መራጭ</translation>
<translation id="5175060854726708547">Braveን ያብጁ እና ይቆጣጠሩ። የሆነ ነገር ትኩረትዎ ያስፈልገዋል - ለዝርዝሮች ጠቅ ያድርጉ።</translation>
<translation id="606156353708638647">Braveን ለመክፈት እና ማሰስ ለመጀመር ስምዎን ጠቅ ያድርጉት።</translation>
<translation id="3892148308691398805">ጽሁፍ ቅዳ</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> አስቀድመው ወደዚህ የBrave መገለጫ ገብተዋል። አሰሳዎን የተለየ እንደሆነ ለማቆየት FlyWeb የራስዎን መገለጫ ለእርስዎ መፍጠር ይችላል።</translation>
<translation id="3941890832296813527">የጭነት ስህተት፦ የጫኙ የፋይል ስም ልክ ያልሆነ ወይም የማይደገፍ ነው።</translation>
<translation id="8536259619256229278">FlyWeb የይለፍ ቃላትን ለመቅዳት እየሞከረ ነው። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="7965008434896274911">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን የተቀመጠ መረጃ እና ሌሎችንም ለማግኘት ወደ FlyWeb ይግቡ</translation>
<translation id="4540773594514226705">የእርስዎ የይለፍ ቃላቶች፣ የመክፈያ ዘዴዎች እና በBrave መለያዎ ውስጥ ያስቀመጧቸው አድራሻዎች ከዚህ መሣሪያ ይወገዳሉ። እንደገና FlyWeb ውስጥ እነሱን ለመጠቀም መልሰው በመለያ ይግቡ።</translation>
<translation id="395904275706073188">የተጠብቁ ገፆች ሊነበቡ አይችሉም። የተለተ ገፅ ይሞክሩ።</translation>
<translation id="3849784651193576458">FlyWeb እንዴት ደህንነትዎን እንደሚጠብቅ ይወቁ</translation>
<translation id="3967822245660637423">ማውረድ ተጠናቅቋል</translation>
<translation id="562495843857641474">የአድራሻ አሞሌው ወይም የፍለጋ ሳጥኑ ውስጥ ሲተይቡ ወይም መታ ሲያደርጉ FlyWeb ጥቆማዎችን ለማግኘት ወደ ድርጅትዎ ፍለጋ፣ ሰው ሠራሽ አስተውሎት እና ወኪል መሣሪያዎች ውስጥ የሚተይቡትን ነገር ይልካል።</translation>
<translation id="5667414856761616811">ስለ FlyWeb ለሙከራ</translation>
<translation id="1152920704813762236">ስለChromeOS</translation>
<translation id="4920206821838432969">አንድን ጣቢያ ሲጎበኙ FlyWeb የአይፒ አድራሻዎን በሚደብቅ የግላዊነት አገልጋይ በኩል የተደበቀውን የዩአርኤል ክፍል ወደ <ph name="BEGIN_LINK"/>FlyWeb የጥንቃቄ አሰሳ<ph name="END_LINK"/> ይልካል። ጣቢያ አጠራጣሪ ነገር ካደረገ፣ እንዲሁም የገጽ ይዘት ሙሉ ዩአርኤሎች እና ቢቶች ይላካሉ።</translation>
<translation id="4016217212818346953">በሚስጥር ቁልፍ አስተዳዳሪ ደኅንነትዎን ይጠብቁ</translation>
<translation id="3703994572283698466">ChromeOS እና <ph name="BEGIN_LINK_LINUX_OSS"/>የLinux ግንባታ ምህዳር<ph name="END_LINK_LINUX_OSS"/> ሊሠሩ የቻሉት በተጨማሪ <ph name="BEGIN_LINK_CROS_OSS"/>የክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_CROS_OSS"/> ነው።</translation>
<translation id="4022972681110646219">ማያ ገፁን ተርጉም</translation>
<translation id="4023601594785368013">የመጀመሪያው ቋንቋ፦ <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">ከማንኛውም መተግበሪያ ላይ አገናኞችን FlyWeb ውስጥ ይከፍታል። በተጨማሪም፣ ለቀላል መዳረሻ የተግባር አሞሌዎ ላይ ፒን ይደረጋል።</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>የአሁኖቹን ቅንብሮች<ph name="END_LINK"/> ሪፖርት በማድረግ FlyWeb የተሻለ እንዲሆን ያግዙ</translation>
<translation id="4050175100176540509">አስፈላጊ የደህንነት ማሻሻያዎች እና አዲስ ባህሪያት በቅርብ ጊዜው ስሪቱ ላይ ይገኛሉ።</translation>
<translation id="4055805654398742145">የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{ድርጅትዎ FlyWeb ለ1 ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።}one{ድርጅትዎ FlyWeb ለ# ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።}other{ድርጅትዎ FlyWeb ለ# ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።}}</translation>
<translation id="4105099155797156500">ወደ ስለBrave ገጽ ይሂዱ</translation>
