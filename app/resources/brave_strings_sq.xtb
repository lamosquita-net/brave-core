<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1026101648481255140">Rifillo instalimin</translation>
<translation id="7099479769133613710">Nise sërish për të përditësuar ChromeOS</translation>
<translation id="291426170030461697">FlyWeb rekomandon që ta rinovosh këtë shtesë</translation>
<translation id="1549005488226693697">Kur një sajt kërkon të ngarkojë paraprakisht lidhje në mënyrë private në faqen e tij, FlyWeb përdor serverët e FlyWeb. Kjo e fsheh identitetin tënd nga sajti i ngarkuar paraprakisht, por FlyWeb mëson se çfarë sajtesh ngarkohen paraprakisht.</translation>
<translation id="1065672644894730302">Preferencat e tua nuk mund të lexohen.

Disa funksione mund të mos ofrohen dhe ndryshimet në preferenca nuk do të ruhen.</translation>
<translation id="8908267645832965492">Prindi yt ka çaktivizuar "Lejet për sajtet, aplikacionet dhe shtesat" për FlyWeb</translation>
<translation id="5557633153169217776">FlyWeb ka nevojë për qasje te rrjeti yt lokal për të zbuluar dhe përdorur pajisjet në afërsi</translation>
<translation id="6441390163669415879">Për të kërkuar një veçori ose shtesë specifike të FlyWeb, shkruaj shkurtoren e saj në shiritin e adresave, të ndjekur nga tasti i zgjedhur i tastierës</translation>
<translation id="9001750423919983557">Shfaq kërkimin me FlyWeb në tabakanë e sistemit dhe aktivizo shkurtoren e tastierës</translation>
<translation id="1368460307421081773">FlyWeb dëshiron të eksportojë fjalëkalimet e tua. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="112640046208448578">Identifiko gjërat ose vendet dhe kopjo ose përkthe tekstin. Kur përdor "Kërkimin nëpërmjet imazheve", një pamje ekrani e faqes dërgohet te serveri. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb është shfletuesi yt i parazgjedhur</translation>
<translation id="4556715463645168547">Për të kontrolluar nëse fjalëkalimet e tua janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK"/>identifikohu në FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Kliko te menyja e FlyWeb</translation>
<translation id="1157985233335035034">Gjuhët e fundit</translation>
<translation id="1184145431117212167">Instalimi dështoi pasi versioni yt i Windows nuk mbështetet.</translation>
<translation id="4380351562011537903">Rreth FlyWeb</translation>
<translation id="853148447909557566">Merr sinjalizime për monitorimin e çmimeve me FlyWeb në telefonin tënd</translation>
<translation id="1203500561924088507">Faleminderit që e instalove. Duhet të rinisësh shfletuesin përpara se të përdorësh <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Kur hap "Kërkimin e imazheve", titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, do të dërgohen automatikisht te serveri. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e FlyWeb" në FlyWeb. Për ta ndryshuar këtë, shko te "Llogaria jote në FlyWeb".</translation>
<translation id="7614508617663739435">Shfaq Gemini në FlyWeb në shiritin e menysë së Mac</translation>
<translation id="832555967476614730">Për të zgjedhur një pjesë të ekranit në Gemini në FlyWeb, përdor shkurtoren e tastierës.</translation>
<translation id="4750836834956739196">Kur kjo skedë ishte joaktive, memoria u lirua që FlyWeb të vazhdojë të jetë i shpejtë. Mund të zgjedhësh që ta përjashtosh gjithmonë këtë sajt nga caktimi si joaktiv.</translation>
<translation id="3190759351483708314">FlyWeb e bllokoi këtë shkarkim sepse skedari është i rrezikshëm</translation>
<translation id="5879469261638423015">Kur identifikohesh me <ph name="USER_EMAIL"/> në shërbimet e FlyWeb, si p.sh. Gmail ose YouTube, mund të identifikohesh automatikisht në FlyWeb me të njëjtën llogari</translation>
<translation id="7142135954326264349">Merr FlyWeb në telefonin tënd</translation>
<translation id="1290883685122687410">Gabim në konfigurim: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Konfiguro profilin tënd të ri të FlyWeb</translation>
<translation id="5252737639504553444">Provo me Gemini në FlyWeb</translation>
<translation id="609743863669742325">FlyWeb ka nevojë për qasje te Bluetooth-i për të eksploruar pajisjet me Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Identifikohu në FlyWeb në telefonin tënd</translation>
<translation id="1330562121671411446">Zbulo gjuhën</translation>
<translation id="2276527911011636666">Fshi po ashtu të dhënat nga FlyWeb (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">U gozhdua! Mund të qasesh përsëri te "Kërkimi nëpërmjet imazheve" nga butoni i ri në shiritin e veglave</translation>
<translation id="1383876407941801731">Kërko</translation>
<translation id="1045149878186896649">Përdor aplikacionin e FlyWeb për të vazhduar të shfletosh kur je në lëvizje</translation>
<translation id="141901961143729572">Ndaj mendimet e tua</translation>
<translation id="2758515779140515865">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për FlyWeb te "Cilësimet e sistemit".</translation>
<translation id="4713192356155907986">Merr ndihmë për FlyWeb for Testing</translation>
<translation id="4984443629206419460">Për të marrë informacionet e ruajtura etj. nga <ph name="DEVICE"/>, identifikohu në FlyWeb</translation>
<translation id="1497802159252041924">Gabim gjatë instalimit: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Kjo faqe është e mbrojtur</translation>
<translation id="8962360511570172">Ndaj një skedë të FlyWeb</translation>
<translation id="2941487459666781243">Identifikohu në FlyWeb</translation>
<translation id="1547469039832541117">Përfundon detyrën e theksuar.</translation>
<translation id="3182893868355533457">Gozhdo FlyWeb</translation>
<translation id="852852907317361085">Veglat e sigurisë të FlyWeb</translation>
<translation id="481155564361715417">FlyWeb dëshiron të fshijë të dhënat e tua të "Menaxherit të fjalëkalimeve". Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="2846999307505917298">Merr më të mirën e FlyWeb me aplikacionin e FlyWeb në telefonin tënd</translation>
<translation id="3961251277542681013">Shqyrto kontrollet kryesore të sigurisë dhe privatësisë në FlyWeb</translation>
<translation id="1640672724030957280">Po shkarkohet...</translation>
<translation id="1665602916345474427">Identifikuar si <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="7625232007557474355">Mund të përdorësh FlyWeb sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera. Ai do të gozhdohet gjithashtu te shiriti i detyrave.</translation>
<translation id="1709772298389099340">Ofron privilegje të larta për <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">FlyWeb do t'i fshijë së shpejti të dhënat e shfletimit</translation>
<translation id="8939535770474283898">FlyWeb do të përpiqet t'i përmirësojë navigimet në HTTPS</translation>
<translation id="2581127533455294937">Të dhënat e FlyWeb u pastruan</translation>
<translation id="7385422968404728039">FlyWeb do të riniset pas <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Kur HTTPS nuk ofrohet, FlyWeb do të përdorë një lidhje të pasigurt pa të të paralajmëruar</translation>
<translation id="307170399141486420">Lejo që FlyWeb të ekzekutohet në sfond</translation>
<translation id="5006568136491721884">Kliko te <ph name="BEGIN_BOLD"/>Po<ph name="END_BOLD"/> në njoftimin e Windows për të gozhduar FlyWeb te shiriti i detyrave për qasje të shpejtë.</translation>
<translation id="2473319786107120819">Instalo përsëri FlyWeb</translation>
<translation id="2533324957407080119">FlyWeb po përpiqet <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në FlyWeb në profilin tënd si <ph name="USER_EMAIL_ADDRESS"/>. Do të marrësh gjithashtu shtesat e tua etj. nga <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">Herën tjetër që të hapësh FlyWeb në <ph name="DEVICE_TYPE"/>, do të shikosh një kërkesë për të përdorur "Menaxherin e fjalëkalimeve të FlyWeb".</translation>
<translation id="1838374766361614909">Fshi kërkimin</translation>
<translation id="3403116471618205223">Për t'i fshirë të dhënat e shfletimit vetëm nga kjo pajisje, ndërkohë që i mban ato në "Llogarinë tënde të FlyWeb", <ph name="BEGIN_LINK"/>dil nga llogaria në FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Shkarko FlyWeb në telefon për të hapur ose krijuar grupe të reja skedash kur je në lëvizje.</translation>
<translation id="3285741355512747610">Mund t'i menaxhosh "Llogaritë e FlyWeb" ku je identifikuar. "Llogaritë e tua të FlyWeb" përdoren për shfletuesin FlyWeb, Play Store, Gmail etj. Nëse do të shtosh një llogari për dikë tjetër, si p.sh. anëtar të familjes, shto më mirë një person të ri te <ph name="DEVICE_TYPE"/> yt. <ph name="LINK_BEGIN"/>Mëso më shumë<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Kërko me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në FlyWeb në profilin tënd si <ph name="USER_EMAIL_ADDRESS"/>. Do të marrësh gjithashtu faqeshënuesit e tu etj. nga <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Përzgjidh tekstin</translation>
<translation id="4824940465467423308">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontrollin mbi profilin tënd të FlyWeb. Të dhënat e tua të FlyWeb, si aplikacionet, faqeshënuesit, historiku, fjalëkalimet dhe cilësimet e tjera do të bëhen të lidhura përgjithmonë me <ph name="USER_NAME"/>. Do të mund t'i fshish këto të dhëna nëpërmjet "Panelit të llogarive të FlyWeb", por nuk do të mund t'i lidhësh këto të dhëna me një llogari tjetër. Mund të krijosh si opsion një profil të ri për t'i mbajtur më vete të dhënat ekzistuese të FlyWeb. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb kursen energjinë e baterisë duke kufizuar aktivitetin në sfond dhe efektet vizuale, si p.sh. lëvizjen e butë dhe shpejtësitë e kuadrove të videove. <ph name="BEGIN_LINK"/>Mëso më shumë për "Kursyesin e energjisë"<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb Updater Service</translation>
<translation id="7390382558747224642">Duke çaktivizuar këtë, mund të identifikohesh në sajtet e FlyWeb si Gmail pa u identifikuar në FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb nuk përgjigjet. Dëshiron ta hapësh sërish tani?</translation>
<translation id="5866699689358760578">Organizata jote, <ph name="MANAGER"/>, kërkon që të identifikohesh në FlyWeb</translation>
<translation id="4035053306113201399">ChromeOS ka nevojë të riniset për të zbatuar përditësimin.</translation>
<translation id="3750729306035486751">FlyWeb e bllokoi këtë shkarkim sepse lloji i skedarit nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="1953553007165777902">Po shkarkohet... Kanë mbetur edhe <ph name="MINUTE"/> minuta</translation>
<translation id="6956650624767954726">FlyWeb nuk mund të përcaktojë ose caktojë shfletuesin e parazgjedhur</translation>
<translation id="197326043290947695">Shfleto në mënyrë më inteligjente me "Kërkimin e imazheve"</translation>
<translation id="130679046523922050">Mëso se pse FlyWeb i bllokon disa skedarë, hapet në një skedë të re</translation>
<translation id="8243822903505210769">E mban të përditësuar softuerin e FlyWeb. Nëse ky shërbim çaktivizohet ose ndalohet, softueri yt i FlyWeb nuk do të mbahet i përditësuar, që do të thotë se dobësitë e sigurisë që mund të lindin nuk mund të rregullohen dhe veçoritë mund të mos funksionojnë. Ky shërbim çinstalohet vetë kur nuk ka një softuer të FlyWeb që e përdor atë.</translation>
<translation id="6495079989036864983">Kjo do të fshijë 1 artikull nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te FlyWeb si <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalimi nuk u krye. Provo përsëri.</translation>
<translation id="2039417478970545937">Cilësimet.</translation>
<translation id="8544477465831682343">Zgjidh nëse do ta përfshish historikun e FlyWeb për përvoja më të personalizuara në shërbimet e FlyWeb</translation>
<translation id="328650761750741315">I integruar në FlyWeb për të të ndihmuar të krijosh, ruash dhe plotësosh automatikisht fjalëkalime të forta. Shto shkurtoren për qasje të lehtë.</translation>
<translation id="2407746489237278840">Kliko te butoni "Personalizo FlyWeb" në faqen e skedës së re për t'i dhënë FlyWeb një pamje të re</translation>
<translation id="8924891216494775926">FlyWeb e bllokoi këtë shkarkim sepse skedari është mashtrues dhe mund të bëjë ndryshime të papritura në pajisjen tënde</translation>
<translation id="5728214838078602184">Do të shikosh një kërkesë për të provuar <ph name="FEATURE_NAME"/> herën tjetër kur të hapësh FlyWeb për iOS.</translation>
<translation id="2058207584484841616">Fjalëkalimet e tua dhe të dhënat e tjera të FlyWeb që ke ruajtur në "Llogarinë tënde të FlyWeb" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në FlyWeb, identifikohu përsëri.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Organizata jote i fshin automatikisht të dhënat e shfletimit kur FlyWeb nuk përdoret për 1 minutë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}other{Organizata jote i fshin automatikisht të dhënat e shfletimit kur FlyWeb nuk përdoret për # minuta. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}}</translation>
<translation id="2125838419757773031">Zgjidh rajonin e ekranit për të kërkuar</translation>
<translation id="2126108037660393668">Skedari i shkarkuar nuk u verifikua.</translation>
<translation id="2135919691573380097">Raportoje këtë sajt</translation>
<translation id="2137162749895930932">Mbyll ekranin e përkthimit</translation>
<translation id="2147218225094845757">Fshihe panelin anësor</translation>
<translation id="4474394796469499134">FlyWeb e bllokoi këtë shkarkim sepse sajti nuk po përdor një lidhje të sigurt dhe mund të ketë pasur ndërhyrje te skedari</translation>
