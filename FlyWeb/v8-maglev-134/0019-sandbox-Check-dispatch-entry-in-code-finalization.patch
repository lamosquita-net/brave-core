From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 10:54:15 +0000
Subject: [PATCH 19/20] [sandbox] Check dispatch entry in code finalization

Port of v8 b5db50f99b (M146 5fc1531adc; crbug 489633232): Maglev records the JS dispatch handles it calls with a fixed parameter count, and InstructionStream::Finalize SBXCHECKs them against the dispatch table. In 13.4 only Maglev's CallKnownJSFunction calls a dispatch entry directly (TurboFan x64 does not), and the table is IsolateGroup's. FlyWeb Maglev debt for level 134.
---
 src/codegen/assembler.cc             |  5 +++++
 src/codegen/assembler.h              |  8 ++++++++
 src/maglev/maglev-ir.cc              |  1 +
 src/objects/instruction-stream-inl.h |  2 ++
 src/objects/instruction-stream.cc    | 18 ++++++++++++++++++
 src/objects/instruction-stream.h     |  2 ++
 6 files changed, 36 insertions(+)

diff --git a/src/codegen/assembler.cc b/src/codegen/assembler.cc
index 9d13f2bb..0354e365 100644
--- a/src/codegen/assembler.cc
+++ b/src/codegen/assembler.cc
@@ -303,6 +303,11 @@ IndirectHandle<HeapObject> AssemblerBase::GetEmbeddedObject(
   return embedded_objects_[index];
 }
 
+void AssemblerBase::RecordJSDispatchHandle(JSDispatchHandle handle,
+                                           uint16_t argument_count) {
+  js_dispatch_handles_.push_back({handle, argument_count});
+}
+
 int Assembler::WriteCodeComments() {
   if (!v8_flags.code_comments) return 0;
   CHECK_IMPLIES(code_comments_writer_.entry_count() > 0,
diff --git a/src/codegen/assembler.h b/src/codegen/assembler.h
index 0e5edf87..5db5f594 100644
--- a/src/codegen/assembler.h
+++ b/src/codegen/assembler.h
@@ -488,6 +488,12 @@ class V8_EXPORT_PRIVATE AssemblerBase : public Malloced {
   // generated code.
   static constexpr int kDefaultBufferSize = 4 * KB;
 
+  void RecordJSDispatchHandle(JSDispatchHandle handle, uint16_t argument_count);
+  const std::vector<std::pair<JSDispatchHandle, uint16_t>>&
+  js_dispatch_handles() const {
+    return js_dispatch_handles_;
+  }
+
  protected:
   // Add 'target' to the {code_targets_} vector, if necessary, and return the
   // offset at which it is stored.
@@ -560,6 +566,8 @@ class V8_EXPORT_PRIVATE AssemblerBase : public Malloced {
                      IndirectHandle<HeapObject>::equal_to>
       embedded_objects_map_;
 
+  std::vector<std::pair<JSDispatchHandle, uint16_t>> js_dispatch_handles_;
+
   const AssemblerOptions options_;
   uint64_t enabled_cpu_features_;
   bool predictable_code_size_;
diff --git a/src/maglev/maglev-ir.cc b/src/maglev/maglev-ir.cc
index 7d59b870..b79c0a03 100644
--- a/src/maglev/maglev-ir.cc
+++ b/src/maglev/maglev-ir.cc
@@ -6073,6 +6073,7 @@ void CallKnownJSFunction::GenerateCode(MaglevAssembler* masm,
     __ CallBuiltin(builtin);
   } else {
 #if V8_ENABLE_LEAPTIERING
+    __ RecordJSDispatchHandle(dispatch_handle_, expected_parameter_count_);
     __ CallJSDispatchEntry(dispatch_handle_, expected_parameter_count_);
 #else
     __ CallJSFunction(kJavaScriptCallTargetRegister, expected_parameter_count_);
diff --git a/src/objects/instruction-stream-inl.h b/src/objects/instruction-stream-inl.h
index 32cdc2c0..f973d84a 100644
--- a/src/objects/instruction-stream-inl.h
+++ b/src/objects/instruction-stream-inl.h
@@ -154,6 +154,8 @@ void InstructionStream::Finalize(Tagged<Code> code,
         code, kReleaseStore);
   }
 
+  InstructionStream::ValidateJSDispatchHandles(heap, desc);
+
   // Trigger the write barriers after we dropped the JIT write permissions.
   RelocateFromDescWriteBarriers(heap, desc, code->constant_pool(), *promise,
                                 no_gc);
diff --git a/src/objects/instruction-stream.cc b/src/objects/instruction-stream.cc
index d7269351..b2029981 100644
--- a/src/objects/instruction-stream.cc
+++ b/src/objects/instruction-stream.cc
@@ -10,6 +10,8 @@
 #include "src/codegen/reloc-info-inl.h"
 #include "src/codegen/reloc-info.h"
 #include "src/objects/instruction-stream-inl.h"
+#include "src/init/isolate-group.h"
+#include "src/sandbox/js-dispatch-table-inl.h"
 
 namespace v8 {
 namespace internal {
@@ -129,5 +131,21 @@ InstructionStream::WriteBarrierPromise::~WriteBarrierPromise() {
 }
 #endif
 
+void InstructionStream::ValidateJSDispatchHandles(Heap* heap,
+                                                  const CodeDesc& desc) {
+#ifdef V8_ENABLE_LEAPTIERING
+  if (desc.origin) {
+    for (const auto& pair : desc.origin->js_dispatch_handles()) {
+      JSDispatchHandle handle = pair.first;
+      uint16_t expected_arg_count = pair.second;
+      uint16_t actual_arg_count =
+          IsolateGroup::current()->js_dispatch_table()->GetParameterCount(
+              handle);
+      SBXCHECK_EQ(expected_arg_count, actual_arg_count);
+    }
+  }
+#endif  // V8_ENABLE_LEAPTIERING
+}
+
 }  // namespace internal
 }  // namespace v8
diff --git a/src/objects/instruction-stream.h b/src/objects/instruction-stream.h
index 68876317..7324a8e8 100644
--- a/src/objects/instruction-stream.h
+++ b/src/objects/instruction-stream.h
@@ -19,6 +19,7 @@ namespace v8 {
 namespace internal {
 
 class Code;
+class CodeDesc;
 class WritableJitAllocation;
 
 // InstructionStream contains the instruction stream for V8-generated code
@@ -116,6 +117,7 @@ class InstructionStream : public TrustedObject {
   static V8_INLINE Tagged<InstructionStream> Initialize(
       Tagged<HeapObject> self, Tagged<Map> map, uint32_t body_size,
       int constant_pool_offset, Tagged<TrustedByteArray> reloc_info);
+  static void ValidateJSDispatchHandles(Heap* heap, const CodeDesc& desc);
   V8_INLINE void Finalize(Tagged<Code> code,
                           Tagged<TrustedByteArray> reloc_info, CodeDesc desc,
                           Heap* heap);
