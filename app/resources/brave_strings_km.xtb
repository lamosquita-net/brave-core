<translation id="8962360511570172">ចែករំលែក​ផ្ទាំង FlyWeb</translation>
<translation id="8196829963313696543">FlyWeb ត្រូវការការអនុញ្ញាតចូលប្រើកាមេរ៉ារបស់អ្នក ដើម្បីបង្កើតផែនទី 3D នៃមជ្ឈដ្ឋានជុំវិញរបស់អ្នក</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{លែងអាចប្រើកម្មវិធីបន្ថែម​នេះបានទៀតហើយ។ FlyWeb ណែនាំឱ្យអ្នកដកកម្មវិធីបន្ថែម​នេះចេញ។}other{លែងអាចប្រើកម្មវិធីបន្ថែម​ទាំងនេះបានទៀតហើយ។ FlyWeb ណែនាំឱ្យអ្នកដកកម្មវិធីបន្ថែម​ទាំងនេះចេញ។}}</translation>
<translation id="852852907317361085">ឧបករណ៍​សុវត្ថិភាពរបស់ FlyWeb</translation>
<translation id="4096742538387076253">FlyWeb ត្រូវការផ្ទៀងផ្ទាត់ថាជាអ្នក មុនពេលដែលទិន្នន័យមួយចំនួនអាចត្រូវបានរក្សាទុកនៅក្នុងគណនី FlyWeb របស់អ្នក និងត្រូវបានប្រើនៅលើឧបករណ៍ទាំងអស់របស់អ្នក។ ប្រសិនបើអ្នកចេញពីគណនី ទិន្នន័យនេះនឹងបន្តស្ថិតនៅលើឧបករណ៍នេះ។</translation>
<translation id="481155564361715417">FlyWeb ចង់លុប​ទិន្នន័យ​កម្មវិធី​គ្រប់គ្រង​ពាក្យសម្ងាត់​របស់អ្នក។ សូម​វាយបញ្ចូល​ពាក្យសម្ងាត់ Windows របស់អ្នក ដើម្បី​អនុញ្ញាត​ការលុបនេះ។</translation>
<translation id="3961251277542681013">ពិនិត្យមើល​ការគ្រប់គ្រង​សុវត្ថិភាព និងឯកជនភាព​សំខាន់ៗនៅក្នុង FlyWeb</translation>
<translation id="1640672724030957280">កំពុងទាញ​យក...</translation>
<translation id="6153580651793156880">ដើម្បីជួយ​កែលម្អ​មុខងារ​ទាំងនេះ FlyWeb បញ្ជូន​អន្តរកម្ម​របស់អ្នក​ជាមួយ​មុខងារ​ទាំងនេះ​ទៅ FlyWeb។ ទិន្នន័យនេះ​អាចត្រូវបាន​អាន ដំណើរការ និង​ធ្វើចំណារ​ដោយ​អ្នកត្រួតពិនិត្យ​ជាមនុស្ស។</translation>
<translation id="1722488837206509557">ការធ្វើបែបនេះ​នឹងអាច​ឱ្យអ្នក​ជ្រើសរើស​ពីឧបករណ៍​ដែលអាច​ប្រើបាន និង​បង្ហាញ​ខ្លឹមសារ​នៅលើ​ឧបករណ៍​ទាំងនោះ។</translation>
<translation id="2383861520542390014">អ្នក​អាច​មើលឃើញ និង​លុប​ចេញ​នូវ​ប្រធានបទ​ជា​ទី​ចាប់​អារម្មណ៍​ដែល​គេហទំព័រ​ប្រើប្រាស់​សម្រាប់​បង្ហាញ​ការ​ផ្សាយ​ពាណិជ្ជកម្ម​ដល់​អ្នក។ FlyWeb ប៉ាន់ស្មានចំណាប់អារម្មណ៍របស់អ្នក ដោយផ្អែកលើប្រវត្តិ​រុករក​តាមអ៊ីនធឺណិតថ្មីៗរបស់អ្នក។</translation>
<translation id="5695205873161614119">FlyWeb នឹង​លុប​ទិន្នន័យរុករកក្នុង​ពេល​ឆាប់ៗ​នេះ</translation>
<translation id="8939535770474283898">FlyWeb នឹងព្យាយាម​ដំឡើងកម្រិត​ការរុករក​ទៅ HTTPS</translation>
<translation id="7385422968404728039">FlyWeb នឹងចាប់ផ្តើមឡើងវិញក្នុងរយៈពេល <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">FlyWeb នឹងប្រើ​ការតភ្ជាប់​ដែលគ្មានសុវត្ថិភាព​ដោយមិន​ប្រាប់អ្នកឱ្យប្រុងប្រយ័ត្ន នៅពេល​ដែលមិន​អាចប្រើ HTTPS បានទេ</translation>
<translation id="307170399141486420">អនុញ្ញាតឲ្យ FlyWeb ដំណើរនៅក្នុងផ្ទៃខាងក្រោយ</translation>
<translation id="2473319786107120819">តំឡើង FlyWeb ឡើងវិញ</translation>
<translation id="2533324957407080119">FlyWeb កំពុងព្យាយាម<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="3403116471618205223">ដើម្បីលុប​ទិន្នន័យរុករក​ចេញពី​ឧបករណ៍​នេះតែប៉ុណ្ណោះ ប៉ុន្តែរក្សា​ទិន្នន័យនេះនៅក្នុង​គណនី FlyWeb របស់អ្នក សូម<ph name="BEGIN_LINK"/>ចេញពីគណនីលើ FlyWeb<ph name="END_LINK"/>។</translation>
<translation id="6434738578659849497">គេហទំព័រអាច​រក្សាទុក​ព័ត៌មានជាមួយ FlyWeb អំពីចំណាប់អារម្មណ៍​របស់អ្នក។ ឧទាហរណ៍ ប្រសិនបើអ្នក​ចូលមើល​គេហទំព័រ ដើម្បីទិញស្បែកជើង​សម្រាប់រត់ម៉ារ៉ាតុង នោះគេហទំព័រនោះ​ប្រហែលជាកំណត់​ចំណាប់អារម្មណ៍​របស់អ្នក​ថាជាការរត់ម៉ារ៉ាតុង។ ក្រោយមកទៀត ប្រសិនបើអ្នកចូលមើល​គេហទំព័រផ្សេង ដើម្បីចុះឈ្មោះ​ចូលរួមការប្រណាំង គេហទំព័រនោះ​អាចបង្ហាញ​ការផ្សាយពាណិជ្ជកម្ម​អំពីស្បែកជើងសម្រាប់​រត់ប្រណាំងដល់អ្នក ដោយផ្អែកលើ​ចំណាប់អារម្មណ៍​របស់អ្នក។</translation>
