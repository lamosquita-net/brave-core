<translation id="7626272203917389133">FlyWeb ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="1789655708880997767">{0,plural, =1{FlyWeb ຈະເປີດຄືນໃໝ່ໃນໜຶ່ງຊົ່ວໂມງ}other{FlyWeb ຈະເປີດຄືນໃໝ່ໃນ # ຊົ່ວໂມງ}}</translation>
<translation id="9106236359747881194">ເລືອກຂໍ້ຄວາມທີ່ຈະຊອກຫາ</translation>
<translation id="8970147445441095618">ເພື່ອໄດ້ຮັບການອັບເດດ FlyWeb ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.1.</translation>
<translation id="1208237657860748752">ເປີດລິ້ງໃນແຖບ FlyWeb ໃໝ່</translation>
<translation id="911206726377975832">ລຶບຂໍ້ມູນການທ່ອງເນັດຂອງທ່ານນໍາບໍ?</translation>
<translation id="9134482777260927479">ຄວາມຊ່ວຍເຫຼືອໃນການເຮັດວຽກບ້ານ</translation>
<translation id="9148058034647219655">ອອກ</translation>
<translation id="1592415213971909403">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: FlyWeb ສາມາດກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອເປີດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="3926534790663909774">ຜູ້ເບິ່ງແຍງລະບົບໄດ້ກຳນົດຄ່າ FlyWeb ໃຫ້ເປີດໂປຣແກຣມທ່ອງເວັບສຳຮອງເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="5022081608392609959">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;FlyWeb</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">ຕັ້ງຄ່າ FlyWeb ໃນແບບຂອງທ່ານເອງ</translation>
<translation id="3410331617397516204">FlyWeb ອາດຈະບໍ່ເຮັດວຽກຢ່າງຖືກຕ້ອງ ເພາະວ່າມັນບໍ່ຖືກຮອງຮັບໃນ Windows XP ຫຼື Windows Vista ອີກຕໍ່ໄປ</translation>
<translation id="3613308994653366133">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ FlyWeb ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ FlyWeb.</translation>
<translation id="945522503751344254">ສົ່ງ​ຄໍາ​ຄິດ​​ເຫັນ</translation>
<translation id="1127626874097952395">ໃຜກຳລັງໃຊ້ FlyWeb)</translation>
<translation id="1626113414414104077">ໃຊ້ຄວາມປອດໄພຂັ້ນສູງສຸດຂອງ FlyWeb</translation>
<translation id="983803489796659991">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດບໍ່ມີຂໍ້ມູນ hash ໃດໆສຳລັບແອັບພລິເຄຊັນ.</translation>
<translation id="839475718250652248">ໃຊ້ FlyWeb ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="989970834842471429">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="7783156808075587495">ເພື່ອໃຊ້ສະຖານທີ່ຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ FlyWeb ໃນ <ph name="BEGIN_LINK"/>ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK"/></translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ ​ເນື່ອງ​ຈາກ​ຄວາມຜິດພາດທີ່ບໍ່ໄດ້ລະບຸ​. ກະ​ລຸ​ນາ​ດາວ​ໂຫລດ FlyWeb ອີກ​.</translation>
<translation id="2725795635123877647">ສ່ວນຂະຫຍາຍ, ແອັບ, ແລະຫົວຂໍ້ທີ່ມາຈາກແຫຼ່ງທີ່ບໍ່ຮູ້ຈັກອັນຕະລາຍຕໍ່ອຸປະກອນຂອງທ່ານ. FlyWeb ແນະນຳໃຫ້ຕິດຕັ້ງສ່ວນຂະຫຍາຍເຫລົ່ານີ້ບໍຂໍ້ມູນຈາກ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="5840822070878669614">ຂ່າຍ Web Store</translation>
<translation id="3470813199863172076">ສ່ວນຂະຫຍາຍອັນນີ້ລະເມີດນະໂຍບາຍຂອງ Web Store ແລະອາດຈະບໍ່ປອດໄພ. ລົບອອກຈາກ FlyWeb ເພື່ອຫລຸດເວລາທີ່ມັນເຫັນແລະແບບບໍ່ຂໍງທ່ານຢາກ</translation>
<translation id="5382847955032513683">ເຕືອນ: FlyWeb ບໍ່ສາມາດປ້ອງກັນສ່ວນຂະຫຍາຍຈາກການບັນທຶກປະຫວັດການເບິ່ງເລົາຂອງທ່ານ. ເພື່ອປິ່ນຈບສ່ວນຂະຫຍາຍນີ້ໃນຮູບແບບສ່ວນຕົນ, ຍົກເລີກໂຕເນີ້ນີ້.</translation>
<translation id="543905389684998697">ເພື່ອໃຫ້ FlyWeb ປອດໄພຂຶ້ນ, ພວກເຮົາໄດ້ປິດສ່ວນຂະຫຍາຍທີ່ບໍ່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ແລະ ອາດທີ່ຈະຖືກເພີ່ມໂຕເຂົ້າໄປບໍ່ທັນມີການຮັກສາຄວາມບໍ່ສາມາດ.</translation>
<translation id="3914570680366033593">ເພື່ອທຳໃຫ້ FlyWeb ປອດໄພຂຶ້ນ, ພວກເຮົາໄດ້ປິດສ່ວນຂະຫຍາຍນີ້ທີ່ບໍ່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ແລະ ອາດທີ່ຈະຖືກເພີ່ມໂຕເຂົ້າໄປບໍ່ແມ່ນໃນ.</translation>
<translation id="2742103213766991703">ເປີດລິ້ງໃນ FlyWeb &amp;ໜ້າສ່ວນຕົວ</translation>
<translation id="1616978953472841483">ເປີດລິ້ງໃນ FlyWeb &amp;ໜ້າສ່ວນຕົວ</translation>
<translation id="2050263926423290804">{COUNT, plural, =0 {ມີການອັບເດດໃຫ່ມຈອງ FlyWeb ກຳລັງຄວາມເຂົ້າໄດ້ແລ້ວ ແລະ ຈະຖືກນຳເອົານໄປໃຊ້່ເປັນເລັດໃນທັນທີ.} =1 {ມີການອັບເດດໃຫມ່ຈາກ FlyWeb ມີໃຫ້ແລ້ວ ແລະ ຈະຖືກເອົາໃຊ້ເມື່ອທ່ານເປີດໃຫມ່. ຫ້ອງສ່ວນຕົວບໍ່ສາມາດເປີດເຂົ້າໃໝ່ໄດ້.} other {ມີການອັບເດດເລີຍ FlyWeb ມີໃຫ້ແລ້ວ ແລະ ຈະປິເພື່ິງມື້ນີ້ນີ້ເລື່ອນ Great เวลา. # ຫ້ອງສ່ວນຕົວບໍ່ຈະສວນໃດເມື່ອທ່ານເປີດໃຫມ່.}}</translation>
<translation id="8494512118209691256">ນີ້ຈະອະນຸຍາດໃຫ້ທ່ານແບ່ງປັນເນື້ອຫາຈາກ FlyWeb ໄປຍັງອຸປະກອນທ້ອງຖິ່ນຂອງທ່ານ ເຊັ່ນ: ໂທລະສະວັສນ໑ ຫຼື ລໍາໂພງ</translation>
<translation id="7488914907489544218">{COUNT, plural, =0 {ຜູ້ບໍລິຫານຂອງທ່ານຂໍໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ} =1 {ຜູ້ບໍລິຫານຂອງທ່ານຂໍໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວຂອງທ່ານຈະບໍ່ເປີດຄືນ.} other {ຜູ້ບໍລິຫານຂອງທ່ານຂໍໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວ # ຂອງທ່ານຈະບໍ່ເປີດຄືນ.}}</translation>
<translation id="7568541461974616693">{COUNT, plural, =0 {ຜູ້ບໍລິຫານຂອງທ່ານກໍ່າລະບຸໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ} =1 {ຜູ້ບໍລິຫານຂອງທ່ານກໍ່າລະບຸໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວຂອງທ່ານຈະບໍ່ເປີດຄືນ.} other {ຜູ້ບໍລິຫານຂອງທ່ານກໍ່າລະບຸໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວ # ຂອງທ່ານຈະບໍ່ເປີດຄືນ.}}</translation>
<translation id="6998204082704836463">{COUNT, plural, =0 {ການປົກປ້ອງຂັ້ນສູງກໍ່າລະບຸໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ} =1 {ການປົກປ້ອງຂັ້ນສູງກໍ່າລະບຸໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວຂອງທ່ານຈະບໍ່ເປີດຄືນ.} other {ການປົກປ້ອງຂັ້ນສູງກໍ່າລະບຸໃຫ້ທ່ານເປີດ FlyWeb ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວ # ຂອງທ່ານຈະບໍ່ເປີດຄືນ.}}</translation>
<translation id="5749154344207139683">ຊ່ວຍໃຫ້ສັນທະນານັກດວນໃ່ເຄືອນນອນໄລຈຳນຍາສອນປີນາທ</translation>
<translation id="4766381896251401675">ເມື່ອທ່ານພິມຢູ່ໃນບີນທີ່ທິດສຳລະທີ່ຢູ່ຕ່ຳຂອງທ່ານ, FlyWeb ຈະສົ່ງມູນທີ່ທ່ານພີລາຍນັ້ປານທເຮັບໃຫ້ທິດສຳລະທີ່ຕັ້ງໂຂມາດເພື້ອໃຫ້ລາຍໄດ້ດີ. ໃຊ້ງານໄດ້.</translation>
<translation id="2832552148674305108">ແທການ FlyWeb Private</translation>
<translation id="611606920944085547">ເມື່ອເຊີມມູນໃນເ້ບສ່ວນຕົວ, FlyWeb ຈະກາຍຫຼືວາເຕືອນກ່ຽວກັນໃກ້ເປັນໃນພຽງໃກ້</translation>
