<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="1026101648481255140">Nadaljuj namestitev</translation>
<translation id="7099479769133613710">Znova zaženite, če želite posodobiti &amp;Chrome OS</translation>
<translation id="291426170030461697">FlyWeb priporoča, da pregledate to razširitev</translation>
<translation id="1549005488226693697">Ko spletno mesto zahteva zasebno vnaprejšnje nalaganje povezav na svoji strani, FlyWeb uporabi Googlove strežnike. S tem je vaša identiteta skrita pred vnaprej naloženim mestom, vendar FlyWeb izve, katera spletna mesta se vnaprej nalagajo.</translation>
<translation id="1065672644894730302">Nastavitev ni mogoče prebrati.

Nekatere funkcije morda niso na voljo in spremembe nastavitev ne bodo shranjene.</translation>
<translation id="8908267645832965492">Tvoj starš je izklopil »Dovoljenja za spletna mesta, aplikacije in razširitve« za FlyWeb</translation>
<translation id="5557633153169217776">FlyWeb potrebuje dostop do lokalnega omrežja, da lahko odkrije in uporablja naprave v bližini</translation>
<translation id="6441390163669415879">Če želite iskati po določeni funkciji ali razširitvi Bravea, v naslovni vrstici vnesite ustrezno bližnjico in nato izbrano tipko na tipkovnici</translation>
<translation id="9001750423919983557">Prikaz iskanja s Braveom v sistemski vrstici in vklop bližnjičnih tipk</translation>
<translation id="1368460307421081773">FlyWeb želi izvoziti gesla. Če želite omogočiti to, vnesite geslo za Windows.</translation>
<translation id="112640046208448578">Določite stvari ali mesta in kopirajte ali prevedite besedilo. Če uporabljate slikovno iskanje, se posnetek zaslona strani pošlje strežniku. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb je privzeti brskalnik</translation>
<translation id="4556715463645168547">Če želite preveriti, ali so gesla varna pred podatkovnimi kršitvami in drugimi varnostnimi težavami, <ph name="BEGIN_LINK"/>se prijavite v FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">Kliknite Braveov meni</translation>
<translation id="1157985233335035034">Nedavni jeziki</translation>
<translation id="1184145431117212167">Namestitev ni uspela, ker vaša različica sistema Windows ni podprta.</translation>
<translation id="4380351562011537903">O Braveu</translation>
<translation id="853148447909557566">Prejemanje opozoril o spremljanju cen s Braveom v telefonu</translation>
<translation id="1203500561924088507">Hvala, ker ste se odločili za namestitev. Preden uporabite <ph name="BUNDLE_NAME"/>, morate znova zagnati brskalnik.</translation>
<translation id="1232234696885483911">Ko odprete slikovno iskanje, se naslov strani, URL in vsebina, vključno z datotekami PDF, samodejno pošljejo v strežnik. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">Ko ste prijavljeni, lahko v Braveu uporabljate svoja gesla in drugo iz računa FlyWeb. Če želite to spremeniti, odprite »Vaš račun v Braveu«.</translation>
<translation id="7614508617663739435">Prikaz Geminija v Braveu v menijski vrstici Maca</translation>
<translation id="832555967476614730">Če želite v Geminiju v Braveu izbrati del zaslona, uporabite bližnjične tipke.</translation>
<translation id="4750836834956739196">Ko je bil ta zavihek neaktiven, je bil pomnilnik sproščen, da je bil FlyWeb še naprej hiter. Izberete lahko, da to spletno mesto ni nikoli neaktivno.</translation>
<translation id="3190759351483708314">FlyWeb je blokiral ta prenos, ker je datoteka nevarna</translation>
<translation id="5879469261638423015">Pri prijavi v Googlove storitve, kot je Gmail ali YouTube, z računom <ph name="USER_EMAIL"/> se lahko z istim računom samodejno prijavite v FlyWeb</translation>
<translation id="7142135954326264349">Prenesite FlyWeb v telefon</translation>
<translation id="1290883685122687410">Napaka pri nastavitvi: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">Nastavitev novega profila v Braveu</translation>
<translation id="5252737639504553444">Preizkusite z Geminijem v Braveu</translation>
<translation id="609743863669742325">FlyWeb potrebuje dostop do Bluetootha za raziskovanje 
 naprav Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">Prijava v FlyWeb v telefonu</translation>
<translation id="1330562121671411446">Zaznaj jezik</translation>
<translation id="2276527911011636666">Iz Bravea izbriši tudi podatke (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Pripeto. Do slikovnega iskanja lahko znova dostopate z novim gumbom v orodni vrstici.</translation>
<translation id="1383876407941801731">Išči</translation>
<translation id="1045149878186896649">Uporabite aplikacijo FlyWeb za brskanje na poti</translation>
<translation id="141901961143729572">Povejte svoje mnenje</translation>
<translation id="2758515779140515865">Če želite deliti okno, v sistemskih nastavitvah omogočite snemanje zaslona za FlyWeb.</translation>
<translation id="4713192356155907986">Pomoč za FlyWeb for Testing</translation>
<translation id="4984443629206419460">Če želite dostopati do shranjenih informacij in drugega v napravi <ph name="DEVICE"/>, se prijavite v FlyWeb</translation>
<translation id="1497802159252041924">Napaka pri namestitvi: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Ta stran je zaščitena</translation>
<translation id="8962360511570172">Deljenje zavihka v Braveu</translation>
<translation id="2941487459666781243">Prijava v FlyWeb</translation>
<translation id="1547469039832541117">Konča označeno opravilo.</translation>
<translation id="3182893868355533457">Pripni FlyWeb</translation>
<translation id="852852907317361085">Varnostna orodja v Braveu</translation>
<translation id="481155564361715417">FlyWeb želi izbrisati podatke upravitelja gesel. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="2846999307505917298">Z aplikacijo FlyWeb v telefonu izkoristite najboljše, kar ponuja FlyWeb</translation>
<translation id="3961251277542681013">Oglejte si ključne kontrolnike zasebnosti in varnosti v Braveu.</translation>
<translation id="1640672724030957280">Prenos ...</translation>
<translation id="1665602916345474427">Prijavljeni ste kot <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, naročnina. Odpri meni računa</translation>
<translation id="7625232007557474355">FlyWeb lahko uporabljate ob vsakem kliku povezav v sporočilih, dokumentih in drugih aplikacijah. Pripet bo tudi v opravilno vrstico.</translation>
<translation id="1709772298389099340">Zagotovi povečane pravice za brskalnik <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">FlyWeb bo kmalu izbrisal podatke brskanja</translation>
<translation id="8939535770474283898">FlyWeb bo poskusil nadgraditi pomikanje na HTTPS</translation>
<translation id="2581127533455294937">Podatki Bravea so izbrisani</translation>
<translation id="7385422968404728039">FlyWeb se bo znova zagnal čez toliko časa: <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">Če HTTPS ni na voljo, FlyWeb uporabi povezavo, ki ni varna, ne da bi vas opozoril</translation>
<translation id="307170399141486420">Naj se FlyWeb izvaja v ozadju</translation>
<translation id="5006568136491721884">Kliknite <ph name="BEGIN_BOLD"/>Da<ph name="END_BOLD"/> v obvestilu sistema Windows, če želite FlyWeb pripeti v opravilno vrstico za hitri dostop.</translation>
<translation id="2473319786107120819">Vnovična namestitev Bravea</translation>
<translation id="2533324957407080119">FlyWeb poskuša <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6758901350197493482">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen. Če želite ločiti brskanje, se v Braveu prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS"/>. V napravi <ph name="DEVICE"/> boste imeli na voljo tudi razširitve in drugo.</translation>
<translation id="3547283483106013256">Ko boste naslednjič odprli FlyWeb v napravi <ph name="DEVICE_TYPE"/>, bo prikazan poziv za uporabo Googlovega upravitelja gesel.</translation>
<translation id="1838374766361614909">Čiščenje iskanja</translation>
<translation id="3403116471618205223">Če želite izbrisati podatke brskanja samo iz te naprave, v računu FlyWeb pa jih želite ohraniti, <ph name="BEGIN_LINK"/>se odjavite iz Bravea<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">Prenesite FlyWeb v telefon, da boste lahko na poti odpirali ali ustvarjali nove skupine zavihkov.</translation>
<translation id="3285741355512747610">Upravljate lahko račune FlyWeb, v katere ste prijavljeni. Računi FlyWeb se uporabljajo za brskalnik FlyWeb, Trgovino Play, Gmail in drugo. Če želite dodati račun za nekoga drugega, na primer družinskega člana, v napravo <ph name="DEVICE_TYPE"/> dodajte novo osebo. <ph name="LINK_BEGIN"/>Več o tem<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Iskanje s slikovnim iskanjem</translation>
<translation id="5054936737639982722">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen. Če želite ločiti brskanje, se v Braveu prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS"/>. Dostopali boste lahko tudi do zaznamkov in drugega v <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">Izbira besedila</translation>
<translation id="4824940465467423308">Prijavljate se z upravljanim računom in s tem njegovemu skrbniku omogočate nadzor vašega profila v Braveu. Vaši podatki v Braveu, kot so aplikacije, zaznamki, zgodovina, gesla in druge nastavitve, bodo postali trajno povezani z uporabnikom <ph name="USER_NAME"/>. Te podatke boste lahko izbrisali na nadzorni plošči za FlyWeb Račune, vendar jih ne boste mogli povezati z drugim računom. Če želite, lahko ustvarite nov profil, da bodo obstoječi podatki v Braveu ostali ločeni. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">FlyWeb varčuje z energijo baterije tako, da omeji dejavnost v ozadju in vizualne učinke, kot sta tekoče pomikanje in število sličic v sekundi pri videoposnetkih. <ph name="BEGIN_LINK"/>Preberite več o varčevanju z energijo<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">Braveova storitev za posodabljanje</translation>
<translation id="7390382558747224642">Če to izklopite, se lahko prijavite na Googlovih spletnih mestih, kot je Gmail, ne da bi se morali prijaviti v FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb se ne odziva. Ga želite znova zagnati?</translation>
<translation id="5866699689358760578">Vaša organizacija (<ph name="MANAGER"/>) zahteva, da se prijavite v FlyWeb</translation>
<translation id="4035053306113201399">Če želite uveljaviti posodobitev, morate znova zagnati Chrome OS.</translation>
<translation id="3750729306035486751">FlyWeb je blokiral ta prenos, ker se vrsta datoteke ne prenaša pogosto in je morda nevarna</translation>
<translation id="1953553007165777902">Prenašanje … Še <ph name="MINUTE"/> min.</translation>
<translation id="6956650624767954726">FlyWeb ne more določiti ali nastaviti privzetega brskalnika</translation>
<translation id="197326043290947695">Brskajte pametneje s slikovnim iskanjem</translation>
<translation id="130679046523922050">Preberite, zakaj FlyWeb blokira nekatere datoteke, odpre se na novem zavihku</translation>
<translation id="8243822903505210769">Poskrbi, da je programska oprema Bravea posodobljena. Če je ta storitev onemogočena ali ustavljena, programska oprema Bravea ne bo posodobljena, kar pomeni, da varnostnih ranljivosti, ki se lahko pojavijo, ni mogoče odpraviti in funkcije morda ne delujejo. Ta storitev se samodejno odstrani, če ni programske opreme Bravea, ki bi jo uporabljala.</translation>
<translation id="6495079989036864983">S tem bo iz te naprave izbrisan 1 element. Če želite pozneje prenesti podatke, se v FlyWeb prijavite kot <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Namestitev ni uspela. Poskusite znova.</translation>
<translation id="2039417478970545937">Nastavitve.</translation>
<translation id="8544477465831682343">Izberite, ali želite, da je zaradi osebno bolj prilagojenih izkušenj v Googlovih storitvah vključena zgodovina v Braveu.</translation>
<translation id="328650761750741315">Vgrajen je v FlyWeb, da vam pomaga ustvarjati, shranjevati in samodejno izpolnjevati močna gesla. Dodajte bližnjico za preprost dostop.</translation>
<translation id="2407746489237278840">Kliknite gumb za prilagajanje Bravea na novem zavihku s povezavami, da bo FlyWeb videti drugače</translation>
<translation id="8924891216494775926">FlyWeb je blokiral ta prenos, ker je datoteka zavajajoča in v napravi morda izvaja nepričakovane spremembe</translation>
<translation id="5728214838078602184">Ko boste naslednjič odprli FlyWeb za iOS, bo prikazan poziv, da preizkusite funkcijo <ph name="FEATURE_NAME"/>.</translation>
<translation id="2058207584484841616">Gesla in drugi podatki v Braveu, ki ste jih shranili v računu FlyWeb, bodo odstranjeni iz te naprave. Če jih želite znova uporabljati v Braveu, se znova prijavite.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate 1 minuto. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}one{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minuto. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}two{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minuti. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}few{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minute. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}other{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minut. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}}</translation>
<translation id="2125838419757773031">Izberite območje zaslona za iskanje</translation>
<translation id="2126108037660393668">Napaka pri preverjanju prenesene datoteke.</translation>
<translation id="2135919691573380097">Prijava tega spletnega mesta</translation>
<translation id="2137162749895930932">Zapiranje zaslona za prevajanje</translation>
<translation id="2147218225094845757">Skrij stransko podokno</translation>
<translation id="4474394796469499134">FlyWeb je blokiral ta prenos, ker spletno mesto ne uporablja varne povezave in so v datoteko morda posegali</translation>
<translation id="2170098639895543546">Izberite kar koli na strani</translation>
<translation id="6765231735885996239">Prilagodi FlyWeb</translation>
<translation id="2174917724755363426">Namestitev še ni končana. Ali ste prepričani, da jo želite preklicati?</translation>
<translation id="2937508664417729967">FlyWeb – Prijava v omrežje – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Napaka pri preverjanju posodobitev: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Odstranitev računa iz Bravea</translation>
<translation id="744837314710861405">Uporabite aplikacijo FlyWeb in imejte najboljša orodja za nakupovanje vedno pri roki</translation>
<translation id="2745381939758295588">Ostanite varnejši na poti z izboljšanim varnim brskanjem v Braveu za iOS</translation>
<translation id="6707114110652917144">Nevarno spletno mesto. FlyWeb je odstranil dovoljenje za obvestila.</translation>
<translation id="2236949375853147973">Moja dejavnost</translation>
<translation id="4646732243247482236">Če želite dostopati do naslovov in drugega v vseh napravah, se prijavite v FlyWeb. Ta naslov bo po prijavi shranjen v računu FlyWeb.</translation>
<translation id="2726680594710751908">Če računalnik souporabljate z drugimi, lahko prijatelji in sorodniki ločeno brskajo ter nastavijo FlyWeb tako, kot ga želijo.</translation>
<translation id="4086571337340463916">Veščine v Braveu</translation>
<translation id="2283803047247799269">Iščite po tem zavihku s slikovnim iskanjem</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb priporoča, da začasno zaustavite zavihek, ki upočasnjuje brskalnik}one{FlyWeb priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}two{FlyWeb priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}few{FlyWeb priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}other{FlyWeb priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}}</translation>
<translation id="2307973900865360088">Obdrži v vrstici Dock</translation>
<translation id="5067150284614317159">Preveri URL-je, tako da jih primerja s seznamom spletnih mest, ki niso varna, shranjenim v Braveu. Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko FlyWeb prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="2356070529366658676">Vprašaj</translation>
<translation id="2359808026110333948">Naprej</translation>
<translation id="7339360994527471629">Razširitev »<ph name="EXTENSION_NAME"/>« želi, da se prijavite v FlyWeb</translation>
<translation id="8788732221355188962">Onemogoči FlyWeb, ki se izvaja v ozadju za aplikacije</translation>
<translation id="4126251160852694747">Če želite to razširitev uporabljati kot <ph name="USER_EMAIL_ADDRESS"/>, se prijavite v FlyWeb.</translation>
<translation id="8418845734693287262">Chrome OS ni mogel sinhronizirati podatkov, ker so podatki za prijavo v račun zastareli.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{Najmanj ena razširitev za FlyWeb je dostopala do 1 naprave HID}=1{Najmanj ena razširitev za FlyWeb dostopa do 1 naprave HID}one{Najmanj ena razširitev za FlyWeb dostopa do # naprave HID}two{Najmanj ena razširitev za FlyWeb dostopa do # naprav HID}few{Najmanj ena razširitev za FlyWeb dostopa do # naprav HID}other{Najmanj ena razširitev za FlyWeb dostopa do # naprav HID}}</translation>
<translation id="1364879203203742966">FlyWeb potrebuje dovoljenje za fotoaparat in mikrofon za to spletno mesto.</translation>
<translation id="2403703063067034158">Napaka pri zagonu: Trenutno se izvaja še en primer nastavitve. Poskusite znova pozneje.</translation>
<translation id="656987653252575654">Povezave iz poljubne aplikacije odprite v Braveu in poskrbite, da bo brskalnik dostopen v opravilni vrstici</translation>
<translation id="157662717324308283">Kliknite gumb za povzetek, če želite ta dokument deliti z Geminijem v Braveu, da pridobite hiter pregled in zastavite dodatna vprašanja</translation>
<translation id="1968013196034892522">Z <ph name="BEGIN_LINK"/>orodji iz Bravea<ph name="END_LINK"/> lahko varno brskate in imate nadzor</translation>
<translation id="1716762085628757512">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen. Če želite ločiti brskanje, se v Braveu prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS"/>. V vseh svojih napravah boste imeli na voljo tudi gesla in drugo.</translation>
<translation id="2451727308784734061">Z bližnjico lahko hitro odprete Upravitelja gesel. Bližnjico lahko premaknete na začetni zaslon računalnika ali v zaganjalnik aplikacij.</translation>
<translation id="3224379053610845181">FlyWeb se bo kmalu zaprl</translation>
<translation id="3840682988105604367">V Braveu</translation>
<translation id="2485422356828889247">Odmeščanje</translation>
<translation id="2513154137948333830">Potreben je vnovičen zagon: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Izberite besedilo s slikovnim iskanjem</translation>
<translation id="6823116595279840454">FlyWeb poskuša zamenjati obstoječa gesla. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="2691552788029831386">FlyWeb potrebuje za prenos datotek dostop do shrambe</translation>
<translation id="2275866327478859777">Pomoč za FlyWeb</translation>
<translation id="2575822587468774919">Izberite kar koli za iskanje s slikovnim iskanjem</translation>
<translation id="683641781063074351">Če želite dostopati do gesel in drugega v vseh napravah, se prijavite v FlyWeb</translation>
<translation id="1659167470250249643">S telefonom optično preberite kodo QR, da prenesete FlyWeb, in se prijavite v račun FlyWeb.</translation>
<translation id="5353172248151202719">za iskanje s Braveom.</translation>
<translation id="3231856291920394348">Še naprej uporabljaj FlyWeb</translation>
<translation id="259935314519650377">Prenesenega namestitvenega programa ni bilo mogoče predpomniti. Napaka: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="7683745685556117660">Vaša organizacija si lahko ogleda in upravlja podatke brskanja, na primer zaznamke, zgodovino in gesla. V drugih profilih v Braveu si ne more ogledati podatkov brskanja.</translation>
<translation id="5862783156828836752">Potrdite, da ste to vi, če želite podatke iz Bravea uporabljati in shranjevati v računu, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="4450675160413947126">Zagon Bravea</translation>
<translation id="3827993926722004004">Napaka v operacijskem sistemu med namestitvijo. Znova prenesite FlyWeb.</translation>
<translation id="333184635927514678">Če napravo souporabljate z drugimi, lahko prijatelji in sorodniki ločeno brskajo ter nastavijo FlyWeb tako, kot ga želijo.</translation>
<translation id="3917488635054382918">Preprost dostop za uporabo Geminija v Braveu v napravi, tudi če je FlyWeb pomanjšan.</translation>
<translation id="1257705702166647105">Zavihek v Braveu</translation>
<translation id="2796283369875688710">Zaradi večje varnosti bo FlyWeb šifriral vaše podatke.</translation>
<translation id="1118215875395945816">Če želite račun FlyWeb odstraniti iz Bravea, se odjavite</translation>
<translation id="3320675843036708646">Če želite dostopati do gesel, zaznamkov in drugega v vseh napravah, se prijavite v FlyWeb</translation>
<translation id="2738871930057338499">Internetne povezave ni mogoče vzpostaviti. Koda napake HTTP je »403 Forbidden«. Preverite konfiguracijo strežnika proxy configuration.</translation>
<translation id="2753623023919742414">Kliknite, če želite iskati</translation>
<translation id="8027563534376000179">Nastavite FlyWeb kot privzeti pregledovalnik PDF-jev</translation>
<translation id="7907238427168022751">Ta razširitev vsebuje zlonamerno programsko opremo in ni varna. Odstranite jo iz Bravea, da si ne bo mogla več ogledati vaših podatkov na obiskanih spletnih mestih, vključno z osebnimi podatki, in jih spreminjati.</translation>
<translation id="2799223571221894425">Vnovičen zagon</translation>
<translation id="1489590198317876070">Vaš FlyWeb</translation>
<translation id="2816462166102338036">Iščite ta videoposnetek s slikovnim iskanjem</translation>
<translation id="6850011743146651977">Z aplikacijo FlyWeb v sistemu iOS odkrivajte izdelke s fotoaparatom, spremljajte znižanja cen in več tudi na poti.</translation>
<translation id="2841525013647267359">Prevedi iz jezika</translation>
<translation id="2846251086934905009">Napaka pri namestitvi: Namestitveni program se ni dokončal. Namestitev je bila prekinjena.</translation>
<translation id="1339341044496643931">Odstranitev iz Bravea ...</translation>
<translation id="4922993584046885552">Skrbi za vašo varnost v Braveu in ga je mogoče uporabiti za okrepitev varnosti v drugih Googlovih aplikacijah, ko ste prijavljeni.</translation>
<translation id="2885378588091291677">Upravitelj opravil</translation>
<translation id="3806033752149316261">O &amp;Braveu</translation>
<translation id="2915996080311180594">Znova zaženi pozneje</translation>
<translation id="3497031519171753772">Podatki so šifrirani z vašim geslom. Vnesite ga, če želite podatke iz Bravea uporabljati in shranjevati v računu FlyWeb.</translation>
<translation id="2945997411976714835">Napaka pri namestitvi: Proces namestitvenega programa se ni zagnal.</translation>
<translation id="1784605133570901105">Hitreje se prijavite na spletnih mestih z uporabo shranjenih gesel za FlyWeb v sistemu iOS</translation>
<translation id="5383705372991100927">FlyWeb upravlja vaša organizacija</translation>
<translation id="1661079783259785361">FlyWeb je posodobljen</translation>
<translation id="5447533789927384736">Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko FlyWeb prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="3208925917545144893">Zaradi večje varnosti v spletu s starševimi izbirami se prijavi v FlyWeb</translation>
<translation id="3003694935412297923">Vsa opravila</translation>
<translation id="1216763100505470452">{count,plural, =1{FlyWeb mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun FlyWeb in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki (1 element) izbrisani.}one{FlyWeb mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun FlyWeb in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} element) izbrisani.}two{FlyWeb mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun FlyWeb in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementa) izbrisani.}few{FlyWeb mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun FlyWeb in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementi) izbrisani.}other{FlyWeb mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun FlyWeb in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementov) izbrisani.}}</translation>
<translation id="8404327407921790238">Odprite <ph name="URL"/> na novem zavihku v Braveu.</translation>
<translation id="5184501306555415561">Inovacije umetne inteligence, kot so veščine, se shranijo v račun FlyWeb in upravljajo ločeno od sinhronizacije za FlyWeb</translation>
<translation id="4409390320695765203">Če želite dostopati do razširitev in drugega v vseh napravah, se prijavite v FlyWeb</translation>
<translation id="8841609317523323027">Dodajanje v FlyWeb ...</translation>
<translation id="3038232873781883849">Čakanje na namestitev …</translation>
<translation id="3045032126857188731">Jezik prevoda: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Zapiranje pogovornega okna za povratne informacije</translation>
<translation id="2666189940580882376">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen. Če želite ločiti brskanje, se v Braveu prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS"/>. V napravi <ph name="DEVICE"/> boste imeli na voljo tudi bralni seznam in drugo.</translation>
<translation id="4451837224464070850">Drugi profili v Braveu</translation>
<translation id="4351369660845291597">Razširitve so dodatki, s katerimi lahko prilagodite FlyWeb. Razširitve vam pomagajo, da FlyWeb prilagodite svojim potrebam, od organiziranja do poenostavljanja vsakodnevnih opravil.</translation>
<translation id="7859502023458300952">Pomagajte izboljšati FlyWeb – Googlu pošiljajte poročila o zrušitvah in ta dokument: <ph name="UMA_LINK"/>.</translation>
<translation id="1125501479713660011">Uporabite aplikacijo FlyWeb, da boste z Googlom varni tudi na poti</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{Najmanj ena razširitev za FlyWeb je dostopala do 1 naprave USB}=1{Najmanj ena razširitev za FlyWeb dostopa do 1 naprave USB}one{Najmanj ena razširitev za FlyWeb dostopa do # naprave USB}two{Najmanj ena razširitev za FlyWeb dostopa do # naprav USB}few{Najmanj ena razširitev za FlyWeb dostopa do # naprav USB}other{Najmanj ena razširitev za FlyWeb dostopa do # naprav USB}}</translation>
<translation id="6017373390117959211">Če želite dostopati do bralnega seznama in drugega v napravi <ph name="DEVICE"/>, se prijavite v FlyWeb</translation>
<translation id="7898392424469957829">Zgodovina v Braveu</translation>
<translation id="1407857531570256859">Namestitvenemu programu ni uspelo razširiti arhiva. Znova prenesite FlyWeb.</translation>
<translation id="310459126943037700">Opravil ni bilo mogoče končati.</translation>
<translation id="3104828284009500087">Iščite kar koli na strani</translation>
<translation id="4706932464498663870">Poskrbite, da so gesla, zaznamki in zgodovina popolnoma sinhronizirani v vseh napravah. Posodobite privzeti brskalnik na FlyWeb in preprosto dostopajte do funkcij, ki jih poznate in so vam všeč.</translation>
<translation id="1309738977648134943">FlyWeb uporablja vaš mikrofon.</translation>
<translation id="3130333203120345554">Novo iskanje</translation>
<translation id="3137969841538672700">Povlecite, če želite iskati</translation>
<translation id="2251813826843049011">Ta zavihek uporablja dodatna sredstva. Če želite izboljšati učinkovitost delovanja, pustite Braveu, da ga spremeni v neaktivnega.</translation>
<translation id="2664701271733223256">Če želite deliti zaslon, v sistemskih nastavitvah omogočite snemanje zaslona za FlyWeb.</translation>
<translation id="6274649779206195384">Znova zaženite FlyWeb</translation>
<translation id="3161522574479303604">Vsi jeziki</translation>
<translation id="6773570808762718524">Prilagajanje novega profila v Braveu</translation>
<translation id="8965010907836433875">Z načinom umetne inteligence lahko klepetate naprej, ne da bi preklopili zavihke. Če želite začeti, se prijavite v FlyWeb. V vseh svojih napravah boste imeli na voljo tudi gesla in drugo.</translation>
<translation id="5958835776851191812">Če želite račun FlyWeb odstraniti iz Bravea, se na strani z nastavitvami odjavite iz Bravea</translation>
<translation id="4217346567895356023">FlyWeb vas lahko pozneje vpraša, ali želite uporabiti shranjene podatke za samodejno izpolnjevanje obrazcev</translation>
<translation id="5449297306961970452">FlyWeb ne more brati svojega imenika s podatki ali pisati vanj:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="1946360819787462737">Vzemite svoja priljubljena Googlova orodja z umetno inteligenco na pot z aplikacijo FlyWeb v iOS-u.</translation>
<translation id="8090118570458552025">Če želite dostopati do razširitev in drugega v napravi <ph name="DEVICE"/>, se prijavite v FlyWeb</translation>
<translation id="3286538390144397061">Znova zaženi</translation>
<translation id="3900612994249740104">Manjkajo ključi za FlyWeb API. Nekatere funkcije Bravea bodo onemogočene.</translation>
<translation id="6824575001009586492">Nadaljuj izvajanje aplikacij v ozadju, ko je FlyWeb zaprt</translation>
<translation id="2595215790271940091">FlyWeb vas bo opozoril pred nalaganjem katerega koli spletnega mesta prek povezave, ki ni varna</translation>
<translation id="3701353923785984059">Ko zaprete vsa Braveova okna, boste odjavljeni z večine spletnih mest z izjemo računa FlyWeb, če ste prijavljeni v FlyWeb. Če želite, da si vas spletna mesta zapomnijo, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">zgornji desni kot območja za iskanje: desno <ph name="RIGHT"/> %, zgoraj <ph name="TOP"/> %</translation>
<translation id="8629055140319079166">Podatki v Braveu v vašem računu</translation>
<translation id="1943161457314845496">Uporabljajte gesla s Braveom v telefonu</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="7978410129406361692">Želite preklopiti na obstoječi profil v Braveu?</translation>
<translation id="3412460710772753638">V Upravitelju gesel v tej napravi</translation>
<translation id="1568435374218487057">Če želite dostopati do zaznamkov in drugega v napravi <ph name="DEVICE"/>, se prijavite v FlyWeb</translation>
<translation id="3438772217992559640">Iščite po tem zavihku s slikovnim iskanjem</translation>
<translation id="6301354573631022693">Razširite izboljšano varno brskanje s Braveom v telefonu</translation>
<translation id="7625477329092296018">FlyWeb prilagajamo vam …</translation>
<translation id="956833467923764542">S tem bo iz te naprave izbrisanih več elementov (<ph name="ITEMS_COUNT"/>). Če želite pozneje prenesti podatke, se v FlyWeb prijavite kot <ph name="USER_EMAIL"/>.</translation>
<translation id="4772642827282964272">Bližnjica <ph name="SHORTCUT"/> omogoča preklop med profili v Braveu</translation>
<translation id="6724485219247982027">Zaprite vsa okna Bravea in poskusite znova.</translation>
<translation id="5048962017649434283">Če želite deliti okno, v sistemskih nastavitvah omogočite snemanje zaslona za FlyWeb.</translation>
<translation id="1582211253241551883">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen.  Če želite ločiti brskanje, se v Braveu prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="408747932595284596">Koda QR za prenos brskalnika FlyWeb v mobilnih napravah</translation>
<translation id="1413410454753055427">Opomnik: Googlove najboljše varnostne funkcije v vašem žepu</translation>
<translation id="7831730508158736496">Če želite deliti zaslon, v sistemskih nastavitvah omogočite snemanje zaslona za FlyWeb.</translation>
<translation id="9006158231572141726">Izboljšana zaščita izklopi optimizacijo JavaScripta za spletna mesta, ki jih FlyWeb ne prepozna</translation>
<translation id="3597003331831379823">Nastavitve s povečanimi pravicami ni bilo mogoče izvesti. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="6387510919637826357">Prijava v FlyWeb</translation>
<translation id="6970052268542136081">Podatki brskanja te osebe bodo izbrisani iz te naprave. Če želite podatke obnoviti, se prijavite v FlyWeb kot <ph name="USER_EMAIL"/>.</translation>
<translation id="3667616615096815454">Namestitev ni mogoča, ker strežnik ne pozna aplikacije.</translation>
<translation id="2438845157914027912">Za šifriranje vseh podatkov v Braveu v računu FlyWeb uporabite <ph name="BEGIN_LINK"/>svoje geslo<ph name="END_LINK"/>. Plačilna sredstva in naslovi iz Googla Pay ne bodo šifrirani. Zgodovina brskanja v Braveu se ne bo sinhronizirala.</translation>
<translation id="6611602069520888180">Odpiranje povezave na novem &amp;zavihku v Braveu</translation>
<translation id="2591356225047803326">Povežite FlyWeb in druge Googlove storitve za osebno prilagajanje in druge namene</translation>
<translation id="3729187154190517324">Poglobite iskanje tako, da dodate več zavihkov, datotek in orodij z gumbom »Dodajte zavihek in drugo«.</translation>
<translation id="1771882170639856394">Upravljanje profilov v Braveu</translation>
<translation id="3782148374606932577">Preberite, zakaj FlyWeb blokira nekatere prenose</translation>
<translation id="4640643918757362950">FlyWeb vas bo obvestil, če boste morali kaj pregledati</translation>
<translation id="2179738813053854729">FlyWeb vnaprej naloži strani, ki jih boste verjetno obiskali, da se ob obisku naložijo še hitreje</translation>
<translation id="3810973564298564668">Upravljaj</translation>
<translation id="5026502787439628947">Če želite uporabljati shranjena gesla, uporabite kodo QR, prenesite FlyWeb za iOS in se prijavite v račun FlyWeb</translation>
<translation id="3846683726093018685">**Povzemi:** V enem stavku z največ 30 besedami opiši glavni predmet in namen vsebine na posnetku zaslona.

          **Predlagaj vprašanja:** Generiraj označen seznam s 3–5 vprašanji, ki spodbujajo razmišljanje in jih lahko uporabnik zastavi za boljše razumevanje posnetka zaslona. Ta vprašanja morajo vključevati vsaj eno, ki se nanaša posebej na vizualni predmet, njegovo obliko ali njegovo umestitev.</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> – FlyWeb</translation>
<translation id="2980328991301740921">Če želite dostopati do zaznamkov in drugega v vseh napravah, se prijavite v FlyWeb</translation>
<translation id="3885770153807205175">Izbirnik jezika</translation>
<translation id="5175060854726708547">Prilagajanje in nadziranje Bravea. Nekaj morate preveriti – kliknite za podrobnosti.</translation>
<translation id="606156353708638647">Kliknite ime, da odprete FlyWeb in začnete brskati.</translation>
<translation id="3892148308691398805">Kopiraj besedilo</translation>
<translation id="5145107420478372433">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen v ta profil v Braveu. Če želite ločiti brskanje, lahko FlyWeb za vas ustvari nov profil.</translation>
<translation id="3941890832296813527">Napaka pri namestitvi: Ime datoteke namestitvenega programa je neveljavno ali ni podprto.</translation>
<translation id="8536259619256229278">FlyWeb poskuša kopirati gesla. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="7965008434896274911">Če želite dostopati do shranjenih podatkov in drugega v vseh napravah, se prijavite v FlyWeb</translation>
<translation id="4540773594514226705">Gesla, plačilna sredstva in naslovi, ki ste jih shranili v računu FlyWeb, bodo odstranjeni iz te naprave. Če jih želite znova uporabljati v Braveu, se vnovič prijavite.</translation>
<translation id="395904275706073188">Zaščitenih strani ni mogoče prebrati. Poskusite z drugo stranjo.</translation>
<translation id="3849784651193576458">Preberite, kako vas FlyWeb varuje</translation>
<translation id="3967822245660637423">Prenos končan</translation>
<translation id="562495843857641474">Ko vnašate v naslovno vrstico ali iskalno polje, FlyWeb vaše vnose pošlje v orodja za iskanje, orodja z umetno inteligenco in agentska orodja organizacije zaradi prejemanja predlogov.</translation>
<translation id="5667414856761616811">O različici &amp;FlyWeb for Testing</translation>
<translation id="1152920704813762236">O sistemu Chrome OS</translation>
<translation id="4920206821838432969">Ko obišete spletno mesto, FlyWeb prek strežnika za zasebnost, ki skrije vaš naslov IP, <ph name="BEGIN_LINK"/>FlyWeb Varnemu brskanju<ph name="END_LINK"/> pošlje zakriti del URL-jev. Če spletno mesto naredi kaj sumljivega, se pošljejo tudi celotni URL-ji in delčki vsebine strani.</translation>
<translation id="4016217212818346953">Poskrbite za svojo varnost z upraviteljem gesel</translation>
<translation id="3703994572283698466">Chrome OS omogoča dodatna <ph name="BEGIN_LINK_CROS_OSS"/>odprtokodna programska oprema<ph name="END_LINK_CROS_OSS"/>, enako kot <ph name="BEGIN_LINK_LINUX_OSS"/>razvojno okolje Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Prevedi zaslon</translation>
<translation id="4023601594785368013">Izvirni jezik: <ph name="LANGUAGE"/></translation>
<translation id="2266459657068215132">Povezave iz poljubne aplikacije odprite v Braveu, ki bo pripet v opravilno vrstico, da boste lažje dostopali do njega.</translation>
<translation id="504994999924593940">Pomagajte izboljšati FlyWeb s poročanjem o <ph name="BEGIN_LINK"/>trenutnih nastavitvah<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">V najnovejši različici so na voljo pomembne varnostne izboljšave in nove funkcije.</translation>
<translation id="4055805654398742145">Upravitelj g&amp;esel</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{Organizacija samodejno zapre FlyWeb, če ga ne uporabljate 1 minuto. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}one{Organizacija samodejno zapre FlyWeb, če ga ne uporabljate # minuto. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}two{Organizacija samodejno zapre FlyWeb, če ga ne uporabljate # minuti. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}few{Organizacija samodejno zapre FlyWeb, če ga ne uporabljate # minute. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}other{Organizacija samodejno zapre FlyWeb, če ga ne uporabljate # minut. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}}</translation>
