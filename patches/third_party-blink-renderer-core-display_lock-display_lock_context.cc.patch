+bool DisplayLockContext::DescendantIsAnchorTargetFromOutsideDisplayLock() {
+  for (auto* obj = element_->GetLayoutObject(); obj; obj = obj->Container()) {
+    if (const auto* ancestor_box = DynamicTo<LayoutBox>(obj)) {
