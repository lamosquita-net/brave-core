<translation id="651290634887454330">{0,plural, =0{FlyWeb አሁን ዳግም ይጀመራል}=1{FlyWeb በ1 ሰከንድ ውስጥ ዳግም ይጀመራል}one{FlyWeb በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}other{FlyWeb በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="2586408713760853791">FlyWeb ፋይሎችን ለማውረድ የማከማቻ መዳረሻ ፈቃድ ያስፈልገዋል</translation>
<translation id="1603558835003845196">በBrave ላይ በተከማቹ ደህንነታቸው ያልተጠበቁ ጣቢያዎች ዝርዝር ጋር ዩአርኤሎችን ይፈትሻል</translation>
<translation id="5751080530525677552">FlyWeb ነባሪውን አሳሽ ያድርጉ።</translation>
<translation id="6248988683584659830">የፍለጋ ቅንብሮች</translation>
<translation id="6342238100521499844">በመሄድ ላይ ሳሉ በስልክዎ ላይ በBrave መተግበሪያ የBraveን ምርጥ የደህንነት ባህሪያት ያግኙ</translation>
<translation id="3542157007113577464">ከBrave ተዘግቶ ይውጣ?</translation>
<translation id="2166321493116256664">እነዚህ ትሮች ተጨማሪ ንብረቶችን እየተጠቀሙ ነው። አፈፃፀምዎን ለማሻሻል FlyWeb እንዲያቦዝናቸው ይፍቀዱ።</translation>
<translation id="3794967601634523398">የBrave መገለጫዎን ያብጁ</translation>
<translation id="6475001900959697061">የBrave መገለጫዎን ይሰይሙ</translation>
<translation id="6356094940346377065">አንድ ቅጥያ ወደ FlyWeb እንዲገቡ ይፈልጋል</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> አደገኛ ሊሆን ስለሚችል FlyWeb አግዶታል።</translation>
<translation id="5523868569707953059">FlyWeb ካሜራዎን እየተጠቀመ ነው።</translation>
<translation id="8226838065217375546">ሌላ ሥርዓተ ክወና በBrave ላይ በሂደት ላይ ነው። እባክዎ ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="6063700568539132984">አሁን Braveን ከBrave መለያዎ ጋር እና በተጋሩ ኮምፒውተሮች ላይ መጠቀም ይበልጥ ቀላል ነው።</translation>
<translation id="5622088198573179705">Braveን እንደ ነባሪ አሳሽዎ በማቀናበር የሚያውቋቸውን፣ የሚወዷቸውን እና የሚያምኗቸውን ባህሪያት ቀላል መዳረሻ ያግኙ።</translation>
<translation id="4709797814274745581">የBrave አቋራጭ</translation>
<translation id="6595693843242836271">ፋይሉ በተለምዶ ስላማይወርድ እና አደገኛ ሊሆን ስለሚችል FlyWeb ይህን ውርድ አግዷል</translation>
<translation id="6890209090736444656">እርግጠኛ ነዎት Braveን ማራገፍ ይፈልጋሉ?</translation>
<translation id="6375219077595103062">ለየሚስጥር ቁልፍ አስተዳዳሪ አቋራጭ ያክሉ</translation>
<translation id="6388799252195623474">በዚህ አግዘኝ</translation>
<translation id="8407518452288816185">ለመቀጠል እንደ <ph name="EMAIL"/> ወደ FlyWeb ይግቡ። ይህ የድርጅትዎ መመሪያዎች እንዳሉዎት ያረጋግጣል።</translation>
<translation id="2104550252781001709">በኮምፒውተር ማያ ገፅ ውስጥ የBrave ዓርማ።</translation>
<translation id="6636986997730784876">FlyWeb ድረ-ገጾችን እና መተግበሪያዎችን እጅግ በጣም ፈጣን በሆነ ፍጥነት የሚያሄድ ድር አሳሽ ነው። ፈጣን፣ የረጋ እና ለመጠቀም ቀላል ነው። FlyWeb ውስጥ አብሮ በተሰራላቸው የተንኮል-አዘል ሶፍትዌር እና የማስገሪያ መከላከያዎች አማካኝነት ደህንነትዎ ይበልጥ በተጠበቀ ሁኔታ ድሩን ያስሱ።</translation>
<translation id="4359872290500912570">በBrave መለያዎ ውስጥ የBrave ውሂብን ሁልጊዜ መጠቀም እና ማስቀመጥ መቻልዎን ለማረጋገጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="3141715584864891679">FlyWeb ይበልጥ በፍጥነት ያሄዳል እና ጃቫስክሪፕት የሚጠቀሙ ባህሪያት እንደተነደፉት መስራት አለባቸው</translation>
<translation id="6436260184216827876">የምስል ፍለጋ አይገኝም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="2139300032719313227">ChromeOSን ዳግም አስጀምር</translation>
<translation id="7560906925528428585">እርስዎ የመጎብኘት ዕድልዎ ከፍተኛ የሆኑባቸው ተጨማሪ ገጾች ሲጎበኟቸው ይበልጥ በፍጥነት እንዲጫኑ FlyWeb በቅድሚያ ይጭናቸዋል</translation>
<translation id="5806916401157869650">ዋጋዎችን ለመከታተል እና ዋጋው በማንኛውም ጣቢያ ላይ ሲቀንስ ማንቂያዎችን ለማግኘት Braveን በስልክዎ ላይ ያውርዱ</translation>
<translation id="2970877059928503461">ጠፍቷል • FlyWeb ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም</translation>
<translation id="173462352822069427">ወደ FlyWeb መገለጫዎች እንኳን በደህና መጡ</translation>
<translation id="8914008746092110409">በሚቀጥለው ጊዜ Braveን በእርስዎ <ph name="DEVICE_TYPE"/> ላይ ሲከፍቱ፣ የትር ቡድኖችን ለመጠቀም ጥያቄ ያያሉ።</translation>
<translation id="3484308111967198595">መለያን ከBrave አስወግድ</translation>
<translation id="1474676525193357364">እንዲሁም Braveን ሲጀምሩት የሚታየውን ገፅ ይቆጣጠራል።</translation>
<translation id="648319183876919572">የተሻሻለ የደህንነት አሰሳ እርስዎን ከአደገኛ ድር ጣቢያዎች እና ውርዶች ለመጠበቅ ይበልጥ ያደርጋል</translation>
<translation id="5777905264835557372">Braveን ያራግፉ</translation>
<translation id="764623543427374554">አቋራጮች በBrave ውስጥ ይከፍታሉ</translation>
<translation id="8852057261917278552">ድርጅትዎ FlyWeb ለ<ph name="TIMEOUT_DURATION"/> ያህል ሥራ ላይ ሳይውል ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።</translation>
<translation id="8592211619057897362">እያንዳንዱ መገለጫ እንደ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎችም ያሉ የራሱ የBrave መረጃዎችን ይይዛል</translation>
<translation id="6556755379298048869">በቁልፍ ሰሌዳ አቋራጭ ይፈልጉ።</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb እንዴት የእርስዎን ውሂብ በግል እንደሚያስቀምጥ<ph name="END_LINK"/> የበለጠ ይወቁ</translation>
<translation id="654107331777480705">አንዴ FlyWeb እንደገና ከጀመረ በኋላ በዚህ ቅንብር ላይ ያሉ ለውጦች ይተገበራሉ።</translation>
<translation id="3594828538355548672">በBrave ዋና ምናሌ ውስጥ ቅጥያዎች የሚለውን ጠቅ በማድረግ ቅጥያዎችዎን ያስተዳድሩ።</translation>
<translation id="7489092380688543560">ከሌላ የBrave መገለጫ የይለፍ ቃላትን ለማየት መቀየር ይችላሉ</translation>
<translation id="472958395762114471">በመሄድ ላይ ሳሉ ምርጥ የሰው ሠራሽ አስተውሎት መሣሪያዎችን ለመውሰድ የBrave መተግበሪያን ይጠቀሙ</translation>
<translation id="8243012192239086369">የሥርዓተ ፊደል አጻጻፍ ስህተቶችን ለማስተካከል፣ FlyWeb እርስዎ በጽሁፍ መስኮች ውስጥ የሚተይቡትን ጽሁፍ ወደ FlyWeb ይልካል</translation>
<translation id="3927263773110604886">ወደ የBrave ማሳወቂያ ቅንብሮች ይሂዱ</translation>
<translation id="6600016381025017075">በዚህ ገጽ ላይ ማንኛውንም ነገር ይፈልጉ</translation>
<translation id="6888846095017247017">ለውጦችዎ FlyWeb በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="4481788155537463533">አሁን ላይ Windows ሲጀምር FlyWeb ይጀመራል ስለዚህ እርስዎ በቅጽበት ማሰስ መጀመር ይችላሉ። ይህን በቅንብሮች ውስጥ ማጥፋት ይችላሉ።</translation>
<translation id="1116311888485102603">ካቆሙበት ይቀጥሉ፦ FlyWeb የእርስዎን ትሮች ከመጨረሻው ክፍለ ጊዜዎ ወደነበሩበት ይመልሳል። ይህን የሚከተለው ውስጥ ማጥፋት ይችላሉ</translation>
<translation id="1886169834787876002">FlyWeb የዙሪያዎን የ3ል ካርታ ለመፍጠር የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="7570986009744020649">እንዲሁም ዕልባቶችዎን በእርስዎ FlyWeb መለያ ውስጥ ካስቀመጡ FlyWeb ውስጥ የምርት ዋጋዎችን መከታተል እና ዋጋው ሲቀንስ ማሳወቂያ ማግኘት ይችላሉ</translation>
<translation id="6676384891291319759">በይነመረብን ተዳረስ</translation>
<translation id="1363996462118479832">በመለያ ሲገባ በነበረ ስህተት ምክንያት &amp;ChromeOS ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="5743696427773796626">የዚህን መተግበሪያ ውሂብ ከBrave ላይ ያስወግዱ</translation>
<translation id="4152880912192471857">FlyWeb ለዚህ ጣቢያ የማይክሮፎን ፈቃድ ያስፈልገዋል</translation>
<translation id="6712881677154121168">የማውረድ ስህተት፦ <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">መገለጫዎ ከአዲስ የBrave ስሪት ስለሆነ የመጣው ሥራ ላይ ሊውል አይችልም።

አንዳንድ ባህሪያት ላይገኙ ይችላሉ። እባክዎ የተለየ የመገለጫ አቃፊ ይግለጹ ወይም ይበልጥ አዲስ የሆነ የBrave ስሪት ይጠቀሙ።</translation>
<translation id="5528558621229392814">ግላዊነት ማላበስን እና ሌሎች ባህሪያትን ለማግኘት Braveን በድር እና በመተግበሪያ እንቅስቃሴ እና በተገናኙ የBrave አገልግሎቶች ውስጥ ያካትቱ</translation>
