<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="1026101648481255140">បន្តការដំឡើង</translation>
<translation id="7099479769133613710">ចាប់ផ្តើម​ឡើងវិញ​ដើម្បីដំឡើងកំណែ &amp;ChromeOS</translation>
<translation id="291426170030461697">FlyWeb ណែនាំឱ្យអ្នកពិនិត្យមើលកម្មវិធីបន្ថែម​នេះ</translation>
<translation id="1549005488226693697">នៅ​ពេល​គេហទំព័រ​ស្នើសុំ​ផ្ទុកតំណ​ជា​មុន​ក្នុងលក្ខណៈ​ឯកជន​នៅ​លើ​ទំព័រ​របស់​គេហទំព័រនេះ FlyWeb ប្រើ​ម៉ាស៊ីនមេ FlyWeb។ ការធ្វើ​បែបនេះ​លាក់​អត្តសញ្ញាណ​របស់​អ្នក​ពី​គេហទំព័រ​ដែល​បាន​ផ្ទុក​ជា​មុន ប៉ុន្តែ​ FlyWeb សិក្សា​អំពី​គេហទំព័រ​អ្វីខ្លះដែលត្រូវបាន​ផ្ទុក​ជា​មុន។</translation>
<translation id="1065672644894730302">ចំណូលចិត្តរបស់អ្នកមិនអាចអានបានទេ។

លក្ខណៈពិសេសមួយចំនួនប្រហែលជាមិនមាន ហើយការប្តូរទៅចំណូលចិត្តនឹងមិនត្រូវបានរក្សាទុកទេ។</translation>
<translation id="8908267645832965492">មាតាបិតា​របស់អ្នក​បានបិទ "ការអនុញ្ញាត​សម្រាប់​គេហទំព័រ កម្មវិធី និង​កម្មវិធី​បន្ថែម" ចំពោះ FlyWeb</translation>
<translation id="6896681084876612310">FlyWeb អាច​ជួយរក្សាសុវត្ថិភាពរបស់អ្នកពី​ការបែកធ្លាយ​ទិន្នន័យ កម្មវិធីបន្ថែម​ដែលមានបញ្ហា និង​អ្វីៗជាច្រើនទៀត</translation>
<translation id="1368460307421081773">FlyWeb ចង់​នាំ​ចេញពាក្យ​សម្ងាត់​របស់អ្នក។ សូមវាយ​បញ្ចូលពាក្យ​សម្ងាត់ Windows របស់អ្នក​ដើម្បីអនុញ្ញាត​ការនាំចេញ​នេះ។</translation>
<translation id="7307912249127683931">FlyWeb គឺជា​កម្មវិធីរុករក​តាមអ៊ីនធឺណិត​លំនាំដើម​របស់​អ្នក</translation>
<translation id="4556715463645168547">ដើម្បីពិនិត្យមើលថា​តើពាក្យសម្ងាត់​របស់អ្នក​មានសុវត្ថិភាពពី​ការបែកធ្លាយ​ទិន្នន័យ និងបញ្ហាសុវត្ថិភាព​ផ្សេងទៀតឬអត់ សូម​<ph name="BEGIN_LINK"/>ចូល FlyWeb<ph name="END_LINK"/>។</translation>
<translation id="2076135703183650206">ចុច​ម៉ឺនុយ FlyWeb</translation>
<translation id="1184145431117212167">ការដំឡើងមិនបានសម្រេចទេ ដោយសារកំណែ Windows របស់អ្នកមិនអាចប្រើបាន។</translation>
<translation id="4380351562011537903">អំពី FlyWeb</translation>
<translation id="2593084789070248821">ដើម្បី​បង្ហាញ​វិនដូ​របស់អ្នក សូម​អនុញ្ញាតឱ្យ FlyWeb ថតវីដេអូ​អេក្រង់​នៅក្នុង "ចំណូលចិត្ត​ប្រព័ន្ធ"។</translation>
<translation id="1203500561924088507">សូមអរគុណសម្រាប់ការដំឡើង។ អ្នកត្រូវតែចាប់ផ្ដើមកម្មវិធីរុករកតាមអ៊ីនធឺណិតរបស់អ្នកឡើងវិញ មុនពេលប្រើ <ph name="BUNDLE_NAME"/>។</translation>
<translation id="4750836834956739196">នៅពេលផ្ទាំងនេះអសកម្ម អង្គចងចាំត្រូវបានសម្អាត ដើម្បីរក្សា FlyWeb ឱ្យដើរលឿន។ អ្នកអាចជ្រើសរើសដកគេហទំព័រនេះចេញពីភាពអសកម្មបានជានិច្ច។</translation>
<translation id="3190759351483708314">FlyWeb បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារនេះ​មានគ្រោះថ្នាក់</translation>
<translation id="5879469261638423015">នៅពេល​ចូល​សេវាកម្ម FlyWeb ដូចជា Gmail ឬ YouTube ដោយប្រើ <ph name="USER_EMAIL"/> អ្នកអាច​ចូល FlyWeb ដោយ​ស្វ័យប្រវត្តិ ដោយប្រើ​គណនី​តែមួយ</translation>
<translation id="1290883685122687410">បញ្ហា​ក្នុងការរៀបចំ៖ <ph name="METAINSTALLER_EXIT_CODE"/>។ <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">រៀបចំ​កម្រងព័ត៌មាន FlyWeb ថ្មី​របស់អ្នក</translation>
<translation id="609743863669742325">FlyWeb ត្រូវការសិទ្ធិចូលប្រើប៊្លូធូស ដើម្បីរុករកឧបករណ៍​ប៊្លូធូស។ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
