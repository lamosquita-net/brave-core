+void RTCDataChannel::RegisterObserver() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  is_transferable_ = false;
+
+  // Do not connect if `this` was transferred, as it should be going away soon.
+  if (was_transferred_) {
