@@ -34,9 +34,26 @@ public:
         SkUNREACHABLE;
     }
 
-    Glyph(SkPackedGlyphID packedGlyphID) : fPackedID(packedGlyphID) {}
+    // A glyph lives in the atlas of one mask format. The same SkPackedGlyphID can be drawn by
+    // sub runs of different formats, so the format is part of the key (crbug 491421267).
+    struct Key {
+        Key(SkPackedGlyphID id, skgpu::MaskFormat format) : fPackedID(id), fMaskFormat(format) {}
+
+        SkPackedGlyphID fPackedID;
+        skgpu::MaskFormat fMaskFormat;
+
+        bool operator==(const Key& that) const {
+            return fPackedID == that.fPackedID && fMaskFormat == that.fMaskFormat;
+        }
+        uint32_t hash() const { return fPackedID.hash(); }
+    };
+
+    Glyph(SkPackedGlyphID packedGlyphID, skgpu::MaskFormat maskFormat)
+            : fPackedID(packedGlyphID), fMaskFormat(maskFormat), fKey(packedGlyphID, maskFormat) {}
 
     const SkPackedGlyphID       fPackedID;
+    const skgpu::MaskFormat     fMaskFormat;
+    const Key                   fKey;
     skgpu::AtlasLocator         fAtlasLocator;
 };
 
