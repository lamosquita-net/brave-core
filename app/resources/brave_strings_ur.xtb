<translation id="6903827847227122616">‏HTTPS دستیاب نہ ہونے پر، FlyWeb آپ کو وارننگ دیے بغیر ایک غیر محفوظ کنکشن استعمال کرے گا</translation>
<translation id="307170399141486420">‏FlyWeb کو پس منظر میں چلنے دیں</translation>
<translation id="543905389684998697">‏FlyWeb کو محفوظ تر بنانے کیلئے، ہم نے کچھ ایکسٹینشنز کو غیر فعال کر دیا ہے جو <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> میں مندرج نہیں ہیں اور ہو سکتا ہے ان کو آپ کے علم کے بغیر شامل کیا گیا ہو۔</translation>
<translation id="5006568136491721884">‏فوری رسائی کے لیے FlyWeb کو اپنے ٹاسک بار میں پن کرنے کی خاطر ونڈو اطلاع میں <ph name="BEGIN_BOLD"/>ہاں<ph name="END_BOLD"/> پر کلک کریں۔</translation>
