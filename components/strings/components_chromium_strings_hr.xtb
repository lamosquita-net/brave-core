<translation id="130631256467250065">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete uređaj.</translation>
<translation id="1555506416658437797">urediti načine plaćanja.</translation>
<translation id="8359495463485001719">Prijavljivanje padova nije dostupno u pregledniku FlyWeb.</translation>
<translation id="6338530717474923868">Gledate sigurnu stranicu Bravea</translation>
<translation id="5147169001159408844">FlyWeb pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="5702992568540613683">Logotip Bravea</translation>
<translation id="510342522494506803">FlyWeb pokušava urediti načine plaćanja.</translation>
<translation id="8375862260948854624">FlyWeb omogućuju projekt utemeljen na otvorenom kôdu <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> i drugi <ph name="BEGIN_LINK_OSS"/>softveri utemeljeni na otvorenom kôdu<ph name="END_LINK_OSS"/>.</translation>
<translation id="4281953335231207224">Idite na
          izbornik FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Postavke LAN-a
          i poništite odabir potvrdnog okvira "Upotrijebi proxy poslužitelj za LAN".</translation>
<translation id="5040124620086808431">FlyWeb je blokirao ovu stranicu</translation>
<translation id="1953000035868532675">U postavkama vatrozida ili antivirusnog programa omogućite Braveu da pristupa mreži.</translation>
<translation id="3442058224540562441">Idite na
          izbornik FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          i provjerite je li konfiguracija postavljena na "bez proxyja" ili "izravno".</translation>
<translation id="585620188971323280">izmjena postavki za popunjavanje načina plaćanja.</translation>
<translation id="2681118099728446983">FlyWeb je omogućio i drugi <ph name="BEGIN_LINK_OSS"/>softver otvorenog izvornog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="6888846095017247017">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete FlyWeb.</translation>
<translation id="1017070759373671177">FlyWeb je omogućio <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>, projekt otvorenog izvornog koda.</translation>
<translation id="7777112741998051633">Otvorite
        izbornik Bravea &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        pa poništite odabir stavke "<ph name="NO_PREFETCH_DESCRIPTION"/>".
        Ako se time ne riješi poteškoća, preporučujemo da ponovo odaberete tu opciju
        radi bolje izvedbe.</translation>
<translation id="8187289872471304532">Idite na
          Aplikacije &gt; Postavke sustava &gt; Mreža &gt; Napredno &gt; Proxy poslužitelji
          i poništite odabir proxy poslužitelja.</translation>
<translation id="4699594416850504200">Pregledavate sigurnu stranicu FlyWeb for Testing</translation>
<translation id="6224789938625024797">FlyWeb se nije ispravno zatvorio.</translation>
