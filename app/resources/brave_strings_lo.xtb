<translation id="5605834417512968703">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກຄຸນສົມບັດນີ້</translation>
<translation id="5618818588972826921">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="6096945112863785306">{0,plural, =0{ມີການອັບເດດ FlyWeb}=1{ມີການອັບເດດ FlyWeb}other{ມີການອັບເດດ FlyWeb ເປັນເວລາ # ມື້ແລ້ວ}}</translation>
<translation id="7698117871740446964">ລຶບຂໍ້ມູນເວັບໄຊຈາກອຸປະກອນຂອງທ່ານທຸກເທື່ອທີ່ທ່ານປິດ FlyWeb</translation>
<translation id="5666891644992637849">ກະລຸນາປິດເປີດ FlyWeb ຄືນໃໝ່ຕອນນີ້</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">ສະ​ແດງ FlyWeb ເປັນພາສານີ້</translation>
<translation id="569897634095159764">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ພຣັອກຊີເຊີບເວີຕ້ອງມີການພິສູດຢືນຢັນ.</translation>
<translation id="5406894461513282158">FlyWeb ຈະເພີ່ມໜ່ວຍຄວາມຈຳຈາກແຖບທີ່ບໍ່ໄດ້ນຳໃຊ້. ເຊິ່ງນີ້ເຮັດໃຫ້ແຖບທີ່ນຳໃຊ້ຢູ່ ແລະ ແອັບອື່ນໆມີຊັບພະຍາກອນສຳລັບຄອມພິວເຕີເພີ່ມຂຶ້ນ ແລະ ຊ່ວຍໃຫ້ FlyWeb ເຮັດວຽກໄດ້ໄວ. ແຖບທີ່ບໍ່ມີການນຳໃຊ້ຂອງທ່ານຈະກັບມາເຮັດວຽກໂດຍອັດຕະໂນມັດອີກຄັ້ງເມື່ອທ່ານກັບຄືນໄປຫາແຖບເຫຼົ່ານັ້ນ. <ph name="BEGIN_LINK"/>ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດໜ່ວຍຄວາມຈຳ<ph name="END_LINK"/></translation>
<translation id="4909672456103357452">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງທ່ານ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, <ph name="SETTINGS_LINK"/> ຂໍ້ມູນ FlyWeb ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="4985665094509307744">ປັບແຕ່ງ ແລະ ຄວບຄຸມ FlyWeb. ຕັ້ງ FlyWeb ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="6646499372922411025">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບໂດຍຕັ້ງ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="5809516625706423866">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 401 ບໍ່ໄດ້ຮັບອະນຸຍາດ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="5890196138054330443">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ FlyWeb ແຕ່ເຮັດໃຫ້ FlyWeb ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ປິດຢູ່.</translation>
<translation id="8651664269417935890">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ FlyWeb ໃນບັນຊີ FlyWeb ຂອງທ່ານ, ກະລຸນາອັບເດດ FlyWeb</translation>
<translation id="5824893331272123205">ບໍ່ສາມາດໂຫຼດແຜງນີ້ໄດ້, ກະລຸນາລອງໃໝ່</translation>
<translation id="8331941171144629807">ຍິນ​ດີ​ຕ້ອນ​ຮັບສູ່ FlyWeb</translation>
<translation id="5831968418530309689">ເປີດຄຸນສົມບັດເພີ່ມເຕີມເພື່ອໃຫ້ການປົກປ້ອງທີ່ເຂັ້ມງວດທີ່ສຸດຂອງ FlyWeb</translation>
<translation id="5871205389137001634">ຄລິກເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="7581082856615467651">FlyWeb ພົບວ່າລາຍການເຫຼົ່ານີ້ມີເມົາແວ:</translation>
<translation id="8117102597407263352">FlyWeb ຈະກວດສອບເປັນປະຈຳເພື່ອໃຫ້ແນ່ໃຈວ່າໂປຣແກຣມທ່ອງເວັບຂອງທ່ານມີການຕັ້ງຄ່າທີ່ປອດໄພທີ່ສຸດ. ພວກເຮົາຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີຫຍັງທີ່ຕ້ອງໃຫ້ທ່ານກວດສອບ.</translation>
<translation id="5895138241574237353">ເລີ່ມຕົ້ນໃໝ່</translation>
<translation id="7740963625398321937">Gemini Enterprise ໃນ FlyWeb</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ</translation>
<translation id="5924017743176219022">ກຳ​ລັງ​ເຊື່ອມ​ຕໍ່​ອິນ​ເຕີ​ເນັດ...</translation>
<translation id="5941711191222866238">ຫຍໍ້ລົງ</translation>
<translation id="6669708050135513710">ເພື່ອຮັບເອົາບຸກມາກນີ້ ແລະ ອື່ນໆອີກໃນທຸກອຸປະກອນຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb</translation>
<translation id="3358004031263458708">ເຮັດໃຫ້ FlyWeb ເປັນຂອງທ່ານ</translation>
<translation id="5960071705175224773">ແອັບທີ່ບໍ່ຮູ້ຈັກປ່ຽນການຕັ້ງຄ່າຂອງທ່ານ</translation>
<translation id="5977420883993828287">ປັກໝຸດແລ້ວ! ໃຊ້ໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="348384176991400026">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ FlyWeb ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ.}other{ອົງກອນຂອງທ່ານຈະປິດ FlyWeb ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ.}}</translation>
<translation id="4955869506208896934">ອັບເດດ FlyWeb ເພື່ອເລີ່ມຊິ້ງຂໍ້ມູນ</translation>
<translation id="5990360079535151574">ຈາກປຸ່ມ "ໜ້າວຽກຕາມບໍລິບົດ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6003112304606738118">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="HOURS"/> ຊົ່ວໂມງ</translation>
<translation id="6009821354356307391">ຂໍການຕິດຕາມຜົນ</translation>
<translation id="6040143037577758943">ປິດ</translation>
<translation id="4530644097272078700">ໃຊ້ປະໂຫຍດເພີ່ມເຕີມຈາກການຊື້ເຄື່ອງອອນລາຍເມື່ອທ່ານໃຊ້ແອັບ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ</translation>
<translation id="619330138913595431">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ອະນຸຍາດໃຫ້ FlyWeb ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. ແຕ່ບໍ່ຢຸດການແຈ້ງເຕືອນ.</translation>
<translation id="8714139918792771260">&amp;ເປີດໃນ FlyWeb</translation>
<translation id="6069027071882229820">ສຳເນົາເປັນຮູບ</translation>
<translation id="499541338626558192">ເພີ່ມ <ph name="EXTENSION_NAME"/> ໃສ່ FlyWeb ແລ້ວ</translation>
<translation id="5880307616068888895">ປັບແຕ່ງ ແລະ ຄວບຄຸມ FlyWeb. ມີການອັບເດດແລ້ວ</translation>
<translation id="1429530657225981960">ເປີດ • FlyWeb ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="8056369489402655495">ບັນຊີຂອງທ່ານໃນ FlyWeb</translation>
<translation id="1683225514126450592">ອະນຸຍາດໃຫ້ສ່ວນຂະຫຍາຍສະແດງຄຳຮ້ອງຂໍສິດເຂົ້າເຖິງໃນແຖບເຄື່ອງມື FlyWeb</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> ອັນຕະລາຍ, ສະນັ້ນ FlyWeb ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="1773252983747911987">FlyWeb ຈະປິດ ແລະ ລຶບຂໍ້ມູນໃນໄວໆນີ້</translation>
<translation id="1686760912855738719">ທ່ານສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ FlyWeb ໄດ້ຢູ່ບ່ອນນີ້</translation>
<translation id="5461795497268691356">ຫາກທ່ານອະນຸຍາດໃຫ້ໃຊ້ຄຸກກີ້ໄດ້, FlyWeb ອາດໃຊ້ພວກມັນເມື່ອໂຫຼດກ່ອນລ່ວງໜ້າ</translation>
<translation id="6165508094623778733">ສຶກສາ​ເພີ່ມ​ເຕີມ</translation>
<translation id="1292852397592425449">ລຶບລ້າງຂໍ້ມູນ FlyWeb ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="7031783851441272920">ໄຟລ໌ນີ້ອາດເປັນອັນຕະລາຍ<ph name="LINE_BREAK"/>FlyWeb ສາມາດກວດສອບການດາວໂຫຼດນີ້ໃຫ້ທ່ານໄດ້ຫາກທ່ານລະບຸລະຫັດຜ່ານ. ຂໍ້ມູນກ່ຽວກັບໄຟລ໌ຈະຖືກສົ່ງໄປຫາ Google Safe Browsing, ແຕ່ເນື້ອຫາໄຟລ໌ ແລະ ລະຫັດຜ່ານຈະຍັງຢູ່ໃນອຸປະກອນຂອງທ່ານ.</translation>
<translation id="6182736845697986886">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດເກີດຂໍ້ຜິດພາດພາຍໃນ.</translation>
<translation id="4403968929742079769">ກວດໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບ FlyWeb ໃນ <ph name="TARGET_DEVICE_NAME"/> ຂອງທ່ານ ແລ້ວລອງສົ່ງໃໝ່.</translation>
<translation id="8345188246355148375">ຊອກຫາ ແລະ ຖາມຄຳຖາມໄດ້ຈາກທຸກບ່ອນ, ເຖິງແມ່ນວ່າຈະຫຍໍ້ FlyWeb ຢູ່. ອະນຸຍາດໃຫ້ FlyWeb ເຮັດວຽກໃນພື້ນຫຼັງ.</translation>
<translation id="1855179706668101462">ຄອມພິວເຕີນີ້ມີ FlyWeb ລຸ້ນໃໝ່ກ່ວາຢູ່ຮຽບຮ້ອຍແລ້ວ. ຖ້າຊອບແວບໍ່ເຮັດວຽກ, ກະລຸນາຖອນຕິດຕັ້ງ FlyWeb ແລະລອງໃໝ່ອີກ.</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb ຈະເປີດຄືນໃໝ່ດຽວນີ້}=1{FlyWeb ຈະເປີດຄືນໃໝ່ໃນ 1 ວິນາທີ}other{FlyWeb ຈະເປີດຄືນໃໝ່ໃນ # ວິນາທີ}}</translation>
<translation id="2586408713760853791">FlyWeb ຕ້ອງການການອະນຸຍາດເຂົ້າເຖິງບ່ອນຈັດເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="1603558835003845196">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ FlyWeb</translation>
<translation id="5751080530525677552">ເຮັດ FlyWeb ເປັນບຣາວ​ເຊີມາດຕະຖານ</translation>
<translation id="6248988683584659830">ການຕັ້ງຄ່າຄົ້ນຫາ</translation>
<translation id="6342238100521499844">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ FlyWeb ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ FlyWeb ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="3542157007113577464">ອອກຈາກລະບົບ FlyWeb ບໍ?</translation>
<translation id="2166321493116256664">ແຖບເຫຼົ່ານີ້ໃຊ້ຊັບພະຍາກອນຫຼາຍເປັນພິເສດ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ກະລຸນາໃຫ້ FlyWeb ຊ່ວຍປິດນຳໃຊ້ແຖບເຫຼົ່ານີ້.</translation>
<translation id="3794967601634523398">ປັບແຕ່ງໂປຣໄຟລ໌ FlyWeb ຂອງທ່ານ</translation>
<translation id="6475001900959697061">ຕັ້ງຊື່ໂປຣໄຟລ໌ FlyWeb ຂອງທ່ານ</translation>
<translation id="6356094940346377065">ສ່ວນຂະຫຍາຍຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ FlyWeb</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> ອາດຈະອັນຕະລາຍ, ສະນັ້ນ FlyWeb ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="5523868569707953059">FlyWeb ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບຂອງ​ທ່ານ​.</translation>
<translation id="8226838065217375546">ການດຳເນີນການອື່ນໃນ FlyWeb ພວມດຳເນີນຢູ່. ກະລຸນາລອງອີກຄັ້ງໃນພາຍຫຼັງ.</translation>
<translation id="6063700568539132984">ດຽວນີ້ມັນງ່າຍທີ່ຈະໃຊ້ FlyWeb ກັບບັນຊີ FlyWeb ຂອງທ່ານ ແລະຢູ່ໃນຄອມພິວເຕີທີ່ແຊຣ໌ແລ້ວ.</translation>
<translation id="5622088198573179705">ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ, ມັກ ແລະ ໄວ້ວາງໃຈໄດ້ຢ່າງງ່າຍດາຍໂດຍການຕັ້ງຄ່າ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="4709797814274745581">ທາງລັດ FlyWeb</translation>
<translation id="6595693843242836271">FlyWeb ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="6890209090736444656">ທ່ານແນ່ໃຈບໍວ່າ ທ່ານຕ້ອງການຖອນຕິດຕັ້ງ FlyWeb?</translation>
<translation id="6375219077595103062">ເພີ່ມທາງລັດໃສ່ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="6388799252195623474">ຊ່ວຍຂ້ອຍໃນເລື່ອງນີ້</translation>
<translation id="8407518452288816185">ເພື່ອສືບຕໍ່, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb ດ້ວຍ <ph name="EMAIL"/>. ການດຳເນີນການນີ້ຈະກວດສອບວ່າທ່ານມີນະໂຍບາຍຂອງອົງກອນຂອງທ່ານແລ້ວ.</translation>
<translation id="2104550252781001709">ໂລໂກ້ FlyWeb ພາຍໃນໜ້າຈໍຄອມພິວເຕີ.</translation>
<translation id="6636986997730784876">FlyWeb ແມ່ນບຣາວເຊີເວັບທີ່ແລ່ນໜ້າເວັບ ແລະແອັບພລິເຄຊັນດ້ວຍຄວາມໄວແບບສາຍຟ້າແມັບ. ມັນໄວ, ໝັ້ນຄົງ, ແລະໃຊ້ງ່າຍ. ທ່ອງເວັບໄດ້ປອດໄພກ່ວາດ້ວຍການປົກປ້ອງມາລແວ ແລະພິຊຊິງທີ່ສ້າງຢູ່ໃນຕົວ FlyWeb.</translation>
<translation id="4359872290500912570">ເພື່ອກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານສາມາດໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ FlyWeb ໃນບັນຊີ FlyWeb ຂອງທ່ານໄດ້ຕະລອດເວລາ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="3141715584864891679">FlyWeb ເຮັດວຽກໄດ້ໄວຂຶ້ນ ແລະ ຄຸນສົມບັດທີ່ໃຊ້ JavaScript ຄວນເຮັດວຽກຕາມທີ່ອອກແບບໄວ້</translation>
<translation id="6436260184216827876">ການຊອກຫາຮູບບໍ່ພ້ອມນຳໃຊ້. ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ.</translation>
<translation id="2139300032719313227">ຣີສະຕາດ ChromeOS</translation>
<translation id="7560906925528428585">FlyWeb ໂຫຼດໜ້າເວັບໄວ້ກ່ອນລ່ວງໜ້າເພີ່ມຫຼາຍຂຶ້ນສຳລັບໜ້າທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="5806916401157869650">ດາວໂຫຼດ FlyWeb ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອຕິດຕາມລາຄາ ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໃນເວັບໄຊໃດກໍຕາມ</translation>
<translation id="2970877059928503461">ປິດ • FlyWeb ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="173462352822069427">ຍິນດີຕ້ອນຮັບສູ່ໂປຣໄຟລ໌ FlyWeb</translation>
<translation id="8914008746092110409">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ກຸ່ມແຖບ.</translation>
<translation id="3484308111967198595">ລຶບບັນຊີອອກຈາກ FlyWeb</translation>
<translation id="1474676525193357364">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ FlyWeb.</translation>
<translation id="648319183876919572">Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຊ່ວຍປົກປ້ອງທ່ານຈາກເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ອັນຕະລາຍ</translation>
<translation id="5777905264835557372">ຖອນ​ຕິດ​ຕັ້ງ FlyWeb</translation>
<translation id="764623543427374554">ເປີດທາງລັດໃນ FlyWeb</translation>
<translation id="8852057261917278552">ອົງກອນຂອງທ່ານປິດ FlyWeb ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION"/>. ຂໍ້ມູນການທ່ອງເວັບຖືກລຶບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="8592211619057897362">ແຕ່ລະໂປຣໄຟລ໌ມີຂໍ້ມູນ FlyWeb ຂອງມັນເອງ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ, ລະຫັດຜ່ານ ແລະ ອື່ນໆອີກ</translation>
<translation id="6556755379298048869">ຊອກຫາດ້ວຍຄີລັດ.</translation>
<translation id="4273595998837775033">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບ <ph name="BEGIN_LINK"/>ວິທີທີ່ FlyWeb ຮັກສາຂໍ້ມູນຂອງທ່ານໃຫ້ເປັນສ່ວນຕົວ<ph name="END_LINK"/></translation>
<translation id="654107331777480705">ການປ່ຽນແປງການຕັ້ງຄ່ານີ້ຈະມີຜົນນຳໃຊ້ເມື່ອ FlyWeb ຣີສະຕາດ.</translation>
<translation id="3594828538355548672">ຈັດການສ່ວນຂະຫຍາຍຂອງທ່ານໂດຍການຄລິກສ່ວນຂະຫຍາຍໃນເມນູຫຼັກຂອງ FlyWeb.</translation>
<translation id="7489092380688543560">ທ່ານສາມາດສະຫຼັບເພື່ອເບິ່ງລະຫັດຜ່ານຈາກໂປຣໄຟລ໌ FlyWeb ອື່ນໄດ້</translation>
<translation id="472958395762114471">ໃຊ້ແອັບ FlyWeb ເພື່ອນຳເຄື່ອງມື AI ທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="8243012192239086369">ເພື່ອແກ້ໄຂການສະກົດຄຳຜິດ, FlyWeb ສົ່ງຂໍ້ຄວາມທີ່ທ່ານພິມໃນຊ່ອງຂໍ້ຄວາມໃຫ້ FlyWeb</translation>
<translation id="3927263773110604886">ໄປຫາການຕັ້ງຄ່າການແຈ້ງເຕືອນຂອງ FlyWeb</translation>
<translation id="6600016381025017075">ຊອກຫາຫຍັງກໍໄດ້ໃນໜ້ານີ້</translation>
<translation id="6888846095017247017">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ FlyWeb ໃໝ່.</translation>
<translation id="4481788155537463533">ຕອນນີ້ລະບົບຈະເປີດໃຊ້ FlyWeb ເມື່ອ Windows ເລີ່ມເຮັດວຽກເພື່ອໃຫ້ທ່ານສາມາດເລີ່ມທ່ອງເວັບໄດ້ທັນທີ. ທ່ານສາມາດປິດການດຳເນີນການນີ້ໄດ້ໃນການຕັ້ງຄ່າ.</translation>
<translation id="1116311888485102603">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: FlyWeb ໄດ້ກູ້ຄືນແທັບຂອງທ່ານຈາກເຊດຊັນຫຼ້າສຸດຂອງທ່ານ. ທ່ານສາມາດປິດໃຊ້ສິ່ງນີ້ໄດ້ໃນ</translation>
<translation id="1886169834787876002">FlyWeb ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບເພື່ອສ້າງແຜນທີ່ 3 ມິຕິຂອງສິ່ງອ້ອມຕົວທ່ານ</translation>
<translation id="7570986009744020649">ນອກຈາກນັ້ນ, ຫາກທ່ານບັນທຶກບຸກມາກຂອງທ່ານໃນບັນຊີ FlyWeb ຂອງທ່ານ, ທ່ານສາມາດຕິດຕາມລາຄາຜະລິດຕະພັນໃນ FlyWeb ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໄດ້</translation>
<translation id="6676384891291319759">ການເຂົ້າຫາອິນເຕີເນັດ</translation>
<translation id="1363996462118479832">ChromeOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການເຂົ້າສູ່ລະບົບຜິດພາດ.</translation>
<translation id="5743696427773796626">ລຶບຂໍ້ມູນຂອງແອັບນີ້ອອກຈາກ FlyWeb</translation>
<translation id="4152880912192471857">FlyWeb ຕ້ອງການການອະນຸຍາດໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="6712881677154121168">ດາວໂຫຼດຜິດພາດ: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">ບໍ່ສາມາດໃຊ້ໂປຣໄຟລ໌ຂອງທ່ານໄດ້ ເພາະວ່າມັນມາຈາກ FlyWeb ລຸ້ນໃໝ່ກ່ວາ.

ບາງ​ຄຸນສົມບັດອາດຈະບໍ່ມີ​ໃຫ້. ກະລຸນາລະບຸລາຍຊື່ບັນຊີໂປຣໄຟລ໌ຕ່າງ ຫຼືໃຊ້ FlyWeb ລຸ້ນໃໝ່ກ່ວາ.</translation>
<translation id="5528558621229392814">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຄຸນສົມບັດອື່ນໆ, ໃຫ້ຮວມ FlyWeb ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ ພ້ອມທັງບໍລິການ FlyWeb ທີ່ລິ້ງໄວ້</translation>
<translation id="7728046102681268859">ຕິດຕັ້ງ FlyWeb ສຳລັບຜູ້ໃຊ້ທຸກຄົນໃນຄອມພິວເຕີຂອງທ່ານແລ້ວ.</translation>
<translation id="2006421382007321898">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb. ລະບົບຈະບັນທຶກບຸກມາກນີ້ໄວ້ໃນບັນຊີ FlyWeb ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="4328426102261301637">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ FlyWeb ແຕ່ເຮັດໃຫ້ FlyWeb ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ເປີດຢູ່.</translation>
<translation id="207175655966839154">{count,plural, =1{ຂໍ້ມູນ FlyWeb ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ FlyWeb ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{ຂໍ້ມູນ FlyWeb ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ FlyWeb ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="1292831930742306370">FlyWeb ແນະນຳໃຫ້ສະແກນໄຟລ໌ນີ້ເນື່ອງຈາກມັນອາດເປັນອັນຕະລາຍໄດ້.</translation>
<translation id="1547295885616600893">ChromeOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS"/>ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS"/> ເພີ່ມເຕີມ.</translation>
<translation id="6831043979455480757">ແປພາສາ</translation>
<translation id="6432682256389755533">FlyWeb ແຈ້ງໃຫ້ທ່ານຮູ້ຖ້າມີຄົນຮູ້ລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="684888714667046800">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ຫາກທ່ານໃຊ້ firewall, ກະລຸນາກວດສອບໃຫ້ໝັ້ນໃຈວ່າ <ph name="PRODUCT_EXE_NAME"/> ຢູ່ໃນລາຍຊື່ອະນຸຍາດ.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">ແຕະເພື່ອສືບຕໍ່</translation>
<translation id="6862030660799253820">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="6869568587896659271">ເຂົ້າເຖິງເວັບໄຊຢູ່ລຸ່ມແຖບທີ່ຢູ່ໄດ້ຢ່າງງ່າຍດາຍ</translation>
<translation id="4695676871328690599">FlyWeb ພົບວ່າ "<ph name="EXTENSION_NAME"/>" ມີເມົາແວ</translation>
<translation id="6877155553248388166">ມຸມຂວາລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT"/>%, ລຸ່ມ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">ສຳເນົາ</translation>
<translation id="6898028264630240901">ທ່ານສາມາດປັກໝຸດໜ້າວຽກຕາມບໍລິບົດເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="8416061171168102237">ຕັ້ງ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ ແລະ ປັກໝຸດມັນໃສ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="3503126745419877918">&amp;ຈັດການໂປຣໄຟລ໌ FlyWeb</translation>
<translation id="4397299252625349918">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້:
          <ph name="LINE_BREAKS"/>
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK"/>
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK"/>
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAK"/>
            • ຣີເຊັດທາງລັດຂອງ FlyWeb
            <ph name="LINE_BREAKS"/>
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="2640214066670118583">ທ່ານບັນທຶກບຸກມາກຂອງ FlyWeb ຮອດຂີດຈຳກັດ <ph name="BOOKMARK_LIMIT"/> ລາຍການແລ້ວ, ດັ່ງນັ້ນລະບົບຈຶ່ງຍັງບໍ່ໄດ້ບັນທຶກບຸກມາກບາງລາຍການຂອງທ່ານໃສ່ໃນບັນຊີ FlyWeb ຂອງທ່ານເທື່ອ.

ທ່ານຈະບໍ່ສາມາດບັນທຶກບຸກມາກໃໝ່ໃສ່ໃນບັນຊີຂອງທ່ານໄດ້ຈົນກວ່າທ່ານຈະລຶບບຸກມາກບາງລາຍການອອກ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ລະບົບຈະລຶບບຸກມາກທີ່ຍັງບໍ່ໄດ້ບັນທຶກໄວ້ອອກ.</translation>
<translation id="6965382102122355670">ຕົກລົງ</translation>
<translation id="3453763134178591239">ຂໍ້ກຳນົດ ChromeOS</translation>
<translation id="1163386134146281359">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ FlyWeb ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບລະບົບປະຕິບັດການເວີຊັນນີ້.</translation>
<translation id="7024536598735240744">ແຕກໄຟລ໌ຜິດພາດ: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="8144357648892716751">ຕັ້ງຄ່າ FlyWeb ແບບກຳນົດເອງ</translation>
<translation id="7047386856539490735">ຜົນການຊອກຫາເຫຼົ່ານີ້ມີປະໂຫຍດຫຼືບໍ່?</translation>
<translation id="3945284827084409390">ອັບເດດ FlyWeb</translation>
<translation id="7886270027101123253">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, FlyWeb ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ FlyWeb.</translation>
<translation id="8434939140421950539">ສຳຜັດປະສິດທິພາບຂອງ AI ເມື່ອທ່ານໃຊ້ແອັບ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ</translation>
<translation id="2647329478963461727">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ FlyWeb ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="5695394421048248926">ປັບແຕ່ງ FlyWeb for Testing</translation>
<translation id="6802544479988856975">ທ່ານສາມາດໃຊ້ FlyWeb ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="8694083743003679818">ລຶບ <ph name="EXTENSION_NAME"/> ອອກຈາກ FlyWeb</translation>
<translation id="6017914745388312119">ອົງກອນຂອງທ່ານລຶບຂໍ້ມູນຂອງ FlyWeb ອອກເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION"/>. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="3283953248242339756">FlyWeb ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບສຳລັບເວັບໄຊນີ້</translation>
<translation id="4729674580260824908">ບໍ່ສາມາດເປີດໃຊ້ FlyWeb ໄດ້. ກະລຸນາລອງອີກຄັ້ງ.</translation>
<translation id="805403942934515799">ຖາມຫຍັງກໍໄດ້, ຈາກບ່ອນທີ່ທ່ານຢູ່, ດ້ວຍ Gemini ໃນ FlyWeb</translation>
<translation id="7093403858436459499">ເກັບ FlyWeb ໃນດັອກຂອງທ່ານເພື່ອໄປໃຊ້ມັນຢ່າງວ່ອງໄວໄດ້ທຸກເວລາ</translation>
<translation id="935820624106805690">ໃຊ້ FlyWeb ຕອນໃດກໍໄດ້ທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="7216228761061470870">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບຢູ່ເດັສທັອບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ</translation>
<translation id="1678436729108859736">ຕົວຈັດການໜ້າວຽກ - FlyWeb</translation>
<translation id="7587087358591725059">ຖາມກ່ຽວກັບເນື້ອຫາພາຍນອກ FlyWeb ເຊັ່ນ: ແອັບ ຫຼື ໄຟລ໌ອື່ນໆ</translation>
<translation id="7013534648688018698"><ph name="EXISTING_USER"/> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS"/>. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="4889865510625659193">ເລີ່ມທ່ອງເວັບໄດ້ທັນທີ: ຕອນນີ້ລະບົບສາມາດເປີດໃຊ້ FlyWeb ເມື່ອ Windows ເລີ່ມເຮັດວຽກໄດ້ແລ້ວ.</translation>
<translation id="7274695763216404502">ປັກໝຸດແລ້ວ! ໃຊ້ການຊອກຫາຮູບອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="7288567540154601580">ແຖບ ແລະ ສ່ວນຂະຫຍາຍ</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{FlyWeb ແນະນຳໃຫ້ທ່ານລຶບອອກ}other{FlyWeb ແນະນຳໃຫ້ທ່ານລຶບອອກ}}</translation>
<translation id="5321339461210685340">ເພື່ອແບ່ງປັນສຽງຂອງລະບົບ, ໃຫ້ເປີດການຕັ້ງຄ່າລະບົບ ແລະ ອະນຸຍາດ 'ການບັນທຶກສຽງຂອງລະບົບເທົ່ານັ້ນ' ສຳລັບ FlyWeb. ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ FlyWeb.</translation>
<translation id="7299899569525778554">ຊອກຫາຈາກເດັສທັອບ</translation>
<translation id="2866611433272355726">ກໍາລັງອັບເດດ FlyWeb</translation>
<translation id="5013690772358862887">ໄຟລ໌ທີ່ມັກຂອງທ່ານເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້.

FlyWeb ບໍ່ສາມາດກູ້ການຕັ້ງຄ່າຂອງທ່ານຄືນໄດ້.</translation>
<translation id="7324051657739063017">ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="1123144153876435088">ເວັບຂອງທ່ານ, ບຸກມາກສ໌, ແລະ FlyWeb ອື່ນສົດຢູ່ທີ່ນີ້.</translation>
<translation id="8915041713909379783">ມີພຽງບຸກຄົນທີ່ມີລະຫັດຜ່ານຂອງທ່ານເທົ່ານັ້ນທີ່ສາມາດອ່ານຂໍ້ມູນທີ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້ຂອງທ່ານໄດ້. FlyWeb ຈະບໍ່ໄດ້ຮັບ ຫຼື ຈັດເກັບລະຫັດຜ່ານດັ່ງກ່າວ. ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ທ່ານຈະຕ້ອງ <ph name="BEGIN_LINK"/>ລຶບຂໍ້ມູນ FlyWeb ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK"/>.</translation>
<translation id="6760192061736180746">ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານໄດ້ກຳນົດຄ່າໃຫ້ FlyWeb ເປີດ <ph name="ALTERNATIVE_BROWSER_NAME"/> ເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">ມີ​ບາງ​ອັນ​ຜິດ​ພາດ</translation>
<translation id="7601756527349047847">ເພື່ອຮັບການອັບເດດ FlyWeb ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ macOS 13 ຂຶ້ນໄປ. ຄອມພິວເຕີເຄື່ອງນີ້ກຳລັງໃຊ້ macOS 12.</translation>
<translation id="3916387280110223245">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. FlyWeb ໄດ້ລຶບ <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> ອອກແລ້ວ.</translation>
<translation id="3313237823190188892">ສະແດງ Gemini ໃນ FlyWeb ໃນຖາດລະບົບ</translation>
<translation id="7401687852903179959">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="6624551989332401777">ຕອນນີ້ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານແລ້ວ</translation>
<translation id="277733508197886564">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: FlyWeb ຈະກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອປິດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="948152006162936800">ນຳເຂົ້າລະຫັດຜ່ານໃສ່ FlyWeb</translation>
<translation id="4755314372270379254">1. ຄລິກ <ph name="BUTTON_LABEL"/> ທາງລຸ່ມ
2. ຄລິກ <ph name="BUTTON_2"/> ໃນການຕັ້ງຄ່າ Windows ຂອງທ່ານ
3. ຄລິກ <ph name="BUTTON_3"/> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ FlyWeb ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="7450541714075000668">ສຳເນົາຂໍ້ຄວາມແລ້ວ</translation>
<translation id="7472280958921965834">ເພື່ອໃຊ້ໄມໂຄຣໂຟນຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ FlyWeb ໃນ <ph name="BEGIN_LINK"/>ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK"/></translation>
<translation id="2431618580332826398">ເພື່ອໄດ້ຮັບການອັບເດດ FlyWeb ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 7.</translation>
<translation id="2154651873647244914">ເລີ່ມເປີດໃຊ້ FlyWeb ໃໝ່ບໍ?</translation>
<translation id="3137757192868162370">ບໍ່ສາມາດຕິດຕັ້ງ FlyWeb ລຸ້ນດຽວກັບທີ່ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​ໄດ້. ກະລຸນາປິດ FlyWeb ແລະລອງໃໝ່ອີກ.</translation>
<translation id="3065486555702061722">ການແຈ້ງເຕືອນ: ປະໂຫຍດສູງສຸດຈາກ FlyWeb ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="4027434552262956425">ເວັບໄຊອາດເຮັດວຽກຕາມທີ່ຄາດໄວ້. ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ FlyWeb ທັງໝົດຍົກເວັ້ນບັນຊີ FlyWeb ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ FlyWeb.</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb ຈະເປີດຄືນໃໝ່ໃນ 1 ນາທີ}other{FlyWeb ຈະເປີດຄືນໃໝ່ໃນ # ນາທີ}}</translation>
<translation id="301074550630080641">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ກະລຸນາອະນຸຍາດໃຫ້ FlyWeb ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້.</translation>
<translation id="3930051800510118744">ເປີດໃຊ້ FlyWeb ໂດຍອັດຕະໂນມັດເພື່ອເລີ່ມທ່ອງເວັບໄດ້ທັນທີ.</translation>
<translation id="7583399374488819119">ຕົວຕິດຕັ້ງ <ph name="COMPANY_NAME"/></translation>
<translation id="3067364763515000789">FlyWeb ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບ​ ແລະໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="1381291360713116383">FlyWeb ​ດີກ​ວ່າແລ້ວ</translation>
<translation id="3892366519980032442">ຕອນນີ້ທ່ານມີຄຸນສົມບັດເພີ່ມເຕີມໃນ FlyWeb</translation>
<translation id="7624307931717240213">ພວກເຮົາໃຊ້ຂໍ້ມູນເພື່ອປັບປຸງບໍລິການນີ້. ເບິ່ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ ແລະ ຂໍ້ກຳນົດບໍລິການ.</translation>
<translation id="7649070708921625228">ຊ່ວຍ​ເຫຼືອ</translation>
<translation id="7733015548570443346">ດາວໂຫຼດແອັບ FlyWeb</translation>
<translation id="7658239707568436148">ຍົກ​ເລີກ​</translation>
<translation id="2230101319599356673">FlyWeb ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="3243257760331619874">ຊິ້ງຂໍ້ມູນ ແລະ ປັບແຕ່ງ FlyWeb ໃຫ້ເປັນແບບສ່ວນຕົວໃນທົ່ວອຸປະກອນຂອງທ່ານ</translation>
<translation id="3836891631266228927">ການອັບເດດ FlyWeb</translation>
<translation id="7362833186911891234">ວຽກຂອງທ່ານປອດໄພໃນ FlyWeb</translation>
<translation id="7716950018788545737">ໜ້າວຽກສິ້ນສຸດແລ້ວ.</translation>
<translation id="77283119132245232">ໃຫ້ບໍລິການຕິດຕາມລະບົບສຳລັບ <ph name="BROWSER_NAME"/>. ຫາກປິດການນຳໃຊ້ບໍລິການນີ້, ການຕິດຕາມປະສິດທິພາບທີ່ສ້າງຂຶ້ນໂດຍໂປຣແກຣມທ່ອງເວັບຈະບໍ່ຮວມກິດຈະກຳທົ່ວລະບົບ ເຊັ່ນ: ກິດຈະກຳປ່ຽນບໍລິບົດ ແລະ ກິດຈະກຳຫົວຂໍ້ທີ່ພ້ອມນຳໃຊ້.</translation>
<translation id="1549877678317463759">ນີ້ຈະລຶບຂໍ້ມູນການທ່ອງເວັບຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ FlyWeb ເປັນ <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">ຕົວຕິດຕັ້ງບໍ່ສາມາດສ້າງໄດເຣັກຕໍຣີຊົ່ວຄາວໄດ້. ກະລຸນາກວດເບິ່ງບ່ອນ​ວ່າງດິສກ໌ ແລະການອະນຸຍາດ ເພື່ອຕິດຕັ້ງຊອບແວ.</translation>
<translation id="104221467268393661">ຣີເຊັດເປັນ FlyWeb ແບບຄ່າເລີ່ມຕົ້ນ</translation>
<translation id="2414061498125565915">ເພື່ອຮັກສາຄວາມປອດໄພໃຫ້ກັບວຽກຂອງທ່ານໃນ FlyWeb, ອົງກອນຂອງທ່ານຈະສາມາດເບິ່ງ ຫຼື ຈັດການຂໍ້ມູນບາງຢ່າງໄດ້ເມື່ອທ່ານເຂົ້າສູ່ລະບົບ FlyWeb.</translation>
<translation id="494195283222791090">ຕັ້ງ FlyWeb ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="134973275687829726">ເຮັດໃຫ້ FlyWeb ໄວຂຶ້ນ</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="2415098152024287665">ເຮັດໃຫ້ຜູ້ທີ່ມີສິດເຂົ້າເຖິງທຣາບຟິກອິນເຕີເນັດຂອງທ່ານເບິ່ງວ່າທ່ານເຂົ້າເບິ່ງເວັບໄຊໃດແດ່ໄດ້ຍາກຂຶ້ນ. FlyWeb ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພເພື່ອຊອກຫາທີ່ຢູ່ IP ຂອງເວັບໄຊໃນ DNS (ລະບົບຊື່ໂດເມນ).</translation>
<translation id="7810005234485217901">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ</translation>
<translation id="6059158364953614237">ເລືອກສິ່ງທີ່ຈະແບ່ງປັນກັບ FlyWeb</translation>
<translation id="8463540467315366872">ມີໂປຣໄຟລ໌ FlyWeb ກັບບັນຊີນີ້ຢູ່ອຸປະກອນນີ້ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="7845233973568007926">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດຄອມພິວເຕີຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME"/>.</translation>
<translation id="3682929584258119691">ມີການປ່ຽນໂປຣແກຣມຊອກຫາຂອງທ່ານຈາກພາຍນອກ FlyWeb. ເພື່ອປົກປ້ອງທ່ານ, FlyWeb ໄດ້ຣີເຊັດໂປຣແກຣມດັ່ງກ່າວເປັນຄ່າເລີ່ມຕົ້ນເກົ່າ. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="7922534680008400314">ປັບແຕ່ງ FlyWeb ເພື່ອໃຫ້ມີຮູບລັກໃໝ່</translation>
<translation id="8611872055947278722">FlyWeb ບໍ່ສາມາດອັບເດດເປັນເວີຊັນຫຼ້າສຸດໄດ້, ສະນັ້ນທ່ານກຳລັງພາດຄຸນສົມບັດ ແລະ ການແກ້ໄຂດ້ານຄວາມປອດໄພໃໝ່ໆຢູ່.</translation>
<translation id="7872446069773932638">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="SECONDS"/> ວິນາທີ</translation>
<translation id="3999247564452560622">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ໃຫ້ <ph name="BEGIN_LINK"/>ລຶບຂໍ້ມູນ FlyWeb ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK"/></translation>
<translation id="3544550150141249305">ເປີດ Gemini ໃນ FlyWeb ໄດ້ຢ່າງວ່ອງໄວທຸກເທື່ອທີ່ທ່ານຕ້ອງການ</translation>
<translation id="6798431672720500005">ຕັ້ງ FlyWeb ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="332151924263389003">FlyWeb ອັບເກຣດການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພເປັນ HTTPS ໂດຍອັດຕະໂນມັດຫາກເປັນໄປໄດ້</translation>
<translation id="3096730275883527801">ທ່ານ​ໄດ້ລົງຊື່ເຂົ້າໃຊ້ FlyWeb ເປັນ <ph name="USER_EMAIL_ADDRESS"/>. ກະ​ລຸ​ນາ​​ໃຊ້​ບັນ​ຊີ​ດຽວ​ກັນ​ ເພື່ອລົງຊື່ເຂົ້າໃຊ້ອີກ.</translation>
<translation id="7097534420680357688"><ph name="EXISTING_USER"/> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS"/>. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຢູ່ອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="9017338699075596174">ນີ້ແມ່ນການຕິດຕັ້ງສຳຮອງຂອງ FlyWeb ແລະ ບໍ່ສາມາດຖືກຕັ້ງເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້.</translation>
<translation id="2888168499066553233">ຮັບປະໂຫຍດສູງສຸດຈາກ FlyWeb ດ້ວຍແອັບ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ</translation>
<translation id="8004582292198964060">ບຣາວ​ເຊີ</translation>
<translation id="8010081455002666927">ກວດຫາອັດຕະໂນມັດ</translation>
<translation id="5944585442866020176">ເມື່ອ FlyWeb ມີການເຂົ້າເຖິງ, ເວັບໄຊຈະສາມາດຮ້ອງຂໍການເຂົ້າເຖິງນຳທ່ານ.</translation>
<translation id="4462215250900528778">ປັກໝຸດ FlyWeb ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວທຸກເວລາ</translation>
<translation id="80471789339884597">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານທັງໝົດກ່ອນການໃຊ້ <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8054112667659782652">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="8069447462453318634">ເລືອກ "ປັກໝຸດໄວ້ຢູ່ແຖບເຄື່ອງມື"</translation>
<translation id="3685797926747054412">ປິດການນຳໃຊ້ FlyWeb ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="80790299200510644">ຊອກຫາຮູບ</translation>
<translation id="8086881907087796310">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຄອມພິວເຕີຂອງທ່ານບໍ່ເປັນໄປຕາມຂໍ້ກຳນົດຂັ້ນຕ່ຳສຳລັບຮາດແວ.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">FlyWeb ຕ້ອງການການອະນຸຍາດສະຖານທີ່ສຳລັບເວັບໄຊນີ້</translation>
<translation id="5289593085778678155">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ເປີດການນຳໃຊ້ການແຈ້ງເຕືອນການຕິດຕາມລາຄາ.</translation>
<translation id="7635444121786764725">ຮັບການແຈ້ງເຕືອນລາຄາຫຼຸດລົງສຳລັບສິນຄ້າທີ່ທ່ານສົນໃຈດ້ວຍແອັບ FlyWeb ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="8118331347066725040">ສົ່ງຄຳຕິຊົມສຳລັບການຊອກຫາດ້ວຍ Lens</translation>
<translation id="5770057404954060005">ປັບປ່ຽນ FlyWeb ໃນແບບຂອງທ່ານ</translation>
<translation id="5334309298019785904">ChromeOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການຊິ້ງຂໍ້ມູນບໍ່ສາມາດໃຊ້ໄດ້ສຳລັບໂດເມນຂອງທ່ານ.</translation>
<translation id="813913629614996137">ກຳລັງລິເລີ່ມ...</translation>
<translation id="6992240065504496864">ເປີດ Gemini ໃນ FlyWeb ດ້ວຍຄີລັດ.</translation>
<translation id="6334554715655789744">ຂໍ້ກຳນົດບໍລິການເພີ່ມເຕີມຂອງ FlyWeb</translation>
<translation id="1597323875619800374">ໄຟລ໌ນີ້ເປັນອັນຕະລາຍ, ສະນັ້ນ FlyWeb ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="8177472873527554730">ບໍ່ພົບເນື້ອຫາໃນໜ້າ</translation>
<translation id="2214224574148863941">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ FlyWeb ໃນບັນຊີຂອງທ່ານ, <ph name="USER_EMAIL"/></translation>
<translation id="820759916613250543">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="8221491193165283816">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ກະລຸນາຄລິກບ່ອນນີ້.</translation>
<translation id="2459467374982542273">ເພື່ອໃຊ້ກ້ອງຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ FlyWeb ໃນ <ph name="BEGIN_LINK"/>ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK"/></translation>
<translation id="4749458995158778066">FlyWeb ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ ແລະ ມັນອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ FlyWeb ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວ.</translation>
<translation id="6756872644564483342">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, FlyWeb ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ FlyWeb. ທ່ານສາມາດປິດສິ່ງນີ້ໃນການຕັ້ງຄ່າໄດ້ທຸກເວລາ.</translation>
<translation id="9179486248398668702">ເຂົ້າສູ່ລະບົບ FlyWeb ໃນໂປຣໄຟລ໌ໃໝ່ບໍ?</translation>
<translation id="1470002120352085290"><ph name="EXISTING_USER"/> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS"/>. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE"/> ນຳ.</translation>
<translation id="8901123396574346662">ສະແດງ Gemini ໃນ FlyWeb ໃນຖາດລະບົບ ແລະ ເປີດຄີລັດ</translation>
<translation id="9102959605052547519"><ph name="BEGIN_LINK"/>FlyWeb ຈະເຕືອນທ່ານ<ph name="END_LINK"/> ກ່ຽວກັບເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ບໍ່ປອດໄພ</translation>
<translation id="669999719045196468">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. FlyWeb ໄດ້ລຶບສິດເຂົ້າເຖິງ <ph name="PERMISSION"/> ອອກແລ້ວ.</translation>
<translation id="7136168924180047124">ເລືອກຊື້, ແປພາສາ ແລະ ລະບຸສິ່ງທີ່ທ່ານເຫັນດ້ວຍກ້ອງຂອງທ່ານຢູ່ແອັບ FlyWeb iOS</translation>
<translation id="867002910715789721">ລະຫັດ QR ເພື່ອເຂົ້າສູ່ລະບົບ FlyWeb ໃນຊື່ <ph name="USER_NAME"/></translation>
<translation id="8313851650939857356">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="208266011144024011">ອົງກອນຂອງທ່ານປິດ FlyWeb ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">ບັນທຶກເປັນຮູບ</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> ເຄີຍໃຊ້ FlyWeb ໃນເມື່ອກ່ອນ</translation>
<translation id="7009033378151348624">ເປີດການນຳໃຊ້ທັກສະໃນ FlyWeb</translation>
<translation id="338142060986183805">ອັບເດດ FlyWeb ເພື່ອສືບຕໍ່ນຳໃຊ້ຂໍ້ມູນ FlyWeb ໃນບັນຊີ FlyWeb ຂອງທ່ານ, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7408894216012529448">ເພື່ອໄດ້ຮັບການອັບເດດ FlyWeb ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.</translation>
<translation id="8362914115861174987">ແປພາສາເປັນ</translation>
<translation id="8367705492654390392">ຖາມຫຍັງກໍໄດ້</translation>
<translation id="5020916672477085422">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb. ລະບົບຈະບັນທຶກລະຫັດຜ່ານນີ້ໄວ້ໃນບັນຊີ FlyWeb ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="5417365165109189454">ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ FlyWeb.</translation>
<translation id="4212474799248200893">FlyWeb ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK"/>ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">ນັກພັດທະນາຍົກເລີກການເຜີຍແຜ່ສ່ວນຂະຫຍາຍນີ້ແລ້ວ ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ FlyWeb ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="3669395395617655404">FlyWeb ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານກ່ອນຈະບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ FlyWeb ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="5261590792975521002">{0,plural, =1{ເປີດໃຊ້ FlyWeb ຄືນໃໝ່ພາຍໃນໜຶ່ງມື້}other{ເປີດໃຊ້ FlyWeb ຄືນໃໝ່ພາຍໃນ # ມື້}}</translation>
<translation id="8438543370129609977">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ. <ph name="LEARN_MORE"/></translation>
<translation id="8562534196217731013">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບການຊອກຫາດ້ວຍການຊອກຫາຮູບໃນ FlyWeb</translation>
<translation id="3101564993057563365">ຄັງຕົວຕິດຕັ້ງຖືກເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້. ກະລຸນາດາວໂຫຼດ FlyWeb ອີກ.</translation>
<translation id="5316851838033144902">FlyWeb ຕ້ອງໃຊ້ Windows 10 ຂຶ້ນໄປ.</translation>
<translation id="6760691951531758781">ຕົວເລືອກເສີມ: ຊ່ວຍປັບປຸງຄຸນສົມບັດ ແລະ ປະສິດທິພາບຂອງ ChromeOS ໂດຍການສົ່ງຂໍ້ມູນການວິນິໄສ ແລະ ການນຳໃຊ້ໄປໃຫ້ FlyWeb ໂດຍອັດຕະໂນມັດ.</translation>
<translation id="2523037024749170569">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ FlyWeb ໃນບັນຊີ FlyWeb ຂອງທ່ານ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="5989540778099253163">ສະແດງຂໍ້ຄວາມເພື່ອເຂົ້າສູ່ລະບົບຫາ FlyWeb</translation>
<translation id="6852836260419236265">FlyWeb ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="360892078644515524">ຂໍຂອບໃຈທີ່ເລືອກ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ!</translation>
<translation id="797182360653885317">FlyWeb ສາມາດກວດເບິ່ງລະຫັດຜ່ານຂອງທ່ານເມື່ອທ່ານບັນທຶກພວກມັນໄວ້</translation>
<translation id="8525579356836940628">ຢຸດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="8340284327429540526">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ</translation>
<translation id="7498776423722712116">ຮັບຄຳເຕືອນຫາກ FlyWeb ພົບໜຶ່ງໃນລະຫັດຜ່ານຂອງທ່ານໃນການລະເມີດຂໍ້ມູນສາທາລະນະ</translation>
<translation id="8555465886620020932">ບໍລິການຜິດພາດ: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="4612664149461928652">ຄຸນສົມບັດ ແລະ ສ່ວນຂະຫຍາຍບາງຢ່າງຂອງ FlyWeb ມາພ້ອມກັບທາງລັດ. ທ່ານສາມາດເລືອກທີ່ຈະເປີດໃຊ້ອີກຄັ້ງໄດ້.</translation>
<translation id="8556420416730706394">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ; ໂດຍການຄລິກປຸ່ມປັກໝຸດຢູ່ເທິງສຸດຂອງແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="856656450041460113">ຊອກຫາລາຍການພາສາ</translation>
<translation id="5128162742812353891">ຫຼາຍອົງການຈັດການ FlyWeb</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="7129578417724116642">ກຳລັງເປີດໃຊ້ FlyWeb...</translation>
<translation id="8624541899164515475">ການຕັ້ງຄ່າ, ເປີດໃນແຖບໃໝ່.</translation>
<translation id="5469043671012993003">ບໍ່ສາມາດຕັ້ງ FlyWeb ສຳລັບການທົດສອບເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານໄດ້.</translation>
<translation id="3892251159131070138">ຊອກຫາດ້ວຍ FlyWeb ໄດ້ຈາກທຸກບ່ອນ</translation>
<translation id="1514450422236300417">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ FlyWeb ຫຼືຄົ້ນຫາຈາກ Omnibox.</translation>
<translation id="573490495087487940">ນີ້​ແມ່ນ FlyWeb ຂອງ​ທ່ານ</translation>
<translation id="8712637175834984815">ເຂົ້າໃຈແລ້ວ</translation>
<translation id="2666961286257416158">ເຂົ້າສູ່ລະບົບ FlyWeb ບໍ?</translation>
<translation id="8747073452963259673">ມຸມຊ້າຍລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT"/>%, ລຸ່ມ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຜູ້ເບິ່ງແຍງລະບົບເຄືອຂ່າຍຂອງທ່ານໃຊ້ນະໂຍບາຍລະດັບກຸ່ມເຊິ່ງປ້ອງກັນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">ແຈ້ງເຕືອນຂ້ອຍໃນພາຍຫຼັງ</translation>
<translation id="4243214377720481697">ແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ FlyWeb ເພື່ອຮັບພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="6808406663598665473">ເຂົ້າສູ່ລະບົບ FlyWeb ບໍ?</translation>
<translation id="7022252178852457880">ຕັ້ງ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="8826492472752484139">ຄລິກ “ຕົວຈັດການລະຫັດຜ່ານ”</translation>
<translation id="6933858244219479645">ລະບົບ ChromeOS</translation>
<translation id="1501202286854500367">ລະບົບຈະໃຊ້ພາສານີ້ເພື່ອສະແດງເມນູ, ການຕັ້ງຄ່າ, ແຈ້ງເຕືອນ ແລະ ຂໍ້ຄວາມອື່ນໆໃນ FlyWeb</translation>
<translation id="8862326446509486874">ທ່ານບໍ່ມີສິດທິທີ່ເໝາະສົມສໍາລັບຕິດຕັ້ງ​ໃນລະດັບລະບົບ. ລອງແລ່ນຕົວຕິດຕັ້ງນີ້ອີກ​ໃນ​ຖານະ​ເປັນ​ຜູ້ຄວບຄຸມ.</translation>
<translation id="2405293075272280413">ເພີ່ມໂປຣໄຟລ໌ FlyWeb</translation>
<translation id="2096285611267043007">ChromeOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ FlyWeb ໃນບັນຊີ FlyWeb ຂອງທ່ານໄດ້ເນື່ອງຈາກເກີດຂໍ້ຜິດພາດໃນການເຂົ້າສູ່ລະບົບ</translation>
<translation id="9046344742397901138">ອົງກອນຂອງທ່ານກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ FlyWeb</translation>
<translation id="4669168852412989042">FlyWeb ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດອັນນີ້.</translation>
<translation id="2704405030486981087">FlyWeb ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານອີກຕໍ່ໄປ. ຕັ້ງຄ່າ FlyWeb ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນບໍ?</translation>
<translation id="1663379621921336006">ບໍ່ສາມາດອັບເດດ FlyWeb ໄດ້</translation>
<translation id="8944232836376404813">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້
          <ph name="LINE_BREAKS"/>
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK"/>
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK"/>
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAKS"/>
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="188856534838382513">ສະແດງທາງລັດເວັບໄຊ FlyWeb</translation>
<translation id="543915850302643692">ໂລໂກ້ FlyWeb Enterprise</translation>
<translation id="4417647437359346154">ນຳຄວາມປອດໄພຂອງ FlyWeb ໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ FlyWeb ຢູ່ <ph name="DEVICE_TYPE"/> ຂອງທ່ານ</translation>
<translation id="6976267397714240800">ບໍ່ສາມາດເລີ່ມ FlyWeb ໄດ້ເນື່ອງຈາກມີບາງຢ່າງຜິດພາດເກີດຂຶ້ນເມື່ອເປີດໂປຣໄຟລ໌ຂອງທ່ານ. ລອງຣີສະຕາດ FlyWeb.</translation>
<translation id="8952346994182255880">ເພື່ອຊອກຫາດ້ວຍ FlyWeb ຫຼື ປັບແຕ່ງໃນ <ph name="BEGIN_LINK"/>ການຕັ້ງຄ່າ<ph name="END_LINK"/></translation>
<translation id="8422308271795251425">ຈັດການໂປຣໄຟລ໌ FlyWeb</translation>
<translation id="519942585686549229">ໃຊ້ແປ້ນພິມຂອງທ່ານເພື່ອນຳທາງລະຫວ່າງ Gemini ໃນ FlyWeb ແລະ ແຖບທີ່ເປີດຢູ່ຂອງທ່ານ.</translation>
<translation id="9018218886431812662">ສຳເລັດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="5804408305184682593">ລົງຊື່ເຂົ້າ​ໃຊ້ FlyWeb</translation>
<translation id="7410599202980023102">ສະແດງການຊອກຫາດ້ວຍ FlyWeb ໃນແຖບເມນູຂອງ Mac ແລະ ເປີດຄີລັດ</translation>
<translation id="2138383893834402906">FlyWeb ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ທີ່ເກັບໄວ້ໃນແຟ້ມມີໄຟລ໌ອື່ນໆທີ່ອາດຈະເຊື່ອງເມົາແວໄວ້</translation>
<translation id="8884768769854521848">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ FlyWeb. ລະບົບຈະປັກໝຸດ FlyWeb ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ.</translation>
<translation id="3668027737318668659">ໃຊ້ເຄື່ອງມື AI ທີ່ດີທີ່ສຸດຂອງ FlyWeb ດ້ວຍແອັບ FlyWeb ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1257818515846885633">ເພື່ອເຂົ້າເຖິງລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE"/>, ໃຫ້ເຂົ້າສູ່ລະບົບ FlyWeb</translation>
