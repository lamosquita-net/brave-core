<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="130631256467250065">तपाईंले अर्को पटक तपाईंको यन्त्रलाई पुन: सुरु गर्दा तपाईंका परिवर्तनहरू प्रभावकारी हुनेछन्।</translation>
<translation id="1555506416658437797">भुक्तानी विधिहरू सम्पादन गर्नुहोस्।</translation>
<translation id="8359495463485001719">क्र्यास रिपोर्टिङ FlyWeb मा उपलब्ध छैन।</translation>
<translation id="6338530717474923868">तपाईं एउटा सुरक्षित FlyWeb पृष्ठ हेर्दै हुनुहुन्छ</translation>
<translation id="5147169001159408844">FlyWeb ले भुक्तानी विधिहरू हाल्नका निम्ति सेटिङ मिलाउन खोज्दै छ।</translation>
<translation id="5702992568540613683">FlyWeb लोगो</translation>
<translation id="510342522494506803">FlyWeb ले भुक्तानी विधिहरू सम्पादन गर्ने प्रयास गर्दै छ।</translation>
<translation id="8375862260948854624">Braveको कारण सम्भव भएको हो <ph name="BEGIN_LINK_CHROMIUM"/> FlyWeb <ph name="END_LINK_CHROMIUM"/> खुला स्रोत परियोजना र अन्य <ph name="BEGIN_LINK_OSS"/> खुला स्रोत सफ्टवेयर <ph name="END_LINK_OSS"/> ।</translation>
<translation id="4281953335231207224">यसमा जानुहोस्
          FlyWeb मेनु &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN सेटिङहरू
          र "Use a proxy server for your LAN" चेकबाकसमा चयन हटाउनुहोस्।</translation>
<translation id="5040124620086808431">FlyWeb ले यो पेज ब्लक गरेको छ</translation>
<translation id="1953000035868532675">FlyWeb लाई तपाईँको फायरवाल वा एन्टिभाइरसका
        सेटिङहरूमा नेटवर्कमा पहुँच गर्ने अनुमति दिनुहोस्।</translation>
<translation id="3442058224540562441">यसमा जानुहोस्
          FlyWeb मेनु &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          र तपाइँको विन्यास "प्रोक्सी छैन" वand make sure your configuration is set to "no proxy" or "direct."</translation>
<translation id="585620188971323280">भुक्तानी विधिहरू हाल्नका निम्ति सेटिङ मिलाउनुहोस्।</translation>
<translation id="2681118099728446983">FlyWeb बनाउँदा <ph name="BEGIN_LINK_OSS"/>खुला स्रोतका अन्य सफ्टवेयर<ph name="END_LINK_OSS"/>को पनि मद्दत लिइएको छ।</translation>
<translation id="6888846095017247017">तपाईंले अर्को पटक FlyWeb लाई पुन: लन्च गर्दा तपाईंका परिवर्तनहरू प्रभावमा आउनेछन्।</translation>
<translation id="1017070759373671177">FlyWeb बनाउँदा <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> खुला स्रोतको परियोजनाको मद्दत लिइएको छ।</translation>
<translation id="7777112741998051633">जानुहोस्
          FlyWeb मेनुमा &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          र अचयन गर्नुहोस् "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          यदि यसले मुद्दा समाधान गर्दैन भने, हामी सुधारिएको कार्यसम्पादनका लागि यस विकल्पलाई फेरि चयन गर्न सिफारिस गर्दछौं।</translation>
<translation id="8187289872471304532">यसमा जानुहोस्
          एपहरू &gt; प्रणाली प्राथमिकताहरू &gt; सञ्जाल &gt; उन्नत &gt; प्रोक्सीहरू
          र तपाइँले चयन गर्नुका कुनै पनि प्रोक्सीहरूको चयन हटाउनुहोस्।</translation>
<translation id="4699594416850504200">तपाईं सुरक्षित FlyWeb for Testing पेज हेर्दै हुनुहुन्छ</translation>
<translation id="6224789938625024797">FlyWeb सही तवरले बन्द भएन।</translation>
</translationbundle>