+std::u16string ToU16String(const LChar* chars, const wtf_size_t length) {
+  std::u16string s;
+  s.reserve(length);
+
+  for (wtf_size_t i = 0U; i < length; ++i) {
+    s.push_back(chars[i]);
+  }
+
+  return s;
+}
+
+std::u16string ToU16String(const UChar* chars, const wtf_size_t length) {
+  return std::u16string(chars, length);
