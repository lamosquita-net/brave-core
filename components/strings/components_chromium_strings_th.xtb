<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="130631256467250065">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณรีสตาร์ทอุปกรณ์ของคุณ</translation>
<translation id="1555506416658437797">แก้ไขวิธีการชำระเงิน</translation>
<translation id="8359495463485001719">ไม่มีการรายงานข้อขัดข้องใน FlyWeb</translation>
<translation id="6338530717474923868">คุณกำลังดูหน้า FlyWeb ที่ปลอดภัย</translation>
<translation id="5147169001159408844">FlyWeb กำลังพยายามแก้ไขการตั้งค่าสำหรับการกรอกวิธีการชำระเงิน</translation>
<translation id="5702992568540613683">โลโก้ FlyWeb</translation>
<translation id="510342522494506803">FlyWeb กําลังพยายามแก้ไขวิธีการชําระเงิน</translation>
<translation id="8375862260948854624">FlyWeb เกิดขึ้นได้ด้วยการสนับสนุนจากโครงการโอเพนซอร์ส <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> และ<ph name="BEGIN_LINK_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_OSS"/>อื่นๆ</translation>
<translation id="4281953335231207224">ไปที่
          เมนู FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          การตั้งค่า LAN
          และยกเลิกการเลือกช่องทำเครื่องหมาย "ใช้เซิร์ฟเวอร์พร็อกซีสำหรับ LAN ของคุณ"</translation>
<translation id="5040124620086808431">หน้านี้ถูกบล็อกโดย FlyWeb</translation>
<translation id="1953000035868532675">อนุญาตให้ FlyWeb เข้าถึงเครือข่ายในการตั้งค่าไฟร์วอลล์
          หรือการป้องกันไวรัส</translation>
<translation id="3442058224540562441">ไปที่
          เมนู FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          และตรวจสอบว่าคุณตั้งการกำหนดค่าของคุณเป็น "ไม่มีพร็อกซี" หรือ "โดยตรง"</translation>
<translation id="585620188971323280">แก้ไขการตั้งค่าสำหรับการกรอกวิธีการชำระเงิน</translation>
<translation id="2681118099728446983">FlyWeb ยังเกิดขึ้นได้ด้วย<ph name="BEGIN_LINK_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_OSS"/>อื่นๆ</translation>
<translation id="6888846095017247017">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณเปิด FlyWeb ขึ้นอีก</translation>
<translation id="1017070759373671177">FlyWeb เกิดขึ้นได้ด้วยโปรเจ็กต์โอเพนซอร์ส <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/></translation>
<translation id="7777112741998051633">ไปที่
          เมนู FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          และยกเลิกการเลือก "<ph name="NO_PREFETCH_DESCRIPTION"/>"
          หากวิธีนี้ไม่ช่วยแก้ปัญหา เราขอแนะนำให้เลือกตัวเลือกนี้
          อีกครั้งเพื่อให้ประสิทธิภาพการทำงานดียิ่งขึ้น</translation>
<translation id="8187289872471304532">ไปที่
          แอปพลิเคชัน &gt; ค่ากำหนดของระบบ &gt; เครือข่าย &gt; ขั้นสูง &gt; พร็อกซี
          แล้วยกเลิกการเลือกพร็อกซีที่ได้เลือกไว้</translation>
<translation id="4699594416850504200">คุณกําลังดูหน้า FlyWeb สําหรับการทดสอบที่ปลอดภัย</translation>
<translation id="6224789938625024797">FlyWeb ไม่ได้ปิดอย่างถูกต้อง</translation>
</translationbundle>