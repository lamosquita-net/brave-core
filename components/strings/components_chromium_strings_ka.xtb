<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="130631256467250065">ცვლილებები გააქტიურდება მოწყობილობის შემდეგი გადატვირთვისას.</translation>
<translation id="1555506416658437797">გადახდის მეთოდების რედაქტირება.</translation>
<translation id="8359495463485001719">ჩაშლის ანგარიშები ხელმისაწვდომი არ არის FlyWeb-ზე.</translation>
<translation id="6338530717474923868">თქვენ ათვალიერებთ FlyWeb-ის დაცულ გვერდს</translation>
<translation id="5147169001159408844">FlyWeb ცდილობს პარამეტრების შეცვლას, გადახდის მეთოდების შესავსებად.</translation>
<translation id="5702992568540613683">FlyWeb-ის ლოგო</translation>
<translation id="510342522494506803">FlyWeb ცდილობს გადახდის მეთოდების რედაქტირებას.</translation>
<translation id="8375862260948854624">FlyWeb არსებობს <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ღია წყაროს პროექტის და სხვა <ph name="BEGIN_LINK_OSS"/>ღია წყაროს პროგრამული უზრუნველყოფის<ph name="END_LINK_OSS"/> წყალობით.</translation>
<translation id="4281953335231207224">გახსენით
          FlyWeb-ის მენიუ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN-ის პარამეტრები
          და მოხსენით მონიშვნა მოსანიშნი უჯრიდან „პროქსი სერვერის გამოყენება LAN-ისთვის“.</translation>
<translation id="5040124620086808431">ეს გვერდი დაბლოკილია FlyWeb-ის მიერ</translation>
<translation id="1953000035868532675">თქვენი ქსელის დაცვის ან ანტივირუსის პარამეტრებში, მიეცით FlyWeb-ს ქსელზე წვდომის
          უფლება.</translation>
<translation id="3442058224540562441">გახსენით
          FlyWeb-ის მენიუ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
         და დარწმუნდით, რომ კონფიგურაციაში დაყენებულია მნიშვნელობები „პროქსის გარეშე“ ან „პირდაპირი“</translation>
<translation id="585620188971323280">პარამეტრების შეცვლა გადახდის მეთოდების შესავსებად.</translation>
<translation id="2681118099728446983">FlyWeb, ასევე, მუშაობს <ph name="BEGIN_LINK_OSS"/>ღია კოდის სხვა პროგრამული უზრუნველყოფის<ph name="END_LINK_OSS"/> დამსახურებით.</translation>
<translation id="6888846095017247017">თქვენი ცვლილებები გააქტიურდება FlyWeb-ის შემდეგი გაშვებისას.</translation>
<translation id="1017070759373671177">FlyWeb არსებობს <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>-ის ღია კოდის პროექტის წყალობით.</translation>
<translation id="7777112741998051633">გახსენით
         FlyWeb-ის მენიუ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          და მოხსენით მონიშვნა ელემენტიდან „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          თუ პრობლემა ვერ გადაწყდა, გირჩევთ ხელახლა აირჩიოთ
          ეს პარამეტრი, გაუმჯობესებული ეფექტურობისთვის.</translation>
<translation id="8187289872471304532">გადადით
          პროგრამები &gt; სისტემის პარამეტრები &gt; ქსელი &gt; მოწინავე &gt; პროქსი
          და გააუქმეთ ნებისმიერი არჩეული პროქსი.</translation>
<translation id="4699594416850504200">თქვენი უყურებთ FlyWeb for Testing-ის დაცულ გვერდს</translation>
<translation id="6224789938625024797">FlyWeb სწორად ვერ გაითიშა.</translation>
</translationbundle>