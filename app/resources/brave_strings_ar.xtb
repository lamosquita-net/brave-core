<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="1026101648481255140">استئناف التثبيت</translation>
<translation id="7099479769133613710">‏إعادة التشغيل لتحديث نظام التشغيل &amp;FlyWeb</translation>
<translation id="291426170030461697">‏ينصح FlyWeb بمراجعة هذه الإضافة</translation>
<translation id="1549005488226693697">‏عندما يطلب موقع إلكتروني تحميل الروابط في صفحته مسبقًا بخصوصية تامة، يستخدم FlyWeb خوادم FlyWeb. يؤدي هذا الإجراء إلى إخفاء هويتك عن الموقع الإلكتروني الذي يتم تحميله مسبقًا، ولكن تبقى FlyWeb على اطّلاع بالمواقع الإلكترونية التي يتم تحميلها مسبقًا.</translation>
<translation id="1065672644894730302">لا يمكن قراءة إعداداتك المفضّلة. قد تكون بعض الميزات غير متاحة، ولن يتم حفظ التغييرات في الإعدادات المفضّلة.</translation>
<translation id="8908267645832965492">‏أوقفَ أحد والدَيك "أذونات المواقع الإلكترونية والتطبيقات والإضافات" لمتصفِّح FlyWeb.</translation>
<translation id="5557633153169217776">‏يحتاج FlyWeb إلى إذن بالوصول إلى شبكتك المحلية لرصد الأجهزة المجاورة واستخدامها</translation>
<translation id="6441390163669415879">‏للبحث عن ميزة أو إضافة محدّدة في FlyWeb، عليك كتابة اختصارها في شريط العناوين متبوعًا بمفتاح لوحة المفاتيح الذي تم اختياره</translation>
<translation id="9001750423919983557">‏عرض ميزة "البحث باستخدام FlyWeb" في لوحة النظام وتفعيل اختصارات لوحة المفاتيح</translation>
<translation id="1368460307421081773">‏يرغب FlyWeb في تصدير كلمات المرور، لذا يُرجى كتابة كلمة مرور Windows للسماح بذلك.</translation>
<translation id="112640046208448578">يمكنك التعرّف على الصور أو الأماكن ونسخ النصوص أو ترجمتها. وعند استخدام ميزة "البحث بالصور"، يتمّ إرسال لقطة شاشة للصفحة إلى الخادم. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">‏FlyWeb هو متصفحك التلقائي</translation>
<translation id="4556715463645168547">‏للتحقُّق مما إذا كانت كلمات المرور آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK"/>تسجيل الدخول إلى FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">‏انقر على قائمة FlyWeb.</translation>
<translation id="1157985233335035034">أحدث اللغات</translation>
<translation id="1184145431117212167">‏تعذَّر التثبيت بسبب عدم توافُق الإصدار الذي تستخدمه من نظام التشغيل Windows.</translation>
<translation id="4380351562011537903">‏لمحة عن FlyWeb</translation>
<translation id="853148447909557566">‏تلقّي تنبيهات ميزة "تتبُّع الأسعار" باستخدام FlyWeb على هاتفك</translation>
<translation id="1203500561924088507">شكرًا على التثبيت. عليك إعادة تشغيل المتصفِّح قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">‏عند فتح ميزة "البحث بالصور"، سيتم تلقائيًا إرسال عنوان الصفحة وعنوان URL والمحتوى (بما في ذلك ملفات PDF) إلى الخادم. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">‏بعد تسجيل الدخول إلى حسابك، يمكنك استخدام كلمات المرور وغيرها من بيانات حسابك على FlyWeb في FlyWeb. لتغيير ذلك، يُرجى الانتقال إلى "حسابك في FlyWeb".</translation>
<translation id="7614508617663739435">‏عرض "Gemini في FlyWeb" في شريط قوائم Mac</translation>
<translation id="832555967476614730">‏يمكنك استخدام اختصار لوحة المفاتيح لاختيار جزء من الشاشة في "Gemini في FlyWeb".</translation>
<translation id="4750836834956739196">‏عندما كانت علامة التبويب هذه غير نشطة، تم إخلاء مساحة في الذاكرة للحفاظ على سرعة FlyWeb. يمكنك اختيار أن يظل هذا الموقع الإلكتروني نشطًا دائمًا.</translation>
<translation id="3190759351483708314">‏حَظَر FlyWeb عملية التنزيل هذه لأنّ الملف خطير.</translation>
<translation id="5879469261638423015">‏عند تسجيل الدخول إلى خدمات FlyWeb، مثل Gmail أو YouTube باستخدام <ph name="USER_EMAIL"/>، يمكنك تسجيل الدخول تلقائيًا إلى FlyWeb باستخدام الحساب نفسه</translation>
<translation id="7142135954326264349">‏تنزيل FlyWeb على هاتفك</translation>
<translation id="1290883685122687410">حدث خطأ أثناء الإعداد: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">‏إعداد ملفك الشخصي الجديد على FlyWeb</translation>
<translation id="5252737639504553444">‏يمكنك تجربة "Gemini في FlyWeb"</translation>
<translation id="609743863669742325">‏يجب منح FlyWeb الإذن بالوصول إلى البلوتوث لاستكشاف 
الأجهزة التي تتضمّن بلوتوث. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">‏تسجيل الدخول إلى FlyWeb على الهاتف</translation>
<translation id="1330562121671411446">رصد اللغة</translation>
<translation id="2276527911011636666">‏حذف البيانات من FlyWeb أيضًا (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">تمّ تثبيت اللوحة. يمكنك الوصول إلى ميزة "البحث بالصور" مرة أخرى من خلال الزر الجديد في شريط الأدوات</translation>
<translation id="1383876407941801731">البحث</translation>
<translation id="1045149878186896649">‏يمكنك استخدام تطبيق FlyWeb لمواصلة التصفّح أثناء التنقل</translation>
<translation id="141901961143729572">شارِك أفكارك</translation>
<translation id="2758515779140515865">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في FlyWeb ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="4713192356155907986">‏الحصول على مساعدة بشأن FlyWeb for Testing</translation>
<translation id="4984443629206419460">‏يمكنك تسجيل الدخول إلى FlyWeb للوصول إلى معلوماتك المحفوظة وغيرها على "<ph name="DEVICE"/>"</translation>
<translation id="1497802159252041924">حدث خطأ أثناء التثبيت: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">هذه الصفحة محمية</translation>
<translation id="8962360511570172">‏مشاركة علامة تبويب FlyWeb</translation>
<translation id="2941487459666781243">‏تسجيل الدخول إلى FlyWeb</translation>
<translation id="1547469039832541117">يؤدي النقر على هذا الزر إلى إنهاء المهمّة المحدّدة.</translation>
<translation id="3182893868355533457">‏تثبيت FlyWeb</translation>
<translation id="852852907317361085">‏أدوات الأمان في FlyWeb</translation>
<translation id="481155564361715417">‏يريد FlyWeb حذف بياناتك في "مدير كلمات المرور". للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="2846999307505917298">‏يمكنك الاستفادة من أفضل ميزات FlyWeb باستخدام تطبيق FlyWeb على هاتفك</translation>
<translation id="3961251277542681013">‏يمكنك مراجعة العناصر الرئيسية للتحكّم في الخصوصية والأمان في FlyWeb.</translation>
<translation id="1640672724030957280">جارٍ التنزيل...</translation>
<translation id="1665602916345474427">تم تسجيل الدخول باسم <ph name="USER_NAME"/>، باستخدام الحساب <ph name="USER_EMAIL"/>، ولديك اشتراك. يمكنك فتح قائمة الحسابات</translation>
<translation id="7625232007557474355">‏يمكنك استخدام FlyWeb في أي وقت عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى. وسيتم أيضًا تثبيته في شريط التطبيقات.</translation>
<translation id="1709772298389099340">توفِّر الخدمة أذونات مميّزة وعالية المستوى لمتصفِّح <ph name="BROWSER_NAME"/>.</translation>
<translation id="5695205873161614119">‏سيحذف FlyWeb بيانات التصفُّح قريبًا</translation>
<translation id="8939535770474283898">‏سيحاول FlyWeb ترقية عمليات الانتقال إلى بروتوكول HTTPS.</translation>
<translation id="2581127533455294937">‏تم محو بيانات FlyWeb</translation>
<translation id="7385422968404728039">‏ستتم إعادة تشغيل FlyWeb خلال <ph name="REMAINING_TIME"/></translation>
<translation id="6903827847227122616">‏سيستخدم FlyWeb اتصالاً غير آمن بدون تحذيرك في حال عدم توفُّر بروتوكول HTTPS.</translation>
<translation id="307170399141486420">‏دع FlyWeb يعمل في الخلفية</translation>
<translation id="5006568136491721884">‏انقر على <ph name="BEGIN_BOLD"/>نعم<ph name="END_BOLD"/> في إشعار Windows لتثبيت FlyWeb في شريط التطبيقات والوصول إليه بسرعة.</translation>
<translation id="2473319786107120819">‏إعادة تثبيت FlyWeb</translation>
<translation id="2533324957407080119">‏يحاول FlyWeb <ph name="AUTHENTICATION_PURPOSE"/>.</translation>
<translation id="6758901350197493482">‏حساب "<ph name="EXISTING_USER"/>" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في FlyWeb بحساب <ph name="USER_EMAIL_ADDRESS"/>. سيتيح لك ذلك أيضًا الوصول إلى إضافاتك وغيرها من <ph name="DEVICE"/>.</translation>
<translation id="3547283483106013256">‏عند فتح FlyWeb على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام "مدير كلمات المرور في FlyWeb".</translation>
<translation id="1838374766361614909">محو البحث</translation>
<translation id="3403116471618205223">‏لحذف بيانات التصفّح من هذا الجهاز فقط والاحتفاظ بها في حسابك على FlyWeb، يُرجى <ph name="BEGIN_LINK"/>تسجيل الخروج من FlyWeb<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">‏يكفي تنزيل متصفِّح FlyWeb على هاتفك لفتح مجموعات علامات التبويب أو إنشائها أثناء التنقّل.</translation>
<translation id="3285741355512747610">‏يمكنك إدارة حسابات FlyWeb التي تم تسجيل الدخول إليها. يتم استخدام حساباتك على FlyWeb في متصفّح FlyWeb و"متجر Play" وGmail والمزيد. إذا أردت إضافة حساب لمستخدم آخر، مثل أحد أفراد العائلة، أضِف شخصًا جديدًا إلى <ph name="DEVICE_TYPE"/> بدلاً من ذلك. <ph name="LINK_BEGIN"/>مزيد من المعلومات<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">البحث باستخدام ميزة "البحث بالصور"</translation>
<translation id="5054936737639982722">‏حساب "<ph name="EXISTING_USER"/>" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في FlyWeb بحساب <ph name="USER_EMAIL_ADDRESS"/>. سيتيح لك ذلك أيضًا الوصول إلى إشاراتك المرجعية وغيرها من <ph name="DEVICE"/>.</translation>
<translation id="1880677175115548835">اختيار نص</translation>
<translation id="4824940465467423308">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على FlyWeb. وستكون بياناتك في FlyWeb مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME"/>. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات FlyWeb، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. ويُمكنك اختيار إنشاء ملف شخصي جديد للإبقاء على بياناتك الحالية في FlyWeb بشكل مستقل. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">‏يحافظ FlyWeb على طاقة البطارية من خلال الحدّ من الأنشطة في الخلفية والتأثيرات المرئية، مثل التمرير السلس وعدد اللقطات في الثانية للفيديو. <ph name="BEGIN_LINK"/>مزيد من المعلومات حول ميزة "توفير البطارية"<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">‏خدمة FlyWeb Updater</translation>
<translation id="7390382558747224642">‏من خلال إيقاف هذا الإعداد، يمكنك تسجيل الدخول إلى "مواقع FlyWeb" مثل Gmail بدون الحاجة إلى تسجيل الدخول إلى FlyWeb</translation>
<translation id="5714085538350759767">‏لا يستجيب FlyWeb. هل تريد إعادة التشغيل الآن؟</translation>
<translation id="5866699689358760578">‏تطلُب المؤسسة (<ph name="MANAGER"/>) منك تسجيل الدخول إلى FlyWeb</translation>
<translation id="4035053306113201399">‏يجب إعادة تشغيل نظام التشغيل FlyWeb حتى يتم تطبيق التحديث.</translation>
<translation id="3750729306035486751">‏حَظَر FlyWeb عملية التنزيل هذه لأنّ نوع الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="1953553007165777902">جارٍ التنزيل… عدد الدقائق المتبقّية: <ph name="MINUTE"/></translation>
<translation id="6956650624767954726">‏يتعذَّر على FlyWeb تحديد المتصفح التلقائي أو تعيينه</translation>
<translation id="197326043290947695">التصفّح أذكى مع ميزة "البحث بالصور"</translation>
<translation id="130679046523922050">‏التعرّف على سبب حظر بعض الملفات في FlyWeb، يتم فتح الرابط في علامة تبويب جديدة</translation>
<translation id="8243822903505210769">‏تساعد هذه الخدمة على تحديث برامج FlyWeb باستمرار. لذا في حال إيقافها بشكل نهائي أو مؤقت، لن يتم تحديث برامج FlyWeb باستمرار، ما يعني أنّه لا يمكن إصلاح الثغرات الأمنية التي قد تحدث وقد لا تعمل بعض الميزات. ويتمّ إلغاء تثبيت هذه الخدمة تلقائيًا من الجهاز عند عدم استخدام أي من برامج FlyWeb لها.</translation>
<translation id="6495079989036864983">‏سيعمل هذا على حذف عنصر واحد من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى FlyWeb كـ <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">تعذّر التثبيت. يُرجى إعادة المحاولة.</translation>
<translation id="2039417478970545937">الإعدادات</translation>
<translation id="8544477465831682343">‏اختَر ما إذا كنت تريد تضمين سجلّ FlyWeb للحصول على تجارب أكثر تخصيصًا في خدمات FlyWeb.</translation>
<translation id="328650761750741315">‏هذه الخدمة مضمّنة في FlyWeb لمساعدتك في إنشاء كلمات مرور قوية وحفظها وملئها تلقائيًا. ويمكنك إضافة اختصار للوصول إليها بسهولة.</translation>
<translation id="2407746489237278840">‏يمكنك النقر على زر "تخصيص FlyWeb" في صفحة "علامة تبويب جديدة" لإضفاء مظهر جديد عليه</translation>
<translation id="8924891216494775926">‏حَظَر FlyWeb عملية التنزيل هذه لأنّ الملف مخادع وقد يُجري تغييرات غير متوقعة على جهازك.</translation>
<translation id="5728214838078602184">‏ستظهر لك رسالة تطلب منك تجربة "<ph name="FEATURE_NAME"/>" عند فتح FlyWeb على iOS في المرة القادمة.</translation>
<translation id="2058207584484841616">‏ستتم إزالة كلمات المرور وبيانات FlyWeb الأخرى التي تم حفظها في حسابك على FlyWeb من هذا الجهاز. ولاستخدامها مرة أخرى في FlyWeb، عليك تسجيل الدخول مجددًا.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة دقيقة واحدة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}two{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة دقيقتَين. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}few{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقائق. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}many{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}other{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام FlyWeb لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}}</translation>
<translation id="2125838419757773031">يمكنك تحديد أي محتوى على الشاشة للبحث عنه</translation>
<translation id="2126108037660393668">تعذَّر التحقق من الملف الذي تم تنزيله.</translation>
<translation id="2135919691573380097">الإبلاغ عن هذا الموقع الإلكتروني</translation>
<translation id="2137162749895930932">إغلاق شاشة الترجمة</translation>
<translation id="2147218225094845757">إخفاء اللوحة الجانبية</translation>
<translation id="4474394796469499134">‏حَظَر FlyWeb عملية التنزيل هذه لأنّ الموقع الإلكتروني لا يستخدم اتصالاً آمنًا وربما تمّ التلاعب بالملف.</translation>
<translation id="2170098639895543546">اختيار أي محتوى على الصفحة</translation>
<translation id="6765231735885996239">‏تخصيص FlyWeb</translation>
<translation id="2174917724755363426">لم يكتمل التثبيت. هل تريد فعلاً الإلغاء؟</translation>
<translation id="2937508664417729967">‏FlyWeb - تسجيل الدخول إلى الشبكة - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">خطأ في عملية التحقق من التحديث: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">‏إزالة الحساب من FlyWeb</translation>
<translation id="744837314710861405">‏أفضل أدوات التسوق ستكون متاحة لك أثناء التنقل باستخدام تطبيق FlyWeb</translation>
<translation id="2745381939758295588">‏يمكنك الحفاظ على أمانك أثناء التنقّل باستخدام ميزة "الحماية المحسّنة للتصفّح الآمن" في FlyWeb على أجهزة iOS</translation>
<translation id="6707114110652917144">‏هذا الموقع الإلكتروني خطير، لذلك أزال FlyWeb إذن الإشعارات.</translation>
<translation id="2236949375853147973">نشاطي</translation>
<translation id="4646732243247482236">‏يمكنك تسجيل الدخول إلى FlyWeb للوصول إلى العناوين وغيرها على جميع أجهزتك. وسيتم حفظ هذا العنوان في حسابك على FlyWeb بعد تسجيل الدخول.</translation>
<translation id="2726680594710751908">‏إذا كنت تشارك الكمبيوتر مع أصدقائك وعائلتك، فبإمكانهم التصفح على حدة وإعداد FlyWeb على النحو الذي يريدونه.</translation>
<translation id="4086571337340463916">‏"المهارات" في FlyWeb</translation>
<translation id="2283803047247799269">البحث في علامة التبويب هذه باستخدام ميزة "البحث بالصور"</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{‏ينصح FlyWeb بإيقاف علامة التبويب التي تبطئ المتصفّح مؤقتًا}zero{‏ينصح FlyWeb بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}two{‏ينصح FlyWeb بإيقاف علامتَي التبويب اللتين تبطئان المتصفّح مؤقتًا}few{‏ينصح FlyWeb بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}many{‏ينصح FlyWeb بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}other{‏ينصح FlyWeb بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}}</translation>
<translation id="2307973900865360088">‏إبقاء التطبيق في شريط التطبيقات (Dock)</translation>
<translation id="5067150284614317159">‏يعمل هذا الوضع على التحقّق من عناوين URL التي تحتوي على قائمة بمواقع إلكترونية غير آمنة مُخزّنة في FlyWeb. وإذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسل متصفِّح FlyWeb أيضًا عناوين URL تتضمّن أجزاء من محتوى الصفحة إلى "التصفُّح الآمن".</translation>
<translation id="2356070529366658676">طلب</translation>
<translation id="2359808026110333948">متابعة</translation>
<translation id="7339360994527471629">‏تطلب منك الإضافة "<ph name="EXTENSION_NAME"/>" تسجيل الدخول إلى FlyWeb</translation>
<translation id="8788732221355188962">‏إيقاف تشغيل FlyWeb في الخلفية أثناء عمل التطبيقات</translation>
<translation id="4126251160852694747">‏لاستخدام هذه الإضافة على الحساب <ph name="USER_EMAIL_ADDRESS"/>، عليك تسجيل الدخول إلى FlyWeb.</translation>
<translation id="8418845734693287262">‏تعذّر على نظام التشغيل FlyWeb مزامنة بياناتك لأن تفاصيل تسجيل الدخول إلى حسابك قديمة.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات FlyWeb تصل إلى جهاز HID واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات FlyWeb إلى جهاز HID واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات FlyWeb إلى جهازَي HID}few{‏تصل إضافة واحدة أو أكثر من إضافات FlyWeb إلى # أجهزة HID}many{‏تصل إضافة واحدة أو أكثر من إضافات FlyWeb إلى # جهاز HID}other{‏تصل إضافة واحدة أو أكثر من إضافات FlyWeb إلى # جهاز HID}}</translation>
<translation id="1364879203203742966">‏يحتاج FlyWeb إلى إذن للوصول إلى الكاميرا والميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="2403703063067034158">خطأ في بدء التشغيل: هناك عملية إعداد أخرى قيد التشغيل حاليًا. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="656987653252575654">‏يمكنك فتح الروابط من أي تطبيق على FlyWeb والوصول إلى المتصفّح بسهولة من خلال شريط المهام</translation>
<translation id="157662717324308283">‏يمكنك النقر على زر "تلخيص" لمشاركة هذا المستند مع "Gemini في FlyWeb" والحصول على نظرة عامة سريعة وطرح أسئلة إضافية</translation>
<translation id="1968013196034892522">‏باستخدام <ph name="BEGIN_LINK"/>أدوات من FlyWeb<ph name="END_LINK"/>، يمكنك التصفُّح بأمان والتحكُّم بشكل كامل</translation>
<translation id="1716762085628757512">‏حساب "<ph name="EXISTING_USER"/>" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في FlyWeb بحساب <ph name="USER_EMAIL_ADDRESS"/>. سيتيح لك ذلك أيضًا الوصول إلى كلمات المرور وغيرها على جميع أجهزتك.</translation>
<translation id="2451727308784734061">استخدِم الاختصار للوصول بسرعة إلى "مدير كلمات المرور". بإمكانك نقل هذا الاختصار إلى الشاشة الرئيسية أو مشغِّل التطبيقات في جهاز الكمبيوتر.</translation>
