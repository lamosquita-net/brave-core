   const Element& anchor = ValidationAnchor();
-  const HTMLElement& host = ToHTMLElement();
   if (anchor.IsFocusable())
     return true;
+  const Element& host = GetHostOrFocusDelegate();
   if (&anchor == &host)
     return false;
   return host.IsFocusable();
