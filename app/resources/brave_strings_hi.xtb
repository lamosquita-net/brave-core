<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
<translation id="1026101648481255140">इंस्टॉल करने की प्रोसेस को दोबारा चालू करें</translation>
<translation id="7099479769133613710">&amp;ChromeOS को अपडेट करने के लिए, उसे फिर से लॉन्च करें</translation>
<translation id="291426170030461697">FlyWeb आपको इस एक्सटेंशन की जांच करने का सुझाव देता है</translation>
<translation id="1549005488226693697">जब कोई साइट अपने पेज पर, लिंक को निजी तौर पर पहले से लोड करने के लिए कहती है, तो FlyWeb, FlyWeb के सर्वर का इस्तेमाल करता है. इस वजह से, पहले से लोड की गई साइट से आपकी पहचान छिपी रहती है. हालांकि, FlyWeb को पता चल जाता है कि कौन-कौनसी साइटें पहले से लोड हुई हैं.</translation>
<translation id="1065672644894730302">आपकी प्राथमिकताओं को पढ़ा नहीं जा सकता| \\n\\nकुछ विशेषताएं अनुपलब्ध हो सकती हैं और प्राथमिकताओं में किए गए परिवर्तनों को सहेजा नहीं जाएगा.</translation>
<translation id="8908267645832965492">आपके माता-पिता ने FlyWeb के लिए, "साइट, ऐप्लिकेशन, और एक्सटेंशन के लिए अनुमतियां" को बंद कर दिया है</translation>
<translation id="5557633153169217776">आस-पास मौजूद डिवाइसों को खोजने और उनका इस्तेमाल करने के लिए, FlyWeb को आपके लोकल नेटवर्क का ऐक्सेस चाहिए</translation>
<translation id="6441390163669415879">FlyWeb की किसी सुविधा या एक्सटेंशन को खोजने के लिए, पता बार में उसका शॉर्टकट टाइप करें. इसके बाद, अपने हिसाब से कीबोर्ड शॉर्टकट दबाएं</translation>
<translation id="9001750423919983557">'FlyWeb की मदद से खोजें' सुविधा को सिस्टम ट्रे में दिखाएं और कीबोर्ड शॉर्टकट चालू करें</translation>
<translation id="1368460307421081773">FlyWeb आपके पासवर्ड निर्यात करना चाहता है. इसकी मंज़ूरी देने के लिए अपना Windows पासवर्ड लिखें.</translation>
<translation id="112640046208448578">चीज़ों या जगहों की पहचान करें और टेक्स्ट को कॉपी करें या उसका अनुवाद करें. इमेज सर्च का इस्तेमाल करने पर, सर्वर को उस पेज का एक स्क्रीनशॉट भेजा जाता है. <ph name="LEARN_MORE"/></translation>
<translation id="7307912249127683931">FlyWeb आपका डिफ़ॉल्ट ब्राउज़र है</translation>
<translation id="4556715463645168547">डेटा के गलत इस्तेमाल और सुरक्षा की अन्य समस्याओं से आपके पासवर्ड सुरक्षित हैं या नहीं, इसकी जांच करने के लिए, <ph name="BEGIN_LINK"/>FlyWeb में साइन इन करें<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">'FlyWeb मेन्यू' पर क्लिक करें</translation>
<translation id="1157985233335035034">हाल ही की भाषाएं</translation>
<translation id="1184145431117212167">इंस्टॉल नहीं किया जा सका, क्योंकि Windows के आपके वर्शन पर यह काम नहीं करता.</translation>
<translation id="4380351562011537903">FlyWeb के बारे में</translation>
<translation id="853148447909557566">अपने फ़ोन पर FlyWeb से, प्रॉडक्ट की कीमत ट्रैक करने की सुविधा से जुड़ी सूचनाएं पाएं</translation>
<translation id="1203500561924088507">इंस्टॉल करने के लिए धन्यवाद. <ph name="BUNDLE_NAME"/> का इस्तेमाल करने से पहले, ब्राउज़र को रीस्टार्ट करना ज़रूरी है.</translation>
<translation id="1232234696885483911">इमेज सर्च खोलने पर, पेज का टाइटल, यूआरएल, और कॉन्टेंट अपने-आप सर्वर पर भेज दिया जाएगा. इसमें PDF भी शामिल हैं. <ph name="LEARN_MORE"/></translation>
<translation id="1281995243191427524">साइन इन रहने के दौरान, आपके पास FlyWeb में अपने FlyWeb खाते से पासवर्ड और अन्य चीज़ों का इस्तेमाल करने का विकल्प होता है. इसे बदलने के लिए, “FlyWeb में आपका खाता” पर जाएं.</translation>
<translation id="7614508617663739435">Gemini को FlyWeb में, Mac के मेन्यू बार में दिखाएं</translation>
<translation id="832555967476614730">'FlyWeb में Gemini' से स्क्रीन पर दिख रहे कॉन्टेंट का कोई हिस्सा चुनने के लिए, कीबोर्ड शॉर्टकट का इस्तेमाल करें.</translation>
<translation id="4750836834956739196">टैब के इनऐक्टिव होने पर मेमोरी खाली की गई थी, ताकि FlyWeb को तेज़ी से ऐक्सेस किया जा सके. इस साइट को हमेशा ऐक्टिव रखने का विकल्प चुना जा सकता है.</translation>
<translation id="3190759351483708314">FlyWeb ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह फ़ाइल खतरनाक है</translation>
<translation id="5879469261638423015">Gmail या YouTube जैसी FlyWeb की सेवाओं में <ph name="USER_EMAIL"/> से साइन इन करने पर, FlyWeb में इसी खाते से अपने-आप साइन इन किया जा सकता है</translation>
<translation id="7142135954326264349">अपने फ़ोन पर FlyWeb डाउनलोड करें</translation>
<translation id="1290883685122687410">सेटअप करने में गड़बड़ी हुई: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">FlyWeb पर अपनी नई प्रोफ़ाइल सेट अप करें</translation>
<translation id="5252737639504553444">FlyWeb में Gemini को आज़माएं</translation>
<translation id="609743863669742325">FlyWeb को ब्लूटूथ का ऐक्सेस चाहिए, ताकि वह ब्लूटूथ डिवाइस ढूंढ पाए. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3619355348488493314">अपने फ़ोन पर FlyWeb में साइन इन करें</translation>
<translation id="1330562121671411446">भाषा का पता लगाएं</translation>
<translation id="2276527911011636666">FlyWeb (<ph name="URL"/>) से भी डेटा मिटाएं</translation>
<translation id="1345251407431278948">पिन किया गया! टूलबार में मौजूद नए बटन की मदद से, 'इमेज सर्च' सुविधा को फिर से ऐक्सेस किया जा सकता है</translation>
<translation id="1383876407941801731">खोजें</translation>
<translation id="1045149878186896649">FlyWeb ऐप्लिकेशन का इस्तेमाल करें और कभी भी, कहीं भी ब्राउज़ करना जारी रखें</translation>
<translation id="141901961143729572">अपने विचार शेयर करें</translation>
<translation id="2758515779140515865">विंडो शेयर करने के लिए, 'सिस्टम सेटिंग' में जाकर FlyWeb के लिए स्क्रीन रिकॉर्ड करने की अनुमति दें.</translation>
<translation id="4713192356155907986">FlyWeb for Testing से जुड़ी सहायता पाएं</translation>
<translation id="4984443629206419460"><ph name="DEVICE"/> में सेव की गई जानकारी वगैरह ऐक्सेस करने के लिए, FlyWeb में साइन इन करें</translation>
<translation id="1497802159252041924">इंस्टॉल करने में गड़बड़ी: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">इस पेज को सुरक्षित किया गया है</translation>
<translation id="8962360511570172">FlyWeb का टैब शेयर करें</translation>
<translation id="2941487459666781243">FlyWeb में साइन इन करें</translation>
<translation id="1547469039832541117">इससे, हाइलाइट किया गया टास्क बंद हो जाता है.</translation>
<translation id="3182893868355533457">FlyWeb को पिन करें</translation>
<translation id="852852907317361085">FlyWeb के सुरक्षा टूल</translation>
<translation id="481155564361715417">FlyWeb, आपके Password Manager के डेटा को मिटाना चाहता है. इसकी अनुमति देने के लिए, Windows का पासवर्ड डालें.</translation>
<translation id="2846999307505917298">अपने फ़ोन पर FlyWeb ऐप्लिकेशन डाउनलोड करके, FlyWeb की बेहतरीन सुविधाओं का इस्तेमाल करें</translation>
<translation id="3961251277542681013">FlyWeb के निजता और सुरक्षा से जुड़े मुख्य कंट्रोल देखें</translation>
<translation id="1640672724030957280">डाउनलोड हो रहा है...</translation>
<translation id="1665602916345474427">आपने सदस्यता वाले <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/> के खाते से साइन इन किया है. खाते का मेन्यू खोलें</translation>
<translation id="7625232007557474355">मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मौजूद लिंक पर क्लिक करके कभी भी FlyWeb इस्तेमाल करें. इसे आपके टास्कबार पर भी पिन कर दिया जाएगा.</translation>
<translation id="1709772298389099340">यह <ph name="BROWSER_NAME"/> के लिए खास सुविधाओं का ऐक्सेस देती है.</translation>
<translation id="5695205873161614119">FlyWeb जल्द ही ब्राउज़िंग डेटा को मिटा देगा</translation>
<translation id="8939535770474283898">FlyWeb, नेविगेशन को एचटीटीपीएस पर अपग्रेड करने की कोशिश करेगा</translation>
<translation id="2581127533455294937">FlyWeb का डेटा साफ़ हो गया</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/> में रीस्टार्ट होगा</translation>
<translation id="6903827847227122616">एचटीटीपीएस उपलब्ध न होने पर, FlyWeb आपको चेतावनी दिए बिना असुरक्षित कनेक्शन का इस्तेमाल करेगा</translation>
<translation id="307170399141486420">FlyWeb को पृष्ठभूमि में चलने दें</translation>
<translation id="5006568136491721884">FlyWeb को अपने टास्कबार पर पिन करने के लिए, Windows की सूचना में <ph name="BEGIN_BOLD"/>हां<ph name="END_BOLD"/> पर क्लिक करें. इससे यह तुरंत ऐक्सेस किया जा सकेगा.</translation>
<translation id="2473319786107120819">FlyWeb को फिर से इंस्टॉल करें</translation>
<translation id="2533324957407080119">FlyWeb, <ph name="AUTHENTICATION_PURPOSE"/> की कोशिश कर रहा है</translation>
<translation id="6758901350197493482"><ph name="EXISTING_USER"/> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, FlyWeb में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS"/> से साइन इन करें. इससे आपको <ph name="DEVICE"/> पर एक्सटेंशन वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="3547283483106013256">अगली बार अपने <ph name="DEVICE_TYPE"/> पर FlyWeb खोलने पर, आपको FlyWeb Password Manager इस्तेमाल करने का प्रॉम्प्ट दिखेगा.</translation>
<translation id="1838374766361614909">खोज साफ़ करें</translation>
<translation id="3403116471618205223">ब्राउज़िंग डेटा को सिर्फ़ इस डिवाइस से मिटाने और अपने FlyWeb खाते में सेव रखने के लिए, <ph name="BEGIN_LINK"/>FlyWeb से साइन आउट करें<ph name="END_LINK"/>.</translation>
<translation id="1909454687815628855">अपने फ़ोन पर FlyWeb डाउनलोड करें, ताकि आप कभी भी, कहीं भी टैब ग्रुप खोल सकें या नए टैब ग्रुप बना सकें.</translation>
<translation id="3285741355512747610">आप अपने साइन-इन किए गए FlyWeb खाते मैनेज कर सकते हैं. आपके FlyWeb खाते, FlyWeb ब्राउज़र, Play Store, Gmail वगैरह के लिए इस्तेमाल किए जाते हैं. अगर आप किसी अन्य व्यक्ति के लिए कोई खाता जोड़ना चाहते हैं, तो अपने <ph name="DEVICE_TYPE"/> में एक नया व्यक्ति जोड़ें. <ph name="LINK_BEGIN"/>ज़्यादा जानें<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">'इमेज सर्च' सुविधा की मदद से खोजें</translation>
<translation id="5054936737639982722"><ph name="EXISTING_USER"/> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, FlyWeb में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS"/> से साइन इन करें. इससे आपको <ph name="DEVICE"/> पर बुकमार्क वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="1880677175115548835">लेख चुनें</translation>
<translation id="4824940465467423308">आप प्रबंधित खाते से साइन इन कर रहे हैं और उसके एडमिन को अपनी FlyWeb प्रोफ़ाइल पर नियंत्रण दे रहे हैं. आपका FlyWeb डेटा, जैसे आपके ऐप्लिकेशन, बुकमार्क, इतिहास, पासवर्ड, और दूसरे सेटिंग स्थायी रूप से <ph name="USER_NAME"/> से जुड़ जाएंगे. आप FlyWeb खाता डैशबोर्ड के ज़रिए इस डेटा को मिटा सकेंगे, लेकिन दूसरे किसी खाते से इस डेटा को जोड़ नहीं सकेंगे. आप अपने मौजूदा FlyWeb डेटा को अलग रखने के लिए वैकल्पिक रूप से एक नई प्रोफ़ाइल बना सकते हैं. <ph name="LEARN_MORE"/></translation>
<translation id="3265644666513019061">इस सेटिंग के चालू होने पर FlyWeb, बैकग्राउंड में चलने वाली गतिविधि और विज़ुअल इफ़ेक्ट, जैसे कि स्मूद स्क्रोलिंग और वीडियो के फ़्रेम रेट को सीमित करके बैटरी की खपत को कम करता है. <ph name="BEGIN_LINK"/>एनर्जी सेवर के बारे में ज़्यादा जानें<ph name="END_LINK"/></translation>
<translation id="6773732565528662666">FlyWeb अपडेटर सर्विस</translation>
<translation id="7390382558747224642">इसे बंद करके, आप FlyWeb में साइन इन किए बिना Gmail जैसी FlyWeb साइटों में साइन इन कर सकते हैं</translation>
<translation id="5714085538350759767">FlyWeb अनुत्तरदायी है. अभी रीलॉन्‍च करें?</translation>
<translation id="5866699689358760578">आपके संगठन <ph name="MANAGER"/> के मुताबिक, यह ज़रूरी है कि आप FlyWeb में साइन इन करें</translation>
<translation id="4035053306113201399">अपडेट को लागू करने के लिए, ChromeOS को रीस्टार्ट करने की ज़रूरत होती है.</translation>
<translation id="3750729306035486751">FlyWeb ने इस डाउनलोड को ब्लॉक किया है, क्योंकि इस तरह की फ़ाइल आम तौर पर डाउनलोड नहीं की जाती और यह खतरनाक हो सकती है</translation>
<translation id="1953553007165777902">डाउनलोड हो रहा है... <ph name="MINUTE"/> मिनट बचे हैं</translation>
<translation id="6956650624767954726">FlyWeb, डिफ़ॉल्ट ब्राउज़र को तय या सेट नहीं कर सकता</translation>
<translation id="197326043290947695">इमेज सर्च से बेहतर तरीके से ब्राउज़ करें</translation>
<translation id="130679046523922050">जानें कि FlyWeb कुछ फ़ाइलों को ब्लॉक क्यों करता है, यह जानकारी नए टैब में खुलती है</translation>
<translation id="8243822903505210769">इससे आपका FlyWeb सॉफ़्टवेयर अप-टू-डेट रहता है. अगर इस सेवा को हमेशा या कुछ समय के लिए बंद किया जाता है, तो आपका FlyWeb सॉफ़्टवेयर अप-टू-डेट नहीं होगा. इसका मतलब है कि सुरक्षा से जुड़े जोखिम हो सकते हैं. साथ ही. उन्हें ठीक नहीं किया जा सकता और ऐसा भी हो सकता है कि ये सुविधाएं काम न करें. अगर कोई FlyWeb सॉफ़्टवेयर इसका इस्तेमाल नहीं करता है, तो यह सेवा अपने-आप अनइंस्टॉल हो जाती है.</translation>
<translation id="6495079989036864983">ऐसा करने से इस डिवाइस से 1 आइटम मिट जाएगा. बाद में अपना डेटा पाने के लिए, FlyWeb में <ph name="USER_EMAIL"/> के रूप में साइन इन करें.</translation>
<translation id="2018879682492276940">इंस्टॉल नहीं हो सका. कृपया फिर से कोशिश करें.</translation>
<translation id="2039417478970545937">सेटिंग.</translation>
<translation id="8544477465831682343">चुनें कि FlyWeb की सेवाओं में अपने हिसाब से और बेहतर अनुभव पाने के लिए, FlyWeb पर सेव किए गए आपके ब्राउज़िंग इतिहास को शामिल करना है या नहीं</translation>
<translation id="328650761750741315">यह सुविधा FlyWeb में पहले से मौजूद है. इससे आपको मज़बूत पासवर्ड बनाने, सेव करने, और उसे ऑटोमैटिक तरीके से भरने में मदद मिलती है. इसे आसानी से ऐक्सेस करने के लिए शॉर्टकट जोड़ें.</translation>
<translation id="2407746489237278840">FlyWeb को नया लुक देने के लिए, 'नया टैब' पेज पर मौजूद 'FlyWeb को पसंद के मुताबिक बनाएं' बटन पर क्लिक करें</translation>
<translation id="8924891216494775926">FlyWeb ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह धोखाधड़ी वाली फ़ाइल है और यह आपके डिवाइस में अनचाहे बदलाव कर सकती है</translation>
<translation id="5728214838078602184">अगली बार FlyWeb iOS खोलने पर, आपको <ph name="FEATURE_NAME"/> आज़माने का प्रॉम्प्ट दिखेगा.</translation>
<translation id="2058207584484841616">आपने अपने FlyWeb खाते में जो अलग-अलग पासवर्ड और FlyWeb से जुड़ा अन्य डेटा सेव किया है उसे इस डिवाइस से हटा दिया जाएगा. FlyWeb में इस डेटा का फिर से इस्तेमाल करने के लिए, दोबारा साइन इन करें.</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{FlyWeb का 1 मिनट तक इस्तेमाल न करने पर, आपका संगठन ब्राउज़िंग डेटा को अपने-आप मिटा देता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं. आपके टैब खुले रहेंगे.}one{FlyWeb का # मिनट तक इस्तेमाल न करने पर, आपका संगठन ब्राउज़िंग डेटा को अपने-आप मिटा देता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं. आपके टैब खुले रहेंगे.}other{FlyWeb का # मिनट तक इस्तेमाल न करने पर, आपका संगठन ब्राउज़िंग डेटा को अपने-आप मिटा देता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं. आपके टैब खुले रहेंगे.}}</translation>
<translation id="2125838419757773031">खोजने के लिए स्क्रीन का कोई हिस्सा चुनें</translation>
<translation id="2126108037660393668">डाउनलोड की गई फ़ाइल की पुष्टि नहीं हो पाई.</translation>
<translation id="2135919691573380097">इस साइट की शिकायत करें</translation>
<translation id="2137162749895930932">'स्क्रीन का अनुवाद करें' मोड बंद करें</translation>
<translation id="2147218225094845757">साइड पैनल छिपाएं</translation>
<translation id="4474394796469499134">FlyWeb ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह साइट सुरक्षित कनेक्शन का इस्तेमाल नहीं कर रही है और हो सकता है कि फ़ाइल के साथ छेड़छाड़ की गई हो</translation>
<translation id="2170098639895543546">पेज पर मौजूद कोई भी आइटम चुनें</translation>
<translation id="6765231735885996239">FlyWeb को पसंद के मुताबिक बनाएं</translation>
<translation id="2174917724755363426">इंस्टॉल करने की प्रोसेस पूरी नहीं हुई. क्या आपको वाकई इसे रद्द करना है?</translation>
<translation id="2937508664417729967">FlyWeb - नेटवर्क में साइन इन करें - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">अपडेट जांच में यह गड़बड़ी है: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">FlyWeb से खाता हटाएं</translation>
<translation id="744837314710861405">FlyWeb ऐप्लिकेशन की मदद से, खरीदारी करने के लिए बेहतरीन टूल कभी भी, कहीं भी इस्तेमाल करें</translation>
<translation id="2745381939758295588">iOS के लिए FlyWeb पर बेहतर सुरक्षित ब्राउज़िंग की सुविधा चालू करें और कभी भी, कहीं भी सुरक्षित रहें</translation>
<translation id="6707114110652917144">खतरनाक साइट. FlyWeb ने सूचनाएं पाने की अनुमति हटा दी है.</translation>
<translation id="2236949375853147973">मेरी गतिविधि</translation>
<translation id="4646732243247482236">अपने सभी डिवाइसों से ईमेल पते वगैरह ऐक्सेस करने के लिए, FlyWeb में साइन इन करें. इसके बाद, यह ईमेल पता आपके FlyWeb खाते में सेव हो जाएगा.</translation>
<translation id="2726680594710751908">अगर आप किसी कंप्यूटर को शेयर करते हैं, तो दोस्त और परिवार अलग-अलग ब्राउज़ कर सकते हैं और FlyWeb को जैसा चाहें सेट कर सकते हैं.</translation>
<translation id="4086571337340463916">FlyWeb में मौजूद स्किल</translation>
<translation id="2283803047247799269">इमेज सर्च की मदद से इस टैब को खोजें</translation>
<translation id="7177582861426663464">{NUM_TABS,plural, =1{FlyWeb का सुझाव है कि आप उस टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहा है}one{FlyWeb का सुझाव है कि आप उस टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहा है}other{FlyWeb का सुझाव है कि आप उन टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहे हैं}}</translation>
<translation id="2307973900865360088">डॉक में रखें</translation>
<translation id="5067150284614317159">FlyWeb में पहले से सेव असुरक्षित साइटों की सूची का इस्तेमाल करके, यूआरएल की जांच करता है. अगर कोई साइट आपका पासवर्ड चुराने की कोशिश करती है या नुकसान पहुंचाने वाली कोई फ़ाइल डाउनलोड होने पर FlyWeb, सुरक्षित ब्राउज़िंग की सेवा को उनका यूआरएल भेजता है. यूआरएल के साथ-साथ पेज का कुछ कॉन्टेंट भी भेजा जाता है.</translation>
<translation id="2356070529366658676">पूछें</translation>
<translation id="2359808026110333948">जारी रखें</translation>
<translation id="7339360994527471629">"<ph name="EXTENSION_NAME"/>" एक्सटेंशन का इस्तेमाल करने के लिए, आपको FlyWeb में साइन इन करना होगा</translation>
<translation id="8788732221355188962">ऐप्लिकेशन चलने के दौरान, FlyWeb को बैकग्राउंड में चलने से रोकें</translation>
<translation id="4126251160852694747">इस एक्सटेंशन को <ph name="USER_EMAIL_ADDRESS"/> के तौर पर इस्तेमाल करने के लिए, FlyWeb में साइन इन करें.</translation>
<translation id="8418845734693287262">ChromeOS आपका डेटा सिंक नहीं कर सका, क्योंकि आपके खाते में साइन इन करने से जुड़ी जानकारी पुरानी हो चुकी है.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{एक या उससे ज़्यादा FlyWeb एक्सटेंशन, 1 एचआईडी डिवाइस को ऐक्सेस कर रहे थे}=1{एक या उससे ज़्यादा FlyWeb एक्सटेंशन, 1 एचआईडी डिवाइस को ऐक्सेस कर रहे हैं}one{एक या उससे ज़्यादा FlyWeb एक्सटेंशन, # एचआईडी डिवाइस को ऐक्सेस कर रहे हैं}other{एक या उससे ज़्यादा FlyWeb एक्सटेंशन, # एचआईडी डिवाइसों को ऐक्सेस कर रहे हैं}}</translation>
<translation id="1364879203203742966">FlyWeb को इस साइट के लिए, माइक्रोफ़ोन और कैमरा ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="2403703063067034158">स्टार्टअप में गड़बड़ी: फ़िलहाल, कोई दूसरी चीज़ सेटअप हो रही है. कृपया बाद में कोशिश करें.</translation>
<translation id="656987653252575654">किसी भी ऐप्लिकेशन से FlyWeb में लिंक खोलें और ब्राउज़र को अपने टास्कबार पर ऐक्सेस करें</translation>
<translation id="157662717324308283">इस दस्तावेज़ को FlyWeb में Gemini के साथ शेयर करने के लिए 'खास जानकारी पाएं' बटन पर क्लिक करें. इससे आपको दस्तावेज़ की खास जानकारी तुरंत मिलेगी और फ़ॉलो-अप वाले सवाल पूछे जा सकेंगे</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>FlyWeb के टूल<ph name="END_LINK"/> की मदद से, सुरक्षित तरीके से ब्राउज़िंग की जा सकती है. साथ ही, अपना डेटा भी कंट्रोल किया जा सकता है</translation>
<translation id="1716762085628757512"><ph name="EXISTING_USER"/> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, FlyWeb में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS"/> से साइन इन करें. इससे आपको अपने सभी डिवाइसों पर पासवर्ड वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="2451727308784734061">Password Manager को फटाफट ऐक्सेस करने के लिए, शॉर्टकट का इस्तेमाल करें. आपके पास, अपने शॉर्टकट को कंप्यूटर की होम स्क्रीन पर या ऐप्लिकेशन लॉन्चर पर ले जाने का विकल्प है.</translation>
<translation id="3224379053610845181">FlyWeb जल्द ही बंद हो जाएगा</translation>
<translation id="3840682988105604367">FlyWeb में</translation>
<translation id="2485422356828889247">विस्थापित करें</translation>
<translation id="2513154137948333830">सिस्टम फिर से चालू करना होगा: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">'इमेज सर्च' सुविधा की मदद से टेक्स्ट चुनें</translation>
<translation id="6823116595279840454">FlyWeb मौजूदा पासवर्ड बदलने की कोशिश कर रहा है. इसकी अनुमति देने के लिए, Windows का पासवर्ड डालें.</translation>
<translation id="2691552788029831386">फ़ाइलें डाउनलोड करने के लिए FlyWeb को मेमोरी एक्‍सेस की ज़रूरत होगी</translation>
<translation id="2275866327478859777">FlyWeb सहायक</translation>
<translation id="2575822587468774919">'इमेज सर्च' सुविधा की मदद से जानकारी खोजने के लिए, कोई भी एलिमेंट चुनें</translation>
<translation id="683641781063074351">अपने सभी डिवाइसों से पासवर्ड वगैरह ऐक्सेस करने के लिए, FlyWeb में साइन इन करें</translation>
<translation id="1659167470250249643">FlyWeb डाउनलोड करने और अपने FlyWeb खाते में साइन इन करने के लिए, अपने फ़ोन से क्यूआर कोड को स्कैन करें.</translation>
<translation id="5353172248151202719">FlyWeb की मदद से खोजने के लिए.</translation>
<translation id="3231856291920394348">FlyWeb को इस्तेमाल करना जारी रखें</translation>
<translation id="259935314519650377">डाउनलोड किए गए इंस्टॉलर को कैश मेमोरी में सेव नहीं किया जा सका. गड़बड़ी: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">सिस्टम</translation>
<translation id="7683745685556117660">आपका संगठन, आपकी प्रोफ़ाइल में मौजूद ब्राउज़िंग डेटा देख सकता है और उसे मैनेज कर सकता है. जैसे, आपके बुकमार्क, ब्राउज़िंग इतिहास, और पासवर्ड. हालांकि, वह FlyWeb पर बनाई गईं अन्य प्रोफ़ाइलों से जुड़ा ब्राउज़िंग डेटा नहीं देख सकता</translation>
<translation id="5862783156828836752">अपनी पहचान की पुष्टि करें, ताकि आप अपने खाते <ph name="ACCOUNT_EMAIL"/> में FlyWeb का डेटा इस्तेमाल और सेव कर पाएं</translation>
<translation id="4450675160413947126">FlyWeb प्रारंभ करें</translation>
<translation id="3827993926722004004">इंस्‍टॉलेशन के दौरान ऑपरेटिंग सिस्‍टम गड़बड़ी हुई. कृपया FlyWeb फिर से डाउनलोड करें.</translation>
<translation id="333184635927514678">अगर आप कोई डिवाइस शेयर करते हैं, तो आपके दोस्त और परिवार के लोग अलग-अलग ब्राउज़ कर सकते हैं. साथ ही, FlyWeb को अपने हिसाब से सेट कर सकते हैं</translation>
<translation id="3917488635054382918">FlyWeb को छोटा करने के बाद भी, 'FlyWeb में Gemini' को अपने डिवाइस पर आसानी से इस्तेमाल करें.</translation>
<translation id="1257705702166647105">FlyWeb टैब</translation>
<translation id="2796283369875688710">ज़्यादा सुरक्षा के लिए, FlyWeb आपके डेटा को सुरक्षित करेगा.</translation>
<translation id="1118215875395945816">FlyWeb से अपना FlyWeb खाता हटाने के लिए, साइन आउट करें</translation>
<translation id="3320675843036708646">अपने सभी डिवाइसों से पासवर्ड, बुकमार्क वगैरह ऐक्सेस करने के लिए, FlyWeb में साइन इन करें</translation>
<translation id="2738871930057338499">इंटरनेट से कनेक्ट नहीं किया जा सका. एचटीटीपी 403 फॉरबिडन रिस्पॉन्स दिख रहा है. कृपया अपने प्रॉक्सी कॉन्फ़िगरेशन की जांच करें.</translation>
<translation id="2753623023919742414">खोजने के लिए क्लिक करें</translation>
<translation id="8027563534376000179">FlyWeb को अपने डिफ़ॉल्ट PDF व्यूअर के तौर पर सेट करें</translation>
<translation id="7907238427168022751">इस एक्सटेंशन में मैलवेयर है और यह खतरनाक है. इसे FlyWeb से हटाएं, ताकि यह उन साइटों का डेटा न देख सके और न उसमें बदलाव कर सके जिन पर विज़िट किया जाता है. इस डेटा में आपकी निजी जानकारी भी शामिल है.</translation>
<translation id="2799223571221894425">फिर से लॉन्‍च करें</translation>
<translation id="1489590198317876070">आपका FlyWeb</translation>
<translation id="2816462166102338036">इमेज सर्च की मदद से इस वीडियो को खोजें</translation>
<translation id="6850011743146651977">iOS पर FlyWeb का इस्तेमाल करके, अपने कैमरे से प्रॉडक्ट खोजने, कीमतों में गिरावट ट्रैक करने जैसे कई दूसरे काम कभी भी, कहीं भी करें.</translation>
<translation id="2841525013647267359">इस भाषा का अनुवाद पाएं</translation>
<translation id="2846251086934905009">इंस्टॉल करने में गड़बड़ी हुई: इंस्टॉल करने की प्रोसेस पूरी नहीं हो सकी. इंस्टॉल करने की प्रोसेस रद्द की गई.</translation>
<translation id="1339341044496643931">FlyWeb से निकालें...</translation>
<translation id="4922993584046885552">अगर आप साइन इन हैं, तो यह सुविधा FlyWeb पर आपको सुरक्षित रखती है. साथ ही, इसका इस्तेमाल करके FlyWeb के अन्य ऐप्लिकेशन में सुरक्षा को बेहतर बनाया जा सकता है</translation>
<translation id="2885378588091291677">काम का मैनेजर</translation>
<translation id="3806033752149316261">&amp;FlyWeb के बारे में</translation>
<translation id="2915996080311180594">बाद में रीस्टार्ट करें</translation>
<translation id="3497031519171753772">आपका डेटा, लंबे पासवर्ड से एन्क्रिप्ट यानी सुरक्षित किया गया है. अपने FlyWeb खाते में, FlyWeb का डेटा सेव करने और उसका इस्तेमाल करने के लिए यह लंबा पासवर्ड डालें.</translation>
<translation id="2945997411976714835">इंस्टॉल करने में गड़बड़ी हुई: इंस्टॉल करने की प्रोसेस शुरू नहीं हो सकी.</translation>
<translation id="1784605133570901105">iOS पर FlyWeb में सेव किए गए पासवर्ड इस्तेमाल करके, साइटों पर तेज़ी से साइन इन करें</translation>
<translation id="5383705372991100927">आपका संगठन FlyWeb मैनेज करता है</translation>
<translation id="1661079783259785361">FlyWeb अप टू डेट है</translation>
<translation id="5447533789927384736">अगर कोई साइट आपका पासवर्ड चुराने की कोशिश करती है या नुकसान पहुंचाने वाली कोई फ़ाइल डाउनलोड होने पर FlyWeb, सुरक्षित ब्राउज़िंग की सेवा को उनके यूआरएल भेज सकता है. यूआरएल के साथ-साथ पेज का कुछ कॉन्टेंट भी भेजा जाता है</translation>
<translation id="3208925917545144893">अपने माता-पिता के चुने गए विकल्पों के साथ, ऑनलाइन सुरक्षित रहने के लिए, FlyWeb में साइन इन करें</translation>
<translation id="3003694935412297923">सभी टास्क</translation>
<translation id="1216763100505470452">{count,plural, =1{आपके FlyWeb खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, FlyWeb को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा (1 आइटम) मिट जाएगा.}one{आपके FlyWeb खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, FlyWeb को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा ({count} आइटम) मिट जाएगा.}other{आपके FlyWeb खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, FlyWeb को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा ({count} आइटम) मिट जाएगा.}}</translation>
<translation id="8404327407921790238"><ph name="URL"/> को FlyWeb के नए टैब में खोलें.</translation>
<translation id="5184501306555415561">स्किल जैसी एआई की सुविधाएं आपके FlyWeb खाते में सेव की जाती हैं और इन्हें FlyWeb सिंक से अलग मैनेज किया जाता है</translation>
<translation id="4409390320695765203">अपने सभी डिवाइसों पर एक्सटेंशन वगैरह ऐक्सेस करने के लिए, FlyWeb में साइन इन करें</translation>
<translation id="8841609317523323027">FlyWeb में जोड़ रहा है...</translation>
<translation id="3038232873781883849">इंस्टॉल करने की प्रोसेस, कुछ देर में शुरू होगी...</translation>
<translation id="3045032126857188731">वह भाषा जिसमें अनुवाद किया गया: <ph name="LANGUAGE"/></translation>
