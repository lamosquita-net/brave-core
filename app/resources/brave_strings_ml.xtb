<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="1026101648481255140">ഇൻസ്റ്റാൾ ചെയ്യൽ പുനരാരംഭിക്കുക</translation>
<translation id="7099479769133613710">&amp;ChromeOS അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="291426170030461697">ഈ വിപുലീകരണം അവലോകനം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു</translation>
<translation id="1549005488226693697">ഒരു സൈറ്റ് അതിലെ പേജിലെ ലിങ്കുകൾ സ്വകാര്യമായി മുൻകൂട്ടി ലോഡ് ചെയ്യാൻ ആവശ്യപ്പെടുമ്പോൾ FlyWeb, FlyWeb സെർവറുകൾ ഉപയോഗിക്കുന്നു. മുൻകൂട്ടി ലോഡ് ചെയ്ത സൈറ്റിൽ നിന്ന് ഇത് നിങ്ങളുടെ ഐഡന്റിറ്റി മറയ്ക്കുന്നു, എന്നാൽ ഏതൊക്കെ സൈറ്റുകളാണ് മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നതെന്ന് FlyWeb മനസ്സിലാക്കുന്നു.</translation>
<translation id="1065672644894730302">നിങ്ങളുടെ മുൻഗണനകൾ വായിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമല്ലായിരിക്കാം ഒപ്പം മുൻഗണനകളിലേക്കുള്ള മാറ്റങ്ങൾ സംരക്ഷിക്കപ്പെടുന്നതുമല്ല.</translation>
<translation id="8908267645832965492">നിങ്ങളുടെ രക്ഷിതാവ് FlyWeb-നുള്ള "സൈറ്റുകൾക്കും ആപ്പുകൾക്കും വിപുലീകരണങ്ങൾക്കുമുള്ള അനുമതികൾ" ഓഫാക്കി</translation>
<translation id="6896681084876612310">ഡാറ്റാ ലംഘനങ്ങൾ, മോശം വിപുലീകരണങ്ങൾ എന്നിവയിൽ നിന്നും മറ്റും നിങ്ങളെ സുരക്ഷിതമായി നിലനിർത്താൻ FlyWeb സഹായിക്കും</translation>
<translation id="1368460307421081773">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എക്‌സ്‌പോർട്ട് ചെയ്യാൻ FlyWeb ആഗ്രഹിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="7307912249127683931">FlyWeb നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാണ്</translation>
<translation id="4556715463645168547">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK"/>FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb മെനുവിൽ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="1184145431117212167">നിങ്ങളുടെ Windows പതിപ്പിന് പിന്തുണയില്ലാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="4380351562011537903">FlyWeb-ത്തിനെക്കുറിച്ച്</translation>
<translation id="2593084789070248821">നിങ്ങളുടെ വിൻഡോ പങ്കിടാൻ, സിസ്റ്റം മുൻഗണനകളിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക.</translation>
<translation id="1203500561924088507">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ ബ്രൗസർ റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="4750836834956739196">ഈ ടാബ് നിഷ്ക്രിയമായിരുന്നപ്പോൾ, FlyWeb വേഗത്തിൽ നിലനിർത്താൻ മെമ്മറിയിൽ ഇടമുണ്ടാക്കി. ഈ സൈറ്റ് എല്ലായ്‌പ്പോഴും നിഷ്‌ക്രിയമായിരിക്കുന്നതിൽ നിന്ന് ഒഴിവാക്കാൻ നിങ്ങൾക്ക് തിരഞ്ഞെടുക്കാം.</translation>
<translation id="3190759351483708314">ഫയൽ അപകടകരമായതിനാൽ FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="5879469261638423015"><ph name="USER_EMAIL"/> ഉപയോഗിച്ച് Gmail അല്ലെങ്കിൽ Youtube പോലുള്ള FlyWeb സേവനങ്ങളിലേക്ക് സൈൻ ഇൻ ചെയ്യുമ്പോൾ, അതേ അക്കൗണ്ട് ഉപയോഗിച്ച് നിങ്ങൾക്ക് FlyWeb-ലേക്കും സ്വയമേവ സൈൻ ഇൻ ചെയ്യാം</translation>
<translation id="1290883685122687410">സജ്ജീകരണത്തിലെ പിശക്: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">നിങ്ങളുടെ പുതിയ FlyWeb പ്രൊഫൈൽ സജ്ജീകരിക്കുക</translation>
<translation id="609743863669742325">Bluetooth ഉപകരണങ്ങൾ 
 അടുത്തറിയാൻ FlyWeb-ന് Bluetooth ആക്‌സസ് ആവശ്യമാണ്. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">FlyWeb-ൽ നിന്നുള്ള ഡാറ്റയും ഇല്ലാതാക്കുക (<ph name="URL"/>)</translation>
<translation id="4150708158890309866">നിങ്ങൾ FlyWeb-ൽ സൈൻ ഇൻ ചെയ്‌തു!</translation>
<translation id="4713192356155907986">FlyWeb for Testing-മായി ബന്ധപ്പെട്ട സഹായം നേടൂ</translation>
<translation id="1497802159252041924">ഇൻസ്‌റ്റാൾ ചെയ്യലിൽ പിശക്: <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">ഒരു FlyWeb ടാബ് പങ്കിടുക</translation>
<translation id="8196829963313696543">നിങ്ങളുടെ ചുറ്റുപാടിന്റെ 3D മാപ്പ് സൃഷ്ടിക്കുന്നതിന് നിങ്ങളുടെ ക്യാമറ ആക്സസ് ചെയ്യാൻ FlyWeb-ന് നിങ്ങളുടെ അനുമതി ആവശ്യമാണ്</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{ഈ വിപുലീകരണത്തിന് ഇനി പിന്തുണയില്ല. നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു.}other{ഈ വിപുലീകരണങ്ങൾക്ക് ഇനി പിന്തുണയില്ല. നിങ്ങൾ അവ നീക്കം ചെയ്യാൻ FlyWeb നിർദ്ദേശിക്കുന്നു.}}</translation>
<translation id="852852907317361085">FlyWeb-ന്റെ സുരക്ഷാ ടൂളുകൾ</translation>
<translation id="4096742538387076253">നിങ്ങളുടെ FlyWeb sync chain-ൽ ചില ഡാറ്റ സംരക്ഷിക്കുന്നതിനും അത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഉപയോഗിക്കുന്നതിനും മുമ്പ് ഇത് നിങ്ങൾ തന്നെയാണെന്ന് FlyWeb-ന് പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്. നിങ്ങൾ സൈൻ ഔട്ട് ചെയ്താലും ഈ ഡാറ്റ ഈ ഉപകരണത്തിൽ നിലനിൽക്കും.</translation>
<translation id="481155564361715417">നിങ്ങളുടെ Password Manager ഡാറ്റ ഇല്ലാതാക്കാൻ FlyWeb താൽപ്പര്യപ്പെടുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് ടൈപ്പ് ചെയ്യുക.</translation>
<translation id="3961251277542681013">FlyWeb-ലെ പ്രധാന സ്വകാര്യതാ, സുരക്ഷാ നിയന്ത്രണങ്ങൾ അവലോകനം ചെയ്യുക</translation>
<translation id="1640672724030957280">ഡൗൺലോഡുചെയ്യുന്നു...</translation>
<translation id="6153580651793156880">ഈ ഫീച്ചറുകൾ മെച്ചപ്പെടുത്താൻ സഹായിക്കുന്നതിന്, FlyWeb-മായി നിങ്ങൾ നടത്തുന്ന ഇടപഴകലുകൾ അത് FlyWeb-ലേക്ക് അയയ്ക്കുന്നു. അവലോകനം ചെയ്യുന്നവർ ഈ ഡാറ്റ വായിക്കുകയും പ്രോസസ് ചെയ്യുകയും വ്യാഖ്യാനിക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="1722488837206509557">ലഭ്യമായ ഉപകരണങ്ങളിൽ നിന്ന് തിരഞ്ഞെടുക്കാനും അവയിൽ ഉള്ളടക്കം പ്രദർശിപ്പിക്കാനും ഇത് നിങ്ങളെ അനുവദിക്കും.</translation>
<translation id="2383861520542390014">നിങ്ങളെ പരസ്യങ്ങൾ കാണിക്കാൻ സൈറ്റുകൾ ഉപയോഗിക്കുന്ന, താൽപ്പര്യമുള്ള വിഷയങ്ങൾ കാണാനും നീക്കം ചെയ്യാനും നിങ്ങൾക്ക് കഴിയും. നിങ്ങളുടെ അടുത്തിടെയുള്ള ബ്രൗസിംഗ് ചരിത്രം അടിസ്ഥാനമാക്കി നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ FlyWeb അനുമാനിക്കുന്നു.</translation>
<translation id="5695205873161614119">FlyWeb ഉടൻ തന്നെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും</translation>
<translation id="8939535770474283898">നാവിഗേഷനുകൾ HTTPS-ലേക്ക് അപ്‌ഗ്രേഡ് ചെയ്യാൻ FlyWeb ശ്രമിക്കും</translation>
<translation id="7385422968404728039"><ph name="REMAINING_TIME"/>-നുള്ളിൽ FlyWeb റീസ്റ്റാർട്ട് ചെയ്യും</translation>
<translation id="6903827847227122616">HTTPS ലഭ്യമല്ലാത്തപ്പോൾ, നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകാതെ FlyWeb ഒരു സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിക്കും</translation>
<translation id="307170399141486420">FlyWeb-ത്തെ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കാൻ അനുവദിക്കുക</translation>
<translation id="2473319786107120819">FlyWeb വീണ്ടും ഇൻസ്‌റ്റാളുചെയ്യുക</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/> എന്നതിനുവേണ്ടി ശ്രമിക്കുന്നു</translation>
<translation id="3403116471618205223">നിങ്ങളുടെ FlyWeb sync chain-ൽ ബ്രൗസിംഗ് ഡാറ്റ നിലനിർത്തിക്കൊണ്ട് ഈ ഉപകരണത്തിൽ നിന്ന് മാത്രം അത് ഇല്ലാതാക്കാൻ, <ph name="BEGIN_LINK"/>FlyWeb-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="6434738578659849497">സൈറ്റുകൾക്ക് നിങ്ങളുടെ താൽപ്പര്യങ്ങളെക്കുറിച്ചുള്ള വിവരങ്ങൾ FlyWeb-ൽ സംഭരിക്കാനാകും. ഉദാഹരണത്തിന്, മാരത്തൺ ഓട്ടത്തിനായി ഷൂസ് വാങ്ങാൻ നിങ്ങൾ ഒരു സൈറ്റ് സന്ദർശിക്കുകയാണെങ്കിൽ മാരത്തൺ ഓടുന്നതാണ് നിങ്ങളുടെ താൽപ്പര്യമെന്ന് സൈറ്റ് നിർവ്വചിച്ചേക്കാം. പിന്നീട്, ഒരു ഓട്ടമത്സരത്തിന് രജിസ്റ്റർ ചെയ്യാൻ നിങ്ങൾ മറ്റൊരു സൈറ്റ് സന്ദർശിക്കുകയാണെങ്കിൽ, നിങ്ങളുടെ താൽപ്പര്യങ്ങളെ അടിസ്ഥാനമാക്കി റണ്ണിംഗ് ഷൂസുകളുടെ പരസ്യം കാണിക്കാൻ ആ സൈറ്റിന് കഴിയും.</translation>
<translation id="4824940465467423308">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിന് നിങ്ങളുടെ FlyWeb പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള FlyWeb ഡാറ്റ <ph name="USER_NAME"/> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. FlyWeb അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാനാകുമെങ്കിലും, ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. നിങ്ങളുടെ നിലവിലെ FlyWeb ഡാറ്റ പ്രത്യേകമായി സൂക്ഷിക്കുന്നതിന് നിങ്ങൾക്ക് ഒരു പുതിയ പ്രൊഫൈൽ ഓപ്‌ഷണലായി സൃഷ്‌ടിക്കാനാകും. <ph name="LEARN_MORE"/></translation>
<translation id="3665070894458449212">വിലാസ ബാറിലോ സെർച്ച് ബോക്‌സിലോ നിങ്ങൾ ടൈപ്പ് ചെയ്യുമ്പോൾ, ഇനങ്ങളുടെ നിർദ്ദേശങ്ങൾ നേടുന്നതിന് FlyWeb നിങ്ങൾ ടൈപ്പ് ചെയ്ത കാര്യങ്ങൾ Google Drive-ലേക്ക് അയയ്ക്കുന്നു. ഇത് അദൃശ്യ മോഡിൽ ഓഫായിരിക്കും.</translation>
<translation id="7390382558747224642">ഇത് ഓഫാക്കുന്നതിലൂടെ, FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാതെ തന്നെ Gmail പോലുള്ള FlyWeb സൈറ്റുകളിൽ നിങ്ങൾക്ക് സൈൻ ഇൻ ചെയ്യാനാവും</translation>
<translation id="5714085538350759767">FlyWeb പ്രതികരിക്കുന്നില്ല. ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കണോ?</translation>
<translation id="4035053306113201399">അപ്ഡേറ്റ് ബാധകമാക്കാൻ ChromeOS റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="3750729306035486751">ഈ ഫയൽ തരം സാധാരണയായി ഡൗൺലോഡ് ചെയ്യാത്തതിനാലും ഇത് അപകടകരമായേക്കാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="1953553007165777902">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="MINUTE"/> മിനിറ്റ് ശേഷിക്കുന്നു</translation>
<translation id="6956650624767954726">FlyWeb-ത്തിന് ഡിഫോൾട്ട് ബ്രൗസർ നിർണ്ണയിക്കാനോ സജ്ജമാക്കാനോ കഴിയില്ല</translation>
<translation id="6495079989036864983">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും ഒരിനം ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2018879682492276940">ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4252651275570549255">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ മറ്റ് പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK"/>FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">FlyWeb സേവനങ്ങളിൽ കൂടുതൽ വ്യക്തിപരമാക്കിയ അനുഭവം ലഭ്യമാകാൻ FlyWeb ചരിത്രം ഉൾപ്പെടുത്തണോ എന്ന് തിരഞ്ഞെടുക്കുക</translation>
<translation id="8924891216494775926">ഫയൽ വഞ്ചനാപരമായതിനാലും നിങ്ങളുടെ ഉപകരണത്തിൽ അപ്രതീക്ഷിത മാറ്റങ്ങൾ വരുത്തിയേക്കാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="1868972292925460871">FlyWeb അതിന്റെ റൂട്ട് സർട്ടിഫിക്കറ്റുകൾ മാനേജ് ചെയ്യുന്നത് എങ്ങനെ എന്നതിനെക്കുറിച്ചുള്ള വിവരങ്ങൾ</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{ഒരു മിനിറ്റ് FlyWeb ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും. നിങ്ങളുടെ ടാബുകൾ ഓണാക്കിയ നിലയിൽ തുടരും.}other{# മിനിറ്റ് FlyWeb ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും. നിങ്ങളുടെ ടാബുകൾ ഓണാക്കിയ നിലയിൽ തുടരും.}}</translation>
<translation id="2126108037660393668">ഡൗൺലോഡ് ചെയ്ത ഫയൽ പരിശോധിച്ചുറപ്പിക്കാനായില്ല.</translation>
<translation id="4474394796469499134">സൈറ്റ് സുരക്ഷിത കണക്ഷൻ ഉപയോഗിക്കാത്തതിനാലും ഫയലിൽ തകരാർ സംഭവിച്ചിട്ടുണ്ടാകാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="2482315227745493547">നിങ്ങൾക്ക് FlyWeb മെനുവിൽ നിന്ന് ബുക്ക്‌മാർക്കുകളും റീഡിംഗ് മോഡും മറ്റും തുറക്കാം</translation>
<translation id="6765231735885996239">FlyWeb ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="2174917724755363426">ഇൻസ്റ്റാൾ ചെയ്യൽ പൂർത്തിയായിട്ടില്ല. റദ്ദാക്കണമെന്ന് ഉറപ്പാണോ?</translation>
<translation id="2937508664417729967">FlyWeb - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">അപ്ഡേറ്റ് പരിശോധനയിലെ പിശക്: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">FlyWeb-ൽ നിന്ന് അക്കൗണ്ട് നീക്കം ചെയ്യുക</translation>
<translation id="6707114110652917144">അപകടകരമായ സൈറ്റ്. അറിയിപ്പുകൾ FlyWeb നീക്കം ചെയ്തു.</translation>
<translation id="5461117213064611992">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> എന്നീ അനുമതികൾ FlyWeb നീക്കം ചെയ്തു</translation>
<translation id="2726680594710751908">നിങ്ങളൊരു കമ്പ്യൂട്ടർ പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് ആവശ്യമുള്ള രീതിയിൽ FlyWeb സജ്ജീകരിക്കാനുമാകും.</translation>
<translation id="5067150284614317159">FlyWeb-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു. ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുമ്പോഴോ നിങ്ങൾ ഒരു ദോഷകരമായ ഫയൽ ഡൗൺലോഡ് ചെയ്യുമ്പോഴോ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കൾ സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് FlyWeb അയയ്ക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="3002925333439341552">ഓണായിരിക്കുമ്പോൾ, ബ്രൗസ് ചെയ്യലും തിരയലും വേഗത്തിലാക്കുന്ന പേജുകൾ FlyWeb മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു.</translation>
<translation id="3256927121768528350">ഇവിടെ നിന്ന് നിങ്ങളുടെ Android ഫോണിലേക്ക് ഒരു നമ്പർ അയയ്‌ക്കാൻ, രണ്ട് ഉപകരണങ്ങളിൽ നിന്നും FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2359808026110333948">തുടരുക</translation>
<translation id="7339360994527471629">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ "<ph name="EXTENSION_NAME"/>" എന്ന വിപുലീകരണം നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="4126251160852694747"><ph name="USER_EMAIL_ADDRESS"/> എന്നയാളായി ഈ വിപുലീകരണം ഉപയോഗിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8418845734693287262">നിങ്ങളുടെ അക്കൗണ്ടിന്റെ സൈൻ ഇൻ വിശദാംശങ്ങൾ കാലഹരണപ്പെട്ടതിനാൽ ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു HID ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ടായിരുന്നു}=1{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു HID ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ട്}other{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ # HID ഉപകരണങ്ങൾ ആക്‌സസ് ചെയ്യുന്നുണ്ട്}}</translation>
<translation id="1364879203203742966">FlyWeb-ന് ഈ സൈറ്റിനായി ക്യാമറ, മൈക്രോഫോൺ അനുമതികൾ ആവശ്യമാണ്</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>FlyWeb-ൽ നിന്നുള്ള ടൂളുകൾ<ph name="END_LINK"/> ഉപയോഗിച്ച്, നിങ്ങൾക്ക് സുരക്ഷിതമായി ബ്രൗസ് ചെയ്യാനും നിയന്ത്രണത്തിൽ തുടരാനുമാകും</translation>
<translation id="2451727308784734061">Password Manager-ലേക്ക് വേഗത്തിൽ എത്താൻ നിങ്ങളുടെ കുറുക്കുവഴി ഉപയോഗിക്കുക. നിങ്ങളുടെ കമ്പ്യൂട്ടറിന്റെ ഹോം സ്‌ക്രീനിലേക്കോ ആപ്പ് ലോഞ്ചറിലേക്കോ കുറുക്കുവഴി നീക്കാം.</translation>
<translation id="3224379053610845181">FlyWeb ഉടൻ അടയ്‌ക്കും</translation>
<translation id="3840682988105604367">FlyWeb-ത്തിൽ</translation>
<translation id="2485422356828889247">അണ്‍‌ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യുക</translation>
<translation id="2513154137948333830">റീബൂട്ട് ചെയ്യേണ്ടതുണ്ട്: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="6823116595279840454">നിലവിലുള്ള പാസ്‌വേഡുകൾ മാറ്റി പകരം പുതിയവ ചേർക്കാൻ FlyWeb ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="2691552788029831386">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ FlyWeb-ത്തിന് സ്റ്റോറേജ് ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="2275866327478859777">FlyWeb ഹെൽപ്പർ</translation>
<translation id="683641781063074351">പാസ്‌വേഡുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="7717615706977383025">ഈ പ്രൊഫൈലിന്റെ ഉപയോഗത്തിനിടയിൽ ഉണ്ടായ ഏത് FlyWeb ഡാറ്റയും (ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണം എന്നിവ സൃഷ്ടിക്കൽ പോലുള്ളവ) ഔദ്യോഗിക പ്രൊഫൈൽ അഡ്മിന് നീക്കം ചെയ്യാനാകും. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">FlyWeb ഉപയോഗിക്കുന്നത് തുടരുക</translation>
<translation id="259935314519650377">ഡൗൺലോഡ് ചെയ്ത ഇൻസ്റ്റാളർ കാഷെ ചെയ്യാനായില്ല. പിശക്: <ph name="UNPACK_CACHING_ERROR_CODE"/></translation>
<translation id="6852129081045176385">FlyWeb വേഗത്തിൽ റൺ ചെയ്യുകയും JavaScript ഉപയോഗിക്കുന്ന ഫീച്ചറുകൾ ഡിസൈൻ ചെയ്തിരിക്കുന്നത് പോലെ പ്രവർത്തിക്കുകയും വേണം (നിർദ്ദേശിക്കുന്നത്)</translation>
<translation id="3827993926722004004">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിനിടെ ഒരു ഓപ്പറേറ്റിംഗ് സിസ്റ്റം പിശക് സംഭവിച്ചു. FlyWeb വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="333184635927514678">നിങ്ങളൊരു ഉപകരണം പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് താൽപ്പര്യമുള്ള തരത്തിൽ FlyWeb സജ്ജീകരിക്കാനുമാകും</translation>
<translation id="1661841342483968180">FlyWeb-ത്തിലേക്ക് സ്വാഗതം, <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">FlyWeb ടാബ്</translation>
<translation id="2796283369875688710">അധിക സുരക്ഷക്കായി, FlyWeb നിങ്ങളുടെ ഡാറ്റ എന്‍‌ക്രിപ്റ്റ് ചെയ്യും.</translation>
<translation id="1118215875395945816">FlyWeb-ൽ നിന്ന് നിങ്ങളുടെ FlyWeb sync chain നീക്കം ചെയ്യാൻ, സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="2738871930057338499">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. HTTP 403 നിരോധിച്ചിരിക്കുന്നു. നിങ്ങളുടെ പ്രോക്‌സി കോൺഫിഗറേഷൻ പരിശോധിക്കുക.</translation>
<translation id="2770231113462710648">ഡിഫോൾട്ട് ബ്രൗസര്‍‌ ഇനിപ്പറയുന്നതിലേക്ക് മാറ്റുക:</translation>
<translation id="7907238427168022751">ഈ വിപുലീകരണത്തിൽ മാല്‍വെയർ അടങ്ങിയിരിക്കുന്നു, ഇത് സുരക്ഷിതമല്ല. FlyWeb-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="2799223571221894425">വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="8990114339313395142">ഇത് <ph name="USER_EMAIL_ADDRESS"/> എന്ന അക്കൗണ്ടിനായി പുതിയൊരു FlyWeb പ്രൊഫൈൽ സൃഷ്ടിക്കും</translation>
<translation id="2846251086934905009">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാളർ പൂർത്തിയായില്ല. ഇൻസ്റ്റാൾ ചെയ്യൽ റദ്ദാക്കി.</translation>
<translation id="1339341044496643931">FlyWeb-ൽ നിന്ന് നീക്കംചെയ്യുക...</translation>
<translation id="4922993584046885552">നിങ്ങൾ സൈൻ ഇൻ ചെയ്തിരിക്കുമ്പോൾ FlyWeb-ൽ നിങ്ങളെ സുരക്ഷിതരാക്കുകയും മറ്റ് FlyWeb ആപ്പുകളിൽ നിങ്ങളുടെ സുരക്ഷ മെച്ചപ്പെടുത്താൻ ഉപയോഗിക്കുകയും ചെയ്യും</translation>
<translation id="2885378588091291677">ടാസ്‌ക് മാനേജര്‍</translation>
<translation id="3806033752149316261">&amp;FlyWeb-നെക്കുറിച്ച്</translation>
<translation id="2915996080311180594">പിന്നീട് റീസ്‌റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="2928420929544864228">ഇൻസ്റ്റാൾ ചെയ്യൽ പൂർത്തിയായി.</translation>
<translation id="2945997411976714835">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാൾ ചെയ്യൽ പ്രക്രിയ ആരംഭിക്കാനായില്ല.</translation>
<translation id="1661079783259785361">FlyWeb അപ്‌‌ടുഡേറ്റാണ്</translation>
<translation id="5447533789927384736">ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുകയോ നിങ്ങൾ ദോഷകരമായ ഒരു ഫയൽ ഡൗൺലോഡ് ചെയ്യുകയോ ആണെങ്കിൽ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കളും സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് FlyWeb അയച്ചേക്കാം</translation>
<translation id="1003068427103858026">നിങ്ങളുടെ ബ്രൗസിംഗ് അനുഭവം മെച്ചപ്പെടുത്താനും വിഭവങ്ങൾ ലഭ്യമാക്കാനുമായി ഈ ടാബുകൾ നിഷ്ക്രിയമാക്കാൻ FlyWeb-ന് കഴിയും.</translation>
<translation id="8404327407921790238">FlyWeb-ലെ പുതിയ ടാബിൽ <ph name="URL"/> തുറക്കുക.</translation>
<translation id="1244955229468464260">FlyWeb-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="8841609317523323027">FlyWeb-ലേക്ക് ചേർക്കുന്നു...</translation>
<translation id="3038232873781883849">ഇൻസ്റ്റാൾ ചെയ്യാൻ കാത്തിരിക്കുന്നു...</translation>
<translation id="4451837224464070850">മറ്റ് FlyWeb പ്രൊഫൈലുകൾ</translation>
<translation id="7859502023458300952">FlyWeb-ലേക്ക് ക്രാഷ് റിപ്പോർട്ടുകളും <ph name="UMA_LINK"/> എന്നതും അയയ്‌ക്കുന്നതിലൂടെ FlyWeb മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു USB ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ടായിരുന്നു}=1{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ ഒരു USB ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ട്}other{ഒന്നോ അതിലധികമോ FlyWeb വിപുലീകരണങ്ങൾ # USB ഉപകരണങ്ങൾ ആക്‌സസ് ചെയ്യുന്നുണ്ട്}}</translation>
<translation id="4133194854947529871">നിങ്ങൾ കാണുന്ന പരസ്യങ്ങളെയും ചുവടെ നിർണ്ണയിച്ചിരിക്കുന്നത് പോലുള്ള താൽപ്പര്യങ്ങളെയും നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം ബാധിക്കുന്നു. നിങ്ങളുടെ സ്വകാര്യത പരിരക്ഷിക്കുന്നതിന് ഓരോ മാസവും റോളിംഗ് അടിസ്ഥാനത്തിൽ FlyWeb നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ സ്വയമേവ ഇല്ലാതാക്കുന്നു. നിങ്ങൾ താൽപ്പര്യങ്ങൾ നീക്കം ചെയ്തില്ലെങ്കിൽ അവ റീഫ്രഷ് ചെയ്യാനാകും.</translation>
<translation id="1407857531570256859">ആര്‍ക്കൈവ് അണ്‍‌കം‌പ്രസ് ചെയ്യാന്‍ ഇന്‍സ്റ്റാളറിന് കഴിഞ്ഞില്ല. FlyWeb വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="1309738977648134943">FlyWeb നിങ്ങളുടെ മൈക്രോഫോൺ ഉപയോഗിക്കുന്നു.</translation>
<translation id="2251813826843049011">ഈ ടാബ് അധിക ഉറവിടങ്ങൾ ഉപയോഗിക്കുന്നു. നിങ്ങളുടെ പ്രകടനം മെച്ചപ്പെടുത്താനായി അതിനെ നിഷ്ക്രിയമാക്കാൻ FlyWeb-നെ അനുവദിക്കുക.</translation>
<translation id="6274649779206195384">FlyWeb വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="6773570808762718524">നിങ്ങളുടെ പുതിയ FlyWeb പ്രൊഫൈൽ ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="2700572810650522793">ഹോ! FlyWeb ക്രാഷായി. ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കണോ?</translation>
<translation id="5958835776851191812">FlyWeb-ൽ നിന്ന് നിങ്ങളുടെ FlyWeb sync chain നീക്കം ചെയ്യാൻ, ക്രമീകരണം പേജിൽ FlyWeb-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="5449297306961970452">FlyWeb-ത്തിന് ഡാറ്റാ ഡയറക്‌റ്ററി വായിക്കാനോ അതിൽ എഴുതാനോ കഴിയില്ല:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="7452618639149696924">സൈറ്റിന്റെ പ്രകടനം മെച്ചപ്പെടുത്താൻ ഉപയോഗിക്കുന്ന FlyWeb-ന്റെ JavaScript, WebAssembly എഞ്ചിനാണ് V8</translation>
<translation id="6755586344927335130">FlyWeb പതിപ്പ് <ph name="PRODUCT_VERSION"/> ഇൻസ്റ്റാൾ ചെയ്തിരിക്കുന്നു</translation>
<translation id="3286538390144397061">ഇപ്പോള്‍ പുനരാരംഭിക്കുക</translation>
<translation id="3900612994249740104">FlyWeb API കീകൾ നഷ്‌ടമായി. FlyWeb-ന്‍റെ ചില പ്രവർത്തനങ്ങൾ പ്രവർത്തനരഹിതമാകും.</translation>
<translation id="6824575001009586492">FlyWeb അടയ്‌ക്കുമ്പോൾ അപ്ലിക്കേഷനുകൾ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കുന്നത് തുടരുക</translation>
<translation id="8400063458073122271">ഞങ്ങൾ അക്കൗണ്ട് ആക്സസ് സജ്ജീകരിക്കുമ്പോൾ നിങ്ങൾക്ക് തുടർന്നും FlyWeb ഉപയോഗിക്കാം. സജ്ജീകരണം പൂർത്തിയാകുന്നത് വരെ ചില ഉറവിടങ്ങൾ ആക്സസ് ചെയ്യാൻ നിങ്ങൾക്കാകില്ല.</translation>
<translation id="2595215790271940091">സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിച്ച് ഏതെങ്കിലും സൈറ്റ് ലോഡ് ചെയ്യുന്നതിന് മുമ്പ് FlyWeb നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകും</translation>
<translation id="3701353923785984059">FlyWeb-ൽ സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ടെങ്കിൽ എല്ലാ FlyWeb വിൻഡോകളും അടയ്ക്കുമ്പോൾ, നിങ്ങളുടെ FlyWeb sync chain ഒഴികെ മിക്ക സൈറ്റുകളിൽ നിന്നും നിങ്ങൾ സൈൻ ഔട്ട് ആകും. നിങ്ങളെ ഓർക്കാൻ സൈറ്റുകളെ അനുവദിക്കുന്നതിന്, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="5399208721646088502">ഈ അക്കൗണ്ടുള്ള ഒരു FlyWeb പ്രൊഫൈൽ നിലവിലുണ്ട്</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">നിലവിലുള്ള FlyWeb പ്രൊഫൈലിലേക്ക് മാറണോ?</translation>
<translation id="3412460710772753638">ഈ ഉപകരണത്തിലെ Password Manager-ൽ</translation>
<translation id="847273641988291714">FlyWeb പ്രൊഫൈലുകൾ ഉപയോഗിച്ച് നിങ്ങളുടെ എല്ലാ FlyWeb ഉള്ളടക്കവും വേർതിരിക്കാം. സുഹൃത്തുക്കൾക്കും കുടുംബത്തിനും വ്യത്യസ്‌ത പ്രൊഫൈലുകൾ സൃഷ്‌ടിക്കൂ അല്ലെങ്കിൽ ജോലികാര്യങ്ങളും വിനോദവും പ്രത്യേകമായി തരംതിരിക്കൂ.</translation>
<translation id="1558345997029205345">അപഹരിക്കപ്പെട്ട പാസ്‌വേഡ് ഉപയോഗിച്ച് നിങ്ങൾ സൈൻ ഇൻ ചെയ്യുമ്പോൾ FlyWeb നിങ്ങളെ അറിയിക്കും</translation>
<translation id="956833467923764542">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും <ph name="ITEMS_COUNT"/> ഇനങ്ങൾ ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി FlyWeb-ത്തിൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> എന്നതിന് FlyWeb പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
<translation id="6724485219247982027">എല്ലാ FlyWeb വിൻഡോകളും അടച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/>, ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്.  നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="763231524941489073">നിങ്ങളുടെ സ്വകാര്യത പരിരക്ഷിക്കുന്നതിന് 4 ആഴ്‌ചയിലധികം പഴക്കമുള്ള താൽപ്പര്യങ്ങൾ ഞങ്ങൾ സ്വയമേവ ഇല്ലാതാക്കുന്നു. നിങ്ങൾ ബ്രൗസ് ചെയ്യുന്നത് തുടരുമ്പോൾ, ഒരു താൽപ്പര്യം ലിസ്റ്റിൽ വീണ്ടും ദൃശ്യമായേക്കാം. അല്ലെങ്കിൽ FlyWeb പരിഗണിക്കരുതെന്ന് നിങ്ങൾ ആഗ്രഹിക്കുന്ന താൽപ്പര്യങ്ങൾ നിങ്ങൾക്ക് നീക്കം ചെയ്യാം.</translation>
<translation id="4856314253538330936">ഈ ഉപകരണത്തിൽ FlyWeb ഉപയോഗിച്ച് നിങ്ങൾ സന്ദർശിച്ച സൈറ്റുകളുടെ റെക്കോർഡ് ആയ നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം.</translation>
<translation id="3597003331831379823">പ്രത്യേക പ്രിവിലേജുകൾ ആവശ്യമുള്ള സജ്ജീകരണം റൺ ചെയ്യാനായില്ല. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="7465608402296261674"><ph name="ORIGIN"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ Android ഫോണിലേക്ക് ഒരു നമ്പർ അയയ്‌ക്കാൻ, രണ്ട് ഉപകരണങ്ങളിൽ നിന്നും FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="3667616615096815454">ഇൻസ്റ്റാൾ ചെയ്യാനാകുന്നില്ല, സെർവറിന് ഈ ആപ്പ് പരിചിതമല്ല.</translation>
<translation id="1483758453057146021">നിങ്ങളുടെ സ്‌ക്രീൻ പങ്കിടാൻ, സിസ്റ്റം മുൻഗണനകളിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക.</translation>
<translation id="1543563097158722437">FlyWeb-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവില്ല. നിങ്ങളുടെ ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിക്കുക.</translation>
<translation id="190360428475385352">FlyWeb-ലെ പരസ്യം വ്യക്തിപരമാക്കലിനെക്കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="6611602069520888180">FlyWeb അദൃശ്യ വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="2591356225047803326">വ്യക്തിപരമാക്കലിനും മറ്റ് ആവശ്യങ്ങൾക്കുമായി FlyWeb-ഉം മറ്റ് FlyWeb സേവനങ്ങളും ലിങ്ക് ചെയ്യുക</translation>
<translation id="1771882170639856394">FlyWeb പ്രൊഫൈലുകൾ മാനേജ് ചെയ്യുക</translation>
<translation id="3782148374606932577">ചില ഡൗൺലോഡുകൾ FlyWeb ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="4640643918757362950">നിങ്ങളുടെ അവലോകനം ആവശ്യമുള്ള എന്തെങ്കിലും ഉണ്ടെങ്കിൽ FlyWeb നിങ്ങളെ അറിയിക്കും</translation>
<translation id="2179738813053854729">നിങ്ങൾ സന്ദർശിക്കാനിടയുള്ള പേജുകൾ FlyWeb മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു, ഇതുവഴി നിങ്ങൾ ആ പേജുകൾ സന്ദർശിക്കുമ്പോൾ അവ അതിവേഗം ലോഡ് ചെയ്യും</translation>
<translation id="2401189691232800402">ChromeOS സിസ്റ്റം</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">ChromeOS-മായി ബന്ധപ്പെട്ട് സഹായം തേടൂ</translation>
<translation id="1864899808802540927"><ph name="ACCOUNT_EMAIL"/> -ൽ നിന്ന് നിങ്ങളുടെ FlyWeb ബ്രൗസർ ഉള്ളടക്കം നേടുക</translation>
<translation id="5175060854726708547">FlyWeb ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക. എന്തോ ഒന്നിന് നിങ്ങളുടെ ശ്രദ്ധ വേണം -വിശദാംശങ്ങൾക്ക് ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="606156353708638647">FlyWeb തുറന്ന് ബ്രൗസിംഗ് ആരംഭിക്കാൻ നിങ്ങളുടെ പേരിൽ ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> ഇതിനകം ഈ FlyWeb പ്രൊഫൈലിലേക്ക് സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു. നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, FlyWeb-ന് നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈൽ സൃഷ്‌ടിക്കാനാകും.</translation>
<translation id="3470813199863172076">ഈ വിപുലീകരണം FlyWeb വെബ് സ്റ്റോർ നയം ലംഘിക്കുന്നു, ഇത് സുരക്ഷിതമല്ലായിരിക്കാം. FlyWeb-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="3376157109651222096">നിങ്ങളുടെ അക്കൗണ്ട് മാനേജ് ചെയ്യുന്നത് <ph name="MANAGER_NAME"/> ആണ്. നിങ്ങളുടെ അഡ്‌മിന് ഈ FlyWeb ബ്രൗസർ പ്രൊഫൈലും ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ എന്നിവ പോലുള്ള അതിലെ ഡാറ്റയും കാണാനും എഡിറ്റ് ചെയ്യാനുമാകും.</translation>
<translation id="3941890832296813527">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാളർ ഫയൽ നാമം അസാധുവാണ് അല്ലെങ്കിൽ പിന്തുണയില്ല.</translation>
<translation id="8536259619256229278">പാസ്‌വേഡുകൾ പകർത്താൻ FlyWeb ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="3849784651193576458">FlyWeb നിങ്ങളെ എങ്ങനെ സുരക്ഷിതരായി സൂക്ഷിക്കുന്നുവെന്ന് അറിയുക</translation>
<translation id="5667414856761616811">&amp;FlyWeb for Testing-നെക്കുറിച്ച്</translation>
<translation id="1152920704813762236">ChromeOS-നെ കുറിച്ച്</translation>
<translation id="3703994572283698466">ChromeOS സാധ്യമാക്കിയത് <ph name="BEGIN_LINK_LINUX_OSS"/>Linux വികസന പരിതസ്ഥിതി<ph name="END_LINK_LINUX_OSS"/> പോലുള്ള അധിക <ph name="BEGIN_LINK_CROS_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_CROS_OSS"/> ഉപയോഗിച്ചാണ്.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>നിലവിലെ ക്രമീകരണം<ph name="END_LINK"/> റിപ്പോർട്ട് ചെയ്‌തുകൊണ്ട് FlyWeb മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="4050175100176540509">ഏറ്റവും പുതിയ പതിപ്പിൽ പ്രധാനപ്പെട്ട സുരക്ഷാ മെച്ചപ്പെടുത്തലുകളും പുതിയ ഫീച്ചറുകളും ലഭ്യമാണ്.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{ഒരു മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ FlyWeb അടയ്‌ക്കും. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.}other{# മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ FlyWeb അടയ്‌ക്കും. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.}}</translation>
<translation id="2832552148674305108">FlyWeb അദൃശ്യ മോഡ്</translation>
<translation id="4105099155797156500">'FlyWeb-ത്തെ കുറിച്ച്' പേജിലേക്ക് പോകുക</translation>
<translation id="4148957013307229264">ഇന്‍സ്റ്റാളുചെയ്യുന്നു...</translation>
<translation id="815587935943511961">നിങ്ങളുടെ ബുക്ക്മാർക്കുകൾ, ചരിത്രം, പാസ്‍വേഡുകൾ എന്നിവ പോലെ, നിങ്ങളുടെ ഔദ്യോഗിക പ്രൊഫൈലിലെ ബ്രൗസിംഗ് ഡാറ്റ നിങ്ങളുടെ സ്ഥാപനത്തിന് കാണാനും മാനേജ് ചെയ്യാനുമാകും. വ്യക്തിപരമായ FlyWeb പ്രൊഫൈലുകളിലെ ബ്രൗസിംഗ് ഡാറ്റ അതിന് കാണാനാകില്ല.</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - FlyWeb</translation>
<translation id="4007949387571083162">FlyWeb-നായി മികച്ച അപ്ലിക്കേഷനുകളും വിപുലീകരണങ്ങളും തീമുകളും കണ്ടെത്തുക.</translation>
<translation id="1595210458721188387">FlyWeb UI പ്രദര്‍ശിപ്പിക്കാൻ ഈ ഭാഷ ഉപയോഗിക്കുന്നു</translation>
<translation id="4222932583846282852">റദ്ദാക്കുന്നു...</translation>
<translation id="4224210481850767180">ഇൻസ്റ്റാൾ ചെയ്യുന്നത് റദ്ദാക്കി.</translation>
<translation id="2564888740660198776">നിങ്ങളുടെ FlyWeb ഡാറ്റ ഈ അക്കൗണ്ടുമായി ലിങ്ക് ചെയ്യണോ?</translation>
<translation id="7337819873931851298">സ്റ്റാൻഡേർഡ് പരിരക്ഷയ്‌ക്ക് പുറമെ, സൈറ്റുകളിൽ നിന്നുള്ള കൂടുതൽ ഡാറ്റ വിശകലനം ചെയ്യുന്നതിലൂടെ, FlyWeb-ന് മുമ്പ് അറിയാത്തവ ഉൾപ്പെടെയുള്ള അപകടകരമായ സൈറ്റുകളെക്കുറിച്ച് മുന്നറിയിപ്പ് നൽകുന്നു. നിങ്ങൾക്ക് FlyWeb മുന്നറിയിപ്പുകൾ ഒഴിവാക്കാൻ തീരുമാനിക്കാം.</translation>
<translation id="8391959103619318249">FlyWeb-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="8514458758262040082">FlyWeb ഉപയോഗിക്കുന്നതിനുള്ള സഹായം തേടുക</translation>
<translation id="4281844954008187215">സേവന നിബന്ധനകൾ</translation>
<translation id="3393587701694585022">അവ്യക്തമായ പിശകിനാൽ ഇൻസ്റ്റാൾ ചെയ്യൽ പരാജയപ്പെട്ടു. FlyWeb നിലവിൽ പ്രവർത്തിക്കുന്നുണ്ടെങ്കിൽ, അത് അടച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4304713468139749426">പാസ്‌വേഡ് മാനേജർ</translation>
<translation id="4334294535648607276">ഡൗൺലോഡ് പൂർത്തിയായി.</translation>
<translation id="1068681683510904753">ഈ ഉപകരണം ഉപയോഗിക്കുന്നതിന് മുമ്പ് ഇനിപ്പറയുന്ന സേവന നിബന്ധനകൾ നിങ്ങൾ വായിച്ച് അംഗീകരിക്കണമെന്ന് <ph name="MANAGER"/> ആവശ്യപ്പെടുന്നു. ഈ നിബന്ധനകൾ ChromeOS നിബന്ധനകൾ വിപുലീകരിക്കുകയോ പരിഷ്‌കരിക്കുകയോ പരിമിതപ്പെടുത്തുകയോ ചെയ്യുന്നില്ല.</translation>
<translation id="1376968889000878095">എന്തായാലും FlyWeb-ത്തിൽ നിന്ന് പുറത്തുകടക്കണോ?</translation>
<translation id="6360389033094512399">FlyWeb-ത്തെ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കാൻ അനുവദിക്കുക</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു. <ph name="BEGIN_LINK"/>പിന്തുണയ്ക്കുന്ന വിപുലീകരണങ്ങളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/>}other{നിങ്ങൾ അവ നീക്കം ചെയ്യാൻ FlyWeb നിർദ്ദേശിക്കുന്നു. <ph name="BEGIN_LINK"/>പിന്തുണയ്ക്കുന്ന വിപുലീകരണങ്ങളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">FlyWeb ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക</translation>
<translation id="4427306783828095590">ഫിഷിംഗും മാല്‍വെയറും ബ്ലോക്ക് ചെയ്യുന്നതിന് മെച്ചപ്പെടുത്തിയ പരിരക്ഷ കൂടുതൽ കാര്യങ്ങൾ ചെയ്യുന്നു</translation>
<translation id="4434353761996769206">ഇൻസ്റ്റാളർ പിശക്: <ph name="INSTALLER_ERROR"/></translation>
<translation id="8791209382165811772">FlyWeb for Testing-നെക്കുറിച്ച്</translation>
<translation id="4501471624619070934">ഈ രാജ്യത്ത് ആക്സസ് നിയന്ത്രിച്ചിരിക്കുന്നതിനാല്‍‌ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="3546782282376530369">ഡാറ്റ ശേഖരിക്കുന്നതും ഉപയോഗിക്കുന്നതും എങ്ങനെയെന്നത് പോലുള്ള സ്വകാര്യതാ വ്യവസ്ഥകൾ ഈ വിപുലീകരണം പ്രസിദ്ധീകരിച്ചിട്ടില്ല. നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="834808339160590901">FlyWeb-ലേക്ക് സ്വാഗതം; പുതിയ ബ്രൗസർ വിൻഡോ തുറന്നു</translation>
<translation id="5094033276783634414">നിങ്ങളുടെ ചുറ്റുപാടുകൾ മാപ്പ് ചെയ്യാനും കൈകൾ ട്രാക്ക് ചെയ്യാനും FlyWeb-ന് അനുമതി ആവശ്യമാണ്</translation>
<translation id="3363095592946520579">നിങ്ങൾ മറ്റൊരു FlyWeb പ്രൊഫൈലിൽ <ph name="USER_EMAIL_ADDRESS"/> ആയി നിലവിൽ സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു</translation>
<translation id="1304885695888649052">FlyWeb അപ്‌ഡേറ്റ് ചെയ്തില്ല, എന്തോ കുഴപ്പമുണ്ടായി. <ph name="BEGIN_LINK"/>FlyWeb അപ്‌ഡേറ്റ് സംബന്ധിച്ച പ്രശ്നങ്ങളും പരാജയപ്പെട്ട അപ്ഡേറ്റുകളും പരിഹരിക്കുക.<ph name="END_LINK"/></translation>
<translation id="5889581962474103319">നിങ്ങളുടെ ബ്രൗസിംഗ് അനുഭവം മെച്ചപ്പെടുത്താനും കാര്യങ്ങൾ വേഗത്തിലാക്കാനുമായി ഈ ടാബ് നിഷ്ക്രിയമാക്കാൻ FlyWeb-ന് കഴിയും.</translation>
<translation id="7350427799239500204">പുതിയ FlyWeb പ്രൊഫൈലിൽ തുടരണോ?</translation>
<translation id="4567424176335768812">നിങ്ങൾ <ph name="USER_EMAIL_ADDRESS"/> ആയി സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നു. സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്ന എല്ലാ ഉപകരണങ്ങളിലും ബുക്ക്‌മാർക്കുകളും ചരിത്രവും മറ്റ് ക്രമീകരണങ്ങളും ആക്‌സസ് ചെയ്യാൻ ഇപ്പോൾ നിങ്ങൾക്കാകും.</translation>
<translation id="5891777644455025808">നിങ്ങൾ സുരക്ഷിത ബ്രൗസിംഗ് ഓഫാക്കിയതിനാലും ഫയൽ പരിശോധിച്ചുറപ്പിക്കാൻ കഴിയാത്തതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="4594305310729380060">ഈ ഉപകരണത്തിലെ Password Manager-ലേക്ക്</translation>
<translation id="6046424510733540251">FlyWeb അപ്ലിക്കേഷനുകൾ</translation>
<translation id="4970880042055371251">ChromeOS പതിപ്പ്</translation>
<translation id="8084731767622512023">നിങ്ങളുടെ സ്‌ക്രീൻ പങ്കിടാൻ, സിസ്റ്റം മുൻഗണനകളിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക</translation>
<translation id="1936188352112244665">എകദേശം അപ്‌‌ടുഡേറ്റാണ്! അപ്‌ഡേറ്റുചെയ്യൽ പൂർത്തിയാക്കാൻ FlyWeb വീണ്ടും ആരംഭിക്കുക.</translation>
<translation id="2962574118577609024">നിങ്ങൾ FlyWeb ഉപയോഗ റിപ്പോർട്ടുകളും പങ്കിടുന്നുവെങ്കിൽ, ആ റിപ്പോർട്ടുകളിൽ നിങ്ങൾ സന്ദർശിക്കുന്ന URL-കളും ഉൾപ്പെടും</translation>
<translation id="9219132550163437762">മറ്റൊരു കമ്പ്യൂട്ടറിൽ (<ph name="HOST_NAME"/>) മറ്റൊരു FlyWeb പ്രോസസ് (<ph name="PROCESS_ID"/>) പ്രൊഫൈൽ ഉപയോഗിക്കുന്നതുപോലെ തോന്നുന്നു. FlyWeb പ്രൊഫൈൽ ലോക്കുചെയ്‌തതിനാൽ ഇത് കേടാകുകയില്ല. മറ്റ് പ്രോസസുകളൊന്നും ഈ പ്രൊഫൈൽ ഉപയോഗിക്കുന്നില്ലെന്ന് ഉറപ്പാണെങ്കിൽ നിങ്ങൾക്ക് പ്രൊഫൈൽ അൺലോക്ക് ചെയ്‌ത് FlyWeb വീണ്ടും സമാരംഭിക്കാം.</translation>
<translation id="4680828127924988555">ഇൻസ്റ്റാൾ ചെയ്യൽ റദ്ദാക്കുക</translation>
<translation id="6156840135417578237">നിങ്ങളുടെ FlyWeb ഡാറ്റയിൽ ചിലത് ഇതുവരെ നിങ്ങളുടെ FlyWeb sync chain-ൽ സംരക്ഷിച്ചിട്ടില്ല. സൈൻ ഔട്ട് ചെയ്യുന്നതിന് മുമ്പ് അൽപ്പസമയം കാത്തിരിക്കുക. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ ഈ ഡാറ്റ ഇല്ലാതാക്കും.</translation>
<translation id="1474749355173247622">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിരിക്കുമ്പോൾ, FlyWeb-ൽ നിങ്ങളുടെ FlyWeb sync chain-ൽ നിന്നുള്ള പാസ്‌വേഡുകളും മറ്റും ഉപയോഗിക്കാനാകും. <ph name="SHORTCUT"/> എന്നതിന് നിങ്ങളുടെ FlyWeb സേവനങ്ങൾ ക്രമീകരണം മാറ്റാനാകും.</translation>
<translation id="5227023869666757348">ഈ കമ്പ്യൂട്ടറിലെ FlyWeb-ത്തിൽ മുമ്പ് മറ്റാരോ <ph name="ACCOUNT_EMAIL_LAST"/> എന്നയാളായി സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നു. നിങ്ങളുടെ വിവരങ്ങൾ പ്രത്യേകം വേർതിരിച്ച് സൂക്ഷിക്കാൻ പുതിയ FlyWeb ഉപയോക്താവിനെ സൃഷ്‌ടിക്കുക.</translation>
<translation id="4724676981607797757">പിന്തുണയ്ക്കാത്ത പ്രോട്ടോക്കോൾ പിശക് കാരണം ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടു.</translation>
<translation id="1671154647029930623">എന്തായാലും FlyWeb-ത്തിൽ നിന്ന് പുറത്തുകടക്കണോ?</translation>
<translation id="4143239505982500022">FlyWeb-നുള്ള ഒരു പ്രത്യേക സുരക്ഷാ അപ്‌ഡേറ്റ് പ്രയോഗിച്ചിരിക്കുന്നു. ഇപ്പോൾ റീസ്‌റ്റാർട്ട് ചെയ്യുക, ഞങ്ങൾ നിങ്ങളുടെ ടാബുകൾ പുനഃസ്ഥാപിക്കും.</translation>
<translation id="1347247057384060764">FlyWeb ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും നിങ്ങളുടെ തീരുമാനം മാറ്റാനാകും. ട്രയലുകൾ റൺ ചെയ്യുന്നത് നിലവിൽ പരസ്യങ്ങൾ നൽകുന്ന രീതിക്കൊപ്പം ആയതിനാൽ, നിങ്ങൾ ഉടൻ മാറ്റങ്ങളൊന്നും കാണില്ല.</translation>
<translation id="4259200560913816786">FlyWeb-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. 24 മണിക്കൂറിന് ശേഷം വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കിൽ <ph name="BEGIN_LINK"/>നിങ്ങളുടെ FlyWeb അക്കൗണ്ടിലെ പാസ്‌വേഡുകൾ പരിശോധിക്കുക<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">FlyWeb തിരയലിൽ ഉപയോഗിക്കുന്ന അതേ സ്പെൽ ചെക്കർ ഇത് ഉപയോഗിക്കുന്നു. ബ്രൗസറിൽ നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്ന ടെക്‌സ്‌റ്റ് FlyWeb-ന് അയയ്ക്കുന്നു. ക്രമീകരണത്തിൽ എപ്പോഴും ഈ രീതി മാറ്റാനാകും.</translation>
<translation id="7460496601839821581">അക്കൗണ്ട് ഇല്ലാതെ FlyWeb ഉപയോഗിക്കുക</translation>
<translation id="2991144524835127379">mDNS ട്രാഫിക്ക് അനുവദിക്കാൻ FlyWeb-നുള്ള ഇൻബൗണ്ട് നയം.</translation>
<translation id="6208903184719035736">&amp;FlyWeb അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="9083381064635607718">ഭാവിയിൽ FlyWeb അപ്ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് macOS 11 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ macOS 10.15 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="7174589544844983914">FlyWeb പശ്ചാത്തല മോഡിലാണ്.</translation>
<translation id="9212977598552218412">FlyWeb സൈൻ ഇൻ ഡയലോഗ് അടയ്ക്കാൻ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="7792628702371319769">അതിഥികൾക്ക് ഒന്നും ശേഷിപ്പിക്കാതെ തന്നെ FlyWeb ഉപയോഗിക്കാനാകും.</translation>
<translation id="2760069255902967585">FlyWeb-ലേക്ക് സ്വയം ചേരുക</translation>
<translation id="4239638419916712076">നിങ്ങളുടെ കുറച്ച് വിവരങ്ങൾ മാത്രം ഉപയോഗിച്ച്, സമാന ബ്രൗസിംഗ് അനുഭവം നൽകാൻ സൈറ്റുകളെ അനുവദിക്കുന്ന പുതിയ ഫീച്ചറുകൾ കണ്ടെത്താൻ FlyWeb ശ്രമിക്കുന്നു</translation>
<translation id="4326845160190496236">FlyWeb അക്കൗണ്ട് വീണ്ടും പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്</translation>
<translation id="387444474697464273">സംരക്ഷിച്ച പാസ്‌വേഡുകളൊന്നുമില്ല. നിങ്ങളുടെ പാസ്‌വേഡുകൾ സംരക്ഷിക്കുകയാണങ്കിൽ, FlyWeb-ന് അവ പരിശോധിക്കാനാവും.</translation>
<translation id="291933003154435191">FlyWeb-ത്തിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/> ഇതിനകം ഈ FlyWeb പ്രൊഫൈലിൽ സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു. ഇത് <ph name="USER_EMAIL_ADDRESS"/> എന്ന അക്കൗണ്ടിനായി പുതിയൊരു FlyWeb പ്രൊഫൈൽ സൃഷ്ടിക്കും</translation>
<translation id="8295539942024823191">നിങ്ങളുടെ മാറ്റങ്ങൾ ബാധകമാക്കാൻ FlyWeb സമാരംഭിക്കുക</translation>
<translation id="611606920944085547">അദൃശ്യ മോഡിൽ ബ്രൗസ് ചെയ്യുമ്പോൾ, സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിച്ച് ഒരു സൈറ്റ് ലോഡ് ചെയ്യുന്നതിന് മുമ്പ് FlyWeb നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകും</translation>
<translation id="5374328929709976901">ട്രയലുകൾ ഓണായിരിക്കുമ്പോൾ, FlyWeb നിങ്ങളെ ക്രമരഹിതമായി ഒരു സജീവ ട്രയലിൽ ഉൾപ്പെടുത്തിയിട്ടുണ്ടെങ്കിൽ, നിങ്ങൾ കാണുന്ന പരസ്യങ്ങളെയും ചുവടെ നിർണ്ണയിച്ചിരിക്കുന്നത് പോലുള്ള താൽപ്പര്യങ്ങളെയും നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം ബാധിക്കുന്നു. നിങ്ങളുടെ സ്വകാര്യത പരിരക്ഷിക്കുന്നതിന് ഓരോ മാസവും റോളിംഗ് അടിസ്ഥാനത്തിൽ FlyWeb നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ ഇല്ലാതാക്കുന്നു.</translation>
<translation id="1392114650763912227"><ph name="USER_EMAIL"/> എന്നതായി FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="6178233095056047786">നിങ്ങളുടെ അവലോകനത്തിനായി FlyWeb ചില സുരക്ഷാ നിർദ്ദേശങ്ങൾ കണ്ടെത്തി</translation>
<translation id="8980390875915032396">മറ്റ് FlyWeb പ്രൊഫൈലുകൾ</translation>
<translation id="8449603408481238073">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിന് നിങ്ങളുടെ FlyWeb പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള FlyWeb ഡാറ്റ <ph name="USER_NAME"/> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. FlyWeb അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാനാകുമെങ്കിലും, ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">അധിക കോഡ്: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">വ്യക്തിപരമാക്കൽ ലഭിക്കാൻ, വെബ്, ആപ്പ് ആക്റ്റിവിറ്റിയിൽ FlyWeb ഉൾപ്പെടുത്തുക</translation>
<translation id="1026219128963768190">ചില ഫയലുകൾ FlyWeb ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="1284798564810038820">FlyWeb അപ്‌ഡേറ്റ് ചെയ്യുന്നു, (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ അനുവദിക്കുക</translation>
<translation id="1827750898515917134">FlyWeb-ൽ നിന്ന് നീക്കംചെയ്യുക</translation>
<translation id="5020755920249060562">നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറായി FlyWeb സജ്ജമാക്കുക</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb ബീറ്റ</translation>
<translation id="5385202369020319636">ഈ Linux വിതരണത്തിൽ ഇനി പിന്തുണയില്ലാത്തതിനാൽ FlyWeb ശരിയായി പ്രവർത്തിച്ചേക്കില്ല</translation>
<translation id="362367838300880777">നിങ്ങളുടെ വ്യക്തിഗത അക്കൗണ്ടുകൾക്കും സോഷ്യൽ നെറ്റ്‌വർക്ക് അക്കൗണ്ടുകൾക്കും ഫയൽ ദോഷകരമായേക്കാം എന്നതിനാൽ FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="5957333939864770801">FlyWeb-ത്തിന് ഈ സൈറ്റുമായി ലൊക്കേഷൻ പങ്കിടുന്നതിന് നിങ്ങളുടെ ലൊക്കേഷനിലേക്കുള്ള ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="780999790006298623">നിങ്ങളുടെ സ്വകാര്യത പരിരക്ഷിക്കുന്നതിന് 4 ആഴ്‌ചയിലധികം പഴക്കമുള്ള താൽപ്പര്യങ്ങൾ ഞങ്ങൾ സ്വയമേവ ഇല്ലാതാക്കുന്നു. നിങ്ങൾ ബ്രൗസ് ചെയ്യുന്നത് തുടരുമ്പോൾ, ഒരു താൽപ്പര്യം ലിസ്റ്റിൽ വീണ്ടും ദൃശ്യമായേക്കാം. FlyWeb തെറ്റായി തിരഞ്ഞെടുത്തതാണെങ്കിലോ ചില പരസ്യങ്ങൾ കാണാൻ നിങ്ങൾ ആഗ്രഹിക്കുന്നില്ലെങ്കിലോ, നിങ്ങൾക്ക് താൽപ്പര്യം നീക്കം ചെയ്യാം.</translation>
<translation id="2183749398075655200">FlyWeb ഏറ്റവും പുതിയ സിസ്‌റ്റം അപ്‌ഡേറ്റുകൾ ഇൻസ്റ്റാളുചെയ്യുന്നതുവരെ കാത്തിരിക്കുക.</translation>
<translation id="8996657165865563765">പാസ്‌വേഡുകൾ എഡിറ്റ് ചെയ്യാൻ FlyWeb ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് ടൈപ്പ് ചെയ്യുക.</translation>
<translation id="5738298079259740925">FlyWeb-ൽ PDF-കൾ തുറക്കുക</translation>
<translation id="6096945112863785306">{0,plural, =0{FlyWeb-ത്തിനൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}=1{FlyWeb-ത്തിനൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}other{# ദിവസമായി FlyWeb-ത്തിനൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}}</translation>
<translation id="7698117871740446964">FlyWeb അടയ്‌ക്കുമ്പോഴെല്ലാം നിങ്ങളുടെ ഉപകരണത്തിൽ നിന്ന് സൈറ്റ് ഡാറ്റ ഇല്ലാതാക്കുക</translation>
<translation id="5666891644992637849">FlyWeb ഇപ്പോൾ റീസ്‌റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">ഈ ഭാഷയിൽ FlyWeb പ്രദർശിപ്പിക്കുക</translation>
<translation id="569897634095159764">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. പ്രോക്സി സെർവറിന് പരിശോധിച്ചുറപ്പിക്കൽ ആവശ്യമാണ്.</translation>
<translation id="3833333172002764160">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> എന്നീ അനുമതികൾ FlyWeb നീക്കം ചെയ്തു</translation>
<translation id="4985665094509307744">FlyWeb ഇഷ്‌ടാനുസൃതമാക്കുകയും നിയന്ത്രിക്കുകയും ചെയ്യൂ. FlyWeb ഡിഫോൾട്ടായി സജ്ജീകരിക്കുക.</translation>
<translation id="5809516625706423866">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. HTTP 401 അംഗീകൃതമല്ല. നിങ്ങളുടെ പ്രോക്‌സി കോൺഫിഗറേഷൻ പരിശോധിക്കുക.</translation>
<translation id="8331941171144629807">FlyWeb-ത്തിലേക്ക് സ്വാഗതം</translation>
<translation id="7581082856615467651">ഈ ഇനങ്ങളിൽ മാൽവെയർ അടങ്ങുന്നതായി FlyWeb കണ്ടെത്തി:</translation>
<translation id="8117102597407263352">നിങ്ങളുടെ ബ്രൗസറിന് ഏറ്റവും സുരക്ഷിതമായ ക്രമീകരണമാണുള്ളതെന്ന് ഉറപ്പാക്കാൻ FlyWeb പതിവായി പരിശോധിക്കുന്നു. നിങ്ങളുടെ അവലോകനം ആവശ്യമുള്ള എന്തെങ്കിലും ഉണ്ടെങ്കിൽ ഞങ്ങൾ നിങ്ങളെ അറിയിക്കും.</translation>
<translation id="5895138241574237353">പുനരാരംഭിക്കുക</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ</translation>
<translation id="5924017743176219022">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യുന്നു...</translation>
<translation id="5383748137832083777">നിങ്ങളുടെ ബ്രൗസിംഗ് അനുഭവം മെച്ചപ്പെടുത്താനും വിഭവങ്ങൾ ലഭ്യമാക്കാനുമായി ഈ ടാബ് നിഷ്ക്രിയമാക്കാൻ FlyWeb-ന് കഴിയും.</translation>
<translation id="5941711191222866238">ചെറുതാക്കുക</translation>
<translation id="483902194277448471">FlyWeb നിങ്ങളെ ക്രമരഹിതമായി ഒരു സജീവ ട്രയലിൽ ഉൾപ്പെടുത്തിയിട്ടുണ്ടെങ്കിൽ, നിങ്ങൾ കാണുന്ന പരസ്യങ്ങളെയും ചുവടെ നിർണ്ണയിച്ചിരിക്കുന്നത് പോലുള്ള താൽപ്പര്യങ്ങളെയും നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം ബാധിക്കുന്നു. നിങ്ങളുടെ സ്വകാര്യത പരിരക്ഷിക്കുന്നതിന് ഓരോ മാസവും റോളിംഗ് അടിസ്ഥാനത്തിൽ FlyWeb നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ ഇല്ലാതാക്കുന്നു. നിങ്ങൾ താൽപ്പര്യങ്ങൾ നീക്കം ചെയ്തില്ലെങ്കിൽ അവ റീഫ്രഷ് ചെയ്യും.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{ഒരു മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ FlyWeb അടയ്‌ക്കും.}other{# മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ FlyWeb അടയ്‌ക്കും.}}</translation>
<translation id="4955869506208896934">സമന്വയിപ്പിക്കാൻ തുടങ്ങുന്നതിന് FlyWeb അപ്‌ഡേറ്റ് ചെയ്യുക</translation>
<translation id="63409513082302419">നിങ്ങളുടെ അനുഭവം വ്യക്തിപരമാക്കുന്നതിന്, നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകൾ നിങ്ങൾക്ക് താൽപ്പര്യമുള്ള കാര്യങ്ങൾ ഓർമ്മിക്കുന്നത് സാധാരണമാണ്. സൈറ്റുകൾക്ക്, നിങ്ങളുടെ താൽപ്പര്യങ്ങളെക്കുറിച്ചുള്ള വിവരങ്ങൾ FlyWeb-ൽ സംഭരിക്കാനുമാകും.</translation>
<translation id="6003112304606738118">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="HOURS"/> മണിക്കൂർ ശേഷിക്കുന്നു</translation>
<translation id="6888926086743577946">മുകളിൽ വലതുവശത്തുള്ള FlyWeb മെനുവിൽ നിന്ന് നിങ്ങൾക്ക് ബുക്ക്‌മാർക്കുകളും റീഡിംഗ് മോഡും മറ്റും തുറക്കാം</translation>
<translation id="6040143037577758943">അടയ്ക്കുക</translation>
<translation id="619330138913595431">നിങ്ങളുടെ ഡാറ്റ പരിരക്ഷിക്കുന്നതിന്, അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ലാത്ത സൈറ്റുകളിൽ നിന്നുള്ള അനുമതികൾ നീക്കം ചെയ്യാൻ FlyWeb-നെ അനുവദിക്കുക. അറിയിപ്പുകൾ നിർത്തുന്നില്ല.</translation>
<translation id="8714139918792771260">&amp;FlyWeb-ത്തിൽ തുറക്കുക</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/> FlyWeb-ത്തിലേക്ക് ചേർത്തു</translation>
<translation id="3890023823480067024">FlyWeb കൂടുതൽ വേഗതയുള്ളതാക്കുക</translation>
<translation id="608006075545470555">ഈ ബ്രൗസറിലേക്ക് ഔദ്യോഗിക പ്രൊഫൈൽ ചേർക്കുക</translation>
<translation id="5880307616068888895">FlyWeb ഇഷ്ടാനുസൃതമാക്കി നിയന്ത്രിക്കുക. അപ്‌ഡേറ്റ് ലഭ്യമാണ്.</translation>
<translation id="8890528681896757647">ഓണായിരിക്കുമ്പോൾ, പശ്ചാത്തല ആക്റ്റിവിറ്റിയും സുഗമമായ സ്ക്രോളിംഗ്, വീഡിയോ ഫ്രെയിം റേറ്റുകൾ എന്നിവ പോലുള്ള വിഷ്വൽ ഇഫക്റ്റുകളും പരിമിതപ്പെടുത്തി FlyWeb ബാറ്ററി പവർ ലാഭിക്കുന്നു.</translation>
<translation id="1429530657225981960">ഓണാണ് • ഈ വിപുലീകരണം എവിടെ നിന്നാണ് വരുന്നതെന്ന് FlyWeb-ന് പരിശോധിച്ചുറപ്പിക്കാനാകില്ല</translation>
<translation id="1683225514126450592">FlyWeb ടൂൾബാറിൽ ആക്‌സസ് അഭ്യർത്ഥനകൾ കാണിക്കാൻ വിപുലീകരണം അനുവദിക്കുക</translation>
<translation id="5171527334826689262">നിങ്ങളുടെ FlyWeb അക്കൗണ്ടിൽ FlyWeb ഈ പാസ്‌വേഡ് സംരക്ഷിക്കും. നിങ്ങൾ അത് ഓർത്ത് വയ്ക്കേണ്ടതില്ല.</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> അപകടകരമായതിനാൽ, FlyWeb ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="1773252983747911987">ഉടൻ തന്നെ FlyWeb അടയ്‌ക്കുകയും ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും</translation>
<translation id="3063780243670578104">സുരക്ഷിത ബ്രൗസിംഗ് ഓഫാണ്. ഇത് ഓണാക്കാൻ FlyWeb നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="1686760912855738719">നിങ്ങൾക്ക് ഇവിടെ FlyWeb പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
<translation id="5461795497268691356">നിങ്ങൾ കുക്കികൾ അനുവദിച്ചാൽ, മുൻകൂട്ടി ലോഡ് ചെയ്യുമ്പോൾ FlyWeb അവ ഉപയോഗിച്ചേക്കാം</translation>
<translation id="7031783851441272920">ഈ ഫയൽ അപകടകരമായേക്കാം<ph name="LINE_BREAK"/>നിങ്ങൾ പാസ്‌വേഡ് നൽകിയാൽ FlyWeb-ന് നിങ്ങൾക്കായി ഈ ഡൗൺലോഡ് പരിശോധിക്കാൻ കഴിയും. ഫയലിനെ സംബന്ധിച്ച വിവരങ്ങൾ FlyWeb സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് അയയ്‌ക്കും, എന്നാൽ ഫയലിന്റെ ഉള്ളടക്കവും പാസ്‌വേഡും നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ നിലനിൽക്കും.</translation>
<translation id="6182736845697986886">അപ്‌ഡേറ്റ് സെർവർ ആന്തരിക പിശക് കാരണം ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടു.</translation>
<translation id="4403968929742079769">നിങ്ങൾ <ph name="TARGET_DEVICE_NAME"/> ഉപകരണത്തിൽ FlyWeb-ലാണ് സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നതെന്ന് ഉറപ്പാക്കുക, തുടർന്ന് വീണ്ടും അയയ്‌ക്കാൻ ശ്രമിക്കുക.</translation>
<translation id="1855179706668101462">FlyWeb-ത്തിന്റെ ഏറ്റവും പുതിയ പതിപ്പ് ഈ കമ്പ്യൂട്ടറില്‍ ഇപ്പോൾ തന്നെയുണ്ട്. സോഫ്റ്റ്‌വെയര്‍ പ്രവര്‍ത്തിക്കുന്നില്ലെങ്കില്‍, FlyWeb അൺഇൻസ്റ്റാൾ ചെയ്‌ത് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കും}=1{ഒരു സെക്കൻഡിൽ FlyWeb വീണ്ടും സമാരംഭിക്കും}other{# സെക്കൻഡിൽ FlyWeb വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="2586408713760853791">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ FlyWeb-ന് സ്റ്റോറേജ് ആക്‌സസ് അനുമതി ആവശ്യമാണ്</translation>
<translation id="1603558835003845196">FlyWeb-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു</translation>
<translation id="5751080530525677552">FlyWeb ഡിഫോൾട്ട് ബ്രൗസറാക്കൂ</translation>
<translation id="4804111781678641302">FlyWeb-ന് അപ്‌ഡേറ്റുകൾക്കായി പരിശോധിക്കാനാവില്ല. നിങ്ങളുടെ ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിക്കുക.</translation>
<translation id="3542157007113577464">FlyWeb-ത്തിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യണോ?</translation>
<translation id="2166321493116256664">ഈ ടാബുകൾ അധിക വിഭവങ്ങൾ ഉപയോഗിക്കുന്നു. നിങ്ങളുടെ പ്രകടനം മെച്ചപ്പെടുത്താനായി അവ നിഷ്ക്രിയമാക്കാൻ FlyWeb-നെ അനുവദിക്കുക.</translation>
<translation id="3794967601634523398">നിങ്ങളുടെ FlyWeb പ്രൊഫൈൽ ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="6475001900959697061">നിങ്ങളുടെ FlyWeb പ്രൊഫൈലിന് പേര് നൽകുക</translation>
<translation id="6356094940346377065">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഒരു വിപുലീകരണം നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> അപകടകരമാകാൻ ഇടയുള്ളതിനാൽ, FlyWeb ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="5523868569707953059">FlyWeb നിങ്ങളുടെ ക്യാമറ ഉപയോഗിക്കുന്നു.</translation>
<translation id="6327105987658262776">അപ്ഡേറ്റ് ലഭ്യമല്ല.</translation>
<translation id="8226838065217375546">FlyWeb-ത്തിൽ മറ്റൊരു പ്രവർത്തനം പുരോഗമിക്കുകയാണ്. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="6063700568539132984">ഇപ്പോൾ നിങ്ങളുടെ FlyWeb sync chain ഉപയോഗിച്ച്, പങ്കിട്ട കമ്പ്യൂട്ടറുകളിൽ FlyWeb ഉപയോഗിക്കാൻ എളുപ്പമാണ്.</translation>
<translation id="2451285993204064190">നിങ്ങളുടെ ബ്രൗസിംഗ് അനുഭവം മെച്ചപ്പെടുത്താനും കാര്യങ്ങൾ വേഗത്തിലാക്കാനുമായി ഈ ടാബുകൾ നിഷ്ക്രിയമാക്കാൻ FlyWeb-ന് കഴിയും.</translation>
<translation id="4709797814274745581">FlyWeb കുറുക്കുവഴി</translation>
<translation id="6595693843242836271">ഈ ഫയൽ സാധാരണയായി ഡൗൺലോഡ് ചെയ്യാത്തതിനാലും ഇത് അപകടകരമായേക്കാം എന്നതിനാലും FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="6890209090736444656">FlyWeb അൺഇൻസ്റ്റാൾ ചെയ്യാൻ നിങ്ങൾ താൽപ്പര്യപ്പെടുന്നുവെന്ന് തീർച്ചയാണോ?</translation>
<translation id="6375219077595103062">Password Manager-ലേക്ക് ഒരു കുറുക്കുവഴി ചേർക്കുക</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>ഈ ഡാറ്റ ഞങ്ങൾ എങ്ങനെ ഉപയോഗിക്കുന്നു:<ph name="END_BOLD"/> FlyWeb-ന് നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ നിർണ്ണയിക്കാനാകും. പിന്നീട്, കാണുന്ന പരസ്യങ്ങൾ വ്യക്തിപരമാക്കുന്നതിന് നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ കാണിക്കാൻ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റിന് FlyWeb-നോട് ആവശ്യപ്പെടാം.</translation>
<translation id="2104550252781001709">ഒരു കമ്പ്യൂട്ടർ സ്ക്രീനിനുള്ളിലെ FlyWeb ലോഗോ.</translation>
<translation id="6636986997730784876">മിന്നൽ വേഗത്തിൽ വെബ്‌ പേജുകളും ആപ്പുകളും പ്രവർത്തിപ്പിക്കുന്ന ഒരു വെബ് ബ്രൗസറാണ് FlyWeb. ഇത് വേഗതയുള്ളതും സ്ഥിരതയാർന്നതും ഉപയോഗിക്കാൻ എളുപ്പമുള്ളതുമാണ്. FlyWeb-ൽ അന്തർനിർമ്മിതമായ മാൽവെയർ, ഫിഷിംഗ് എന്നിവയ്‌ക്കെതിരായുള്ള പരിരക്ഷയോടൊപ്പം കൂടുതൽ സുരക്ഷിതമായി വെബ് ബ്രൗസ് ചെയ്യുക.</translation>
<translation id="2139300032719313227">ChromeOS റീസ്റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="7560906925528428585">നിങ്ങൾ സന്ദർശിക്കാനിടയുള്ള കൂടുതൽ പേജുകൾ FlyWeb മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു, ഇതുവഴി നിങ്ങൾ ആ പേജുകൾ സന്ദർശിക്കുമ്പോൾ അവ അതിവേഗം ലോഡ് ചെയ്യും</translation>
<translation id="2970877059928503461">ഓഫാണ് • ഈ വിപുലീകരണം എവിടെ നിന്നാണ് വരുന്നതെന്ന് FlyWeb-ന് പരിശോധിച്ചുറപ്പിക്കാനാകില്ല</translation>
<translation id="173462352822069427">FlyWeb പ്രൊഫൈലുകളിലേക്ക് സ്വാഗതം</translation>
<translation id="3484308111967198595">FlyWeb-ൽ നിന്ന് അക്കൗണ്ട് നീക്കം ചെയ്യുക</translation>
<translation id="1474676525193357364">നിങ്ങൾ FlyWeb ആരംഭിക്കുമ്പോൾ ദൃശ്യമാകുന്ന പേജും അത് നിയന്ത്രിയ്ക്കും.</translation>
<translation id="648319183876919572">അപകടകരമായ വെബ്‌സൈറ്റുകളിൽ നിന്നും ഡൗൺലോഡുകളിൽ നിന്നും നിങ്ങളെ പരിരക്ഷിക്കാൻ മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് കൂടുതൽ കാര്യങ്ങൾ ചെയ്യുന്നു</translation>
<translation id="5777905264835557372">FlyWeb അൺഇൻസ്റ്റാൾ ചെയ്യുക</translation>
<translation id="764623543427374554">FlyWeb-ൽ കുറുക്കുവഴികൾ തുറക്കൽ</translation>
<translation id="3616832517943695570">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിരിക്കുമ്പോൾ, FlyWeb-ൽ നിങ്ങളുടെ FlyWeb sync chain-ൽ നിന്നുള്ള പാസ്‌വേഡുകളും മറ്റും ഉപയോഗിക്കാനാകും. ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് ഇത് ഏതുസമയത്തും മാറ്റാം.</translation>
<translation id="8852057261917278552"><ph name="TIMEOUT_DURATION"/> ഉപയോഗിച്ചില്ലെങ്കിൽ നിങ്ങളുടെ സ്ഥാപനം FlyWeb ഡാറ്റ അടയ്ക്കുന്നു. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കി. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.</translation>
<translation id="8592211619057897362">ഓരോ പ്രൊഫൈലും ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ എന്നിവയും മറ്റും പോലുള്ള അതിന്റെ സ്വന്തം FlyWeb വിവരങ്ങൾ സൂക്ഷിക്കുന്നു</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb നിങ്ങളുടെ ഡാറ്റ എങ്ങനെ സ്വകാര്യമായി നിലനിർത്തുന്നു<ph name="END_LINK"/> എന്നതിനെക്കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="7489092380688543560">നിങ്ങൾക്ക് മറ്റൊരു FlyWeb പ്രൊഫൈലിൽ നിന്നുള്ള പാസ്‌വേഡുകൾ കാണാൻ പ്രൊഫൈൽ മാറ്റാം</translation>
<translation id="8243012192239086369">അക്ഷരപ്പിശകുകൾ പരിഹരിക്കാൻ, ടെക്‌സ്‌റ്റ് ഫീൽഡുകളിൽ നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്ന ടെക്‌സ്‌റ്റ് FlyWeb, FlyWeb-ന് അയയ്ക്കുന്നു</translation>
<translation id="3927263773110604886">FlyWeb അറിയിപ്പ് ക്രമീകരണത്തിലേക്ക് പോവുക</translation>
<translation id="6888846095017247017">നിങ്ങളുടെ മാറ്റങ്ങൾ അടുത്ത തവണ FlyWeb വീണ്ടും ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.</translation>
<translation id="1886169834787876002">നിങ്ങളുടെ ചുറ്റുപാടുകളുടെ 3D മാപ്പ് സൃഷ്‌ടിക്കാൻ FlyWeb-ന് ക്യാമറാ അനുമതി ആവശ്യമാണ്</translation>
<translation id="7640394575797555654">നിങ്ങൾ പ്രതീക്ഷിക്കുന്നത് പോലെത്തന്നെ സൈറ്റുകൾ പ്രവർത്തിക്കാനിടയുണ്ടെങ്കിലും, FlyWeb വിൻഡോകളെല്ലാം അടച്ചാൽ പിന്നീട് നിങ്ങളെ ഓർക്കുകയില്ല</translation>
<translation id="7570986009744020649">ബുക്ക്‌മാർക്കുകൾ നിങ്ങളുടെ FlyWeb sync chain-ലും സംരക്ഷിക്കുകയാണെങ്കിൽ, FlyWeb-ൽ ഉൽപ്പന്ന വിലകൾ ട്രാക്ക് ചെയ്യാനും അവയുടെ വില കുറയുമ്പോൾ അറിയിപ്പ് നേടാനുമാകും</translation>
<translation id="6676384891291319759">ഇന്റര്‍‌നെറ്റ് ആക്‌സസ് ചെയ്യുക</translation>
<translation id="1363996462118479832">സൈൻ ഇൻ ചെയ്യുന്നതിലെ പിശക് മൂലം ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="4748642594935526275">FlyWeb, നിങ്ങൾ കാണുന്ന പരസ്യങ്ങളിൽ നിങ്ങൾക്ക് കൂടുതൽ നിയന്ത്രണം നൽകുകയും നിങ്ങളെ വ്യക്തിപരമാക്കിയ പരസ്യങ്ങൾ കാണിക്കുമ്പോൾ സൈറ്റുകൾക്ക് നിങ്ങളെക്കുറിച്ച് അറിയാൻ കഴിയുന്ന വിവരങ്ങൾ പരിമിതപ്പെടുത്തുകയും ചെയ്യുന്നു</translation>
<translation id="4152880912192471857">FlyWeb-ന് ഈ സൈറ്റിനായി മൈക്രോഫോൺ അനുമതി ആവശ്യമാണ്</translation>
<translation id="6712881677154121168">ഡൗൺലോഡ് ചെയ്യുന്നതിൽ പിശക്: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="2193001403607253406">FlyWeb-ന്റെ ഏറ്റവും പുതിയ ഒരു പതിപ്പിൽ നിന്നുള്ളതായതിനാൽ നിങ്ങളുടെ പ്രൊഫൈൽ ഉപയോഗിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമായേക്കില്ല. മറ്റൊരു പ്രൊഫൈൽ ഡയറക്‌ടറി വ്യക്തമാക്കുകയോ FlyWeb-ന്റെ ഏറ്റവും പുതിയ പതിപ്പ് ഉപയോഗിക്കുകയോ ചെയ്യുക.</translation>
<translation id="5528558621229392814">വ്യക്തിപരമാക്കലും മറ്റ് ഫീച്ചറുകളും ലഭിക്കാൻ, വെബ്, ആപ്പ് ആക്റ്റിവിറ്റിയിലും ലിങ്ക് ചെയ്‌ത FlyWeb സേവനങ്ങളിലും FlyWeb ഉൾപ്പെടുത്തുക</translation>
<translation id="7728046102681268859">നിങ്ങളുടെ കമ്പ്യൂട്ടറിലെ എല്ലാ ഉപയോക്താക്കൾക്കുമായി നിലവിൽ FlyWeb ഇൻസ്റ്റാൾ ചെയ്‌തിട്ടുണ്ട്.</translation>
<translation id="7030752319019635064">നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും FlyWeb ഫയൽ ആക്സസ് ചെയ്യാൻ, സൈൻ ഇൻ ചെയ്ത ശേഷം സമന്വയിപ്പിക്കൽ ഓണാക്കുക.</translation>
<translation id="199909180078651278">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> എന്നിവയും മറ്റ് <ph name="COUNT"/> അനുമതികളും FlyWeb നീക്കം ചെയ്തു</translation>
<translation id="1292831930742306370">ഈ ഫയൽ അപകടകരമാകാൻ സാധ്യതയുള്ളതിനാൽ ഇത് സ്‌കാൻ ചെയ്യാൻ FlyWeb നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="1547295885616600893">ChromeOS സാധ്യമാക്കിയത് അധിക <ph name="BEGIN_LINK_CROS_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_CROS_OSS"/> ഉപയോഗിച്ചാണ്.</translation>
<translation id="6432682256389755533">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എപ്പോഴെങ്കിലും അപഹരിക്കപ്പെട്ടിട്ടുണ്ടെങ്കിൽ അക്കാര്യം FlyWeb നിങ്ങളെ അറിയിക്കും</translation>
<translation id="684888714667046800">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. നിങ്ങൾ ഫയർവാൾ ഉപയോഗിക്കുന്നുണ്ടെങ്കിൽ, <ph name="PRODUCT_EXE_NAME"/> വൈറ്റ്‌ലിസ്റ്റിൽ ഉണ്ടെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="4695676871328690599">"<ph name="EXTENSION_NAME"/>" എന്നതിൽ മാൽ‌വെയർ അടങ്ങുന്നതായി FlyWeb കണ്ടെത്തി</translation>
<translation id="5929819793040985066">ട്രയലുകൾ ഓണായിരിക്കുമ്പോൾ, നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളെ അവയുടെ പരസ്യങ്ങളുടെ പ്രകടനം അളക്കാൻ സഹായിക്കുന്ന FlyWeb-ൽ നിന്നുള്ള വിവരങ്ങൾ അഭ്യർത്ഥിക്കാൻ ആഡ് മെഷർമെന്റ് അനുവദിക്കുന്നു. സൈറ്റുകൾക്കിടയിൽ കഴിയുന്നത്ര കുറച്ച് വിവരങ്ങൾ കൈമാറുന്നതിലൂടെ ആഡ് മെഷർമെന്റ് ക്രോസ്-സൈറ്റ് ട്രാക്കിംഗ് നിയന്ത്രിക്കുന്നു.</translation>
<translation id="8806901087257994310">പിന്നീട്, കാണുന്ന പരസ്യങ്ങൾ വ്യക്തിപരമാക്കുന്നതിന് നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ കാണിക്കാൻ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റിന് FlyWeb-നോട് ആവശ്യപ്പെടാം. FlyWeb-ന് 3 താൽപ്പര്യങ്ങൾ വരെ പങ്കിടാനാകും.</translation>
<translation id="2553796189989827248">ദുർബലമായ പാസ്‌വേഡുകൾ ഊഹിക്കാൻ എളുപ്പമാണ്. <ph name="BEGIN_LINK"/>നിങ്ങൾക്കായി ശക്തമായ പാസ്‌വേഡുകൾ സൃഷ്ടിക്കാനും ഓർമ്മിക്കാനും<ph name="END_LINK"/> FlyWeb-ത്തെ അനുവദിക്കുക.</translation>
<translation id="1749753408579541220">ഓണായിരിക്കുമ്പോൾ, നിഷ്ക്രിയമായ ടാബുകളിൽ നിന്നുള്ള മെമ്മറി FlyWeb മറ്റ് ആവശ്യങ്ങൾക്ക് ലഭ്യമാക്കും. ഇത് സജീവമായ ടാബുകൾക്കും മറ്റ് ആപ്പുകൾക്കും കൂടുതൽ കമ്പ്യൂട്ടർ റിസോഴ്‌സുകൾ നൽകുകയും FlyWeb-നെ വേഗതയുള്ളതായി നിലനിർത്തുകയും ചെയ്യുന്നു. നിഷ്ക്രിയമായ ടാബുകളിലേക്ക് നിങ്ങൾ മടങ്ങുമ്പോൾ അവ സ്വയമേവ വീണ്ടും സജീവമാകും.</translation>
<translation id="3453763134178591239">ChromeOS നിബന്ധനകൾ</translation>
<translation id="8545123476334328275">ഈ സൈറ്റിനായി, FlyWeb-ത്തിന് നിങ്ങളുടെ മൈക്രോഫോൺ ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="7011190694940573312">ഓപ്പറേറ്റിംഗ് സിസ്റ്റത്തിന്റെ ഈ പതിപ്പ് പിന്തുണയ്ക്കാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="7024536598735240744">അൺപാക്ക് ചെയ്യുന്നതിൽ പിശക്: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ഇൻസ്റ്റാൾ ചെയ്യൽ നിർത്തി.</translation>
<translation id="8144357648892716751">FlyWeb നിങ്ങളുടേതാക്കുക</translation>
<translation id="3945284827084409390">FlyWeb അപ്‌ഡേറ്റ് ചെയ്യുക</translation>
<translation id="7886270027101123253">ചിത്രത്തിൽ ഉപകാരപ്രദമായ വിവരണമില്ലെങ്കിൽ നിങ്ങൾക്കായി ഒരു വിവരണം നൽകാൻ FlyWeb ശ്രമിക്കും. വിവരണങ്ങൾ സൃഷ്‌ടിക്കാൻ, ചിത്രങ്ങൾ FlyWeb-ലേക്ക് അയയ്ക്കുന്നു.</translation>
<translation id="5695394421048248926">FlyWeb for Testing ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="8694083743003679818">FlyWeb-ൽ നിന്ന് <ph name="EXTENSION_NAME"/> നീക്കംചെയ്യുക</translation>
<translation id="6017914745388312119"><ph name="TIMEOUT_DURATION"/> ഉപയോഗിച്ചില്ലെങ്കിൽ നിങ്ങളുടെ സ്ഥാപനം FlyWeb ഡാറ്റ ഇല്ലാതാക്കുന്നു. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.</translation>
<translation id="3283953248242339756">FlyWeb-ന് ഈ സൈറ്റിനായി ക്യാമറാ അനുമതി ആവശ്യമാണ്</translation>
<translation id="4729674580260824908">FlyWeb ലോഞ്ച് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="9165925035484501889">FlyWeb-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. 24 മണിക്കൂറിന് ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="935820624106805690">സന്ദേശങ്ങൾ, ഡോക്യുമെന്റുകൾ മറ്റ് ആപ്പുകൾ എന്നിവയിലെ ലിങ്കുകളിൽ ക്ലിക്ക് ചെയ്യുമ്പോഴെല്ലാം FlyWeb ഉപയോഗിക്കുക</translation>
<translation id="1678436729108859736">ടാസ്‌ക് മാനേജർ - FlyWeb</translation>
<translation id="6135229048093148288">FlyWeb-ന്റെ നിർണ്ണയം അനുസരിച്ചുള്ള നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{നിങ്ങൾ അത് നീക്കം ചെയ്യാൻ FlyWeb നിർദ്ദേശിക്കുന്നു}other{നിങ്ങൾ അവ നീക്കം ചെയ്യാൻ FlyWeb നിർദ്ദേശിക്കുന്നു}}</translation>
<translation id="7641415053133771502">നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളെ അവയുടെ പരസ്യങ്ങളുടെ പ്രകടനം അളക്കാൻ സഹായിക്കുന്ന FlyWeb-ൽ നിന്നുള്ള വിവരങ്ങൾ അഭ്യർത്ഥിക്കാൻ ആഡ് മെഷർമെന്റ് അനുവദിക്കുന്നു. സൈറ്റുകൾക്കിടയിൽ കഴിയുന്നത്ര കുറച്ച് വിവരങ്ങൾ കൈമാറുന്നതിലൂടെ ആഡ് മെഷർമെന്റ് ക്രോസ്-സൈറ്റ് ട്രാക്കിംഗ് നിയന്ത്രിക്കുന്നു.</translation>
<translation id="2866611433272355726">FlyWeb അപ്‌ഡേറ്റ് ചെയ്യുന്നു</translation>
<translation id="5013690772358862887">നിങ്ങളുടെ 'മുൻഗണനകൾ ഫയൽ' കേടായതാണ് അല്ലെങ്കിൽ അസാധുവാണ്.

നിങ്ങളുടെ ക്രമീകരണങ്ങൾ വീണ്ടെടുക്കാൻ FlyWeb-ന് കഴിയില്ല.</translation>
<translation id="7339898014177206373">പുതിയ വിന്‍ഡോ</translation>
<translation id="1123144153876435088">നിങ്ങളുടെ വെബ്, ബുക്ക്മാർക്കുകൾ,മറ്റ് FlyWeb ഫയൽ എന്നിവ ഇവിടെ തത്സമയമാണ്.</translation>
<translation id="6760192061736180746"><ph name="TARGET_URL_HOSTNAME"/> ആക്‌സസ് ചെയ്യാൻ <ph name="ALTERNATIVE_BROWSER_NAME"/> തുറക്കുന്നതിനായി നിങ്ങളുടെ സിസ്‌റ്റം അഡ്‌മിൻ FlyWeb കോൺഫിഗർ ചെയ്‌തു.</translation>
<translation id="3597072490217949295"><ph name="USER_EMAIL"/> ഉൾപ്പെടെയുള്ള നിങ്ങളുടെ വ്യക്തിഗത അക്കൗണ്ടുകൾക്കും സോഷ്യൽ നെറ്റ്‌വർക്ക് അക്കൗണ്ടുകൾക്കും ഫയൽ ദോഷകരമായേക്കാം എന്നതിനാൽ FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="5674884821459478726">ഈ വിപുലീകരണം ഇനി പിന്തുണയ്ക്കില്ല. പകരം, നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="3225813655660631613">FlyWeb പ്രൊഫൈലുകൾ ഉപയോഗിച്ച് നിങ്ങളുടെ എല്ലാ FlyWeb ഉള്ളടക്കവും വേർതിരിക്കാം. ജോലികാര്യങ്ങളും വിനോദവും പ്രത്യേകമായി തരംതിരിക്കുന്നത് ഇത് കൂടുതൽ എളുപ്പമാക്കുന്നു.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="3787225360375979559">ഈ സൈറ്റിനായി, FlyWeb-ത്തിന് നിങ്ങളുടെ ക്യാമറ ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="2431618580332826398">ഭാവിയിൽ FlyWeb അപ്‌ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് Windows 10 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ Windows 7 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="2154651873647244914">FlyWeb വീണ്ടും ആരംഭിക്കണോ?</translation>
<translation id="3137757192868162370">നിലവിൽ പ്രവർത്തിച്ചുക്കൊണ്ടിരിക്കുന്ന FlyWeb-ത്തിന്റെ സമാന പതിപ്പ് ഇൻസ്റ്റാൾ ചെയ്യാൻ കഴിയില്ല. FlyWeb അവസാനിപ്പിച്ചതിന് ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4027434552262956425">സൈറ്റുകൾ പ്രതീക്ഷിച്ചത് പോലെ പ്രവർത്തിക്കും. FlyWeb-ൽ സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ടെങ്കിൽ എല്ലാ FlyWeb വിൻഡോകളും അടയ്ക്കുമ്പോൾ, നിങ്ങളുടെ FlyWeb sync chain ഒഴികെ മിക്ക സൈറ്റുകളിൽ നിന്നും നിങ്ങൾ സൈൻ ഔട്ട് ആകും.</translation>
<translation id="4731230085409037950">{0,plural, =1{ഒരു മിനിറ്റിൽ FlyWeb വീണ്ടും സമാരംഭിക്കും}other{# മിനിറ്റിൽ FlyWeb വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="2681961630847487657">നിങ്ങളുടെ വിൻഡോ പങ്കിടാൻ, സിസ്റ്റം മുൻഗണനകളിൽ FlyWeb-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക</translation>
<translation id="5426732664223965459">FlyWeb-ന് നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ നിർണ്ണയിക്കാനാകും. പിന്നീട്, കാണുന്ന പരസ്യങ്ങൾ വ്യക്തിപരമാക്കുന്നതിന് നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ കാണിക്കാൻ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റിന് FlyWeb-നോട് ആവശ്യപ്പെടാം.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ഇൻസ്റ്റാളർ</translation>
<translation id="6174417243847172547">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION"/> FlyWeb നീക്കം ചെയ്തു</translation>
<translation id="3067364763515000789">FlyWeb നിങ്ങളുടെ ക്യാമറയും മൈക്രോഫോണും ഉപയോഗിക്കുന്നു.</translation>
<translation id="1381291360713116383">FlyWeb കൂടുതൽ മികച്ചതായി</translation>
<translation id="7649070708921625228">സഹായം</translation>
<translation id="481435825250648341">FlyWeb ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് ഈ ഫീച്ചറുകളെ കുറിച്ച് കൂടുതലറിയാനാകും.</translation>
<translation id="2230101319599356673">FlyWeb നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറല്ല</translation>
<translation id="3243257760331619874">നിങ്ങളുടെ ഉപകരണങ്ങളിലുടനീളം FlyWeb സമന്വയിപ്പിച്ച് വ്യക്തിഗതമാക്കുക</translation>
<translation id="3836891631266228927">FlyWeb അപ്‌ഡേറ്റ്</translation>
<translation id="1549877678317463759">ഇത് ഈ ഉപകരണത്തിൽ നിന്ന് നിങ്ങളുടെ ബ്രൗസിംഗ് വിവരങ്ങളെ ഇല്ലാതാക്കും. പിന്നീട് വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി FlyWeb-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="7747138024166251722">ഇൻസ്റ്റാളറിന് താൽക്കാലിക ഡയറക്റ്ററി സൃഷ്‌ടിക്കാനായില്ല. ശൂന്യമായ ഡിസ്‍ക് സ്പെയിസും സോഫ്റ്റ്‌വെയർ ഇൻസ്റ്റാൾ ചെയ്യാനുള്ള അനുമതിയും പരിശോധിക്കുക.</translation>
<translation id="134973275687829726">FlyWeb കൂടുതൽ വേഗതയുള്ളതാക്കുക</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8560501749799359076">നിങ്ങളുടെ ഇന്റർനെറ്റ് ട്രാഫിക്കിലേക്ക് ആക്സസുള്ള ആളുകൾക്ക് നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകൾ കാണുന്നത് പ്രയാസകരമാക്കും. DNS-ൽ (ഡൊമൈൻ നാമ സിസ്റ്റം) ഒരു സൈറ്റിന്റെ IP വിലാസം തിരയാൻ FlyWeb ഒരു സുരക്ഷിത കണക്ഷൻ ഉപയോഗിക്കുന്നു.</translation>
<translation id="8463540467315366872">ഈ അക്കൗണ്ടുള്ള FlyWeb പ്രൊഫൈൽ ഈ ഉപകരണത്തിൽ നിലവിലുണ്ട്</translation>
<translation id="7845233973568007926">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ കമ്പ്യൂട്ടർ റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="4766381896251401675">നിങ്ങൾ വിലാസ ബാറിലോ സെർച്ച് ബോക്‌സിലോ ടൈപ്പ് ചെയ്യുമ്പോൾ, മികച്ച നിർദ്ദേശങ്ങൾ ലഭിക്കുന്നതിന് ടൈപ്പ് ചെയ്യുന്നതെന്തോ അത് FlyWeb നിങ്ങളുടെ ഡിഫോൾട്ട് തിരയൽ യന്ത്രത്തിലേക്ക് അയയ്ക്കുന്നു. ഇത് അദൃശ്യ മോഡിൽ ഓഫാണ്.</translation>
<translation id="8611872055947278722">ഏറ്റവും പുതിയ പതിപ്പിലേക്ക് FlyWeb അപ്‌ഡേറ്റ് ചെയ്യാനായില്ല, അതിനാൽ പുതിയ ഫീച്ചറുകളും സുരക്ഷാ പരിഹാരങ്ങളും നിങ്ങൾക്ക് ലഭിക്കുന്നില്ല.</translation>
<translation id="7872446069773932638">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="SECONDS"/> സെക്കൻഡ് ശേഷിക്കുന്നു</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>നിങ്ങളുടെ ഡാറ്റ എങ്ങനെ മാനേജ് ചെയ്യാം:<ph name="END_BOLD"/> നിങ്ങളുടെ സ്വകാര്യത പരിരക്ഷിക്കുന്നതിന് 4 ആഴ്‌ചയിലധികം പഴക്കമുള്ള താൽപ്പര്യങ്ങൾ ഞങ്ങൾ സ്വയമേവ ഇല്ലാതാക്കുന്നു. നിങ്ങൾ ബ്രൗസ് ചെയ്യുന്നത് തുടരുമ്പോൾ, ഒരു താൽപ്പര്യം ലിസ്റ്റിൽ വീണ്ടും ദൃശ്യമായേക്കാം. അല്ലെങ്കിൽ FlyWeb പരിഗണിക്കരുതെന്ന് നിങ്ങൾ ആഗ്രഹിക്കുന്ന താൽപ്പര്യങ്ങൾ നിങ്ങൾക്ക് നീക്കം ചെയ്യാം.</translation>
<translation id="6798431672720500005">FlyWeb ഡിഫോൾട്ട് ബ്രൗസറായി സജ്ജീകരിക്കുക</translation>
<translation id="3096730275883527801">FlyWeb-ൽ നിങ്ങൾ <ph name="USER_EMAIL_ADDRESS"/> എന്നായി സൈൻ ഇൻ ചെയ്‌തു. വീണ്ടും സൈൻ ഇൻ ചെയ്യുന്നതിന് സമാന അക്കൗണ്ട് ഉപയോഗിക്കുക.</translation>
<translation id="9017338699075596174">ഇത് FlyWeb-ത്തിന്റെ ദ്വിതീയ ഇൻസ്‌റ്റലേഷനായതിനാൽ, നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാക്കാൻ കഴിയില്ല.</translation>
<translation id="5944585442866020176">FlyWeb-ത്തിന് ആക്‌സസ് ലഭിച്ചുകഴിഞ്ഞാൽ, വെബ്‌സൈറ്റുകൾക്ക് നിങ്ങളോട് ആക്‌സസ് ചോദിക്കാനാകും.</translation>
<translation id="80471789339884597">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ എല്ലാ ബ്രൗസറുകളും റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="8086881907087796310">നിങ്ങളുടെ കമ്പ്യൂട്ടർ ഏറ്റവും കുറഞ്ഞ ഹാർഡ്‌വെയർ ആവശ്യകതകൾ പാലിക്കാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">FlyWeb-ന് ഈ സൈറ്റിനായി ലൊക്കേഷൻ അനുമതി ആവശ്യമാണ്</translation>
<translation id="5334309298019785904">നിങ്ങളുടെ ഡൊമെയ്‌നിൽ സമന്വയിപ്പിക്കൽ ലഭ്യമല്ലാത്തതിനാൽ ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="813913629614996137">ആരംഭിക്കുന്നു...</translation>
<translation id="1446402395644795187">FlyWeb-ന്റെ JavaScript, WebAssembly എഞ്ചിനുകളിൽ അധിക പരിരക്ഷ ഓണാക്കുക</translation>
<translation id="1597323875619800374">ഈ ഫയൽ അപകടകരമായതിനാൽ FlyWeb ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="4749458995158778066">ഈ വിപുലീകരണം എവിടെ നിന്നാണ് വരുന്നതെന്ന് FlyWeb-ന് പരിശോധിച്ചുറപ്പിക്കാനാകില്ല, കൂടാതെ അത് സുരക്ഷിതമല്ലായിരിക്കാം. FlyWeb-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="6756872644564483342">ചിത്രത്തിൽ ഉപകാരപ്രദമായ വിവരണമില്ലെങ്കിൽ നിങ്ങൾക്കായി ഒരു വിവരണം നൽകാൻ FlyWeb ശ്രമിക്കും. വിവരണങ്ങൾ സൃഷ്‌ടിക്കാൻ, ചിത്രങ്ങൾ FlyWeb-ലേക്ക് അയയ്ക്കുന്നു. ഏതുസമയത്തും ക്രമീകരണത്തിൽ നിങ്ങൾക്കിത് ഓഫാക്കാം.</translation>
<translation id="9179486248398668702">പുതിയൊരു പ്രൊഫൈലിൽ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യണോ?</translation>
<translation id="5792785787074426346">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിട്ടില്ലാത്തതിനാൽ FlyWeb-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവില്ല</translation>
<translation id="9102959605052547519">സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളെയും ഡൗൺലോഡുകളെയും കുറിച്ച് <ph name="BEGIN_LINK"/>FlyWeb നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകുന്നു<ph name="END_LINK"/></translation>
<translation id="208266011144024011"><ph name="TIMEOUT_DURATION"/> ഉപയോഗിച്ചില്ലെങ്കിൽ നിങ്ങളുടെ സ്ഥാപനം FlyWeb ഡാറ്റ അടയ്ക്കുന്നു.</translation>
<translation id="5565286784156841599">നിങ്ങളുടെ ഉപകരണങ്ങളിലുടനീളം FlyWeb സമന്വയിപ്പിച്ച് വ്യക്തിഗതമാക്കാൻ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/> മുമ്പ് FlyWeb ഉപയോഗിച്ചിട്ടുണ്ട്</translation>
<translation id="5975370349701995302">നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും FlyWeb ബ്രൗസർ ഉള്ളടക്കം ആക്സസ് ചെയ്യാൻ, സൈൻ ഇൻ ചെയ്ത ശേഷം സമന്വയിപ്പിക്കൽ ഓണാക്കുക</translation>
<translation id="7408894216012529448">ഭാവിയിൽ FlyWeb അപ്‌ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് Windows 10 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ Windows 8 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="5020916672477085422">പാസ്‌വേഡുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. സൈൻ ഇൻ ചെയ്‌തുകഴിഞ്ഞാൽ ഈ പാസ്‌വേഡ് നിങ്ങളുടെ FlyWeb sync chain-ൽ സംരക്ഷിക്കും.</translation>
<translation id="5417365165109189454">തുടർന്ന്, നിങ്ങൾ FlyWeb റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="4212474799248200893">നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് FlyWeb നിർദ്ദേശിക്കുന്നു. <ph name="BEGIN_LINK"/>പിന്തുണയ്ക്കുന്ന വിപുലീകരണങ്ങളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">ഈ വിപുലീകരണം അതിന്റെ ഡെവലപ്പർ പ്രസിദ്ധീകരിച്ചത് റദ്ദാക്കി, ഇത് സുരക്ഷിതമല്ലായിരിക്കാം. FlyWeb-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="5261590792975521002">{0,plural, =1{ഒരു ദിവസത്തിനുള്ളിൽ FlyWeb വീണ്ടും സമാരംഭിക്കുക}other{# ദിവസത്തിനുള്ളിൽ FlyWeb വീണ്ടും സമാരംഭിക്കുക}}</translation>
<translation id="3101564993057563365">ഇൻസ്റ്റാളർ ആർക്കൈവ് കേടായതാണ് അല്ലെങ്കിൽ അസാധുവാണ്. FlyWeb വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="5316851838033144902">FlyWeb-ത്തിന് Windows 10 അല്ലെങ്കിൽ അതിനുശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്.</translation>
<translation id="6760691951531758781">ഓപ്ഷണൽ: പ്രശ്നനിർണ്ണയ, ഉപയോഗ ഡാറ്റ സ്വയമേവ FlyWeb-ന് അയച്ച് ChromeOS ഫീച്ചറുകളും പ്രകടനവും മെച്ചപ്പെടുത്താൻ സഹായിക്കുക.</translation>
<translation id="6852836260419236265">FlyWeb കാലഹരണപ്പെട്ടു</translation>
<translation id="797182360653885317">നിങ്ങളുടെ പാസ്‌വേഡുകൾ സംരക്ഷിക്കുകയാണങ്കിൽ, FlyWeb-ന് അവ പരിശോധിക്കാനാകും</translation>
<translation id="8550334526674375523">ഈ ഔദ്യോഗിക പ്രൊഫൈൽ നിങ്ങളുടെ വ്യക്തിപരമായ പ്രൊഫൈലിൽ നിന്ന് തികച്ചും വ്യത്യസ്തമാണ്.</translation>
<translation id="8555465886620020932">സേവന പിശക്: <ph name="SERVICE_ERROR"/></translation>
<translation id="8842078659829047498">FlyWeb sync chain ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുമ്പോൾ FlyWeb-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവും</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="6539417028609632917"><ph name="BEGIN_BOLD"/>ഈ ഡാറ്റ ഞങ്ങൾ എങ്ങനെ ഉപയോഗിക്കുന്നു:<ph name="END_BOLD"/> സൈറ്റുകൾക്ക് നിങ്ങളുടെ താൽപ്പര്യങ്ങളെക്കുറിച്ചുള്ള വിവരങ്ങൾ FlyWeb-ൽ സംഭരിക്കാനാകും. ഉദാഹരണത്തിന്, മാരത്തൺ ഓട്ടത്തിനായി ഷൂസ് വാങ്ങാൻ നിങ്ങൾ ഒരു സൈറ്റ് സന്ദർശിക്കുകയാണെങ്കിൽ മാരത്തൺ ഓടുന്നതാണ് നിങ്ങളുടെ താൽപ്പര്യമെന്ന് സൈറ്റ് നിർവ്വചിച്ചേക്കാം. പിന്നീട്, ഒരു ഓട്ടമത്സരത്തിന് രജിസ്റ്റർ ചെയ്യാൻ നിങ്ങൾ മറ്റൊരു സൈറ്റ് സന്ദർശിക്കുകയാണെങ്കിൽ, നിങ്ങളുടെ താൽപ്പര്യങ്ങളെ അടിസ്ഥാനമാക്കി റണ്ണിംഗ് ഷൂസുകളുടെ പരസ്യം കാണിക്കാൻ ആ സൈറ്റിന് കഴിയും.</translation>
<translation id="7129578417724116642">FlyWeb സമാരംഭിക്കുന്നു...</translation>
<translation id="781795332371306113">അവ്യക്തമായ പിശകിനാൽ ഇൻസ്റ്റാൾ ചെയ്യൽ പരാജയപ്പെട്ടു. FlyWeb വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="5469043671012993003">FlyWeb for Testing നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാക്കാനാകില്ല.</translation>
<translation id="1514450422236300417">നിങ്ങൾ FlyWeb ആരംഭിക്കുമ്പോൾ അല്ലെങ്കിൽ ഓമ്‌നിബോക്‌സിൽ നിന്ന് തിരയുമ്പോൾ ദൃശ്യമാകുന്ന പേജും അത് നിയന്ത്രിയ്ക്കുന്നു.</translation>
<translation id="573490495087487940">ഇത് നിങ്ങളുടെ FlyWeb ആണ്</translation>
<translation id="2666961286257416158">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യണോ?</translation>
<translation id="878572486461146056">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാൾ ചെയ്യൽ തടയുന്ന ഒരു ഗ്രൂപ്പ് നയം നിങ്ങളുടെ നെറ്റ്‌വർക്ക് അഡ്‌മിനിസ്ട്രേറ്റർ ബാധകമാക്കി: <ph name="INSTALL_ERROR"/></translation>
<translation id="6779439179813982247">ഈ സൈറ്റിനായി, FlyWeb-ത്തിന് നിങ്ങളുടെ ക്യാമറയും മൈക്രോഫോണും ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="6808406663598665473">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യണോ?</translation>
<translation id="8826492472752484139">“Password Manager” ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="6933858244219479645">ChromeOS സിസ്റ്റം</translation>
<translation id="7354175404728814475"><ph name="BEGIN_BOLD"/>എന്തൊക്കെ ഡാറ്റ ഉപയോഗിക്കുന്നു:<ph name="END_BOLD"/> ഈ ഉപകരണത്തിൽ FlyWeb ഉപയോഗിച്ച് നിങ്ങൾ സന്ദർശിച്ച സൈറ്റുകളുടെ റെക്കോർഡ് ആയ നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം.</translation>
<translation id="8862326446509486874">സിസ്റ്റം തലത്തിൽ ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യുന്നതിന് നിങ്ങള്‍‌ക്ക് ഉചിതമായ അവകാശങ്ങളില്ല. അഡ്‌മിനിസ്‌ട്രേറ്ററായി ഇന്‍‌സ്റ്റാളര്‍‌ റണ്‍ ചെയ്യിക്കാൻ വീണ്ടും ശ്രമിക്കൂ.</translation>
<translation id="709828993049448700">മാറ്റിയെങ്കിൽ, നിങ്ങളുടെ FlyWeb-ലെ സംരക്ഷിച്ച പാസ്‌വേഡ് എഡിറ്റ് ചെയ്യുക. എങ്കിൽ മാത്രമേ ഈ പുതിയ പാസ്‌വേഡുമായി അത് പൊരുത്തപ്പെടൂ.</translation>
<translation id="4669168852412989042">FlyWeb പാസ്‌വേഡുകൾ ദൃശ്യമാക്കാൻ ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="1343885466359249904">കഴിഞ്ഞ ഏതാനും ആഴ്‌ചകളിലെ നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രത്തെ അടിസ്ഥാനമാക്കി FlyWeb-ന് നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ നിർണ്ണയിക്കാനാകും. ഈ വിവരങ്ങൾ നിങ്ങളുടെ ഉപകരണത്തിൽ നിലനിൽക്കും.</translation>
<translation id="1663379621921336006">FlyWeb അപ്‌ഡേറ്റ് ചെയ്യാനാകില്ല</translation>
<translation id="543915850302643692">FlyWeb Enterprise ലോഗോ</translation>
<translation id="8986207147630327271">നിങ്ങൾ ഈ ബ്രൗസറിലേക്ക് ഒരു ഔദ്യോഗിക പ്രൊഫൈൽ ചേർക്കുകയും നിങ്ങളുടെ അഡ്മിന് ഔദ്യോഗിക പ്രൊഫൈലിലേക്ക് മാത്രം നിയന്ത്രണം നൽകുകയും ചെയ്യുന്നു.</translation>
<translation id="8422308271795251425">FlyWeb പ്രൊഫൈലുകൾ മാനേജ് ചെയ്യുക</translation>
<translation id="5804408305184682593">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="2138383893834402906">മാൽവെയർ അടങ്ങിയേക്കാവുന്ന മറ്റ് ഫയലുകൾ ആർക്കൈവ് ഫയലിൽ ഉള്ളതിനാൽ FlyWeb ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="7813768067688376455">നിങ്ങൾ മറ്റ് FlyWeb സേവനങ്ങളിലേക്ക് സൈൻ ഇൻ ചെയ്യുമ്പോൾ FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="8692043725449223663">FlyWeb-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. ആ അക്കൗണ്ട് ഉപയോഗിച്ച് ഒരു തവണ മാത്രമേ സൈൻ ഇൻ ചെയ്യേണ്ടതുള്ളൂ എങ്കിൽ നിങ്ങൾക്ക് <ph name="GUEST_LINK_BEGIN"/>അതിഥിയായി ഉപകരണം ഉപയോഗിക്കാം<ph name="GUEST_LINK_END"/>.</translation>
<translation id="8323442969389928559">FlyWeb സ്വയമേവ അടച്ചു</translation>
<translation id="7626272203917389133">FlyWeb കാലഹരണപ്പെട്ടു</translation>
<translation id="1789655708880997767">{0,plural, =1{ഒരു മണിക്കൂറിൽ FlyWeb വീണ്ടും സമാരംഭിക്കും}other{# മണിക്കൂറിൽ FlyWeb വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="8970147445441095618">ഭാവിയിൽ FlyWeb അപ്‌ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് Windows 10 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ Windows 8.1 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="1208237657860748752">പുതിയ FlyWeb &amp;ടാബിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="911206726377975832">നിങ്ങളുടെ ബ്രൗസിംഗ് ഡാറ്റയും ഇതോടൊപ്പം ഇല്ലാതാക്കണോ?</translation>
<translation id="1899793037348288257">ട്രയൽ സമയത്ത്, നിങ്ങളെ പരസ്യങ്ങൾ കാണിക്കാൻ സൈറ്റുകൾ ഉപയോഗിക്കുന്ന, താൽപ്പര്യമുള്ള വിഷയങ്ങൾ കാണാനും നീക്കം ചെയ്യാനും നിങ്ങൾക്ക് കഴിയും. നിങ്ങളുടെ അടുത്തിടെയുള്ള ബ്രൗസിംഗ് ചരിത്രം അടിസ്ഥാനമാക്കി നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ FlyWeb അനുമാനിക്കുന്നു.</translation>
<translation id="3926534790663909774"><ph name="TARGET_URL_HOSTNAME"/> ആക്‌സസ് ചെയ്യാൻ ഇതര ബ്രൗസർ തുറക്കുന്നതിനായി നിങ്ങളുടെ സിസ്‌റ്റം അഡ്‌മിൻ FlyWeb കോൺഫിഗർ ചെയ്‌തു.</translation>
<translation id="5022081608392609959">&amp;FlyWeb അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">FlyWeb നിങ്ങൾക്ക് അനുയോജ്യമാക്കൂ</translation>
<translation id="3410331617397516204">ഇനിയങ്ങോട്ട് Windows XP-യും Windows Vista-യും പിന്തുണയ്‌ക്കാത്തതിനാൽ FlyWeb ശരിയായി പ്രവർത്തിച്ചേക്കില്ല</translation>
<translation id="1641772209502041092">FlyWeb മാനേജ് ചെയ്യുന്ന സർട്ടിഫിക്കറ്റുകൾ</translation>
<translation id="1127626874097952395">ആരൊക്കെയാണ് FlyWeb ഉപയോഗിക്കുന്നത്?</translation>
<translation id="1626113414414104077">FlyWeb-ന്റെ ഏറ്റവും ശക്തമായ സുരക്ഷ നേടുക</translation>
<translation id="983803489796659991">അപ്‌ഡേറ്റ് സെർവറിൽ ആപ്പിനായി ഹാഷ് ഡാറ്റയൊന്നും ഇല്ലാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടു.</translation>
<translation id="839475718250652248">അക്കൗണ്ട് ഇല്ലാതെ FlyWeb ഉപയോഗിക്കുക</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="137466361146087520">Google Chrome ബീറ്റ</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="4434689349450618970">ഈ അക്കൗണ്ട് ഒരു തവണ മാത്രം ഉപയോഗിച്ചാൽ മതിയെങ്കിൽ, നിങ്ങൾക്ക് FlyWeb ബ്രൗസറിലെ <ph name="GUEST_LINK_BEGIN"/>അതിഥി മോഡ്<ph name="GUEST_LINK_END"/> ഉപയോഗിക്കാം. മറ്റാർക്കെങ്കിലും വേണ്ടി അക്കൗണ്ട് ചേർക്കണമെന്നുണ്ടെങ്കിൽ നിങ്ങളുടെ <ph name="DEVICE_TYPE"/> ഉപകരണത്തിലേക്ക് <ph name="LINK_BEGIN"/>പുതിയൊരു വ്യക്തിയെ ചേർക്കുക<ph name="LINK_END"/>.

വെബ്‌സൈറ്റുകൾക്കും ആപ്പുകൾക്കും നിങ്ങൾ ഇതിനകം നൽകിയ അനുമതികൾ ഈ അക്കൗണ്ടിന് ബാധകമായേക്കാം. <ph name="SETTINGS_LINK_BEGIN"/>ക്രമീകരണത്തിൽ<ph name="SETTINGS_LINK_END"/> നിങ്ങളുടെ FlyWeb അക്കൗണ്ടുകൾ മാനേജ് ചെയ്യാം.</translation>
<translation id="2725795635123877647">അറിയാത്ത ഉറവിടങ്ങളിൽ നിന്നുള്ള വിപുലീകരണങ്ങൾ, ആപ്പുകൾ, തീമുകൾ എന്നിവ നിങ്ങളുടെ ഉപകരണത്തിന് ദോഷകരമാകാം. അവ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> എന്നതിൽ നിന്ന് മാത്രം ഇൻസ്റ്റാൾ ചെയ്യാൻ FlyWeb നിർദ്ദേശിക്കുന്നു</translation>
<translation id="5382847955032513683">മുന്നറിയിപ്പ്: നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം റെക്കോർഡ് ചെയ്യുന്നതിൽ നിന്ന് വിപുലീകരണങ്ങളെ തടയാൻ FlyWeb-ന് കഴിയില്ല. അദൃശ്യമോഡിൽ ഈ വിപുലീകരണം പ്രവർത്തനരഹിതമാക്കാൻ, ഈ ഓപ്ഷൻ തിരഞ്ഞെടുത്തത് റദ്ദാക്കുക.</translation>
<translation id="543905389684998697">FlyWeb സുരക്ഷിതമാക്കുന്നതിന്, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> എന്നതിൽ ലിസ്റ്റുചെയ്യാത്ത ചില വിപുലീകരണങ്ങൾ ഞങ്ങൾ പ്രവർത്തനരഹിതമാക്കി, അവ നിങ്ങളുടെ അറിവില്ലാതെ ചേർത്തിരിക്കാനിടയുണ്ട്.</translation>
<translation id="3914570680366033593">FlyWeb സുരക്ഷിതമാക്കാൻ, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> എന്നതിൽ ലിസ്റ്റുചെയ്യാത്ത ഇനിപ്പറയുന്ന വിപുലീകരണം ഞങ്ങൾ പ്രവർത്തനരഹിതമാക്കി, അവ നിങ്ങളുടെ അറിവില്ലാതെ ചേർത്തിരിക്കാനിടയുണ്ട്.</translation>
<translation id="3293172835368652510">ഈ ഉപകരണത്തിൽ നിന്ന് ഈ വ്യക്തിയുടെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഡാറ്റ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നതായി FlyWeb-ത്തിലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2742103213766991703">FlyWeb ആൾ&amp;മാറാട്ട വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="1616978953472841483">FlyWeb ആൾ&amp;മാറാട്ട വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{FlyWeb-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും.}=1{FlyWeb-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{FlyWeb-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് FlyWeb വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു}=1{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് FlyWeb വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് FlyWeb വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് FlyWeb വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു}=1{അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് FlyWeb വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് FlyWeb വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="4630629063306099328">സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്ന FlyWeb അക്കൗണ്ടുകൾ നിങ്ങൾക്ക് മാനേജ് ചെയ്യാം. FlyWeb ബ്രൗസർ, Play Store, Gmail എന്നിവയ്ക്കും മറ്റുമായി നിങ്ങളുടെ FlyWeb അക്കൗണ്ടുകൾ ഉപയോഗിക്കുന്നു. കുടുംബാംഗത്തെ പോലുള്ള മറ്റാർക്കെങ്കിലും വേണ്ടി ഒരു അക്കൗണ്ട് ചേർക്കണമെങ്കിൽ, പകരം നിങ്ങളുടെ <ph name="DEVICE_TYPE"/> എന്നതിലേക്ക് പുതിയൊരു വ്യക്തിയെ ചേർക്കുക. <ph name="LINK_BEGIN"/>കൂടുതലറിയുക<ph name="LINK_END"/></translation>
</translationbundle>