<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mr">
<translation id="130631256467250065">तुम्ही आपल्या डिव्हाइसचा पुढील वेळी पुनरारंभ कराल तेव्हा तुमचे बदल प्रभावी होतील.</translation>
<translation id="1555506416658437797">पेमेंट पद्धती संपादित करा.</translation>
<translation id="8359495463485001719">FlyWeb मध्ये क्रॅश अहवाल उपलब्ध नाही.</translation>
<translation id="6338530717474923868">तुम्ही एक सुरक्षित FlyWeb पेज पाहत आहात</translation>
<translation id="5147169001159408844">FlyWeb पेमेंट पद्धती भरण्यासाठी सेटिंग्जमध्ये फेरबदल करण्याचा प्रयत्न करत आहे.</translation>
<translation id="5702992568540613683">FlyWeb लोगो</translation>
<translation id="510342522494506803">FlyWeb हे पेमेंट पद्धती संपादित करण्याचा प्रयत्‍न करत आहे.</translation>
<translation id="8375862260948854624">FlyWeb हे <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> खुला स्रोत प्रकल्प आणि इतर <ph name="BEGIN_LINK_OSS"/>खुले स्रोत सॉफ्टवेअर<ph name="END_LINK_OSS"/> द्वारे बनवणे शक्य झाले.</translation>
<translation id="4281953335231207224">FlyWeb मेनू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          LAN सेटिंग्ज
          वर जा आणि "तुमच्या LAN साठी एक प्रॉक्सी सर्व्हर वापरा" चेकबॉक्स ची निवड रद्द करा.</translation>
<translation id="5040124620086808431">हे पेज FlyWeb ने ब्लॉक केले आहे</translation>
<translation id="1953000035868532675">तुमच्या फायरवॉल किंवा अँटीव्हायरस सेटिंग्जमधील नेटवर्क ॲक्सेस करण्यास
        FlyWeb ला परवानगी  द्या.</translation>
<translation id="3442058224540562441">FlyWeb मेनू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          वर जा आणि तुमचे कॉंफिगरेशन "प्रॉक्सी नाही" किंवा "प्रत्यक्ष" वर सेट केल्याचे सुनिश्चित करा.</translation>
<translation id="585620188971323280">पेमेंट पद्धती भरण्यासाठी सेटिंग्जमध्ये फेरबदल करा.</translation>
<translation id="2681118099728446983">FlyWeb हे इतर <ph name="BEGIN_LINK_OSS"/>मुक्त स्रोत सॉफ्टवेअर<ph name="END_LINK_OSS"/> द्वारेदेखील तयार करण्यात आले आहे.</translation>
<translation id="6888846095017247017">तुम्ही पुढल्या वेळी FlyWeb रीलाँच कराल तोपर्यंत तुमचे बदल प्रभावी होतील.</translation>
<translation id="1017070759373671177">FlyWeb हे <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> मुक्त स्रोत प्रोजेक्टद्वारे तयार करण्यात आले आहे.</translation>
<translation id="7777112741998051633">FlyWeb मेनू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          वर जा आणि "<ph name="NO_PREFETCH_DESCRIPTION"/>" ची निवड रद्द करा.
          हे समस्‍येचे निराकरण करीत नसल्‍यास, आम्‍ही
सुधारित कार्यप्रदर्शनासाठी पुन्हा
          हा पर्याय निवडण्याची शिफारस करतो.</translation>
<translation id="8187289872471304532">ॲप्लिकेशन &gt; सिस्टम प्राधान्ये &gt; नेटवर्क &gt; प्रगत &gt; प्रॉक्सी
          वर जा आणि निवडलेल्या कोणत्याही प्रॉक्सींची निवड रद्द करा.</translation>
<translation id="4699594416850504200">तुम्ही सुरक्षित FlyWeb for Testing पेज पाहत आहात</translation>
<translation id="6224789938625024797">FlyWeb योग्यरित्या बंद केले नव्‍हते.</translation>
</translationbundle>