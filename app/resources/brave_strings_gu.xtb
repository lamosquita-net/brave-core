<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1026101648481255140">ઇન્સ્ટૉલેશનની પ્રક્રિયા ફરી શરૂ કરો</translation>
<translation id="7099479769133613710">&amp;ChromeOSને અપડેટ કરવા માટે, તેને ફરીથી લૉન્ચ કરો</translation>
<translation id="291426170030461697">FlyWeb તમને આ એક્સ્ટેન્શનનો રિવ્યૂ કરવાનો સુઝાવ આપે છે</translation>
<translation id="1549005488226693697">જ્યારે કોઈ સાઇટ તેના પેજ પર લિંક ખાનગી રીતે પહેલેથી લોડ કરવાનું પૂછે, ત્યારે FlyWeb FlyWeb સર્વરનો ઉપયોગ કરે છે. આ તમારી ઓળખ પહેલેથી લોડ કરેલી સાઇટથી છુપાવે છે, પણ Braveને એ જાણવા મળે છે કે કઈ સાઇટ પહેલેથી લોડ કરવામાં આવે છે.</translation>
<translation id="1065672644894730302">તમારી પસંદગીઓને વાંચી શકાતી નથી.

કેટલીક સુવિધાઓ ઉપલબ્ધ હોઈ શકે છે અને પસંદગીઓ પરના ફેરફારોને સાચવવામાં આવશે નહીં.</translation>
<translation id="8908267645832965492">તમારા માતાપિતાએ FlyWeb માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે.\</translation>
<translation id="6896681084876612310">FlyWeb તમને ડેટા ઉલ્લંઘન, ખરાબ એક્સ્ટેંશન અને બીજી ઘણી બાબતોથી સુરક્ષિત રાખી શકે છે</translation>
<translation id="1368460307421081773">FlyWeb તમારા પાસવર્ડની નિકાસ કરવા માગે છે. આને મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="7307912249127683931">FlyWeb તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="4556715463645168547">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK"/>Braveiumમાં સાઇન ઇન કરો<ph name="END_LINK"/>.</translation>
<translation id="2076135703183650206">FlyWeb મેનૂ પર ક્લિક કરો</translation>
<translation id="1184145431117212167">Windowsનું તમારું વર્ઝન સપોર્ટેડ ન હોવાને કારણે આ ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="4380351562011537903">FlyWeb વિશે</translation>
<translation id="2593084789070248821">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમની પસંદગીઓમાં FlyWeb માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="1203500561924088507">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME"/>નો ઉપયોગ કરતા પહેલાં તમારે તમારું બ્રાઉઝર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="4750836834956739196">જ્યારે આ ટૅબ નિષ્ક્રિય હતું, ત્યારે Braveને ઝડપી રાખવા માટે મેમરી ખાલી કરવામાં આવી હતી. તમે આ સાઇટને નિષ્ક્રિય રહેવામાંથી બાકાત રાખવાનું હંમેશા પસંદ કરી શકો છો.</translation>
<translation id="3190759351483708314">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે ફાઇલ જોખમી છે</translation>
<translation id="5879469261638423015">Gmail કે YouTube જેવી Braveની સેવાઓમાં <ph name="USER_EMAIL"/> વડે સાઇન ઇન કરતી વખતે, તમે એ જ એકાઉન્ટ વડે Braveમાં ઑટોમૅટિક રીતે સાઇન ઇન કરી શકો છો</translation>
<translation id="1290883685122687410">સેટઅપ કરવામાં ભૂલ: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4549187150186083146">તમારી નવી FlyWeb પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="609743863669742325">બ્લૂટૂથ ડિવાઇસ વિશે શોધખોળ કરવા Braveને બ્લૂટૂથના 
 ઍક્સેસની જરૂર છે. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="2276527911011636666">FlyWeb (<ph name="URL"/>)માંથી પણ ડેટા ડિલીટ કરો</translation>
<translation id="4150708158890309866">તમે FlyWeb માં સાઇન ઇન કર્યું છે!</translation>
<translation id="4713192356155907986">FlyWeb for Testing માટે સહાય મેળવો</translation>
<translation id="1497802159252041924">ઇન્સ્ટૉલ કરવામાં ભૂલ: <ph name="INSTALL_ERROR"/></translation>
<translation id="8962360511570172">FlyWeb ટૅબ શેર કરો</translation>
<translation id="8196829963313696543">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Braveને તમારા કૅમેરાના ઍક્સેસની પરવાનગી જરૂરી છે</translation>
<translation id="7438510757222932553">{NUM_EXTENSIONS,plural, =1{આ એક્સ્ટેન્શનને હવે સપોર્ટ કરવામાં આવતો નથી. FlyWeb તમને તેને કાઢી નાખવાનો સુઝાવ આપે છે.}one{આ એક્સ્ટેન્શનને હવે સપોર્ટ કરવામાં આવતો નથી. FlyWeb તમને તેને કાઢી નાખવાનો સુઝાવ આપે છે.}other{આ એક્સ્ટેન્શનને હવે સપોર્ટ કરવામાં આવતો નથી. FlyWeb તમને તેને કાઢી નાખવાનો સુઝાવ આપે છે.}}</translation>
<translation id="852852907317361085">Braveના સલામતી માટેના ટૂલ</translation>
<translation id="4096742538387076253">અમુક ડેટા તમારા FlyWeb એકાઉન્ટમાં સાચવી શકાયો હોય અને તેનો ઉપયોગ તમારા બધા ડિવાઇસ પર કરી શકાયો હોય એ પહેલાં, FlyWeb માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે સાઇન આઉટ કરશો, તો આ ડેટા આ ડિવાઇસ પર રહેશે.</translation>
<translation id="481155564361715417">FlyWeb તમારો Password Manager ડેટા ડિલીટ કરવા માગે છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="3961251277542681013">Braveમાં પ્રાઇવસી અને સુરક્ષા સંબંધિત મુખ્ય નિયંત્રણોનો રિવ્યૂ કરો</translation>
<translation id="1640672724030957280">ડાઉનલોડ કરી રહ્યું છે...</translation>
<translation id="6153580651793156880">આ સુવિધાઓને બહેતર બનાવવામાં સહાય કરવા માટે, FlyWeb તેની સાથેની તમારી ક્રિયાપ્રતિક્રિયાઓ Braveને મોકલે છે. માનવ રિવ્યૂઅર દ્વારા આ ડેટા વાંચવામાં આવી શકે છે તેમજ તેના પર પ્રક્રિયા અને ટીકાટિપ્પણી કરવામાં આવી શકે છે.</translation>
<translation id="1722488837206509557">આ તમને ઉપલબ્ધ ડિવાઇસમાંથી પસંદ કરવાની અને તેમના પર કન્ટેન્ટ બતાવવાની મંજૂરી આપશે.</translation>
<translation id="2383861520542390014">તમે રુચિના એ વિષયોને જોઈ અને કાઢી નાખી શકો છો કે જેનો ઉપયોગ સાઇટ તમને જાહેરાતો બતાવવા માટે કરે છે. FlyWeb તમારા તાજેતરના બ્રાઉઝિંગ ઇતિહાસના આધારે તમારી રુચિઓનું અનુમાન લગાવે છે.</translation>
<translation id="5695205873161614119">FlyWeb ટૂંક સમયમાં જ બ્રાઉઝિંગ ડેટા ડિલીટ કરશે</translation>
<translation id="8939535770474283898">FlyWeb નૅવિગેશનને HTTPS પર અપગ્રેડ કરવાનો પ્રયાસ કરશે</translation>
<translation id="7385422968404728039">FlyWeb <ph name="REMAINING_TIME"/>માં ફરી શરૂ થશે</translation>
<translation id="6903827847227122616">જ્યારે HTTPS ઉપલબ્ધ ન હોય, ત્યારે FlyWeb તમને ચેતવણી આપ્યા વિના અસુરક્ષિત કનેક્શનનો ઉપયોગ કરશે</translation>
<translation id="307170399141486420">Braveને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="2473319786107120819">FlyWeb ફરીથી ઇન્સ્ટોલ કરો</translation>
<translation id="2533324957407080119">FlyWeb <ph name="AUTHENTICATION_PURPOSE"/>નો પ્રયાસ કરી રહ્યું છે</translation>
<translation id="3403116471618205223">તમારા FlyWeb એકાઉન્ટમાં બ્રાઉઝિંગ ડેટા રાખીને તેને માત્ર આ ડિવાઇસમાંથી ડિલીટ કરવા માટે, <ph name="BEGIN_LINK"/>Braveમાંથી સાઇન આઉટ કરો<ph name="END_LINK"/>.</translation>
<translation id="6434738578659849497">સાઇટ, FlyWeb પર તમારી રુચિના વિષયો વિશેની માહિતી સ્ટોર કરી શકે છે. ઉદાહરણ તરીકે જો તમે મૅરેથનમાં દોડવા માટે શૂઝ ખરીદવા કોઈ સાઇટની મુલાકાત લો, તો એ સાઇટ મૅરેથન દોડને તમારી રુચિના વિષય તરીકે સાચવી શકે છે. પછી, જો તમે દોડ માટે રજિસ્ટ્રેશન કરાવવા કોઈ અન્ય સાઇટની મુલાકાત લેશો, તો તે સાઇટ તમારી રુચિના વિષયના આધારે તમને દોડવા માટેના શૂઝની જાહેરાત બતાવી શકે છે.</translation>
<translation id="4824940465467423308">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી FlyWeb પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો FlyWeb ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME"/>થી જોડાયેલા રહેશે. તમે FlyWeb એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. તમે હાલના FlyWeb ડેટાને અલગ રાખવા માટે વૈકલ્પિક રીતે એક નવી પ્રોફાઇલ બનાવી શકો છો. <ph name="LEARN_MORE"/></translation>
<translation id="3665070894458449212">જ્યારે તમે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે આઇટમના સૂચનો મેળવવા માટે FlyWeb તમે જે ટાઇપ કરો છો, તે Google Driveને મોકલે છે. આ સુવિધા છૂપા મોડમાં બંધ હોય છે.</translation>
<translation id="7390382558747224642">આને બંધ કરવાથી, તમે Braveમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Braveની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="5714085538350759767">FlyWeb પ્રતિસાદ આપતું નથી. હવે ફરીથી લોંચ કરીએ?</translation>
<translation id="4035053306113201399">અપડેટ લાગુ કરવા માટે ChromeOSને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="3750729306035486751">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ પ્રકારની ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="1953553007165777902">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="MINUTE"/> મિનિટ બાકી છે</translation>
<translation id="6956650624767954726">FlyWeb ડિફૉલ્ટ બ્રાઉઝરને નિર્ધારિત અથવા સેટ કરી શકતું નથી</translation>
<translation id="6495079989036864983">આ, 1 આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, FlyWeb માં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2018879682492276940">ઇન્સ્ટૉલ કરવામાં નિષ્ફળ રહ્યાં. કૃપા કરીને ફરી પ્રયાસ કરો.</translation>
<translation id="4252651275570549255">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા અન્ય પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK"/>Braveમાં સાઇન ઇન કરો<ph name="END_LINK"/>.</translation>
<translation id="8544477465831682343">Braveની સેવાઓમાં વધુ મનગમતા બનાવેલા અનુભવો આપવા માટે, FlyWeb ઇતિહાસ શામેલ કરવો કે નહીં, તે પસંદ કરો</translation>
<translation id="8924891216494775926">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ ફાઇલ છેતરામણી છે અને તે તમારા ડિવાઇસમાં અનપેક્ષિત ફેરફારો કરે તેમ બની શકે છે</translation>
<translation id="1868972292925460871">FlyWeb તેના રૂટ પ્રમાણપત્રો કેવી રીતે મેનેજ કરે છે તે વિશેની માહિતી</translation>
<translation id="5846919427222391880">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}one{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}other{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}}</translation>
<translation id="2126108037660393668">ડાઉનલોડ કરેલી ફાઇલની ચકાસણી નિષ્ફળ થઈ.</translation>
<translation id="4474394796469499134">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ સાઇટ કોઈ સુરક્ષિત કનેક્શનનો ઉપયોગ કરી રહી નથી તેમજ ફાઇલ સાથે ચેડાં કરવામાં આવ્યા હોઈ શકે છે</translation>
<translation id="2482315227745493547">તમે FlyWeb મેનૂમાંથી બુકમાર્ક અને વાંચન મોડ જેવું બીજું ઘણું ખોલી શકો છો</translation>
<translation id="6765231735885996239">FlyWeb કસ્ટમાઇઝ કરો</translation>
<translation id="2174917724755363426">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ નથી. શું તમે ખરેખર રદ કરવા માગો છો?</translation>
<translation id="2937508664417729967">FlyWeb - નેટવર્ક સાઇન ઇન - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">અપડેટ ચેક કરવામાં ભૂલ: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="1475706760978948356">Braveમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="6707114110652917144">જોખમી સાઇટ. FlyWeb દ્વારા નોટિફિકેશન કાઢી નાખવામાં આવ્યા.</translation>
<translation id="5461117213064611992">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. FlyWeb દ્વારા <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>ની પરવાનગીઓ કાઢી નાખવામાં આવી</translation>
<translation id="2726680594710751908">જો તમે કમ્પ્યુટરને શેર કરો છો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી અને તેમને જોઇએ તેમ FlyWeb ને સેટ કરી શકે છે.</translation>
<translation id="5067150284614317159">URLsને Braveમાં સંગ્રહિત અસુરક્ષિત સાઇટની સૂચિ સાથે ચેક કરે છે. જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે FlyWeb પેજ કન્ટેન્ટના બિટની સાથોસાથ URLs પણ Safe Browsingને મોકલી શકે છે.</translation>
<translation id="3002925333439341552">જ્યારે ચાલુ હોય, ત્યારે FlyWeb પેજને પહેલેથી લોડ કરે છે, જે બ્રાઉઝ કરવાનું અને શોધવાનું વધુ ઝડપી બનાવે છે.</translation>
<translation id="3256927121768528350">અહીંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Braveમાં સાઇન ઇન કરો.</translation>
<translation id="2359808026110333948">આગળ વધો</translation>
<translation id="7339360994527471629">\"<ph name="EXTENSION_NAME"/>\" એક્સ્ટેન્શન ઇચ્છે છે કે તમે Braveમાં સાઇન ઇન કરો</translation>
<translation id="4126251160852694747"><ph name="USER_EMAIL_ADDRESS"/> તરીકે આ એક્સ્ટેન્શનનો ઉપયોગ કરવા માટે, Braveમાં સાઇન ઇન કરો.</translation>
<translation id="8418845734693287262">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે ChromeOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="4722826414103151470">{NUM_DEVICES,plural, =0{1 HID ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 HID ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# HID ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# HID ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="1364879203203742966">આ સાઇટ માટે Braveને કૅમેરા અને માઇક્રોફોનની પરવાનગીઓની જરૂર છે</translation>
<translation id="1968013196034892522"><ph name="BEGIN_LINK"/>Braveના ટૂલ<ph name="END_LINK"/> વડે, તમે સલામત રીતે બ્રાઉઝ કરી શકો છો તેમજ નિયંત્રણ જાળવી શકો છો</translation>
<translation id="2451727308784734061">Password Manager પર ઝડપથી જવા માટે તમારા શૉર્ટકટનો ઉપયોગ કરો. તમે તમારા શૉર્ટકટને તમારા કમ્પ્યુટરની હોમ સ્ક્રીન અથવા ઍપ લૉન્ચર પર ખસેડી શકો છો.</translation>
<translation id="3224379053610845181">FlyWeb ટૂંક સમયમાં જ બંધ થશે</translation>
<translation id="3840682988105604367">FlyWeb માં</translation>
<translation id="2485422356828889247">અનઇન્સ્ટૉલ કરો</translation>
<translation id="2513154137948333830">રીબૂટ કરવું આવશ્યક છે: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="6823116595279840454">FlyWeb વર્તમાન પાસવર્ડ બદલવાનો પ્રયાસ કરી રહ્યું છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="2691552788029831386">ફાઇલો ડાઉનલોડ કરવા માટે Braveને સ્ટોરેજના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="2275866327478859777">FlyWeb હેલ્પર</translation>
<translation id="683641781063074351">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Braveમાં સાઇન ઇન કરો</translation>
<translation id="7717615706977383025">આ પ્રોફાઇલના ઉપયોગ (જેમકે બુકમાર્ક, ઇતિહાસ, પાસવર્ડ બનાવવા અને અન્ય સેટિંગ ગોઠવવા) દરમિયાન જનરેટ થયેલા કોઈપણ FlyWeb ડેટાને ઑફિસની પ્રોફાઇલના વ્યવસ્થાપક કાઢી નાખી શકે છે. <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">Braveનો ઉપયોગ કરવાનું ચાલુ રાખો</translation>
<translation id="259935314519650377">ડાઉનલોડ કરેલા ઇન્સ્ટૉલરને કૅશ મેમરીમાં સાચવવામાં નિષ્ફળ રહ્યાં. ભૂલ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="6852129081045176385">FlyWeb વધુ ઝડપથી કામ કરે છે અને JavaScriptનો ઉપયોગ કરતી સુવિધાઓ ડિઝાઇન પ્રમાણે કામ કરવી જોઈએ (સુઝાવ આપવામાં આવે છે)</translation>
<translation id="3827993926722004004">ઇન્સ્ટૉલેશન દરમિયાન ઓપરેટિંગ સિસ્ટમ ભૂલ આવી. કૃપા કરીને ફરીથી FlyWeb ડાઉનલોડ કરો.</translation>
<translation id="333184635927514678">જો તમે ડિવાઇસ શેર કરતા હો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેઓ તેમને જોઈએ તે પ્રમાણે Braveનું સેટઅપ કરી શકે છે</translation>
<translation id="1661841342483968180">Braveમાં સ્વાગત છે, <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">FlyWeb ટૅબ</translation>
<translation id="2796283369875688710">ઉમેરેલી સુરક્ષા માટે, FlyWeb તમારા ડેટાને એન્ક્રિપ્ટ કરશે.</translation>
<translation id="1118215875395945816">Braveમાંથી તમારા FlyWeb એકાઉન્ટને કાઢી નાખવા માટે, સાઇન આઉટ કરો</translation>
<translation id="2738871930057338499">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 403 પ્રતિબંધિત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="2770231113462710648">ડિફૉલ્ટ બ્રાઉઝરને આના પર બદલો:</translation>
<translation id="7907238427168022751">આ એક્સ્ટેન્શન માલવેર ધરાવે છે અને તે અસુરક્ષિત છે. તેને Braveમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="2799223571221894425">ફરીથી લોંચ કરો</translation>
<translation id="8990114339313395142">આને લીધે <ph name="USER_EMAIL_ADDRESS"/> માટે નવી FlyWeb પ્રોફાઇલ બનશે</translation>
<translation id="2846251086934905009">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલર પૂર્ણ થયું નહીં. ઇન્સ્ટોલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="1339341044496643931">FlyWeb માંથી દૂર કરો...</translation>
<translation id="4922993584046885552">તમને FlyWeb પર સલામત રાખે છે અને જ્યારે તમે સાઇન ઇન થયા હો, ત્યારે Braveની અન્ય ઍપમાં તમારી સુરક્ષા બહેતર બનાવવામાં કદાચ ઉપયોગમાં લેવાઈ શકે છે</translation>
<translation id="2885378588091291677">કાર્ય વ્યવસ્થાપક</translation>
<translation id="3806033752149316261">&amp;FlyWeb વિશે</translation>
<translation id="2915996080311180594">પછીથી ફરી શરૂ કરો</translation>
<translation id="2928420929544864228">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ.</translation>
<translation id="2945997411976714835">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની પ્રક્રિયા શરૂ થવામાં નિષ્ફળ રહી.</translation>
<translation id="1661079783259785361">FlyWeb અપ ટૂ ડેટ છે</translation>
<translation id="5447533789927384736">જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે FlyWeb પેજ કન્ટેન્ટના બિટ સહિત URLs પણ Safe Browsingને મોકલી શકે છે</translation>
<translation id="1003068427103858026">તમારા બ્રાઉઝિંગ અનુભવને બહેતર બનાવવા અને સંસાધનોનો ઉપયોગ ઘટાડવા માટે, FlyWeb આ ટૅબને નિષ્ક્રિય કરી શકે છે.</translation>
<translation id="8404327407921790238">Braveમાં નવા ટૅબમાં <ph name="URL"/> ખોલો.</translation>
<translation id="1244955229468464260">FlyWeb તમારા પાસવર્ડ ચેક કરી શકતું નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="8841609317523323027">FlyWeb માં ઉમેરી રહ્યું છે...</translation>
<translation id="3038232873781883849">ઇન્સ્ટૉલ થવાની રાહ જોઈ રહ્યાં છીએ...</translation>
<translation id="4451837224464070850">અન્ય FlyWeb પ્રોફાઇલ</translation>
<translation id="7859502023458300952">ક્રૅશ રિપોર્ટ અને <ph name="UMA_LINK"/> Braveને મોકલીને FlyWeb ને વધુ સારું બનાવવામાં મદદ કરો.</translation>
<translation id="6508863982477776456">{NUM_DEVICES,plural, =0{1 USB ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 USB ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# USB ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# USB ડિવાઇસને એક કે વધુ FlyWeb એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="4133194854947529871">તમારો બ્રાઉઝિંગ ઇતિહાસ તમે જુઓ છો તે જાહેરાતોને અને નીચે જણાવેલી અનુમાનિત રુચિઓને અસર કરે છે. તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે FlyWeb નવા વિષયો આવતા જાય, તેના આધારે દર મહિને તમારી રુચિના વિષયોને ઑટોમૅટિક રીતે ડિલીટ કરે છે. જો તમે રુચિઓને કાઢી ન નાખો, તો તે રિફ્રેશ થઈ શકે છે.</translation>
<translation id="1407857531570256859">ઇન્સ્ટૉલર આર્કાઇવને અનકોમ્પ્રેસ કરવામાં નિષ્ફળ. કૃપા કરીને FlyWeb ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="1309738977648134943">FlyWeb તમારા માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="2251813826843049011">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યું છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, Braveને તેને નિષ્ક્રિય કરવા દો.</translation>
<translation id="6274649779206195384">FlyWeb ને ફરીથી લોંચ કરો</translation>
<translation id="6773570808762718524">તમારી નવી FlyWeb પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="2700572810650522793">ઓહ! FlyWeb ક્રેશ થઈ ગયું. હમણાં ફરીથી લોંચ કરીએ?</translation>
<translation id="5958835776851191812">Braveમાંથી તમારા FlyWeb એકાઉન્ટને કાઢી નાખવા માટે, સેટિંગ પેજમાં જઈને Braveમાંથી સાઇન આઉટ કરો</translation>
<translation id="5449297306961970452">FlyWeb એની ડેટા ડિરેક્ટરી વાંચી અથવા લખી શકતુંં નથી:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="7452618639149696924">V8 એ Braveનું JavaScript અને WebAssembly એન્જિન છે જેનો ઉપયોગ સાઇટનું પર્ફોર્મન્સ બહેતર બનાવવા માટે થાય છે</translation>
<translation id="6755586344927335130">Braveનું <ph name="PRODUCT_VERSION"/> વર્ઝન ઇન્સ્ટૉલ કરવામાં આવેલું છે</translation>
<translation id="3286538390144397061">હવે ફરીથી પ્રારંભ કરો</translation>
<translation id="3900612994249740104">FlyWeb API કીઝ ખૂટે છે. FlyWeb ની કેટલીક કાર્યક્ષમતા અક્ષમ થશે.</translation>
<translation id="6824575001009586492">જ્યારે FlyWeb બંધ થાય ત્યારે બૅકગ્રાઉન્ડ ઍપ ચલાવવાનું ચાલુ રાખો</translation>
<translation id="8400063458073122271">અમે એકાઉન્ટના ઍક્સેસનું સેટઅપ કરી રહ્યાં હોય, ત્યારે પણ તમે Braveનો ઉપયોગ કરી શકો છો. સેટઅપની પ્રક્રિયા પૂર્ણ થાય નહીં ત્યાં સુધી તમે અમુક સંસાધનો ઍક્સેસ કરી શકો નહીં એમ બની શકે છે.</translation>
<translation id="2595215790271940091">અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને કોઈપણ સાઇટ લોડ કરતા પહેલાં FlyWeb તમને ચેતવણી આપશે</translation>
<translation id="3701353923785984059">જ્યારે તમે બધી FlyWeb વિન્ડો બંધ કરશો, ત્યારે તમને મોટાભાગની સાઇટમાંથી સાઇન આઉટ કરવામાં આવશે, સિવાય કે જો તમે Braveમાં સાઇન ઇન કરેલું હોય, તો તમારા FlyWeb એકાઉન્ટમાંથી સાઇન આઉટ કરવામાં આવશે નહીં. સાઇટને તમને યાદ રાખવાની મંજૂરી આપવા માટે, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="5399208721646088502">આ એકાઉન્ટ સાથેની FlyWeb પ્રોફાઇલ પહેલેથી અસ્તિત્વમાં છે</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="7978410129406361692">વર્તમાન FlyWeb પ્રોફાઇલ પર સ્વિચ કરીએ?</translation>
<translation id="3412460710772753638">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="847273641988291714">FlyWeb પ્રોફાઇલ વડે તમે તમારી બધી વસ્તુઓ FlyWeb પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="1558345997029205345">જ્યારે તમે ચેડાં કરવામાં આવેલા પાસવર્ડ વડે સાઇન ઇન કરશો ત્યારે FlyWeb તમને સૂચિત કરશે</translation>
<translation id="956833467923764542">આ, <ph name="ITEMS_COUNT"/> આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, FlyWeb માં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="4772642827282964272"><ph name="SHORTCUT"/> વડે એક FlyWeb પ્રોફાઇલથી બીજી FlyWeb પ્રોફાઇલ પર સ્વિચ કરી શકાય છે</translation>
<translation id="6724485219247982027">કૃપા કરીને બધી FlyWeb વિંડોઝ બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="1582211253241551883"><ph name="EXISTING_USER"/> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે.  તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Braveમાં <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="763231524941489073">તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે, અમે 4 અઠવાડિયા કરતાં જૂની હોય એવી તમારી રુચિઓને ઑટોમૅટિક રીતે ડિલીટ કરીએ છીએ. તમે જેમ જેમ બ્રાઉઝ કરતા રહો છો, તેમ તેમ તમારી રુચિનો વિષય ફરી સૂચિમાં દેખાઈ શકે છે. અથવા તમે તમારી રુચિના એવા વિષયો કાઢી નાખી શકો છો કે જેમને તમે Braveની સૂચિમાં શામેલ કરવા માગતા નથી.</translation>
<translation id="4856314253538330936">તમારો બ્રાઉઝિંગ ઇતિહાસ કે જેમાં આ ડિવાઇસ પર તમે FlyWeb વડે મુલાકાત લીધેલી સાઇટનો રેકોર્ડ હોય છે.</translation>
<translation id="3597003331831379823">વધારેલા વિશેષાધિકારો સાથે સેટઅપ ચલાવવામાં નિષ્ફળ રહ્યાં. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="7465608402296261674"><ph name="ORIGIN"/>માંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Braveમાં સાઇન ઇન કરો.</translation>
<translation id="3667616615096815454">ઇન્સ્ટૉલ કરી શકતા નથી, સર્વર માટે આ ઍપ્લિકેશન અજાણી છે.</translation>
<translation id="1483758453057146021">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમની પસંદગીઓમાં FlyWeb માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="1543563097158722437">FlyWeb તમારા પાસવર્ડ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="190360428475385352">Braveમાં રુચિ મુજબ જાહેરાત વિશે વધુ જાણો</translation>
<translation id="6611602069520888180">નવા FlyWeb &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="2591356225047803326">મનગમતું બનાવવા અને અન્ય હેતુઓ માટે, FlyWeb અને Braveની અન્ય સેવાઓ લિંક કરો</translation>
<translation id="1771882170639856394">FlyWeb પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="3782148374606932577">શા માટે FlyWeb અમુક ડાઉનલોડ કરેલી ફાઇલને બ્લૉક કરે છે તે જાણો</translation>
<translation id="4640643918757362950">જો કંઈપણ માટે તમારા રિવ્યૂની જરૂર હોય, તો FlyWeb તમને જણાવશે</translation>
<translation id="2179738813053854729">તમે જે પેજની મુલાકાત લેવાની શક્યતા વધુ હોય, FlyWeb તેને પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થઈ શકે</translation>
<translation id="2401189691232800402">ChromeOS સિસ્ટમ</translation>
<translation id="8979989643967423454"><ph name="PAGE_TITLE"/> - FlyWeb</translation>
<translation id="3744202345691150878">ChromeOS વડે સહાય મેળવો</translation>
<translation id="1864899808802540927"><ph name="ACCOUNT_EMAIL"/>માંથી તમારા FlyWeb બ્રાઉઝરની વસ્તુઓ મેળવો</translation>
<translation id="5175060854726708547">Braveને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. તમારે ક્યાંક ધ્યાન આપવાની જરૂર છે - વિગતો માટે ક્લિક કરો.</translation>
<translation id="606156353708638647">FlyWeb ને ખોલવા માટે તમારા નામને ક્લિક કરો અને બ્રાઉઝ કરવાનું પ્રારંભ કરો.</translation>
<translation id="5145107420478372433"><ph name="EXISTING_USER"/> આ FlyWeb પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, FlyWeb તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="3470813199863172076">આ એક્સ્ટેન્શન FlyWeb વેબ સ્ટોર પૉલિસીનું ઉલ્લંઘન કરે છે અને તે અસુરક્ષિત હોઈ શકે છે. તેને Braveમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="3376157109651222096"><ph name="MANAGER_NAME"/> દ્વારા તમારું એકાઉન્ટ મેનેજ કરવામાં આવે છે. તમારા ઍડમિનિસ્ટ્રેટર આ FlyWeb બ્રાઉઝરની પ્રોફાઇલ અને બુકમાર્ક, ઇતિહાસ તથા પાસવર્ડ જેવો તેનો ડેટા જોઈ શકે છે અને તેમાં ફેરફાર કરી શકે છે.</translation>
<translation id="3941890832296813527">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની ફાઇલનું નામ અમાન્ય અથવા અનસપોર્ટેડ છે.</translation>
<translation id="8536259619256229278">FlyWeb પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="3849784651193576458">Braveની તમને સલામત રાખવાની રીત વિશે જાણો</translation>
<translation id="5667414856761616811">FlyWeb for Testing વિશે</translation>
<translation id="1152920704813762236">ChromeOS વિશે</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_LINUX_OSS"/>Linux ડેવલપમેન્ટ એન્વાયરમેન્ટ<ph name="END_LINK_LINUX_OSS"/>ની જેમ, ChromeOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS"/>ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS"/> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="504994999924593940"><ph name="BEGIN_LINK"/>વર્તમાન સેટિંગ<ph name="END_LINK"/>ની જાણ કરીને Braveને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="4050175100176540509">નવીનતમ વર્ઝનમાં મહત્ત્વપૂર્ણ સુરક્ષા સુધારણાઓ અને નવી સુવિધાઓ ઉપલબ્ધ છે.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="7916861696409201118">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}one{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}other{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}}</translation>
<translation id="2832552148674305108">FlyWeb છૂપો મોડ</translation>
<translation id="4105099155797156500">FlyWeb વિશે પેજ પર જાઓ</translation>
<translation id="4148957013307229264">ઇન્સ્ટોલ કરી રહ્યું છે...</translation>
<translation id="815587935943511961">તમારી સંસ્થા તમારી ઑફિસની પ્રોફાઇલમાં બ્રાઉઝિંગ ડેટા જોઈ અને મેનેજ કરી શકે છે, જેમ કે તમારા બુકમાર્ક, ઇતિહાસ અને પાસવર્ડ. તે વ્યક્તિગત FlyWeb પ્રોફાઇલમાં બ્રાઉઝિંગ ડેટા જોઈ શકતી નથી.</translation>
<translation id="4890947375650921286"><ph name="PAGE_TITLE"/> - નેટવર્ક સાઇન ઇન - FlyWeb</translation>
<translation id="4007949387571083162">FlyWeb માટે શ્રેષ્ઠ એપ્લીકેશન્સ, રમતો, એક્સટેન્શન્સ અને થીમ્સ શોધો.</translation>
<translation id="1595210458721188387">આ ભાષાનો ઉપયોગ FlyWeb UI પ્રદર્શિત કરવા માટે થાય છે</translation>
<translation id="4222932583846282852">રદ કરી રહ્યાં છીએ…</translation>
<translation id="4224210481850767180">ઇન્સ્ટૉલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="2564888740660198776">તમારા FlyWeb ડેટાને આ એકાઉન્ટ સાથે લિંક કરીએ?</translation>
<translation id="7337819873931851298">સાઇટ પરથી માનક સંરક્ષણ કરતા વધુ ડેટા વિશ્લેષિત કરીને, Braveને પણ પહેલાંથી જાણ ન હોય તેવી ખતરનાક સાઇટ વિશે તમને ચેતવણી આપે છે. તમે FlyWeb ચેતવણીઓને છોડી દેવાનું પસંદ કરી શકો છો.</translation>
<translation id="8391959103619318249">Braveમાંથી સાઇન આઉટ કરો</translation>
<translation id="8514458758262040082">FlyWeb સાથે સહાય મેળવો</translation>
<translation id="4281844954008187215">સેવાની શરતો</translation>
<translation id="3393587701694585022">અમઉલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ થયું. જો FlyWeb હાલમાં ચાલી રહ્યું હોય, તો તેને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="4304713468139749426">પાસવર્ડ મેનેજર</translation>
<translation id="4334294535648607276">ડાઉનલોડ પૂર્ણ.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> માટે જરૂરી છે કે તમે આ ડિવાઇસનો ઉપયોગ કરતા પહેલાં નીચે આપેલી સેવાની શરતો વાંચો અને તેને સ્વીકારો. આ શરતો ChromeOSની શરતોમાં વધારો કરતી નથી, તેમાં ફેરફાર કરતી નથી અથવા તેને મર્યાદિત કરતી નથી.</translation>
<translation id="1376968889000878095">છતાં પણ Braveમાંથી બહાર નિકળવું છે?</translation>
<translation id="6360389033094512399">Braveને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="7865671235132080316">{NUM_EXTENSIONS,plural, =1{FlyWeb તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/>}one{FlyWeb તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/>}other{FlyWeb તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/>}}</translation>
<translation id="4166347503469830337">FlyWeb ને કસ્ટમાઇઝ અને નિયંત્રિત કરો</translation>
<translation id="4427306783828095590">વધારેલી સુરક્ષા ફિશિંગ અને માલવેરને બ્લૉક કરવામાં વધુ સહાયરૂપ થાય છે</translation>
<translation id="4434353761996769206">ઇન્સ્ટૉલરની ભૂલ <ph name="INSTALLER_ERROR"/></translation>
<translation id="8791209382165811772">FlyWeb for Testing વિશે</translation>
<translation id="4501471624619070934">ઇન્સ્ટૉલેશન નિષ્ફળ ગયું કારણ કે આ દેશમાં ઍક્સેસ પ્રતિબંધિત છે.</translation>
<translation id="3546782282376530369">આ એક્સ્ટેન્શન દ્વારા તેની ડેટા એકત્રિત કરવાની અને તેનો ઉપયોગ કરવાની રીત જેવી પ્રાઇવસી પ્રૅક્ટિસ પબ્લિશ કરવામાં આવી નથી. FlyWeb તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે.</translation>
<translation id="834808339160590901">FlyWeb પર આપનું સ્વાગત છે; નવી બ્રાઉઝર વિન્ડો ખોલી છે</translation>
<translation id="5094033276783634414">તમારી આસપાસના વિસ્તારો અને તમારા હાથને ટ્રૅક કરવા માટે, Braveને પરવાનગીની જરૂર છે</translation>
<translation id="3363095592946520579">તમે પહેલેથી Braveની અન્ય પ્રોફાઇલમાં <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="1304885695888649052">કંઈક ખોટુ થયું હોવાને કારણે FlyWeb અપડેટ થયું નથી. <ph name="BEGIN_LINK"/>FlyWeb અપડેટ કરવામાં આવતી સમસ્યાઓ અને નિષ્ફળ થયેલા અપડેટ સુધારો.<ph name="END_LINK"/></translation>
<translation id="5889581962474103319">તમારો બ્રાઉઝિંગ અનુભવ બહેતર બનાવવા અને જે-તે બાબતની ઝડપ જાળવી રાખવા માટે FlyWeb આ ટૅબને નિષ્ક્રિય કરી શકે છે.</translation>
<translation id="7350427799239500204">નવી FlyWeb પ્રોફાઇલમાં બ્રાઉઝિંગ ચાલુ રાખીએ?</translation>
<translation id="4567424176335768812">તમે <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન છો. હવે તમે તમારા બધા સાઇન ઇન કરેલા ડિવાઇસ પર તમારા બુકમાર્ક, ઇતિહાસ અને અન્ય સેટિંગને ઍક્સેસ કરી શકો છો.</translation>
<translation id="5891777644455025808">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે તમે Safe Browsingની સુવિધા બંધ કરેલી છે અને ફાઇલની ચકાસણી કરી શકાતી નથી</translation>
<translation id="4594305310729380060">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="6046424510733540251">FlyWeb ઍપ્લિકેશનો</translation>
<translation id="4970880042055371251">ChromeOSનું વર્ઝન</translation>
<translation id="8084731767622512023">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમની પસંદગીઓમાં FlyWeb માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="1936188352112244665">અપ ટૂ ડેટ થવામાં છે! અપડેટ સમાપ્ત કરવા માટે FlyWeb ને ફરીથી લોંચ કરો.</translation>
<translation id="2962574118577609024">જો તમે Braveના વપરાશના રિપોર્ટ પણ શેર કરતા હો, તો તે રિપોર્ટમાં તમે મુલાકાત લો છો તે URLs શામેલ હોય છે</translation>
<translation id="9219132550163437762">બીજા કમ્પ્યુટર (<ph name="HOST_NAME"/>) પર પ્રોફાઇલ બીજી FlyWeb પ્રક્રિયા (<ph name="PROCESS_ID"/>) દ્વારા ઉપયોગમાં હોય એવું લાગે છે. FlyWeb એ પ્રોફાઇલને લૉક કરી છે જેથી તે દૂષિત ન થઈ જાય. જો તમને ખાતરી છે કે કોઈ અન્ય પ્રક્રિયાઓ આ પ્રોફાઇલનો ઉપયોગ કરી રહી નથી, તો તમે પ્રોફાઇલને અનલૉક કરી અને FlyWeb ને ફરીથી લોંચ કરી શકો છો.</translation>
<translation id="4680828127924988555">ઇન્સ્ટૉલેશનની પ્રક્રિયા રદ કરો</translation>
<translation id="6156840135417578237">Braveનો તમારો અમુક ડેટા હજી સુધી તમારા FlyWeb એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ડિલીટ કરવામાં આવશે.</translation>
<translation id="1474749355173247622">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે Braveમાં તમારા FlyWeb એકાઉન્ટમાંથી તમારા પાસવર્ડ અને વધુનો ઉપયોગ કરી શકો છો. <ph name="SHORTCUT"/> તમારા Braveની સેવાઓના સેટિંગ બદલી શકે છે.</translation>
<translation id="5227023869666757348">કોઈએ આ કોમ્પ્યુટર પર પહેલા <ph name="ACCOUNT_EMAIL_LAST"/> તરીકે Braveમાં સાઇન ઇન કર્યું છે. તમારી માહિતી અલગ રાખવા માટે કૃપા કરીને નવો FlyWeb વપરાશકર્તા બનાવો.</translation>
<translation id="4724676981607797757">અનસપોર્ટેડ પ્રોટોકૉલ ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="1671154647029930623">છતાં પણ FlyWeb બંધ કરવું છે?</translation>
<translation id="4143239505982500022">FlyWeb માટેનું એક વિશિષ્ટ સુરક્ષા અપડેટ હમણાં જ લાગુ કરવામાં આવ્યું. હવે ફરી શરૂ કરો અને અમે તમારાં ટૅબની પુનઃસ્થાપના કરીશું.</translation>
<translation id="1347247057384060764">તમે FlyWeb સેટિંગમાં જઈને કોઈપણ સમયે તમારો નિર્ણય બદલી શકો છો. જાહેરાતો આપવાની વર્તમાન રીતની સાથેસાથે અજમાયશો ચાલે છે, તેથી તમને ફેરફારો તરત જ દેખાશે નહીં.</translation>
<translation id="4259200560913816786">FlyWeb તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરજો અથવા <ph name="BEGIN_LINK"/>તમારા FlyWeb એકાઉન્ટમાં પાસવર્ડ ચેક કરો<ph name="END_LINK"/>.</translation>
<translation id="3469649164996417993">આ પણ FlyWeb Searchમાં જે જોડણી તપાસનારનો ઉપયોગ થાય છે તેનો જ ઉપયોગ કરે છે. તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Braveને મોકલવામાં આવે છે. તમે સેટિંગમાં આ વર્તણૂકને હંમેશાં બદલી શકો છો.</translation>
<translation id="7460496601839821581">એકાઉન્ટ વગર Braveનો ઉપયોગ કરો</translation>
<translation id="2991144524835127379">mDNS ટ્રાફિકને મંજૂરી આપવા FlyWeb માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="6208903184719035736">&amp;FlyWeb અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="9083381064635607718">Braveની ભાવિ અપડેટ મેળવવા માટે, તમારે macOS 11 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યૂટર macOS 10.15નો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="7174589544844983914">FlyWeb બૅકગ્રાઉન્ડ મોડમાં છે.</translation>
<translation id="9212977598552218412">Braveમાં સાઇન ઇન કરવાનો સંવાદ બંધ કરવા માટે ક્લિક કરો</translation>
<translation id="7792628702371319769">અતિથિઓ કંઈપણ પાછળ છોડ્યાં વિના FlyWeb નો ઉપયોગ કરી શકે છે.</translation>
<translation id="2760069255902967585">સ્વયંને FlyWeb માં ઉમેરો</translation>
<translation id="4239638419916712076">FlyWeb એવી નવી સુવિધાઓની શોધખોળ કરી રહ્યું છે કે જેના વડે સાઇટ તમારી ઓછી માહિતીનો ઉપયોગ કરીને બ્રાઉઝિંગનો એવો જ અનુભવ પ્રદાન કરી શકે</translation>
<translation id="4326845160190496236">FlyWeb એકાઉન્ટને પુન:પ્રમાણીકરણની જરૂર છે</translation>
<translation id="387444474697464273">કોઈ સાચવેલા પાસવર્ડ નથી. જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે FlyWeb તેને ચેક કરી શકે છે.</translation>
<translation id="291933003154435191">Braveમાંથી સાઇન આઉટ કરો</translation>
<translation id="520701392326482190"><ph name="EXISTING_USER"/> આ FlyWeb પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. આને લીધે <ph name="USER_EMAIL_ADDRESS"/> માટે નવી FlyWeb પ્રોફાઇલ બનશે</translation>
<translation id="8295539942024823191">તમારા ફેરફારો લાગુ કરવા માટે, Braveને ફરી લૉન્ચ કરો</translation>
<translation id="611606920944085547">છૂપા મોડમાં બ્રાઉઝ કરતી વખતે, અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને સાઇટ લોડ કરતા પહેલાં FlyWeb તમને ચેતવણી આપશે</translation>
<translation id="5374328929709976901">જ્યારે અજમાયશો ચાલુ હોય અને જો FlyWeb કોઈ સક્રિય અજમાયશમાં કોઈપણ ક્રમમાં તમારી ગોઠવણ કરી લે, તો તમારો બ્રાઉઝિંગ ઇતિહાસ તમને દેખાતી જાહેરાતો અને નીચે જણાવેલી અનુમાનિત રુચિઓને અસર કરે છે. તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે FlyWeb નવા વિષયો આવતા જાય, તેના આધારે દર મહિને તમારી રુચિના વિષયોને ડિલીટ કરે છે.</translation>
<translation id="1392114650763912227">Braveમાં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો</translation>
<translation id="6178233095056047786">Braveને તમારા રિવ્યૂ માટે કેટલાક સલામતી સંબંધિત સુઝાવો મળ્યા છે</translation>
<translation id="8980390875915032396">અન્ય FlyWeb પ્રોફાઇલ</translation>
<translation id="8449603408481238073">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી FlyWeb પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો FlyWeb ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME"/>થી જોડાયેલા રહેશે. તમે FlyWeb એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">વધારાનો કોડ: <ph name="EXTRA_CODE"/>.</translation>
<translation id="7210984238645376121">મનગમતું બનાવવાની સુવિધા મેળવવા માટે, Braveમાં વેબ અને ઍપ ઍક્ટિવિટી ઉમેરો</translation>
<translation id="1026219128963768190">FlyWeb શા માટે અમુક ફાઇલો બ્લૉક કરે છે, તે જાણો</translation>
<translation id="1284798564810038820">FlyWeb અપડેટ થઈ રહ્યું છે (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="3872448231555118416">Braveમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="1827750898515917134">FlyWeb માંથી દૂર કરો</translation>
<translation id="5020755920249060562">FlyWeb ને તમારા ડિફોલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="3148325800171225029"><ph name="PAGE_TITLE"/> - FlyWeb બીટા</translation>
<translation id="5385202369020319636">આ Linux વિતરણ સિસ્ટમ પર FlyWeb હવે સપોર્ટ કરતું ન હોવાથી કદાચ તે યોગ્ય રીતે કાર્ય ન કરે</translation>
<translation id="362367838300880777">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આ ફાઇલ તમારા વ્યક્તિગત અને સોશિયલ નેટવર્ક એકાઉન્ટને નુકસાન પહોંચાડી શકે છે</translation>
<translation id="5957333939864770801">Braveને આ સાઇટ સાથે તમારું સ્થાન શેર કરવા માટે તમારા સ્થાનના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="780999790006298623">તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે, અમે 4 અઠવાડિયા કરતાં જૂની હોય એવી તમારી રુચિઓને ઑટોમૅટિક રીતે ડિલીટ કરીએ છીએ. તમે જેમ જેમ બ્રાઉઝ કરતા રહો છો, તેમ તેમ તમારી રુચિનો વિષય ફરી સૂચિમાં દેખાઈ શકે છે. અને જો તમને લાગે કે FlyWeb દ્વારા પસંદ કરાયેલો તમારી રુચિનો વિષય ખોટો છે અથવા તમે અમુક ચોક્કસ પ્રકારની જાહેરાતો જોવા માગતા ન હો, તો તમે તે રુચિ કાઢી નાખી શકો છો.</translation>
<translation id="2183749398075655200">કૃપા કરીને FlyWeb, નવીનતમ સિસ્ટમ અપડેટ્સ ઇન્સ્ટોલ કરે ત્યાં સુધી રાહ જુઓ.</translation>
<translation id="8996657165865563765">FlyWeb પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="5738298079259740925">Braveમાં PDFs ખોલો</translation>
<translation id="6096945112863785306">{0,plural, =0{FlyWeb અપડેટ ઉપલબ્ધ છે}=1{FlyWeb અપડેટ ઉપલબ્ધ છે}one{FlyWeb અપડેટ # દિવસ માટે ઉપલબ્ધ છે}other{FlyWeb અપડેટ # દિવસ માટે ઉપલબ્ધ છે}}</translation>
<translation id="7698117871740446964">જ્યારે તમે FlyWeb બંધ કરો, ત્યારે હંમેશાં તમારા ડિવાઇસમાંથી સાઇટનો ડેટા ડિલીટ કરો</translation>
<translation id="5666891644992637849">કૃપા કરીને હવે FlyWeb ફરી શરૂ કરો</translation>
<translation id="2081080188998199150">FlyWeb LLC</translation>
<translation id="4985093807982416118">આ ભાષામાં FlyWeb બતાવો</translation>
<translation id="569897634095159764">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. પ્રૉક્સી સર્વરને પ્રમાણીકરણની જરૂર છે.</translation>
<translation id="3833333172002764160">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. FlyWeb દ્વારા <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>ની પરવાનગીઓ કાઢી નાખવામાં આવી</translation>
<translation id="4985665094509307744">Braveને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. Braveને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો.</translation>
<translation id="5809516625706423866">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 401 અનધિકૃત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="8331941171144629807">FlyWeb માં સ્વાગત છે</translation>
<translation id="7581082856615467651">Braveને આ આઇટમમાં માલવેર હોવાનું જાણવા મળ્યું છે:</translation>
<translation id="8117102597407263352">FlyWeb નિયમિત રીતે ચેક કરીને એ વાતની ખાતરી કરતું રહે છે કે તમારા બ્રાઉઝરના સેટિંગ સૌથી સલામત છે. જો કોઈ બાબતનો રિવ્યૂ કરવો જરૂરી હશે તો અમે તમને તેની જાણ કરીશું.</translation>
<translation id="5895138241574237353">પુનઃપ્રારંભ કરો</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - નેટવર્ક સાઇન ઇન</translation>
<translation id="5924017743176219022">ઇન્ટરનેટ સાથે કનેક્ટ કરી રહ્યાં છીએ...</translation>
<translation id="5383748137832083777">તમારો બ્રાઉઝિંગ અનુભવ બહેતર બનાવવા અને સંસાધનોનો ઉપયોગ ઘટાડવા માટે FlyWeb આ ટૅબને નિષ્ક્રિય કરી શકે છે.</translation>
<translation id="5941711191222866238">નાનું કરો</translation>
<translation id="483902194277448471">જો FlyWeb કોઈ સક્રિય અજમાયશમાં કોઈપણ ક્રમમાં તમારી ગોઠવણ કરી લે, તો તમારો બ્રાઉઝિંગ ઇતિહાસ તમને દેખાતી જાહેરાતો અને નીચે જણાવેલી અનુમાનિત રુચિઓને અસર કરે છે. તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે FlyWeb નવા વિષયો આવતા જાય, તેના આધારે દર મહિને તમારી રુચિના વિષયોને ડિલીટ કરે છે. જો તમે રુચિઓને કાઢી ન નાખો, તો તે રિફ્રેશ થાય છે.</translation>
<translation id="348384176991400026">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}one{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}other{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}}</translation>
<translation id="4955869506208896934">સમન્વયનને પ્રારંભ કરવા માટે FlyWeb ને અપડેટ કરો</translation>
<translation id="63409513082302419">તમારા અનુભવને મનગમતો બનાવવા માટે તમે જે સાઇટની મુલાકાત લો છો તે બધી સાઇટ તમને જેમાં રુચિ હોય એવી તમામ વસ્તુઓ યાદ રાખી લે તે સામાન્ય બાબત છે. સાઇટ, FlyWeb પર તમારી રુચિના વિષયો વિશેની માહિતી પણ સ્ટોર કરી શકે છે.</translation>
<translation id="6003112304606738118">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="HOURS"/> કલાક બાકી છે</translation>
<translation id="6888926086743577946">સૌથી ઉપર જમણી બાજુએ FlyWeb મેનૂમાંથી તમે બુકમાર્ક અને વાંચન મોડ જેવું બીજું ઘણું ખોલી શકો છો</translation>
<translation id="6040143037577758943">બંધ કરો</translation>
<translation id="619330138913595431">તમારા ડેટાને સુરક્ષિત કરવા માટે, Braveને તમે તાજેતરમાં મુલાકાત લીધી ન હોય તેવી સાઇટમાંથી પરવાનગીઓ દૂર કરવા દો. નોટિફિકેશન બંધ કરવામાં આવશે નહીં.</translation>
<translation id="8714139918792771260">અને Braveમાં ખોલો</translation>
<translation id="499541338626558192"><ph name="EXTENSION_NAME"/>ને Braveમાં ઉમેરવામાં આવ્યું છે</translation>
<translation id="3890023823480067024">Braveને વધુ ઝડપી બનાવો</translation>
<translation id="608006075545470555">આ બ્રાઉઝરમાં ઑફિસની પ્રોફાઇલ ઉમેરો</translation>
<translation id="5880307616068888895">Braveને કસ્ટમાઇઝ અને નિયંત્રિત કરો. અપડેટ ઉપલબ્ધ છે.</translation>
<translation id="8890528681896757647">જ્યારે ચાલુ હોય ત્યારે FlyWeb, સ્મૂધ સ્ક્રોલિંગ અને વીડિયોના ફ્રેમ રેટ જેવી બૅકગ્રાઉન્ડની પ્રવૃત્તિ અને વિઝ્યુઅલ ઇફેક્ટને મર્યાદિત કરીને બૅટરી પાવર બચાવે છે.</translation>
<translation id="1429530657225981960">ચાલુ • આ એક્સ્ટેન્શન ક્યાંથી આવે છે તેની ચકાસણી FlyWeb કરી શકતું નથી</translation>
<translation id="1683225514126450592">Braveના ટૂલબારમાં ઍક્સેસની વિનંતીઓ બતાવવા માટે એક્સ્ટેન્શનને મંજૂરી આપો</translation>
<translation id="5171527334826689262">FlyWeb આ પાસવર્ડ તમારા FlyWeb એકાઉન્ટમાં સાચવશે. તમારે તેને યાદ રાખવો જરૂરી નથી.</translation>
<translation id="4809579265564854985"><ph name="FILE_NAME"/> જોખમી છે, તેથી FlyWeb એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="1773252983747911987">FlyWeb ટૂંક સમયમાં જ બંધ થશે અને ડેટા ડિલીટ કરશે</translation>
<translation id="3063780243670578104">Safe Browsingની સુવિધા બંધ છે. FlyWeb તેને ચાલુ રાખવાનો સુઝાવ આપે છે.</translation>
<translation id="1686760912855738719">તમે અહીં એક FlyWeb પ્રોફાઇલથી બીજી FlyWeb પ્રોફાઇલ પર સ્વિચ કરી શકો છો</translation>
<translation id="5461795497268691356">જો તમે કુકીને મંજૂરી આપો, તો FlyWeb પહેલેથી લોડ કરતી વખતે તેનો ઉપયોગ કરી શકે છે</translation>
<translation id="7031783851441272920">આ ફાઇલ જોખમી હોઈ શકે છે<ph name="LINE_BREAK"/>જો તમે પાસવર્ડ પ્રદાન કરો છો, તો FlyWeb તમારા માટે આ ડાઉનલોડને તપાસી શકે છે. ફાઇલ વિશેની માહિતી Google Safe Browsingને મોકલવામાં આવે છે, પરંતુ ફાઇલનું કન્ટેન્ટ અને પાસવર્ડ તમારા ડિવાઇસમાં જ રહે છે.</translation>
<translation id="6182736845697986886">કોઈ અપડેટ સર્વરની આંતરિક ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="4403968929742079769">ખાતરી કરો કે તમે તમારા <ph name="TARGET_DEVICE_NAME"/> પર Braveમાં સાઇન ઇન કર્યું છે અને પછી ફરીથી મોકલવાનો પ્રયાસ કરો.</translation>
<translation id="1855179706668101462">આ કમ્પ્યુટર પર પહેલાંથી જ Braveનું સૌથી તાજેતરનું વર્ઝન છે. જો સૉફ્ટવેર કાર્ય કરી રહ્યું નથી, તો કૃપા કરીને Braveને અનઇન્સ્ટૉલ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="651290634887454330">{0,plural, =0{FlyWeb હમણાં ફરીથી લૉન્ચ થશે}=1{FlyWeb 1 સેકન્ડમાં ફરીથી લૉન્ચ થશે}one{FlyWeb # સેકન્ડમાં ફરીથી લૉન્ચ થશે}other{FlyWeb # સેકન્ડમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="2586408713760853791">ફાઇલો ડાઉનલોડ કરવા માટે, Braveને સ્ટોરેજના ઍક્સેસની પરવાનગીની જરૂર છે</translation>
<translation id="1603558835003845196">URLsને Braveમાં સ્ટોર કરેલી અસુરક્ષિત સાઇટની સૂચિ સાથે સરખાવીને ચેક કરે છે</translation>
<translation id="5751080530525677552">FlyWeb ને ડિફોલ્ટ બ્રાઉઝર બનાવો</translation>
<translation id="4804111781678641302">FlyWeb અપડેટ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="3542157007113577464">Braveમાંથી સાઇન આઉટ કરીએ?</translation>
<translation id="2166321493116256664">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યાં છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, Braveને તેમને નિષ્ક્રિય કરવા દો.</translation>
<translation id="3794967601634523398">તમારી FlyWeb પ્રોફાઇલને કસ્ટમાઇઝ કરો</translation>
<translation id="6475001900959697061">તમારી FlyWeb પ્રોફાઇલને નામ આપો</translation>
<translation id="6356094940346377065">કોઈ એક્સ્ટેન્શન ઇચ્છે છે કે તમે Braveમાં સાઇન ઇન કરો</translation>
<translation id="4465156155012748592"><ph name="FILE_NAME"/> જોખમી હોઈ શકે છે, તેથી FlyWeb એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="5523868569707953059">FlyWeb તમારા કૅમેરાનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="6327105987658262776">કોઈ અપડેટ ઉપલબ્ધ નથી.</translation>
<translation id="8226838065217375546">FlyWeb પર બીજી ક્રિયા ચાલુ છે. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો.</translation>
<translation id="6063700568539132984">હવે તમારા FlyWeb એકાઉન્ટ સાથે અને શેર કરેલ કમ્પ્યુટર પર FlyWeb નો ઉપયોગ કરવો વધુ સરળ છે.</translation>
<translation id="2451285993204064190">તમારા બ્રાઉઝિંગ અનુભવને બહેતર બનાવવા અને વસ્તુઓને ઝડપી રાખવા માટે, FlyWeb આ ટૅબને નિષ્ક્રિય કરી શકે છે.</translation>
<translation id="4709797814274745581">FlyWeb શૉર્ટકટ</translation>
<translation id="6595693843242836271">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="6890209090736444656">શું તમે ખરેખર તમે FlyWeb ને અનઇન્સ્ટૉલ કરવા માંગો છો?</translation>
<translation id="6375219077595103062">Password Managerમાં શૉર્ટકટ ઉમેરો</translation>
<translation id="8218289771633351023"><ph name="BEGIN_BOLD"/>અમે આ ડેટાનો ઉપયોગ કેવી રીતે કરીએ છીએ:<ph name="END_BOLD"/> FlyWeb તમારી રુચિઓનું અનુમાન લગાવી શકે છે. પછી, તમે જેની મુલાકાત લો તે સાઇટ Braveને તમારી રુચિઓ જોવા માટે કહી શકે છે, જેથી તમને જોવા મળતી જાહેરાતોને મનગમતી બનાવી શકાય.</translation>
<translation id="2104550252781001709">કમ્પ્યૂટરની સ્ક્રીનમાં Braveનો લોગો.</translation>
<translation id="6636986997730784876">FlyWeb એ એક એવું વેબ બ્રાઉઝર છે જે પ્રકાશની ગતિએ વેબપૃષ્ઠો અને એપ્લિકેશંસને ચલાવે છે. તે ઝડપી, સ્થિર અને ઉપયોગમાં સરળ છે. FlyWeb FlyWeb માં નિર્મિત મૉલવેર અને ફિશીંગ સુરક્ષા સાથે વેબને વધુ સુરક્ષિત રૂપે બ્રાઉઝ કરો.</translation>
<translation id="2139300032719313227">ChromeOS ફરી શરૂ કરો</translation>
<translation id="7560906925528428585">તમે જે પેજની મુલાકાત લેશો તેવી શક્યતા હોય, FlyWeb તેવા વધુ પેજને પણ પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થાય</translation>
<translation id="2970877059928503461">બંધ • આ એક્સ્ટેન્શન ક્યાંથી આવે છે તેની ચકાસણી FlyWeb કરી શકતું નથી</translation>
<translation id="173462352822069427">FlyWeb પ્રોફાઇલમાં આપનું સ્વાગત છે</translation>
<translation id="3484308111967198595">Braveમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="1474676525193357364">જ્યારે તમે FlyWeb શરૂ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="648319183876919572">Safe Browsingમાં વધારેલી સુરક્ષા તમને જોખમી વેબસાઇટ અને ડાઉનલોડ સામે વધુ સુરક્ષા આપે છે</translation>
<translation id="5777905264835557372">FlyWeb ને અનઇન્સ્ટૉલ કરો</translation>
<translation id="764623543427374554">શૉર્ટકટ Braveમાં ખુલે છે</translation>
<translation id="3616832517943695570">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે Braveમાં તમારા FlyWeb એકાઉન્ટમાંથી તમારા પાસવર્ડ અને વધુનો ઉપયોગ કરી શકો છો. તમે સેટિંગમાં જઈને કોઈપણ સમયે આને બદલી શકો છો.</translation>
<translation id="8852057261917278552">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION"/> માટે Braveનો ઉપયોગ ન કરે ત્યારે તેને બંધ કરે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવ્યો હતો. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.</translation>
<translation id="8592211619057897362">દરેક પ્રોફાઇલ બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજી ઘણી બાબતો જેવી તેની પોતાની FlyWeb માહિતી ધરાવે છે</translation>
<translation id="4273595998837775033"><ph name="BEGIN_LINK"/>FlyWeb તમારા ડેટાને કેવી રીતે ખાનગી રાખે છે<ph name="END_LINK"/> તે વિશે વધુ જાણો</translation>
<translation id="7489092380688543560">તમે બીજી FlyWeb પ્રોફાઇલમાંથી પાસવર્ડ જુઓ પર સ્વિચ કરી શકો છો</translation>
<translation id="8243012192239086369">જોડણીની ભૂલો સુધારવા માટે, FlyWeb તમે ટેક્સ્ટ ફીલ્ડમાં ટાઇપ કરો તે ટેક્સ્ટ Braveને મોકલે છે</translation>
<translation id="3927263773110604886">Braveની નોટિફિકેશનની સેટિંગ પર જાઓ</translation>
<translation id="6888846095017247017">તમારા ફેરફારો તમે આગલી વખતે FlyWeb ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="1886169834787876002">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Braveને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="7640394575797555654">સાઇટ કદાચ તમારી અપેક્ષા મુજબ કામ કરશે, પરંતુ તમે Braveની બધી વિન્ડો બંધ કરી દો તે પછી, તે તમારો ડેટા સાચવશે નહીં</translation>
<translation id="7570986009744020649">જો તમે બુકમાર્કને તમારા FlyWeb એકાઉન્ટમાં પણ સાચવશો, તો તમે પ્રોડક્ટની કિંમતો Braveમાં ટ્રૅક કરી શકશો તેમજ જ્યારે પણ કિંમતમાં ઘટાડો થાય ત્યારે નોટિફિકેશન મેળવશો</translation>
<translation id="6676384891291319759">ઇંટરનેટ ઍક્સેસ કરો</translation>
<translation id="1363996462118479832">સાઇન ઇનમાં થયેલી ભૂલને કારણે ChromeOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="4748642594935526275">તમે જુઓ છો તે જાહેરાતો માટે FlyWeb તમને વધુ નિયંત્રણો આપે છે અને સાઇટ તમને મનગમતી બનાવેલી જાહેરાતો બતાવે ત્યારે તે તમારા વિશે શું જાણી શકે છે તેને મર્યાદિત કરે છે</translation>
<translation id="4152880912192471857">આ સાઇટ માટે Braveને માઇક્રોફોનની પરવાનગીની જરૂર છે</translation>
<translation id="6712881677154121168">ડાઉનલોડ કરવામાં ભૂલ: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2193001403607253406">તમારી પ્રોફાઇલનો ઉપયોગ કરી શકાતો નથી કારણ કે તે Braveના નવા વર્ઝન તરફથી છે.

કેટલીક સુવિધાઓ ઉપલબ્ધ થઈ શકે છે. કૃપા કરીને અલગ પ્રોફાઇલ ડિરેક્ટરીનો ઉલ્લેખ કરો અથવા Braveના નવા વર્ઝનનો ઉપયોગ કરો.</translation>
<translation id="5528558621229392814">મનગમતું બનાવવાની અને અન્ય સુવિધાઓ મેળવવા માટે, Braveનો વેબ અને ઍપ ઍક્ટિવિટી અને લિંક કરેલી FlyWeb સેવાઓમાં સમાવેશ કરો</translation>
<translation id="7728046102681268859">FlyWeb, તમારા કમ્પ્યુટર પર તમામ વપરાશકર્તાઓ માટે પહેલાંથી ઇન્સ્ટૉલ કરેલ છે.</translation>
<translation id="7030752319019635064">FlyWeb પરની તમારી વસ્તુઓને તમારા બધા ડિવાઇસ પર ઍક્સેસ કરવા માટે, સાઇન ઇન કરો અને પછી સિંક કરવાની સુવિધા ચાલુ કરો.</translation>
<translation id="199909180078651278">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. FlyWeb દ્વારા <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> અને <ph name="COUNT"/>ની પરવાનગીઓ કાઢી નાખવામાં આવી</translation>
<translation id="1292831930742306370">FlyWeb આ ફાઇલને સ્કૅન કરવાનો સુઝાવ આપે છે, કારણ કે તે જોખમકારક હોઈ શકે છે.</translation>
<translation id="1547295885616600893">ChromeOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS"/>ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS"/> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="6432682256389755533">FlyWeb વડે તમે તમારા પાસવર્ડમાં ક્યારેક ચેડાં થાય તો તેના વિશે જાણકારી મેળવી શકો છો</translation>
<translation id="684888714667046800">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. જો તમે કોઈ ફાયરવૉલનો ઉપયોગ કરતા હો, તો કૃપા કરીને ખાતરી કરો કે <ph name="PRODUCT_EXE_NAME"/> વ્હાઇટલિસ્ટમાં છે.</translation>
<translation id="8852956515664182428">FlyWeb - <ph name="PAGE_TITLE"/></translation>
<translation id="4695676871328690599">Braveને "<ph name="EXTENSION_NAME"/>"માં માલવેર હોવાનું જાણવા મળ્યું છે</translation>
<translation id="5929819793040985066">અજમાયશો ચાલુ હોય ત્યારે, Ad measurement તમે જેની મુલાકાત લો છો તે સાઇટને FlyWeb પાસેથી માહિતીની વિનંતી કરવાની મંજૂરી આપે છે, જે સાઇટને તેની જાહેરાતોનું કાર્યપ્રદર્શન માપવામાં સહાય કરે છે. Ad measurement સાઇટ વચ્ચે શક્ય તેટલી ઓછી માહિતી ટ્રાન્સફર કરીને, સાઇટ દ્વારા પરસ્પરના ટ્રૅકિંગને પ્રતિબંધિત કરે છે.</translation>
<translation id="8806901087257994310">પછી, તમે જેની મુલાકાત લો તે સાઇટ Braveને તમારી રુચિઓ જોવા માટે કહી શકે છે, જેથી તમને જોવા મળતી જાહેરાતોને મનગમતી બનાવી શકાય. FlyWeb વધુમાં વધુ 3 રુચિ શેર કરી શકે છે.</translation>
<translation id="2553796189989827248">નબળા પાસવર્ડનું અનુમાન કરવું સરળ હોય છે. Braveને <ph name="BEGIN_LINK"/>તમારા માટે સશક્ત પાસવર્ડ બનાવવા અને યાદ રાખવા<ph name="END_LINK"/>ની મંજૂરી આપો.</translation>
<translation id="1749753408579541220">જ્યારે ચાલુ હોય, ત્યારે FlyWeb નિષ્ક્રિય ટૅબમાંથી મેમરી ખાલી કરે છે. આ સક્રિય ટૅબ અને અન્ય ઍપને કમ્પ્યુટરના વધુ સંસાધનો આપે છે અને Braveને ઝડપી રાખે છે. તમે તમારા નિષ્ક્રિય ટૅબ પર પાછા જાઓ ત્યારે તે ઑટોમૅટિક રીતે ફરી સક્રિય થાય છે.</translation>
<translation id="3453763134178591239">ChromeOSની શરતો</translation>
<translation id="8545123476334328275">Braveને આ સાઇટ માટે તમારા માઇક્રોફોનના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="7011190694940573312">ઑપરેટિંગ સિસ્ટમનું આ વર્ઝન સપોર્ટેડ ન હોવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="7024536598735240744">અનપૅક કરવામાં ભૂલ: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ઇન્સ્ટૉલેશનની પ્રક્રિયા રોકી.</translation>
<translation id="8144357648892716751">FlyWeb કસ્ટમાઇઝ કરો</translation>
<translation id="3945284827084409390">FlyWeb ને અપડેટ કરો</translation>
<translation id="7886270027101123253">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો FlyWeb તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Braveને છબીઓ મોકલવામાં આવે છે.</translation>
<translation id="5695394421048248926">FlyWeb for Testing કસ્ટમાઇઝ કરો</translation>
<translation id="8694083743003679818">Braveમાંથી <ph name="EXTENSION_NAME"/> કાઢી નાખો</translation>
<translation id="6017914745388312119">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION"/> માટે FlyWeb ડેટાનો ઉપયોગ ન કરે ત્યારે તેને ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.</translation>
<translation id="3283953248242339756">આ સાઇટ માટે Braveને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="4729674580260824908">FlyWeb લૉન્ચ કરી શકાયું નથી. ફરી પ્રયાસ કરો.</translation>
<translation id="9165925035484501889">FlyWeb તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરો.</translation>
<translation id="935820624106805690">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે Braveનો ઉપયોગ કરો</translation>
<translation id="1678436729108859736">કાર્ય વ્યવસ્થાપક - FlyWeb</translation>
<translation id="6135229048093148288">FlyWeb દ્વારા અનુમાન લગાવ્યા મુજબની તમારી રુચિઓ</translation>
<translation id="777484471503595351">{NUM_EXTENSIONS,plural, =1{FlyWeb તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે}one{FlyWeb તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે}other{FlyWeb તેમને કાઢી નાખવાનો સુઝાવ તમને આપે છે}}</translation>
<translation id="7641415053133771502">Ad measurement તમે જેની મુલાકાત લો છો તે સાઇટને FlyWeb પાસેથી માહિતીની વિનંતી કરવાની મંજૂરી આપે છે, જે સાઇટને તેની જાહેરાતોનું કાર્યપ્રદર્શન માપવામાં સહાય કરે છે. Ad measurement સાઇટ વચ્ચે શક્ય તેટલી ઓછી માહિતી ટ્રાન્સફર કરીને, સાઇટ દ્વારા પરસ્પરના ટ્રૅકિંગને પ્રતિબંધિત કરે છે.</translation>
<translation id="2866611433272355726">FlyWeb ને અપડેટ કરી રહ્યું છે</translation>
<translation id="5013690772358862887">તમારી પસંદગીઓ ફાઇલ દૂષિત અથવા અમાન્ય છે.

FlyWeb તમારા સેટિંગને રિકવર શકતું નથી.</translation>
<translation id="7339898014177206373">નવી વિંડો</translation>
<translation id="1123144153876435088">તમારું વેબ, બુકમાર્ક અને અન્ય FlyWeb સામગ્રી અહીં હોય છે.</translation>
<translation id="6760192061736180746">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME"/>ને ઍક્સેસ કરવા Braveને <ph name="ALTERNATIVE_BROWSER_NAME"/> ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="3597072490217949295">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આ ફાઇલ <ph name="USER_EMAIL"/> સહિત તમારા વ્યક્તિગત અને સોશિયલ નેટવર્ક એકાઉન્ટને નુકસાન પહોંચાડી શકે છે</translation>
<translation id="5674884821459478726">આ એક્સ્ટેન્શન હવે સપોર્ટેડ રહ્યું નથી. એના બદલે FlyWeb તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે.</translation>
<translation id="3225813655660631613">FlyWeb પ્રોફાઇલ વડે તમે તમારી બધી વસ્તુઓ FlyWeb પર અલગ-અલગ રાખી શકો છો. આનાથી ઑફિસ અને મનોરંજન વચ્ચે વિભાજન કરવાનું સરળ બને છે.</translation>
<translation id="2971917489215408838"><ph name="PAGE_TITLE"/> - FlyWeb Dev</translation>
<translation id="3787225360375979559">Braveને આ સાઇટ માટે તમારા કૅમેરાના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="2431618580332826398">Braveની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 7નો ઉપયોગ કરે છે.</translation>
<translation id="2154651873647244914">FlyWeb ફરીથી લૉન્ચ કરીએ?</translation>
<translation id="3137757192868162370">હાલમાં ચાલી રહ્યું છે તેના જેવું સમાન FlyWeb વર્ઝન ઇન્સ્ટૉલ કરી શકાતું નથી. કૃપા કરીને Braveને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="4027434552262956425">સાઇટ અપેક્ષા મુજબ કામ કરે તેમ બની શકે છે. જો તમે Braveમાં સાઇન ઇન કર્યું હોય, તો જ્યારે તમે તમારા FlyWeb એકાઉન્ટ સિવાયની બધી FlyWeb વિન્ડો બંધ કરશો, ત્યારે તમે મોટાભાગની સાઇટમાંથી સાઇન આઉટ થઈ જશો.</translation>
<translation id="4731230085409037950">{0,plural, =1{FlyWeb 1 મિનિટમાં ફરીથી લૉન્ચ થશે}one{FlyWeb # મિનિટમાં ફરીથી લૉન્ચ થશે}other{FlyWeb # મિનિટમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="2681961630847487657">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમની પસંદગીઓમાં FlyWeb માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="5426732664223965459">FlyWeb તમારી રુચિઓનું અનુમાન લગાવી શકે છે. પછી, તમે જેની મુલાકાત લો તે સાઇટ Braveને તમારી રુચિઓ જોવા માટે કહી શકે છે, જેથી તમને જોવા મળતી જાહેરાતોને મનગમતી બનાવી શકાય.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ઇન્સ્ટૉલર</translation>
<translation id="6174417243847172547">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. FlyWeb દ્વારા <ph name="PERMISSION"/>ની પરવાનગી કાઢી નાખવામાં આવી</translation>
<translation id="3067364763515000789">FlyWeb તમારા કૅમેરા અને માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="1381291360713116383">FlyWeb હવે પહેલાંથી બહેતર બન્યું છે</translation>
<translation id="7649070708921625228">સહાય</translation>
<translation id="481435825250648341">તમે FlyWeb સેટિંગમાં આ સુવિધાઓ વિશે વધુ જાણી શકો છો.</translation>
<translation id="2230101319599356673">FlyWeb તમારું ડિફૉલ્ટ બ્રાઉઝર નથી</translation>
<translation id="3243257760331619874">તમારા બધા ડિવાઇસ પર Braveને સિંક કરો અને મનગમતું બનાવો</translation>
<translation id="3836891631266228927">FlyWeb અપડેટ</translation>
<translation id="1549877678317463759">આ તમારા બ્રાઉઝિંગ ડેટાને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, FlyWeb માં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="7747138024166251722">ઇન્સ્ટૉલર અસ્થાયી ડિરેક્ટરી બનાવી શક્યું નથી. કૃપા કરીને ખાલી ડિસ્ક સ્પેસ માટે અને સૉફ્ટવેર ઇન્સ્ટૉલ કરવાની પરવાનગી માટે તપાસો.</translation>
<translation id="134973275687829726">Braveને વધુ ઝડપી બનાવો</translation>
<translation id="1102535934248882091"><ph name="PAGE_TITLE"/> - FlyWeb Canary</translation>
<translation id="8560501749799359076">તમારા ઇન્ટરનેટ ટ્રાફિકનો ઍક્સેસ ધરાવતા લોકો માટે, તમે કઈ સાઇટની મુલાકાત લો છો તે જોવાનું વધુ મુશ્કેલ બનાવો. FlyWeb દ્વારા DNS (ડોમેન નેમ સિસ્ટમ)માં સાઇટનું IP ઍડ્રેસ જોવા માટે સુરક્ષિત કનેક્શનનો ઉપયોગ કરવામાં આવે છે.</translation>
<translation id="8463540467315366872">આ એકાઉન્ટ સાથેની FlyWeb પ્રોફાઇલ પહેલેથી જ આ ડિવાઇસ પર અસ્તિત્વમાં છે</translation>
<translation id="7845233973568007926">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME"/>નો ઉપયોગ કરતા પહેલાં તમારે તમારું કમ્પ્યુટર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="4766381896251401675">જ્યારે તમે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે બહેતર સૂચનો મેળવવા માટે FlyWeb તમે જે ટાઇપ કરો છો તેને તમારા ડિફૉલ્ટ શોધ એન્જિનને મોકલે છે. આ સુવિધા છૂપા મોડમાં કામ કરતી નથી.</translation>
<translation id="8611872055947278722">FlyWeb નવીનતમ વર્ઝન પર અપડેટ ન થઈ શક્યું, તેથી તમે નવી સુવિધાઓ અને સુરક્ષાના સુધારા ચૂકી રહ્યા છો.</translation>
<translation id="7872446069773932638">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="SECONDS"/> સેકન્ડ બાકી છે</translation>
<translation id="3217139311889964618"><ph name="BEGIN_BOLD"/>તમે તમારો ડેટા કેવી રીતે મેનેજ કરી શકો છો:<ph name="END_BOLD"/> તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે, અમે 4 અઠવાડિયા કરતાં જૂની હોય એવી તમારી રુચિઓને ઑટોમૅટિક રીતે ડિલીટ કરીએ છીએ. તમે જેમ જેમ બ્રાઉઝ કરતા રહો છો, તેમ તેમ તમારી રુચિનો વિષય ફરી સૂચિમાં દેખાઈ શકે છે. અથવા તમે તમારી રુચિના એવા વિષયો કાઢી નાખી શકો છો કે જેમને તમે Braveની સૂચિમાં શામેલ કરવા માગતા નથી.</translation>
<translation id="6798431672720500005">Braveને તમારા ડિફૉલ્ટ તરીકે સેટ કરો</translation>
<translation id="3096730275883527801">તમે FlyWeb માં <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન કર્યું હતું. ફરીથી સાઇન ઇન કરવા માટે કૃપા કરીને એ જ એકાઉન્ટનો ઉપયોગ કરો.</translation>
<translation id="9017338699075596174">આ FlyWeb નું દ્વિતીય ઇન્સ્ટૉલેશન છે અને આને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="5944585442866020176">એકવાર Braveને ઍક્સેસ મળે, તે પછી વેબસાઇટ તમારી પાસે ઍક્સેસ માગી શકશે.</translation>
<translation id="80471789339884597">ઇન્સ્ટૉલ કરવા બદલ આભાર. તમારે <ph name="BUNDLE_NAME"/>નો ઉપયોગ કરતા પહેલાં તમારા બધા બ્રાઉઝર ફરી શરૂ કરવા આવશ્યક છે.</translation>
<translation id="8086881907087796310">તમારું કમ્પ્યૂટર, હાર્ડવેરની ઓછામાં ઓછી આવશ્યકતાઓ પૂર્ણ ન કરી શકવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="1252435607084353041"><ph name="PAGE_TITLE"/> - FlyWeb for Testing</translation>
<translation id="3263664073045388929">આ સાઇટ માટે Braveને સ્થાનની પરવાનગીની જરૂર છે</translation>
<translation id="5334309298019785904">તમારા ડોમેન પર સિંકની સુવિધા ઉપલબ્ધ ન હોવાને કારણે ChromeOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="813913629614996137">પ્રારંભ કરી રહ્યું છે...</translation>
<translation id="1446402395644795187">Braveના JavaScript અને WebAssembly એન્જિનમાં વધારાની સુરક્ષા ચાલુ કરો</translation>
<translation id="1597323875619800374">આ ફાઇલ જોખમી છે, તેથી FlyWeb એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="4749458995158778066">FlyWeb એ ચકાસણી કરી શકતું નથી કે આ એક્સ્ટેન્શન ક્યાંથી આવ્યું છે અને તે કદાચ અસલામત હોઈ શકે છે. તેને Braveમાંથી કાઢી નાખો, જેથી તે હવેથી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો છો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="6756872644564483342">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો FlyWeb તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Braveને છબીઓ મોકલવામાં આવે છે. તમે આને કોઈપણ સમયે સેટિંગમાં જઈને બંધ કરી શકો છો.</translation>
<translation id="9179486248398668702">નવી પ્રોફાઇલમાં Braveમાં સાઇન ઇન કરીએ?</translation>
<translation id="5792785787074426346">તમે સાઇન ઇન કરેલું ન હોવાને કારણે FlyWeb તમારા પાસવર્ડ ચેક કરી શકતું નથી</translation>
<translation id="9102959605052547519">અસુરક્ષિત સાઇટ અને ડાઉનલોડ વિશે <ph name="BEGIN_LINK"/>FlyWeb તમને ચેતવણી આપે છે<ph name="END_LINK"/></translation>
<translation id="208266011144024011">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION"/> માટે Braveનો ઉપયોગ ન કરે ત્યારે તેને બંધ કરે છે.</translation>
<translation id="5565286784156841599">તમારા બધા ડિવાઇસ પર Braveને સિંક કરો અને મનગમતું બનાવવા માટે સાઇન ઇન કરો</translation>
<translation id="9174706677133564856"><ph name="USER_EMAIL_ADDRESS"/>, પહેલાં FlyWeb નો ઉપયોગ કરી રહ્યાં હતાં</translation>
<translation id="5975370349701995302">FlyWeb બ્રાઉઝર પરની તમારી વસ્તુઓને તમારા બધા ડિવાઇસ પર ઍક્સેસ કરવા માટે, સાઇન ઇન કરો અને પછી સિંક કરવાની સુવિધા ચાલુ કરો</translation>
<translation id="7408894216012529448">Braveની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8નો ઉપયોગ કરે છે.</translation>
<translation id="5020916672477085422">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Braveમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ પાસવર્ડ તમારા FlyWeb એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="5417365165109189454">ત્યાર પછી તમારે FlyWeb ફરી શરૂ કરવું જરૂરી છે.</translation>
<translation id="4212474799248200893">FlyWeb તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/></translation>
<translation id="7256356679044945328">આ એક્સ્ટેન્શનને તેના ડેવલપર દ્વારા અનપબ્લિશ કરવામાં આવ્યું હતું અને તે અસુરક્ષિત હોઈ શકે છે. તેને Braveમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="5261590792975521002">{0,plural, =1{એક દિવસની અંદર Braveને ફરીથી લૉન્ચ કરો}one{# દિવસની અંદર Braveને ફરીથી લૉન્ચ કરો}other{# દિવસની અંદર Braveને ફરીથી લૉન્ચ કરો}}</translation>
<translation id="3101564993057563365">ઇન્સ્ટૉલર આર્કાઇવ ખરાબ અથવા અમાન્ય છે. કૃપા કરીને FlyWeb ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="5316851838033144902">FlyWeb માટે Windows 10 અથવા તે પછીનું વર્ઝન આવશ્યક છે.</translation>
<translation id="6760691951531758781">વૈકલ્પિક: Braveને ડાયગ્નોસ્ટિક અને વપરાશનો ડેટા ઑટોમૅટિક રીતે મોકલીને ChromeOSની સુવિધાઓ અને કાર્યપ્રદર્શનને બહેતર બનાવવામાં સહાય કરો.</translation>
<translation id="6852836260419236265">FlyWeb જૂનું થઈ ગયું છે</translation>
<translation id="797182360653885317">જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે FlyWeb તેને ચેક કરી શકે છે</translation>
<translation id="8550334526674375523">ઑફિસની આ પ્રોફાઇલ તમારી વ્યક્તિગત પ્રોફાઇલથી સાવ અલગ છે.</translation>
<translation id="8555465886620020932">સેવામાં ભૂલ: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8842078659829047498">જ્યારે તમે તમારા FlyWeb એકાઉન્ટ વડે સાઇન ઇન કરો ત્યારે FlyWeb તમારા પાસવર્ડ ચેક કરી શકે છે</translation>
<translation id="4533644814362098185">Copyright © <ph name="YEAR"/> lamosquita and The Brave Authors. All rights reserved.</translation>
<translation id="6539417028609632917"><ph name="BEGIN_BOLD"/>અમે આ ડેટાનો ઉપયોગ કેવી રીતે કરીએ છીએ:<ph name="END_BOLD"/> સાઇટ, FlyWeb પર તમારી રુચિના વિષયો વિશેની માહિતી સ્ટોર કરી શકે છે. ઉદાહરણ તરીકે જો તમે મૅરેથનમાં દોડવા માટે શૂઝ ખરીદવા કોઈ સાઇટની મુલાકાત લો, તો એ સાઇટ મૅરેથન દોડને તમારી રુચિના વિષય તરીકે સાચવી શકે છે. પછી, જો તમે દોડ માટે રજિસ્ટ્રેશન કરાવવા કોઈ અન્ય સાઇટની મુલાકાત લેશો, તો તે સાઇટ તમારી રુચિના વિષયના આધારે તમને દોડવા માટેના શૂઝની જાહેરાત બતાવી શકે છે.</translation>
<translation id="7129578417724116642">FlyWeb લૉન્ચ કરી રહ્યાં છીએ…</translation>
<translation id="781795332371306113">અનુલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ રહ્યું. કૃપા કરીને FlyWeb ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="5469043671012993003">FlyWeb for Testingને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="1514450422236300417">જ્યારે તમે FlyWeb શરૂ કરો અથવા ઑમ્નિબૉક્સ પરથી શોધ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="573490495087487940">આ તમારું FlyWeb છે</translation>
<translation id="2666961286257416158">Braveમાં સાઇન ઇન કરીએ?</translation>
<translation id="878572486461146056">ઇન્સ્ટૉલ કરવામાં ભૂલ: તમારા નેટવર્ક ઍડમિન દ્વારા કોઈ ગ્રૂપ પૉલિસી લાગુ કરવામાં આવી છે, જે ઇન્સ્ટૉલેશનની પ્રક્રિયાને અટકાવે છે: <ph name="INSTALL_ERROR"/></translation>
<translation id="6779439179813982247">Braveને આ સાઇટ માટે તમારા કૅમેરા અને માઇક્રોફોનના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="6808406663598665473">શું Braveમાં સાઇન ઇન કરીએ?</translation>
<translation id="8826492472752484139">“Password Manager” પર ક્લિક કરો</translation>
<translation id="6933858244219479645">ChromeOS સિસ્ટમ</translation>
<translation id="7354175404728814475"><ph name="BEGIN_BOLD"/>કયા ડેટાનો ઉપયોગ કરવામાં આવે છે:<ph name="END_BOLD"/> તમારો બ્રાઉઝિંગ ઇતિહાસ કે જેમાં આ ડિવાઇસ પર તમે FlyWeb વડે મુલાકાત લીધેલી સાઇટનો રેકોર્ડ હોય છે.</translation>
<translation id="8862326446509486874">તમારી પાસે સિસ્ટમ-સ્તરનાં ઇન્સ્ટોલ માટે ઉચિત અધિકારો નથી. એડમિન તરીકે ઇન્સ્ટૉલરને ફરીથી ચલાવવનો પ્રયાસ કરો.</translation>
<translation id="709828993049448700">જો એવું હોય, તો કૃપા કરીને Braveમાં તમારા સાચવેલા પાસવર્ડમાં ફેરફાર કરો જેથી તે તમારા નવા પાસવર્ડ સાથે મેળ ખાય.</translation>
<translation id="4669168852412989042">FlyWeb પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="1343885466359249904">FlyWeb છેલ્લા અમુક અઠવાડિયાઓના તમારા બ્રાઉઝિંગ ઇતિહાસને આધારે તમારી રુચિઓનું અનુમાન લગાવી શકે છે. આ માહિતી તમારા ડિવાઇસમાં જ રહે છે.</translation>
<translation id="1663379621921336006">FlyWeb અપડેટ કરી શકતાં નથી</translation>
<translation id="543915850302643692">FlyWeb Enterpriseનો લોગો</translation>
<translation id="8986207147630327271">તમે આ બ્રાઉઝરમાં ઑફિસની પ્રોફાઇલ ઉમેરી રહ્યાં છો અને તમારા વ્યવસ્થાપકને માત્ર ઑફિસની પ્રોફાઇલનો નિયંત્રણ આપી રહ્યાં છો.</translation>
<translation id="8422308271795251425">FlyWeb પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="5804408305184682593">FlyWeb માં સાઇન ઇન કરો</translation>
<translation id="2138383893834402906">FlyWeb દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આર્કાઇવ ફાઇલમાં શામેલ અન્ય ફાઇલોમાં માલવેર છુપાવેલા હોઈ શકે છે</translation>
<translation id="7813768067688376455">જ્યારે તમે Braveની અન્ય સેવાઓમાં સાઇન ઇન કરશો, ત્યારે Braveમાં સાઇન ઇન કરો</translation>
<translation id="8692043725449223663">Braveમાં સાઇન ઇન કરો. જો કોઈ એકાઉન્ટમાં તમે માત્ર એક જ વાર સાઇન ઇન કરવા માગતા હો, તો તમે <ph name="GUEST_LINK_BEGIN"/>ડિવાઇસનો ઉપયોગ અતિથિ તરીકે કરી<ph name="GUEST_LINK_END"/> શકો છો.</translation>
<translation id="8323442969389928559">FlyWeb ઑટોમૅટિક રીતે બંધ થઈ ગયું હતું</translation>
<translation id="7626272203917389133">FlyWeb જૂનું થઈ ગયું છે</translation>
<translation id="1789655708880997767">{0,plural, =1{FlyWeb એક કલાકમાં ફરીથી લૉન્ચ થશે}one{FlyWeb # કલાકમાં ફરીથી લૉન્ચ થશે}other{FlyWeb # કલાકમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="8970147445441095618">Braveની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8.1નો ઉપયોગ કરે છે.</translation>
<translation id="1208237657860748752">નવા FlyWeb &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="911206726377975832">તમારો બ્રાઉઝિંગ ડેટા પણ ડિલીટ કરી દઈએ?</translation>
<translation id="1899793037348288257">અજમાયશો દરમિયાન, તમે રુચિના એ વિષયોને જોઈ અને કાઢી નાખી શકો છો કે જેનો ઉપયોગ સાઇટ દ્વારા તમને જાહેરાતો બતાવવા માટે કરવામાં આવ્યો હતો. FlyWeb તમારા તાજેતરના બ્રાઉઝિંગ ઇતિહાસના આધારે તમારી રુચિઓનું અનુમાન લગાવે છે.</translation>
<translation id="3926534790663909774">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME"/>ને ઍક્સેસ કરવા Braveને વૈકલ્પિક બ્રાઉઝર ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="5022081608392609959">&amp;FlyWeb અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="8203782065881668160">FlyWeb (mDNS-In)</translation>
<translation id="5547805003442792166">Braveને તમારું પોતાનું બનાવો</translation>
<translation id="3410331617397516204">FlyWeb યોગ્ય રીતે કાર્ય ન કરે તેવું બની શકે કારણ કે તે હવેથી Windows XP અથવા Windows Vista પર સમર્થિત નથી</translation>
<translation id="1641772209502041092">FlyWeb દ્વારા મેનેજ કરવામાં આવતા પ્રમાણપત્રો</translation>
<translation id="1127626874097952395">કોણ Braveનો ઉપયોગ કરે છે?</translation>
<translation id="1626113414414104077">Braveની સૌથી વધુ મજબૂત સુરક્ષા મેળવો</translation>
<translation id="983803489796659991">અપડેટ સર્વર પાસે ઍપ્લિકેશન માટે કોઈ હૅશ સંબંધી ડેટા ન હોવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="839475718250652248">કોઈ એકાઉન્ટ વિના Braveનો ઉપયોગ કરો</translation>
<translation id="5853146837898805914">lamosquita</translation>
<translation id="137466361146087520">Google Chrome બીટા</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="4434689349450618970">જો તમે માત્ર એક વાર જ આ એકાઉન્ટનો ઉપયોગ કરવા માગતા હો, તો તમે FlyWeb બ્રાઉઝરમાં <ph name="GUEST_LINK_BEGIN"/>અતિથિ મોડ<ph name="GUEST_LINK_END"/>નો ઉપયોગ કરી શકો છો. જો તમે કોઈ બીજી વ્યક્તિ માટે એકાઉન્ટ ઉમેરવા માગતા હો, તો તમારા <ph name="DEVICE_TYPE"/>માં <ph name="LINK_BEGIN"/>નવી વ્યક્તિ ઉમેરો<ph name="LINK_END"/>.

તમે વેબસાઇટ અને ઍપને પહેલેથી જે પરવાનગીઓ આપી છે, તે આ એકાઉન્ટ પર લાગુ થઈ શકે છે. તમે <ph name="SETTINGS_LINK_BEGIN"/>સેટિંગ<ph name="SETTINGS_LINK_END"/>માં જઈને તમારા FlyWeb એકાઉન્ટ મેનેજ કરી શકો છો.</translation>
<translation id="2725795635123877647">અજાણ્યા સ્રોતો પરના એક્સ્ટેન્શન, ઍપ અને થીમ તમારા ડિવાઇસને નુકસાન પહોંચાડી શકે છે. FlyWeb તેમને <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> પરથી જ ઇન્સ્ટૉલ કરવાનો સુઝાવ આપે છે</translation>
<translation id="5382847955032513683">ચેતવણી: એક્સ્ટેન્શનને તમારો બ્રાઉઝિંગ ઇતિહાસ રેકોર્ડ કરવાથી FlyWeb અટકાવી શકતું નથી. છૂપા મોડમાં આ એક્સ્ટેન્શનને બંધ કરવા માટે, આ વિકલ્પની પસંદગી નાપસંદ કરો.</translation>
<translation id="543905389684998697">FlyWeb ને સુરક્ષિત બનાવવા માટે, અમે <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યાં હોઈ શકે છે તેવા કેટલાક એક્સ્ટેન્શન્સને અક્ષમ કર્યા છે.</translation>
<translation id="3914570680366033593">FlyWeb ને સુરક્ષિત બનાવવા માટે, અમે નીચેના એક્સ્ટેન્શનને અક્ષમ કર્યું છે કે જે <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યું હોઈ શકે છે.</translation>
<translation id="3293172835368652510">આ વ્યક્તિનો બ્રાઉઝિંગ ડેટા આ ડિવાઇસમાંથી ડિલીટ કરવામાં આવશે. આ ડેટા પાછો મેળવવા માટે, Braveમાં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2742103213766991703">FlyWeb છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="1616978953472841483">FlyWeb છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="2050263926423290804">{COUNT,plural, =0{FlyWeb માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે.}=1{FlyWeb માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{FlyWeb માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{FlyWeb માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="7488914907489544218">{COUNT,plural, =0{આ અપડેટ લાગુ કરવા માટે FlyWeb ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે}=1{આ અપડેટ લાગુ કરવા માટે FlyWeb ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{આ અપડેટ લાગુ કરવા માટે FlyWeb ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{આ અપડેટ લાગુ કરવા માટે FlyWeb ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="7568541461974616693">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે તમે Braveને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે}=1{અપડેટ લાગુ કરવા માટે તમે Braveને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે તમે Braveને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે તમે Braveને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="4630629063306099328">તમે તમારા સાઇન ઇન કરેલા હોય એવા FlyWeb એકાઉન્ટ મેનેજ કરી શકો છો. તમારા FlyWeb એકાઉન્ટનો ઉપયોગ FlyWeb બ્રાઉઝર, Play Store, Gmail અને વધુ માટે થાય છે. જો તમે કોઈ બીજા, જેમકે તમારા કુટુંબના સભ્ય માટે એકાઉન્ટ ઉમેરવા માંગતા હો, તો તેના બદલે નવી વ્યક્તિને તમારા <ph name="DEVICE_TYPE"/>માં ઉમેરો. <ph name="LINK_BEGIN"/>વધુ જાણો<ph name="LINK_END"/></translation>
</translationbundle>