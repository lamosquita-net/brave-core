<translation id="6933858244219479645">የChromeOS ስርዓት</translation>
<translation id="1501202286854500367">ይህ ቋንቋ FlyWeb ውስጥ ምናሌዎች፣ ቅንብሮች፣ ማንቂያዎች እና ሌላ ጽሁፍ ለማሳየት ጥቅም ላይ ይውላል</translation>
<translation id="8862326446509486874">ለስርዓተ-ደረጃ ጭነት ተገቢ መብቶች የሉዎትም። ጫኚውን እንደ አስተዳዳሪ በማሄድ እንደገና ይሞክሩ።</translation>
<translation id="2405293075272280413">የBrave መገለጫ ያክሉ</translation>
<translation id="2096285611267043007">በመለያ በመግባት ላይ ባለ ስሕተት ምክንያት ChromeOS የBrave ውሂብን በBrave መለያዎ ውስጥ ማስቀመጥ አልቻለም</translation>
