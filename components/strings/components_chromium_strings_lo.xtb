<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="130631256467250065">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ອຸປະກອນຂອງທ່ານໃໝ່.</translation>
<translation id="125853961893919199">ເຄັດລັບ FlyWeb: ບັນທຶກລະຫັດຜ່ານ</translation>
<translation id="1589233279653618219">ເຂົ້າໄປ
          ເມນູ FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ແລະ ກວດສອບວ່າມີການກຳນົດການຕັ້ງຄ່າຂອງທ່ານເປັນ "ບໍ່ມີພຣັອກຊີ" ຫຼື "ໂດຍກົງ".</translation>
<translation id="8359495463485001719">ບໍ່ມີການລາຍງານການຂັດຂ້ອງຢູ່ໃນ FlyWeb​.</translation>
<translation id="6338530717474923868">ທ່ານກຳລັງເບິ່ງໜ້າ FlyWeb ທີ່ປອດໄພ</translation>
<translation id="5147169001159408844">FlyWeb ກຳລັງພະຍາຍາມແກ້ໄຂການຕັ້ງຄ່າສຳລັບການຕື່ມວິທີການຈ່າຍເງິນ.</translation>
<translation id="5702992568540613683">ໂລໂກ້ FlyWeb</translation>
<translation id="8966580353365544289">ເຄັດລັບ FlyWeb: Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນ</translation>
<translation id="510342522494506803">FlyWeb ກຳລັງພະຍາຍາມແກ້ໄຂວິທີການຈ່າຍເງິນ.</translation>
<translation id="8375862260948854624">FlyWeb ເຮັດໃຫ້ເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/> ໂຄງການ open source ແລະ <ph name="BEGIN_LINK_OSS"/>ຊອບແວ open source<ph name="END_LINK_OSS"/> ອື່ນໆ.</translation>
<translation id="5040124620086808431">ໜ້ານີ້ຖືກບລັອກໄວ້ໂດຍ FlyWeb</translation>
<translation id="1953000035868532675">ອະນຸຍາດໃຫ້ FlyWeb ເຂົ້າເຖິງເຄືອຂ່າຍໃນການຕັ້ງຄ່າໄຟຣ໌ວໍ ຫຼື ໂປຣແກຣມ
          ຕ້ານໄວຣັສຂອງທ່ານ.</translation>
<translation id="4949828774841497663">ເຂົ້າໄປແອັບພລິເຄຊັນ &gt; ການຕັ້ງຄ່າລະບົບ &gt; ເຄືອຂ່າຍ, ເລືອກ
          ເຄືອຂ່າຍທີ່ນຳໃຊ້ຢູ່, ຄລິກປຸ່ມລາຍລະອຽດ... ແລ້ວເຊົາເລືອກພຣັອກຊີໃດກໍຕາມ
          ທີ່ອາດເລືອກໄວ້.</translation>
<translation id="7584668345330431749">ເຂົ້າໄປ
          ເມນູ FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ເຄືອຂ່າຍ ແລະ ອິນເຕີເນັດ &gt; ພຣັອກຊີ
          ແລ້ວເຊົາເລືອກ "ກວດຫາການຕັ້ງຄ່າໂດຍອັດຕະໂນມັດ".</translation>
<translation id="3145451630329266064">ໜ້າເຫຼົ່ານີ້ມີໄວ້ສຳລັບນັກພັດທະນາ FlyWeb ເທົ່ານັ້ນ ແລະ ອາດບໍ່ໄດ້ຮັບການບຳລຸງຮັກສາ ຫຼື ທົດສອບຢ່າງສະໝ່ຳສະເໝີ. ເພື່ອເປີດການນຳໃຊ້, ໃຫ້ເຂົ້າໄປ <ph name="BEGIN_LINK"/>flyweb://chrome-urls<ph name="LINK_END"/>, ຄລິກປຸ່ມເພື່ອເປີດການນຳໃຊ້ໜ້າດີບັກ, ຈາກນັ້ນນຳທາງໄປຫາໜ້ານີ້ອີກຄັ້ງ.</translation>
<translation id="2681118099728446983">FlyWeb ຍັງເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_OSS"/>ຊອບແວໂອເພນຊອດ<ph name="END_LINK_OSS"/> ອື່ນນຳອີກ.</translation>
<translation id="6888846095017247017">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ FlyWeb ໃໝ່.</translation>
<translation id="8524328905288851065">FlyWeb ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສືບຕໍ່ 
 ການຈັບຄູ່. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1017070759373671177">FlyWeb ເປັນໄປໄດ້ໂດຍໂຄງການໂອເພນຊອດ <ph name="BEGIN_LINK_CHROMIUM"/>FlyWeb<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="7777112741998051633">ໄປ​ທີ່
          ເມ​ນູ FlyWeb &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          ແລະ​ຖອນ​ເລືອກ "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          ຖ້າອັນ​ນີ້​ບໍ່​ແກ້​ໄຂ​ບັນ​ຫາ​ໄດ້, ພວກ​ເຮົາ​ແນະ​ນຳ​ໃຫ້​ເລືອກ​ເອົາ​ທາງ​ເລືອກ​ນີ້
          ອີກ​ເພື່ອ​ເພີ່ມ​ການ​ປະ​ຕິ​ບັດ​ງານ.</translation>
<translation id="4699594416850504200">ທ່ານກຳລັງເບິ່ງໜ້າ FlyWeb ສຳລັບການທົດສອບທີ່ປອດໄພ</translation>
<translation id="6224789938625024797">FlyWeb ມອດ​ຢ່າງບໍ່​ຖືກ​ຕ້ອງ.</translation>
<translation id="3593104813552438879">ເຄັດລັບສຳລັບ FlyWeb: ຊອກຫາດ້ວຍ Lens</translation>
</translationbundle>