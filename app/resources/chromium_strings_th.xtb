<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="7099479769133613710">เปิดอีกครั้งเพื่ออัปเดต &amp;Chrome OS</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="6896681084876612310">FlyWeb ช่วยให้คุณปลอดภัยจากการละเมิดข้อมูล ส่วนขยายที่ไม่ปลอดภัย และอื่นๆ ได้</translation>
<translation id="1368460307421081773">FlyWeb ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="7307912249127683931">FlyWeb เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="4556715463645168547"><ph name="BEGIN_LINK"/>ลงชื่อเข้าใช้ FlyWeb<ph name="END_LINK"/> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="2076135703183650206">คลิกเมนู FlyWeb</translation>
<translation id="7543127592112274795">{NUM_DEVICES,plural, =0{ส่วนขยาย FlyWeb ได้เข้าถึงอุปกรณ์ HID}=1{ส่วนขยาย FlyWeb กำลังเข้าถึงอุปกรณ์ HID}other{ส่วนขยาย FlyWeb กำลังเข้าถึงอุปกรณ์ HID # เครื่อง}}</translation>
<translation id="4380351562011537903">เกี่ยวกับ FlyWeb</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME"/></translation>
<translation id="4876991604685198381">โหมดประหยัดหน่วยความจำช่วยให้ FlyWeb ทำงานได้เร็วขึ้น</translation>
<translation id="4750836834956739196">ขณะที่แท็บนี้ไม่มีการใช้งาน ระบบจะเพิ่มพื้นที่ว่างในหน่วยความจำเพื่อให้ใช้ FlyWeb ได้อย่างรวดเร็วอยู่เสมอ ทั้งนี้คุณจะเลือกยกเว้นให้เว็บไซต์นี้ทำงานตลอดเวลาได้</translation>
<translation id="4549187150186083146">ตั้งค่าโปรไฟล์ FlyWeb ใหม่</translation>
<translation id="4150708158890309866">คุณลงชื่อเข้าใช้ FlyWeb แล้ว!</translation>
<translation id="4713192356155907986">รับความช่วยเหลือเกี่ยวกับ FlyWeb สำหรับการทดสอบ</translation>
<translation id="8962360511570172">แชร์แท็บ FlyWeb</translation>
<translation id="8196829963313696543">FlyWeb ต้องการสิทธิ์เข้าถึงกล้องเพื่อสร้างแผนที่ 3 มิติของสิ่งที่อยู่รอบตัวคุณ</translation>
<translation id="3961251277542681013">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน FlyWeb</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="5579294097895667826">FlyWeb รุ่นใหม่ที่ปลอดภัยกว่าเดิมพร้อมให้ใช้งานแล้ว</translation>
<translation id="2383861520542390014">คุณสามารถดูและลบหัวข้อที่สนใจซึ่งเว็บไซต์ใช้เพื่อแสดงโฆษณาแก่คุณ FlyWeb คาดคะเนความสนใจของคุณโดยอิงจากประวัติการท่องเว็บล่าสุด</translation>
<translation id="5695205873161614119">FlyWeb จะลบข้อมูลการท่องเว็บเร็วๆ นี้</translation>
<translation id="7385422968404728039">FlyWeb จะรีสตาร์ทใน <ph name="REMAINING_TIME"/></translation>
<translation id="307170399141486420">ให้ FlyWeb ทำงานในพื้นหลัง</translation>
<translation id="2473319786107120819">ติดตั้ง FlyWeb ใหม่</translation>
<translation id="2533324957407080119">FlyWeb กำลังพยายาม<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="6434738578659849497">เว็บไซต์สามารถจัดเก็บข้อมูลเกี่ยวกับความสนใจไว้กับ FlyWeb ตัวอย่างเช่น หากคุณเข้าชมเว็บไซต์เพื่อซื้อรองเท้าวิ่งมาราธอน เว็บไซต์นี้อาจระบุว่าคุณสนใจการวิ่งมาราธอน ภายหลัง เมื่อคุณเข้าชมเว็บไซต์อื่นเพื่อลงทะเบียนแข่งมาราธอน เว็บไซต์นี้ก็อาจแสดงโฆษณารองเท้าวิ่งโดยอิงจากความสนใจดังกล่าว</translation>
<translation id="4824940465467423308">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ FlyWeb ของคุณ ข้อมูล FlyWeb เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME"/> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี FlyWeb แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น คุณสามารถเลือกที่จะสร้างโปรไฟล์ใหม่เพื่อแยกเก็บข้อมูล FlyWeb ที่มีอยู่ของคุณ <ph name="LEARN_MORE"/></translation>
<translation id="7390382558747224642">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ FlyWeb อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ FlyWeb</translation>
<translation id="5714085538350759767">FlyWeb ไม่ตอบสนอง เปิดใหม่เลยหรือไม่</translation>
<translation id="4035053306113201399">ต้องรีสตาร์ท Chrome OS เพื่อใช้การอัปเดต</translation>
<translation id="1953553007165777902">กำลังดาวน์โหลด... เหลืออีก <ph name="MINUTE"/> นาที</translation>
<translation id="6956650624767954726">FlyWeb ไม่สามารถกำหนดหรือตั้งค่าเบราว์เซอร์เริ่มต้น</translation>
<translation id="6495079989036864983">การดำเนินการนี้จะลบ 1 รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ FlyWeb ด้วย <ph name="USER_EMAIL"/></translation>
<translation id="2018879682492276940">การติดตั้งไม่สำเร็จ โปรดลองอีกครั้ง</translation>
<translation id="4252651275570549255"><ph name="BEGIN_LINK"/>ลงชื่อเข้าใช้ FlyWeb<ph name="END_LINK"/> เพื่อตรวจสอบว่ารหัสผ่านรายการอื่นไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="8544477465831682343">เลือกว่าจะรวมประวัติการเข้าชม FlyWeb เพื่อรับประสบการณ์ที่ปรับเปลี่ยนในแบบของคุณมากขึ้นในบริการของ FlyWeb หรือไม่</translation>
<translation id="1868972292925460871">ข้อมูลเกี่ยวกับวิธีที่ FlyWeb จัดการใบรับรองรูท</translation>
<translation id="6765231735885996239">ปรับแต่ง FlyWeb</translation>
<translation id="2174917724755363426">การติดตั้งไม่สมบูรณ์ คุณแน่ใจไหมว่าต้องการยกเลิก</translation>
<translation id="2937508664417729967">FlyWeb - หน้าลงชื่อเข้าใช้ของเครือข่าย - <ph name="PAGE_TITLE"/></translation>
<translation id="2726680594710751908">ถ้าคุณให้ผู้อื่นใช้คอมพิวเตอร์ร่วมด้วย เพื่อนๆ และครอบครัวของคุณสามารถท่องเว็บแยกกันได้และตั้งค่า FlyWeb ได้ตามที่พวกเขาต้องการ</translation>
<translation id="5067150284614317159">ตรวจสอบ URL กับรายการเว็บไซต์ที่ไม่ปลอดภัยซึ่งจัดเก็บไว้ใน FlyWeb หากเว็บไซต์พยายามขโมยรหัสผ่าน หรือคุณดาวน์โหลดไฟล์ที่เป็นอันตราย FlyWeb อาจส่ง URL รวมถึงเนื้อหาบางส่วนในหน้าไปยัง Google Safe Browsing ด้วย</translation>
<translation id="3256927121768528350">หากต้องการส่งหมายเลขจากที่นี่ไปยังโทรศัพท์ Android ให้ลงชื่อเข้าใช้ FlyWeb ในอุปกรณ์ทั้งสองเครื่อง</translation>
<translation id="8776241960316471093">ส่วนขยายนี้ได้เปลี่ยนหน้าที่จะแสดงเมื่อคุณเริ่มต้น FlyWeb</translation>
<translation id="2359808026110333948">ต่อไป</translation>
<translation id="8418845734693287262">Chrome OS ซิงค์ข้อมูลไม่ได้เนื่องจากรายละเอียดการลงชื่อเข้าใช้บัญชีไม่ใช่ข้อมูลปัจจุบัน</translation>
<translation id="2100412893059179161">ส่วนขยาย "<ph name="EXTENSION_NAME"/>" ได้เปลี่ยนหน้าที่จะแสดงเมื่อคุณเริ่มต้น FlyWeb</translation>
<translation id="1364879203203742966">FlyWeb ต้องการสิทธิ์เข้าถึงกล้องและไมโครโฟนสำหรับเว็บไซต์นี้</translation>
<translation id="2451727308784734061">ใช้ทางลัดเพื่อไปยังเครื่องมือจัดการรหัสผ่านได้อย่างรวดเร็ว คุณสามารถย้ายทางลัดไปยังหน้าจอหลักหรือตัวเปิดแอปของคอมพิวเตอร์ได้</translation>
<translation id="3224379053610845181">FlyWeb จะปิดเร็วๆ นี้</translation>
<translation id="3840682988105604367">ใน FlyWeb</translation>
<translation id="2485422356828889247">ถอนการติดตั้ง</translation>
<translation id="6823116595279840454">FlyWeb กำลังพยายามแทนที่รหัสผ่านที่มีอยู่ โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="2691552788029831386">FlyWeb ต้องการสิทธิ์เข้าถึงพื้นที่เก็บข้อมูลเพื่อดาวน์โหลดไฟล์</translation>
<translation id="2275866327478859777">FlyWeb Helper</translation>
<translation id="7717615706977383025">ผู้ดูแลโปรไฟล์งานนำข้อมูล FlyWeb ที่สร้างขึ้นในช่วงที่มีการใช้โปรไฟล์นี้ออกได้ (เช่น การสร้างบุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ) <ph name="LEARN_MORE"/></translation>
<translation id="3231856291920394348">ใช้ FlyWeb ต่อ</translation>
<translation id="3827993926722004004">เกิดข้อผิดพลาดของระบบปฏิบัติในระหว่างการติดตั้ง โปรดดาวน์โหลด FlyWeb อีกครั้ง</translation>
<translation id="333184635927514678">เพื่อนและครอบครัวสามารถท่องเว็บแยกกันและตั้งค่า FlyWeb ตามที่ตนต้องการในกรณีที่ใช้อุปกรณ์ร่วมกัน</translation>
<translation id="8991987934418988501">FlyWeb บล็อกไฟล์ที่เก็บถาวรนี้เนื่องจากอาจซ่อนมัลแวร์</translation>
<translation id="1661841342483968180">ยินดีต้อนรับสู่ FlyWeb <ph name="ACCOUNT_FIRST_NAME"/></translation>
<translation id="1257705702166647105">แท็บ FlyWeb</translation>
<translation id="2796283369875688710">เพื่อเพิ่มความปลอดภัยให้มากยิ่งขึ้น FlyWeb จะเข้ารหัสข้อมูลของคุณ</translation>
<translation id="2770231113462710648">เปลี่ยนเบราว์เซอร์ที่เป็นค่าเริ่มต้นเป็น:</translation>
<translation id="7907238427168022751">ส่วนขยายนี้มีมัลแวร์และไม่ปลอดภัย นำส่วนขยายดังกล่าวออกจาก FlyWeb เพื่อไม่ให้ดูและเปลี่ยนแปลงข้อมูลของคุณในเว็บไซต์ที่เข้าชม รวมถึงข้อมูลส่วนบุคคลได้อีกต่อไป</translation>
<translation id="2799223571221894425">เปิดใหม่</translation>
<translation id="8990114339313395142">การดำเนินการนี้จะสร้างโปรไฟล์ FlyWeb ใหม่สำหรับ <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="1339341044496643931">นำออกจาก FlyWeb...</translation>
<translation id="4922993584046885552">รักษาความปลอดภัยของคุณใน FlyWeb และอาจใช้เพื่อปรับปรุงความปลอดภัยในแอปอื่นๆ ของ FlyWeb เมื่อลงชื่อเข้าใช้</translation>
<translation id="2885378588091291677">ตัวจัดการงาน</translation>
<translation id="3806033752149316261">เกี่ยวกับ &amp;FlyWeb</translation>
<translation id="2915996080311180594">รีสตาร์ทภายหลัง</translation>
<translation id="2928420929544864228">การติดตั้งเสร็จสมบูรณ์</translation>
<translation id="1661079783259785361">FlyWeb อัปเดตแล้ว</translation>
<translation id="5447533789927384736">หากเว็บไซต์พยายามขโมยรหัสผ่าน หรือคุณดาวน์โหลดไฟล์ที่เป็นอันตราย FlyWeb อาจส่ง URL รวมถึงเนื้อหาบางส่วนในหน้าไปยัง Google Safe Browsing ด้วย</translation>
<translation id="1244955229468464260">FlyWeb ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดลองอีกครั้งภายหลัง</translation>
<translation id="8841609317523323027">กำลังเพิ่มลงใน FlyWeb...</translation>
<translation id="3038232873781883849">กำลังรอติดตั้ง...</translation>
<translation id="7859502023458300952">ช่วยทำให้ FlyWeb ดียิ่งขึ้นโดยการส่งรายงานข้อขัดข้องและ <ph name="UMA_LINK"/> ไปยัง FlyWeb</translation>
<translation id="4133194854947529871">ประวัติการท่องเว็บส่งผลต่อโฆษณาที่คุณเห็นและความสนใจที่ระบบคาดคะเนไว้ดังที่แสดงอยู่ด้านล่างนี้ FlyWeb ลบความสนใจโดยอัตโนมัติเป็นประจำทุกเดือนเพื่อปกป้องความเป็นส่วนตัวของคุณ ระบบจะรีเฟรชความสนใจหากคุณไม่นำออก</translation>
<translation id="1407857531570256859">โปรแกรมติดตั้งคลายการบีบอัดการเก็บข้อมูลไม่ได้ โปรดดาวน์โหลด FlyWeb อีกครั้ง</translation>
<translation id="1309738977648134943">FlyWeb ใช้ไมโครโฟนของคุณอยู่</translation>
<translation id="6274649779206195384">เรียกใช้งาน FlyWeb อีกครั้ง</translation>
